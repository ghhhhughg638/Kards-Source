{
  "name": "KARDS Blueprint Studio",
  "short_name": "KARDS BP",
  "description": "KARDS 专用可视化蓝图编辑器 / Visual blueprint editor for KARDS",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#121719",
