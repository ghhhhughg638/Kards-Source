{"format":"kards-original-reference","version":1,"id":"4b59fc3462fb6329","name":"card_unit_1st_marines","package":"/Game/Blueprints/Cards/USA/Allegiance/units/card_unit_1st_marines","parent":"UBaseCardObject","card":{"title":"1st MARINES","text":"When this unit moves into the frontline, give your HQ Smokescreen until your next turn.","flavorText":"The 1st Marine Regiment was first activated in 1913 during the so-called Banana-Wars in the Caribbean, later in the Haitian campaign (1915–1916) and the Dominican Republic campaign (1916). During WWII the regiment first saw combat in the Guadalcanal Campaign in 1942 and would afterwards fight in several campaigns and operations in the Pacific. The last WWII engagement of the 1st Marine Regiment was the Battle of Okinawa in 1945, but afterwards it was deployed to North China where it would help garrison the area until 1949. The regiment has remained active since WWII and has participated in most major American wars since then.","faction":"USA","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":1,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_1st_marines","title":{"Namespace":"card_usa","Key":"card_unit_1st_marines_title","SourceString":"1st MARINES","LocalizedString":"1st MARINES"},"Type":"ETypeEnum::infantry","attack":3,"defense":4,"range":1,"faction":"EFactionEnum::USA","kredits":3,"Text":{"Namespace":"card_usa","Key":"card_unit_1st_marines_text","SourceString":"When this unit moves into the frontline, give your HQ Smokescreen until your next turn.","LocalizedString":"When this unit moves into the frontline, give your HQ Smokescreen until your next turn."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_1st_marines_history","SourceString":"The 1st Marine Regiment was first activated in 1913 during the so-called Banana-Wars in the Caribbean, later in the Haitian campaign (1915–1916) and the Dominican Republic campaign (1916). During WWII the regiment first saw combat in the Guadalcanal Campaign in 1942 and would afterwards fight in several campaigns and operations in the Pacific. The last WWII engagement of the 1st Marine Regiment was the Battle of Okinawa in 1945, but afterwards it was deployed to North China where it would help garrison the area until 1949. The regiment has remained active since WWII and has participated in most major American wars since then.","LocalizedString":"The 1st Marine Regiment was first activated in 1913 during the so-called Banana-Wars in the Caribbean, later in the Haitian campaign (1915–1916) and the Dominican Republic campaign (1916). During WWII the regiment first saw combat in the Guadalcanal Campaign in 1942 and would afterwards fight in several campaigns and operations in the Pacific. The last WWII engagement of the 1st Marine Regiment was the Battle of Okinawa in 1945, but afterwards it was deployed to North China where it would help garrison the area until 1949. The regiment has remained active since WWII and has participated in most major American wars since then."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Expansion2019","isInPermanentPool":true,"showBoostIcon":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Blitz","EHelpBubbleTypes::Smokescreen","EHelpBubbleTypes::Trigger"],"draftBaseWeight":0.9,"suppressionExceptionTriggers":["ERegisteredCardFunction::OnStartofTurn"],"hasBlitz":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/t_marines.t_marines","SubPathString":""},"artist":"Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/1st_MARINES.1st_MARINES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":407.0},"historyPhotoSource":"U.S. Department of Defense","historyPhotoDescription":{