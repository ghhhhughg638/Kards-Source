{"format":"kards-original-reference","version":1,"id":"306798db9c9a7a72","name":"card_unit_1081th_smolensk","package":"/Game/Blueprints/Cards/Soviet/OceaniaStorm/units/card_unit_1081th_smolensk","parent":"UBaseCardObject","card":{"title":"1081st SMOLENSK","text":"When you play a BLAST, distribute 2 damage randomly between all enemies.","flavorText":"The 1081st Rifle Regiment was one of the original rifle regiments of the Soviet 312th Rifle Division, alongside the 1079th and 1083rd. The division was first formed in July 1941 at Akyubinsk in Kazakhstan, with many Kazakh personnel in its ranks. It was sent north toward Leningrad, then urgently redirected toward Moscow during Operation Typhoon. Its regiments arrived in poor order and were thrown into combat near Maloyaroslavets almost straight from the trains. Within weeks, the first 312th Rifle Division was badly depleted and its remnants were absorbed into other units. A second 312th Rifle Division was formed in Siberia at the end of 1941. It fought near Moscow, then in the costly battles around Rzhev and Sychevka. In 1943, the division joined the advance during Operation Suvorov and entered Dorogobuzh before helping liberate Smolensk. For this action it received the honor name “Smolensk”. The division later fought through Belorussia, Poland, and toward Berlin, earning the Orders of the Red Banner, Suvorov, and Kutuzov before being disbanded in 1945.","faction":"Soviet","type":"infantry","rarity":"Rare","cost":4,"operationCost":1,"attack":3,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_1081th_smolensk","title":{"Namespace":"card_soviet","Key":"card_unit_1081th_smolensk_title","SourceString":"1081st SMOLENSK","LocalizedString":"1081st SMOLENSK"},"Type":"ETypeEnum::infantry","attack":3,"defense":6,"range":1,"faction":"EFactionEnum::Soviet","kredits":4,"Text":{"Namespace":"card_soviet","Key":"card_unit_1081th_smolensk_text","SourceString":"When you play a BLAST, distribute 2 damage randomly between all enemies.","LocalizedString":"When you play a BLAST, distribute 2 damage randomly between all enemies."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_1081th_smolensk_history","SourceString":"The 1081st Rifle Regiment was one of the original rifle regiments of the Soviet 312th Rifle Division, alongside the 1079th and 1083rd. The division was first formed in July 1941 at Akyubinsk in Kazakhstan, with many Kazakh personnel in its ranks. It was sent north toward Leningrad, then urgently redirected toward Moscow during Operation Typhoon. Its regiments arrived in poor order and were thrown into combat near Maloyaroslavets almost straight from the trains. Within weeks, the first 312th Rifle Division was badly depleted and its remnants were absorbed into other units. A second 312th Rifle Division was formed in Siberia at the end of 1941. It fought near Moscow, then in the costly battles around Rzhev and Sychevka. In 1943, the division joined the advance during Operation Suvorov and entered Dorogobuzh before helping liberate Smolensk. For this action it received the honor name “Smolensk”. The division later fought through Belorussia, Poland, and toward Berlin, earning the Orders of the Red Banner, Suvorov, and Kutuzov before being disbanded in 1945.","LocalizedString":"The 1081st Rifle Regiment was one of the original rifle regiments of the Soviet 312th Rifle Division, alongside the 1079th and 1083rd. The division was first formed in July 1941 at Akyubinsk in Kazakhstan, with many Kazakh personnel in its ranks. It was sent north toward Leningrad, then urgently redirected toward Moscow during Operation Typhoon. Its regiments arrived in poor order and were thrown into combat near Maloyaroslavets almost straight from the trains. Within weeks, the first 312th Rifle Division was badly depleted and its remnants were absorbed into other units. A second 312th Rifle Division was formed in Siberia at the end of 1941. It fought near Moscow, then in the costly battles around Rzhev and Sychevka. In 1943, the division joined the advance during Operation Suvorov and entered Dorogobuzh before helping liberate Smolensk. For this action it received the honor name “Smolensk”. The division later fought through Belorussia, Poland, and toward Berlin, earning the Orders of the Red Banner, Suvorov, and Kutuzov before being disbanded in 1945."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"hasGuard":true,"hasShock":true,"spawnCardName":"card_event_blast","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/1081th_SMOLENSK.1081th_SMOLENSK","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_1081th_smolensk_photo","SourceString":"Dug in Red Army infantry during Operation Typhoon, Eastern Front, 1941.","LocalizedString":"Dug in Red Army infantry during Operation Typhoon, Eastern Front, 1941."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"threat_level":0.1},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_1081th_smolensk","owner":"card_unit_1081th_smolensk_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Variable","type":"int32","direction":"in"},{"name":"CallFunc_LessEqual_IntInt_ReturnValue","type":"bool","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":