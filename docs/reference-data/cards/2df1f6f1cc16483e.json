ep into the Soviet Union. The Soviet summer offensive of 1944 led to battles like Tali-Ihantala, the largest in Finnish and Nordic history, where Finnish troops held their ground against overwhelming odds. This success allowed Finland to negotiate an armistice and preserve its independence. Finland’s wartime goal was survival, not conquest, and its steadfast defense ensured sovereignty despite immense pressure."},"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::NavalWarfare","usedTriggers":["ERegisteredCardFunction::OnOtherCardDealDamage"],"spawnCardName":"card_unit_sissi","soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Class_Specific_Engineer_Socket_Crank_Sequence_2'","ObjectPath":"kards/Content/War_UI/Waves/Class_Specific/War_UI_Class_Specific_Engineer_Socket_Crank_Sequence_2.0"},"soundAttack":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Finland/Naval_Warfare/t_heartland_defense.t_heartland_defense","SubPathString":""},"artist":"Finnish WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/HEARTLAND_DEFENSE.HEARTLAND_DEFENSE","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":345.0},"historyPhotoDescription":{"Namespace":"card_finland","Key":"card_event_heartland_defense_photo","SourceString":"Finnish soldiers during the Battle of Tali-Ihantala, Finland, 5 August 1944.","LocalizedString":"Finnish soldiers during the Battle of Tali-Ihantala, Finland, 5 August 1944."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"isDirectDamage":true},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_event_heartland_defense","owner":"card_event_heartland_defense_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFu