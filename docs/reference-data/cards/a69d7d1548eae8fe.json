{"format":"kards-original-reference","version":1,"id":"a69d7d1548eae8fe","name":"card_unit_3rd_maizuru_snlf","package":"/Game/Blueprints/Cards/Japan/WinterWar/units/card_unit_3rd_maizuru_snlf","parent":"UBaseCardObject","card":{"title":"3rd MAIZURU SNLF","text":"When you add or deploy an Alpine unit, deal 1 damage to a random enemy. Pin it if a unit.","flavorText":"The 3rd Maizuru SNFL (Special Naval Landing Force) was a naval infantry unit of the Imperial Japanese Navy that were part of the land forces. The SNFL was not a marine force but instead they were sailors who received basic infantry training and were deployed in landings during WWII. The 3rd Maizuru SNFL landed on Kiska Island in Alaska in June 1942 with a battalion-sized force of 550 men and occupied the island without any resistance. In the coming months, more units joined, and the occupying force gradually expanded to approximately 5,640 military personnel and 1,170 civilians. Despite the significant size of the force, it was not enough for the construction of an airfield, roads, accommodations, and defenses. Over the course of the fourteen-month occupation, the Japanese faced escalating attacks from American air and naval forces. Finally, on 28 July 1943 the occupation force withdrew from Kiska Island without attracting the attention of the Allied forces, and 18 days later an Allied force of 34,000 men invaded the deserted island.","faction":"Japan","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_3rd_maizuru_snlf","title":{"Namespace":"card_japan","Key":"card_unit_3rd_maizuru_snlf_title","SourceString":"3rd MAIZURU SNLF","LocalizedString":"3rd MAIZURU SNLF"},"Type":"ETypeEnum::infantry","attack":2,"defense":3,"range":1,"faction":"EFactionEnum::Japan","kredits":3,"Text":{"Namespace":"card_japan","Key":"card_unit_3rd_maizuru_snlf_text","SourceString":"When you add or deploy an Alpine unit, deal 1 damage to a random enemy. Pin it if a unit.","LocalizedString":"When you add or deploy an Alpine unit, deal 1 damage to a random enemy. Pin it if a unit."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_3rd_maizuru_snlf_history","SourceString":"The 3rd Maizuru SNFL (Special Naval Landing Force) was a naval infantry unit of the Imperial Japanese Navy that were part of the land forces. The SNFL was not a marine force but instead they were sailors who received basic infantry training and were deployed in landings during WWII. The 3rd Maizuru SNFL landed on Kiska Island in Alaska in June 1942 with a battalion-sized force of 550 men and occupied the island without any resistance. In the coming months, more units joined, and the occupying force gradually expanded to approximately 5,640 military personnel and 1,170 civilians. Despite the significant size of the force, it was not enough for the construction of an airfield, roads, accommodations, and defenses. Over the course of the fourteen-month occupation, the Japanese faced escalating attacks from American air and naval forces. Finally, on 28 July 1943 the occupation force withdrew from Kiska Island without attracting the attention of the Allied forces, and 18 days later an Allied force of 34,000 men invaded the deserted island.","LocalizedString":"The 3rd Maizuru SNFL (Special Naval Landing Force) was a naval infantry unit of the Imperial Japanese Navy that were part of the land forces. The SNFL was not a marine force but instead they were sailors who received basic infantry training and were deployed in landings during WWII. The 3rd Maizuru SNFL landed on Kiska Island in Alaska in June 1942 with a battalion-sized force of 550 men and occupied the island without any resistance. In the coming months, more units joined, and the occupying force gradually expanded to approximately 5,640 military personnel and 1,170 civilians. Despite the significant size of the force, it was not enough for the construction of an airfield, roads, accommodations, and defenses. Over the course of the fourteen-month occupation, the Japanese faced escalating attacks from American air and naval forces. Finally, on 28 July 1943 the occupation force withdrew from Kiska Island without attracting the attention of the Allied forces, and 18 days later an Allied force of 34,000 men invaded the deserted island."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::WinterWar","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardEnterPlay"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Alpine","EHelpBubbleTypes::Trigger"],"hasAlpine":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/CandidateArtwork/Winter_war/t_japanese_winter_infantry.t_japanese_winter_infantry","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/3rd_MAIZURU_SNFL.3rd_MAIZURU_SNFL","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":390.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_3rd_maizuru_snlf_photo","SourceString":"Men of the 3rd Maizuru SNFL on Kiska Island in the Aleutians on June 6th, 1942.","LocalizedString":"Men of the 3rd Maizuru SNFL on Kiska Island in the Aleutians on June 6th, 1942."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"Notes":"Image from Y.Takani not licensed yet","isHQDamage":true,"threat_level":0.1},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_3rd_maizuru_snlf","owner":"card_unit_3rd_maizuru_snlf_C","params":[{"name":"EntryPoint","t