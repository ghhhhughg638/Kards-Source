{"format":"kards-original-reference","version":1,"id":"09586edc0da0fdac","name":"card_event_island_hopping_elit","package":"/Game/Blueprints/Cards/USA/Legions/events/card_event_island_hopping_elit","parent":"UBaseCardObject","card":{"title":"ISLAND HOPPING","text":"The enemy HQ gets: \"If this HQ has taken 3+ damage this turn, a random friendly unit gets +2+2.\"","flavorText":"Island hopping, also known as Leapfrogging, was a military strategy employed by the Allies in the Pacific War against the Empire of Japan and the Axis powers during WWII. In short the strategy was about taking control of islands in the Pacific that were not heavily defended by the Japanese, and quickly constructing landing strips and small military bases. From there the target was set on the next island, and gradually the Allied forces moved closer to its final goal which was Japan. The island hopping strategy was very costly for the Allies, but ultimately it led to victory over the Japanese forces.","faction":"USA","type":"order","rarity":"Unique","cost":3,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_island_hopping_elit","title":{"Namespace":"card_usa","Key":"card_event_island_hopping_elit_title","SourceString":"ISLAND HOPPING","LocalizedString":"ISLAND HOPPING"},"Type":"ETypeEnum::order","faction":"EFactionEnum::USA","kredits":3,"Text":{"Namespace":"card_usa","Key":"card_event_island_hopping_elit_text","SourceString":"The enemy HQ gets: \"If this HQ has taken 3+ damage this turn, a random friendly unit gets +2+2.\"","LocalizedString":"The enemy HQ gets: \"If this HQ has taken 3+ damage this turn, a random friendly unit gets +2+2.\""},"flavorText":{"Namespace":"card_usa","Key":"card_event_island_hopping_elit_history","SourceString":"Island hopping, also known as Leapfrogging, was a military strategy employed by the Allies in the Pacific War against the Empire of Japan and the Axis powers during WWII. In short the strategy was about taking control of islands in the Pacific that were not heavily defended by the Japanese, and quickly constructing landing strips and small military bases. From there the target was set on the next island, and gradually the Allied forces moved closer to its final goal which was Japan. The island hopping strategy was very costly for the Allies, but ultimately it led to victory over the Japanese forces.","LocalizedString":"Island hopping, also known as Leapfrogging, was a military strategy employed by the Allies in the Pacific War against the Empire of Japan and the Axis powers during WWII. In short the strategy was about taking control of islands in the Pacific that were not heavily defended by the Japanese, and quickly constructing landing strips and small military bases. From there the target was set on the next island, and gradually the Allied forces moved closer to its final goal which was Japan. The island hopping strategy was very costly for the Allies, but ultimately it led to victory over the Japanese forces."},"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::Legions","isReserved":true,"usedTriggers":["ERegisteredCardFunction::OnOtherCardDealDamage","ERegisteredCardFunction::OnBeforeStartOfTurn"],"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/CandidateArtwork/t_a_few_good_mens.t_a_few_good_mens","SubPathString":""},"artist":"Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/ISLAND_HOPPING.ISLAND_HOPPING","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":322.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_event_island_hopping_elit_photo","SourceString":"LVTs approach the island of Iwo Jima, 1945.","LocalizedString":"LVTs approach the island of Iwo Jima, 1945."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effe