{"format":"kards-original-reference","version":1,"id":"61ab859d26fd83e2","name":"card_unit_kv_85","package":"/Game/Blueprints/Cards/Soviet/NavalWarfare/units/card_unit_kv_85","parent":"UBaseCardObject","card":{"title":"KV-85","text":"Deployment: Convert a card in hand into your last destroyed unit. Lose 2 kredits at the start of your next turn.","flavorText":"The KV-85 was a Soviet heavy tank developed in 1943 as an interim solution to counter advanced German armor such as the Tiger I. It combined the KV-1S chassis with a new turret designed for the IS-1, mounting an 85mm D-5T gun capable of penetrating the Tiger I's armor at 1,000 meters. This upgrade addressed the KV-1's inadequate firepower against newer German tanks. Production was limited to 148 units between August and October 1943, as the KV-85 was quickly superseded by the more advanced IS series. Despite its enhanced armament, the KV-85 retained the KV-1S's chassis, which suffered from mobility and armor limitations. Its armor, while improved, was still vulnerable to German 75mm and 88mm guns. The KV-85 saw combat in late 1943, notably in Ukraine, where it provided valuable experience that informed the development of the IS-1 and IS-2 tanks. While its service was brief, the KV-85 represented a crucial step in the evolution of Soviet heavy tank design during WWII.","faction":"Soviet","type":"tank","rarity":"Rare","cost":2,"operationCost":2,"attack":5,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_kv_85","title":{"Namespace":"card_soviet","Key":"card_unit_kv_85_title","SourceString":"KV-85","LocalizedString":"KV-85"},"Type":"ETypeEnum::tank","attack":5,"defense":5,"range":1,"faction":"EFactionEnum::Soviet","kredits":2,"Text":{"Namespace":"card_soviet","Key":"card_unit_kv_85_text","SourceString":"Deployment: Convert a card in hand into your last destroyed unit. Lose 2 kredits at the start of your next turn.","LocalizedString":"Deployment: Convert a card in hand into your last destroyed unit. Lose 2 kredits at the start of your next turn."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_kv_85_history","SourceString":"The KV-85 was a Soviet heavy tank developed in 1943 as an interim solution to counter advanced German armor such as the Tiger I. It combined the KV-1S chassis with a new turret designed for the IS-1, mounting an 85mm D-5T gun capable of penetrating the Tiger I's armor at 1,000 meters. This upgrade addressed the KV-1's inadequate firepower against newer German tanks. Production was limited to 148 units between August and October 1943, as the KV-85 was quickly superseded by the more advanced IS series. Despite its enhanced armament, the KV-85 retained the KV-1S's chassis, which suffered from mobility and armor limitations. Its armor, while improved, was still vulnerable to German 75mm and 88mm guns. The KV-85 saw combat in late 1943, notably in Ukraine, where it provided valuable experience that informed the development of the IS-1 and IS-2 tanks. While its service was brief, the KV-85 represented a crucial step in the evolution of Soviet heavy tank design during WWII.","LocalizedString":"The KV-85 was a Soviet heavy tank developed in 1943 as an interim solution to counter advanced German armor such as the Tiger I. It combined the KV-1S chassis with a new turret designed for the IS-1, mounting an 85mm D-5T gun capable of penetrating the Tiger I's armor at 1,000 meters. This upgrade addressed the KV-1's inadequate firepower against newer German tanks. Production was limited to 148 units between August and October 1943, as the KV-85 was quickly superseded by the more advanced IS series. Despite its enhanced armament, the KV-85 retained the KV-1S's chassis, which suffered from mobility and armor limitations. Its armor, while improved, was still vulnerable to German 75mm and 88mm guns. The KV-85 saw combat in late 1943, notably in Ukraine, where it provided valuable experience that informed the development of the IS-1 and IS-2 tanks. While its service was brief, the KV-85 represented a crucial step in the evolution of Soviet heavy tank design during WWII."},"operationCost":2,"rarity":"ERarityEnum::Rare","waitWithOnOtherCardPlayedUntilHandTargetSelected":true,"selectHandCardNotifyText":{"Namespace":"","Key":"66524B7F4A40A7DB9542CF8064ADB72A","SourceString":"Choose a card in hand to Convert","LocalizedString":"Choose a card in hand to Convert"},"cardSet":"ECardSetEnum::NavalWarfare","usedTriggers":["ERegisteredCardFunction::OnStartofTurn","ERegisteredCardFunction::OnOtherCardDestroyed"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Convert"],"suppressionExceptionTriggers":["ERegisteredCardFunction::OnStartofTurn"],"hasDeployment":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/NavalWarfare/t_kv_85.t_kv_85","SubPathString":""},"artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/KV-85.KV-85","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":302.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_kv_85_photo","SourceString":"A KV-85 heavy tank of the 34th Guards Armored Regiment in 1943.","LocalizedString":"A KV-85 heavy tank of the 34th Guards Armored Regiment in 1943."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionArmourM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionArmourM.36"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Tanks/BP_AttackTank.BP_AttackTank_C","SubPathString":""},"isHQDamage":true},"variables":[{"name":"allCardsDestroyedThisBattle","type":"TArray<int32>","direction":"in"},{"name":"lastFriendlyDestroyedCard","type":"UBaseCardObject*","direction":"in"},{"name":"timesPlayed","type":"int32","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_kv_85","owner":"card_unit_kv_85_