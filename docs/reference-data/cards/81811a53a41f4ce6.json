{"format":"kards-original-reference","version":1,"id":"81811a53a41f4ce6","name":"card_unit_2nd_michigan","package":"/Game/Blueprints/Cards/USA/BloodIron/units/card_unit_2nd_michigan","parent":"UBaseCardObject","card":{"title":"2nd MICHIGAN","text":"Gain 2 kredits when you operate a unit with 3 or more operation cost.","flavorText":"The 126th Infantry Regiment, nicknamed “Second Michigan” is a unit of the Michigan Army National Guard, part of the United States Army. When the United States entered WWII the regiment was trained for war in Europe, but was redirected to the Pacific and it landed in Australia in April 1942. From there the regiment sailed to New Guinea where it participated in the Battle of Buna-Gona as part of the 32nd Infantry Division. During the battle the 2nd Michigan faced devastating losses, both in combat and due to disease, and of the 131 officers and 3,040 men, only 32 officers and 579 enlisted men were left. The regiment was sent back to Australia to refit and retrain, and there it received amphibious training and lessons in jungle warfare. As part of the 32nd Infantry Division the regiment landed in Papua New Guinea where it participated in the Western New Guinea campaign, and later they fought in Leyte and Luzon. During its service the 32nd Division logged a total of 654 days of combat during WWII, more than any other United States Army division.","faction":"USA","type":"infantry","rarity":"Rare","cost":4,"operationCost":3,"attack":6,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_2nd_michigan","title":{"Namespace":"card_usa","Key":"card_unit_2nd_michigan_title","SourceString":"2nd MICHIGAN","LocalizedString":"2nd MICHIGAN"},"Type":"ETypeEnum::infantry","attack":6,"defense":6,"range":1,"faction":"EFactionEnum::USA","kredits":4,"Text":{"Namespace":"card_usa","Key":"card_unit_2nd_michigan_text","SourceString":"Gain 2 kredits when you operate a unit with 3 or more operation cost.","LocalizedString":"Gain 2 kredits when you operate a unit with 3 or more operation cost."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_2nd_michigan_history","SourceString":"The 126th Infantry Regiment, nicknamed “Second Michigan” is a unit of the Michigan Army National Guard, part of the United States Army. When the United States entered WWII the regiment was trained for war in Europe, but was redirected to the Pacific and it landed in Australia in April 1942. From there the regiment sailed to New Guinea where it participated in the Battle of Buna-Gona as part of the 32nd Infantry Division. During the battle the 2nd Michigan faced devastating losses, both in combat and due to disease, and of the 131 officers and 3,040 men, only 32 officers and 579 enlisted men were left. The regiment was sent back to Australia to refit and retrain, and there it received amphibious training and lessons in jungle warfare. As part of the 32nd Infantry Division the regiment landed in Papua New Guinea where it participated in the Western New Guinea campaign, and later they fought in Leyte and Luzon. During its service the 32nd Division logged a total of 654 days of combat during WWII, more than any other United States Army division.","LocalizedString":"The 126th Infantry Regiment, nicknamed “Second Michigan” is a unit of the Michigan Army National Guard, part of the United States Army. When the United States entered WWII the regiment was trained for war in Europe, but was redirected to the Pacific and it landed in Australia in April 1942. From there the regiment sailed to New Guinea where it participated in the Battle of Buna-Gona as part of the 32nd Infantry Division. During the battle the 2nd Michigan faced devastating losses, both in combat and due to disease, and of the 131 officers and 3,040 men, only 32 officers and 579 enlisted men were left. The regiment was sent back to Australia to refit and retrain, and there it received amphibious training and lessons in jungle warfare. As part of the 32nd Infantry Division the regiment landed in Papua New Guinea where it participated in the Western New Guinea campaign, and later they fought in Leyte and Luzon. During its service the 32nd Division logged a total of 654 days of combat during WWII, more than any other United States Army division."},"operationCost":3,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::BloodAndIron","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardOperationKreditSpent"],"draftBaseWeight":0.9,"hasBlitz":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/Winter_2024/2nd_michigan.2nd_michigan","SubPathString":""},"artist":"US WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/2nd_MICHIGAN.2nd_MICHIGAN","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":424.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_2nd_michigan_photo","SourceString":"Men of the 126th Infantry Regiment on Luzon Island, Philippines, 1945.","LocalizedString":"Men of the 126th Infantry Regiment on Luzon Island, Philippines, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"isDirectDamage":true,"threat_level":0.2},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_2nd_michigan","owner":"card_unit_2nd_michigan_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"K2Node_Event_cardOperated","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_kreditsSpent_1","type":"int32","direction":"in"},{"name":"CallFunc_Giv