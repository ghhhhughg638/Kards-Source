{"format":"kards-original-reference","version":1,"id":"81cd48da16a429bd","name":"card_unit_dinah","package":"/Game/Blueprints/Cards/Japan/Base/units/card_unit_dinah","parent":"UBaseCardObject","card":{"title":"M6A1 SEIRAN","text":"Your orders deal +1 damage.","flavorText":"The Aichi M6A1 Seiran was a Japanese submarine-launched attack floatplane used by the Imperial Japanese Navy during WWII. It was intended to operate from I-400 class submarines and its original mission was to conduct aerial attacks against the United States. Only 28 aircraft were built, including variants, and it was first used in service in 1945, not long before Japan surrendered. Many of the M6A1's were destroyed to prevent capture and only one exists today at the Udvar-Hazy Center of the Smithsonian's National Air and Space Museum.","faction":"Japan","type":"bomber","rarity":"Rare","cost":4,"operationCost":2,"attack":1,"defense":4},"defaults":{"Name":"card_unit_dinah","title":{"Namespace":"card_japan","Key":"card_unit_dinah_title","SourceString":"M6A1 SEIRAN","LocalizedString":"M6A1 SEIRAN"},"Type":"ETypeEnum::bomber","attack":1,"defense":4,"range":2,"faction":"EFactionEnum::Japan","kredits":4,"Text":{"Namespace":"card_japan","Key":"card_unit_dinah_text","SourceString":"Your orders deal +1 damage.","LocalizedString":"Your orders deal +1 damage."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_dinah_history","SourceString":"The Aichi M6A1 Seiran was a Japanese submarine-launched attack floatplane used by the Imperial Japanese Navy during WWII. It was intended to operate from I-400 class submarines and its original mission was to conduct aerial attacks against the United States. Only 28 aircraft were built, including variants, and it was first used in service in 1945, not long before Japan surrendered. Many of the M6A1's were destroyed to prevent capture and only one exists today at the Udvar-Hazy Center of the Smithsonian's National Air and Space Museum.","LocalizedString":"The Aichi M6A1 Seiran was a Japanese submarine-launched attack floatplane used by the Imperial Japanese Navy during WWII. It was intended to operate from I-400 class submarines and its original mission was to conduct aerial attacks against the United States. Only 28 aircraft were built, including variants, and it was first used in service in 1945, not long before Japan surrendered. Many of the M6A1's were destroyed to prevent capture and only one exists today at the Udvar-Hazy Center of the Smithsonian's National Air and Space Museum."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Basic","isReserved":true,"EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardDealDamageAddDamage"],"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/01_Base/T_m6a1_seiran.T_m6a1_seiran","SubPathString":""},"artist":"Yoshiyuki Takani","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/M6A1_SEIRAN.M6A1_SEIRAN","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":279.0},"historyPhotoSource":"Australian War Memorial ","historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_dinah_photo","SourceString":"Aichi M6A Seiran during WWII.","LocalizedString":"Aichi M6A Seiran during WWII."},"historyTypeDescription":{"Namespace":"card_japan","Key":"card_unit_dinah_header","SourceString":"Dive/Torpedo Bomber","LocalizedString":"Dive/Torpedo Bomber"},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackBomber.BP_Atta