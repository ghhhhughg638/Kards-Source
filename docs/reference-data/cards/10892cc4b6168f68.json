{"format":"kards-original-reference","version":1,"id":"10892cc4b6168f68","name":"card_event_planned_attack","package":"/Game/Blueprints/Cards/Britain/OceaniaStorm/events/card_event_planned_attack","parent":"UBaseCardObject","card":{"title":"PLANNED ATTACK","text":"Choose One - deal 2 damage and add a PLAN to hand OR draw a card and add a BLAST to hand.","flavorText":"Operation Thursday took place from March to August 1944 and was the second and largest Chindit expedition in Burma. The Chindits, officially named Long Range Penetration Groups, were British and Indian Army  units assembled by Orde Wingate to operate deep behind Japanese lines. Their columns included British, Indian, Gurkha, Burmese, and West African soldiers. They were trained for jungle warfare , demolition, raiding, and survival far from normal supply routes. The plans for Operation Thursday changed several times before the final attack. Wingate shifted from long marches into Burma toward a bolder plan based on air power. Chindit units would be flown deep into enemy-held territory, build fortified bases with airstrips, and send out mobile columns to cut roads, railways, and supply lines. The US 1st Air Commando Group provided gliders, Dakota transports, supply drops, evacuation, and air support. Landing zones were selected by aerial reconnaissance and given code names such as Piccadilly, Broadway and Chowringhee. The operation disrupted Japanese communications, but diseases, exhaustion, monsoon rain, and heavy fighting made the cost severe.","faction":"Britain","type":"order","rarity":"Uncommon","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_planned_attack","title":{"Namespace":"card_britain","Key":"card_event_planned_attack_title","SourceString":"PLANNED ATTACK","LocalizedString":"PLANNED ATTACK"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Britain","kredits":2,"Text":{"Namespace":"card_britain","Key":"card_event_planned_attack_text","SourceString":"Choose One - deal 2 damage and add a PLAN to hand OR draw a card and add a BLAST to hand.","LocalizedString":"Choose One - deal 2 damage and add a PLAN to hand OR draw a card and add a BLAST to hand."},"flavorText":{"Namespace":"card_britain","Key":"card_event_planned_attack_history","SourceString":"Operation Thursday took place from March to August 1944 and was the second and largest Chindit expedition in Burma. The Chindits, officially named Long Range Penetration Groups, were British and Indian Army  units assembled by Orde Wingate to operate deep behind Japanese lines. Their columns included British, Indian, Gurkha, Burmese, and West African soldiers. They were trained for jungle warfare , demolition, raiding, and survival far from normal supply routes. The plans for Operation Thursday changed several times before the final attack. Wingate shifted from long marches into Burma toward a bolder plan based on air power. Chindit units would be flown deep into enemy-held territory, build fortified bases with airstrips, and send out mobile columns to cut roads, railways, and supply lines. The US 1st Air Commando Group provided gliders, Dakota transports, supply drops, evacuation, and air support. Landing zones were selected by aerial reconnaissance and given code names such as Piccadilly, Broadway and Chowringhee. The operation disrupted Japanese communications, but diseases, exhaustion, monsoon rain, and heavy fighting made the cost severe.","LocalizedString":"Operation Thursday took place from March to August 1944 and was the second and largest Chindit expedition in Burma. The Chindits, officially named Long Range Penetration Groups, were British and Indian Army  units assembled by Orde Wingate to operate deep behind Japanese lines. Their columns included British, Indian, Gurkha, Burmese, and West African soldiers. They were trained for jungle warfare , demolition, raiding, and survival far from normal supply routes. The plans for Operation Thursday changed several times before the final attack. Wingate shifted from long marches into Burma toward a bolder plan based on air power. Chindit units would be flown deep into enemy-held territory, build fortified bases with airstrips, and send out mobile columns to cut roads, railways, and supply lines. The US 1st Air Commando Group provided gliders, Dakota transports, supply drops, evacuation, and air support. Landing zones were selected by aerial reconnaissance and given code names such as Piccadilly, Broadway and Chowringhee. The operation disrupted Japanese communications, but diseases, exhaustion, monsoon rain, and heavy fighting made the cost severe."},"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::OceaniaStorm","chooseOneCards":[{"cardText":{"Namespace":"","Key":"E4B3A2D9484AF1A8CBED7DBEE83CD53F","SourceString":"Deal 2 damage and add a PLAN to hand.","LocalizedString":"Deal 2 damage and add a PLAN to hand."},"selectTargetOnPlayedFromHand":true},{"cardText":{"Namespace":"","Key":"436AC76C42618DC5FBBF7D8E038E1985","SourceString":"Draw a card and add a BLAST to hand.","LocalizedString":"Draw a card and add a BLAST to hand."},"selectTargetOnPlayedFromHand":false}],"spawnCardName":"card_event_blast;card_event_plan","soundEnterPlay":{"ObjectName":"SoundCue'War_UI_Drum_Movement_Field_Snares_3_Cue'","ObjectPath":"kards/Content/War_UI/Cues/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3_Cue.0"},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/PLANNED_ATTACK.PLANNED_ATTACK","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_event_planned_attack_photo","SourceString":"Chindits boarding a plane during Operation Thursday, Burma, 1944.","LocalizedString":"Chindits boarding a plane during Operation Thursday, Burma, 1944."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""}},"variables":[],"functions":[{"name":"CanPlayFromHand","owner":"card_even