{"format":"kards-original-reference","version":1,"id":"b6020189b3dac081","name":"card_unit_hotchkiss_35","package":"/Game/Blueprints/Cards/France/units/card_unit_hotchkiss_35","parent":"UBaseCardObject","card":{"title":"HOTCHKISS H35","text":"Gets +1 attack when you deploy a non-French unit.","flavorText":"The Hotchkiss H35 (French: Char Léger model 1935 H) was a French light Cavalry tank in French service from 1936 to 1940. The H35 had a crew of 2, a main armament of a 37 mm SA 18 gun and a secondary armament of a 7.5 mm MAC31 Reibel machine gun. After the fall of France in 1940, production was halted, and by then 1200 Hotchkiss tanks had been produced. For the rest of WWII, the Axis powers used captured Hotchkiss H35s and made several modifications to them.","faction":"France","type":"tank","rarity":"Common","cost":2,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_hotchkiss_35","title":{"Namespace":"card_france","Key":"card_unit_hotchkiss_35_title","SourceString":"HOTCHKISS H35","LocalizedString":"HOTCHKISS H35"},"Type":"ETypeEnum::tank","attack":2,"defense":3,"range":1,"faction":"EFactionEnum::France","kredits":2,"Text":{"Namespace":"card_france","Key":"card_unit_hotchkiss_35_text","SourceString":"Gets +1 attack when you deploy a non-French unit.","LocalizedString":"Gets +1 attack when you deploy a non-French unit."},"flavorText":{"Namespace":"card_france","Key":"card_unit_hotchkiss_35_history","SourceString":"The Hotchkiss H35 (French: Char Léger model 1935 H) was a French light Cavalry tank in French service from 1936 to 1940. The H35 had a crew of 2, a main armament of a 37 mm SA 18 gun and a secondary armament of a 7.5 mm MAC31 Reibel machine gun. After the fall of France in 1940, production was halted, and by then 1200 Hotchkiss tanks had been produced. For the rest of WWII, the Axis powers used captured Hotchkiss H35s and made several modifications to them.","LocalizedString":"The Hotchkiss H35 (French: Char Léger model 1935 H) was a French light Cavalry tank in French service from 1936 to 1940. The H35 had a crew of 2, a main armament of a 37 mm SA 18 gun and a secondary armament of a 7.5 mm MAC31 Reibel machine gun. After the fall of France in 1940, production was halted, and by then 1200 Hotchkiss tanks had been produced. For the rest of WWII, the Axis powers used captured Hotchkiss H35s and made several modifications to them."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Expansion2019","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"soundEnterPlay":{"ObjectName":"SoundWave'Armored_Car_Move_New'","ObjectPath":"kards/Content/Assets/Audio/Units/Armored_Car_Move_New.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Armored_Car_Move_New'","ObjectPath":"kards/Content/Assets/Audio/Units/Armored_Car_Move_New.0"},"soundBlowUp":{"ObjectName":"SoundWave'AU_ArmorExplosion_01'","ObjectPath":"kards/Content/Assets/Audio/Explosions/AU_ArmorExplosion_01.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/France/t_h39_1940.t_h39_1940","SubPathString":""},"artist":"Jarosław Wróbel","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/HOTCHKISS_H35.HOTCHKISS_H35","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":329.0},"historyPhotoSource":"https://ww2db.com/","historyPhotoDescription":{"Namespace":"card_france","Key":"card_unit_hotchkiss_35_photo","SourceString":"French troops and H35 tanks, France, 1940.","LocalizedString":"French troops and H35 tanks, France, 1940."},"historyTypeDescription":{"Namespace":"card_france","Key":"card_unit_hotchkiss_35_header","SourceString":"Light Tank","LocalizedString":"Light Tank"},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionArmourS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionArmourS.31"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","Obj