{"format":"kards-original-reference","version":1,"id":"a37704b1118b4d53","name":"card_unit_grumman_goose","package":"/Game/Blueprints/Cards/USA/CovertOp/units/card_unit_grumman_goose","parent":"UBaseCardObject","card":{"title":"GRUMMAN GOOSE","text":"Reveal: When the enemy HQ is attacked this turn, draw a card.","flavorText":"The Grumman G-21, nicknamed “Goose”, was initially designed as an “air yacht” for wealthy New York businessmen, so they could commute from their homes on Long Island to their Manhattan offices. However, it soon found a market as an airliner, military transport, and utility aircraft. During WWII the Grumman Goose was primarily used by the US Navy, the US Coast Guard and USAAF, but also by the Royal Canadian Air Force. The aircraft was mainly employed for transport, reconnaissance, rescue, and training roles. A total of 345 Grumman Goose were produced by October 1945, including quite a few variants, but most were phased out of military service after WWII.","faction":"USA","type":"fighter","rarity":"Rare","cost":3,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_grumman_goose","title":{"Namespace":"card_usa","Key":"card_unit_grumman_goose_title","SourceString":"GRUMMAN GOOSE","LocalizedString":"GRUMMAN GOOSE"},"Type":"ETypeEnum::fighter","attack":2,"defense":3,"range":2,"faction":"EFactionEnum::USA","kredits":3,"Text":{"Namespace":"card_usa","Key":"card_unit_grumman_goose_text","SourceString":"Reveal: When the enemy HQ is attacked this turn, draw a card.","LocalizedString":"Reveal: When the enemy HQ is attacked this turn, draw a card."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_grumman_goose_history","SourceString":"The Grumman G-21, nicknamed “Goose”, was initially designed as an “air yacht” for wealthy New York businessmen, so they could commute from their homes on Long Island to their Manhattan offices. However, it soon found a market as an airliner, military transport, and utility aircraft. During WWII the Grumman Goose was primarily used by the US Navy, the US Coast Guard and USAAF, but also by the Royal Canadian Air Force. The aircraft was mainly employed for transport, reconnaissance, rescue, and training roles. A total of 345 Grumman Goose were produced by October 1945, including quite a few variants, but most were phased out of military service after WWII.","LocalizedString":"The Grumman G-21, nicknamed “Goose”, was initially designed as an “air yacht” for wealthy New York businessmen, so they could commute from their homes on Long Island to their Manhattan offices. However, it soon found a market as an airliner, military transport, and utility aircraft. During WWII the Grumman Goose was primarily used by the US Navy, the US Coast Guard and USAAF, but also by the Royal Canadian Air Force. The aircraft was mainly employed for transport, reconnaissance, rescue, and training roles. A total of 345 Grumman Goose were produced by October 1945, including quite a few variants, but most were phased out of military service after WWII."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::CurrentExpansion","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn","ERegisteredCardFunction::OnAfterOtherCardAttacks"],"hasCovert":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/CandidateArtwork/Summer_24/t_grumman_goose.t_grumman_goose","SubPathString":""},"artist":"Darryl Legg","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/GRUMMAN_GOOSE.GRUMMAN_GOOSE","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":409.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_grumman_goose_photo","SourceString":"A Grumman JRF-5 Goose from the US Navy, 1941.","LocalizedString":"A Grumman JRF-5 Goose from the US Navy, 1941."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_Exp