{"format":"kards-original-reference","version":1,"id":"3033a987993d396d","name":"card_unit_sissiosasto_5d","package":"/Game/Blueprints/Cards/Finland/units/card_unit_sissiosasto_5d","parent":"UBaseCardObject","card":{"title":"SISSIOSASTO 5.D","text":"Gets +1+1 when an enemy unit is added, deployed or destroyed.","flavorText":"Sissiosasto/5.D (5th Division Sissi Detachment) was a specialized Finnish Army unit established during the Continuation War under the Lynx Division (5th Division, Finnish VI Corps). The unit was raised in 1941 and it focused on reconnaissance, sabotage, and guerrilla operations behind enemy lines. Led by Second Lieutenant V.I. Laajoki and comprising 51 volunteers from the 5th Division's sub-units, SissiOs./5.D conducted reconnaissance patrols in newly captured territories near the Svir River in late 1941. From early 1942, they engaged in longer reconnaissance missions independently and collaboratively with other Sissi units (light infantry units). In April 1942, an ad hoc squad, Osasto Uimonen, was formed to destroy a Soviet logistics center. Divided into two groups, the squad faced unexpected challenges and, despite significant losses, engaged in a fierce battle against a large enemy force. After the failed mission and the loss of their officers, SissiOs./5.D was reassigned to Kevyt osasto 19 (English: Light Division 19) and participated in frontline battles in the Šemenski-Pertjärvi area, contributing to a Finnish defensive victory.","faction":"Finland","type":"infantry","rarity":"Rare","cost":2,"operationCost":1,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_sissiosasto_5d","title":{"Namespace":"card_finland","Key":"card_unit_sissiosasto_5d_title","SourceString":"SISSIOSASTO 5.D","LocalizedString":"SISSIOSASTO 5.D"},"Type":"ETypeEnum::infantry","attack":1,"defense":2,"range":1,"faction":"EFactionEnum::Finland","kredits":2,"Text":{"Namespace":"card_finland","Key":"card_unit_sissiosasto_5d_text","SourceString":"Gets +1+1 when an enemy unit is added, deployed or destroyed.","LocalizedString":"Gets +1+1 when an enemy unit is added, deployed or destroyed."},"flavorText":{"Namespace":"card_finland","Key":"card_unit_sissiosasto_5d_history","SourceString":"Sissiosasto/5.D (5th Division Sissi Detachment) was a specialized Finnish Army unit established during the Continuation War under the Lynx Division (5th Division, Finnish VI Corps). The unit was raised in 1941 and it focused on reconnaissance, sabotage, and guerrilla operations behind enemy lines. Led by Second Lieutenant V.I. Laajoki and comprising 51 volunteers from the 5th Division's sub-units, SissiOs./5.D conducted reconnaissance patrols in newly captured territories near the Svir River in late 1941. From early 1942, they engaged in longer reconnaissance missions independently and collaboratively with other Sissi units (light infantry units). In April 1942, an ad hoc squad, Osasto Uimonen, was formed to destroy a Soviet logistics center. Divided into two groups, the squad faced unexpected challenges and, despite significant losses, engaged in a fierce battle against a large enemy force. After the failed mission and the loss of their officers, SissiOs./5.D was reassigned to Kevyt osasto 19 (English: Light Division 19) and participated in frontline battles in the Šemenski-Pertjärvi area, contributing to a Finnish defensive victory.","LocalizedString":"Sissiosasto/5.D (5th Division Sissi Detachment) was a specialized Finnish Army unit established during the Continuation War under the Lynx Division (5th Division, Finnish VI Corps). The unit was raised in 1941 and it focused on reconnaissance, sabotage, and guerrilla operations behind enemy lines. Led by Second Lieutenant V.I. Laajoki and comprising 51 volunteers from the 5th Division's sub-units, SissiOs./5.D conducted reconnaissance patrols in newly captured territories near the Svir River in late 1941. From early 1942, they engaged in longer reconnaissance missions independently and collaboratively with other Sissi units (light infantry units). In April 1942, an ad hoc squad, Osasto Uimonen, was formed to destroy a Soviet logistics center. Divided into two groups, the squad faced unexpected challenges and, despite significant losses, engaged in a fierce battle against a large enemy force. After the failed mission and the loss of their officers, SissiOs./5.D was reassigned to Kevyt osasto 19 (English: Light Division 19) and participated in frontline battles in the Šemenski-Pertjärvi area, contributing to a Finnish defensive victory."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::WinterWar","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardDestroyed","ERegisteredCardFunction::OnOtherCardEnterPlay","ERegisteredCardFunction::OnOtherCovertCardPlayedFromHand"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Guard","EHelpBubbleTypes::Trigger"],"hasGuard":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Finland/t_finnish_card_x.t_finnish_card_x","SubPathString":""},"artist":"Look and Learn","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/SISSIOSASTO_5_D.SISSIOSASTO_5_D","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":265.0},"historyPhotoDescription":{"Namespace":"card_finland","Key":"card_unit_sissiosasto_5d_photo","SourceString":"Finnish light infantry utilizing a motorboat for an amphibious assault. Date unknown.","LocalizedString":"Finnish light infantry utilizing a motorboat for an amphibious assault. Date unknown."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_Att