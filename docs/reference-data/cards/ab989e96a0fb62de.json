{"format":"kards-original-reference","version":1,"id":"ab989e96a0fb62de","name":"card_unit_2nd_alpini","package":"/Game/Blueprints/Cards/Italy/units/card_unit_2nd_alpini","parent":"UBaseCardObject","card":{"title":"2nd ALPINI REGIMENT","text":"Deployment: If you control another Alpine unit, draw a card.","flavorText":"The 2nd Alpini Regiment was a light infantry regiment of the Italian Army that specialized in mountain warfare. During WWII the regiment was attached to the \"Cuneense\" division of the Italian Army which fought in France, the Italian attack on Greece and the invasion of Yugoslavia. In 1942 the division fought with the German Sixth Army on the Eastern Front in the Battle of Stalingrad where it ended up being encircled and almost annihilated by the Red Army. In February 1943 the division counted as few as 5,206 men, 206 of them being men of the 2nd Alpini Regiment, who by then had walked 200 km, fought in 20 battles and spent 11 nights camped out in the middle of the Russian Steppe. After the signing of the Italian armistice with the Allies in September 1943, the regiment was disbanded.","faction":"Italy","type":"infantry","rarity":"Uncommon","cost":2,"operationCost":1,"attack":2,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_2nd_alpini","title":{"Namespace":"card_italy","Key":"card_unit_2nd_alpini_title","SourceString":"2nd ALPINI REGIMENT","LocalizedString":"2nd ALPINI REGIMENT"},"Type":"ETypeEnum::infantry","attack":2,"defense":2,"range":1,"faction":"EFactionEnum::Italy","kredits":2,"Text":{"Namespace":"card_italy","Key":"card_unit_2nd_alpini_text","SourceString":"Deployment: If you control another Alpine unit, draw a card.","LocalizedString":"Deployment: If you control another Alpine unit, draw a card."},"flavorText":{"Namespace":"card_italy","Key":"card_unit_2nd_alpini_history","SourceString":"The 2nd Alpini Regiment was a light infantry regiment of the Italian Army that specialized in mountain warfare. During WWII the regiment was attached to the \"Cuneense\" division of the Italian Army which fought in France, the Italian attack on Greece and the invasion of Yugoslavia. In 1942 the division fought with the German Sixth Army on the Eastern Front in the Battle of Stalingrad where it ended up being encircled and almost annihilated by the Red Army. In February 1943 the division counted as few as 5,206 men, 206 of them being men of the 2nd Alpini Regiment, who by then had walked 200 km, fought in 20 battles and spent 11 nights camped out in the middle of the Russian Steppe. After the signing of the Italian armistice with the Allies in September 1943, the regiment was disbanded.","LocalizedString":"The 2nd Alpini Regiment was a light infantry regiment of the Italian Army that specialized in mountain warfare. During WWII the regiment was attached to the \"Cuneense\" division of the Italian Army which fought in France, the Italian attack on Greece and the invasion of Yugoslavia. In 1942 the division fought with the German Sixth Army on the Eastern Front in the Battle of Stalingrad where it ended up being encircled and almost annihilated by the Red Army. In February 1943 the division counted as few as 5,206 men, 206 of them being men of the 2nd Alpini Regiment, who by then had walked 200 km, fought in 20 battles and spent 11 nights camped out in the middle of the Russian Steppe. After the signing of the Italian armistice with the Allies in September 1943, the regiment was disbanded."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Expansion2019","isInPermanentPool":true,"hasDeployment":true,"hasAlpine":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion02'","ObjectPath":"kards/Content/StarterContent/Audio/Explosion02.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Italy/t_alpini_2.t_alpini_2","SubPathString":""},"artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/2nd_ALPINI_REGIMENT.2nd_ALPINI_REGIMENT","SubPathSt