{"format":"kards-original-reference","version":1,"id":"d5d0468fac357f0a","name":"card_event_grim_day","package":"/Game/Blueprints/Cards/USA/WinterWar/events/card_event_grim_day","parent":"UBaseCardObject","card":{"title":"GRIM DAY","text":"Until your next turn, it costs +2 kredits for the enemy to target or attack your units.","flavorText":"The Battle for Convoy ONS-5 which took place in May 1943 is considered the turning point of the Battle of the Atlantic. The ONS-5 convoy consisted of 42 ships and 16 US and British escort vessels -bound from Liverpool to Halifax. On the opposing side were 40 U-boats under the command of Admiral Karl Dönitz which attacked the convoy relentlessly over the course of a week. During the battle the Germans managed to sink 13 ships totaling 63,000 tons, while the Allied escort vessels sunk 6 U-boats and caused significant damage to 7 more. This engagement served as clear evidence that the convoy escorts had honed their skills in safeguarding convoys. Their armaments and expertise not only enabled them to protect the convoys and fend off attackers, but also allowed them to deal heavy damages to the enemy. Following this encounter, the Allies achieved a string of victories and inflicted substantial casualties on the U-boat fleet, a period referred to by the German Kriegsmarine as \"Black May.\" This ultimately led Admiral Karl Dönitz to withdraw his forces from the North Atlantic theater.","faction":"USA","type":"order","rarity":"Common","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_grim_day","title":{"Namespace":"card_usa","Key":"card_event_grim_day_title","SourceString":"GRIM DAY","LocalizedString":"GRIM DAY"},"Type":"ETypeEnum::order","faction":"EFactionEnum::USA","kredits":1,"Text":{"Namespace":"card_usa","Key":"card_event_grim_day_text","SourceString":"Until your next turn, it costs +2 kredits for the enemy to target or attack your units.","LocalizedString":"Until your next turn, it costs +2 kredits for the enemy to target or attack your units."},"flavorText":{"Namespace":"card_usa","Key":"card_event_grim_day_history","SourceString":"The Battle for Convoy ONS-5 which took place in May 1943 is considered the turning point of the Battle of the Atlantic. The ONS-5 convoy consisted of 42 ships and 16 US and British escort vessels -bound from Liverpool to Halifax. On the opposing side were 40 U-boats under the command of Admiral Karl Dönitz which attacked the convoy relentlessly over the course of a week. During the battle the Germans managed to sink 13 ships totaling 63,000 tons, while the Allied escort vessels sunk 6 U-boats and caused significant damage to 7 more. This engagement served as clear evidence that the convoy escorts had honed their skills in safeguarding convoys. Their armaments and expertise not only enabled them to protect the convoys and fend off attackers, but also allowed them to deal heavy damages to the enemy. Following this encounter, the Allies achieved a string of victories and inflicted substantial casualties on the U-boat fleet, a period referred to by the German Kriegsmarine as \"Black May.\" This ultimately led Admiral Karl Dönitz to withdraw his forces from the North Atlantic theater.","LocalizedString":"The Battle for Convoy ONS-5 which took place in May 1943 is considered the turning point of the Battle of the Atlantic. The ONS-5 convoy consisted of 42 ships and 16 US and British escort vessels -bound from Liverpool to Halifax. On the opposing side were 40 U-boats under the command of Admiral Karl Dönitz which attacked the convoy relentlessly over the course of a week. During the battle the Germans managed to sink 13 ships totaling 63,000 tons, while the Allied escort vessels sunk 6 U-boats and caused significant damage to 7 more. This engagement served as clear evidence that the convoy escorts had honed their skills in safeguarding convoys. Their armaments and expertise not only enabled them to protect the convoys and fend off attackers, but also allowed them to deal heavy damages to the enemy. Following this encounter, the Allies achieved a string of victories and inflicted substantial casualties on the U-boat fleet, a period referred to by the German Kriegsmarine as \"Black May.\" This ultimately led Admiral Karl Dönitz to withdraw his forces from the North Atlantic theater."},"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::WinterWar","isReserved":true,"usedTriggers":["ERegisteredCardFunction::OnOtherCardEnterPlay","ERegisteredCardFunction::OnStartofTurn"],"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/CandidateArtwork/Winter_War/t_grim_day.t_grim_day","SubPathString":""},"artist":"Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/GRIM_DAY.GRIM_DAY","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":407.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_event_grim_day_photo","SourceString":"The sinking of German U-boat U-175 by USCGC Spencer, April 1943.","LocalizedString":"The sinking of German U-boat U-175 by USCGC Spencer, April 1943."},"OnPlayedFromHandVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_OrderDiveBomber.BP_OrderDiveBomber_C","SubPathString":""},"isRemoval":true},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_event_grim_day","owner":"card_event_grim_day_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_GetAllCardsOnBoard_cards",