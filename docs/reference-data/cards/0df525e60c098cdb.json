{"format":"kards-original-reference","version":1,"id":"0df525e60c098cdb","name":"card_unit_3rd_mixed_regiment","package":"/Game/Blueprints/Cards/Japan/NavalWarfare/units/card_unit_3rd_mixed_regiment","parent":"UBaseCardObject","card":{"title":"3rd MIXED REGIMENT","text":"Once per turn, deal 2 damage to the enemy HQ when you shuffle your deck.","flavorText":"The 3rd Mixed Regiment was a unit of the 38th Division of the Imperial Japanese Army. The division was formed in 1939 and deployed in southern China before being redirected for operations across the Pacific and Southeast Asia. In December 1941 the 38th Division took part in the invasion of Hong Kong. It was involved in a rapid offensive launched from the mainland and played a major role in breaking British defenses on the Kowloon Peninsula. Subsequently, the division crossed the Kowloon Bay into Hong Kong Island, and after a week of intense fighting, the Allied garrison surrendered on Christmas Day. Following the fall of Hong Kong, the regiment was involved in garrison duties and regional security operations. Later, elements of the 38th Division, including the 3rd Mixed Regiment, participated in campaigns in the Dutch East Indies and the Philippines. Throughout the war the division suffered heavy casualties, and the remainder of the men capitulated following the Japanese surrender in August 1945.","faction":"Japan","type":"infantry","rarity":"Common","cost":3,"operationCost":1,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_3rd_mixed_regiment","title":{"Namespace":"card_japan","Key":"card_unit_3rd_mixed_regiment_title","SourceString":"3rd MIXED REGIMENT","LocalizedString":"3rd MIXED REGIMENT"},"Type":"ETypeEnum::infantry","attack":3,"defense":4,"range":1,"faction":"EFactionEnum::Japan","kredits":3,"Text":{"Namespace":"card_japan","Key":"card_unit_3rd_mixed_regiment_text","SourceString":"Once per turn, deal 2 damage to the enemy HQ when you shuffle your deck.","LocalizedString":"Once per turn, deal 2 damage to the enemy HQ when you shuffle your deck."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_3rd_mixed_regiment_history","SourceString":"The 3rd Mixed Regiment was a unit of the 38th Division of the Imperial Japanese Army. The division was formed in 1939 and deployed in southern China before being redirected for operations across the Pacific and Southeast Asia. In December 1941 the 38th Division took part in the invasion of Hong Kong. It was involved in a rapid offensive launched from the mainland and played a major role in breaking British defenses on the Kowloon Peninsula. Subsequently, the division crossed the Kowloon Bay into Hong Kong Island, and after a week of intense fighting, the Allied garrison surrendered on Christmas Day. Following the fall of Hong Kong, the regiment was involved in garrison duties and regional security operations. Later, elements of the 38th Division, including the 3rd Mixed Regiment, participated in campaigns in the Dutch East Indies and the Philippines. Throughout the war the division suffered heavy casualties, and the remainder of the men capitulated following the Japanese surrender in August 1945.","LocalizedString":"The 3rd Mixed Regiment was a unit of the 38th Division of the Imperial Japanese Army. The division was formed in 1939 and deployed in southern China before being redirected for operations across the Pacific and Southeast Asia. In December 1941 the 38th Division took part in the invasion of Hong Kong. It was involved in a rapid offensive launched from the mainland and played a major role in breaking British defenses on the Kowloon Peninsula. Subsequently, the division crossed the Kowloon Bay into Hong Kong Island, and after a week of intense fighting, the Allied garrison surrendered on Christmas Day. Following the fall of Hong Kong, the regiment was involved in garrison duties and regional security operations. Later, elements of the 38th Division, including the 3rd Mixed Regiment, participated in campaigns in the Dutch East Indies and the Philippines. Throughout the war the division suffered heavy casualties, and the remainder of the men capitulated following the Japanese surrender in August 1945."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::NavalWarfare","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn","ERegisteredCardFunction::OnDeckShuffled"],"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/NavalWarfare/t_3rd_mixed_regiment.t_3rd_mixed_regiment","SubPathString":""},"artist":"Japanese WWII Postcard","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/3rd_MIXED_REGIMENT.3rd_MIXED_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":338.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_3rd_mixed_regiment_photo","SourceString":"Japanese troops during the Battle of Hong Kong, December 1941.","LocalizedString":"Japanese troops during the Battle of Hong Kong, December 1941."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"Notes":"Image from Y.Takani not licensed yet","isHQDamage":true,"threat_level":0.1},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_3rd_mixed_regiment","owner":"card_unit_3rd_mixed_regiment_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"K2Node_Event_deckSide","type":"ESideEnum","direction":"in"},{"name":"K2Node_Event_instigatorCard","type":"UBaseCardObject*","direction":"in"},{"nam