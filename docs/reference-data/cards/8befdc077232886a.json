{"format":"kards-original-reference","version":1,"id":"8befdc077232886a","name":"card_event_night_witches","package":"/Game/Blueprints/Cards/Soviet/Allegiance/events/card_event_night_witches","parent":"UBaseCardObject","card":{"title":"NIGHT WITCHES","text":"Add three POLIKARPOV PO-2-II to your hand.","flavorText":"Night Witches, or “die Nachthexen”, was a German nickname for the female pilots of the 588th Night Bomber Regiment of the Soviet Air Force. The regiment carried out harassment bombing raids and precision bombing missions and flew over 23,000 sorties, dropping over 3,000 tons of bombs and 26,000 incendiary shells on Axis targets. They flew Polikarpov U-2 biplanes, which were slow but maneuverable, however, since they could only carry two bombs at a time, each pilot often had to fly eight or more missions per night. The regiment was raised to guards status in 1943 and became known as the 46th \"Taman\" Guards Night Bomber Aviation Regiment.","faction":"Soviet","type":"order","rarity":"Unique","cost":3,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_night_witches","title":{"Namespace":"card_soviet","Key":"card_event_night_witches_title","SourceString":"NIGHT WITCHES","LocalizedString":"NIGHT WITCHES"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Soviet","kredits":3,"Text":{"Namespace":"card_soviet","Key":"card_event_night_witches_text","SourceString":"Add three POLIKARPOV PO-2-II to your hand.","LocalizedString":"Add three POLIKARPOV PO-2-II to your hand."},"flavorText":{"Namespace":"card_soviet","Key":"card_event_night_witches_history","SourceString":"Night Witches, or “die Nachthexen”, was a German nickname for the female pilots of the 588th Night Bomber Regiment of the Soviet Air Force. The regiment carried out harassment bombing raids and precision bombing missions and flew over 23,000 sorties, dropping over 3,000 tons of bombs and 26,000 incendiary shells on Axis targets. They flew Polikarpov U-2 biplanes, which were slow but maneuverable, however, since they could only carry two bombs at a time, each pilot often had to fly eight or more missions per night. The regiment was raised to guards status in 1943 and became known as the 46th \"Taman\" Guards Night Bomber Aviation Regiment.","LocalizedString":"Night Witches, or “die Nachthexen”, was a German nickname for the female pilots of the 588th Night Bomber Regiment of the Soviet Air Force. The regiment carried out harassment bombing raids and precision bombing missions and flew over 23,000 sorties, dropping over 3,000 tons of bombs and 26,000 incendiary shells on Axis targets. They flew Polikarpov U-2 biplanes, which were slow but maneuverable, however, since they could only carry two bombs at a time, each pilot often had to fly eight or more missions per night. The regiment was raised to guards status in 1943 and became known as the 46th \"Taman\" Guards Night Bomber Aviation Regiment."},"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::Expansion2019","isReserved":true,"spawnCardName":"card_unit_polikarpov_po_2_ii;card_event_from_the_people","soundEnterPlay":{"ObjectName":"SoundWave'October_Red'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/October_Red.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/t_nachthexen.t_nachthexen","SubPathString":""},"artist":"Mitchell Nolte","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/NIGHT_WITCHES.NIGHT_WITCHES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":314.0},"historyPhotoSource":"http://goskatalog.ru/portal/#/collections?id=6924799","historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_event_night_witches_photo","SourceString":"The 588th Night Bomber Regiment in 1942.","LocalizedString":"The 588th Night Bomber Regiment in 1942."},"isAttackBuff":true,"isDefenseBuff":true},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_event_night_witches","owner":"card_event_night_wit