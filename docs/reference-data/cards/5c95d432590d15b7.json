{"format":"kards-original-reference","version":1,"id":"5c95d432590d15b7","name":"card_unit_shibata_regiment","package":"/Game/Blueprints/Cards/Japan/Allegiance/units/card_unit_shibata_regiment","parent":"UBaseCardObject","card":{"title":"SHIBATA REGIMENT","text":"When the enemy gives an order, deal 1 damage to the enemy HQ.","flavorText":"The 16th Infantry Regiment Shibata was part of the 2nd Division of the Imperial Japanese Army. The division was formed in 1871 and participated in several engagements in the First Sino-Japanese War and the Russo-Japanese War. During the Pacific War the division was one of the first to occupy the Dutch East Indies, and in 1942 after the surrender of Dutch forces, it was transferred to Papua New Guinea. From there the 2nd Division was sent to Guadalcanal where it fought in the Battle for Henderson Field and later the Battle for Guadalcanal, where it lost almost 7,000 men. The division was deployed to garrison duty in Malaya and Singapore, and was deployed to Burma in 1944 where it was almost annihilated in the conflict against the Allies. The survivors were assigned to the Japanese 38th Army in French Indochina where it was disbanded at the end of WWII.","faction":"Japan","type":"infantry","rarity":"Common","cost":1,"operationCost":1,"attack":1,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_shibata_regiment","title":{"Namespace":"card_japan","Key":"card_unit_shibata_regiment_title","SourceString":"SHIBATA REGIMENT","LocalizedString":"SHIBATA REGIMENT"},"Type":"ETypeEnum::infantry","attack":1,"defense":3,"range":1,"faction":"EFactionEnum::Japan","kredits":1,"Text":{"Namespace":"card_japan","Key":"card_unit_shibata_regiment_text","SourceString":"When the enemy gives an order, deal 1 damage to the enemy HQ.","LocalizedString":"When the enemy gives an order, deal 1 damage to the enemy HQ."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_shibata_regiment_history","SourceString":"The 16th Infantry Regiment Shibata was part of the 2nd Division of the Imperial Japanese Army. The division was formed in 1871 and participated in several engagements in the First Sino-Japanese War and the Russo-Japanese War. During the Pacific War the division was one of the first to occupy the Dutch East Indies, and in 1942 after the surrender of Dutch forces, it was transferred to Papua New Guinea. From there the 2nd Division was sent to Guadalcanal where it fought in the Battle for Henderson Field and later the Battle for Guadalcanal, where it lost almost 7,000 men. The division was deployed to garrison duty in Malaya and Singapore, and was deployed to Burma in 1944 where it was almost annihilated in the conflict against the Allies. The survivors were assigned to the Japanese 38th Army in French Indochina where it was disbanded at the end of WWII.","LocalizedString":"The 16th Infantry Regiment Shibata was part of the 2nd Division of the Imperial Japanese Army. The division was formed in 1871 and participated in several engagements in the First Sino-Japanese War and the Russo-Japanese War. During the Pacific War the division was one of the first to occupy the Dutch East Indies, and in 1942 after the surrender of Dutch forces, it was transferred to Papua New Guinea. From there the 2nd Division was sent to Guadalcanal where it fought in the Battle for Henderson Field and later the Battle for Guadalcanal, where it lost almost 7,000 men. The division was deployed to garrison duty in Malaya and Singapore, and was deployed to Burma in 1944 where it was almost annihilated in the conflict against the Allies. The survivors were assigned to the Japanese 38th Army in French Indochina where it was disbanded at the end of WWII."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Expansion2019","returnSet":"ECardSetEnum::CurrentExpansion","showBoostIcon":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnBeforeOtherCardPlayedFromHand"],"extraHelpTex