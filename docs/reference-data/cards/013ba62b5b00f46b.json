{"format":"kards-original-reference","version":1,"id":"013ba62b5b00f46b","name":"card_unit_1st_florida","package":"/Game/Blueprints/Cards/USA/Homefront/units/card_unit_1st_florida","parent":"UBaseCardObject","card":{"title":"1st FLORIDA","text":"Destruction: A random friendly unit gets attack and defense equal to the attack of this unit.","flavorText":"Nicknamed “First Florida,” the 124th Infantry Regiment traces its roots to the Florida State Troops in the late 1800s. After service in the Spanish–American War and the Pancho Villa Expedition, the regiment was reorganized and activated for duty in both world wars. In WWI, it joined the 31st Division, but its soldiers were mostly used as replacements in France. In WWII, the 124th rejoined the 31st Infantry Division and trained at Camp Blanding, Florida. It deployed to the Pacific theater, participating in key campaigns in Dutch New Guinea and the Philippines. At the Battle of Morotai in 1944, the regiment helped establish a vital airbase against constant Japanese resistance. This operation enabled further Allied advances into the southern Philippines. Later, during the Mindanao campaign, the 124th saw some of its toughest fighting, clearing entrenched Japanese positions in dense jungle. For its actions, the regiment was awarded the Presidential Unit Citation and the Philippine Presidential Unit Citation. Throughout the war, the men of the 124th upheld their motto, “Florida and Country,” with distinction.","faction":"USA","type":"infantry","rarity":"Common","cost":5,"operationCost":1,"attack":4,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_1st_florida","title":{"Namespace":"card_usa","Key":"card_unit_1st_florida_title","SourceString":"1st FLORIDA","LocalizedString":"1st FLORIDA"},"Type":"ETypeEnum::infantry","attack":4,"defense":4,"range":1,"faction":"EFactionEnum::USA","kredits":5,"Text":{"Namespace":"card_usa","Key":"card_unit_1st_florida_text","SourceString":"Destruction: A random friendly unit gets attack and defense equal to the attack of this unit.","LocalizedString":"Destruction: A random friendly unit gets attack and defense equal to the attack of this unit."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_1st_florida_history","SourceString":"Nicknamed “First Florida,” the 124th Infantry Regiment traces its roots to the Florida State Troops in the late 1800s. After service in the Spanish–American War and the Pancho Villa Expedition, the regiment was reorganized and activated for duty in both world wars. In WWI, it joined the 31st Division, but its soldiers were mostly used as replacements in France. In WWII, the 124th rejoined the 31st Infantry Division and trained at Camp Blanding, Florida. It deployed to the Pacific theater, participating in key campaigns in Dutch New Guinea and the Philippines. At the Battle of Morotai in 1944, the regiment helped establish a vital airbase against constant Japanese resistance. This operation enabled further Allied advances into the southern Philippines. Later, during the Mindanao campaign, the 124th saw some of its toughest fighting, clearing entrenched Japanese positions in dense jungle. For its actions, the regiment was awarded the Presidential Unit Citation and the Philippine Presidential Unit Citation. Throughout the war, the men of the 124th upheld their motto, “Florida and Country,” with distinction.","LocalizedString":"Nicknamed “First Florida,” the 124th Infantry Regiment traces its roots to the Florida State Troops in the late 1800s. After service in the Spanish–American War and the Pancho Villa Expedition, the regiment was reorganized and activated for duty in both world wars. In WWI, it joined the 31st Division, but its soldiers were mostly used as replacements in France. In WWII, the 124th rejoined the 31st Infantry Division and trained at Camp Blanding, Florida. It deployed to the Pacific theater, participating in key campaigns in Dutch New Guinea and the Philippines. At the Battle of Morotai in 1944, the regiment helped establish a vital airbase against constant Japanese resistance. This operation enabled further Allied advances into the southern Philippines. Later, during the Mindanao campaign, the 124th saw some of its toughest fighting, clearing entrenched Japanese positions in dense jungle. For its actions, the regiment was awarded the Presidential Unit Citation and the Philippine Presidential Unit Citation. Throughout the war, the men of the 124th upheld their motto, “Florida and Country,” with distinction."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Homefront","hasDestruction":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/1st_FLORIDA.1st_FLORIDA","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_1st_florida_photo","SourceString":"Men of the 31st Division landing at Morotai Island, September 1944.","LocalizedString":"Men of the 31st Division landing at Morotai Island, September 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"possibleUnits","type":"TArray<UBaseCardObject*>","direction":"in"},{"name":"destroyer","type":"UBaseCardObject*","direction":"in"},{"name":"tempCard","type":"UBaseCardObject*","direction":"in"},{"name":"attackValue","type":"int32","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_1st_florida","owner":"card_unit_1st_florida_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":