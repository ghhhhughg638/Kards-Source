{"format":"kards-original-reference","version":1,"id":"2fbf210d3db66d07","name":"card_unit_light_detachment_15","package":"/Game/Blueprints/Cards/Finland/units/card_unit_light_detachment_15","parent":"UBaseCardObject","card":{"title":"LIGHT DETACHMENT 15","text":"Gets +1 attack when a unit with higher attack is deployed.","flavorText":"Light Detachment 15 was part of the 7th Division (7. Divisioona) of the Finnish Army, nicknamed the \"Sword Division,\" and was active during the Continuation War (1941–1944). It was formed with men from the Northern Savonia and North Karelia civil guard districts and was part of the VII Corps under the Army of Karelia. In July 1941, the division advanced to the Matkaselkä Railway and it captured Sortavala on August 8. It continued eastward, aiding in the capture of Petrozavodsk and reaching the Svir River by October. In July 1944, during the Soviet Svir-Petrozavodsk Offensive, the division fought a delaying action from the Svir River to Petrozavodsk and eventually to the Sortavala region. The 7th Division suffered 12,384 casualties during the war, the second-highest among Finnish divisions.","faction":"Finland","type":"infantry","rarity":"Common","cost":1,"operationCost":1,"attack":0,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_light_detachment_15","title":{"Namespace":"card_finland","Key":"card_unit_light_detachment_15_title","SourceString":"LIGHT DETACHMENT 15","LocalizedString":"LIGHT DETACHMENT 15"},"Type":"ETypeEnum::infantry","defense":4,"range":1,"faction":"EFactionEnum::Finland","kredits":1,"Text":{"Namespace":"card_finland","Key":"card_unit_light_detachment_15_text","SourceString":"Gets +1 attack when a unit with higher attack is deployed.","LocalizedString":"Gets +1 attack when a unit with higher attack is deployed."},"flavorText":{"Namespace":"card_finland","Key":"card_unit_light_detachment_15_history","SourceString":"Light Detachment 15 was part of the 7th Division (7. Divisioona) of the Finnish Army, nicknamed the \"Sword Division,\" and was active during the Continuation War (1941–1944). It was formed with men from the Northern Savonia and North Karelia civil guard districts and was part of the VII Corps under the Army of Karelia. In July 1941, the division advanced to the Matkaselkä Railway and it captured Sortavala on August 8. It continued eastward, aiding in the capture of Petrozavodsk and reaching the Svir River by October. In July 1944, during the Soviet Svir-Petrozavodsk Offensive, the division fought a delaying action from the Svir River to Petrozavodsk and eventually to the Sortavala region. The 7th Division suffered 12,384 casualties during the war, the second-highest among Finnish divisions.","LocalizedString":"Light Detachment 15 was part of the 7th Division (7. Divisioona) of the Finnish Army, nicknamed the \"Sword Division,\" and was active during the Continuation War (1941–1944). It was formed with men from the Northern Savonia and North Karelia civil guard districts and was part of the VII Corps under the Army of Karelia. In July 1941, the division advanced to the Matkaselkä Railway and it captured Sortavala on August 8. It continued eastward, aiding in the capture of Petrozavodsk and reaching the Svir River by October. In July 1944, during the Soviet Svir-Petrozavodsk Offensive, the division fought a delaying action from the Svir River to Petrozavodsk and eventually to the Sortavala region. The 7th Division suffered 12,384 casualties during the war, the second-highest among Finnish divisions."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::NavalWarfare","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"draftBaseWeight":0.9,"hasGuard":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Finland/Naval_Warfare/t_light_detachment_16.t_light_detachment_16","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"