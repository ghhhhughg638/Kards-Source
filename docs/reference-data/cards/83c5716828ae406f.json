{"format":"kards-original-reference","version":1,"id":"83c5716828ae406f","name":"card_unit_p40n","package":"/Game/Blueprints/Cards/USA/Base/units/card_unit_p40n","parent":"UBaseCardObject","card":{"title":"P-40 N-5","text":"Units deployed by the enemy have +2 operation cost.","flavorText":"The P-40 N was introduced in 1943 and became the most produced variant of the Curtiss P-40 Warhawk, with 5220 aircraft built. This variant was made lighter than its predecessor, the undercarriage wheels were made smaller, two guns were removed and aluminum radiators and oil coolers were installed. This made the P-40 N the fastest Warhawk, reaching a speed of 378 mph below 12,000 feet. Many of the P-40 Ns were shipped to Allied air forces under Lend-Lease and many were sent to the USSR. Most of the P-40 Ns operational flying took place in the Pacific Theater in fighter-bomber or escort roles, both by the Americans and other Allied air forces.","faction":"USA","type":"fighter","rarity":"Unique","cost":4,"operationCost":2,"attack":4,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_p40n","title":{"Namespace":"card_usa","Key":"card_unit_p40n_title","SourceString":"P-40 N-5","LocalizedString":"P-40 N-5"},"Type":"ETypeEnum::fighter","attack":4,"defense":3,"range":2,"faction":"EFactionEnum::USA","kredits":4,"Text":{"Namespace":"card_usa","Key":"card_unit_p40n_text","SourceString":"Units deployed by the enemy have +2 operation cost.","LocalizedString":"Units deployed by the enemy have +2 operation cost."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_p40n_history","SourceString":"The P-40 N was introduced in 1943 and became the most produced variant of the Curtiss P-40 Warhawk, with 5220 aircraft built. This variant was made lighter than its predecessor, the undercarriage wheels were made smaller, two guns were removed and aluminum radiators and oil coolers were installed. This made the P-40 N the fastest Warhawk, reaching a speed of 378 mph below 12,000 feet. Many of the P-40 Ns were shipped to Allied air forces under Lend-Lease and many were sent to the USSR. Most of the P-40 Ns operational flying took place in the Pacific Theater in fighter-bomber or escort roles, both by the Americans and other Allied air forces.","LocalizedString":"The P-40 N was introduced in 1943 and became the most produced variant of the Curtiss P-40 Warhawk, with 5220 aircraft built. This variant was made lighter than its predecessor, the undercarriage wheels were made smaller, two guns were removed and aluminum radiators and oil coolers were installed. This made the P-40 N the fastest Warhawk, reaching a speed of 378 mph below 12,000 feet. Many of the P-40 Ns were shipped to Allied air forces under Lend-Lease and many were sent to the USSR. Most of the P-40 Ns operational flying took place in the Pacific Theater in fighter-bomber or escort roles, both by the Americans and other Allied air forces."},"operationCost":2,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::Basic","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Trigger"],"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/t_p40_ground_attack.t_p40_ground_attack","SubPathString":""},"artist":"Roy Grinnell","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/P-40_N.P-40_N","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":375.0},"historyPhotoSource":"USAAF Photo via Hagdedorn","historyPhotoAuthor":"United States Air Force","historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_p40n_photo","SourceString":"Curtiss P-40N Warhawk's flying in formation, Panama, 1944.","LocalizedString":"Curtiss P-40N Warhawk's flying in formation, Panama, 1944."},"historyTypeDescription":{"Name