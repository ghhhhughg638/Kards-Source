{"format":"kards-original-reference","version":1,"id":"4c39f999fa1bdadd","name":"card_unit_maus","package":"/Game/Blueprints/Cards/Germany/BloodIron/units/card_unit_maus","parent":"UBaseCardObject","card":{"title":"MAUS","text":"Deployment: Destroy all units with cost 3 or less. Deal 2 damage to an enemy for each.","flavorText":"Panzerkampfwagen VIII Maus is the heaviest fully enclosed armored fighting vehicle ever built. Weighing 188 tons, it had up to 220mm thick armor. Its main armament was a 128 mm gun firing a 28 kg shell, with a coaxial 75 mm gun as well as a machine gun. Initially it was named Mammut, then it was changed to Mäuschen (little mouse) and finally to Maus. Meaning the largest tank ever built was called mouse. On paper this was a battle winning weapon. Yet it was fraught with problems. The primary issue was to develop an engine and drivetrain powerful enough for such a large and heavy tank, and still fit inside it. The solution was a hybrid drive, using an internal combustion engine to produce electricity powering the motor units driving the tracks. Its top speed was 22 km/h. The second concern was that the Maus immense weight made it unable to use most bridges, which meant it had to ford or submerge in rivers to a depth up to 8 m using a snorkel. In the end only two prototypes were built before all work was stopped in August 1944. After the war the Soviets captured the first hull and mated it with the turret of the second Maus. The sole remaining Maus is now on display at the Kubinka tank Museum.","faction":"Germany","type":"tank","rarity":"Unique","cost":12,"operationCost":4,"attack":12,"defense":10},"defaults":{"UberGraphFrame":{},"Name":"card_unit_maus","title":{"Namespace":"card_germany","Key":"card_unit_maus_title","SourceString":"MAUS","LocalizedString":"MAUS"},"Type":"ETypeEnum::tank","attack":12,"defense":10,"range":1,"faction":"EFactionEnum::Germany","kredits":12,"Text":{"Namespace":"card_germany","Key":"card_unit_maus_text","SourceString":"Deployment: Destroy all units with cost 3 or less. Deal 2 damage to an enemy for each.","LocalizedString":"Deployment: Destroy all units with cost 3 or less. Deal 2 damage to an enemy for each."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_maus_history","SourceString":"Panzerkampfwagen VIII Maus is the heaviest fully enclosed armored fighting vehicle ever built. Weighing 188 tons, it had up to 220mm thick armor. Its main armament was a 128 mm gun firing a 28 kg shell, with a coaxial 75 mm gun as well as a machine gun. Initially it was named Mammut, then it was changed to Mäuschen (little mouse) and finally to Maus. Meaning the largest tank ever built was called mouse. On paper this was a battle winning weapon. Yet it was fraught with problems. The primary issue was to develop an engine and drivetrain powerful enough for such a large and heavy tank, and still fit inside it. The solution was a hybrid drive, using an internal combustion engine to produce electricity powering the motor units driving the tracks. Its top speed was 22 km/h. The second concern was that the Maus immense weight made it unable to use most bridges, which meant it had to ford or submerge in rivers to a depth up to 8 m using a snorkel. In the end only two prototypes were built before all work was stopped in August 1944. After the war the Soviets captured the first hull and mated it with the turret of the second Maus. The sole remaining Maus is now on display at the Kubinka tank Museum.","LocalizedString":"Panzerkampfwagen VIII Maus is the heaviest fully enclosed armored fighting vehicle ever built. Weighing 188 tons, it had up to 220mm thick armor. Its main armament was a 128 mm gun firing a 28 kg shell, with a coaxial 75 mm gun as well as a machine gun. Initially it was named Mammut, then it was changed to Mäuschen (little mouse) and finally to Maus. Meaning the largest tank ever built was called mouse. On paper this was a battle winning weapon. Yet it was fraught with problems. The primary issue was to develop an engine and drivetrain powerful enough for such a large and heavy tank, and still fit inside it. The solution was a hybrid drive, using an internal combustion engine to produce electricity powering the motor units driving the tracks. Its top speed was 22 km/h. The second concern was that the Maus immense weight made it unable to use most bridges, which meant it had to ford or submerge in rivers to a depth up to 8 m using a snorkel. In the end only two prototypes were built before all work was stopped in August 1944. After the war the Soviets captured the first hull and mated it with the turret of the second Maus. The sole remaining Maus is now on display at the Kubinka tank Museum."},"operationCost":4,"rarity":"ERarityEnum::Unique","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::BloodAndIron","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"heavyArmor":3,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/Winter_2024/t_maus.t_maus","SubPathString":""},"artist":"1518 Studios","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/Maus.Maus","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":389.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_maus_photo","SourceString":"Maus during trials.","LocalizedString":"Maus during trials."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionArmourL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionArmourL.36"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Tanks/BP_AttackTank.BP_AttackTank_C","SubPathString":""}},"variables":[{"name":"cardsToDestroy","type":"TArray<int32>","direction":"in"},{"name":"count","type":"int32","direction":"in"},{"name":"tmpTarget","type":"UBaseCardObject*","directio