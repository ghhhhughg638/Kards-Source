{"format":"kards-original-reference","version":1,"id":"905a79b793e76960","name":"card_unit_valentine_mk_ii","package":"/Game/Blueprints/Cards/Britain/Homefront/units/card_unit_valentine_mk_ii","parent":"UBaseCardObject","card":{"title":"VALENTINE Mk II","text":"Deployment: Gets Blitz if you deployed a British infantry last turn.","flavorText":"The Mk II was the first version of the Valentine tank to be fitted with a diesel engine, replacing the petrol engine used in the Mk I. Based on the AEC Comet commercial vehicle’s engine, the diesel was chosen for better range and reliability. Introduced in 1940, the Mk II kept the same compact hull and 2 pounder gun in a two-man turret, but the change of engine significantly improved operational performance. The Mk II was rushed into production without prototype trials, as British industry scrambled to rearm after the evacuation at Dunkirk. By September 1940, over 100 had already been built. It began service in armoured divisions in Britain and arrived in North Africa in June 1941. Although undergunned by contemporary standards, the Mk II’s excellent mechanical reliability made it a favorite in desert conditions. During the advance from El Alamein to Tunisia, some Valentines covered more than 3,000 miles.The Mk II was also supplied in large numbers to the Soviet Union through the Lend Lease program. Crews valued its sturdy armor and dependable engine, even if the 2 pounder gun quickly became obsolete in frontline combat.","faction":"Britain","type":"tank","rarity":"Common","cost":2,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.bond"],"Name":"card_unit_valentine_mk_ii","title":{"Namespace":"card_britain","Key":"card_unit_valentine_mk_ii_title","SourceString":"VALENTINE Mk II","LocalizedString":"VALENTINE Mk II"},"Type":"ETypeEnum::tank","attack":2,"defense":3,"range":1,"faction":"EFactionEnum::Britain","kredits":2,"Text":{"Namespace":"card_britain","Key":"card_unit_valentine_mk_ii_text","SourceString":"Deployment: Gets Blitz if you deployed a British infantry last turn.","LocalizedString":"Deployment: Gets Blitz if you deployed a British infantry last turn."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_valentine_mk_ii_history","SourceString":"The Mk II was the first version of the Valentine tank to be fitted with a diesel engine, replacing the petrol engine used in the Mk I. Based on the AEC Comet commercial vehicle’s engine, the diesel was chosen for better range and reliability. Introduced in 1940, the Mk II kept the same compact hull and 2 pounder gun in a two-man turret, but the change of engine significantly improved operational performance. The Mk II was rushed into production without prototype trials, as British industry scrambled to rearm after the evacuation at Dunkirk. By September 1940, over 100 had already been built. It began service in armoured divisions in Britain and arrived in North Africa in June 1941. Although undergunned by contemporary standards, the Mk II’s excellent mechanical reliability made it a favorite in desert conditions. During the advance from El Alamein to Tunisia, some Valentines covered more than 3,000 miles.The Mk II was also supplied in large numbers to the Soviet Union through the Lend Lease program. Crews valued its sturdy armor and dependable engine, even if the 2 pounder gun quickly became obsolete in frontline combat.","LocalizedString":"The Mk II was the first version of the Valentine tank to be fitted with a diesel engine, replacing the petrol engine used in the Mk I. Based on the AEC Comet commercial vehicle’s engine, the diesel was chosen for better range and reliability. Introduced in 1940, the Mk II kept the same compact hull and 2 pounder gun in a two-man turret, but the change of engine significantly improved operational performance. The Mk II was rushed into production without prototype trials, as British industry scrambled to rearm after the evacuation at Dunkirk. By September 1940, over 100 had already been built. It began service in armoured divisions in Britain and arrived in North Africa in June 1941. Although undergunned by contemporary standards, the Mk II’s excellent mechanical reliability made it a favorite in desert conditions. During the advance from El Alamein to Tunisia, some Valentines covered more than 3,000 miles.The Mk II was also supplied in large numbers to the Soviet Union through the Lend Lease program. Crews valued its sturdy armor and dependable engine, even if the 2 pounder gun quickly became obsolete in frontline combat."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Homefront","hasDeployment":true,"hasFury":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/VALENTINE_Mk_II.VALENTINE_Mk_II","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":483.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_unit_valentine_mk_ii_photo","SourceString":"Valentine tanks of the British Army, Tunisia, 15 February 1943.","LocalizedString":"Valentine tanks of the British Army, Tunisia, 15 February 1943."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionArmourS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionArmourS.31"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Tanks/BP_AttackTank.BP_AttackTank_C","SubPathString":""}},"variables":[{"name":"didPlayInfantry","type":"bool","direction":"in"}],"functions":[{"name":"didPlayBritishInfantryLastTurn","owner":"card_unit_valentine_mk_ii_C","params":[{"name":"didSo","type":"bool","direction":"out"}],"pure":true,"event":false,"flags":"FUNC_Public | FUNC_HasOutParms | FUNC_HasDefaults | FUNC_BlueprintCallable | FUNC_BlueprintEvent | FUNC_BlueprintPure","locals":[{"name":"Temp_int_Array_Index_Variable","type":"i