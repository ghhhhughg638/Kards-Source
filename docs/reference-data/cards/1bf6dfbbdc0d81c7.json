{"format":"kards-original-reference","version":1,"id":"1bf6dfbbdc0d81c7","name":"card_unit_56th_recon","package":"/Game/Blueprints/Cards/Japan/BrothersInArms/units/card_unit_56th_recon","parent":"UBaseCardObject","card":{"title":"56th RECON","text":"Destruction: Deal 1 damage to each enemy unit.","flavorText":"The 56th Reconnaissance Regiment was a motorized unit of the 56th Division of the Imperial Japanese Army which was active between 1940-1945. Initially, the 56th Division was intended as reinforcements for the Japanese invasion of Malaya but was attached to the 25th Army and sent to Burma in March 1942. The Division played a significant role in the Battle of Toungoo, where it linked with the 55th Division, and forced the Chinese to evacuate the city, paving the way to the east. The 56th Division defeated the Chinese 6th Corps in several battles, including Mawchi, Bawlake, Bato, Taunggyi, and Loikaw. It advanced north through the Shan States, took the city of Lashio, and cut off much of the local Chinese Army from China, forcing the Allies to evacuate Burma. After May 1942, the 56th Division mostly performed garrison duties on the Yunnan border. In January 1944, the division participated in the Battle of Northern Burma and Western Yunnan campaign, where it played a significant role in shattering Merrill's Marauders in the Siege of Myitkyina and delaying the Chinese forces during the Battle of Mount Song. The Division suffered heavy losses and was removed from the front line in October 1944. On the day of the surrender of Japan, August 15, 1945, the division was stationed on the border between South Burma and Thailand.","faction":"Japan","type":"infantry","rarity":"Uncommon","cost":1,"operationCost":1,"attack":2,"defense":1},"defaults":{"UberGraphFrame":{},"Name":"card_unit_56th_recon","title":{"Namespace":"card_japan","Key":"card_unit_56th_recon_title","SourceString":"56th RECON","LocalizedString":"56th RECON"},"Type":"ETypeEnum::infantry","attack":2,"defense":1,"range":1,"faction":"EFactionEnum::Japan","kredits":1,"Text":{"Namespace":"card_japan","Key":"card_unit_56th_recon_text","SourceString":"Destruction: Deal 1 damage to each enemy unit.","LocalizedString":"Destruction: Deal 1 damage to each enemy unit."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_56th_recon_history","SourceString":"The 56th Reconnaissance Regiment was a motorized unit of the 56th Division of the Imperial Japanese Army which was active between 1940-1945. Initially, the 56th Division was intended as reinforcements for the Japanese invasion of Malaya but was attached to the 25th Army and sent to Burma in March 1942. The Division played a significant role in the Battle of Toungoo, where it linked with the 55th Division, and forced the Chinese to evacuate the city, paving the way to the east. The 56th Division defeated the Chinese 6th Corps in several battles, including Mawchi, Bawlake, Bato, Taunggyi, and Loikaw. It advanced north through the Shan States, took the city of Lashio, and cut off much of the local Chinese Army from China, forcing the Allies to evacuate Burma. After May 1942, the 56th Division mostly performed garrison duties on the Yunnan border. In January 1944, the division participated in the Battle of Northern Burma and Western Yunnan campaign, where it played a significant role in shattering Merrill's Marauders in the Siege of Myitkyina and delaying the Chinese forces during the Battle of Mount Song. The Division suffered heavy losses and was removed from the front line in October 1944. On the day of the surrender of Japan, August 15, 1945, the division was stationed on the border between South Burma and Thailand.","LocalizedString":"The 56th Reconnaissance Regiment was a motorized unit of the 56th Division of the Imperial Japanese Army which was active between 1940-1945. Initially, the 56th Division was intended as reinforcements for the Japanese invasion of Malaya but was attached to the 25th Army and sent to Burma in March 1942. The Division played a significant role in the Battle of Toungoo, where it linked with the 55th Division, and forced the Chinese to evacuate the city, paving the way to the east. The 56th Division defeated the Chinese 6th Corps in several battles, including Mawchi, Bawlake, Bato, Taunggyi, and Loikaw. It advanced north through the Shan States, took the city of Lashio, and cut off much of the local Chinese Army from China, forcing the Allies to evacuate Burma. After May 1942, the 56th Division mostly performed garrison duties on the Yunnan border. In January 1944, the division participated in the Battle of Northern Burma and Western Yunnan campaign, where it played a significant role in shattering Merrill's Marauders in the Siege of Myitkyina and delaying the Chinese forces during the Battle of Mount Song. The Division suffered heavy losses and was removed from the front line in October 1944. On the day of the surrender of Japan, August 15, 1945, the division was stationed on the border between South Burma and Thailand."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::BrothersInArms","isReserved":true,"hasDestruction":true,"cipher":1,"soundBlowUp":{"ObjectName":"SoundWave'explosion_small_01'","ObjectPath":"kards/Content/ExplosionSoundPack/ExplosionSounds/Wavs/explosion_small_01.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/Spring2023Candidates/t_japanese_infantry_rifles.t_japanese_infantry_rifles","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/56th_RECON.56th_RECON","SubPathString":""},"historyPhotoSize":{"X":493.0,"Y":512.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_56th_recon_photo","SourceString":"Japanese troops in Burma, ca. 1941-1942.","LocalizedString":"Japanese troops in Burma, ca. 1941-1942."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"isDestroyed","type":"bool","direction":"in"},{"name":"cards_to_damage","type":"TArray<int32>","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_56th_recon","owner":"card_unit_56th_recon_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"CallFunc_GetOppositeSide_oppositeSide","type":"ESideEnum","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"K2Node_Event_killer","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_TriggerNotDestroyed","type":"bool","direction":"in"},{"name":"CallFunc_DamageMultipleCards_cardsDestroyed","type":"TArray<int32>","direction":"in"},{"name":"CallFunc_GetCardsOnBoardBySide_cards","type":"TArray<UBaseCardObject*>","direction":"in"},{"name":"CallFunc_Array_Length_ReturnValue","type":"int32","direction":"in"},{"name":"CallFunc_Array_Get_Item","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_Less_IntInt_ReturnValue","type":"bool","direction":"in"},{"name":"CallFunc_Array_Add_ReturnValue","type":"int32","direction":"in"}],"body":[{"op":"PushExecutionFlow","at":0,"to":629},{"op":"ComputedJump","at":5,"value":{"op":"Variable","name":"EntryPoint","type":"int32","scope":"local","sourceOp":"LocalVariable"}},{"op":"PushExecutionFlow","at":15,"to":170},{"op":"Context","at":20,"object":{"op":"ObjectConst","value":"Default__KismetArrayLibrary","path