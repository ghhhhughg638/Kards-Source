{"format":"kards-original-reference","version":1,"id":"fe58a537c043e1b2","name":"card_unit_kurmark_aufklarungs","package":"/Game/Blueprints/Cards/Germany/CovertOp/units/card_unit_kurmark_aufklarungs","parent":"UBaseCardObject","card":{"title":"KURMARK AUFKLÄRUNG","text":"Deployment: Choose a countermeasure in hand. Activate it at the end of your turn.","flavorText":"The Kurmark Aufklärungs-Abteilung was a battalion in the Panzergrenadier Division Kurmark, also known as Panzer Division Kurmark, which was an armored unit of the German Army formed in January 1945 in preparation for the Battle of Berlin. The division was named after the Kurmark region in the province of Brandenburg, and established in Frankfurt on the Oder from remains of the Panzergrenadier Division \"Großdeutschland\", an elite combat unit of the German army. It was understaffed and lacked sufficient motorized transport from the start, forcing some soldiers to use bicycles and horses. The division later found itself encircled with other Wehrmacht units southeast of Berlin. After exhausting their fuel, they were forced to abandon and destroy their remaining King Tiger tanks on April 30th, 1945. The surviving members of the Panzergrenadier Division Kurmark managed to escape and eventually surrendered to the US Army in Jerichow on the Elbe River in May 1945.","faction":"Germany","type":"infantry","rarity":"Rare","cost":3,"operationCost":1,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_kurmark_aufklarungs","title":{"Namespace":"card_germany","Key":"card_unit_kurmark_aufklarungs_title","SourceString":"KURMARK AUFKLÄRUNG","LocalizedString":"KURMARK AUFKLÄRUNG"},"Type":"ETypeEnum::infantry","attack":3,"defense":3,"range":1,"faction":"EFactionEnum::Germany","kredits":3,"Text":{"Namespace":"card_germany","Key":"card_unit_kurmark_aufklarungs_text","SourceString":"Deployment: Choose a countermeasure in hand. Activate it at the end of your turn.","LocalizedString":"Deployment: Choose a countermeasure in hand. Activate it at the end of your turn."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_kurmark_aufklarungs_history","SourceString":"The Kurmark Aufklärungs-Abteilung was a battalion in the Panzergrenadier Division Kurmark, also known as Panzer Division Kurmark, which was an armored unit of the German Army formed in January 1945 in preparation for the Battle of Berlin. The division was named after the Kurmark region in the province of Brandenburg, and established in Frankfurt on the Oder from remains of the Panzergrenadier Division \"Großdeutschland\", an elite combat unit of the German army. It was understaffed and lacked sufficient motorized transport from the start, forcing some soldiers to use bicycles and horses. The division later found itself encircled with other Wehrmacht units southeast of Berlin. After exhausting their fuel, they were forced to abandon and destroy their remaining King Tiger tanks on April 30th, 1945. The surviving members of the Panzergrenadier Division Kurmark managed to escape and eventually surrendered to the US Army in Jerichow on the Elbe River in May 1945.","LocalizedString":"The Kurmark Aufklärungs-Abteilung was a battalion in the Panzergrenadier Division Kurmark, also known as Panzer Division Kurmark, which was an armored unit of the German Army formed in January 1945 in preparation for the Battle of Berlin. The division was named after the Kurmark region in the province of Brandenburg, and established in Frankfurt on the Oder from remains of the Panzergrenadier Division \"Großdeutschland\", an elite combat unit of the German army. It was understaffed and lacked sufficient motorized transport from the start, forcing some soldiers to use bicycles and horses. The division later found itself encircled with other Wehrmacht units southeast of Berlin. After exhausting their fuel, they were forced to abandon and destroy their remaining King Tiger tanks on April 30th, 1945. The surviving members of the Panzergrenadier Division Kurmark managed to escape and eventually surrendered to the US Army in Jerichow on the Elbe River in May 1945."},"operationCost":1,"rarity":"ERarityEnum::Rare","waitWithOnOtherCardPlayedUntilHandTargetSelected":true,"selectHandCardNotifyText":{"Namespace":"","Key":"BC0A042841F37BB2E43359AECBBD9C61","SourceString":"Choose a countermeasure to activate.","LocalizedString":"Choose a countermeasure to activate."},"cardSet":"ECardSetEnum::CurrentExpansion","isReserved":true,"usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"draftBaseWeight":0.9,"suppressionExceptionTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"hasDeployment":true,"hasAlpine":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/CandidateArtwork/Summer_24/t_wiking_div.t_wiking_div","SubPathString":""},"artist":"WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/KURMARK_AUFKLARUNGS.KURMARK_AUFKLARUNGS","SubPathString":""},"historyPhotoSize":{"X":414.0,"Y":512.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_kurmark_aufklarungs_photo","SourceString":"Willy Langkeit, commander of Panzer Division Kurmark. Romania, May 1944.","LocalizedString":"Willy Langkeit, commander of Panzer Division Kurmark. Romania, May 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_kurmark_aufklarungs","owner":"card_unit_kurmark_aufklarungs_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphF