{"format":"kards-original-reference","version":1,"id":"24c835d7438fbb1b","name":"card_unit_murase_battalion","package":"/Game/Blueprints/Cards/Japan/OceaniaStorm/units/card_unit_murase_battalion","parent":"UBaseCardObject","card":{"title":"MURASE BATTALION","text":"Once per turn, gain 3 additional kredits when you lose a kredit slot.","flavorText":"The Murase Battalion was formally named 1st Battalion, 144th Infantry Regiment, and was led by Major Gohei Murase. The battalion belonged to the South Seas Detachment, a Japanese force sent into the Papuan campaign after earlier operations at Guam and Rabaul. In 1942, the unit took part in the fighting around the Kokoda Track and then withdrew across the Owen Stanley Range after its failed attempt to reach Port Moresby. By the time the battalion reached the northern coast of Papua, it had been badly weakened by combat, hunger, disease, and the harsh terrain. It then became one of the key Japanese formations defending the Sanananda and Giruwa area. Rather than deep trenches, the battalion relied on above-ground bunkers built from coconut tree logs and earth, because the water table was too high for normal fieldwork. These positions were difficult to detect and resisted small arms fire well. During the Allied advance in late 1942 and early 1943, the battalion held out under severe pressure. But by January 1943, it had largely ceased to exist as an organized unit.","faction":"Japan","type":"infantry","rarity":"Rare","cost":1,"operationCost":1,"attack":1,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_murase_battalion","title":{"Namespace":"card_japan","Key":"card_unit_murase_battalion_title","SourceString":"MURASE BATTALION","LocalizedString":"MURASE BATTALION"},"Type":"ETypeEnum::infantry","attack":1,"defense":3,"range":1,"faction":"EFactionEnum::Japan","kredits":1,"Text":{"Namespace":"card_japan","Key":"card_unit_murase_battalion_text","SourceString":"Once per turn, gain 3 additional kredits when you lose a kredit slot.","LocalizedString":"Once per turn, gain 3 additional kredits when you lose a kredit slot."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_murase_battalion_history","SourceString":"The Murase Battalion was formally named 1st Battalion, 144th Infantry Regiment, and was led by Major Gohei Murase. The battalion belonged to the South Seas Detachment, a Japanese force sent into the Papuan campaign after earlier operations at Guam and Rabaul. In 1942, the unit took part in the fighting around the Kokoda Track and then withdrew across the Owen Stanley Range after its failed attempt to reach Port Moresby. By the time the battalion reached the northern coast of Papua, it had been badly weakened by combat, hunger, disease, and the harsh terrain. It then became one of the key Japanese formations defending the Sanananda and Giruwa area. Rather than deep trenches, the battalion relied on above-ground bunkers built from coconut tree logs and earth, because the water table was too high for normal fieldwork. These positions were difficult to detect and resisted small arms fire well. During the Allied advance in late 1942 and early 1943, the battalion held out under severe pressure. But by January 1943, it had largely ceased to exist as an organized unit.","LocalizedString":"The Murase Battalion was formally named 1st Battalion, 144th Infantry Regiment, and was led by Major Gohei Murase. The battalion belonged to the South Seas Detachment, a Japanese force sent into the Papuan campaign after earlier operations at Guam and Rabaul. In 1942, the unit took part in the fighting around the Kokoda Track and then withdrew across the Owen Stanley Range after its failed attempt to reach Port Moresby. By the time the battalion reached the northern coast of Papua, it had been badly weakened by combat, hunger, disease, and the harsh terrain. It then became one of the key Japanese formations defending the Sanananda and Giruwa area. Rather than deep trenches, the battalion relied on above-ground bunkers built from coconut tree logs and earth, because the water table was too high for normal fieldwork. These positions were difficult to detect and resisted small arms fire well. During the Allied advance in late 1942 and early 1943, the battalion held out under severe pressure. But by January 1943, it had largely ceased to exist as an organized unit."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"hasSmokescreen":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/MURASE_BATTALION.MURASE_BATTALION","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_murase_battalion_photo","SourceString":"Japanese Soldiers in Papua New Guinea in 1942.","LocalizedString":"Japanese Soldiers in Papua New Guinea in 1942."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"threat_level":0.2},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_murase_battalion","owner":"card_unit_murase_battalion_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"K2Node_Event_cardGivingKredit","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_sideGaining","type":"ESideEnum","direction":"in"},{"name":"K2Node_Event_isNegativeGain","type":"bool","direction":"in"},{"name":"CallFunc_IsLocatedOnBoard_isIt","type":"bool","direction":"in"},{"name":"CallFunc_EqualEqual_By