{"format":"kards-original-reference","version":1,"id":"83e5d22c959fb377","name":"card_unit_me_bf_109_fin","package":"/Game/Blueprints/Cards/Finland/units/card_unit_me_bf_109_fin","parent":"UBaseCardObject","card":{"title":"ME BF 109 G FI","text":"When this unit attacks the enemy HQ, draw a card from the enemy deck. Discard it end of turn.","flavorText":"Finland acquired its first Bf 109 aircraft in March 1943 under a German-Finnish agreement, initially receiving 48 Bf 109 G-2s, followed by 111 G-6s and three G-8s (reconnaissance variant) by 1944. A total of 162 Bf 109s were procured for Finland, though three were lost during delivery. The Finnish Air Force used the Messerschmitt Bf 109 as its primary fighter aircraft during the Continuation War (1941–1944) against the Soviet Union. Finnish pilots found the Bf 109 to be a highly effective interceptor, with its superior speed, climb rate, and firepower making it a match against Soviet fighters like the Yak-9 and La-5. The aircraft played a key role in defending Finnish airspace, achieving aerial superiority in many battles. Finnish Bf 109 pilots were credited with shooting down over 600 enemy aircraft while suffering relatively low losses. After the war, Finland retained the Bf 109 in service until 1954, making it one of the last countries to operate the aircraft.","faction":"Finland","type":"fighter","rarity":"Uncommon","cost":3,"operationCost":2,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_me_bf_109_fin","title":{"Namespace":"card_finland","Key":"card_unit_me_bf_109_fin_title","SourceString":"ME BF 109 G FI","LocalizedString":"ME BF 109 G FI"},"Type":"ETypeEnum::fighter","attack":3,"defense":4,"range":2,"faction":"EFactionEnum::Finland","kredits":3,"Text":{"Namespace":"card_finland","Key":"card_unit_me_bf_109_fin_text","SourceString":"When this unit attacks the enemy HQ, draw a card from the enemy deck. Discard it end of turn.","LocalizedString":"When this unit attacks the enemy HQ, draw a card from the enemy deck. Discard it end of turn."},"flavorText":{"Namespace":"card_finland","Key":"card_unit_me_bf_109_fin_history","SourceString":"Finland acquired its first Bf 109 aircraft in March 1943 under a German-Finnish agreement, initially receiving 48 Bf 109 G-2s, followed by 111 G-6s and three G-8s (reconnaissance variant) by 1944. A total of 162 Bf 109s were procured for Finland, though three were lost during delivery. The Finnish Air Force used the Messerschmitt Bf 109 as its primary fighter aircraft during the Continuation War (1941–1944) against the Soviet Union. Finnish pilots found the Bf 109 to be a highly effective interceptor, with its superior speed, climb rate, and firepower making it a match against Soviet fighters like the Yak-9 and La-5. The aircraft played a key role in defending Finnish airspace, achieving aerial superiority in many battles. Finnish Bf 109 pilots were credited with shooting down over 600 enemy aircraft while suffering relatively low losses. After the war, Finland retained the Bf 109 in service until 1954, making it one of the last countries to operate the aircraft.","LocalizedString":"Finland acquired its first Bf 109 aircraft in March 1943 under a German-Finnish agreement, initially receiving 48 Bf 109 G-2s, followed by 111 G-6s and three G-8s (reconnaissance variant) by 1944. A total of 162 Bf 109s were procured for Finland, though three were lost during delivery. The Finnish Air Force used the Messerschmitt Bf 109 as its primary fighter aircraft during the Continuation War (1941–1944) against the Soviet Union. Finnish pilots found the Bf 109 to be a highly effective interceptor, with its superior speed, climb rate, and firepower making it a match against Soviet fighters like the Yak-9 and La-5. The aircraft played a key role in defending Finnish airspace, achieving aerial superiority in many battles. Finnish Bf 109 pilots were credited with shooting down over 600 enemy aircraft while suffering relatively low losses. After the war, Finland retained the Bf 109 in service until 1954, making it one of the last countries to operate the aircraft."},"operationCost":2,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::BloodAndIron","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn","ERegisteredCardFunction::OnOtherCardReset"],"draftBaseWeight":0.9,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Finland/Mini_Ally_Expansion_25/t_bf_109_g_fi.t_bf_109_g_fi","SubPathString":""},"artist":"Jarosław Wróbel","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/ME_BF_109_G_FI.ME_BF_109_G_FI","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":331.0},"historyPhotoDescription":{"Namespace":"card_finland","Key":"card_unit_me_bf_109_fin_photo","SourceString":"Finnish Bf 109 pilot and crew preparing for takeoff. Date unknown.","LocalizedString":"Finnish Bf 109 pilot and crew preparing for takeoff. Date unknown."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackFighter.BP_AttackFighter_C","SubPathString":""},"threat_level":0.1},"variables":[{"name":"opponentTopCard","type":"int32","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_me_bf_109_fin","owner":"card_unit_me_bf_109_fin_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"K2Node_Event_defenderCard","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_wasShockAttack","type