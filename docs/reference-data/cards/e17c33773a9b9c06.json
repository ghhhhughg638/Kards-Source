{"format":"kards-original-reference","version":1,"id":"e17c33773a9b9c06","name":"card_unit_qf_40mm_mk_iii","package":"/Game/Blueprints/Cards/Britain/Allegiance/units/card_unit_qf_40mm_mk_iii","parent":"UBaseCardObject","card":{"title":"QF 40mm Mk III","text":"Deployment: Duplicate this unit if you have damaged the enemy HQ this turn.","flavorText":"The QF 40mm Mk III gun, also referred to as the Bofors gun, was a Swedish made anti-aircraft auto-cannon designed in the 1930s. During WWII it was used in most theatres by the Allies, but also to some extent by the Axis powers. The QF 40 mm Mark III variant (QF stood for quick firing) was the standard light AA weapon of the British Army and considered vital in the defense of Britain and the Commonwealth countries after the fall of France. By the end of the war over 19,000 units had been produced and a small number of these weapons remain in service to this day.","faction":"Britain","type":"artillery","rarity":"Common","cost":3,"operationCost":1,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_qf_40mm_mk_iii","title":{"Namespace":"card_britain","Key":"card_unit_qf_40mm_mk_iii_title","SourceString":"QF 40mm Mk III","LocalizedString":"QF 40mm Mk III"},"Type":"ETypeEnum::artillery","attack":1,"defense":2,"range":2,"faction":"EFactionEnum::Britain","kredits":3,"Text":{"Namespace":"card_britain","Key":"card_unit_qf_40mm_mk_iii_text","SourceString":"Deployment: Duplicate this unit if you have damaged the enemy HQ this turn.","LocalizedString":"Deployment: Duplicate this unit if you have damaged the enemy HQ this turn."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_qf_40mm_mk_iii_history","SourceString":"The QF 40mm Mk III gun, also referred to as the Bofors gun, was a Swedish made anti-aircraft auto-cannon designed in the 1930s. During WWII it was used in most theatres by the Allies, but also to some extent by the Axis powers. The QF 40 mm Mark III variant (QF stood for quick firing) was the standard light AA weapon of the British Army and considered vital in the defense of Britain and the Commonwealth countries after the fall of France. By the end of the war over 19,000 units had been produced and a small number of these weapons remain in service to this day.","LocalizedString":"The QF 40mm Mk III gun, also referred to as the Bofors gun, was a Swedish made anti-aircraft auto-cannon designed in the 1930s. During WWII it was used in most theatres by the Allies, but also to some extent by the Axis powers. The QF 40 mm Mark III variant (QF stood for quick firing) was the standard light AA weapon of the British Army and considered vital in the defense of Britain and the Commonwealth countries after the fall of France. By the end of the war over 19,000 units had been produced and a small number of these weapons remain in service to this day."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Basic","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment","EHelpBubbleTypes::Blitz"],"hasDeployment":true,"hasBlitz":true,"soundEnterPlay":{"ObjectName":"SoundWave'Artillery_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Artillery_Move_FX.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Artillery_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Artillery_Move_FX.0"},"soundAttack":{"ObjectName":"SoundWave'Silence'","ObjectPath":"kards/Content/Assets/Audio/Silence/Silence.0"},"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Armor_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Armor_Medium_Cue.0"},"soundProjectileImpact":{"ObjectName":"SoundWave'Silence'","ObjectPath":"kards/Content/Assets/Audio/Silence/Silence.0"},"soundProjectileFiring":{"ObjectName":"SoundWave'Silence'","ObjectPath":"kards/Content/Assets/Audio/Silence/Silence.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/DontUseOrTemp/t_anti_aircraft_gun.t_anti_aircraft_gun","SubPathString":""},"historyPho