{"format":"kards-original-reference","version":1,"id":"a6d68abb497a3a14","name":"card_unit_sabae_regiment","package":"/Game/Blueprints/Cards/Japan/NavalWarfare/units/card_unit_sabae_regiment","parent":"UBaseCardObject","card":{"title":"SABAE REGIMENT","text":"Once per turn, when you shuffle, distribute damage randomly to enemies equal to units in play.","flavorText":"The 136th Infantry Regiment was a unit of the 109th Division of the Imperial Japanese Army during WWII. The 109th Division, nicknamed the \"Courage Division\", was formed in August 1937 and was first deployed to North China, participating in operations along the Beiping-Hankou Railway and garrisoning in Shanxi province until it was dissolved in December 1939. The division was reformed in May 1944 from island garrisons and new recruits. It was assigned to the 31st Army under General Kuribayashi, becoming the main Japanese force on the Bonin Islands, especially Iwo Jima and Chichi Jima, with about 47,000 troops spread across the island clusters. In February 1945, the 109th Division fiercely defended Iwo Jima against overwhelming US forces, employing deep tunnel systems and determined resistance. Despite their efforts, almost all defenders were killed. Only about 1,083 Japanese soldiers survived, with General Kuribayashi believed to have died leading a final counterattack. The division’s last stand at Iwo Jima became one of WWII’s most intense and symbolic battles, remembered for its desperate defense and heavy casualties.","faction":"Japan","type":"infantry","rarity":"Rare","cost":4,"operationCost":2,"attack":3,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_sabae_regiment","title":{"Namespace":"card_japan","Key":"card_unit_sabae_regiment_title","SourceString":"SABAE REGIMENT","LocalizedString":"SABAE REGIMENT"},"Type":"ETypeEnum::infantry","attack":3,"defense":5,"range":1,"faction":"EFactionEnum::Japan","kredits":4,"Text":{"Namespace":"card_japan","Key":"card_unit_sabae_regiment_text","SourceString":"Once per turn, when you shuffle, distribute damage randomly to enemies equal to units in play.","LocalizedString":"Once per turn, when you shuffle, distribute damage randomly to enemies equal to units in play."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_sabae_regiment_history","SourceString":"The 136th Infantry Regiment was a unit of the 109th Division of the Imperial Japanese Army during WWII. The 109th Division, nicknamed the \"Courage Division\", was formed in August 1937 and was first deployed to North China, participating in operations along the Beiping-Hankou Railway and garrisoning in Shanxi province until it was dissolved in December 1939. The division was reformed in May 1944 from island garrisons and new recruits. It was assigned to the 31st Army under General Kuribayashi, becoming the main Japanese force on the Bonin Islands, especially Iwo Jima and Chichi Jima, with about 47,000 troops spread across the island clusters. In February 1945, the 109th Division fiercely defended Iwo Jima against overwhelming US forces, employing deep tunnel systems and determined resistance. Despite their efforts, almost all defenders were killed. Only about 1,083 Japanese soldiers survived, with General Kuribayashi believed to have died leading a final counterattack. The division’s last stand at Iwo Jima became one of WWII’s most intense and symbolic battles, remembered for its desperate defense and heavy casualties.","LocalizedString":"The 136th Infantry Regiment was a unit of the 109th Division of the Imperial Japanese Army during WWII. The 109th Division, nicknamed the \"Courage Division\", was formed in August 1937 and was first deployed to North China, participating in operations along the Beiping-Hankou Railway and garrisoning in Shanxi province until it was dissolved in December 1939. The division was reformed in May 1944 from island garrisons and new recruits. It was assigned to the 31st Army under General Kuribayashi, becoming the main Japanese force on the Bonin Islands, especially Iwo Jima and Chichi Jima, with about 47,000 troops spread across the island clusters. In February 1945, the 109th Division fiercely defended Iwo Jima against overwhelming US forces, employing deep tunnel systems and determined resistance. Despite their efforts, almost all defenders were killed. Only about 1,083 Japanese soldiers survived, with General Kuribayashi believed to have died leading a final counterattack. The division’s last stand at Iwo Jima became one of WWII’s most intense and symbolic battles, remembered for its desperate defense and heavy casualties."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::NavalWarfare","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn","ERegisteredCardFunction::OnDeckShuffled"],"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/NavalWarfare/t_sabae_regiment.t_sabae_regiment","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/SABAE_REGIMENT.SABAE_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":373.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_sabae_regiment_photo","SourceString":"Japanese officers, Iwo Jima, late 1944.","LocalizedString":"Japanese officers, Iwo Jima, late 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"Notes":"Image from Y.Takani not licensed yet","isHQDamage":true,"threat_level":0.1},"variables":[{"name":"removedCard","type":"UBaseCardObject*","direction":"in"},{"name":"count","type":