{"format":"kards-original-reference","version":1,"id":"33801ae9763560ca","name":"card_unit_125th_la_spezia","package":"/Game/Blueprints/Cards/Italy/units/card_unit_125th_la_spezia","parent":"UBaseCardObject","card":{"title":"125th LA SPEZIA","text":"Deployment: Draw a card if you control an air unit.","flavorText":"The 125th Infantry Regiment \"La Spezia\" was part of the 80th Infantry Division \"La Spezia\", an Italian airborne division formed in 1941. Originally supposed to take part in the invasion of Malta, the division was instead deployed to Libya after the operation was canceled. It participated in the Second Battle of El Alamein in October 1942, won by the Allies. Following the defeat, the division retreated to Tunisia, where it took part in the Battle of Medenine in March 1943, followed shortly after by the Battle of the Mareth Line, both of which resulted in Allied victories. During these battles, the division lost half of its strength, and the remaining troops, along with the rest of the Axis forces, retreated to Enfidaville (currently Enfidha) in northeastern Tunisia. By May 1943, the remaining Italian forces in Enfidaville were surrounded, and soon after, approximately 80,000 Italian troops surrendered to the British. The 80th Infantry Division \"La Spezia\" was officially lost on 13 May 1943.","faction":"Italy","type":"infantry","rarity":"Common","cost":4,"operationCost":1,"attack":2,"defense":7},"defaults":{"UberGraphFrame":{},"Name":"card_unit_125th_la_spezia","title":{"Namespace":"card_italy","Key":"card_unit_125th_la_spezia_title","SourceString":"125th LA SPEZIA","LocalizedString":"125th LA SPEZIA"},"Type":"ETypeEnum::infantry","attack":2,"defense":7,"range":1,"faction":"EFactionEnum::Italy","kredits":4,"Text":{"Namespace":"card_italy","Key":"card_unit_125th_la_spezia_text","SourceString":"Deployment: Draw a card if you control an air unit.","LocalizedString":"Deployment: Draw a card if you control an air unit."},"flavorText":{"Namespace":"card_italy","Key":"card_unit_125th_la_spezia_history","SourceString":"The 125th Infantry Regiment \"La Spezia\" was part of the 80th Infantry Division \"La Spezia\", an Italian airborne division formed in 1941. Originally supposed to take part in the invasion of Malta, the division was instead deployed to Libya after the operation was canceled. It participated in the Second Battle of El Alamein in October 1942, won by the Allies. Following the defeat, the division retreated to Tunisia, where it took part in the Battle of Medenine in March 1943, followed shortly after by the Battle of the Mareth Line, both of which resulted in Allied victories. During these battles, the division lost half of its strength, and the remaining troops, along with the rest of the Axis forces, retreated to Enfidaville (currently Enfidha) in northeastern Tunisia. By May 1943, the remaining Italian forces in Enfidaville were surrounded, and soon after, approximately 80,000 Italian troops surrendered to the British. The 80th Infantry Division \"La Spezia\" was officially lost on 13 May 1943.","LocalizedString":"The 125th Infantry Regiment \"La Spezia\" was part of the 80th Infantry Division \"La Spezia\", an Italian airborne division formed in 1941. Originally supposed to take part in the invasion of Malta, the division was instead deployed to Libya after the operation was canceled. It participated in the Second Battle of El Alamein in October 1942, won by the Allies. Following the defeat, the division retreated to Tunisia, where it took part in the Battle of Medenine in March 1943, followed shortly after by the Battle of the Mareth Line, both of which resulted in Allied victories. During these battles, the division lost half of its strength, and the remaining troops, along with the rest of the Axis forces, retreated to Enfidaville (currently Enfidha) in northeastern Tunisia. By May 1943, the remaining Italian forces in Enfidaville were surrounded, and soon after, approximately 80,000 Italian troops surrendered to the British. The 80th Infantry Division \"La Spezia\" was officially lost on 13 May 1943."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::BloodAndIron","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"hasGuard":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Italy/Mini_Ally_Expansion_25/t_125th_la_spezia_b.t_125th_la_spezia_b","SubPathString":""},"artist":"Italian WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/125th_LA_SPEZIA.125th_LA_SPEZIA","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":350.0},"historyPhotoDescription":{"Namespace":"card_italy","Key":"card_unit_125th_la_spezia_photo","SourceString":"Italian artillery crew in Tunisia, March 1943.","LocalizedString":"Italian artillery crew in Tunisia, March 1943."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"airUnitFound","type":"bool","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_125th_la_spezia","owner":"card_unit_125th_la_spezia_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_bool_True_if_break_was_hit_Variable","type":"bool","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Not_PreBool_ReturnValue","type":"bool","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntIn