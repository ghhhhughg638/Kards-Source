{"format":"kards-original-reference","version":1,"id":"3b46c08e5c1e8708","name":"card_unit_132nd_omsk","package":"/Game/Blueprints/Cards/Soviet/Homefront/units/card_unit_132nd_omsk","parent":"UBaseCardObject","card":{"title":"132nd OMSK","text":"Deployment: Gets +1+1 for each of your units with two or more combat keywords.","flavorText":"The 132nd Omsk Rifle Regiment was part of the 27th Rifle Division, a unit originally formed during the Russian Civil War and known for its key role in the capture of Omsk in 1919. This earned the division its honorary title and solidified its place in early Soviet military history. During WWII, the first formation of the 27th Rifle Division was deployed near Grodno in Belarus at the start of Operation Barbarossa in June 1941. Facing the German 9th Army, the division was encircled in the Białystok–Minsk pocket and effectively destroyed by mid-July. Its commander, Major General Aleksandr Stepanov, was killed while leading a breakout attempt on August 11, and the division was officially disbanded the following month. A second formation of the division was established in August 1941 in Arkhangelsk, initially under the name Rebolsky Direction Division. Renamed the 27th Rifle Division on September 24, it was assigned to the 26th Army of the Karelian Front and saw action against Finnish forces in the far north until late 1944. The division later joined the 2nd Belorussian Front and was awarded the Order of the Red Banner on April 5, 1945, for its role in capturing Stolp. It ended the war under the 19th Army in May 1945.","faction":"Soviet","type":"infantry","rarity":"Common","cost":2,"operationCost":1,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_132nd_omsk","title":{"Namespace":"card_soviet","Key":"card_unit_132nd_omsk_title","SourceString":"132nd OMSK","LocalizedString":"132nd OMSK"},"Type":"ETypeEnum::infantry","attack":1,"defense":2,"range":1,"faction":"EFactionEnum::Soviet","kredits":2,"Text":{"Namespace":"card_soviet","Key":"card_unit_132nd_omsk_text","SourceString":"Deployment: Gets +1+1 for each of your units with two or more combat keywords.","LocalizedString":"Deployment: Gets +1+1 for each of your units with two or more combat keywords."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_132nd_omsk_history","SourceString":"The 132nd Omsk Rifle Regiment was part of the 27th Rifle Division, a unit originally formed during the Russian Civil War and known for its key role in the capture of Omsk in 1919. This earned the division its honorary title and solidified its place in early Soviet military history. During WWII, the first formation of the 27th Rifle Division was deployed near Grodno in Belarus at the start of Operation Barbarossa in June 1941. Facing the German 9th Army, the division was encircled in the Białystok–Minsk pocket and effectively destroyed by mid-July. Its commander, Major General Aleksandr Stepanov, was killed while leading a breakout attempt on August 11, and the division was officially disbanded the following month. A second formation of the division was established in August 1941 in Arkhangelsk, initially under the name Rebolsky Direction Division. Renamed the 27th Rifle Division on September 24, it was assigned to the 26th Army of the Karelian Front and saw action against Finnish forces in the far north until late 1944. The division later joined the 2nd Belorussian Front and was awarded the Order of the Red Banner on April 5, 1945, for its role in capturing Stolp. It ended the war under the 19th Army in May 1945.","LocalizedString":"The 132nd Omsk Rifle Regiment was part of the 27th Rifle Division, a unit originally formed during the Russian Civil War and known for its key role in the capture of Omsk in 1919. This earned the division its honorary title and solidified its place in early Soviet military history. During WWII, the first formation of the 27th Rifle Division was deployed near Grodno in Belarus at the start of Operation Barbarossa in June 1941. Facing the German 9th Army, the division was encircled in the Białystok–Minsk pocket and effectively destroyed by mid-July. Its commander, Major General Aleksandr Stepanov, was killed while leading a breakout attempt on August 11, and the division was officially disbanded the following month. A second formation of the division was established in August 1941 in Arkhangelsk, initially under the name Rebolsky Direction Division. Renamed the 27th Rifle Division on September 24, it was assigned to the 26th Army of the Karelian Front and saw action against Finnish forces in the far north until late 1944. The division later joined the 2nd Belorussian Front and was awarded the Order of the Red Banner on April 5, 1945, for its role in capturing Stolp. It ended the war under the 19th Army in May 1945."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Homefront","hasDeployment":true,"hasBlitz":true,"hasAmbush":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/132nd_OMSK.132nd_OMSK","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":417.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_132nd_omsk_photo","SourceString":"Soviet infantry in the Białystok–Minsk pocket in 1941.","LocalizedString":"Soviet infantry in the Białystok–Minsk pocket in 1941."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"keyUnits","type":"int32","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_132nd_omsk","owner":"card_unit_132nd_omsk_C","params":[{"name":"EntryPoint","type":"in