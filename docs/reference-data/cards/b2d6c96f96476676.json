{"format":"kards-original-reference","version":1,"id":"b2d6c96f96476676","name":"card_unit_sakura_regiment","package":"/Game/Blueprints/Cards/Japan/WorldAtWar/units/card_unit_sakura_regiment","parent":"UBaseCardObject","card":{"title":"SAKURA REGIMENT","text":"Has +2 attack if you have fewer cards in hand than the enemy.","flavorText":"The 57th Regiment Sakura was a regiment of the 1st Division of the Imperial Japanese Army during WWII. The division was sent to the Philippines to participate in the Pacific War in 1944 and was initially based in Manila before being shipped to Leyte to defend against the Filipino and US forces which had reoccupied the island. The 1st Division participated in fierce combat during the Battle of Leyte where it was nearly annihilated. Of the 11,000 soldiers only 800 managed to evacuate to Cebu island where they would participate in the Battle for Cebu City.","faction":"Japan","type":"infantry","rarity":"Uncommon","cost":1,"operationCost":1,"attack":1,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_sakura_regiment","title":{"Namespace":"card_japan","Key":"card_unit_sakura_regiment_title","SourceString":"SAKURA REGIMENT","LocalizedString":"SAKURA REGIMENT"},"Type":"ETypeEnum::infantry","attack":1,"defense":3,"range":1,"faction":"EFactionEnum::Japan","kredits":1,"Text":{"Namespace":"card_japan","Key":"card_unit_sakura_regiment_text","SourceString":"Has +2 attack if you have fewer cards in hand than the enemy.","LocalizedString":"Has +2 attack if you have fewer cards in hand than the enemy."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_sakura_regiment_history","SourceString":"The 57th Regiment Sakura was a regiment of the 1st Division of the Imperial Japanese Army during WWII. The division was sent to the Philippines to participate in the Pacific War in 1944 and was initially based in Manila before being shipped to Leyte to defend against the Filipino and US forces which had reoccupied the island. The 1st Division participated in fierce combat during the Battle of Leyte where it was nearly annihilated. Of the 11,000 soldiers only 800 managed to evacuate to Cebu island where they would participate in the Battle for Cebu City.","LocalizedString":"The 57th Regiment Sakura was a regiment of the 1st Division of the Imperial Japanese Army during WWII. The division was sent to the Philippines to participate in the Pacific War in 1944 and was initially based in Manila before being shipped to Leyte to defend against the Filipino and US forces which had reoccupied the island. The 1st Division participated in fierce combat during the Battle of Leyte where it was nearly annihilated. Of the 11,000 soldiers only 800 managed to evacuate to Cebu island where they would participate in the Battle for Cebu City."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::WorldAtWar","isReserved":true,"showBoostIcon":true,"EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCovertCardPlayedFromHand","ERegisteredCardFunction::OnOtherCardPlayedFromHand","ERegisteredCardFunction::OnOtherCardReset","ERegisteredCardFunction::OnOtherCardSpawnedInHand","ERegisteredCardFunction::OnOtherCardDrawnFromDeck","ERegisteredCardFunction::OnOtherCardDiscarded"],"spawnCardChosen":"A Japanese soldier during the Battle of Leyte, 1944.","soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/t_sakura_regiment.t_sakura_regiment","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/SAKURA_REGIMENT.SAKURA_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":372.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_sakura_regiment_photo","SourceString":"A Japanese soldier during the Battle of Leyte, 1944.","LocalizedString":"A Japanese soldier during