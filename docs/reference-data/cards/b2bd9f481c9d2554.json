{"format":"kards-original-reference","version":1,"id":"b2bd9f481c9d2554","name":"card_unit_fw_190_ta_152","package":"/Game/Blueprints/Cards/Germany/OceaniaStorm/units/card_unit_fw_190_ta_152","parent":"UBaseCardObject","card":{"title":"FW TA 152","text":"Becomes Veteran when it attacks and destroys a unit.","flavorText":"The Focke-Wulf Ta 152 was the final development of the Fw 190 line, redesigned by Kurt Tank to fight at altitudes where earlier German fighters struggled. The original Fw 190 was strong at medium flight level, but Allied heavy bombers and long-range escorts operated at increasingly higher altitudes than its BMW 801 engine could handle well. The Ta 152 answered this issue with a longer fuselage, larger tail, pressurized cockpit, improved radio equipment and, on the H model, a greatly extended wing for high altitude control. The Ta 152H entered Luftwaffe service in January 1945, far too late to affect the air war. Only 69 were built. Its Junkers Jumo 213E engine used MW 50 water methanol boost at lower altitudes and GM 1 nitrous oxide boost higher up. The H 1 carried one 30 mm MK 108 cannon and two 20 mm MG 151 cannons, giving it heavy firepower against bombers. The aircraft served mainly with Jagdgeschwader 301. Pilots praised its speed and handling, but fuel and parts shortages, and Germany’s collapsing production system kept it rare in combat.","faction":"Germany","type":"fighter","rarity":"Rare","cost":4,"operationCost":2,"attack":4,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_fw_190_ta_152","title":{"Namespace":"card_germany","Key":"card_unit_fw_190_ta_152_title","SourceString":"FW TA 152","LocalizedString":"FW TA 152"},"Type":"ETypeEnum::fighter","attack":4,"defense":5,"range":2,"faction":"EFactionEnum::Germany","kredits":4,"Text":{"Namespace":"card_germany","Key":"card_unit_fw_190_ta_152_text","SourceString":"Becomes Veteran when it attacks and destroys a unit.","LocalizedString":"Becomes Veteran when it attacks and destroys a unit."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_fw_190_ta_152_history","SourceString":"The Focke-Wulf Ta 152 was the final development of the Fw 190 line, redesigned by Kurt Tank to fight at altitudes where earlier German fighters struggled. The original Fw 190 was strong at medium flight level, but Allied heavy bombers and long-range escorts operated at increasingly higher altitudes than its BMW 801 engine could handle well. The Ta 152 answered this issue with a longer fuselage, larger tail, pressurized cockpit, improved radio equipment and, on the H model, a greatly extended wing for high altitude control. The Ta 152H entered Luftwaffe service in January 1945, far too late to affect the air war. Only 69 were built. Its Junkers Jumo 213E engine used MW 50 water methanol boost at lower altitudes and GM 1 nitrous oxide boost higher up. The H 1 carried one 30 mm MK 108 cannon and two 20 mm MG 151 cannons, giving it heavy firepower against bombers. The aircraft served mainly with Jagdgeschwader 301. Pilots praised its speed and handling, but fuel and parts shortages, and Germany’s collapsing production system kept it rare in combat.","LocalizedString":"The Focke-Wulf Ta 152 was the final development of the Fw 190 line, redesigned by Kurt Tank to fight at altitudes where earlier German fighters struggled. The original Fw 190 was strong at medium flight level, but Allied heavy bombers and long-range escorts operated at increasingly higher altitudes than its BMW 801 engine could handle well. The Ta 152 answered this issue with a longer fuselage, larger tail, pressurized cockpit, improved radio equipment and, on the H model, a greatly extended wing for high altitude control. The Ta 152H entered Luftwaffe service in January 1945, far too late to affect the air war. Only 69 were built. Its Junkers Jumo 213E engine used MW 50 water methanol boost at lower altitudes and GM 1 nitrous oxide boost higher up. The H 1 carried one 30 mm MK 108 cannon and two 20 mm MG 151 cannons, giving it heavy firepower against bombers. The aircraft served mainly with Jagdgeschwader 301. Pilots praised its speed and handling, but fuel and parts shortages, and Germany’s collapsing production system kept it rare in combat."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::OceaniaStorm","usedTriggers":["ERegisteredCardFunction::OnAfterOtherCardAttacks","ERegisteredCardFunction::OnOtherCardMoveToFrontline","ERegisteredCardFunction::OnEndOfTurn","ERegisteredCardFunction::OnOtherCardDestroyed","ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"hasShock":true,"spawnCardName":"card_unit_fw_190_ta_152_vet","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/FW_TA_152.FW_TA_152","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_fw_190_ta_152_photo","SourceString":"A Luftwaffe Focke-Wulf Ta 152. Date unknown.","LocalizedString":"A Luftwaffe Focke-Wulf Ta 152. Date unknown."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackFighter.BP_AttackFighter_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_fw_190_ta_152","owner":"card_unit_fw_190_ta_152_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"K2Node_Event_cardDestroyed","type":"UBaseCardOb