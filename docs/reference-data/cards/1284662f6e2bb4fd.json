{"format":"kards-original-reference","version":1,"id":"1284662f6e2bb4fd","name":"card_event_partisans","package":"/Game/Blueprints/Cards/Soviet/Legions/events/card_event_partisans","parent":"UBaseCardObject","card":{"title":"PARTISANS","text":"Take control of an enemy unit. At the end of turn, send it to owner's hand.","flavorText":"The Soviet partisans fought a guerrilla war against the Axis forces on the Eastern Front during WWII. The partisans were coordinated and controlled by the Soviet government and covertly received arms, equipment, and orders from the Soviet forces fighting at the front. Their role was to operate in the rear and to harass, disrupt, sabotage, and to provide intelligence about German military and economic activities in the occupied territories. The Soviet Partisans movement grew from 90,000 men and women in 1941 to 550,000 in 1943 and managed to make a significant contribution to the Allied victory on the Eastern Front.","faction":"Soviet","type":"order","rarity":"Rare","cost":6,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_partisans","title":{"Namespace":"card_soviet","Key":"card_event_partisans_title","SourceString":"PARTISANS","LocalizedString":"PARTISANS"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Soviet","kredits":6,"Text":{"Namespace":"card_soviet","Key":"card_event_partisans_text","SourceString":"Take control of an enemy unit. At the end of turn, send it to owner's hand.","LocalizedString":"Take control of an enemy unit. At the end of turn, send it to owner's hand."},"flavorText":{"Namespace":"card_soviet","Key":"card_event_partisans_history","SourceString":"The Soviet partisans fought a guerrilla war against the Axis forces on the Eastern Front during WWII. The partisans were coordinated and controlled by the Soviet government and covertly received arms, equipment, and orders from the Soviet forces fighting at the front. Their role was to operate in the rear and to harass, disrupt, sabotage, and to provide intelligence about German military and economic activities in the occupied territories. The Soviet Partisans movement grew from 90,000 men and women in 1941 to 550,000 in 1943 and managed to make a significant contribution to the Allied victory on the Eastern Front.","LocalizedString":"The Soviet partisans fought a guerrilla war against the Axis forces on the Eastern Front during WWII. The partisans were coordinated and controlled by the Soviet government and covertly received arms, equipment, and orders from the Soviet forces fighting at the front. Their role was to operate in the rear and to harass, disrupt, sabotage, and to provide intelligence about German military and economic activities in the occupied territories. The Soviet Partisans movement grew from 90,000 men and women in 1941 to 550,000 in 1943 and managed to make a significant contribution to the Allied victory on the Eastern Front."},"rarity":"ERarityEnum::Rare","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Legions","returnSet":"ECardSetEnum::NavalWarfare","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::UnderEnemyControl"],"soundEnterPlay":{"ObjectName":"SoundWave'Mother_Russia'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Mother_Russia.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/Invasion/t_conscripts.t_conscripts","SubPathString":""},"artist":"Soviet WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/PARTISANS.PARTISANS","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":349.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_event_partisans_photo","SourceString":"Soviet partisans in Belarus, 1943.","LocalizedString":"Soviet partisans in Belarus, 1943."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_OrderDiveBomber.BP_OrderDiveBomber_C","SubPathString":""},"customName1":"endofturn2"},"variables"