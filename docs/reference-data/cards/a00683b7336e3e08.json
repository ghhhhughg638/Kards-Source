{"format":"kards-original-reference","version":1,"id":"a00683b7336e3e08","name":"card_event_pams","package":"/Game/Blueprints/Cards/Britain/OceaniaStorm/events/card_event_pams","parent":"UBaseCardObject","card":{"title":"PAMS","text":"Develop a British order costing 4 or less. Add it to your deck with a cost of 0.","flavorText":"During the Blitz, Britain’s Police Auxiliary Messengers, universally known as the PAMs, carried vital information through streets where normal communications had broken down. Women and boys under the age of eighteen helped local police forces during and after air raids, delivering messages when telephone lines had been cut by bombing, power failures, or fallen wires. The PAMs received basic training in first aid and the use of stirrup pumps, and they had to learn the locations of police and civil defense posts by heart. Their work could mean delivering messages through blackout conditions, rubble-strewn streets, and ongoing enemy attacks. In heavily bombed cities such as Coventry, PAMs also assisted rescue services and dealt with fires caused by incendiary bombs. Several were decorated for exceptional bravery, including messengers who continued carrying urgent dispatches despite blast injuries and falling bombs. The service remained active until 1945, when wartime restrictions were lifted and the PAMs were effectively replaced by Police Cadets.","faction":"Britain","type":"order","rarity":"Uncommon","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.develop"],"Name":"card_event_pams","title":{"Namespace":"card_britain","Key":"card_event_pams_title","SourceString":"PAMS","LocalizedString":"PAMS"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Britain","kredits":1,"Text":{"Namespace":"card_britain","Key":"card_event_pams_text","SourceString":"Develop a British order costing 4 or less. Add it to your deck with a cost of 0.","LocalizedString":"Develop a British order costing 4 or less. Add it to your deck with a cost of 0."},"flavorText":{"Namespace":"card_britain","Key":"card_event_pams_history","SourceString":"During the Blitz, Britain’s Police Auxiliary Messengers, universally known as the PAMs, carried vital information through streets where normal communications had broken down. Women and boys under the age of eighteen helped local police forces during and after air raids, delivering messages when telephone lines had been cut by bombing, power failures, or fallen wires. The PAMs received basic training in first aid and the use of stirrup pumps, and they had to learn the locations of police and civil defense posts by heart. Their work could mean delivering messages through blackout conditions, rubble-strewn streets, and ongoing enemy attacks. In heavily bombed cities such as Coventry, PAMs also assisted rescue services and dealt with fires caused by incendiary bombs. Several were decorated for exceptional bravery, including messengers who continued carrying urgent dispatches despite blast injuries and falling bombs. The service remained active until 1945, when wartime restrictions were lifted and the PAMs were effectively replaced by Police Cadets.","LocalizedString":"During the Blitz, Britain’s Police Auxiliary Messengers, universally known as the PAMs, carried vital information through streets where normal communications had broken down. Women and boys under the age of eighteen helped local police forces during and after air raids, delivering messages when telephone lines had been cut by bombing, power failures, or fallen wires. The PAMs received basic training in first aid and the use of stirrup pumps, and they had to learn the locations of police and civil defense posts by heart. Their work could mean delivering messages through blackout conditions, rubble-strewn streets, and ongoing enemy attacks. In heavily bombed cities such as Coventry, PAMs also assisted rescue services and dealt with fires caused by incendiary bombs. Several were decorated for exceptional bravery, including messengers who continued carrying urgent dispatches despite blast injuries and falling bombs. The service remained active until 1945, when wartime restrictions were lifted and the PAMs were effectively replaced by Police Cadets."},"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::OceaniaStorm","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Develop"],"soundEnterPlay":{"ObjectName":"SoundWave'For_the_Queen'","ObjectPath":"kards/Content/Assets/Audio/Misc/For_the_Queen.0"},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/THE_PAMS.THE_PAMS","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":341.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_event_pams_photo","SourceString":"A PAM motorcycle rider, 1941.","LocalizedString":"A PAM motorcycle rider, 1941."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"Notes":"Image needed to be customized","isDefenseBuff":true},"variables":[{"name":"cheapeastCard","type":"UBaseCardObject*","direction":"in"},{"name":"myDeck","type":"TArray<int32>","direction":"in"},{"name":"objSet","type":"bool","direction":"in"},{"name":"PossibleCards","type":"TArray<UBaseCardObject*>","direction":"in"},{"name":"cardDeveloped","type":"int32","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_pams","owner":"card_event_pams_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_bool_True_if_break_was_hit_Variable","type":"bool","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Not_PreBool_ReturnValue","type":"bool","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":