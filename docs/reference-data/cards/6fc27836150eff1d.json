{"format":"kards-original-reference","version":1,"id":"6fc27836150eff1d","name":"card_unit_hirosaki_regiment","package":"/Game/Blueprints/Cards/Japan/BloodIron/units/card_unit_hirosaki_regiment","parent":"UBaseCardObject","card":{"title":"HIROSAKI BRIGADE","text":"When a friendly unit loses Smokescreen, it gets +1+1 and -1 operation cost.","flavorText":"The 59th Infantry brigade (Hirosaki) was a brigade of the 69th Division of the Imperial Japanese Army during WWII. The division was formed on 2 February 1942 and nicknamed the Winning Division (勝兵団, Katsu Heidan). It was assigned to the 1st Army upon formation and tasked with garrisoning central and western Shanxi Province in China. In autumn 1943, it fought in Lanshan County during the Battle of Changde. In March 1944, the divisional headquarters moved to Yuncheng, and the 69th Division joined Operation Ichi-Go in May 1944. After the offensive ended in April 1945, the division was reassigned to garrison duty in China under the 13th Army, where it remained stationed until Japan’s surrender on August 15th, 1945.","faction":"Japan","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":1,"attack":2,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_hirosaki_regiment","title":{"Namespace":"card_japan","Key":"card_unit_hirosaki_regiment_title","SourceString":"HIROSAKI BRIGADE","LocalizedString":"HIROSAKI BRIGADE"},"Type":"ETypeEnum::infantry","attack":2,"defense":4,"range":1,"faction":"EFactionEnum::Japan","kredits":3,"Text":{"Namespace":"card_japan","Key":"card_unit_hirosaki_regiment_text","SourceString":"When a friendly unit loses Smokescreen, it gets +1+1 and -1 operation cost.","LocalizedString":"When a friendly unit loses Smokescreen, it gets +1+1 and -1 operation cost."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_hirosaki_regiment_history","SourceString":"The 59th Infantry brigade (Hirosaki) was a brigade of the 69th Division of the Imperial Japanese Army during WWII. The division was formed on 2 February 1942 and nicknamed the Winning Division (勝兵団, Katsu Heidan). It was assigned to the 1st Army upon formation and tasked with garrisoning central and western Shanxi Province in China. In autumn 1943, it fought in Lanshan County during the Battle of Changde. In March 1944, the divisional headquarters moved to Yuncheng, and the 69th Division joined Operation Ichi-Go in May 1944. After the offensive ended in April 1945, the division was reassigned to garrison duty in China under the 13th Army, where it remained stationed until Japan’s surrender on August 15th, 1945.","LocalizedString":"The 59th Infantry brigade (Hirosaki) was a brigade of the 69th Division of the Imperial Japanese Army during WWII. The division was formed on 2 February 1942 and nicknamed the Winning Division (勝兵団, Katsu Heidan). It was assigned to the 1st Army upon formation and tasked with garrisoning central and western Shanxi Province in China. In autumn 1943, it fought in Lanshan County during the Battle of Changde. In March 1944, the divisional headquarters moved to Yuncheng, and the 69th Division joined Operation Ichi-Go in May 1944. After the offensive ended in April 1945, the division was reassigned to garrison duty in China under the 13th Army, where it remained stationed until Japan’s surrender on August 15th, 1945."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::BloodAndIron","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardLoseSmokescreen"],"hasSmokescreen":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/Winter_2024/t_hirosaki_regiment.t_hirosaki_regiment","SubPathString":""},"artist":"Rebellion","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/HIROKASI_REGIMENT.HIROKASI_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":358.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_hirosaki_regiment_photo","SourceString":"Japane