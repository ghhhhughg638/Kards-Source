{"format":"kards-original-reference","version":1,"id":"e65c1d708cf4fca7","name":"card_unit_106th_infantry_regiment","package":"/Game/Blueprints/Cards/Japan/Homefront/units/card_unit_106th_infantry_regiment","parent":"UBaseCardObject","card":{"title":"106th INFANTRY REGIMENT","text":"Deployment: Deal 1 damage to an enemy.\r\nDestruction: If it's the enemy turn, add a copy to your hand.","flavorText":"The 106th Infantry Regiment was part of the Japanese 49th Division, an infantry formation of the Imperial Japanese Army established on 6 January 1944 in Seoul. The division was formed using troops from the 64th Infantry Brigade and the headquarters of the 20th Division. It was known as the “Wolf Division”, and its personnel included around 2% of Korean locals. In May 1944, the 49th Division was assigned to the Burma Area Army and sent to reinforce Japanese positions in Burma. The deployment was costly: two transport ships were sunk en route, causing around 1,600 deaths. Once in Burma, the division was split across various fronts. The 106th Infantry Regiment, along with the divisional headquarters and artillery units, was involved in fierce battles to retake the critical communications hub of Meiktila in March 1945. Despite determined counterattacks, their efforts failed due to poor coordination with other Japanese units, and they suffered heavy casualties. Following the failed Meiktila offensive, the remnants of the division participated in defensive actions during the Battle of the Sittang Bend and were still holding positions on the Sittang River when Japan surrendered in August 1945.","faction":"Japan","type":"infantry","rarity":"Common","cost":2,"operationCost":1,"attack":1,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_106th_infantry_regiment","title":{"Namespace":"card_japan","Key":"card_unit_106th_infantry_regiment_title","SourceString":"106th INFANTRY REGIMENT","LocalizedString":"106th INFANTRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":1,"defense":3,"range":1,"faction":"EFactionEnum::Japan","kredits":2,"Text":{"Namespace":"card_japan","Key":"card_unit_106th_infantry_regiment_text","SourceString":"Deployment: Deal 1 damage to an enemy.\r\nDestruction: If it's the enemy turn, add a copy to your hand.","LocalizedString":"Deployment: Deal 1 damage to an enemy.\r\nDestruction: If it's the enemy turn, add a copy to your hand."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_106th_infantry_regiment_history","SourceString":"The 106th Infantry Regiment was part of the Japanese 49th Division, an infantry formation of the Imperial Japanese Army established on 6 January 1944 in Seoul. The division was formed using troops from the 64th Infantry Brigade and the headquarters of the 20th Division. It was known as the “Wolf Division”, and its personnel included around 2% of Korean locals. In May 1944, the 49th Division was assigned to the Burma Area Army and sent to reinforce Japanese positions in Burma. The deployment was costly: two transport ships were sunk en route, causing around 1,600 deaths. Once in Burma, the division was split across various fronts. The 106th Infantry Regiment, along with the divisional headquarters and artillery units, was involved in fierce battles to retake the critical communications hub of Meiktila in March 1945. Despite determined counterattacks, their efforts failed due to poor coordination with other Japanese units, and they suffered heavy casualties. Following the failed Meiktila offensive, the remnants of the division participated in defensive actions during the Battle of the Sittang Bend and were still holding positions on the Sittang River when Japan surrendered in August 1945.","LocalizedString":"The 106th Infantry Regiment was part of the Japanese 49th Division, an infantry formation of the Imperial Japanese Army established on 6 January 1944 in Seoul. The division was formed using troops from the 64th Infantry Brigade and the headquarters of the 20th Division. It was known as the “Wolf Division”, and its personnel included around 2% of Korean locals. In May 1944, the 49th Division was assigned to the Burma Area Army and sent to reinforce Japanese positions in Burma. The deployment was costly: two transport ships were sunk en route, causing around 1,600 deaths. Once in Burma, the division was split across various fronts. The 106th Infantry Regiment, along with the divisional headquarters and artillery units, was involved in fierce battles to retake the critical communications hub of Meiktila in March 1945. Despite determined counterattacks, their efforts failed due to poor coordination with other Japanese units, and they suffered heavy casualties. Following the failed Meiktila offensive, the remnants of the division participated in defensive actions during the Battle of the Sittang Bend and were still holding positions on the Sittang River when Japan surrendered in August 1945."},"operationCost":1,"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Trigger","hasDeployment":true,"hasDestruction":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/106th_INFANTRY_REGIMENT.106th_INFANTRY_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":509.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_106th_infantry_regiment_photo","SourceString":"Soldiers of the Japanese Burma Area Army surrendering in 1945.","LocalizedString":"Soldiers of the Japanese Burma Area Army surrendering in 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_