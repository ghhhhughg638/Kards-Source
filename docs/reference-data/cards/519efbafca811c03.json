{"format":"kards-original-reference","version":1,"id":"519efbafca811c03","name":"card_event_mayhem","package":"/Game/Blueprints/Cards/USA/CovertOp/events/card_event_mayhem","parent":"UBaseCardObject","card":{"title":"MAYHEM","text":"Choose a unit in hand. Swap it with a friendly unit on the battlefield.","flavorText":"The Battle of Okinawa stands out as one of the most intense and chaotic engagements involving the USA during WWII. During the battle, US and Japanese forces exchanged relentless artillery fire. The US Tenth Army alone fired 1.1 million 105mm howitzer rounds, which is one of the largest barrages in WWII’s history. Combat was fierce and often hand-to-hand, and troops were engaged in intense fighting across hillsides, caves, trenches, bunkers, and pillboxes. XXIV Corps troops used 60-mm mortar tubes to launch 521,000 projectiles, fired nine million rifle bullets, consumed 16 million .30 caliber machine gun rounds, used 367,000 hand grenades, and fired 25,600 rifle grenades. Additionally, the US Navy fired approximately 600,000 rounds in support of ground operations. The human cost was immense, 12,520 US troops were killed or declared missing in action, 110,000 Japanese defenders were killed, and on top of that it is estimated that over 100,000 civilians lost their lives in the Okinawa Campaign.","faction":"USA","type":"order","rarity":"Unique","cost":4,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_mayhem","title":{"Namespace":"card_usa","Key":"card_event_mayhem_title","SourceString":"MAYHEM","LocalizedString":"MAYHEM"},"Type":"ETypeEnum::order","faction":"EFactionEnum::USA","kredits":4,"Text":{"Namespace":"card_usa","Key":"card_event_mayhem_text","SourceString":"Choose a unit in hand. Swap it with a friendly unit on the battlefield.","LocalizedString":"Choose a unit in hand. Swap it with a friendly unit on the battlefield."},"flavorText":{"Namespace":"card_usa","Key":"card_event_mayhem_history","SourceString":"The Battle of Okinawa stands out as one of the most intense and chaotic engagements involving the USA during WWII. During the battle, US and Japanese forces exchanged relentless artillery fire. The US Tenth Army alone fired 1.1 million 105mm howitzer rounds, which is one of the largest barrages in WWII’s history. Combat was fierce and often hand-to-hand, and troops were engaged in intense fighting across hillsides, caves, trenches, bunkers, and pillboxes. XXIV Corps troops used 60-mm mortar tubes to launch 521,000 projectiles, fired nine million rifle bullets, consumed 16 million .30 caliber machine gun rounds, used 367,000 hand grenades, and fired 25,600 rifle grenades. Additionally, the US Navy fired approximately 600,000 rounds in support of ground operations. The human cost was immense, 12,520 US troops were killed or declared missing in action, 110,000 Japanese defenders were killed, and on top of that it is estimated that over 100,000 civilians lost their lives in the Okinawa Campaign.","LocalizedString":"The Battle of Okinawa stands out as one of the most intense and chaotic engagements involving the USA during WWII. During the battle, US and Japanese forces exchanged relentless artillery fire. The US Tenth Army alone fired 1.1 million 105mm howitzer rounds, which is one of the largest barrages in WWII’s history. Combat was fierce and often hand-to-hand, and troops were engaged in intense fighting across hillsides, caves, trenches, bunkers, and pillboxes. XXIV Corps troops used 60-mm mortar tubes to launch 521,000 projectiles, fired nine million rifle bullets, consumed 16 million .30 caliber machine gun rounds, used 367,000 hand grenades, and fired 25,600 rifle grenades. Additionally, the US Navy fired approximately 600,000 rounds in support of ground operations. The human cost was immense, 12,520 US troops were killed or declared missing in action, 110,000 Japanese defenders were killed, and on top of that it is estimated that over 100,000 civilians lost their lives in the Okinawa Campaign."},"rarity":"ERarityEnum::Unique","selectTargetOnPlayedFromHand":true,"waitWithOnOtherCardPlayedUntilHandTargetSelected":true,"selectHandCardNotifyText":{"Namespace":"","Key":"E5A3983043871FE8E78F3E86FD63AE4E","SourceString":"Choose a unit in hand to replace a friendly unit on the battlefield.","LocalizedString":"Choose a unit in hand to replace a friendly unit on the battlefield."},"cardSet":"ECardSetEnum::CurrentExpansion","soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/CandidateArtwork/Summer_24/t_mayhem.t_mayhem","SubPathString":""},"artist":"US WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/MAYHEM.MAYHEM","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":405.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_event_mayhem_photo","SourceString":"Soldiers of the 1st Marine Division advancing behind a flame-throwing tank during the Battle of Okinawa, May 1945.","LocalizedString":"Soldiers of the 1st Marine Division advancing behind a flame-throwing tank during the Battle of Okinawa, May 1945."},"isRemoval":true},"variables":[{"name":"hasUnitInHand","type":"bool","direction":"in"},{"name":"hasUnitOnBoard","type":"bool","direction":"in"},{"name":"inFrontline","type":"bool","direction":"in"},{"name":"localTarget","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"CanPlayFromHand","owner":"card_event_mayhem_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms