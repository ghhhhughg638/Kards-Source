{"format":"kards-original-reference","version":1,"id":"7806576bc6af9b58","name":"card_unit_heinkel_he_59","package":"/Game/Blueprints/Cards/Germany/OceaniaStorm/units/card_unit_heinkel_he_59","parent":"UBaseCardObject","card":{"title":"HEINKEL HE 59","text":"Once per turn, when a friendly unit becomes Veteran, draw a card and gain a kredit.","flavorText":"The Heinkel He 59 was a large twin-engine biplane floatplane built for roles forbidden to Germany when its design began in 1930. Officially presented as a civil aircraft, it had in reality been developed for the Reichsmarine as a torpedo bomber and reconnaissance aircraft. The first landplane prototype flew in 1931,  but only the floatplane version went into production. A total of 142 were built. The He 59 was easy to fly, but its weak engines, short range, limited load, and light armament made it outdated by WWII. Even so, it found use in coastal reconnaissance, minelaying, torpedo training, transport, and air-sea rescue. During the early war it supported German operations in Norway and the Netherlands, then became closely linked with the Seenotstaffeln, the Luftwaffe air-sea rescue units. He 59 crews searched the Channel for downed German airmen during the Battle of Britain. British forces argued that some rescue aircraft also performed reconnaissance, making them valid targets despite their Red Cross markings. Later, in 1943, Finland later rented four He 59s for long range patrol and transport, before returning them to Germany.","faction":"Germany","type":"bomber","rarity":"Uncommon","cost":2,"operationCost":1,"attack":1,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_heinkel_he_59","title":{"Namespace":"card_germany","Key":"card_unit_heinkel_he_59_title","SourceString":"HEINKEL HE 59","LocalizedString":"HEINKEL HE 59"},"Type":"ETypeEnum::bomber","attack":1,"defense":4,"range":2,"faction":"EFactionEnum::Germany","kredits":2,"Text":{"Namespace":"card_germany","Key":"card_unit_heinkel_he_59_text","SourceString":"Once per turn, when a friendly unit becomes Veteran, draw a card and gain a kredit.","LocalizedString":"Once per turn, when a friendly unit becomes Veteran, draw a card and gain a kredit."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_heinkel_he_59_history","SourceString":"The Heinkel He 59 was a large twin-engine biplane floatplane built for roles forbidden to Germany when its design began in 1930. Officially presented as a civil aircraft, it had in reality been developed for the Reichsmarine as a torpedo bomber and reconnaissance aircraft. The first landplane prototype flew in 1931,  but only the floatplane version went into production. A total of 142 were built. The He 59 was easy to fly, but its weak engines, short range, limited load, and light armament made it outdated by WWII. Even so, it found use in coastal reconnaissance, minelaying, torpedo training, transport, and air-sea rescue. During the early war it supported German operations in Norway and the Netherlands, then became closely linked with the Seenotstaffeln, the Luftwaffe air-sea rescue units. He 59 crews searched the Channel for downed German airmen during the Battle of Britain. British forces argued that some rescue aircraft also performed reconnaissance, making them valid targets despite their Red Cross markings. Later, in 1943, Finland later rented four He 59s for long range patrol and transport, before returning them to Germany.","LocalizedString":"The Heinkel He 59 was a large twin-engine biplane floatplane built for roles forbidden to Germany when its design began in 1930. Officially presented as a civil aircraft, it had in reality been developed for the Reichsmarine as a torpedo bomber and reconnaissance aircraft. The first landplane prototype flew in 1931,  but only the floatplane version went into production. A total of 142 were built. The He 59 was easy to fly, but its weak engines, short range, limited load, and light armament made it outdated by WWII. Even so, it found use in coastal reconnaissance, minelaying, torpedo training, transport, and air-sea rescue. During the early war it supported German operations in Norway and the Netherlands, then became closely linked with the Seenotstaffeln, the Luftwaffe air-sea rescue units. He 59 crews searched the Channel for downed German airmen during the Battle of Britain. British forces argued that some rescue aircraft also performed reconnaissance, making them valid targets despite their Red Cross markings. Later, in 1943, Finland later rented four He 59s for long range patrol and transport, before returning them to Germany."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardBecomingVeteran","ERegisteredCardFunction::OnEndOfTurn"],"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/HEINKEL_HE_59.HEINKEL_HE_59","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_heinkel_he_59_photo","SourceString":"A Heinkel He 59 in flight. Date unknown.","LocalizedString":"A Heinkel He 59 in flight. Date unknown."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionAircraftM.49"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackBomber.BP_AttackBomber_C","SubPathString":""},"threat_level":0.1},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_heinkel_he_59","owner":"card_unit_heinkel_he_59_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"K2Node_Event_cardBecomingVeteran","type":"UBaseCardObject*","d