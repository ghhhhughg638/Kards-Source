{"format":"kards-original-reference","version":1,"id":"58c7626d71f881d5","name":"card_event_a_few_good_men","package":"/Game/Blueprints/Cards/USA/ToW/events/card_event_a_few_good_men","parent":"UBaseCardObject","card":{"title":"A FEW GOOD MEN","text":"Choose 1 of 3 random elite US units to add to your hand.","flavorText":"Shortly after the US Marines landed on Guadalcanal island their recon group was wiped out by the enemy during a patrol. Shortly after a barefoot man in tattered clothes reported to base, this was Major Martin Clemens British colonial administrator and soldier, and with him were his native scouts, and they would provide vital help with coordinating intelligence on Japanese activities on the island. His chief scout was Jacob C. Vouza, a retired Sergeant Major of the Solomon Islands Protectorate Armed Constabulary, but now back in service. On August 20, 1942, while Vouza was scouting for suspected Japanese outposts he was captured by the enemy. Having found a small American flag in Vouza's possession his capturers started torturing him for information. He was interrogated for hours, beaten, hanged upside down from a tree until he passed out, covered with red ants, but Vouza kept silent the whole time. Finally the Japanese soldiers bayoneted him seven times and left him to die, but once his captures departed Vouza chewed through his ropes and made it several miles to the American lines. Vouza managed to warn the Americans about an imminent attack, which gave them precious time to prepare for what is now known as the Battle of the Tenaru, where the Marines won a decisive victory. Vouza was rushed to the hospital where the doctors managed to save his life and after 12 days he returned to duty.","faction":"USA","type":"order","rarity":"Unique","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_a_few_good_men","title":{"Namespace":"card_usa","Key":"card_event_a_few_good_men_title","SourceString":"A FEW GOOD MEN","LocalizedString":"A FEW GOOD MEN"},"Type":"ETypeEnum::order","faction":"EFactionEnum::USA","kredits":2,"Text":{"Namespace":"card_usa","Key":"card_event_a_few_good_men_text","SourceString":"Choose 1 of 3 random elite US units to add to your hand.","LocalizedString":"Choose 1 of 3 random elite US units to add to your hand."},"flavorText":{"Namespace":"card_usa","Key":"card_event_a_few_good_men_history","SourceString":"Shortly after the US Marines landed on Guadalcanal island their recon group was wiped out by the enemy during a patrol. Shortly after a barefoot man in tattered clothes reported to base, this was Major Martin Clemens British colonial administrator and soldier, and with him were his native scouts, and they would provide vital help with coordinating intelligence on Japanese activities on the island. His chief scout was Jacob C. Vouza, a retired Sergeant Major of the Solomon Islands Protectorate Armed Constabulary, but now back in service. On August 20, 1942, while Vouza was scouting for suspected Japanese outposts he was captured by the enemy. Having found a small American flag in Vouza's possession his capturers started torturing him for information. He was interrogated for hours, beaten, hanged upside down from a tree until he passed out, covered with red ants, but Vouza kept silent the whole time. Finally the Japanese soldiers bayoneted him seven times and left him to die, but once his captures departed Vouza chewed through his ropes and made it several miles to the American lines. Vouza managed to warn the Americans about an imminent attack, which gave them precious time to prepare for what is now known as the Battle of the Tenaru, where the Marines won a decisive victory. Vouza was rushed to the hospital where the doctors managed to save his life and after 12 days he returned to duty.","LocalizedString":"Shortly after the US Marines landed on Guadalcanal island their recon group was wiped out by the enemy during a patrol. Shortly after a barefoot man in tattered clothes reported to base, this was Major Martin Clemens British colonial administrator and soldier, and with him were his native scouts, and they would provide vital help with coordinating intelligence on Japanese activities on the island. His chief scout was Jacob C. Vouza, a retired Sergeant Major of the Solomon Islands Protectorate Armed Constabulary, but now back in service. On August 20, 1942, while Vouza was scouting for suspected Japanese outposts he was captured by the enemy. Having found a small American flag in Vouza's possession his capturers started torturing him for information. He was interrogated for hours, beaten, hanged upside down from a tree until he passed out, covered with red ants, but Vouza kept silent the whole time. Finally the Japanese soldiers bayoneted him seven times and left him to die, but once his captures departed Vouza chewed through his ropes and made it several miles to the American lines. Vouza managed to warn the Americans about an imminent attack, which gave them precious time to prepare for what is now known as the Battle of the Tenaru, where the Marines won a decisive victory. Vouza was rushed to the hospital where the doctors managed to save his life and after 12 days he returned to duty."},"rarity":"ERarityEnum::Unique","waitWithOnOtherCardPlayedUntilHandTargetSelected":true,"cardSet":"ECardSetEnum::Campaign2020","isInPermanentPool":true,"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/t_a_few_good_men.t_a_few_good_men","SubPathString":""},"artist":"Pictures Now / Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/A_FEW_GOOD_MEN.A_FEW_GOOD_MEN","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":726.0},"historyPhotoSource":"Unknown","historyPhotoDescription":{"Namespace":"card_usa","Key":"card_event_a_few_good_men_photo","SourceString":"Jacob C. Vouza holding a captured Japanese sword, Guadalcanal, 1942.","LocalizedString":"Jacob C. Vouza holding a captured Japanese sword, Guadalcanal, 1942."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"isAttackBuff":true,"isDefenseBuff":true},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_event_a_few_good_men","owner":"card_event_a_few_good_men_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_selectCardToDraw_drawnCardID","type":"int32","direction":"in"}],"body":[{"op":"ComputedJump","at":0,"value":{"op":"Variable","name":"EntryPoint","type":"int32","scope":"local","sourceOp":"LocalVariable"}},{"op":"Context","at":10,"object":{"op":"Variable","name":"cardFunction","type":"ACardFunctionsStub*","scope":"member","sourceOp":"InstanceVariable"},"value":{"op":"LocalVirtualFunction","name":"selectCardToDraw","signature":"CardFunctionsStub.selectCardToDraw","args":[{"op":"Variable","name":"cardID","type":"int32","scope":"member","sourceOp":"InstanceVariable"},{"op":"False"},{"op":"False"},{"op":"Variable","name":"CallFunc_selectCardToDraw_drawnCardID","type":"int32","scope":"local","sourceOp":"LocalVariable"}]}},{"op":"Return","at":66,"value":{"op":"Nothing"}},{"op":"EndOfScript","at":68}]},{"name":"GetChooseSpawnCards","owner":"card_event_a_few_good_men_C","params":[{"name":"cards","type":"TArray<UBaseCardObject*>","direction":"out"},{"name":"markAsSeen","type":"bool","direction":"out"},{"name":"keepOrder","type":"bool","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_HasDefaults | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"PossibleCards","type":"TArray<UBa