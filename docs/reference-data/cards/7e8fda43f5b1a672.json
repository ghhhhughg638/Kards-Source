{"format":"kards-original-reference","version":1,"id":"7e8fda43f5b1a672","name":"card_event_supply_front","package":"/Game/Blueprints/Cards/USA/Allegiance/events/card_event_supply_front","parent":"UBaseCardObject","card":{"title":"SUPPLY FRONT","text":"Fully repair all units in the frontline and give them +1+2.","flavorText":"Delivering supplies to frontline troops in war is always a logistical challenge. After the successful landings in Normandy, the Allied forces moved quickly through Europe, and to expedite cargo shipments to the front a convoy system was put into operation. The convoy system was called Red Ball Express and it was primarily staffed with African-American soldiers who operated 5,958 vehicles and carried 12,500 tonnes of supplies a day. The convoy express operated non-stop for 83 days, or until port facilities at Antwerp, Belgium were opened, French rail lines were repaired, and portable gasoline pipelines were deployed.","faction":"USA","type":"order","rarity":"Common","cost":5,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_supply_front","title":{"Namespace":"card_usa","Key":"card_event_supply_front_title","SourceString":"SUPPLY FRONT","LocalizedString":"SUPPLY FRONT"},"Type":"ETypeEnum::order","faction":"EFactionEnum::USA","kredits":5,"Text":{"Namespace":"card_usa","Key":"card_event_supply_front_text","SourceString":"Fully repair all units in the frontline and give them +1+2.","LocalizedString":"Fully repair all units in the frontline and give them +1+2."},"flavorText":{"Namespace":"card_usa","Key":"card_event_supply_front_history","SourceString":"Delivering supplies to frontline troops in war is always a logistical challenge. After the successful landings in Normandy, the Allied forces moved quickly through Europe, and to expedite cargo shipments to the front a convoy system was put into operation. The convoy system was called Red Ball Express and it was primarily staffed with African-American soldiers who operated 5,958 vehicles and carried 12,500 tonnes of supplies a day. The convoy express operated non-stop for 83 days, or until port facilities at Antwerp, Belgium were opened, French rail lines were repaired, and portable gasoline pipelines were deployed.","LocalizedString":"Delivering supplies to frontline troops in war is always a logistical challenge. After the successful landings in Normandy, the Allied forces moved quickly through Europe, and to expedite cargo shipments to the front a convoy system was put into operation. The convoy system was called Red Ball Express and it was primarily staffed with African-American soldiers who operated 5,958 vehicles and carried 12,500 tonnes of supplies a day. The convoy express operated non-stop for 83 days, or until port facilities at Antwerp, Belgium were opened, French rail lines were repaired, and portable gasoline pipelines were deployed."},"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Expansion2019","isReserved":true,"soundEnterPlay":{"ObjectName":"SoundWave'AU_depl_Train_01'","ObjectPath":"kards/Content/Assets/Audio/Train/AU_depl_Train_01.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/t_supply_train.t_supply_train","SubPathString":""},"artist":"Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/SUPPLY_FRONT.SUPPLY_FRONT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":610.0},"historyPhotoSource":"US National Archives","historyPhotoIdentificationCode":"530707","historyPhotoDescription":{"Namespace":"card_usa","Key":"card_event_supply_front_photo","SourceString":"Military Policeman and sign posted along the Red Ball Route, France, 1944.","LocalizedString":"Military Policeman and sign posted along the Red Ball Route, France, 1944."},"isAttackBuff":true,"isDefenseBuff":true},"variables":[{"name":"tempCard","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_supply_front","owner":"card_event_supply_fr