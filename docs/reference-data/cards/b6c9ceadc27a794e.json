{"format":"kards-original-reference","version":1,"id":"b6c9ceadc27a794e","name":"card_unit_panzer_35t_commander","package":"/Game/Blueprints/Cards/Germany/Breakthrough/units/card_unit_panzer_35t_commander","parent":"UBaseCardObject","card":{"title":"Pz. BEFEHLSWAGEN 35t","text":"If this unit is in hand, add it to the frontline when you take it.","flavorText":"The Panzerbefehlswagen 35(t) was a command tank variant of the Panzer 35(t) light tank, which was a Czechoslovakian design, but mainly used by the Germans during WWII. The tank had a crew of 4, a main armament of a 3.7 cm (1.5 in) KwK 34(t) gun and 2 x 7.92 mm MG 37(t) machine guns a secondary armament. The German command tank version carried less ammunition to make room for an extra radio and a gyrocompass and it could be recognized by the radio antenna mounted on the rear deck that looks like a fence. 434 Panzer 35(t) tanks were built between 1936-1940.","faction":"Germany","type":"tank","rarity":"Rare","cost":2,"operationCost":1,"attack":2,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_panzer_35t_commander","title":{"Namespace":"card_germany","Key":"card_unit_panzer_35t_commander_title","SourceString":"Pz. BEFEHLSWAGEN 35t","LocalizedString":"Pz. BEFEHLSWAGEN 35t"},"Type":"ETypeEnum::tank","attack":2,"defense":2,"range":1,"faction":"EFactionEnum::Germany","kredits":2,"Text":{"Namespace":"card_germany","Key":"card_unit_panzer_35t_commander_text","SourceString":"If this unit is in hand, add it to the frontline when you take it.","LocalizedString":"If this unit is in hand, add it to the frontline when you take it."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_panzer_35t_commander_history","SourceString":"The Panzerbefehlswagen 35(t) was a command tank variant of the Panzer 35(t) light tank, which was a Czechoslovakian design, but mainly used by the Germans during WWII. The tank had a crew of 4, a main armament of a 3.7 cm (1.5 in) KwK 34(t) gun and 2 x 7.92 mm MG 37(t) machine guns a secondary armament. The German command tank version carried less ammunition to make room for an extra radio and a gyrocompass and it could be recognized by the radio antenna mounted on the rear deck that looks like a fence. 434 Panzer 35(t) tanks were built between 1936-1940.","LocalizedString":"The Panzerbefehlswagen 35(t) was a command tank variant of the Panzer 35(t) light tank, which was a Czechoslovakian design, but mainly used by the Germans during WWII. The tank had a crew of 4, a main armament of a 3.7 cm (1.5 in) KwK 34(t) gun and 2 x 7.92 mm MG 37(t) machine guns a secondary armament. The German command tank version carried less ammunition to make room for an extra radio and a gyrocompass and it could be recognized by the radio antenna mounted on the rear deck that looks like a fence. 434 Panzer 35(t) tanks were built between 1936-1940."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Breakthrough","isReserved":true,"usedTriggers":["ERegisteredCardFunction::OnFrontlineOwnershipChange"],"soundBlowUp":{"ObjectName":"SoundWave'Explosion02'","ObjectPath":"kards/Content/StarterContent/Audio/Explosion02.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/CandidateArtwork/t_pz35t_rommel.t_pz35t_rommel","SubPathString":""},"artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/Pz__BEFEHLSWAGEN_35t.Pz__BEFEHLSWAGEN_35t","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":324.0},"historyPhotoSource":"German Federal Archives","historyPhotoIdentificationCode":"101I-769-0236-23","historyPhotoAuthor":"Borchert, Erich","historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_panzer_35t_commander_photo","SourceString":"Panzer 35(t) command vehicle leading a tank column, France, 1940. ","LocalizedString":"Panzer 35(t) command vehicle leading a tank column, France, 1940. "},"historyTypeDescription":{"Namespace":"card_germany","Key":"card_unit_panzer_35t_commander_header","S