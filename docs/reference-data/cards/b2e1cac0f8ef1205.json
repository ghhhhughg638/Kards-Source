{"format":"kards-original-reference","version":1,"id":"b2e1cac0f8ef1205","name":"card_unit_yak_9","package":"/Game/Blueprints/Cards/Soviet/Base/units/card_unit_yak_9","parent":"UBaseCardObject","card":{"title":"YAK 9","text":"Destruction: Draw a random Soviet card.","flavorText":"The Yakovlev Yak-9 was a single-engine fighter aircraft designed and used by the Soviet Union in WWII. The aircraft first saw combat in late 1942 and took on various roles later in the war. It was used as a light bomber, in long-range escort roles and as an anti-tank aircraft, but it was also highly maneuverable, very fast and performed well against the Bf 109 and Fw 190A enemy fighters. In total there were 14,579 Yak 9s manufactured during the war and it suffered lower losses on average, with only 383 lost in combat.","faction":"Soviet","type":"fighter","rarity":"Rare","cost":5,"operationCost":2,"attack":4,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_yak_9","title":{"Namespace":"card_soviet","Key":"card_unit_yak_9_title","SourceString":"YAK 9","LocalizedString":"YAK 9"},"Type":"ETypeEnum::fighter","attack":4,"defense":5,"range":2,"faction":"EFactionEnum::Soviet","kredits":5,"Text":{"Namespace":"card_soviet","Key":"card_unit_yak_9_text","SourceString":"Destruction: Draw a random Soviet card.","LocalizedString":"Destruction: Draw a random Soviet card."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_yak_9_history","SourceString":"The Yakovlev Yak-9 was a single-engine fighter aircraft designed and used by the Soviet Union in WWII. The aircraft first saw combat in late 1942 and took on various roles later in the war. It was used as a light bomber, in long-range escort roles and as an anti-tank aircraft, but it was also highly maneuverable, very fast and performed well against the Bf 109 and Fw 190A enemy fighters. In total there were 14,579 Yak 9s manufactured during the war and it suffered lower losses on average, with only 383 lost in combat.","LocalizedString":"The Yakovlev Yak-9 was a single-engine fighter aircraft designed and used by the Soviet Union in WWII. The aircraft first saw combat in late 1942 and took on various roles later in the war. It was used as a light bomber, in long-range escort roles and as an anti-tank aircraft, but it was also highly maneuverable, very fast and performed well against the Bf 109 and Fw 190A enemy fighters. In total there were 14,579 Yak 9s manufactured during the war and it suffered lower losses on average, with only 383 lost in combat."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Basic","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Destruction"],"hasDestruction":true,"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/01_Base/T_yak_9.T_yak_9","SubPathString":""},"artist":"Keith Woodcock","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/YAK_9.YAK_9","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":224.0},"historyPhotoSource":"airwar.ru","historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_yak_9_photo","SourceString":"Yakovlev Yak-9K, cannon-armed Soviet fighter.","LocalizedString":"Yakovlev Yak-9K, cannon-armed Soviet fighter."},"historyTypeDescription":{"Namespace":"card_soviet","Key":"card_unit_yak_9_header","SourceString":"Fighter Aircraft","LocalizedString":"Fighter Aircraft"},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackFighter.BP_AttackFighter_C","SubPathString":""}},"variabl