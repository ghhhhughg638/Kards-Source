{"format":"kards-original-reference","version":1,"id":"f153e2e27f0b9829","name":"card_event_german_counterattack","package":"/Game/Blueprints/Cards/Germany/OceaniaStorm/events/card_event_german_counterattack","parent":"UBaseCardObject","card":{"title":"COUNTERATTACK","text":"Your Veteran units get +2+2. Then each friendly unit fights a random enemy unit.","flavorText":"After the German defeat at Stalingrad, Soviet armies pushed west across Ukraine in early 1943. Their advance created deep salients and stretched supply lines, while German forces fell back in disorder. Field Marshal Erich von Manstein, commanding Army Group South, chose not to defend every position. Instead, he pulled mobile units back, waited for the Soviet spearheads to overextend, and prepared a counterattack. In February and March 1943, German panzer and infantry formations struck the exposed Soviet flanks around Kharkov. German forces cut off several forward Soviet units, retook some lost ground, and forced the Red Army to abandon positions taken during its winter offensive. Kharkov was recaptured in March after hard fighting in and around the city. The counterstrike restored part of the German front in southern Ukraine and delayed further Soviet advances until summer. It also showed that German mobile warfare could still be dangerous when used against an overstretched enemy, even after the disaster at Stalingrad.","faction":"Germany","type":"order","rarity":"Unique","cost":3,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_german_counterattack","title":{"Namespace":"card_germany","Key":"card_event_german_counterattack_title","SourceString":"COUNTERATTACK","LocalizedString":"COUNTERATTACK"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Germany","kredits":3,"Text":{"Namespace":"card_germany","Key":"card_event_german_counterattack_text","SourceString":"Your Veteran units get +2+2. Then each friendly unit fights a random enemy unit.","LocalizedString":"Your Veteran units get +2+2. Then each friendly unit fights a random enemy unit."},"flavorText":{"Namespace":"card_germany","Key":"card_event_german_counterattack_history","SourceString":"After the German defeat at Stalingrad, Soviet armies pushed west across Ukraine in early 1943. Their advance created deep salients and stretched supply lines, while German forces fell back in disorder. Field Marshal Erich von Manstein, commanding Army Group South, chose not to defend every position. Instead, he pulled mobile units back, waited for the Soviet spearheads to overextend, and prepared a counterattack. In February and March 1943, German panzer and infantry formations struck the exposed Soviet flanks around Kharkov. German forces cut off several forward Soviet units, retook some lost ground, and forced the Red Army to abandon positions taken during its winter offensive. Kharkov was recaptured in March after hard fighting in and around the city. The counterstrike restored part of the German front in southern Ukraine and delayed further Soviet advances until summer. It also showed that German mobile warfare could still be dangerous when used against an overstretched enemy, even after the disaster at Stalingrad.","LocalizedString":"After the German defeat at Stalingrad, Soviet armies pushed west across Ukraine in early 1943. Their advance created deep salients and stretched supply lines, while German forces fell back in disorder. Field Marshal Erich von Manstein, commanding Army Group South, chose not to defend every position. Instead, he pulled mobile units back, waited for the Soviet spearheads to overextend, and prepared a counterattack. In February and March 1943, German panzer and infantry formations struck the exposed Soviet flanks around Kharkov. German forces cut off several forward Soviet units, retook some lost ground, and forced the Red Army to abandon positions taken during its winter offensive. Kharkov was recaptured in March after hard fighting in and around the city. The counterstrike restored part of the German front in southern Ukraine and delayed further Soviet advances until summer. It also showed that German mobile warfare could still be dangerous when used against an overstretched enemy, even after the disaster at Stalingrad."},"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::OceaniaStorm","soundEnterPlay":{"ObjectName":"SoundWave'AU_AirCraft_Bomber_flyby_04_6s'","ObjectPath":"kards/Content/Assets/Audio/Bomber/AU_AirCraft_Bomber_flyby_04_6s.0"},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/COUNTERATTACK.COUNTERATTACK","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_event_german_counterattack_photo","SourceString":"A German tank column awaiting orders during the Third Battle of Karkhov, Eastern Front, 1943.","LocalizedString":"A German tank column awaiting orders during the Third Battle of Karkhov, Eastern Front, 1943."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"isDirectDamage":true},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_event_german_counterattack","owner":"card_event_german_counterattack_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable_1","type":"int32","direction":"in"},{"name":"CallFunc_GetAllUnitsOnBoard_cards","type":"TArray<UBaseCardObject*>","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue_1","type":"int32","direction":"in"},{"name":"CallFunc_Array_Length_ReturnValue","type":"int