{"format":"kards-original-reference","version":1,"id":"b202a622d4cc50a7","name":"card_event_victory_march","package":"/Game/Blueprints/Cards/USA/WinterWar/events/card_event_victory_march","parent":"UBaseCardObject","card":{"title":"VICTORY MARCH","text":"Set the operation cost of your units to 0. Gain HQ defense equal to total cost reduced.","flavorText":"The Battle of the Bulge (December 16th, 1944 – January 16th, 1945), codenamed \"Unternehmen Wacht am Rhein\",  marked the last German offensive on the Western Front, and despite initial successes and complete surprise, the Germans could not gain the upper hand. Their Ardennes operation caused significant losses and delayed the Allied invasion of Germany by several weeks, but by February 1945, the Western Front lines were largely back to where they were in December 1944. The German casualties were severe, depleting their last reserves and damaging the Luftwaffe, and on top of that the Soviets began the Vistula-Oder Offensive where they conquered most of the pre-war Polish territory. After this, Germany’s defeat was only a matter of time.","faction":"USA","type":"order","rarity":"Unique","cost":5,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_victory_march","title":{"Namespace":"card_usa","Key":"card_event_victory_march_title","SourceString":"VICTORY MARCH","LocalizedString":"VICTORY MARCH"},"Type":"ETypeEnum::order","faction":"EFactionEnum::USA","kredits":5,"Text":{"Namespace":"card_usa","Key":"card_event_victory_march_text","SourceString":"Set the operation cost of your units to 0. Gain HQ defense equal to total cost reduced.","LocalizedString":"Set the operation cost of your units to 0. Gain HQ defense equal to total cost reduced."},"flavorText":{"Namespace":"card_usa","Key":"card_event_victory_march_history","SourceString":"The Battle of the Bulge (December 16th, 1944 – January 16th, 1945), codenamed \"Unternehmen Wacht am Rhein\",  marked the last German offensive on the Western Front, and despite initial successes and complete surprise, the Germans could not gain the upper hand. Their Ardennes operation caused significant losses and delayed the Allied invasion of Germany by several weeks, but by February 1945, the Western Front lines were largely back to where they were in December 1944. The German casualties were severe, depleting their last reserves and damaging the Luftwaffe, and on top of that the Soviets began the Vistula-Oder Offensive where they conquered most of the pre-war Polish territory. After this, Germany’s defeat was only a matter of time.","LocalizedString":"The Battle of the Bulge (December 16th, 1944 – January 16th, 1945), codenamed \"Unternehmen Wacht am Rhein\",  marked the last German offensive on the Western Front, and despite initial successes and complete surprise, the Germans could not gain the upper hand. Their Ardennes operation caused significant losses and delayed the Allied invasion of Germany by several weeks, but by February 1945, the Western Front lines were largely back to where they were in December 1944. The German casualties were severe, depleting their last reserves and damaging the Luftwaffe, and on top of that the Soviets began the Vistula-Oder Offensive where they conquered most of the pre-war Polish territory. After this, Germany’s defeat was only a matter of time."},"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::WinterWar","isReserved":true,"soundEnterPlay":{"ObjectName":"SoundWave'Monty'","ObjectPath":"kards/Content/Assets/Audio/Misc/Monty.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/CandidateArtwork/Winter_War/t_cover.t_cover","SubPathString":""},"artist":"Nicolas Trudgian","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/VICTORY_MARCH.VICTORY_MARCH","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":399.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_event_victory_march_photo","SourceString":"US infantry crossing