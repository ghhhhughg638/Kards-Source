{"format":"kards-original-reference","version":1,"id":"fb235d68337da99b","name":"card_unit_m3_lee_home","package":"/Game/Blueprints/Cards/USA/Homefront/units/card_unit_m3_lee_home","parent":"UBaseCardObject","card":{"title":"M3 LEE","text":"When this unit moves into the frontline, all units in your deck get +1 attack.","flavorText":"Introduced in 1941, the M3 Lee was an American medium tank developed rapidly to meet the urgent need for a 75 mm gun platform. Designed as a stopgap before the M4 Sherman was available, the M3 featured a distinctive layout with a sponson-mounted 75 mm gun in the hull and a smaller 37 mm gun in a turret above. Its tall silhouette and riveted armor were drawbacks, limiting its effectiveness in hull-down positions. Still, it offered strong firepower and reliable performance early in the war. A total of 6,258 units were produced between August 1941 and December 1942 by several manufacturers, including the Detroit Tank Arsenal and Baldwin Locomotive Works. In British service,  versions using the original US turret were called Lee, while those modified to British specifications were named Grant. The M3 first saw action in North Africa, where it initially outmatched the Panzer III and early Panzer IVs. However, by mid-1943 it was largely replaced in European theaters by the M4 Sherman. It continued to serve in the Pacific and with Allied forces, including the Soviet Union, through the Lend-Lease program. Despite its limitations, the M3 Lee played a vital role in bridging the gap to more advanced designs.","faction":"USA","type":"tank","rarity":"Rare","cost":3,"operationCost":2,"attack":4,"defense":4},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.bond"],"Name":"card_unit_m3_lee_home","title":{"Namespace":"card_usa","Key":"card_unit_m3_lee_home_title","SourceString":"M3 LEE","LocalizedString":"M3 LEE"},"Type":"ETypeEnum::tank","attack":4,"defense":4,"range":1,"faction":"EFactionEnum::USA","kredits":3,"Text":{"Namespace":"card_usa","Key":"card_unit_m3_lee_home_text","SourceString":"When this unit moves into the frontline, all units in your deck get +1 attack.","LocalizedString":"When this unit moves into the frontline, all units in your deck get +1 attack."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_m3_lee_home_history","SourceString":"Introduced in 1941, the M3 Lee was an American medium tank developed rapidly to meet the urgent need for a 75 mm gun platform. Designed as a stopgap before the M4 Sherman was available, the M3 featured a distinctive layout with a sponson-mounted 75 mm gun in the hull and a smaller 37 mm gun in a turret above. Its tall silhouette and riveted armor were drawbacks, limiting its effectiveness in hull-down positions. Still, it offered strong firepower and reliable performance early in the war. A total of 6,258 units were produced between August 1941 and December 1942 by several manufacturers, including the Detroit Tank Arsenal and Baldwin Locomotive Works. In British service,  versions using the original US turret were called Lee, while those modified to British specifications were named Grant. The M3 first saw action in North Africa, where it initially outmatched the Panzer III and early Panzer IVs. However, by mid-1943 it was largely replaced in European theaters by the M4 Sherman. It continued to serve in the Pacific and with Allied forces, including the Soviet Union, through the Lend-Lease program. Despite its limitations, the M3 Lee played a vital role in bridging the gap to more advanced designs.","LocalizedString":"Introduced in 1941, the M3 Lee was an American medium tank developed rapidly to meet the urgent need for a 75 mm gun platform. Designed as a stopgap before the M4 Sherman was available, the M3 featured a distinctive layout with a sponson-mounted 75 mm gun in the hull and a smaller 37 mm gun in a turret above. Its tall silhouette and riveted armor were drawbacks, limiting its effectiveness in hull-down positions. Still, it offered strong firepower and reliable performance early in the war. A total of 6,258 units were produced between August 1941 and December 1942 by several manufacturers, including the Detroit Tank Arsenal and Baldwin Locomotive Works. In British service,  versions using the original US turret were called Lee, while those modified to British specifications were named Grant. The M3 first saw action in North Africa, where it initially outmatched the Panzer III and early Panzer IVs. However, by mid-1943 it was largely replaced in European theaters by the M4 Sherman. It continued to serve in the Pacific and with Allied forces, including the Soviet Union, through the Lend-Lease program. Despite its limitations, the M3 Lee played a vital role in bridging the gap to more advanced designs."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::NotAvailable"],"hasAmbush":true,"hasSmokescreen":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/M3_LEE.M3_LEE","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_m3_lee_home_photo","SourceString":"M3 Lee tank during training exercises, Fort Knox, Kentucky, 1942.","LocalizedString":"M3 Lee tank during training exercises, Fort Knox, Kentucky, 1942."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionArmourM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionArmourM.36"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Tanks/BP_AttackTank.BP_AttackTank_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_m3_lee_home","owner":"card_unit_m3_lee_home_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"