{"format":"kards-original-reference","version":1,"id":"6868489ac90e701d","name":"card_unit_16th_infantry_brigade","package":"/Game/Blueprints/Cards/ANZAC/units/card_unit_16th_infantry_brigade","parent":"UBaseCardObject","card":{"title":"16th INFANTRY BRIGADE","text":"Becomes Veteran after you play a Rain or a Storm card.","flavorText":"The 16th Infantry Brigade was part of the 6th Australian Division during WWII. It was raised in 1939 as part of the Second Australian Imperial Force and was one of the first Australian volunteer formations ready for overseas service. After training in Australia, it sailed for the Middle East in 1940 and entered combat in the Western Desert campaign. Its first major engagement came at Bardia in January 1941, followed by service around Tobruk. In Greece, the brigade resisted against the German advance. Its battalions helped cover the retreat through Veria Pass, Tempe Gorge, and Larissa before being evacuated. Some elements reached Crete, where the 2/1st Battalion was largely destroyed while defending Retimo airfield. After Japan entered the war, the brigade shipped to the Pacific. In 1942, it crossed the Owen Stanley Range in Papua New Guinea during the Kokoda campaign, fought around Eora Creek and Oivi Gorari, then advanced toward the Japanese beachheads at Sanananda. Later, after rebuilding in Australia, the brigade returned to New Guinea for the Aitape-Wewak campaign, conducting patrols and small actions until the end of the war.","faction":"Anzac","type":"infantry","rarity":"Uncommon","cost":4,"operationCost":1,"attack":4,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_16th_infantry_brigade","title":{"Namespace":"card_anzac","Key":"card_unit_16th_infantry_brigade_title","SourceString":"16th INFANTRY BRIGADE","LocalizedString":"16th INFANTRY BRIGADE"},"Type":"ETypeEnum::infantry","attack":4,"defense":6,"range":1,"faction":"EFactionEnum::Anzac","kredits":4,"Text":{"Namespace":"card_anzac","Key":"card_unit_16th_infantry_brigade_text","SourceString":"Becomes Veteran after you play a Rain or a Storm card.","LocalizedString":"Becomes Veteran after you play a Rain or a Storm card."},"flavorText":{"Namespace":"card_anzac","Key":"card_unit_16th_infantry_brigade_history","SourceString":"The 16th Infantry Brigade was part of the 6th Australian Division during WWII. It was raised in 1939 as part of the Second Australian Imperial Force and was one of the first Australian volunteer formations ready for overseas service. After training in Australia, it sailed for the Middle East in 1940 and entered combat in the Western Desert campaign. Its first major engagement came at Bardia in January 1941, followed by service around Tobruk. In Greece, the brigade resisted against the German advance. Its battalions helped cover the retreat through Veria Pass, Tempe Gorge, and Larissa before being evacuated. Some elements reached Crete, where the 2/1st Battalion was largely destroyed while defending Retimo airfield. After Japan entered the war, the brigade shipped to the Pacific. In 1942, it crossed the Owen Stanley Range in Papua New Guinea during the Kokoda campaign, fought around Eora Creek and Oivi Gorari, then advanced toward the Japanese beachheads at Sanananda. Later, after rebuilding in Australia, the brigade returned to New Guinea for the Aitape-Wewak campaign, conducting patrols and small actions until the end of the war.","LocalizedString":"The 16th Infantry Brigade was part of the 6th Australian Division during WWII. It was raised in 1939 as part of the Second Australian Imperial Force and was one of the first Australian volunteer formations ready for overseas service. After training in Australia, it sailed for the Middle East in 1940 and entered combat in the Western Desert campaign. Its first major engagement came at Bardia in January 1941, followed by service around Tobruk. In Greece, the brigade resisted against the German advance. Its battalions helped cover the retreat through Veria Pass, Tempe Gorge, and Larissa before being evacuated. Some elements reached Crete, where the 2/1st Battalion was largely destroyed while defending Retimo airfield. After Japan entered the war, the brigade shipped to the Pacific. In 1942, it crossed the Owen Stanley Range in Papua New Guinea during the Kokoda campaign, fought around Eora Creek and Oivi Gorari, then advanced toward the Japanese beachheads at Sanananda. Later, after rebuilding in Australia, the brigade returned to New Guinea for the Aitape-Wewak campaign, conducting patrols and small actions until the end of the war."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::OceaniaStorm","usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"spawnCardName":"card_unit_16th_infantry_brigade_vet","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/16th_INFANTRY_BRIGADE.16th_INFANTRY_BRIGADE","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_anzac","Key":"card_unit_16th_infantry_brigade_photo","SourceString":"Men of the 16th Brigade during the Battle of Bardia, Libya, 1941.","LocalizedString":"Men of the 16th Brigade during the Battle of Bardia, Libya, 1941."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_16th_infantry_brigade","owner":"card_unit_16th_infantry_brigade_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"CallFunc_IsLocatedOnBoard_isIt","type":"bool"