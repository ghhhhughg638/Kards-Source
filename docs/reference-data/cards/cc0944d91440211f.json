{"format":"kards-original-reference","version":1,"id":"cc0944d91440211f","name":"card_event_turmoil","package":"/Game/Blueprints/Cards/Soviet/CovertOp/events/card_event_turmoil","parent":"UBaseCardObject","card":{"title":"TURMOIL","text":"Deal 2 damage to a unit. Deal 4 instead if it is damaged.","flavorText":"The Battle of Stalingrad was a brutal and pivotal clash during WWII. The city held significant strategic and symbolic importance for both Germany and the Soviet Union during WWII. For Germany, capturing the city would secure access to crucial oil fields and control of the Volga River which was a vital transportation route. For the Soviets, Stalingrad bore the name of their leader, Stalin, and its loss would be a major blow to their morale. The battle began in July 1942 with German forces, supported by the Luftwaffe, launching a massive offensive that reduced much of the city to rubble. The fighting soon turned into intense urban combat, with both sides pouring in reinforcements. By November, the Germans had pushed the Soviets back to the Volga River, but the harsh winter conditions hampered their progress. The Battle of Stalingrad ended on February 2, 1943, with the surrender of the remaining German forces trapped in the city after months of brutal urban warfare and a successful Soviet counteroffensive.","faction":"Soviet","type":"order","rarity":"Uncommon","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_turmoil","title":{"Namespace":"card_soviet","Key":"card_event_turmoil_title","SourceString":"TURMOIL","LocalizedString":"TURMOIL"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Soviet","kredits":2,"Text":{"Namespace":"card_soviet","Key":"card_event_turmoil_text","SourceString":"Deal 2 damage to a unit. Deal 4 instead if it is damaged.","LocalizedString":"Deal 2 damage to a unit. Deal 4 instead if it is damaged."},"flavorText":{"Namespace":"card_soviet","Key":"card_event_turmoil_history","SourceString":"The Battle of Stalingrad was a brutal and pivotal clash during WWII. The city held significant strategic and symbolic importance for both Germany and the Soviet Union during WWII. For Germany, capturing the city would secure access to crucial oil fields and control of the Volga River which was a vital transportation route. For the Soviets, Stalingrad bore the name of their leader, Stalin, and its loss would be a major blow to their morale. The battle began in July 1942 with German forces, supported by the Luftwaffe, launching a massive offensive that reduced much of the city to rubble. The fighting soon turned into intense urban combat, with both sides pouring in reinforcements. By November, the Germans had pushed the Soviets back to the Volga River, but the harsh winter conditions hampered their progress. The Battle of Stalingrad ended on February 2, 1943, with the surrender of the remaining German forces trapped in the city after months of brutal urban warfare and a successful Soviet counteroffensive.","LocalizedString":"The Battle of Stalingrad was a brutal and pivotal clash during WWII. The city held significant strategic and symbolic importance for both Germany and the Soviet Union during WWII. For Germany, capturing the city would secure access to crucial oil fields and control of the Volga River which was a vital transportation route. For the Soviets, Stalingrad bore the name of their leader, Stalin, and its loss would be a major blow to their morale. The battle began in July 1942 with German forces, supported by the Luftwaffe, launching a massive offensive that reduced much of the city to rubble. The fighting soon turned into intense urban combat, with both sides pouring in reinforcements. By November, the Germans had pushed the Soviets back to the Volga River, but the harsh winter conditions hampered their progress. The Battle of Stalingrad ended on February 2, 1943, with the surrender of the remaining German forces trapped in the city after months of brutal urban warfare and a successful Soviet counteroffensive."},"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::CurrentExpansion","isReserved":true,"soundEnterPlay":{"ObjectName":"SoundWave'The_Hammer'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/The_Hammer.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/Summer_24/t_turmoil.t_turmoil","SubPathString":""},"Delay":2.5,"artist":"Soviet WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/TURMOIL.TURMOIL","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":495.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_event_turmoil_photo","SourceString":"Soviet soldiers in a trench during the battle of Stalingrad, 1942.","LocalizedString":"Soviet soldiers in a trench during the battle of Stalingrad, 1942."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_OrderDiveBomber.BP_OrderDiveBomber_C","SubPathString":""},"isDirectDamage":true},"variables":[],"functions":[{"name":"CanPlayFromHand","owner":"card_event_turmoil_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","direction":"in"},{"name":"CallFunc_GetTargetedCard_card","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_IsUnit_isIt","type":"bool","direction":"in"}],"body":[{"op":"Context","at":0,"object":{"op":"Variable","name":"cardFunction","type":"ACardFunctionsStub*","scope":"member","sourceOp":"InstanceVariable"},"value":{"op":"LocalVirtualFunction","name":"GetTa