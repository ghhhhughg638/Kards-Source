{"format":"kards-original-reference","version":1,"id":"cceb557812017a88","name":"card_unit_4th_alabama","package":"/Game/Blueprints/Cards/USA/NavalWarfare/units/card_unit_4th_alabama","parent":"UBaseCardObject","card":{"title":"4th ALABAMA","text":"Show when drawn: Give your units +1 attack until end of turn.","flavorText":"The 167th Infantry Regiment, known as the \"4th Alabama\", is a unit of the US Army which has been active from 1836 to this day. During WWII, the regiment served with the 31st \"Dixie\" Division in the Pacific Theater. After deploying in March 1944, the regiment saw its first combat in July along the northern coast of New Guinea. In September, elements of the 167th participated in the amphibious assault on Morotai Island, securing key positions and eliminating remaining Japanese resistance by January 1945. Later, the regiment moved to the Philippines, landing on Mindanao in April 1945. There, the 167th faced challenging terrain and harsh conditions as it advanced through coastal areas near Davao Gulf and Sarangani Bay. The regiment's efforts contributed to the liberation of the island from Japanese control. For its service in the Pacific, the 167th Infantry Regiment received the Philippine Republic Presidential Unit Citation. The regiment remained in the southern Philippines until the end of the war, returning to the United States in December 1945.","faction":"USA","type":"infantry","rarity":"Common","cost":1,"operationCost":1,"attack":1,"defense":3},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.showwhendrawn"],"Name":"card_unit_4th_alabama","title":{"Namespace":"card_usa","Key":"card_unit_4th_alabama_title","SourceString":"4th ALABAMA","LocalizedString":"4th ALABAMA"},"Type":"ETypeEnum::infantry","attack":1,"defense":3,"range":1,"faction":"EFactionEnum::USA","kredits":1,"Text":{"Namespace":"card_usa","Key":"card_unit_4th_alabama_text","SourceString":"Show when drawn: Give your units +1 attack until end of turn.","LocalizedString":"Show when drawn: Give your units +1 attack until end of turn."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_4th_alabama_history","SourceString":"The 167th Infantry Regiment, known as the \"4th Alabama\", is a unit of the US Army which has been active from 1836 to this day. During WWII, the regiment served with the 31st \"Dixie\" Division in the Pacific Theater. After deploying in March 1944, the regiment saw its first combat in July along the northern coast of New Guinea. In September, elements of the 167th participated in the amphibious assault on Morotai Island, securing key positions and eliminating remaining Japanese resistance by January 1945. Later, the regiment moved to the Philippines, landing on Mindanao in April 1945. There, the 167th faced challenging terrain and harsh conditions as it advanced through coastal areas near Davao Gulf and Sarangani Bay. The regiment's efforts contributed to the liberation of the island from Japanese control. For its service in the Pacific, the 167th Infantry Regiment received the Philippine Republic Presidential Unit Citation. The regiment remained in the southern Philippines until the end of the war, returning to the United States in December 1945.","LocalizedString":"The 167th Infantry Regiment, known as the \"4th Alabama\", is a unit of the US Army which has been active from 1836 to this day. During WWII, the regiment served with the 31st \"Dixie\" Division in the Pacific Theater. After deploying in March 1944, the regiment saw its first combat in July along the northern coast of New Guinea. In September, elements of the 167th participated in the amphibious assault on Morotai Island, securing key positions and eliminating remaining Japanese resistance by January 1945. Later, the regiment moved to the Philippines, landing on Mindanao in April 1945. There, the 167th faced challenging terrain and harsh conditions as it advanced through coastal areas near Davao Gulf and Sarangani Bay. The regiment's efforts contributed to the liberation of the island from Japanese control. For its service in the Pacific, the 167th Infantry Regiment received the Philippine Republic Presidential Unit Citation. The regiment remained in the southern Philippines until the end of the war, returning to the United States in December 1945."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::NavalWarfare","hasBlitz":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/NavalWarfare/t_4th_alabama.t_4th_alabama","SubPathString":""},"artist":"US WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/4th_ALABAMA.4th_ALABAMA","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":383.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_4th_alabama_photo","SourceString":"US troops landing on Morotai Island in September 1944.","LocalizedString":"US troops landing on Morotai Island in September 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_4th_alabama","owner":"card_unit_4th_alabama_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_text_Variable","type":"FText","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"K2Node_Event_StartOfTurnDraw","type":"