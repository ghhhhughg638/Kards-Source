{"format":"kards-original-reference","version":1,"id":"5500a83ef4e7ece6","name":"card_unit_a6m3_zeke","package":"/Game/Blueprints/Cards/Japan/Allegiance/units/card_unit_a6m3_zeke","parent":"UBaseCardObject","card":{"title":"A6M3 ZEKE","text":"Enemy countermeasures cost 2 more to activate.","flavorText":"The Mitsubishi A6M3 Type 0 Model 32, better known as Zero, was a variant that was first introduced in 1941. It came with a new Sakae 21 engine that gave it more power and was designed for better altitude performance. This made the aircraft heavier than its predecessor, and even though it increased the speed by 11 km/h the range was 1,000 km less, which meant that it was only suitable for shorter range missions and interception. The Allied reporting name for the aircraft was Zeke 32. Only 343 A6M3’s were built.","faction":"Japan","type":"fighter","rarity":"Rare","cost":4,"operationCost":2,"attack":4,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_a6m3_zeke","title":{"Namespace":"card_japan","Key":"card_unit_a6m3_zeke_title","SourceString":"A6M3 ZEKE","LocalizedString":"A6M3 ZEKE"},"Type":"ETypeEnum::fighter","attack":4,"defense":3,"range":2,"faction":"EFactionEnum::Japan","kredits":4,"Text":{"Namespace":"card_japan","Key":"card_unit_a6m3_zeke_text","SourceString":"Enemy countermeasures cost 2 more to activate.","LocalizedString":"Enemy countermeasures cost 2 more to activate."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_a6m3_zeke_history","SourceString":"The Mitsubishi A6M3 Type 0 Model 32, better known as Zero, was a variant that was first introduced in 1941. It came with a new Sakae 21 engine that gave it more power and was designed for better altitude performance. This made the aircraft heavier than its predecessor, and even though it increased the speed by 11 km/h the range was 1,000 km less, which meant that it was only suitable for shorter range missions and interception. The Allied reporting name for the aircraft was Zeke 32. Only 34