{"format":"kards-original-reference","version":1,"id":"378dd5af22ffdd70","name":"card_event_zamosc_uprising","package":"/Game/Blueprints/Cards/Poland/events/card_event_zamosc_uprising","parent":"UBaseCardObject","card":{"title":"ZAMOŚĆ UPRISING","text":"Retreat target unit.","flavorText":"The Zamość uprising was an armed resistance movement from Polish partisans against German forces in the Zamość region of occupied Poland during WWII. It took place from 1942 to 1944 as the Germans attempted to clear the area of its Polish population to make way for German settlers as part of the \"Lebensraum\" (living space) policy. The local Polish resistance, primarily members of the Home Army (Armia Krajowa) and the Peasant Battalions (Bataliony Chłopskie) with support from Soviet partisans, fought back with sabotage, ambushes, and guerrilla tactics. Despite having limited resources, the partisans managed to disrupt the German plans and to protect many Polish civilians, until the Germans started to lose control of the region in the spring of 1943. The Zamość uprising became a symbol of Polish resistance against the German occupation.","faction":"Poland","type":"order","rarity":"Common","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_zamosc_uprising","title":{"Namespace":"card_poland","Key":"card_event_zamosc_uprising_title","SourceString":"ZAMOŚĆ UPRISING","LocalizedString":"ZAMOŚĆ UPRISING"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Poland","kredits":2,"Text":{"Namespace":"card_poland","Key":"card_event_zamosc_uprising_text","SourceString":"Retreat target unit.","LocalizedString":"Retreat target unit."},"flavorText":{"Namespace":"card_poland","Key":"card_event_zamosc_uprising_history","SourceString":"The Zamość uprising was an armed resistance movement from Polish partisans against German forces in the Zamość region of occupied Poland during WWII. It took place from 1942 to 1944 as the Germans attempted to clear the area of its Polish population to make way for German settlers as part of the \"Lebensraum\" (living space) policy. The local Polish resistance, primarily members of the Home Army (Armia Krajowa) and the Peasant Battalions (Bataliony Chłopskie) with support from Soviet partisans, fought back with sabotage, ambushes, and guerrilla tactics. Despite having limited resources, the partisans managed to disrupt the German plans and to protect many Polish civilians, until the Germans started to lose control of the region in the spring of 1943. The Zamość uprising became a symbol of Polish resistance against the German occupation.","LocalizedString":"The Zamość uprising was an armed resistance movement from Polish partisans against German forces in the Zamość region of occupied Poland during WWII. It took place from 1942 to 1944 as the Germans attempted to clear the area of its Polish population to make way for German settlers as part of the \"Lebensraum\" (living space) policy. The local Polish resistance, primarily members of the Home Army (Armia Krajowa) and the Peasant Battalions (Bataliony Chłopskie) with support from Soviet partisans, fought back with sabotage, ambushes, and guerrilla tactics. Despite having limited resources, the partisans managed to disrupt the German plans and to protect many Polish civilians, until the Germans started to lose control of the region in the spring of 1943. The Zamość uprising became a symbol of Polish resistance against the German occupation."},"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::BloodAndIron","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Retreat"],"cipher":2,"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Poland/Winter_2024/t_zamosc_uprising.t_zamosc_uprising","SubPathString":""},"artist":"Jarosław Wróbel","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/ZAMOSC_UPRISING.ZAMOSC_UPRISING","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":337.0},"historyPhotoDescription":{"Namespace":"card_poland","Key":"card_event_zamosc_uprising_photo","SourceString":"Soldiers of the Polish Home Army in front of Zamość Town Hall shortly after German forces were pushed out of the city. Zamość, Poland, 25 July 1944.","LocalizedString":"Soldiers of the Polish Home Army in front of Zamość Town Hall shortly after German forces were pushed out of the city. Zamość, Poland, 25 July 1944."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""}},"variables":[],"functions":[{"name":"CanPlayFromHand","owner":"card_event_zamosc_uprising_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","direction":"in"},{"name":"CallFunc_GetTargetedCard_card","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_HasCustomAbility_doesIt","type":"bool","direction":"in"},{"name":"CallFunc_IsUnit_isIt","type":"bool","direction":"in"}],"body":[{"op":"Context","at":0,"object":{"op":"Variable","name":"cardFunction","type":"ACardFunctionsStub*","scope":"member","sourceOp":"InstanceVariable"},"value":{"op":"LocalVirtualFunction","name":"GetTargetedCard","signature":"CardFunctionsStub.GetTargetedCard","args":[{"op":"Self"},{"op":"Variable","name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","scope":"local","sourceOp":"LocalVariable"},{"op":"Variable","name":"CallFunc_GetTar