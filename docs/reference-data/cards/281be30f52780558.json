{"format":"kards-original-reference","version":1,"id":"281be30f52780558","name":"card_unit_40_royal_marine","package":"/Game/Blueprints/Cards/Britain/NavalWarfare/units/card_unit_40_royal_marine","parent":"UBaseCardObject","card":{"title":"40 ROYAL MARINE","text":"Deployment: Fight target enemy unit. \r\nDestruction: If this unit isn't Navy, put on top of your deck with the Navy type.","flavorText":"The 40 Royal Marine Commando was formed in 1942 and was the first Royal Marines unit established for commando operations during WWII. Initially designated as 'A' RM Commando, it was later renamed 40 RM Commando in October 1942. The unit comprised volunteers from Royal Marine battalions and underwent rigorous commando training. Their first major engagement was the Dieppe Raid on 19 August 1942. Tasked with operations in the port area, they faced intense German resistance. Out of 370 officers and men, 76 were lost, including their commanding officer, and the second-in-command, Robert Houghton, was captured. In July 1943, they participated in Operation Husky, landing near Pachino, Sicily. They later saw action at Pizzio in September and at Termoli in October, where their commanding officer, Lt. Col. 'Pops' Manners, was killed during a German counterattack. In September 1944, during Operation Mercerised, 40 Commando landed at Sarande, Albania, facing a larger-than-expected German force. Despite the odds, they captured the town and took 1,000 prisoners. They then moved to Corfu to accept the German surrender and remained there until February 1945 to maintain order. Their final WWII operation was Operation Roast in April 1945 at Lake Comacchio, Italy. They conducted a feint attack to the south, crossing the Reno River and clearing its north bank. The subsequent action, Operation Impact Plain, was costly, with 27 killed and 45 wounded, but they succeeded in taking their objectives.","faction":"Britain","type":"infantry","rarity":"Uncommon","cost":2,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"GameplayTags":["subtype.commando"],"Name":"card_unit_40_royal_marine","title":{"Namespace":"card_britain","Key":"card_unit_40_royal_marine_title","SourceString":"40 ROYAL MARINE","LocalizedString":"40 ROYAL MARINE"},"Type":"ETypeEnum::infantry","attack":2,"defense":3,"range":1,"faction":"EFactionEnum::Britain","kredits":2,"Text":{"Namespace":"card_britain","Key":"card_unit_40_royal_marine_text","SourceString":"Deployment: Fight target enemy unit. \r\nDestruction: If this unit isn't Navy, put on top of your deck with the Navy type.","LocalizedString":"Deployment: Fight target enemy unit. \r\nDestruction: If this unit isn't Navy, put on top of your deck with the Navy type."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_40_royal_marine_history","SourceString":"The 40 Royal Marine Commando was formed in 1942 and was the first Royal Marines unit established for commando operations during WWII. Initially designated as 'A' RM Commando, it was later renamed 40 RM Commando in October 1942. The unit comprised volunteers from Royal Marine battalions and underwent rigorous commando training. Their first major engagement was the Dieppe Raid on 19 August 1942. Tasked with operations in the port area, they faced intense German resistance. Out of 370 officers and men, 76 were lost, including their commanding officer, and the second-in-command, Robert Houghton, was captured. In July 1943, they participated in Operation Husky, landing near Pachino, Sicily. They later saw action at Pizzio in September and at Termoli in October, where their commanding officer, Lt. Col. 'Pops' Manners, was killed during a German counterattack. In September 1944, during Operation Mercerised, 40 Commando landed at Sarande, Albania, facing a larger-than-expected German force. Despite the odds, they captured the town and took 1,000 prisoners. They then moved to Corfu to accept the German surrender and remained there until February 1945 to maintain order. Their final WWII operation was Operation Roast in April 1945 at Lake Comacchio, Italy. They conducted a feint attack to the south, crossing the Reno River and clearing its north bank. The subsequent action, Operation Impact Plain, was costly, with 27 killed and 45 wounded, but they succeeded in taking their objectives.","LocalizedString":"The 40 Royal Marine Commando was formed in 1942 and was the first Royal Marines unit established for commando operations during WWII. Initially designated as 'A' RM Commando, it was later renamed 40 RM Commando in October 1942. The unit comprised volunteers from Royal Marine battalions and underwent rigorous commando training. Their first major engagement was the Dieppe Raid on 19 August 1942. Tasked with operations in the port area, they faced intense German resistance. Out of 370 officers and men, 76 were lost, including their commanding officer, and the second-in-command, Robert Houghton, was captured. In July 1943, they participated in Operation Husky, landing near Pachino, Sicily. They later saw action at Pizzio in September and at Termoli in October, where their commanding officer, Lt. Col. 'Pops' Manners, was killed during a German counterattack. In September 1944, during Operation Mercerised, 40 Commando landed at Sarande, Albania, facing a larger-than-expected German force. Despite the odds, they captured the town and took 1,000 prisoners. They then moved to Corfu to accept the German surrender and remained there until February 1945 to maintain order. Their final WWII operation was Operation Roast in April 1945 at Lake Comacchio, Italy. They conducted a feint attack to the south, crossing the Reno River and clearing its north bank. The subsequent action, Operation Impact Plain, was costly, with 27 killed and 45 wounded, but they succeeded in taking their objectives."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::NavalWarfare","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Fight"],"hasDeployment":true,"hasDestruction":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/NavalWarfare/t_royal_marines.t_royal_marines","SubPathString":""},"artist":"Rebellion","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/40_ROYAL_MARINE.40_ROYAL_MARINE","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":370.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_unit_40_royal_marine_photo","SourceString":"Men of 40 Royal Marine Commando after their mission at Lake Comacchio in Italy, 11 April 1945.","LocalizedString":"Men of 40 Royal Marine Commando after their mission at Lake Comacchio in Italy, 11 April 1945."},"historyTypeDescription":{"Namespace":"","Key":"0DBC5F184A8F0CFAA1A9D6BB449E2AC6","SourceString":"Infantry","LocalizedString":"Infantry"},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"PossibleCards","type":"TArray<UBaseCardObject*>","direction":"in"},{"name":"tempCard","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"CanPlayFromHand","owner":"card_unit_40_royal_marine_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_GetOppositeSide_opposit