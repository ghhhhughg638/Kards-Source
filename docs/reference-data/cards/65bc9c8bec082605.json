{"format":"kards-original-reference","version":1,"id":"65bc9c8bec082605","name":"card_event_uprising","package":"/Game/Blueprints/Cards/Poland/events/card_event_uprising","parent":"UBaseCardObject","card":{"title":"UPRISING","text":"Deal damage to all units equal to Polish units destroyed this battle.","flavorText":"The Warsaw Uprising was a major military operation that took place in the summer of 1944. The operation was led by the Polish resistance Home Army and the aim was to liberate Warsaw from German occupation. At the time the Soviet forces were at the gates of Warsaw and the goal was to keep up the fight until Soviet forces arrived. However, this never happened and the Soviet forces stood by and watched while the Germans defeated the Polish resistance. After getting air clearance from the Soviets, the British and Americans managed to supply the Polish resistance from air, but to no avail. Much of the supplies ended up in German hands, and even if everything had reached the intended recipients it is unlikely that it would have changed the outcome. After 63 days of fighting the Germans had crushed the resistance and it is believed that between 150-200,000 civilians died during the fight. A total of 16,000 resistance fighters were KIA, 6,000 wounded and 15,000 were taken prisoners. The exact numbers of German casualties are not known and the estimates differ widely depending on the source. 2,000-17,000 Germans were killed, 9,000 wounded, 0-7,000 MIA and 2,000-5,000 were taken prisoners.","faction":"Poland","type":"order","rarity":"Rare","cost":5,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_uprising","title":{"Namespace":"card_poland","Key":"card_event_uprising_title","SourceString":"UPRISING","LocalizedString":"UPRISING"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Poland","kredits":5,"Text":{"Namespace":"card_poland","Key":"card_event_uprising_text","SourceString":"Deal damage to all units equal to Polish units destroyed this battle.","LocalizedString":"Deal damage to all units equal to Polish units destroyed this battle."},"flavorText":{"Namespace":"card_poland","Key":"card_event_uprising_history","SourceString":"The Warsaw Uprising was a major military operation that took place in the summer of 1944. The operation was led by the Polish resistance Home Army and the aim was to liberate Warsaw from German occupation. At the time the Soviet forces were at the gates of Warsaw and the goal was to keep up the fight until Soviet forces arrived. However, this never happened and the Soviet forces stood by and watched while the Germans defeated the Polish resistance. After getting air clearance from the Soviets, the British and Americans managed to supply the Polish resistance from air, but to no avail. Much of the supplies ended up in German hands, and even if everything had reached the intended recipients it is unlikely that it would have changed the outcome. After 63 days of fighting the Germans had crushed the resistance and it is believed that between 150-200,000 civilians died during the fight. A total of 16,000 resistance fighters were KIA, 6,000 wounded and 15,000 were taken prisoners. The exact numbers of German casualties are not known and the estimates differ widely depending on the source. 2,000-17,000 Germans were killed, 9,000 wounded, 0-7,000 MIA and 2,000-5,000 were taken prisoners.","LocalizedString":"The Warsaw Uprising was a major military operation that took place in the summer of 1944. The operation was led by the Polish resistance Home Army and the aim was to liberate Warsaw from German occupation. At the time the Soviet forces were at the gates of Warsaw and the goal was to keep up the fight until Soviet forces arrived. However, this never happened and the Soviet forces stood by and watched while the Germans defeated the Polish resistance. After getting air clearance from the Soviets, the British and Americans managed to supply the Polish resistance from air, but to no avail. Much of the supplies ended up in German hands, and even if everything had reached the intended recipients it is unlikely that it would have changed the outcome. After 63 days of fighting the Germans had crushed the resistance and it is believed that between 150-200,000 civilians died during the fight. A total of 16,000 resistance fighters were KIA, 6,000 wounded and 15,000 were taken prisoners. The exact numbers of German casualties are not known and the estimates differ widely depending on the source. 2,000-17,000 Germans were killed, 9,000 wounded, 0-7,000 MIA and 2,000-5,000 were taken prisoners."},"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Legions","isInPermanentPool":true,"usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand","ERegisteredCardFunction::OnOtherCardDestroyed","ERegisteredCardFunction::OnOtherCardCreatedAlterCard"],"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Poland/Mini_campaign_candidates/t_uprising.t_uprising","SubPathString":""},"artist":"Jarosław Wróbel","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/UPRISING.UPRISING","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":321.0},"historyPhotoDescription":{"Namespace":"card_poland","Key":"card_event_uprising_photo","SourceString":"Polish Home Army soldier from battalion OW – KB “Sokół”, Warsaw, Poland 1944.","LocalizedString":"Polish Home Army soldier from battalion OW – KB “Sokół”, Warsaw, Poland 1944."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""}},"variables":[{"name":"count","type":"int32","direction":"in"},{"name":"cardsToDamage","type":"TArray<int32>","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_uprising","owner":"card_event_uprising_C","