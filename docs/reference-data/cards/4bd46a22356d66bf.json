nuary 1945, with additional units likely produced until the war's end, although documentation for subsequent months is incomplete. The Fw 190 F-9 served on both the Eastern and Western Fronts and provided crucial support to German ground forces during the final months of WWII. Its robust design and effective armament made it a formidable opponent in the ground-attack role, despite the challenging conditions faced by the Luftwaffe in 1945."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::NavalWarfare","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn","ERegisteredCardFunction::OnOtherCardPlayedFromHand","ERegisteredCardFunction::OnOtherCovertCardPlayedFromHand"],"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/NavalWarfare/t_fw_190_f9.t_fw_190_f9","SubPathString":""},"artist":"Darryl Legg","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/FW_190_F-9.FW_190_F-9","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":333.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_fw_190_f8_photo","SourceString":"An Fw 190 F-9 in 1945.","LocalizedString":"An Fw 190 F-9 in 1945."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftL'","ObjectPath":"kards/Content/Effects/Explosions/Large/Aircraft/P_ExplosionAircraftL.201"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackFighter.BP_AttackFighter_C","SubPathString":""},"threat_level":0.15},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_fw_190_f8","owner":"card_unit_fw_190_f8_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"K2Node_Event_turnnumber","type":"int32","direction":"in"},{"