{"format":"kards-original-reference","version":1,"id":"0ed14da1c610d4e5","name":"card_unit_kv_ii","package":"/Game/Blueprints/Cards/Soviet/Allegiance/units/card_unit_kv_ii","parent":"UBaseCardObject","card":{"title":"KV-2","text":"Order damage to a friendly unit is reduced by its Heavy Armor.","flavorText":"The Kliment Voroshilov was a Soviet heavy tank, named after the Soviet defense commissar and politician Kliment Voroshilov, and used by the Red Army during WWII. The KV-2 was a heavy assault tank with a main armament of a M-10 152 mm howitzer, and due to the size of the turret it had a much higher profile than the KV-1 and much heavier as well. The KV-2 was produced at the same time as the KV-1, but due to its heavy weight and slow speed it was considered ineffective in combat and only 334 tanks were produced. The KV-2 had a crew of 6 and a secondary armament of 2× DT machine guns.","faction":"Soviet","type":"tank","rarity":"Rare","cost":7,"operationCost":2,"attack":7,"defense":5},"defaults":{"Name":"card_unit_kv_ii","title":{"Namespace":"card_soviet","Key":"card_unit_kv_ii_title","SourceString":"KV-2","LocalizedString":"KV-2"},"Type":"ETypeEnum::tank","attack":7,"defense":5,"range":1,"faction":"EFactionEnum::Soviet","kredits":7,"Text":{"Namespace":"card_soviet","Key":"card_unit_kv_ii_text","SourceString":"Order damage to a friendly unit is reduced by its Heavy Armor.","LocalizedString":"Order damage to a friendly unit is reduced by its Heavy Armor."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_kv_ii_history","SourceString":"The Kliment Voroshilov was a Soviet heavy tank, named after the Soviet defense commissar and politician Kliment Voroshilov, and used by the Red Army during WWII. The KV-2 was a heavy assault tank with a main armament of a M-10 152 mm howitzer, and due to the size of the turret it had a much higher profile than the KV-1 and much heavier as well. The KV-2 was produced at the same time as the KV-1, but due to its heavy weight and slow speed it was considered ineffective in combat and only 334 tanks were produced. The KV-2 had a crew of 6 and a secondary armament of 2× DT machine guns.","LocalizedString":"The Kliment Voroshilov was a Soviet heavy tank, named after the Soviet defense commissar and politician Kliment Voroshilov, and used by the Red Army during WWII. The KV-2 was a heavy assault tank with a main armament of a M-10 152 mm howitzer, and due to the size of the turret it had a much higher profile than the KV-1 and much heavier as well. The KV-2 was produced at the same time as the KV-1, but due to its heavy weight and slow speed it was considered ineffective in combat and only 334 tanks were produced. The KV-2 had a crew of 6 and a secondary armament of 2× DT machine guns."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Expansion2019","returnSet":"ECardSetEnum::CurrentExpansion","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardDealDamageAddDamage"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::HeavyArmor2"],"heavyArmor":2,"soundEnterPlay":{"ObjectName":"SoundWave'Tank_Heavy_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Heavy_Move_Fx.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Tank_Heavy_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Heavy_Move_Fx.0"},"soundAttack":{"ObjectName":"SoundWave'Heavy_Tank_Attack_Straight'","ObjectPath":"kards/Content/Assets/Audio/Units/Heavy_Tank_Attack_Straight.0"},"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Armor_Large_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Armor_Large_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/t_kv_i_big.t_kv_i_big","SubPathString":""},"artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/KV-2.KV-2","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":355.0},"historyPhotoSource":"https://world-war-2.wikia.org/","