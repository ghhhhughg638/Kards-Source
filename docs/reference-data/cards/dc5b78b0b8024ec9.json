{"format":"kards-original-reference","version":1,"id":"dc5b78b0b8024ec9","name":"card_event_duty_bound","package":"/Game/Blueprints/Cards/Japan/BloodIron/events/card_event_duty_bound","parent":"UBaseCardObject","card":{"title":"DUTY BOUND","text":"Give a friendly unit +1+1, plus +1+1 for each previously played DUTY BOUND.","flavorText":"For Japanese soldiers during WWII, honor was paramount. A soldier was expected to fulfill his duty with no regard for his own life. This put peer pressure on all who fought together and built up determination and disregard for their own self. This fanatical approach made the Japanese fearsome and those who fought against them were often surprised at how willing to sacrifice themselves for duty they were. The phrase \"Death is lighter than a feather, but duty is heavier than a mountain\" from the 1882 Japanese Imperial Rescript to Soldiers and Sailors embodies the intense sense of honor and self-sacrifice that defined Japan's wartime mentality during World War II. It reflects the belief that death in battle was a noble and inevitable consequence of fulfilling one's duty to the Emperor and country. Soldiers were urged to put aside personal fears, viewing death as insignificant compared to the weight of their obligations. This philosophy encouraged extreme loyalty, often leading to kamikaze missions and other acts of martyrdom during the war.","faction":"Japan","type":"order","rarity":"Common","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_duty_bound","title":{"Namespace":"card_japan","Key":"card_event_duty_bound_title","SourceString":"DUTY BOUND","LocalizedString":"DUTY BOUND"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Japan","kredits":1,"Text":{"Namespace":"card_japan","Key":"card_event_duty_bound_text","SourceString":"Give a friendly unit +1+1, plus +1+1 for each previously played DUTY BOUND.","LocalizedString":"Give a friendly unit +1+1, plus +1+1 for each previously played DUTY BOUND."},"flavorText":{"Namespace":"card_japan","Key":"card_event_duty_bound_history","SourceString":"For Japanese soldiers during WWII, honor was paramount. A soldier was expected to fulfill his duty with no regard for his own life. This put peer pressure on all who fought together and built up determination and disregard for their own self. This fanatical approach made the Japanese fearsome and those who fought against them were often surprised at how willing to sacrifice themselves for duty they were. The phrase \"Death is lighter than a feather, but duty is heavier than a mountain\" from the 1882 Japanese Imperial Rescript to Soldiers and Sailors embodies the intense sense of honor and self-sacrifice that defined Japan's wartime mentality during World War II. It reflects the belief that death in battle was a noble and inevitable consequence of fulfilling one's duty to the Emperor and country. Soldiers were urged to put aside personal fears, viewing death as insignificant compared to the weight of their obligations. This philosophy encouraged extreme loyalty, often leading to kamikaze missions and other acts of martyrdom during the war.","LocalizedString":"For Japanese soldiers during WWII, honor was paramount. A soldier was expected to fulfill his duty with no regard for his own life. This put peer pressure on all who fought together and built up determination and disregard for their own self. This fanatical approach made the Japanese fearsome and those who fought against them were often surprised at how willing to sacrifice themselves for duty they were. The phrase \"Death is lighter than a feather, but duty is heavier than a mountain\" from the 1882 Japanese Imperial Rescript to Soldiers and Sailors embodies the intense sense of honor and self-sacrifice that defined Japan's wartime mentality during World War II. It reflects the belief that death in battle was a noble and inevitable consequence of fulfilling one's duty to the Emperor and country. Soldiers were urged to put aside personal fears, viewing death as insignificant compared to the weight of their obligations. This philosophy encouraged extreme loyalty, often leading to kamikaze missions and other acts of martyrdom during the war."},"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::BloodAndIron","usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand","ERegisteredCardFunction::OnOtherCardCreatedAlterCard"],"draftBaseWeight":1.1,"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Taiko_Hits_1'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Taiko_Hits_1.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/Winter_2024/t_duty_bound_not_final_version.t_duty_bound_not_final_version","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/DUTY_BOUND.DUTY_BOUND","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":288.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_event_duty_bound_photo","SourceString":"Japanese soldiers celebrating a victory, 1941.","LocalizedString":"Japanese soldiers celebrating a victory, 1941."},"isDraw":true,"isDefenseBuff":true},"variables":[{"name":"tempCard","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"CanPlayFromHand","owner":"card_event_duty_bound_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","direction":"in"},{"name":"CallFunc_GetTargetedCard_card","type":"UBaseCardObject*","directio