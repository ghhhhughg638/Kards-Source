{"format":"kards-original-reference","version":1,"id":"df866810b8a0a38a","name":"card_unit_6th_motor_rifles_sov","package":"/Game/Blueprints/Cards/Soviet/NavalWarfare/units/card_unit_6th_motor_rifles_sov","parent":"UBaseCardObject","card":{"title":"6th MOTOR RIFLES","text":"Deployment: Draw a card. Convert two cards in your deck into this unit.","flavorText":"The 6th Motor Rifle Regiment was an infantry unit of the Soviet Red Army which was active during WWII. At the beginning of the war, it was part of the 127th Rifle Division, later renamed 2nd Guards Rifle Division for its distinguished combat service during the early stages of the German invasion. The division entered the war under the 19th Army’s 25th Rifle Corps. After surviving the chaotic retreats of 1941 near Smolensk and Yartsevo, it fought defensive battles in the Kursk area in October, before joining the Soviet counteroffensive toward Stary Oskol during the Winter Campaign of 1941-42. The 2nd Guards Rifle Division earned the title \"Tamanskaya\" after liberating Taman during the Novorossiysk-Taman offensive in September and October 1943. The next month, it took part in the Kerch-Eltigen Operation, where it spearheaded the landings on Crimea's eastern coast. In Spring 1944, it participated in the Crimean Offensive, capturing Alushta on 15 April 1944. Transferred to the Baltic front in July, the division fought in the Šiauliai Offensive and the Battle of Memel, before advancing into East Prussia in 1945. It ended the war on the Baltic coast near Primorsk.","faction":"Soviet","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":1,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_6th_motor_rifles_sov","title":{"Namespace":"card_soviet","Key":"card_unit_6th_motor_rifles_sov_title","SourceString":"6th MOTOR RIFLES","LocalizedString":"6th MOTOR RIFLES"},"Type":"ETypeEnum::infantry","attack":3,"defense":3,"range":1,"faction":"EFactionEnum::Soviet","kredits":3,"Text":{"Namespace":"card_soviet","Key":"card_unit_6th_motor_rifles_sov_text","SourceString":"Deployment: Draw a card. Convert two cards in your deck into this unit.","LocalizedString":"Deployment: Draw a card. Convert two cards in your deck into this unit."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_6th_motor_rifles_sov_history","SourceString":"The 6th Motor Rifle Regiment was an infantry unit of the Soviet Red Army which was active during WWII. At the beginning of the war, it was part of the 127th Rifle Division, later renamed 2nd Guards Rifle Division for its distinguished combat service during the early stages of the German invasion. The division entered the war under the 19th Army’s 25th Rifle Corps. After surviving the chaotic retreats of 1941 near Smolensk and Yartsevo, it fought defensive battles in the Kursk area in October, before joining the Soviet counteroffensive toward Stary Oskol during the Winter Campaign of 1941-42. The 2nd Guards Rifle Division earned the title \"Tamanskaya\" after liberating Taman during the Novorossiysk-Taman offensive in September and October 1943. The next month, it took part in the Kerch-Eltigen Operation, where it spearheaded the landings on Crimea's eastern coast. In Spring 1944, it participated in the Crimean Offensive, capturing Alushta on 15 April 1944. Transferred to the Baltic front in July, the division fought in the Šiauliai Offensive and the Battle of Memel, before advancing into East Prussia in 1945. It ended the war on the Baltic coast near Primorsk.","LocalizedString":"The 6th Motor Rifle Regiment was an infantry unit of the Soviet Red Army which was active during WWII. At the beginning of the war, it was part of the 127th Rifle Division, later renamed 2nd Guards Rifle Division for its distinguished combat service during the early stages of the German invasion. The division entered the war under the 19th Army’s 25th Rifle Corps. After surviving the chaotic retreats of 1941 near Smolensk and Yartsevo, it fought defensive battles in the Kursk area in October, before joining the Soviet counteroffensive toward Stary Oskol during the Winter Campaign of 1941-42. The 2nd Guards Rifle Division earned the title \"Tamanskaya\" after liberating Taman during the Novorossiysk-Taman offensive in September and October 1943. The next month, it took part in the Kerch-Eltigen Operation, where it spearheaded the landings on Crimea's eastern coast. In Spring 1944, it participated in the Crimean Offensive, capturing Alushta on 15 April 1944. Transferred to the Baltic front in July, the division fought in the Šiauliai Offensive and the Battle of Memel, before advancing into East Prussia in 1945. It ended the war on the Baltic coast near Primorsk."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::NavalWarfare","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Convert"],"hasDeployment":true,"hasBlitz":true,"hasAmbush":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/NavalWarfare/t_6th_motor_rifles.t_6th_motor_rifles","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/6th_MOTOR_RIFLES.6th_MOTOR_RIFLES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":327.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_6th_motor_rifles_sov_photo","SourceString":"Soldiers of the 2nd Guards Rifle Division on the coast of the Kerch Peninsula, Crimea, November 1943.","LocalizedString":"Soldiers of the 2nd Guards Rifle Division on the coast of the Kerch Peninsula, Crimea, November 1943."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_Att