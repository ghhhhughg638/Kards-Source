{"format":"kards-original-reference","version":1,"id":"af4514a338344855","name":"card_event_ingenuity","package":"/Game/Blueprints/Cards/Britain/WinterWar/events/card_event_ingenuity","parent":"UBaseCardObject","card":{"title":"INGENUITY","text":"Develop a British or US bomber.","flavorText":"The so-called “Butt Report” was a report initiated by Lord Cherwell, a friend of Churchill and chief scientific advisor to the Cabinet, but commonly referred to by the name of its author, Archibald Butt, a civil servant who worked for the Statistical Section of the Admiralty during WWII. The report was published in August 1941 and revealed the widespread failure of RAF Bomber Command aircraft to hit their targets. Following this highly critical report, Bomber Command was reorganized with new aircraft, new navigational aids, new tactics and new leadership. In February 1942 Air Marshal Arthur Harris was appointed Commander-in-Chief of Bomber Command and the implementation of electronic navigational tools such as GEE, Oboe, G-H, and ground-mapping radar H2S increased bombings precision significantly. Furthermore, the creation of the Pathfinder Force also improved the accuracy of bombing raids. This was a specialized force within the RAF that was responsible for marking targets and guiding bomber formations to those.","faction":"Britain","type":"order","rarity":"Uncommon","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.develop"],"Name":"card_event_ingenuity","title":{"Namespace":"card_britain","Key":"card_event_ingenuity_title","SourceString":"INGENUITY","LocalizedString":"INGENUITY"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Britain","kredits":2,"Text":{"Namespace":"card_britain","Key":"card_event_ingenuity_text","SourceString":"Develop a British or US bomber.","LocalizedString":"Develop a British or US bomber."},"flavorText":{"Namespace":"card_britain","Key":"card_event_ingenuity_history","SourceString":"The so-called “Butt Report” was a report initiated by Lord Cherwell, a friend of Churchill and chief scientific advisor to the Cabinet, but commonly referred to by the name of its author, Archibald Butt, a civil servant who worked for the Statistical Section of the Admiralty during WWII. The report was published in August 1941 and revealed the widespread failure of RAF Bomber Command aircraft to hit their targets. Following this highly critical report, Bomber Command was reorganized with new aircraft, new navigational aids, new tactics and new leadership. In February 1942 Air Marshal Arthur Harris was appointed Commander-in-Chief of Bomber Command and the implementation of electronic navigational tools such as GEE, Oboe, G-H, and ground-mapping radar H2S increased bombings precision significantly. Furthermore, the creation of the Pathfinder Force also improved the accuracy of bombing raids. This was a specialized force within the RAF that was responsible for marking targets and guiding bomber formations to those.","LocalizedString":"The so-called “Butt Report” was a report initiated by Lord Cherwell, a friend of Churchill and chief scientific advisor to the Cabinet, but commonly referred to by the name of its author, Archibald Butt, a civil servant who worked for the Statistical Section of the Admiralty during WWII. The report was published in August 1941 and revealed the widespread failure of RAF Bomber Command aircraft to hit their targets. Following this highly critical report, Bomber Command was reorganized with new aircraft, new navigational aids, new tactics and new leadership. In February 1942 Air Marshal Arthur Harris was appointed Commander-in-Chief of Bomber Command and the implementation of electronic navigational tools such as GEE, Oboe, G-H, and ground-mapping radar H2S increased bombings precision significantly. Furthermore, the creation of the Pathfinder Force also improved the accuracy of bombing raids. This was a specialized force within the RAF that was responsible for marking targets and guiding bomber formations to those."},"rarity":"ERarityEnum::Uncommon","waitWithOnOtherCardPlayedUntilHandTargetSelected":true,"cardSet":"ECardSetEnum::WinterWar","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Develop"],"draftBaseWeight":0.8,"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/CandidateArtwork/Winter_War/t_ingenuity.t_ingenuity","SubPathString":""},"artist":"Michael Turner","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/INGENUITY.INGENUITY","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":277.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_event_ingenuity_photo","SourceString":"A RAF officer studying aerial photographs with a stereoscope. Ca. 1939-40.","LocalizedString":"A RAF officer studying aerial photographs with a stereoscope. Ca. 1939-40."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"Notes":"Image needed to be customized","isDefenseBuff":true},"variables":[{"name":"bombers","type":"TArray<int32>","direction":"in"},{"name":"drawnBomber","type":"int32","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_ingenuity","owner":"card_event_ingenuity_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_selectCardToDraw_drawnCardID","type":"int32","direction":"in"}],"body":[{"op":"ComputedJump","at":0,"value":{"op":"Variable","name":"EntryPoint","type":"int32","scope":"local","sourceOp":"LocalVariable"}},{"op":"Context","at":10,"object":{"op":"Variable","name":"cardFunction","type":"ACard