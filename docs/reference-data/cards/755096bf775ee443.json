{"format":"kards-original-reference","version":1,"id":"755096bf775ee443","name":"card_unit_11th_infantry_regiment","package":"/Game/Blueprints/Cards/USA/Allegiance/units/card_unit_11th_infantry_regiment","parent":"UBaseCardObject","card":{"title":"11th INFANTRY REGIMENT","text":"Deployment: Fully repair a friendly unit, then give it +1+1.","flavorText":"The 11th Infantry Regiment was formed in 1862 in the American Civil War and has been active to this day. At the start of WWII the regiment was attached to the 5th Infantry Division of the US Army. In 1942 the division was deployed in Iceland where it stayed for 15 months before it was moved to England in preparation for D-Day. The division participated in the Normandy landings and fought its way across Europe as part of Patton’s Third Army where the 11th Infantry Regiment played vital roles in the Battle for Metz and the Battle of the Bulge. The regiment ended the war in Czechoslovakia and was retired on its return to the US, but reactivated in 1954 and has stayed active to this day.","faction":"USA","type":"infantry","rarity":"Common","cost":3,"operationCost":1,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_11th_infantry_regiment","title":{"Namespace":"card_usa","Key":"card_unit_11th_infantry_regiment_title","SourceString":"11th INFANTRY REGIMENT","LocalizedString":"11th INFANTRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":3,"defense":3,"range":1,"faction":"EFactionEnum::USA","kredits":3,"Text":{"Namespace":"card_usa","Key":"card_unit_11th_infantry_regiment_text","SourceString":"Deployment: Fully repair a friendly unit, then give it +1+1.","LocalizedString":"Deployment: Fully repair a friendly unit, then give it +1+1."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_11th_infantry_regiment_history","SourceString":"The 11th Infantry Regiment was formed in 1862 in the American Civil War and has been active to this day. At the start of WWII the regiment was attached to the 5th Infantry Division of the US Army. In 1942 the division was deployed in Iceland where it stayed for 15 months before it was moved to England in preparation for D-Day. The division participated in the Normandy landings and fought its way across Europe as part of Patton’s Third Army where the 11th Infantry Regiment played vital roles in the Battle for Metz and the Battle of the Bulge. The regiment ended the war in Czechoslovakia and was retired on its return to the US, but reactivated in 1954 and has stayed active to this day.","LocalizedString":"The 11th Infantry Regiment was formed in 1862 in the American Civil War and has been active to this day. At the start of WWII the regiment was attached to the 5th Infantry Division of the US Army. In 1942 the division was deployed in Iceland where it stayed for 15 months before it was moved to England in preparation for D-Day. The division participated in the Normandy landings and fought its way across Europe as part of Patton’s Third Army where the 11th Infantry Regiment played vital roles in the Battle for Metz and the Battle of the Bulge. The regiment ended the war in Czechoslovakia and was retired on its return to the US, but reactivated in 1954 and has stayed active to this day."},"operationCost":1,"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Expansion2019","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/t_us_inf_exp.t_us_inf_exp","SubPathString":""},"artist":"US WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/11th_INFANTRY_REGIMENT.11th_INFANTRY_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":395.0},"historyPhotoSource":"US Signal Corps","historyPhotoDescription":{"Namespace":"card_usa","K