{"format":"kards-original-reference","version":1,"id":"7f7cc0dbdb3e8675","name":"card_unit_fokker_finland","package":"/Game/Blueprints/Cards/Finland/units/card_unit_fokker_finland","parent":"UBaseCardObject","card":{"title":"FOKKER D.XXI","text":"Deployment: Suppress target enemy unit.","flavorText":"The Fokker D.XXI was a Dutch fighter that saw its most extensive service with the Finnish Air Force. Finland first acquired the aircraft in 1937, and later produced 93 under license at the State Aircraft Factory in Tampere between 1939 and 1944. Designed as a rugged and affordable monoplane with a fixed undercarriage, the D.XXI proved well suited for operations in Finnish conditions, and could be converted to skis for winter use. At the outbreak of the Winter War in 1939, 41 Finnish D.XXIs were in service. On December 1st, one of them claimed the type’s first kill by downing a Soviet Tupolev SB. Though increasingly outclassed as newer Soviet fighters entered the war, the Fokker D.XXI's maneuverability and sturdy construction earned it the respect of enemy pilots. It remained in frontline use during the Continuation War, where pilots like Jorma Sarvanto achieved Ace status flying this type. The highest-scoring airframe, FR-110, achieved 10 victories and is preserved today at the Central Finland Aviation Museum. Finnish D.XXIs served until 1949, long after the aircraft had been retired elsewhere.","faction":"Finland","type":"fighter","rarity":"Uncommon","cost":2,"operationCost":1,"attack":3,"defense":1},"defaults":{"UberGraphFrame":{},"Name":"card_unit_fokker_finland","title":{"Namespace":"card_finland","Key":"card_unit_fokker_finland_title","SourceString":"FOKKER D.XXI","LocalizedString":"FOKKER D.XXI"},"Type":"ETypeEnum::fighter","attack":3,"defense":1,"range":2,"faction":"EFactionEnum::Finland","kredits":2,"Text":{"Namespace":"card_finland","Key":"card_unit_fokker_finland_text","SourceString":"Deployment: Suppress target enemy unit.","LocalizedString":"Deployment: Suppress target enemy unit."},"flavorText":{"Namespace":"card_finland","Key":"card_unit_fokker_finland_history","SourceString":"The Fokker D.XXI was a Dutch fighter that saw its most extensive service with the Finnish Air Force. Finland first acquired the aircraft in 1937, and later produced 93 under license at the State Aircraft Factory in Tampere between 1939 and 1944. Designed as a rugged and affordable monoplane with a fixed undercarriage, the D.XXI proved well suited for operations in Finnish conditions, and could be converted to skis for winter use. At the outbreak of the Winter War in 1939, 41 Finnish D.XXIs were in service. On December 1st, one of them claimed the type’s first kill by downing a Soviet Tupolev SB. Though increasingly outclassed as newer Soviet fighters entered the war, the Fokker D.XXI's maneuverability and sturdy construction earned it the respect of enemy pilots. It remained in frontline use during the Continuation War, where pilots like Jorma Sarvanto achieved Ace status flying this type. The highest-scoring airframe, FR-110, achieved 10 victories and is preserved today at the Central Finland Aviation Museum. Finnish D.XXIs served until 1949, long after the aircraft had been retired elsewhere.","LocalizedString":"The Fokker D.XXI was a Dutch fighter that saw its most extensive service with the Finnish Air Force. Finland first acquired the aircraft in 1937, and later produced 93 under license at the State Aircraft Factory in Tampere between 1939 and 1944. Designed as a rugged and affordable monoplane with a fixed undercarriage, the D.XXI proved well suited for operations in Finnish conditions, and could be converted to skis for winter use. At the outbreak of the Winter War in 1939, 41 Finnish D.XXIs were in service. On December 1st, one of them claimed the type’s first kill by downing a Soviet Tupolev SB. Though increasingly outclassed as newer Soviet fighters entered the war, the Fokker D.XXI's maneuverability and sturdy construction earned it the respect of enemy pilots. It remained in frontline use during the Continuation War, where pilots like Jorma Sarvanto achieved Ace status flying this type. The highest-scoring airframe, FR-110, achieved 10 victories and is preserved today at the Central Finland Aviation Museum. Finnish D.XXIs served until 1949, long after the aircraft had been retired elsewhere."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::NavalWarfare","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment","EHelpBubbleTypes::Suppress"],"hasDeployment":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Finland/World_at_War/t_fokker_d_xxi.t_fokker_d_xxi","SubPathString":""},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/FOKKER_D_XXI.FOKKER_D_XXI","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":353.0},"historyPhotoDescription":{"Namespace":"card_finland","Key":"card_unit_fokker_finland_photo","SourceString":"Finnish Fokker D XXIs at Vesivehmaa, Finland. October 1943.","LocalizedString":"Finnish Fokker D XXIs at Vesivehmaa, Finland. October 1943."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackFighter.BP_AttackFighter_C","SubPathString":""}},"variables":[],"functions":[{"name":"CanPlayFromHand","owner":"card_unit_fokker_finland_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event