{"format":"kards-original-reference","version":1,"id":"ffc141adeef542f6","name":"card_unit_27th_mg_battalion","package":"/Game/Blueprints/Cards/ANZAC/units/card_unit_27th_mg_battalion","parent":"UBaseCardObject","card":{"title":"27th MG BATTALION","text":"Units you deploy get Blitz if they were left-most in hand, Shock if they were right-most.","flavorText":"The 27th Machine-Gun Battalion was an infantry unit of the 2nd New Zealand Division during WWII. Raised at Burnham in 1939, it counted about 700 men, equipped with Vickers machine guns, which gave the division sustained fire support. Its companies also included signals, transport, administration, and anti-aircraft support. After training in New Zealand, the battalion was sent to Egypt in early 1941. The battalion first saw action in Greece, where it fought during the long withdrawal to the Peloponnese, including the rearguard battles at Vevi and Mount Olympus. It was then sent to Crete and fought at Maleme and Galatas during the German airborne invasion. In North Africa, it served in Operation Crusader, at El Alamein, during the advance into Tunisia, and the flanking move around the Mareth Line. It also supplied men to the Long Range Desert Group. In Italy, the battalion crossed the Sangro River early and was heavily engaged, firing nearly nine million rounds during the campaign. It was converted to infantry in 1945 and ended the war at Trieste.","faction":"Anzac","type":"infantry","rarity":"Rare","cost":1,"operationCost":1,"attack":1,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_27th_mg_battalion","title":{"Namespace":"card_anzac","Key":"card_unit_27th_mg_battalion_title","SourceString":"27th MG BATTALION","LocalizedString":"27th MG BATTALION"},"Type":"ETypeEnum::infantry","attack":1,"defense":3,"range":1,"faction":"EFactionEnum::Anzac","kredits":1,"Text":{"Namespace":"card_anzac","Key":"card_unit_27th_mg_battalion_text","SourceString":"Units you deploy get Blitz if they were left-most in hand, Shock if they were right-most.","LocalizedString":"Units you deploy get Blitz if they were left-most in hand, Shock if they were right-most."},"flavorText":{"Namespace":"card_anzac","Key":"card_unit_27th_mg_battalion_history","SourceString":"The 27th Machine-Gun Battalion was an infantry unit of the 2nd New Zealand Division during WWII. Raised at Burnham in 1939, it counted about 700 men, equipped with Vickers machine guns, which gave the division sustained fire support. Its companies also included signals, transport, administration, and anti-aircraft support. After training in New Zealand, the battalion was sent to Egypt in early 1941. The battalion first saw action in Greece, where it fought during the long withdrawal to the Peloponnese, including the rearguard battles at Vevi and Mount Olympus. It was then sent to Crete and fought at Maleme and Galatas during the German airborne invasion. In North Africa, it served in Operation Crusader, at El Alamein, during the advance into Tunisia, and the flanking move around the Mareth Line. It also supplied men to the Long Range Desert Group. In Italy, the battalion crossed the Sangro River early and was heavily engaged, firing nearly nine million rounds during the campaign. It was converted to infantry in 1945 and ended the war at Trieste.","LocalizedString":"The 27th Machine-Gun Battalion was an infantry unit of the 2nd New Zealand Division during WWII. Raised at Burnham in 1939, it counted about 700 men, equipped with Vickers machine guns, which gave the division sustained fire support. Its companies also included signals, transport, administration, and anti-aircraft support. After training in New Zealand, the battalion was sent to Egypt in early 1941. The battalion first saw action in Greece, where it fought during the long withdrawal to the Peloponnese, including the rearguard battles at Vevi and Mount Olympus. It was then sent to Crete and fought at Maleme and Galatas during the German airborne invasion. In North Africa, it served in Operation Crusader, at El Alamein, during the advance into Tunisia, and the flanking move around the Mareth Line. It also supplied men to the Long Range Desert Group. In Italy, the battalion crossed the Sangro River early and was heavily engaged, firing nearly nine million rounds during the campaign. It was converted to infantry in 1945 and ended the war at Trieste."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::OceaniaStorm","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/27th_MG_BATTALION.27th_MG_BATTALION","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_anzac","Key":"card_unit_27th_mg_battalion_photo","SourceString":"Gunners of the 27th MG Battalion during maneuvres at Maadi, Egypt, 1941.","LocalizedString":"Gunners of the 27th MG Battalion during maneuvres at Maadi, Egypt, 1941."},"historyTypeDescription":{"Namespace":"","Key":"0DBC5F184A8F0CFAA1A9D6BB449E2AC6","SourceString":"Infantry","LocalizedString":"Infantry"},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"threat_level":0.1},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_27th_mg_battalion","owner":"card_unit_27th_mg_battalion_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"CallFunc_IsLocatedOnBoard_isIt","type":"bool","direction":"in"},{"name":"K2Node_Event_cardPlayed","ty