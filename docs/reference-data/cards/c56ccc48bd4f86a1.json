{"format":"kards-original-reference","version":1,"id":"c56ccc48bd4f86a1","name":"card_unit_77th_guards","package":"/Game/Blueprints/Cards/Soviet/Homefront/units/card_unit_77th_guards","parent":"UBaseCardObject","card":{"title":"77th GUARDS","text":"When you deploy or add a unit, give it a random combat keyword.","flavorText":"The 77th Guards Rifle Regiment was a unit of the 26th Guards Rifle Division, one of the Red Army’s elite infantry formations. Created in April 1942 from the experienced 93rd Rifle Division, the 26th Division was quickly thrown into heavy fighting in the Rzhev sector. It endured brutal losses during the First Rzhev–Sychyovka Offensive and Operation Mars, in battles that tested the limits of Soviet infantry under grueling conditions. In 1943, the division joined the newly formed 11th Guards Army and fought in Operation Kutuzov and the advance through Bryansk. During the 1944 summer offensive, it played a key role in the Vitebsk-Orsha and Minsk operations, helping to encircle and destroy large portions of Army Group Center. After forcing a crossing over the Berezina River, the division received the Order of the Red Banner. It continued advancing through Lithuania and into East Prussia, where it stormed Insterburg and later took part in the capture of Königsberg. For its role in these battles, it was awarded the Order of Suvorov and earned a place among the Soviet Union’s most decorated divisions.","faction":"Soviet","type":"infantry","rarity":"Common","cost":4,"operationCost":1,"attack":2,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_77th_guards","title":{"Namespace":"card_soviet","Key":"card_unit_77th_guards_title","SourceString":"77th GUARDS","LocalizedString":"77th GUARDS"},"Type":"ETypeEnum::infantry","attack":2,"defense":5,"range":1,"faction":"EFactionEnum::Soviet","kredits":4,"Text":{"Namespace":"card_soviet","Key":"card_unit_77th_guards_text","SourceString":"When you deploy or add a unit, give it a random combat keyword.","LocalizedString":"When you deploy or add a unit, give it a random combat keyword."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_77th_guards_history","SourceString":"The 77th Guards Rifle Regiment was a unit of the 26th Guards Rifle Division, one of the Red Army’s elite infantry formations. Created in April 1942 from the experienced 93rd Rifle Division, the 26th Division was quickly thrown into heavy fighting in the Rzhev sector. It endured brutal losses during the First Rzhev–Sychyovka Offensive and Operation Mars, in battles that tested the limits of Soviet infantry under grueling conditions. In 1943, the division joined the newly formed 11th Guards Army and fought in Operation Kutuzov and the advance through Bryansk. During the 1944 summer offensive, it played a key role in the Vitebsk-Orsha and Minsk operations, helping to encircle and destroy large portions of Army Group Center. After forcing a crossing over the Berezina River, the division received the Order of the Red Banner. It continued advancing through Lithuania and into East Prussia, where it stormed Insterburg and later took part in the capture of Königsberg. For its role in these battles, it was awarded the Order of Suvorov and earned a place among the Soviet Union’s most decorated divisions.","LocalizedString":"The 77th Guards Rifle Regiment was a unit of the 26th Guards Rifle Division, one of the Red Army’s elite infantry formations. Created in April 1942 from the experienced 93rd Rifle Division, the 26th Division was quickly thrown into heavy fighting in the Rzhev sector. It endured brutal losses during the First Rzhev–Sychyovka Offensive and Operation Mars, in battles that tested the limits of Soviet infantry under grueling conditions. In 1943, the division joined the newly formed 11th Guards Army and fought in Operation Kutuzov and the advance through Bryansk. During the 1944 summer offensive, it played a key role in the Vitebsk-Orsha and Minsk operations, helping to encircle and destroy large portions of Army Group Center. After forcing a crossing over the Berezina River, the division received the Order of the Red Banner. It continued advancing through Lithuania and into East Prussia, where it stormed Insterburg and later took part in the capture of Königsberg. For its role in these battles, it was awarded the Order of Suvorov and earned a place among the Soviet Union’s most decorated divisions."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardEnterPlay"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::CombatKeywords"],"hasBlitz":true,"hasGuard":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/77th_GUARDS.77th_GUARDS","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_77th_guards_photo","SourceString":"Red Army infantry during Operation Kutuzov, 1943.","LocalizedString":"Red Army infantry during Operation Kutuzov, 1943."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"isDefenseBuff":true},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_77th_guards","owner":"card_unit_77th_guards_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"K2Node_Event_cardPlayed","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_method","type":"EOnEnterPlayMethod","direction":"in"},{"name":"CallFunc_EqualEqual_ByteByte_ReturnValue","type":"bool","d