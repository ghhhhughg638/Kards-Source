{"format":"kards-original-reference","version":1,"id":"f7f32f51172a9d5b","name":"card_unit_38th_guards_rifles","package":"/Game/Blueprints/Cards/Soviet/CovertOp/units/card_unit_38th_guards_rifles","parent":"UBaseCardObject","card":{"title":"38th GUARD RIFLES","text":"Reveal: Add a T-34 1942 to your support line if this unit was Covert for 3 or more turns.","flavorText":"The 38th Guards Rifle Regiment was a unit of the 65th Rifle Division, which became the 102nd Guards Rifle Division in 1944. When Operation Barbarossa began in 1941, the division was caught in defensive battles near the town of Tikhvin, located near Leningrad. That same year it participated in the liberation of the town during a Soviet Counteroffensive. The division continued fighting near Leningrad and in 1944 it was involved in the Petsamo-Kirkenes Operation, which was a Soviet offensive that defeated the Wehrmacht's forces in the Arctic. In February 1945, shortly after being raised to Guards status, the division took part in the East Pomeranian Offensive with the 19th Army of the 2nd Belorussian Front. From late March to early April 1945, it played a role in securing the naval base and port of Gdynia while also freeing the \"Polish Corridor\". Following this success, the division engaged in operations aimed at containing and neutralizing enemy forces along the western coast of the Danzig Bay. After the war it performed occupation duty on the demarcation line of the Mecklenburg province until it was disbanded in 1947.","faction":"Soviet","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":1,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_38th_guards_rifles","title":{"Namespace":"card_soviet","Key":"card_unit_38th_guards_rifles_title","SourceString":"38th GUARD RIFLES","LocalizedString":"38th GUARD RIFLES"},"Type":"ETypeEnum::infantry","attack":3,"defense":4,"range":1,"faction":"EFactionEnum::Soviet","kredits":3,"Text":{"Namespace":"card_soviet","Key":"card_unit_38th_guards_rifles_text","SourceString":"Reveal: Add a T-34 1942 to your support line if this unit was Covert for 3 or more turns.","LocalizedString":"Reveal: Add a T-34 1942 to your support line if this unit was Covert for 3 or more turns."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_38th_guards_rifles_history","SourceString":"The 38th Guards Rifle Regiment was a unit of the 65th Rifle Division, which became the 102nd Guards Rifle Division in 1944. When Operation Barbarossa began in 1941, the division was caught in defensive battles near the town of Tikhvin, located near Leningrad. That same year it participated in the liberation of the town during a Soviet Counteroffensive. The division continued fighting near Leningrad and in 1944 it was involved in the Petsamo-Kirkenes Operation, which was a Soviet offensive that defeated the Wehrmacht's forces in the Arctic. In February 1945, shortly after being raised to Guards status, the division took part in the East Pomeranian Offensive with the 19th Army of the 2nd Belorussian Front. From late March to early April 1945, it played a role in securing the naval base and port of Gdynia while also freeing the \"Polish Corridor\". Following this success, the division engaged in operations aimed at containing and neutralizing enemy forces along the western coast of the Danzig Bay. After the war it performed occupation duty on the demarcation line of the Mecklenburg province until it was disbanded in 1947.","LocalizedString":"The 38th Guards Rifle Regiment was a unit of the 65th Rifle Division, which became the 102nd Guards Rifle Division in 1944. When Operation Barbarossa began in 1941, the division was caught in defensive battles near the town of Tikhvin, located near Leningrad. That same year it participated in the liberation of the town during a Soviet Counteroffensive. The division continued fighting near Leningrad and in 1944 it was involved in the Petsamo-Kirkenes Operation, which was a Soviet offensive that defeated the Wehrmacht's forces in the Arctic. In February 1945, shortly after being raised to Guards status, the division took part in the East Pomeranian Offensive with the 19th Army of the 2nd Belorussian Front. From late March to early April 1945, it played a role in securing the naval base and port of Gdynia while also freeing the \"Polish Corridor\". Following this success, the division engaged in operations aimed at containing and neutralizing enemy forces along the western coast of the Danzig Bay. After the war it performed occupation duty on the demarcation line of the Mecklenburg province until it was disbanded in 1947."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::CurrentExpansion","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Covert","EHelpBubbleTypes::Trigger"],"draftBaseWeight":0.9,"hasCovert":true,"spawnCardName":"card_unit_t_34","Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/Summer_24/t_38th_guards_rifles_01.t_38th_guards_rifles_01","SubPathString":""},"ImageAnchor":"EImageAnchor::Bot","artist":"Ken Smith","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/38th_GUARD_RIFLES.38th_GUARD_RIFLES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":328.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_38th_guards_rifles_photo","SourceString":"Soviet soldiers during the Petsamo-Kirkenes Operation, 1944.","LocalizedString":"Soviet soldiers during the Petsamo-Kirkenes Operation, 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effe