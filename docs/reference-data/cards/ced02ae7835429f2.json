{"format":"kards-original-reference","version":1,"id":"ced02ae7835429f2","name":"card_unit_arado_ar_196","package":"/Game/Blueprints/Cards/Germany/Base/units/card_unit_arado_ar_196","parent":"UBaseCardObject","card":{"title":"ARADO AR 196","text":"Deployment: If you have equal or less units on the battlefield, draw an order.","flavorText":"The Arado Ar 196 was a German made seaplane and was mainly used for reconnaissance missions. It was a standard aircraft of the Kriegsmarine (German Navy) and was used by the Axis forces throughout WWII. The aircraft was considered best of its class and served its purpose well in reconnaissance missions and submarine hunts, but it was no match against enemy fighters. The Finnish Air Force used it for transporting and supplying special forces behind enemy lines as it had the ability to land on small lakes in remote locations.","faction":"Germany","type":"fighter","rarity":"Rare","cost":1,"operationCost":1,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_arado_ar_196","title":{"Namespace":"card_germany","Key":"card_unit_arado_ar_196_title","SourceString":"ARADO AR 196","LocalizedString":"ARADO AR 196"},"Type":"ETypeEnum::fighter","attack":1,"defense":2,"range":2,"faction":"EFactionEnum::Germany","kredits":1,"Text":{"Namespace":"card_germany","Key":"card_unit_arado_ar_196_text","SourceString":"Deployment: If you have equal or less units on the battlefield, draw an order.","LocalizedString":"Deployment: If you have equal or less units on the battlefield, draw an order."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_arado_ar_196_history","SourceString":"The Arado Ar 196 was a German made seaplane and was mainly used for reconnaissance missions. It was a standard aircraft of the Kriegsmarine (German Navy) and was used by the Axis forces throughout WWII. The aircraft was considered best of its class and served its purpose well in reconnaissance missions and submarine hunts, but it was no match against enemy fighters. The Finnish Air Force used it for transporting and supplying special forces behind enemy lines as it had the ability to land on small lakes in remote locations.","LocalizedString":"The Arado Ar 196 was a German made seaplane and was mainly used for reconnaissance missions. It was a standard aircraft of the Kriegsmarine (German Navy) and was used by the Axis forces throughout WWII. The aircraft was considered best of its class and served its purpose well in reconnaissance missions and submarine hunts, but it was no match against enemy fighters. The Finnish Air Force used it for transporting and supplying special forces behind enemy lines as it had the ability to land on small lakes in remote locations."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Basic","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"soundEnterPlay":{"ObjectName":"SoundCue'AU_depl_biplane_Cue'","ObjectPath":"kards/Content/Assets/Audio/Biplane/AU_depl_biplane_Cue.0"},"soundMoveToFrontline":{"ObjectName":"SoundCue'AU_move_biplane_01_Cue'","ObjectPath":"kards/Content/Assets/Audio/Biplane/AU_move_biplane_01_Cue.0"},"soundAttack":{"ObjectName":"SoundCue'AU_move_biplane_01_Cue'","ObjectPath":"kards/Content/Assets/Audio/Biplane/AU_move_biplane_01_Cue.0"},"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Small_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Small_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/t_arado_ar_196.t_arado_ar_196","SubPathString":""},"artist":"Darryl Legg","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/ARADO_AR_196.ARADO_AR_196","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":429.0},"historyPhotoSource":"https://ww2db.com","historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_arado_ar_196_photo","SourceString":"Ar 196 A-5 aircraft flying in formation, date unknown.","LocalizedS