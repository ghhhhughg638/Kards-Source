{"format":"kards-original-reference","version":1,"id":"6d69294afa3633e2","name":"card_unit_l4_grasshopper","package":"/Game/Blueprints/Cards/USA/BloodIron/units/card_unit_l4_grasshopper","parent":"UBaseCardObject","card":{"title":"L-4 GRASSHOPPER","text":"Your Sherman units cost 1 less to deploy and have Blitz.","flavorText":"The L-4 Grasshopper was a light and versatile observation and liaison aircraft used by the US military during WWII. Adapted from the civilian Piper J-3 Cub, it played key roles in artillery spotting, reconnaissance, and supply missions throughout the war. With its slow speed and excellent maneuverability, the L-4 could take off and land on short, rugged fields, making it ideal for frontline operations. For the most part, the L-4 was unarmed, often flying low enough to evade enemy radar and attacks while providing critical “eyes” on the battlefield. Some L-4s were fitted with improvised racks carrying pairs or quartets of infantry bazookas for ground-attack missions against German armored units. The most famous of these was “Rosie the Rocketer” piloted by Maj. Charles \"Bazooka Charlie\" Carpenter, who destroyed six enemy tanks and several armored cars, particularly during the Battle of Arracourt in 1944. The L-4 could even be launched from ships using the Brodie landing system, further extending its versatility. Its simplicity and effectiveness made the L-4 an invaluable asset throughout the war.","faction":"USA","type":"fighter","rarity":"Uncommon","cost":2,"operationCost":1,"attack":1,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_l4_grasshopper","title":{"Namespace":"card_usa","Key":"card_unit_l4_grasshopper_title","SourceString":"L-4 GRASSHOPPER","LocalizedString":"L-4 GRASSHOPPER"},"Type":"ETypeEnum::fighter","attack":1,"defense":3,"range":2,"faction":"EFactionEnum::USA","kredits":2,"Text":{"Namespace":"card_usa","Key":"card_unit_l4_grasshopper_text","SourceString":"Your Sherman units cost 1 less to deploy and have Blitz.","LocalizedString":"Your Sherman units cost 1 less to deploy and have Blitz."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_l4_grasshopper_history","SourceString":"The L-4 Grasshopper was a light and versatile observation and liaison aircraft used by the US military during WWII. Adapted from the civilian Piper J-3 Cub, it played key roles in artillery spotting, reconnaissance, and supply missions throughout the war. With its slow speed and excellent maneuverability, the L-4 could take off and land on short, rugged fields, making it ideal for frontline operations. For the most part, the L-4 was unarmed, often flying low enough to evade enemy radar and attacks while providing critical “eyes” on the battlefield. Some L-4s were fitted with improvised racks carrying pairs or quartets of infantry bazookas for ground-attack missions against German armored units. The most famous of these was “Rosie the Rocketer” piloted by Maj. Charles \"Bazooka Charlie\" Carpenter, who destroyed six enemy tanks and several armored cars, particularly during the Battle of Arracourt in 1944. The L-4 could even be launched from ships using the Brodie landing system, further extending its versatility. Its simplicity and effectiveness made the L-4 an invaluable asset throughout the war.","LocalizedString":"The L-4 Grasshopper was a light and versatile observation and liaison aircraft used by the US military during WWII. Adapted from the civilian Piper J-3 Cub, it played key roles in artillery spotting, reconnaissance, and supply missions throughout the war. With its slow speed and excellent maneuverability, the L-4 could take off and land on short, rugged fields, making it ideal for frontline operations. For the most part, the L-4 was unarmed, often flying low enough to evade enemy radar and attacks while providing critical “eyes” on the battlefield. Some L-4s were fitted with improvised racks carrying pairs or quartets of infantry bazookas for ground-attack missions against German armored units. The most famous of these was “Rosie the Rocketer” piloted by Maj. Charles \"Bazooka Charlie\" Carpenter, who destroyed six enemy tanks and several armored cars, particularly during the Battle of Arracourt in 1944. The L-4 could even be launched from ships using the Brodie landing system, further extending its versatility. Its simplicity and effectiveness made the L-4 an invaluable asset throughout the war."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::BloodAndIron","EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardEnterPlay","ERegisteredCardFunction::OnOtherCardReset","ERegisteredCardFunction::OnOtherCardSpawnedInHand","ERegisteredCardFunction::OnOtherCardDrawnFromDeck"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Blitz"],"soundEnterPlay":{"ObjectName":"SoundCue'AU_depl_biplane_Cue'","ObjectPath":"kards/Content/Assets/Audio/Biplane/AU_depl_biplane_Cue.0"},"soundMoveToFrontline":{"ObjectName":"SoundCue'AU_move_biplane_01_Cue'","ObjectPath":"kards/Content/Assets/Audio/Biplane/AU_move_biplane_01_Cue.0"},"soundAttack":{"ObjectName":"SoundCue'AU_move_biplane_01_Cue'","ObjectPath":"kards/Content/Assets/Audio/Biplane/AU_move_biplane_01_Cue.0"},"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Small_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Small_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/Winter_2024/t_grasshopper.t_grasshopper","SubPathString":""},"artist":"US WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/L-4_GRASSHOPPER.L-4_GRASSHOPPER","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":397.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_l4_grasshopper_photo","SourceString":"Maj. Charles \"Bazooka Charlie\" Carpenter with the L-4 Grasshopper “Rosie the Rocketer” during WWII.","LocalizedString":"Maj. Charles \"Bazooka Charlie\" Carpenter with the L-4 Grasshopper “Rosie the Rocketer” during WWII."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftS'","ObjectPath":"kards/Content/Effects/Explosions/Small/Aircraft/P_ExplosionAircraftS.119"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackFighter.BP_AttackFighter_C","SubPathString":""}},"variables":[{"name":"tmpCard","type":"UBaseCardObject*","direction":"in"},{"name":"tempCardID","type":"int32","direction":"in"}],"functions":[{"name":"ApplyTheBuff","owner":"card_unit_l4_grasshopper_C","params":[],"pure":false,"event":false,"flags":"FUNC_Public | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_getHasGameplayTag_hasTag","type":"bool","direction":"in"},{"name":"CallFunc_IsLocatedOnBoard_isIt","type":"bool","direction":"in"},{"name":"CallFunc_IsLocatedInHand_isIt","type":"bool","direction":"in"},{"name":"CallFunc_ChangeKreditCost_qqq","type":"bool","direction":"in"},{"name":"CallFunc_EqualEqual_ByteByte_ReturnValue","type":"bool","direction":"in"}],"body":[{"op":"Context","at":0,"object":{"op":"Variable","name":"tmpCard","type":"UBaseCardObject*","scope":"member","sourceOp":"InstanceVariable"},"value":{"op":"FinalFunction","name":"getHasGameplayTag","signature":"BaseCardObject.getHasGameplayTag","args":[{"op":"StructConst","type":"GameplayTag","values":[{"op":"NameConst","value":"subtype.sherman"}]},{"op":"Variable","name":"CallFunc_getHasGameplayTag_hasTag","type":"bool","scope":"local","sourceOp":"LocalVariable"}]}},{"op":"JumpIfNot","at":68,"to":418,"condition":{"op":"Variable","name":"CallFunc_getHasGameplayTag_hasTag","type":"bool","scope":"local","sourceOp":"LocalVariable"}},{"op":"LetBool","at":82,"target":{"op":"Variable","name":"CallFunc_EqualEqual_ByteByte_ReturnValue","type":"bool","scope":"local","sourceOp":"LocalVariable"},"value":{"op":"Cal