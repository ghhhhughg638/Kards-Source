{"format":"kards-original-reference","version":1,"id":"c52b947afb5eadf1","name":"card_unit_12th_guards_mechanised","package":"/Game/Blueprints/Cards/Soviet/BloodIron/units/card_unit_12th_guards_mechanised","parent":"UBaseCardObject","card":{"title":"12th GUARDS MECHANISED","text":"Becomes Veteran when you deploy a tank with 4 or more attack.","flavorText":"The 12th Guards Mechanised Brigade fought closely along the tanks of the Red Army. It belongs to the 5th Guards Mechanized Corps. During the battle of Kursk in 1943, the Corps was part of the 5th Guards Tank Army and it fought in the southern part of the salient. It participated in the Battle of Prokhorovka, remained with the main striking force of the army and liberated Belgorod. It took part in the Battle of the Korsun-Cherkassy Pocket and finally the Battle of Berlin in 1945. It ended up with several honors including the Order of the Red Banner for exemplary performance during the capture of the capital of Germany, and for the valor and courage displayed in doing so.","faction":"Soviet","type":"infantry","rarity":"Common","cost":1,"operationCost":1,"attack":2,"defense":1},"defaults":{"UberGraphFrame":{},"Name":"card_unit_12th_guards_mechanised","title":{"Namespace":"card_soviet","Key":"card_unit_12th_guards_mechanised_title","SourceString":"12th GUARDS MECHANISED","LocalizedString":"12th GUARDS MECHANISED"},"Type":"ETypeEnum::infantry","attack":2,"defense":1,"range":1,"faction":"EFactionEnum::Soviet","kredits":1,"Text":{"Namespace":"card_soviet","Key":"card_unit_12th_guards_mechanised_text","SourceString":"Becomes Veteran when you deploy a tank with 4 or more attack.","LocalizedString":"Becomes Veteran when you deploy a tank with 4 or more attack."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_12th_guards_mechanised_history","SourceString":"The 12th Guards Mechanised Brigade fought closely along the tanks of the Red Army. It belongs to the 5th Guards Mechanized Corps. During the battle of Kursk in 1943, the Corps was part of the 5th Guards Tank Army and it fought in the southern part of the salient. It participated in the Battle of Prokhorovka, remained with the main striking force of the army and liberated Belgorod. It took part in the Battle of the Korsun-Cherkassy Pocket and finally the Battle of Berlin in 1945. It ended up with several honors including the Order of the Red Banner for exemplary performance during the capture of the capital of Germany, and for the valor and courage displayed in doing so.","LocalizedString":"The 12th Guards Mechanised Brigade fought closely along the tanks of the Red Army. It belongs to the 5th Guards Mechanized Corps. During the battle of Kursk in 1943, the Corps was part of the 5th Guards Tank Army and it fought in the southern part of the salient. It participated in the Battle of Prokhorovka, remained with the main striking force of the army and liberated Belgorod. It took part in the Battle of the Korsun-Cherkassy Pocket and finally the Battle of Berlin in 1945. It ended up with several honors including the Order of the Red Banner for exemplary performance during the capture of the capital of Germany, and for the valor and courage displayed in doing so."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::BloodAndIron","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnBeforeOtherCardPlayedFromHand"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Veteran","EHelpBubbleTypes::Blitz"],"hasSmokescreen":true,"spawnCardName":"card_unit_12th_guards_mechanised_vet","Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/Winter_2024/t_12th_guards_mechanised.t_12th_guards_mechanised","SubPathString":""},"artist":"Alamy Stock Images","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/12_GUARDS_MECHANIZED.12_GUARDS_MECHANIZED","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":315.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_