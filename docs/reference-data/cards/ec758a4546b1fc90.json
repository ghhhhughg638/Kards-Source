tages of the war. Some were modified for suicide missions, including the Sakura-dan variant which carried two 800 kg bombs. Some variants such as night fighters and anti-submarine aircraft were also developed. Its durability and agility made it one of Japan's most capable twin-engine bombers of WWII."},"operationCost":2,"rarity":"ERarityEnum::Unique","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Homefront","hasDeployment":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/Ki-67_PEGGY.Ki-67_PEGGY","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":341.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_japan_ki_67_peggy_photo","SourceString":"A Ki-67 “Peggy” of the 74th Hikō Sentai, Japan, 1945.","LocalizedString":"A Ki-67 “Peggy” of the 74th Hikō Sentai, Japan, 1945."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackBomber.BP_AttackBomber_C","SubPathString":""},"isRemoval":true},"variables":[],"functions":[{"name":"CanPlayFromHand","owner":"card_unit_japan_ki_67_peggy_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_GetOppositeSide_oppositeSide","type":"ESideEnum","direction":"in"},{"name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","direction":"in"},{"