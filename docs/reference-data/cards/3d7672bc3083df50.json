{"format":"kards-original-reference","version":1,"id":"3d7672bc3083df50","name":"card_unit_5e_cuirassier","package":"/Game/Blueprints/Cards/France/units/card_unit_5e_cuirassier","parent":"UBaseCardObject","card":{"title":"5e CUIRASSIERS","text":"Deployment: If this is the first unit you deploy this turn, add a 18e RÉGIMENT to hand.","flavorText":"The 5th Cuirassiers Regiment is a cavalry unit of the French Army formed during the French Revolution from a French royal regiment dating back to 1653. It took part in the campaigns of the Kingdom of France, the Napoleonic Wars, the Franco-Prussian War of 1870 and World War I. Its motto is “Nec pluribus impar” (meaning “unmatched” in Latin). At the beginning of World War II, it participated in the Battle of France. On May 10th, 1940, as part of the 2nd Light Cavalry Division, the 5th Cuirassiers fought the invading German troops at the Belgian border. They kept fighting in the French Ardennes after the German breakthrough at the Battle of Sedan. The division received the order to cease fire on June 12th after suffering heavy losses, and had to surrender to Erwin Rommel’s 7th Panzerdivision. On this occasion, Rommel paid homage to the French cavalry. After the end of WWII, the 5th Cuirassiers Regiment took part in the Indochina War as part of the French Far East Expeditionary Corps from 1946 to 1954. After being disbanded in 1992, it was reformed in June 2016.","faction":"France","type":"infantry","rarity":"Rare","cost":2,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_5e_cuirassier","title":{"Namespace":"card_france","Key":"card_unit_5e_cuirassier_title","SourceString":"5e CUIRASSIERS","LocalizedString":"5e CUIRASSIERS"},"Type":"ETypeEnum::infantry","attack":2,"defense":3,"range":1,"faction":"EFactionEnum::France","kredits":2,"Text":{"Namespace":"card_france","Key":"card_unit_5e_cuirassier_text","SourceString":"Deployment: If this is the first unit you deploy this turn, add a 18e RÉGIMENT to hand.","LocalizedString":"Deployment: If this is the first unit you deploy this turn, add a 18e RÉGIMENT to hand."},"flavorText":{"Namespace":"card_france","Key":"card_unit_5e_cuirassier_history","SourceString":"The 5th Cuirassiers Regiment is a cavalry unit of the French Army formed during the French Revolution from a French royal regiment dating back to 1653. It took part in the campaigns of the Kingdom of France, the Napoleonic Wars, the Franco-Prussian War of 1870 and World War I. Its motto is “Nec pluribus impar” (meaning “unmatched” in Latin). At the beginning of World War II, it participated in the Battle of France. On May 10th, 1940, as part of the 2nd Light Cavalry Division, the 5th Cuirassiers fought the invading German troops at the Belgian border. They kept fighting in the French Ardennes after the German breakthrough at the Battle of Sedan. The division received the order to cease fire on June 12th after suffering heavy losses, and had to surrender to Erwin Rommel’s 7th Panzerdivision. On this occasion, Rommel paid homage to the French cavalry. After the end of WWII, the 5th Cuirassiers Regiment took part in the Indochina War as part of the French Far East Expeditionary Corps from 1946 to 1954. After being disbanded in 1992, it was reformed in June 2016.","LocalizedString":"The 5th Cuirassiers Regiment is a cavalry unit of the French Army formed during the French Revolution from a French royal regiment dating back to 1653. It took part in the campaigns of the Kingdom of France, the Napoleonic Wars, the Franco-Prussian War of 1870 and World War I. Its motto is “Nec pluribus impar” (meaning “unmatched” in Latin). At the beginning of World War II, it participated in the Battle of France. On May 10th, 1940, as part of the 2nd Light Cavalry Division, the 5th Cuirassiers fought the invading German troops at the Belgian border. They kept fighting in the French Ardennes after the German breakthrough at the Battle of Sedan. The division received the order to cease fire on June 12th after suffering heavy losses, and had to surrender to Erwin Rommel’s 7th Panzerdivision. On this occasion, Rommel paid homage to the French cavalry. After the end of WWII, the 5th Cuirassiers Regiment took part in the Indochina War as part of the French Far East Expeditionary Corps from 1946 to 1954. After being disbanded in 1992, it was reformed in June 2016."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::BloodAndIron","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"hasBlitz":true,"spawnCardName":"card_unit_18e_regiment","soundEnterPlay":{"ObjectName":"SoundCue'AU_Move_Cavalry_light_Cue'","ObjectPath":"kards/Content/Assets/Audio/Cavalry/AU_Move_Cavalry_light_Cue.0"},"soundMoveToFrontline":{"ObjectName":"SoundCue'AU_Move_Cavalry_light_Cue'","ObjectPath":"kards/Content/Assets/Audio/Cavalry/AU_Move_Cavalry_light_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/France/Mini_Ally_Expansion_25/t_5e_cuirassier.t_5e_cuirassier","SubPathString":""},"artist":"French WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/5e_CUIRASSIERS.5e_CUIRASSIERS","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":342.0},"historyPhotoDescription":{"Namespace":"card_france","Key":"card_unit_5e_cuirassier_photo","SourceString":"Horsemen, cyclist and Somua S35 tank of the French Army, 1940.","LocalizedString":"Horsemen, cyclist and Somua S35 tank of the French Army, 1940."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPath