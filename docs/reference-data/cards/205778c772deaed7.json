{"format":"kards-original-reference","version":1,"id":"205778c772deaed7","name":"card_unit_fiat_cr_42","package":"/Game/Blueprints/Cards/Italy/units/card_unit_fiat_cr_42","parent":"UBaseCardObject","card":{"title":"FIAT C.R.42","text":"Deployment: Gets +1 attack if you control more units than the enemy.","flavorText":"The Fiat CR.42 Falco (e. falcon) was an Italian, single seated sesquiplane fighter, developed and manufactured by Fiat Aviazione and used by the Italian Royal Air Force in WWII. The CR.42 entered service in 1939 and was the last of the Fiat biplane fighters to enter frontline service. The fighter was used in bomber escort missions in Southern France in 1940, and later in raids on Britain, but was considered too vulnerable against British fighters and too slow to keep up with the rest of the air fleet. As the Allies started using more modern designs, the CR.42s were relocated to North Africa where they were still used in reconnaissance and ground attack roles. In total 1819 aircraft were manufactured and they were last used in 1948 by the Spanish Air Force.","faction":"Italy","type":"fighter","rarity":"Common","cost":1,"operationCost":1,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_fiat_cr_42","title":{"Namespace":"card_italy","Key":"card_unit_fiat_cr_42_title","SourceString":"FIAT C.R.42","LocalizedString":"FIAT C.R.42"},"Type":"ETypeEnum::fighter","attack":1,"defense":2,"range":2,"faction":"EFactionEnum::Italy","kredits":1,"Text":{"Namespace":"card_italy","Key":"card_unit_fiat_cr_42_text","SourceString":"Deployment: Gets +1 attack if you control more units than the enemy.","LocalizedString":"Deployment: Gets +1 attack if you control more units than the enemy."},"flavorText":{"Namespace":"card_italy","Key":"card_unit_fiat_cr_42_history","SourceString":"The Fiat CR.42 Falco (e. falcon) was an Italian, single seated sesquiplane fighter, developed and manufactured by Fiat Aviazione and used by the Italian Royal Air Force in WWII. The CR.42 entered service in 1939 and was the last of the Fiat biplane fighters to enter frontline service. The fighter was used in bomber escort missions in Southern France in 1940, and later in raids on Britain, but was considered too vulnerable against British fighters and too slow to keep up with the rest of the air fleet. As the Allies started using more modern designs, the CR.42s were relocated to North Africa where they were still used in reconnaissance and ground attack roles. In total 1819 aircraft were manufactured and they were last used in 1948 by the Spanish Air Force.","LocalizedString":"The Fiat CR.42 Falco (e. falcon) was an Italian, single seated sesquiplane fighter, developed and manufactured by Fiat Aviazione and used by the Italian Royal Air Force in WWII. The CR.42 entered service in 1939 and was the last of the Fiat biplane fighters to enter frontline service. The fighter was used in bomber escort missions in Southern France in 1940, and later in raids on Britain, but was considered too vulnerable against British fighters and too slow to keep up with the rest of the air fleet. As the Allies started using more modern designs, the CR.42s were relocated to North Africa where they were still used in reconnaissance and ground attack roles. In total 1819 aircraft were manufactured and they were last used in 1948 by the Spanish Air Force."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Expansion2019","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"soundEnterPlay":{"ObjectName":"SoundCue'AU_depl_biplane_Cue'","ObjectPath":"kards/Content/Assets/Audio/Biplane/AU_depl_biplane_Cue.0"},"soundMoveToFrontline":{"ObjectName":"SoundCue'AU_move_biplane_01_Cue'","ObjectPath":"kards/Content/Assets/Audio/Biplane/AU_move_biplane_01_Cue.0"},"soundAttack":{"ObjectName":"SoundCue'AU_move_biplane_01_Cue'","ObjectPath":"kards/Content/Assets/Audio/Biplane/AU_move_biplane_01_Cue.0"},"