{"format":"kards-original-reference","version":1,"id":"2279a6f921d3ad39","name":"card_unit_ki_49_donryu","package":"/Game/Blueprints/Cards/Japan/BrothersInArms/units/card_unit_ki_49_donryu","parent":"UBaseCardObject","card":{"title":"Ki-49 STORM DRAGON","text":"Destruction: Destroy all units.","flavorText":"The Nakajima Ki-49 Donryu, also known as the \"Storm Dragon,\" was a twin-engine heavy bomber used by the Japanese during WWII.  The Ki-49 was heavily armed and armored but had limited bomb-carrying, and was initially designed for daylight bombing missions without fighter escort. The Ki-49 saw service in China, New Guinea, and Australia, but faced challenges since it was underpowered and vulnerable against enemy fighters. Upgraded versions were developed, but production delays hindered further improvements. As losses mounted and fighter opposition increased, the Ki-49's role shifted to anti-submarine patrols, troop transport, and even kamikaze missions. Production ended in December 1944 after approximately 819 aircraft had been built.","faction":"Japan","type":"bomber","rarity":"Unique","cost":9,"operationCost":3,"attack":5,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_ki_49_donryu","title":{"Namespace":"card_japan","Key":"card_unit_ki_49_donryu_title","SourceString":"Ki-49 STORM DRAGON","LocalizedString":"Ki-49 STORM DRAGON"},"Type":"ETypeEnum::bomber","attack":5,"defense":4,"range":2,"faction":"EFactionEnum::Japan","kredits":9,"Text":{"Namespace":"card_japan","Key":"card_unit_ki_49_donryu_text","SourceString":"Destruction: Destroy all units.","LocalizedString":"Destruction: Destroy all units."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_ki_49_donryu_history","SourceString":"The Nakajima Ki-49 Donryu, also known as the \"Storm Dragon,\" was a twin-engine heavy bomber used by the Japanese during WWII.  The Ki-49 was heavily armed and armored but had limited bomb-carrying, and was initially designed for daylight bombing missions without fighter escort. The Ki-49 saw service in China, New Guinea, and Australia, but faced challenges since it was underpowered and vulnerable against enemy fighters. Upgraded versions were developed, but production delays hindered further improvements. As losses mounted and fighter opposition increased, the Ki-49's role shifted to anti-submarine patrols, troop transport, and even kamikaze missions. Production ended in December 1944 after approximately 819 aircraft had been built.","LocalizedString":"The Nakajima Ki-49 Donryu, also known as the \"Storm Dragon,\" was a twin-engine heavy bomber used by the Japanese during WWII.  The Ki-49 was heavily armed and armored but had limited bomb-carrying, and was initially designed for daylight bombing missions without fighter escort. The Ki-49 saw service in China, New Guinea, and Australia, but faced challenges since it was underpowered and vulnerable against enemy fighters. Upgraded versions were developed, but production delays hindered further improvements. As losses mounted and fighter opposition increased, the Ki-49's role shifted to anti-submarine patrols, troop transport, and even kamikaze missions. Production ended in December 1944 after approximately 819 aircraft had been built."},"operationCost":3,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::BrothersInArms","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Destruction"],"hasDestruction":true,"hasBlitz":true,"soundBlowUp":{"ObjectName":"SoundCue'au_aircraft_large'","ObjectPath":"kards/Content/Explosions_SFX/Cues/au_aircraft_large.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/Spring2023Candidates/t_ki_49_storm_dragon.t_ki_49_storm_dragon","SubPathString":""},"artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/KI-49_STORM_DRAGON.KI-49_STORM_DRAGON","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":365.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_ki_