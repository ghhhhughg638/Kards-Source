{"format":"kards-original-reference","version":1,"id":"d5347a83765e51f4","name":"card_event_command_failure","package":"/Game/Blueprints/Cards/Japan/BloodIron/events/card_event_command_failure","parent":"UBaseCardObject","card":{"title":"COMMAND FAILURE","text":"Destroy target unit with less attack than defense.","flavorText":"One notable example of Japanese troops exploiting an Allied weakness during WWII was the capture of Singapore in February 1942. The British had heavily fortified the southern coast of the island, expecting a naval assault, but they neglected to defend the northern part effectively, assuming the dense jungle would prevent an attack from Malaya. Japanese forces, under General Tomoyuki Yamashita, advanced swiftly down the Malay Peninsula, using bicycles and light tanks to move through the jungle terrain, which the British had believed to be impassable. The speed and surprise of the Japanese advance overwhelmed British defenses. When the Japanese reached the unprotected northern side of Singapore, they launched a rapid assault, crossing the Johor Strait and attacking from the landward side. The British forces were not prepared for a land invasion and soon faced shortages of supplies and declining morale. Finally the British forces surrendered on February 15th, 1942, in one of the most significant Allied defeats of the war.","faction":"Japan","type":"order","rarity":"Uncommon","cost":3,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_command_failure","title":{"Namespace":"card_japan","Key":"card_event_command_failure_title","SourceString":"COMMAND FAILURE","LocalizedString":"COMMAND FAILURE"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Japan","kredits":3,"Text":{"Namespace":"card_japan","Key":"card_event_command_failure_text","SourceString":"Destroy target unit with less attack than defense.","LocalizedString":"Destroy target unit with less attack than defense."},"flavorText":{"Namespace":"card_japan","Key":"card_event_command_failure_history","SourceString":"One notable example of Japanese troops exploiting an Allied weakness during WWII was the capture of Singapore in February 1942. The British had heavily fortified the southern coast of the island, expecting a naval assault, but they neglected to defend the northern part effectively, assuming the dense jungle would prevent an attack from Malaya. Japanese forces, under General Tomoyuki Yamashita, advanced swiftly down the Malay Peninsula, using bicycles and light tanks to move through the jungle terrain, which the British had believed to be impassable. The speed and surprise of the Japanese advance overwhelmed British defenses. When the Japanese reached the unprotected northern side of Singapore, they launched a rapid assault, crossing the Johor Strait and attacking from the landward side. The British forces were not prepared for a land invasion and soon faced shortages of supplies and declining morale. Finally the British forces surrendered on February 15th, 1942, in one of the most significant Allied defeats of the war.","LocalizedString":"One notable example of Japanese troops exploiting an Allied weakness during WWII was the capture of Singapore in February 1942. The British had heavily fortified the southern coast of the island, expecting a naval assault, but they neglected to defend the northern part effectively, assuming the dense jungle would prevent an attack from Malaya. Japanese forces, under General Tomoyuki Yamashita, advanced swiftly down the Malay Peninsula, using bicycles and light tanks to move through the jungle terrain, which the British had believed to be impassable. The speed and surprise of the Japanese advance overwhelmed British defenses. When the Japanese reached the unprotected northern side of Singapore, they launched a rapid assault, crossing the Johor Strait and attacking from the landward side. The British forces were not prepared for a land invasion and soon faced shortages of supplies and declining morale. Finally the British forces surrendered on February 15th, 1942, in one of the most significant Allied defeats of the war."},"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::BloodAndIron","draftBaseWeight":0.9,"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Taiko_Hits_1'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Taiko_Hits_1.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/Winter_2024/t_command_failure.t_command_failure","SubPathString":""},"artist":"Rebellion","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/COMMAND_FAILURE.COMMAND_FAILURE","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":341.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_event_command_failure_photo","SourceString":"Victorious Japanese troops marching through Fullerton Square, Singapore, 1942.","LocalizedString":"Victorious Japanese troops marching through Fullerton Square, Singapore, 1942."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"isRemoval":true},"variables":[],"functions":[{"name":"CanPlayFromHand","owner":"card_event_command_failure_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","direction":"in"},{"name":"CallFunc_GetTargetedCard_card","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_getTotalDefense_totalDefense","type":"int32","direction":"in"},{"name":"CallFunc_getTotalAtta