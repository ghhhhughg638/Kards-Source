{"format":"kards-original-reference","version":1,"id":"d6d3e59005a66996","name":"card_unit_110e_regiment_motorize","package":"/Game/Blueprints/Cards/France/units/card_unit_110e_regiment_motorize","parent":"UBaseCardObject","card":{"title":"110e RÉGIMENT MOTORISÉ","text":"Give your other units +1+1 the first time you shuffle your deck each turn.","flavorText":"The 110th Motorized Infantry Regiment is a French Army unit established in 1792 during the Revolution. At the start of WWII, it was part of the 1st Motorized Infantry Division (1st DIM), attached to the 7th Army, and advanced into Belgium according to the Dyle plan, or plan D. Between May 11 and 15, 1940, the 110th Regiment took part in one of the rare French victories against the Wehrmacht during the Battle of France, repelling assaults by the 3rd Panzer Division near Gembloux, Belgium, despite lacking tanks and air support and suffering heavy casualties. Following the German breakthrough at Sedan further south, the 1st DIM was forced to retreat and became encircled in the Lille Pocket, where it fought fiercely until running out of ammunition, buying crucial time for the Allied evacuation at Dunkirk. After France’s surrender, soldiers from the 110th Regiment formed Resistance groups in Northern France. The regiment was first revived in October 1944 during the Siege of Dunkirk, then officially reestablished on January 1, 1945, to fight in Germany.","faction":"France","type":"infantry","rarity":"Rare","cost":2,"operationCost":1,"attack":2,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_110e_regiment_motorize","title":{"Namespace":"card_france","Key":"card_unit_110e_regiment_motorize_title","SourceString":"110e RÉGIMENT MOTORISÉ","LocalizedString":"110e RÉGIMENT MOTORISÉ"},"Type":"ETypeEnum::infantry","attack":2,"defense":2,"range":1,"faction":"EFactionEnum::France","kredits":2,"Text":{"Namespace":"card_france","Key":"card_unit_110e_regiment_motorize_text","SourceString":"Give your other units +1+1 the first time you shuffle your deck each turn.","LocalizedString":"Give your other units +1+1 the first time you shuffle your deck each turn."},"flavorText":{"Namespace":"card_france","Key":"card_unit_110e_regiment_motorize_history","SourceString":"The 110th Motorized Infantry Regiment is a French Army unit established in 1792 during the Revolution. At the start of WWII, it was part of the 1st Motorized Infantry Division (1st DIM), attached to the 7th Army, and advanced into Belgium according to the Dyle plan, or plan D. Between May 11 and 15, 1940, the 110th Regiment took part in one of the rare French victories against the Wehrmacht during the Battle of France, repelling assaults by the 3rd Panzer Division near Gembloux, Belgium, despite lacking tanks and air support and suffering heavy casualties. Following the German breakthrough at Sedan further south, the 1st DIM was forced to retreat and became encircled in the Lille Pocket, where it fought fiercely until running out of ammunition, buying crucial time for the Allied evacuation at Dunkirk. After France’s surrender, soldiers from the 110th Regiment formed Resistance groups in Northern France. The regiment was first revived in October 1944 during the Siege of Dunkirk, then officially reestablished on January 1, 1945, to fight in Germany.","LocalizedString":"The 110th Motorized Infantry Regiment is a French Army unit established in 1792 during the Revolution. At the start of WWII, it was part of the 1st Motorized Infantry Division (1st DIM), attached to the 7th Army, and advanced into Belgium according to the Dyle plan, or plan D. Between May 11 and 15, 1940, the 110th Regiment took part in one of the rare French victories against the Wehrmacht during the Battle of France, repelling assaults by the 3rd Panzer Division near Gembloux, Belgium, despite lacking tanks and air support and suffering heavy casualties. Following the German breakthrough at Sedan further south, the 1st DIM was forced to retreat and became encircled in the Lille Pocket, where it fought fiercely until running out of ammunition, buying crucial time for the Allied evacuation at Dunkirk. After France’s surrender, soldiers from the 110th Regiment formed Resistance groups in Northern France. The regiment was first revived in October 1944 during the Siege of Dunkirk, then officially reestablished on January 1, 1945, to fight in Germany."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::NavalWarfare","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn","ERegisteredCardFunction::OnDeckShuffled"],"hasBlitz":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/France/NavalWarfare/t_88e_régiment.t_88e_régiment","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/110e_REGIMENT_MOTORISE.110e_REGIMENT_MOTORISE","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":377.0},"historyPhotoDescription":{"Namespace":"card_france","Key":"card_unit_110e_regiment_motorize_photo","SourceString":"French soldiers of the 7th Army retreating from Belgium to the Weygand defensive line, May 1940.","LocalizedString":"French soldiers of the 7th Army retreating from Belgium to the Weygand defensive line, May 1940."},"historyTypeDescription":{"Namespace":"","Key":"0DBC5F184A8F0CFAA1A9D6BB449E2AC6","SourceString":"Infantry","LocalizedString":"Infantry"},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"threat_level":0.1},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_110e_regiment_motorize","owner":