{"format":"kards-original-reference","version":1,"id":"1dbfcb0e4a40d45c","name":"card_event_careless_talk","package":"/Game/Blueprints/Cards/Germany/Base/events/card_event_careless_talk","parent":"UBaseCardObject","card":{"title":"CARELESS TALK","text":"When your enemy deploys a unit, deal 3 damage to it.","flavorText":"Anti gossip campaigns were launched by all fighting parties in WWII. The aim was to discourage talking about sensitive material where it could possibly be overheard by spies. Careless talk did indeed have an impact on the Nazi Germany war effort, and perhaps from where they least expected. As an example, Poles were used as forced laborers across the continent of the Nazi Reich, which put them in a unique position to spy on their enemy. It is believed that 48 percent of all reports received by British secret services during the war had come from these sources. The reports included advanced warnings of Operation Barbarossa, Operation Edelweiss, the German Caucasus Campaign and first intelligence on the Holocaust.","faction":"Germany","type":"gotcha","rarity":"Common","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_careless_talk","title":{"Namespace":"card_germany","Key":"card_event_careless_talk_title","SourceString":"CARELESS TALK","LocalizedString":"CARELESS TALK"},"Type":"ETypeEnum::gotcha","faction":"EFactionEnum::Germany","kredits":1,"Text":{"Namespace":"card_germany","Key":"card_event_careless_talk_text","SourceString":"When your enemy deploys a unit, deal 3 damage to it.","LocalizedString":"When your enemy deploys a unit, deal 3 damage to it."},"flavorText":{"Namespace":"card_germany","Key":"card_event_careless_talk_history","SourceString":"Anti gossip campaigns were launched by all fighting parties in WWII. The aim was to discourage talking about sensitive material where it could possibly be overheard by spies. Careless talk did indeed have an impact on the Nazi Germany war effort, and perhaps from where they least expected. As an example, Poles were used as forced laborers across the continent of the Nazi Reich, which put them in a unique position to spy on their enemy. It is believed that 48 percent of all reports received by British secret services during the war had come from these sources. The reports included advanced warnings of Operation Barbarossa, Operation Edelweiss, the German Caucasus Campaign and first intelligence on the Holocaust.","LocalizedString":"Anti gossip campaigns were launched by all fighting parties in WWII. The aim was to discourage talking about sensitive material where it could possibly be overheard by spies. Careless talk did indeed have an impact on the Nazi Germany war effort, and perhaps from where they least expected. As an example, Poles were used as forced laborers across the continent of the Nazi Reich, which put them in a unique position to spy on their enemy. It is believed that 48 percent of all reports received by British secret services during the war had come from these sources. The reports included advanced warnings of Operation Barbarossa, Operation Edelweiss, the German Caucasus Campaign and first intelligence on the Holocaust."},"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Basic","isInPermanentPool":true,"usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"draftBaseWeight":1.2,"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Class_Specific_Engineer_Socket_Crank_Sequence_2'","ObjectPath":"kards/Content/War_UI/Waves/Class_Specific/War_UI_Class_Specific_Engineer_Socket_Crank_Sequence_2.0"},"soundAttack":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/t_careless_talk.t_careless_talk","SubPathString":""},"ImageAnchor":"EImageAnchor::Bot","artist":"War posters / Alamy Stock Photo","historyPhoto":{"AssetPathName":