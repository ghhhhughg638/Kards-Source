{"format":"kards-original-reference","version":1,"id":"182e943b5b4031ae","name":"card_unit_199th_rifle_regiment","package":"/Game/Blueprints/Cards/Soviet/Homefront/units/card_unit_199th_rifle_regiment","parent":"UBaseCardObject","card":{"title":"199th RIFLE REGIMENT","text":"Gets +1+1 when you deploy or add a British or US unit.","flavorText":"The 199th Rifle Regiment served in the 39th Rifle Division, a veteran formation from the Russian Far East region. Originally formed in 1922, the division operated under the Special Far Eastern Army and later became part of the 1st Red Banner Army. Stationed near Vladivostok, the 39th was tasked with guarding the border against Japanese incursions and played a defensive role throughout most of WWII. Its regiments, including the 199th, were seasoned in frontier operations and prepared for rapid deployment in the event of conflict with Japan. In August 1945, during the Soviet invasion of Manchuria, the 39th Rifle Division finally moved into action. Advancing from Primorsky Krai, it helped crush the Japanese Kwantung Army in one of the final offensives of the war. For its role, the division received several decorations, including the Order of the Red Banner and the Order of Kutuzov. After the war, it was reorganized into a motorized unit and later transitioned into a training formation, preserving the legacy of its regiments, like the 199th, well into the postwar era.","faction":"Soviet","type":"infantry","rarity":"Uncommon","cost":2,"operationCost":1,"attack":2,"defense":2},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.bond"],"Name":"card_unit_199th_rifle_regiment","title":{"Namespace":"card_soviet","Key":"card_unit_199th_rifle_regiment_title","SourceString":"199th RIFLE REGIMENT","LocalizedString":"199th RIFLE REGIMENT"},"Type":"ETypeEnum::infantry","attack":2,"defense":2,"range":1,"faction":"EFactionEnum::Soviet","kredits":2,"Text":{"Namespace":"card_soviet","Key":"card_unit_199th_rifle_regiment_text","SourceString":"Gets +1+1 when you deploy or add a British or US unit.","LocalizedString":"Gets +1+1 when you deploy or add a British or US unit."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_199th_rifle_regiment_history","SourceString":"The 199th Rifle Regiment served in the 39th Rifle Division, a veteran formation from the Russian Far East region. Originally formed in 1922, the division operated under the Special Far Eastern Army and later became part of the 1st Red Banner Army. Stationed near Vladivostok, the 39th was tasked with guarding the border against Japanese incursions and played a defensive role throughout most of WWII. Its regiments, including the 199th, were seasoned in frontier operations and prepared for rapid deployment in the event of conflict with Japan. In August 1945, during the Soviet invasion of Manchuria, the 39th Rifle Division finally moved into action. Advancing from Primorsky Krai, it helped crush the Japanese Kwantung Army in one of the final offensives of the war. For its role, the division received several decorations, including the Order of the Red Banner and the Order of Kutuzov. After the war, it was reorganized into a motorized unit and later transitioned into a training formation, preserving the legacy of its regiments, like the 199th, well into the postwar era.","LocalizedString":"The 199th Rifle Regiment served in the 39th Rifle Division, a veteran formation from the Russian Far East region. Originally formed in 1922, the division operated under the Special Far Eastern Army and later became part of the 1st Red Banner Army. Stationed near Vladivostok, the 39th was tasked with guarding the border against Japanese incursions and played a defensive role throughout most of WWII. Its regiments, including the 199th, were seasoned in frontier operations and prepared for rapid deployment in the event of conflict with Japan. In August 1945, during the Soviet invasion of Manchuria, the 39th Rifle Division finally moved into action. Advancing from Primorsky Krai, it helped crush the Japanese Kwantung Army in one of the final offensives of the war. For its role, the division received several decorations, including the Order of the Red Banner and the Order of Kutuzov. After the war, it was reorganized into a motorized unit and later transitioned into a training formation, preserving the legacy of its regiments, like the 199th, well into the postwar era."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardEnterPlay"],"hasSmokescreen":true,"hasShock":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/199th_RIFLE_REGIMENT.199th_RIFLE_REGIMENT","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_199th_rifle_regiment_photo","SourceString":"Red Army infantry soldiers during the Soviet invasion of Manchuria, 1945.","LocalizedString":"Red Army infantry soldiers during the Soviet invasion of Manchuria, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_199th_rifle_regiment","owner":"card_unit_199th_rifle_regiment_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"K2Node_Event_cardPlayed","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_method","type":"EOnEnterPlayMethod","direction":"in"},{"name":"CallFunc_NotEqual_ByteByte_ReturnValue","type"