{"format":"kards-original-reference","version":1,"id":"63c7f07f59529006","name":"card_unit_55th_rifles","package":"/Game/Blueprints/Cards/Soviet/Homefront/units/card_unit_55th_rifles","parent":"UBaseCardObject","card":{"title":"55th RIFLES","text":"Destruction: Gain 3 additional kredits at the start of your next turn.","flavorText":"The 55th Rifle Regiment was part of the 17th Rifle Division, an infantry formation of the Soviet Red Army with a long lineage dating back to the Russian Civil War. Originally formed in October 1918, the division fought in multiple early Soviet conflicts including the Civil War, the Polish-Soviet War, and the Winter War against Finland. In WWII, the division was first deployed to the Vitebsk-Polotsk area as part of the 10th Army at the start of Operation Barbarossa in June 1941. Surrounded by German forces east of Minsk, the division was destroyed by the end of that month, though it was not officially disbanded until September 19, 1941. A new 17th Rifle Division was reformed in October 1941 from the 17th Moscow People's Militia Rifle Division. It was assigned to the 33rd and later the 43rd Army, participating in the defense of Moscow. From 1943 onward, the division was part of the 1st Belorussian Front, where it fought in major operations including the Orel Counteroffensive, Operation Bagration, and the East Prussian Offensive. It was honored with the Order of the Red Banner and participated in the liberation of Bobruisk. The division was disbanded in 1947 after a brief postwar service as a rifle brigade.","faction":"Soviet","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":1,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_55th_rifles","title":{"Namespace":"card_soviet","Key":"card_unit_55th_rifles_title","SourceString":"55th RIFLES","LocalizedString":"55th RIFLES"},"Type":"ETypeEnum::infantry","attack":3,"defense":4,"range":1,"faction":"EFactionEnum::Soviet","kredits":3,"Text":{"Namespace":"card_soviet","Key":"card_unit_55th_rifles_text","SourceString":"Destruction: Gain 3 additional kredits at the start of your next turn.","LocalizedString":"Destruction: Gain 3 additional kredits at the start of your next turn."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_55th_rifles_history","SourceString":"The 55th Rifle Regiment was part of the 17th Rifle Division, an infantry formation of the Soviet Red Army with a long lineage dating back to the Russian Civil War. Originally formed in October 1918, the division fought in multiple early Soviet conflicts including the Civil War, the Polish-Soviet War, and the Winter War against Finland. In WWII, the division was first deployed to the Vitebsk-Polotsk area as part of the 10th Army at the start of Operation Barbarossa in June 1941. Surrounded by German forces east of Minsk, the division was destroyed by the end of that month, though it was not officially disbanded until September 19, 1941. A new 17th Rifle Division was reformed in October 1941 from the 17th Moscow People's Militia Rifle Division. It was assigned to the 33rd and later the 43rd Army, participating in the defense of Moscow. From 1943 onward, the division was part of the 1st Belorussian Front, where it fought in major operations including the Orel Counteroffensive, Operation Bagration, and the East Prussian Offensive. It was honored with the Order of the Red Banner and participated in the liberation of Bobruisk. The division was disbanded in 1947 after a brief postwar service as a rifle brigade.","LocalizedString":"The 55th Rifle Regiment was part of the 17th Rifle Division, an infantry formation of the Soviet Red Army with a long lineage dating back to the Russian Civil War. Originally formed in October 1918, the division fought in multiple early Soviet conflicts including the Civil War, the Polish-Soviet War, and the Winter War against Finland. In WWII, the division was first deployed to the Vitebsk-Polotsk area as part of the 10th Army at the start of Operation Barbarossa in June 1941. Surrounded by German forces east of Minsk, the division was destroyed by the end of that month, though it was not officially disbanded until September 19, 1941. A new 17th Rifle Division was reformed in October 1941 from the 17th Moscow People's Militia Rifle Division. It was assigned to the 33rd and later the 43rd Army, participating in the defense of Moscow. From 1943 onward, the division was part of the 1st Belorussian Front, where it fought in major operations including the Orel Counteroffensive, Operation Bagration, and the East Prussian Offensive. It was honored with the Order of the Red Banner and participated in the liberation of Bobruisk. The division was disbanded in 1947 after a brief postwar service as a rifle brigade."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Homefront","usedTriggers":["ERegisteredCardFunction::OnStartofTurn","ERegisteredCardFunction::OnEndOfTurn"],"hasDestruction":true,"hasGuard":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/55th_RIFLES.55th_RIFLES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":384.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_55th_rifles_photo","SourceString":"Soviet infantry and armored forces during a counterattack in 1941.","LocalizedString":"Soviet infantry and armored forces during a counterattack in 1941."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"isDefenseBuff":true},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_55th_rifles","owner":"card_unit_55th_rifles_