{"format":"kards-original-reference","version":1,"id":"9ade97057e378860","name":"card_unit_king_tiger_ii","package":"/Game/Blueprints/Cards/Germany/WorldAtWar/units/card_unit_king_tiger_ii","parent":"UBaseCardObject","card":{"title":"KING TIGER","text":"Gain 2 kredits for each of your German units after this unit is deployed or operated.","flavorText":"The King Tiger (German: Königstiger), official designation Panzerkampfwagen Tiger Ausf. B, was a German heavy tank that first entered service in 1944. The tank saw action on the Eastern Front and in Europe and its 8.8cm KwK 43 gun and armor made it a formidable weapon. It could knock out any Allied tank that came up against it and its thick armor made it almost impenetrable for any Allied weapon. The main problem with King Tiger was its reliability and many crews were forced to abandon the tank when it either broke down or ran out of fuel. Luckily for the Allies the tank was produced late and under the most difficult circumstances, both the bombing of German factories and lack of materials caused a series of delays and limited the production capabilities. Only 489 King Tigers were manufactured.","faction":"Germany","type":"tank","rarity":"Unique","cost":12,"operationCost":4,"attack":10,"defense":10},"defaults":{"UberGraphFrame":{},"Name":"card_unit_king_tiger_ii","title":{"Namespace":"card_germany","Key":"card_unit_king_tiger_ii_title","SourceString":"KING TIGER","LocalizedString":"KING TIGER"},"Type":"ETypeEnum::tank","attack":10,"defense":10,"range":1,"faction":"EFactionEnum::Germany","kredits":12,"Text":{"Namespace":"card_germany","Key":"card_unit_king_tiger_ii_text","SourceString":"Gain 2 kredits for each of your German units after this unit is deployed or operated.","LocalizedString":"Gain 2 kredits for each of your German units after this unit is deployed or operated."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_king_tiger_ii_history","SourceString":"The King Tiger (German: Königstiger), official designation Panzerkampfwagen Tiger Ausf. B, was a German heavy tank that first entered service in 1944. The tank saw action on the Eastern Front and in Europe and its 8.8cm KwK 43 gun and armor made it a formidable weapon. It could knock out any Allied tank that came up against it and its thick armor made it almost impenetrable for any Allied weapon. The main problem with King Tiger was its reliability and many crews were forced to abandon the tank when it either broke down or ran out of fuel. Luckily for the Allies the tank was produced late and under the most difficult circumstances, both the bombing of German factories and lack of materials caused a series of delays and limited the production capabilities. Only 489 King Tigers were manufactured.","LocalizedString":"The King Tiger (German: Königstiger), official designation Panzerkampfwagen Tiger Ausf. B, was a German heavy tank that first entered service in 1944. The tank saw action on the Eastern Front and in Europe and its 8.8cm KwK 43 gun and armor made it a formidable weapon. It could knock out any Allied tank that came up against it and its thick armor made it almost impenetrable for any Allied weapon. The main problem with King Tiger was its reliability and many crews were forced to abandon the tank when it either broke down or ran out of fuel. Luckily for the Allies the tank was produced late and under the most difficult circumstances, both the bombing of German factories and lack of materials caused a series of delays and limited the production capabilities. Only 489 King Tigers were manufactured."},"operationCost":4,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::WorldAtWar","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Trigger","extraHelpTextBubbleTypes":["EHelpBubbleTypes::HeavyArmor2"],"heavyArmor":2,"soundBlowUp":{"ObjectName":"SoundWave'explosion_metal_large'","ObjectPath":"kards/Content/Explosions_SFX/Wavs/explosion_metal_large.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/