{"format":"kards-original-reference","version":1,"id":"62d7cdc89fd6d56b","name":"card_unit_kyoto_regiment","package":"/Game/Blueprints/Cards/Japan/NavalWarfare/units/card_unit_kyoto_regiment","parent":"UBaseCardObject","card":{"title":"KYOTO REGIMENT","text":"Deployment: Remove an enemy unit until this unit leaves the battlefield.","flavorText":"The 51st Infantry Regiment (Kyoto) was a unit of the 15th Division of the Imperial Japanese Army. The division was established in 1905 during the Russo-Japanese War. It was disbanded in 1925 as part of military downsizing. The division was reactivated in 1938. In 1943, the 15th Division was reassigned to the 15th Army in Burma to participate in Operation U-Go, an offensive aimed at invading the British Raj. The division's objective was to cut the road between Imphal and Kohima at Kangpokpi. However, challenging terrain and logistical issues delayed their advance. The division faced stiff resistance from Allied forces, including unexpected tank assaults, leading to significant casualties. By mid-1944, it was forced to retreat after failing to achieve its objectives. In early 1945, the 15th Division, alongside the 53rd Division, was tasked with defending Mandalay against advancing Allied forces. Despite reinforcements, it was understrength and unable to hold the city. After intense fighting, the division withdrew from Mandalay in March 1945. The remnants retreated through difficult terrain back into Thailand, where they remained until Japan's surrender in August 1945.","faction":"Japan","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":1,"attack":1,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_kyoto_regiment","title":{"Namespace":"card_japan","Key":"card_unit_kyoto_regiment_title","SourceString":"KYOTO REGIMENT","LocalizedString":"KYOTO REGIMENT"},"Type":"ETypeEnum::infantry","attack":1,"defense":4,"range":1,"faction":"EFactionEnum::Japan","kredits":3,"Text":{"Namespace":"card_japan","Key":"card_unit_kyoto_regiment_text","SourceString":"Deployment: Remove an enemy unit until this unit leaves the battlefield.","LocalizedString":"Deployment: Remove an enemy unit until this unit leaves the battlefield."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_67th_infantry_regiment_history","SourceString":"The 51st Infantry Regiment (Kyoto) was a unit of the 15th Division of the Imperial Japanese Army. The division was established in 1905 during the Russo-Japanese War. It was disbanded in 1925 as part of military downsizing. The division was reactivated in 1938. In 1943, the 15th Division was reassigned to the 15th Army in Burma to participate in Operation U-Go, an offensive aimed at invading the British Raj. The division's objective was to cut the road between Imphal and Kohima at Kangpokpi. However, challenging terrain and logistical issues delayed their advance. The division faced stiff resistance from Allied forces, including unexpected tank assaults, leading to significant casualties. By mid-1944, it was forced to retreat after failing to achieve its objectives. In early 1945, the 15th Division, alongside the 53rd Division, was tasked with defending Mandalay against advancing Allied forces. Despite reinforcements, it was understrength and unable to hold the city. After intense fighting, the division withdrew from Mandalay in March 1945. The remnants retreated through difficult terrain back into Thailand, where they remained until Japan's surrender in August 1945.","LocalizedString":"The 51st Infantry Regiment (Kyoto) was a unit of the 15th Division of the Imperial Japanese Army. The division was established in 1905 during the Russo-Japanese War. It was disbanded in 1925 as part of military downsizing. The division was reactivated in 1938. In 1943, the 15th Division was reassigned to the 15th Army in Burma to participate in Operation U-Go, an offensive aimed at invading the British Raj. The division's objective was to cut the road between Imphal and Kohima at Kangpokpi. However, challenging terrain and logistical issues delayed their advance. The division faced stiff resistance from Allied forces, including unexpected tank assaults, leading to significant casualties. By mid-1944, it was forced to retreat after failing to achieve its objectives. In early 1945, the 15th Division, alongside the 53rd Division, was tasked with defending Mandalay against advancing Allied forces. Despite reinforcements, it was understrength and unable to hold the city. After intense fighting, the division withdrew from Mandalay in March 1945. The remnants retreated through difficult terrain back into Thailand, where they remained until Japan's surrender in August 1945."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::NavalWarfare","hasDeployment":true,"hasGuard":true,"cipher":1,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/NavalWarfare/t_67th_infantry_regiment.t_67th_infantry_regiment","SubPathString":""},"artist":"Japanese WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/KYOTO_REGIMENT.KYOTO_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":366.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_67th_infantry_regiment_photo","SourceString":"Japanese troops crossing flooded terrain in Burma.","LocalizedString":"Japanese troops crossing flooded terrain in Burma."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"Notes":"Image from Y.Takani not licensed yet","isHQDamage":true,"threat_level":0.15},"variables