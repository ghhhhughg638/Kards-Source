{"format":"kards-original-reference","version":1,"id":"58ccb49f043712eb","name":"card_unit_173rd_guard_rifles","package":"/Game/Blueprints/Cards/Soviet/Legions/units/card_unit_173rd_guard_rifles","parent":"UBaseCardObject","card":{"title":"173rd GUARD RIFLES","text":"Gets +1 attack when your HQ takes damage.","flavorText":"The 173rd Guard Rifles was a regiment of the 1st Division of the Soviet Red Army. The division was formed from units stationed in Moscow and during the course of WWII it was reformed a few times. In 1940 the division was redesignated 1st Motorized Division and in 1942 it was raised to guard status. The division fought at Stalingrad in 1942 and by the end of the year it was redesignated 58th Guards Rifle Division. In 1944 the division became part of the 70th Army of the 2nd Belorussian, and that same year it participated in the Lublin-Brest Offensive, followed by the advance into Poland where it fought at Gdynia. The division was briefly a part of the Group of Soviet Forces in Germany before being disbanded in July 1945.","faction":"Soviet","type":"infantry","rarity":"Common","cost":1,"operationCost":0,"attack":1,"defense":1},"defaults":{"UberGraphFrame":{},"Name":"card_unit_173rd_guard_rifles","title":{"Namespace":"card_soviet","Key":"card_unit_173rd_guard_rifles_title","SourceString":"173rd GUARD RIFLES","LocalizedString":"173rd GUARD RIFLES"},"Type":"ETypeEnum::infantry","attack":1,"defense":1,"range":1,"faction":"EFactionEnum::Soviet","kredits":1,"Text":{"Namespace":"card_soviet","Key":"card_unit_173rd_guard_rifles_text","SourceString":"Gets +1 attack when your HQ takes damage.","LocalizedString":"Gets +1 attack when your HQ takes damage."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_173rd_guard_rifles_history","SourceString":"The 173rd Guard Rifles was a regiment of the 1st Division of the Soviet Red Army. The division was formed from units stationed in Moscow and during the course of WWII it was reformed a few times. In 1940 the division was redesignated 1st Motorized Division and in 1942 it was raised to guard status. The division fought at Stalingrad in 1942 and by the end of the year it was redesignated 58th Guards Rifle Division. In 1944 the division became part of the 70th Army of the 2nd Belorussian, and that same year it participated in the Lublin-Brest Offensive, followed by the advance into Poland where it fought at Gdynia. The division was briefly a part of the Group of Soviet Forces in Germany before being disbanded in July 1945.","LocalizedString":"The 173rd Guard Rifles was a regiment of the 1st Division of the Soviet Red Army. The division was formed from units stationed in Moscow and during the course of WWII it was reformed a few times. In 1940 the division was redesignated 1st Motorized Division and in 1942 it was raised to guard status. The division fought at Stalingrad in 1942 and by the end of the year it was redesignated 58th Guards Rifle Division. In 1944 the division became part of the 70th Army of the 2nd Belorussian, and that same year it participated in the Lublin-Brest Offensive, followed by the advance into Poland where it fought at Gdynia. The division was briefly a part of the Group of Soviet Forces in Germany before being disbanded in July 1945."},"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Legions","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardReceiveDamage"],"hasBlitz":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Small'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Small.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/Invasion/t_sov_inf_xx.t_sov_inf_xx","SubPathString":""},"artist":"Soviet WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/173rd_GUARD_RIFLES.173rd_GUARD_RIFLES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":342.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_173r