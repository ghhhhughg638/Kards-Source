{"format":"kards-original-reference","version":1,"id":"fb330c387f4b795f","name":"card_unit_39th_bologna","package":"/Game/Blueprints/Cards/Italy/units/card_unit_39th_bologna","parent":"UBaseCardObject","card":{"title":"39th BOLOGNA REGIMENT","text":"If in your hand, this unit costs 1 more each time you lose a unit.","flavorText":"During WWII the 39th Bologna Regiment was part of the 25th Infantry Division Bologna of the Italian Army. In 1941 the division was sent to Libya where it participated in the siege of Tobruk. In 1942 it was ordered to reinforce the El Alamein front, but lacking vehicles the troops had to march 400 miles, and after 46 days of marching the division reached the town of Alam el Halfa (south of El Alamein) where it linked up with the German-Italian Panzer Army in the Battle of Alam el Halfa, which ended in an Axis defeat. The division was forced to retreat and finally surrender to the Allies. Some detachments managed to escape to Tunisia and were merged to other units, but the remainder of the Bologna Division was officially dissolved in November 1942.","faction":"Italy","type":"infantry","rarity":"Rare","cost":3,"operationCost":2,"attack":3,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_39th_bologna","title":{"Namespace":"card_italy","Key":"card_unit_39th_bologna_title","SourceString":"39th BOLOGNA REGIMENT","LocalizedString":"39th BOLOGNA REGIMENT"},"Type":"ETypeEnum::infantry","attack":3,"defense":6,"range":1,"faction":"EFactionEnum::Italy","kredits":3,"Text":{"Namespace":"card_italy","Key":"card_unit_39th_bologna_text","SourceString":"If in your hand, this unit costs 1 more each time you lose a unit.","LocalizedString":"If in your hand, this unit costs 1 more each time you lose a unit."},"flavorText":{"Namespace":"card_italy","Key":"card_unit_39th_bologna_history","SourceString":"During WWII the 39th Bologna Regiment was part of the 25th Infantry Division Bologna of the Italian Army. In 1941 the division was sent to Libya where it participated in the siege of Tobruk. In 1942 it was ordered to reinforce the El Alamein front, but lacking vehicles the troops had to march 400 miles, and after 46 days of marching the division reached the town of Alam el Halfa (south of El Alamein) where it linked up with the German-Italian Panzer Army in the Battle of Alam el Halfa, which ended in an Axis defeat. The division was forced to retreat and finally surrender to the Allies. Some detachments managed to escape to Tunisia and were merged to other units, but the remainder of the Bologna Division was officially dissolved in November 1942.","LocalizedString":"During WWII the 39th Bologna Regiment was part of the 25th Infantry Division Bologna of the Italian Army. In 1941 the division was sent to Libya where it participated in the siege of Tobruk. In 1942 it was ordered to reinforce the El Alamein front, but lacking vehicles the troops had to march 400 miles, and after 46 days of marching the division reached the town of Alam el Halfa (south of El Alamein) where it linked up with the German-Italian Panzer Army in the Battle of Alam el Halfa, which ended in an Axis defeat. The division was forced to retreat and finally surrender to the Allies. Some detachments managed to escape to Tunisia and were merged to other units, but the remainder of the Bologna Division was officially dissolved in November 1942."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Expansion2019","isReserved":true,"usedTriggers":["ERegisteredCardFunction::OnOtherCardDestroyed"],"hasGuard":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion02'","ObjectPath":"kards/Content/StarterContent/Audio/Explosion02.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Italy/t_italian_bersaglieri.t_italian_bersaglieri","SubPathString":""},"artist":"Look and Learn","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/39th_BOLGNA_REGIMENT.39th_BOLGNA_REGIMENT","SubPathString":""},"historyPhotoSize":{"X