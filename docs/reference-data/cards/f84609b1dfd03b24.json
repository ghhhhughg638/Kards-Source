{"format":"kards-original-reference","version":1,"id":"f84609b1dfd03b24","name":"card_unit_15_aufklarungs","package":"/Game/Blueprints/Cards/Germany/CovertOp/units/card_unit_15_aufklarungs","parent":"UBaseCardObject","card":{"title":"15. AUFKLÄRUNG","text":"Deployment: Develop a German countermeasure.","flavorText":"The 15th Aufklärungs-Abteilung was a reconnaissance detachment of the 15th Infantry Division of the Wehrmacht during WWII. The division participated in the Invasion of Poland in 1939 and the Battle of France in 1940. In 1941 the 15th Division was transferred to the Eastern Front and fought with Army Group Centre in the Battle of Smolensk, and later that year against the Soviet Yelnya Offensive. The division participated in the Battle of Moscow but was withdrawn to France after heavy losses. In 1943 the 15th Division returned to the Eastern Front where it joined Army Group South in the Third Battle of Kharkov, and it kept fighting in Ukraine for the next several months before starting to retreat in front of the Soviet advance. In 1944 the division fought in Romania and was destroyed in the Second Jassy–Kishinev Offensive against the Soviet forces in August. The division was formed again in October 1944 and fought in Hungary as part of the Hungarian II Corps of 8th Army, but in 1945 it retreated into Czechoslovakia where it finally surrendered to the Soviet forces at the end of the war.","faction":"Germany","type":"infantry","rarity":"Common","cost":2,"operationCost":1,"attack":3,"defense":2},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.develop"],"Name":"card_unit_15_aufklarungs","title":{"Namespace":"card_germany","Key":"card_unit_15_aufklarungs_title","SourceString":"15. AUFKLÄRUNG","LocalizedString":"15. AUFKLÄRUNG"},"Type":"ETypeEnum::infantry","attack":3,"defense":2,"range":1,"faction":"EFactionEnum::Germany","kredits":2,"Text":{"Namespace":"card_germany","Key":"card_unit_15_aufklarungs_text","SourceString":"Deployment: Develop a German countermeasure.","LocalizedString":"Deployment: Develop a German countermeasure."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_15_aufklarungs_history","SourceString":"The 15th Aufklärungs-Abteilung was a reconnaissance detachment of the 15th Infantry Division of the Wehrmacht during WWII. The division participated in the Invasion of Poland in 1939 and the Battle of France in 1940. In 1941 the 15th Division was transferred to the Eastern Front and fought with Army Group Centre in the Battle of Smolensk, and later that year against the Soviet Yelnya Offensive. The division participated in the Battle of Moscow but was withdrawn to France after heavy losses. In 1943 the 15th Division returned to the Eastern Front where it joined Army Group South in the Third Battle of Kharkov, and it kept fighting in Ukraine for the next several months before starting to retreat in front of the Soviet advance. In 1944 the division fought in Romania and was destroyed in the Second Jassy–Kishinev Offensive against the Soviet forces in August. The division was formed again in October 1944 and fought in Hungary as part of the Hungarian II Corps of 8th Army, but in 1945 it retreated into Czechoslovakia where it finally surrendered to the Soviet forces at the end of the war.","LocalizedString":"The 15th Aufklärungs-Abteilung was a reconnaissance detachment of the 15th Infantry Division of the Wehrmacht during WWII. The division participated in the Invasion of Poland in 1939 and the Battle of France in 1940. In 1941 the 15th Division was transferred to the Eastern Front and fought with Army Group Centre in the Battle of Smolensk, and later that year against the Soviet Yelnya Offensive. The division participated in the Battle of Moscow but was withdrawn to France after heavy losses. In 1943 the 15th Division returned to the Eastern Front where it joined Army Group South in the Third Battle of Kharkov, and it kept fighting in Ukraine for the next several months before starting to retreat in front of the Soviet advance. In 1944 the division fought in Romania and was destroyed in the Second Jassy–Kishinev Offensive against the Soviet forces in August. The division was formed again in October 1944 and fought in Hungary as part of the Hungarian II Corps of 8th Army, but in 1945 it retreated into Czechoslovakia where it finally surrendered to the Soviet forces at the end of the war."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::CurrentExpansion","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Develop"],"hasDeployment":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/CandidateArtwork/Summer_24/t_15_aufklarungs.t_15_aufklarungs","SubPathString":""},"artist":"German WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/15__AUFKLARUNGS.15__AUFKLARUNGS","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":359.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_15_aufklarungs_photo","SourceString":"German infantry and tank advancing during the Third Battle of Kharkov, 1943.","LocalizedString":"German infantry and tank advancing during the Third Battle of Kharkov, 1943."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"PossibleCards","type":"TArray<UBaseCardObject*>","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_15_aufklarungs","owner":"card_unit_15_aufklarungs_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals