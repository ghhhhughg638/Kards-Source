{"format":"kards-original-reference","version":1,"id":"715a1365e89bee2a","name":"card_unit_macchi_c_200","package":"/Game/Blueprints/Cards/Italy/units/card_unit_macchi_c_200","parent":"UBaseCardObject","card":{"title":"MACCHI C.200","text":"Deployment: Gets +1+1 for each other friendly air unit.","flavorText":"The Macchi C.200 Saetta (\"Lightning\") was an Italian fighter aircraft in service in the Regia Aeronautica during WWII from its introduction in 1939. It was designed and manufactured by Aeronautica Macchi, featured an all-metal construction and was powered by a Fiat A.74 radial engine. The aircraft was considered reliable despite having limited speed compared to its Allied counterparts. Its agility and sturdy airframe made it effective in dogfights, even though it was lightly armed with two 12.7mm Breda-SAFAT machine guns, and early models had open cockpits (later enclosed). The C.200 operated across multiple theaters, including the Mediterranean, North Africa, the Balkans and the Eastern Front. It excelled in ground-attack roles and close air support thanks to its durability, but it struggled against faster, more heavily armed adversaries like the Spitfire. From 1941-42, it was gradually replaced by the improved C.202 Folgore. Despite its underpowered engine and modest armament, the Saetta was respected for its maneuverability and played a key role in Italy’s early wartime campaigns. It was considered the best early-war Italian fighter.","faction":"Italy","type":"fighter","rarity":"Common","cost":2,"operationCost":1,"attack":2,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_macchi_c_200","title":{"Namespace":"card_italy","Key":"card_unit_macchi_c_200_title","SourceString":"MACCHI C.200","LocalizedString":"MACCHI C.200"},"Type":"ETypeEnum::fighter","attack":2,"defense":2,"range":2,"faction":"EFactionEnum::Italy","kredits":2,"Text":{"Namespace":"card_italy","Key":"card_unit_macchi_c_200_text","SourceString":"Deployment: Gets +1+1 for each other friendly air unit.","LocalizedString":"Deployment: Gets +1+1 for each other friendly air unit."},"flavorText":{"Namespace":"card_italy","Key":"card_unit_macchi_c_200_history","SourceString":"The Macchi C.200 Saetta (\"Lightning\") was an Italian fighter aircraft in service in the Regia Aeronautica during WWII from its introduction in 1939. It was designed and manufactured by Aeronautica Macchi, featured an all-metal construction and was powered by a Fiat A.74 radial engine. The aircraft was considered reliable despite having limited speed compared to its Allied counterparts. Its agility and sturdy airframe made it effective in dogfights, even though it was lightly armed with two 12.7mm Breda-SAFAT machine guns, and early models had open cockpits (later enclosed). The C.200 operated across multiple theaters, including the Mediterranean, North Africa, the Balkans and the Eastern Front. It excelled in ground-attack roles and close air support thanks to its durability, but it struggled against faster, more heavily armed adversaries like the Spitfire. From 1941-42, it was gradually replaced by the improved C.202 Folgore. Despite its underpowered engine and modest armament, the Saetta was respected for its maneuverability and played a key role in Italy’s early wartime campaigns. It was considered the best early-war Italian fighter.","LocalizedString":"The Macchi C.200 Saetta (\"Lightning\") was an Italian fighter aircraft in service in the Regia Aeronautica during WWII from its introduction in 1939. It was designed and manufactured by Aeronautica Macchi, featured an all-metal construction and was powered by a Fiat A.74 radial engine. The aircraft was considered reliable despite having limited speed compared to its Allied counterparts. Its agility and sturdy airframe made it effective in dogfights, even though it was lightly armed with two 12.7mm Breda-SAFAT machine guns, and early models had open cockpits (later enclosed). The C.200 operated across multiple theaters, including the Mediterranean, North Africa, the Balkans and the Eastern Front. It excelled in ground-attack roles and close air support thanks to its durability, but it struggled against faster, more heavily armed adversaries like the Spitfire. From 1941-42, it was gradually replaced by the improved C.202 Folgore. Despite its underpowered engine and modest armament, the Saetta was respected for its maneuverability and played a key role in Italy’s early wartime campaigns. It was considered the best early-war Italian fighter."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::BloodAndIron","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Italy/Mini_Ally_Expansion_25/t_macchi_200.t_macchi_200","SubPathString":""},"artist":"Look and Learn","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/MACCHI_200.MACCHI_200","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":297.0},"historyPhotoDescription":{"Namespace":"card_italy","Key":"card_unit_macchi_c_200_photo","SourceString":"A Macchi C.200 Saetta in flight. Date unknown.","LocalizedString":"A Macchi C.200 Saetta in flight. Date unknown."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftS'","ObjectPath":"kards/Content/Effects/Explosions/Small/Aircraft/P_ExplosionAircraftS.119"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackFighter.BP_AttackFighter_C","SubPathString":""}},"variables":[{"name":"airUnits","type":"int32","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_macchi_c_200","owner":"card_unit_macchi_c_200_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","loca