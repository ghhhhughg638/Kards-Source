{"format":"kards-original-reference","version":1,"id":"98c0e0ceeca1c478","name":"card_unit_7_schutzen","package":"/Game/Blueprints/Cards/Germany/BrothersInArms/units/card_unit_7_schutzen","parent":"UBaseCardObject","card":{"title":"7. SCHÜTZEN","text":"Becomes Veteran when it attacks and destroys a unit.","flavorText":"The 7th Schützen Regiment was an infantry regiment of the 7th Panzer Division of the Wehrmacht during WWII. The division achieved notable victories in France in 1940 under Rommel's command, and later in the Soviet Union in 1941 under the command of Generalmajor Hans von Funck. However, in May 1942, it was withdrawn from the Soviet Union and sent back to France for replenishment and rearmament after suffering losses. Following the defeat at Stalingrad, the division returned to the Eastern Front and played a crucial role in defensive battles as part of Army Group Don, under General Erich von Manstein. It also participated in the counterattack at Kharkov. The 7th Panzer Division faced significant challenges during the unsuccessful offensive at Kursk in the summer of 1943, resulting in heavy casualties and equipment losses. The subsequent Soviet counteroffensive further weakened the division's strength. From 1944 to 1945, the division remained understrength and engaged in a series of defensive battles along the eastern front. It was forced to evacuate twice by sea, abandoning its remaining heavy equipment each time. After engaging in defensive actions across Prussia and Northern Germany, the surviving soldiers eventually sought refuge in the forest and surrendered to the British Army northwest of Berlin in May 1945.","faction":"Germany","type":"infantry","rarity":"Rare","cost":4,"operationCost":1,"attack":4,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_7_schutzen","title":{"Namespace":"card_germany","Key":"card_unit_7_schutzen_title","SourceString":"7. SCHÜTZEN","LocalizedString":"7. SCHÜTZEN"},"Type":"ETypeEnum::infantry","attack":4,"defense":5,"range":1,"faction":"EFactionEnum::Germany","kredits":4,"Text":{"Namespace":"card_germany","Key":"card_unit_7_schutzen_text","SourceString":"Becomes Veteran when it attacks and destroys a unit.","LocalizedString":"Becomes Veteran when it attacks and destroys a unit."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_7_schutzen_history","SourceString":"The 7th Schützen Regiment was an infantry regiment of the 7th Panzer Division of the Wehrmacht during WWII. The division achieved notable victories in France in 1940 under Rommel's command, and later in the Soviet Union in 1941 under the command of Generalmajor Hans von Funck. However, in May 1942, it was withdrawn from the Soviet Union and sent back to France for replenishment and rearmament after suffering losses. Following the defeat at Stalingrad, the division returned to the Eastern Front and played a crucial role in defensive battles as part of Army Group Don, under General Erich von Manstein. It also participated in the counterattack at Kharkov. The 7th Panzer Division faced significant challenges during the unsuccessful offensive at Kursk in the summer of 1943, resulting in heavy casualties and equipment losses. The subsequent Soviet counteroffensive further weakened the division's strength. From 1944 to 1945, the division remained understrength and engaged in a series of defensive battles along the eastern front. It was forced to evacuate twice by sea, abandoning its remaining heavy equipment each time. After engaging in defensive actions across Prussia and Northern Germany, the surviving soldiers eventually sought refuge in the forest and surrendered to the British Army northwest of Berlin in May 1945.","LocalizedString":"The 7th Schützen Regiment was an infantry regiment of the 7th Panzer Division of the Wehrmacht during WWII. The division achieved notable victories in France in 1940 under Rommel's command, and later in the Soviet Union in 1941 under the command of Generalmajor Hans von Funck. However, in May 1942, it was withdrawn from the Soviet Union and sent back to France for replenishment and rearmament after suffering losses. Following the defeat at Stalingrad, the division returned to the Eastern Front and played a crucial role in defensive battles as part of Army Group Don, under General Erich von Manstein. It also participated in the counterattack at Kharkov. The 7th Panzer Division faced significant challenges during the unsuccessful offensive at Kursk in the summer of 1943, resulting in heavy casualties and equipment losses. The subsequent Soviet counteroffensive further weakened the division's strength. From 1944 to 1945, the division remained understrength and engaged in a series of defensive battles along the eastern front. It was forced to evacuate twice by sea, abandoning its remaining heavy equipment each time. After engaging in defensive actions across Prussia and Northern Germany, the surviving soldiers eventually sought refuge in the forest and surrendered to the British Army northwest of Berlin in May 1945."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::BrothersInArms","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardDestroyed"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Veteran"],"draftBaseWeight":0.9,"hasBlitz":true,"spawnCardName":"card_unit_7_schutzen_vet","soundBlowUp":{"ObjectName":"SoundWave'Explosion02'","ObjectPath":"kards/Content/StarterContent/Audio/Explosion02.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/Spring2023Candidates/t_veteran_germs.t_veteran_germs","SubPathString":""},"artist":"Jarosław Wróbel","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/7__SCHUTZEN.7__SCHUTZEN","SubPathString":""},"historyPhotoSize":{"X":351.0,"Y":512.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_7_schutzen_photo","SourceString":"General Erwin Rommel and staff observe 7th Panzer Division practicing a river crossing at the Mosel, 1940.","LocalizedString":"General Erwin Rommel and staff observe 7th Panzer Division practicing a river crossing at the Mosel, 1940."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_7_schutzen","owner":"card_unit_7_schutzen_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"K2Node_Event_cardDestroyed","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_killer","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_TriggerNotDestroyed","type":"bool","direction":"in"},{"name":"K2Node_Event_destroyedLocation","type":"ECardLocationEnum","direction":"in"},{"name":"K2Node_Event_selfIsAlsoGettingDestroyed","type":"bool","direction":"in"},{"name":"K2Node_Event_destroyedInCombat","type":"bool","direction":"in"},{"name":"CallFunc_IsSideActive_active","type":"bool","direction":"in"},{"name":"CallFunc_IsUnit_isIt","type":"bool","direction":"in"},{"name":"CallFunc_EqualEqual_IntInt_ReturnValue","type":"bool","direction":"in"},{"name":"CallFunc_IsVeteran_isIt","type":"bool","direction":"in"},{"name":"CallFunc_BooleanAND_ReturnValue","type":"bool","direction":"in"},{"name":"CallFunc_BooleanAND_ReturnValue_1","type":"bool","direction":"in"},{"name":"CallFunc_MakeVeteran_qqq","type":"int32","direction":"in"},{"name":"CallFunc_GetOppositeSide_oppositeSide","type":"ESideEnum","direction":"in"},{"name":"CallFunc_GetLocationCardBySide_car