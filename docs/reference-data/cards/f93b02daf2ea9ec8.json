{"format":"kards-original-reference","version":1,"id":"f93b02daf2ea9ec8","name":"card_unit_17th_infantry_brigade","package":"/Game/Blueprints/Cards/ANZAC/units/card_unit_17th_infantry_brigade","parent":"UBaseCardObject","card":{"title":"17th INFANTRY BRIGADE","text":"Deployment: Deal 2 damage to a unit. If you do, draw a card if deployed from left-most in hand.","flavorText":"The 17th Infantry Brigade was part of the 6th Australian Division during WWII. It was raised in 1939 as part of the Second Australian Imperial Force, with its main battalions recruited in Victoria. After training in Australia, the brigade shipped to the Middle East in 1940 and first saw action in the Western Desert campaign. At Bardia, it supported the main assault, then helped capture Italian positions as the conflict moved through Tobruk, Barce and Marsa Brega. In 1941, the brigade was sent to Greece during the German invasion. Its battalions fought delaying actions near Larissa and Domokos before evacuation. Some men reached Crete, where the 2/7th Battalion took part in the fierce bayonet attack at 42nd Street alongside the Māori Battalion. The brigade later fought in the Syria-Lebanon campaign, including the advance toward Damour and Beirut. After Japan entered the war, the 17th Brigade was sent to the Pacific theater. In New Guinea, it fought at Wau, Mubo, Bobdubi, Lababia Ridge, Nassau Bay, and Mount Tambu during the Salamaua Lae campaign. Its final engagement  was the Aitape-Wewak campaign in 1944 and 1945.","faction":"Anzac","type":"infantry","rarity":"Rare","cost":2,"operationCost":1,"attack":3,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_17th_infantry_brigade","title":{"Namespace":"card_anzac","Key":"card_unit_17th_infantry_brigade_title","SourceString":"17th INFANTRY BRIGADE","LocalizedString":"17th INFANTRY BRIGADE"},"Type":"ETypeEnum::infantry","attack":3,"defense":2,"range":1,"faction":"EFactionEnum::Anzac","kredits":2,"Text":{"Namespace":"card_anzac","Key":"card_unit_17th_infantry_brigade_text","SourceString":"Deployment: Deal 2 damage to a unit. If you do, draw a card if deployed from left-most in hand.","LocalizedString":"Deployment: Deal 2 damage to a unit. If you do, draw a card if deployed from left-most in hand."},"flavorText":{"Namespace":"card_anzac","Key":"card_unit_17th_infantry_brigade_history","SourceString":"The 17th Infantry Brigade was part of the 6th Australian Division during WWII. It was raised in 1939 as part of the Second Australian Imperial Force, with its main battalions recruited in Victoria. After training in Australia, the brigade shipped to the Middle East in 1940 and first saw action in the Western Desert campaign. At Bardia, it supported the main assault, then helped capture Italian positions as the conflict moved through Tobruk, Barce and Marsa Brega. In 1941, the brigade was sent to Greece during the German invasion. Its battalions fought delaying actions near Larissa and Domokos before evacuation. Some men reached Crete, where the 2/7th Battalion took part in the fierce bayonet attack at 42nd Street alongside the Māori Battalion. The brigade later fought in the Syria-Lebanon campaign, including the advance toward Damour and Beirut. After Japan entered the war, the 17th Brigade was sent to the Pacific theater. In New Guinea, it fought at Wau, Mubo, Bobdubi, Lababia Ridge, Nassau Bay, and Mount Tambu during the Salamaua Lae campaign. Its final engagement  was the Aitape-Wewak campaign in 1944 and 1945.","LocalizedString":"The 17th Infantry Brigade was part of the 6th Australian Division during WWII. It was raised in 1939 as part of the Second Australian Imperial Force, with its main battalions recruited in Victoria. After training in Australia, the brigade shipped to the Middle East in 1940 and first saw action in the Western Desert campaign. At Bardia, it supported the main assault, then helped capture Italian positions as the conflict moved through Tobruk, Barce and Marsa Brega. In 1941, the brigade was sent to Greece during the German invasion. Its battalions fought delaying actions near Larissa and Domokos before evacuation. Some men reached Crete, where the 2/7th Battalion took part in the fierce bayonet attack at 42nd Street alongside the Māori Battalion. The brigade later fought in the Syria-Lebanon campaign, including the advance toward Damour and Beirut. After Japan entered the war, the 17th Brigade was sent to the Pacific theater. In New Guinea, it fought at Wau, Mubo, Bobdubi, Lababia Ridge, Nassau Bay, and Mount Tambu during the Salamaua Lae campaign. Its final engagement  was the Aitape-Wewak campaign in 1944 and 1945."},"operationCost":1,"rarity":"ERarityEnum::Rare","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::OceaniaStorm","isInPermanentPool":true,"hasDeployment":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/17th_INFANTRY_BRIGADE.17th_INFANTRY_BRIGADE","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_anzac","Key":"card_unit_17th_infantry_brigade_photo","SourceString":"Men of the 17th Infantry Brigade fighting around Khalde, Lebanon, 1941.","LocalizedString":"Men of the 17th Infantry Brigade fighting around Khalde, Lebanon, 1941."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"unitFound","type":"bool","direction":"in"}],"functions":[{"name":"CanPlayFromHand","owner":"card_unit_17th_infantry_brigade_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"ou