{"format":"kards-original-reference","version":1,"id":"4432f830aa48b6c5","name":"card_event_experimental_flight","package":"/Game/Blueprints/Cards/Japan/Breakthrough/events/card_event_experimental_flight","parent":"UBaseCardObject","card":{"title":"EXPERIMENTAL FLIGHT","text":"Choose and discard a card to add a random Japanese elite air unit to your hand.","flavorText":"The Nakajima Kikka (j. Orange Blossom) was Japan's first jet aircraft, and almost a copy of the Me 262. It was developed late in WWII and the first prototype had only flown once before the war ended. Another interesting aircraft was the J7W1 Shinden (Magnificent Lightning), a canard design with a pusher propeller and an estimated top speed of 466 miles per hour. Construction started in June 1944 and the prototype was ready 10 months later, but some problems with the engine and propeller delayed the flight tests until August, but by then Japan had surrendered. One design that saw limited use before the end of the war was the kamikaze Ohka Model 11, a manned rocket-powered flying bomb. It was designed to be carried beneath a Mitsubishi G4M Betty bomber until it was close to US fleets. Dropped from the bomber, the pilot of the Ohka would glide down, ignite the rocket engine, and dive into its target. Very few Ohkas ever made it near the US fleet as patrolling fighters shot down most of the G4M Betty bombers before they could get into range to launch their Ohkas.","faction":"Japan","type":"order","rarity":"Common","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_experimental_flight","title":{"Namespace":"card_japan","Key":"card_event_experimental_flight_title","SourceString":"EXPERIMENTAL FLIGHT","LocalizedString":"EXPERIMENTAL FLIGHT"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Japan","kredits":1,"Text":{"Namespace":"card_japan","Key":"card_event_experimental_flight_text","SourceString":"Choose and discard a card to add a random Japanese elite air unit to your hand.","LocalizedString":"Choose and discard a card to add a random Japanese elite air unit to your hand."},"flavorText":{"Namespace":"card_japan","Key":"card_event_experimental_flight_history","SourceString":"The Nakajima Kikka (j. Orange Blossom) was Japan's first jet aircraft, and almost a copy of the Me 262. It was developed late in WWII and the first prototype had only flown once before the war ended. Another interesting aircraft was the J7W1 Shinden (Magnificent Lightning), a canard design with a pusher propeller and an estimated top speed of 466 miles per hour. Construction started in June 1944 and the prototype was ready 10 months later, but some problems with the engine and propeller delayed the flight tests until August, but by then Japan had surrendered. One design that saw limited use before the end of the war was the kamikaze Ohka Model 11, a manned rocket-powered flying bomb. It was designed to be carried beneath a Mitsubishi G4M Betty bomber until it was close to US fleets. Dropped from the bomber, the pilot of the Ohka would glide down, ignite the rocket engine, and dive into its target. Very few Ohkas ever made it near the US fleet as patrolling fighters shot down most of the G4M Betty bombers before they could get into range to launch their Ohkas.","LocalizedString":"The Nakajima Kikka (j. Orange Blossom) was Japan's first jet aircraft, and almost a copy of the Me 262. It was developed late in WWII and the first prototype had only flown once before the war ended. Another interesting aircraft was the J7W1 Shinden (Magnificent Lightning), a canard design with a pusher propeller and an estimated top speed of 466 miles per hour. Construction started in June 1944 and the prototype was ready 10 months later, but some problems with the engine and propeller delayed the flight tests until August, but by then Japan had surrendered. One design that saw limited use before the end of the war was the kamikaze Ohka Model 11, a manned rocket-powered flying bomb. It was designed to be carried beneath a Mitsubishi G4M Betty bomber until it was close to US fleets. Dropped from the bomber, the pilot of the Ohka would glide down, ignite the rocket engine, and dive into its target. Very few Ohkas ever made it near the US fleet as patrolling fighters shot down most of the G4M Betty bombers before they could get into range to launch their Ohkas."},"rarity":"ERarityEnum::Common","waitWithOnOtherCardPlayedUntilHandTargetSelected":true,"selectHandCardNotifyText":{"Namespace":"","Key":"049D61AB4EE3B893B582ED8FAD33C86A","SourceString":"Choose a card in hand to discard","LocalizedString":"Choose a card in hand to discard"},"cardSet":"ECardSetEnum::Breakthrough","isReserved":true,"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Taiko_Hits_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Taiko_Hits_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/CandidateArtwork/WE_Candidates/t_experimental_flight.t_experimental_flight","SubPathString":""},"artist":"Pit-Road","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/EXPERIMENTAL_FLIGHT.EXPERIMENTAL_FLIGHT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":378.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_event_experimental_flight_photo","SourceString":"The Kyushu J7W1 Shinden (Magnificent Lightning) on the ground, ca. 1945.","LocalizedString":"The Kyushu J7W1 Shinden (Magnificent Lightning) on the ground, ca. 1945."},"isDraw":true,"isDefenseBuff":true},"variables":[{"name":"possibleCards","type":"TArray<UBaseCardObject*>","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_experimental_flight","owner":"card_event_experimental_flight_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"K2Node_Event_targetCard","type":"UBaseCardObje