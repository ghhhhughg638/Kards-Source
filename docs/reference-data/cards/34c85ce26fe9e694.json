{"format":"kards-original-reference","version":1,"id":"34c85ce26fe9e694","name":"card_event_by_the_sword","package":"/Game/Blueprints/Cards/Soviet/Breakthrough/events/card_event_by_the_sword","parent":"UBaseCardObject","card":{"title":"BY THE SWORD","text":"Draw cards equal to the number of enemy units on the battlefield.","flavorText":"\"Whoever comes to us with a sword will die by the sword!\" is a quote attributed to Alexander Nevsky (1221- 1263), the Novgorod prince, who allegedly uttered this phrase when his enemies begged for peace after being defeated in battle. There is no evidence that this phrase was ever uttered by the prince, but since the 18th century Alexander Nevsky has been the symbol of the defender of Russia and Eisenstein's film about him that premiered in 1941, when the Great Patriotic War had begun, gave new life to this image. The film had such a strong influence on public consciousness that the Order of Alexander Nevsky was established in 1942 and the Novgorod prince became a central theme of Russia’s heroic past in war Soviet propaganda.","faction":"Soviet","type":"order","rarity":"Rare","cost":4,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_by_the_sword","title":{"Namespace":"card_soviet","Key":"card_event_by_the_sword_title","SourceString":"BY THE SWORD","LocalizedString":"BY THE SWORD"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Soviet","kredits":4,"Text":{"Namespace":"card_soviet","Key":"card_event_by_the_sword_text","SourceString":"Draw cards equal to the number of enemy units on the battlefield.","LocalizedString":"Draw cards equal to the number of enemy units on the battlefield."},"flavorText":{"Namespace":"card_soviet","Key":"card_event_by_the_sword_history","SourceString":"\"Whoever comes to us with a sword will die by the sword!\" is a quote attributed to Alexander Nevsky (1221- 1263), the Novgorod prince, who allegedly uttered this phrase when his enemies begged for peace after being defeated in battle. There is no evidence that this phrase was ever uttered by the prince, but since the 18th century Alexander Nevsky has been the symbol of the defender of Russia and Eisenstein's film about him that premiered in 1941, when the Great Patriotic War had begun, gave new life to this image. The film had such a strong influence on public consciousness that the Order of Alexander Nevsky was established in 1942 and the Novgorod prince became a central theme of Russia’s heroic past in war Soviet propaganda.","LocalizedString":"\"Whoever comes to us with a sword will die by the sword!\" is a quote attributed to Alexander Nevsky (1221- 1263), the Novgorod prince, who allegedly uttered this phrase when his enemies begged for peace after being defeated in battle. There is no evidence that this phrase was ever uttered by the prince, but since the 18th century Alexander Nevsky has been the symbol of the defender of Russia and Eisenstein's film about him that premiered in 1941, when the Great Patriotic War had begun, gave new life to this image. The film had such a strong influence on public consciousness that the Order of Alexander Nevsky was established in 1942 and the Novgorod prince became a central theme of Russia’s heroic past in war Soviet propaganda."},"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Breakthrough","isInPermanentPool":true,"soundEnterPlay":{"ObjectName":"SoundWave'Patriotic_Push'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Patriotic_Push.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/WE_Candidates/t_by_the_sword.t_by_the_sword","SubPathString":""},"artist":"Soviet WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/BY_THE_SWORD.BY_THE_SWORD","SubPathString":""},"historyPhotoSize":{"X":370.0,"Y":512.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_event_by_the_sword_photo","SourceString":"Amet-khan Sultan, a highly decorated flying ace. The Order of Alexander Nevsky can be seen bottom right on the picture.","LocalizedString":"Amet-khan Sultan, a highly decorated flying ace. The Order of Alexander Nevsky can be seen bottom right on the picture."},"isAttackBuff":true,"isDefenseBuff":true},"variables":[{"name":"count","type":"int32","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_by_the_sword","owner":"card_event_by_the_sword_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue_1","type":"int32","direction":"in"},{"name":"CallFunc_Greater_IntInt_ReturnValue","type":"bool","direction":"in"},{"name":"CallFunc_DrawCardsFromDeckbySide_cardsIDs","type":"TArray<int32>","direction":"in"},{"name":"CallFunc_GetAllCardsOnBoard_cards","type":"TArray<UBaseCardObject*>","direction":"in"},{"name":"Temp_int_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Array_Get_Item","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_IsUnit_isIt","type":"bool","direction":"in"},{"name":"CallFunc_NotEqual_ByteByte_ReturnValue","type":"bool","direction":"in"},{"name":"CallFunc_BooleanAND_ReturnValue","type":"bool","direction":"in"},{"name":"CallFunc_Array_Length_ReturnValue","type":"int32","direction":"in"},{"name":"CallFunc_Less_IntInt_ReturnValue","type":"bool","direction":"in"}],"body":[{"op":"PushExecutionFlow","at":0,"to":763},{"op":"ComputedJump","at":5,"value":{"op":"Variable","name":"EntryPoint","type":"int32","scope":"local","sourceOp":"LocalVariable"}},{"op":"PushExecutionFlow","at":15,"to":325},{"op":"Context","at":20,