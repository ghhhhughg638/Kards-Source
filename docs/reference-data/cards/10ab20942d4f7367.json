{"format":"kards-original-reference","version":1,"id":"10ab20942d4f7367","name":"card_unit_infantry_regiment_36","package":"/Game/Blueprints/Cards/Finland/units/card_unit_infantry_regiment_36","parent":"UBaseCardObject","card":{"title":"INFANTRY REGIMENT 36","text":"Deployment: Draw a card. Discard it at the end of your next turn.","flavorText":"The 36th Infantry Regiment was a unit of the 12th Division of the Finnish Army. The division fought in the Winter War (1939–1940) and the Continuation War (1941–1944). It is most famously associated with the Battle of Kollaa in 1940 which was a pivotal engagement in the Winter War. The division was tasked with defending the Kollaa River region in Ladoga Karelia and it managed to repel repeated Soviet assaults despite severe numerical and material disadvantages. It is worth noting that the legendary Finnish sniper Simo Häyhä, nicknamed \"The White Death\", would see his first battle on the Kollaa front. After the Winter War, the 12th Division was re-formed in 1941 from the 3rd Brigade and integrated into Finland’s offensive operations during the Continuation War, where it fought alongside Germany against the Soviet Union. The division’s activities at this time are less well known, but it remained part of Finland’s order of battle until the armistice with the Soviet Union in 1944.","faction":"Finland","type":"infantry","rarity":"Common","cost":3,"operationCost":1,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_infantry_regiment_36","title":{"Namespace":"card_finland","Key":"card_unit_infantry_regiment_36_title","SourceString":"INFANTRY REGIMENT 36","LocalizedString":"INFANTRY REGIMENT 36"},"Type":"ETypeEnum::infantry","attack":3,"defense":3,"range":1,"faction":"EFactionEnum::Finland","kredits":3,"Text":{"Namespace":"card_finland","Key":"card_unit_infantry_regiment_36_text","SourceString":"Deployment: Draw a card. Discard it at the end of your next turn.","LocalizedString":"Deployment: Draw a card. Discard it at the end of your next turn."},"flavorText":{"Namespace":"card_finland","Key":"card_unit_infantry_regiment_36_history","SourceString":"The 36th Infantry Regiment was a unit of the 12th Division of the Finnish Army. The division fought in the Winter War (1939–1940) and the Continuation War (1941–1944). It is most famously associated with the Battle of Kollaa in 1940 which was a pivotal engagement in the Winter War. The division was tasked with defending the Kollaa River region in Ladoga Karelia and it managed to repel repeated Soviet assaults despite severe numerical and material disadvantages. It is worth noting that the legendary Finnish sniper Simo Häyhä, nicknamed \"The White Death\", would see his first battle on the Kollaa front. After the Winter War, the 12th Division was re-formed in 1941 from the 3rd Brigade and integrated into Finland’s offensive operations during the Continuation War, where it fought alongside Germany against the Soviet Union. The division’s activities at this time are less well known, but it remained part of Finland’s order of battle until the armistice with the Soviet Union in 1944.","LocalizedString":"The 36th Infantry Regiment was a unit of the 12th Division of the Finnish Army. The division fought in the Winter War (1939–1940) and the Continuation War (1941–1944). It is most famously associated with the Battle of Kollaa in 1940 which was a pivotal engagement in the Winter War. The division was tasked with defending the Kollaa River region in Ladoga Karelia and it managed to repel repeated Soviet assaults despite severe numerical and material disadvantages. It is worth noting that the legendary Finnish sniper Simo Häyhä, nicknamed \"The White Death\", would see his first battle on the Kollaa front. After the Winter War, the 12th Division was re-formed in 1941 from the 3rd Brigade and integrated into Finland’s offensive operations during the Continuation War, where it fought alongside Germany against the Soviet Union. The division’s activities at this time are less well known, but it remained part of Finland’s order of battle until the armistice with the Soviet Union in 1944."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::BloodAndIron","isInPermanentPool":true,"usedTriggers":["ERegisteredCardFunction::OnEndOfTurn","ERegisteredCardFunction::OnOtherCardReset"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"draftBaseWeight":0.8,"suppressionExceptionTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"hasDeployment":true,"hasBlitz":true,"hasShock":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Finland/Mini_Ally_Expansion_25/t_infantry_regiment_36.t_infantry_regiment_36","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/INFANTRY_REGIMENT_36.INFANTRY_REGIMENT_36","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":288.0},"historyPhotoDescription":{"Namespace":"card_finland","Key":"card_unit_infantry_regiment_36_photo","SourceString":"Finnish soldiers of the 12th Division during the Battle of Kollaa in 1940.","LocalizedString":"Finnish soldiers of the 12th Division during the Battle of Kollaa in 1940."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"drawnCard","type":"int32","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_infantry_regiment_36","owner":"card_unit_infantry_regiment_36_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","loca