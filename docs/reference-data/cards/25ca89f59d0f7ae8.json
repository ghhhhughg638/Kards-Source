{"format":"kards-original-reference","version":1,"id":"25ca89f59d0f7ae8","name":"card_event_deep_operation","package":"/Game/Blueprints/Cards/Soviet/Legions/events/card_event_deep_operation","parent":"UBaseCardObject","card":{"title":"DEEP OPERATION","text":"Add two LIGHT INFANTRY to your hand, then give all such units in hand Blitz.","flavorText":"Deep Operation, or Soviet Deep Battle, was a military theory that was developed by the Soviet Union in the 1920s and 1930s.  In short, the Deep Operations doctrine is to exploit the depths of the battlefield and is achieved through using overwhelming superiority of men and material, and whatever the costs, find the weakest points in the enemy's territory and move all reserve units to these sectors. Before the war the Soviet military had abandoned the deep battle concept, but they relearned it and started to apply it during the strategic offensive at Stalingrad. After that, deep operation was used with a devastating effect.","faction":"Soviet","type":"order","rarity":"Uncommon","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_deep_operation","title":{"Namespace":"card_soviet","Key":"card_event_deep_operation_title","SourceString":"DEEP OPERATION","LocalizedString":"DEEP OPERATION"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Soviet","kredits":2,"Text":{"Namespace":"card_soviet","Key":"card_event_deep_operation_text","SourceString":"Add two LIGHT INFANTRY to your hand, then give all such units in hand Blitz.","LocalizedString":"Add two LIGHT INFANTRY to your hand, then give all such units in hand Blitz."},"flavorText":{"Namespace":"card_soviet","Key":"card_event_deep_operation_history","SourceString":"Deep Operation, or Soviet Deep Battle, was a military theory that was developed by the Soviet Union in the 1920s and 1930s.  In short, the Deep Operations doctrine is to exploit the depths of the battlefield and is achieved through using overwhelming superiority of men and material, and whatever the costs, find the weakest points in the enemy's territory and move all reserve units to these sectors. Before the war the Soviet military had abandoned the deep battle concept, but they relearned it and started to apply it during the strategic offensive at Stalingrad. After that, deep operation was used with a devastating effect.","LocalizedString":"Deep Operation, or Soviet Deep Battle, was a military theory that was developed by the Soviet Union in the 1920s and 1930s.  In short, the Deep Operations doctrine is to exploit the depths of the battlefield and is achieved through using overwhelming superiority of men and material, and whatever the costs, find the weakest points in the enemy's territory and move all reserve units to these sectors. Before the war the Soviet military had abandoned the deep battle concept, but they relearned it and started to apply it during the strategic offensive at Stalingrad. After that, deep operation was used with a devastating effect."},"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Legions","returnSet":"ECardSetEnum::OceaniaStorm","usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Blitz"],"spawnCardName":"card_unit_light_infantry","soundEnterPlay":{"ObjectName":"SoundWave'October_Red'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/October_Red.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/Invasion/t_deep_operation.t_deep_operation","SubPathString":""},"artist":"Nicolas Trudgian","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/DEEP_OPERATION.DEEP_OPERATION","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":345.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_event_deep_operation_photo","SourceString":"Red Army soldiers during the Battle of Stalingrad, ca. 1942-43.","LocalizedString":"Red Army soldiers during the Battle of Stalingrad, ca. 1942-43."},"