{"format":"kards-original-reference","version":1,"id":"ca1380df08806bab","name":"card_event_salpa_line","package":"/Game/Blueprints/Cards/Finland/events/card_event_salpa_line","parent":"UBaseCardObject","card":{"title":"SALPA LINE","text":"Add a SISSI to your support line, then give all your SISSI units +3 defense.","flavorText":"The Salpa Line was Finland’s great eastern defensive line, built after the Winter War to guard against a possible new Soviet invasion. Its official name was Suomen Salpa, meaning Finland’s latch. Construction began in 1940 during the Interim Peace, the period between the Winter War and the Continuation War, first with volunteers and then with men who were not eligible for front line service. At its peak in 1941, about 35,000 workers were involved. The line stretched over roughly 1,200 kilometres from the Gulf of Finland to Petsamo. Its strongest section laid between the Gulf of Finland and the Lake Saimaa waterway system, where lakes, marshes, islands, rivers and rocky ground were built into the defence plan. The fortifications included 728 concrete installations, 315 kilometres of wire obstacles, 225 kilometres of anti-tank obstacles, 130 kilometres of anti-tank ditches, more than 3,000 entrenchments, and 254 concrete infantry shelters. Work stopped after the Continuation War began, but resumed in 1944 as the front moved closer to Finland’s old borders. The Salpa Line was never tested in battle, since the Soviet offensive was stopped farther east, but its existence strengthened Finland’s position in the peace talks.","faction":"Finland","type":"order","rarity":"Common","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_salpa_line","title":{"Namespace":"card_finland","Key":"card_event_salpa_line_title","SourceString":"SALPA LINE","LocalizedString":"SALPA LINE"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Finland","kredits":2,"Text":{"Namespace":"card_finland","Key":"card_event_salpa_line_text","SourceString":"Add a SISSI to your support line, then give all your SISSI units +3 defense.","LocalizedString":"Add a SISSI to your support line, then give all your SISSI units +3 defense."},"flavorText":{"Namespace":"card_finland","Key":"card_event_salpa_line_history","SourceString":"The Salpa Line was Finland’s great eastern defensive line, built after the Winter War to guard against a possible new Soviet invasion. Its official name was Suomen Salpa, meaning Finland’s latch. Construction began in 1940 during the Interim Peace, the period between the Winter War and the Continuation War, first with volunteers and then with men who were not eligible for front line service. At its peak in 1941, about 35,000 workers were involved. The line stretched over roughly 1,200 kilometres from the Gulf of Finland to Petsamo. Its strongest section laid between the Gulf of Finland and the Lake Saimaa waterway system, where lakes, marshes, islands, rivers and rocky ground were built into the defence plan. The fortifications included 728 concrete installations, 315 kilometres of wire obstacles, 225 kilometres of anti-tank obstacles, 130 kilometres of anti-tank ditches, more than 3,000 entrenchments, and 254 concrete infantry shelters. Work stopped after the Continuation War began, but resumed in 1944 as the front moved closer to Finland’s old borders. The Salpa Line was never tested in battle, since the Soviet offensive was stopped farther east, but its existence strengthened Finland’s position in the peace talks.","LocalizedString":"The Salpa Line was Finland’s great eastern defensive line, built after the Winter War to guard against a possible new Soviet invasion. Its official name was Suomen Salpa, meaning Finland’s latch. Construction began in 1940 during the Interim Peace, the period between the Winter War and the Continuation War, first with volunteers and then with men who were not eligible for front line service. At its peak in 1941, about 35,000 workers were involved. The line stretched over roughly 1,200 kilometres from the Gulf of Finland to Petsamo. Its strongest section laid between the Gulf of Finland and the Lake Saimaa waterway system, where lakes, marshes, islands, rivers and rocky ground were built into the defence plan. The fortifications included 728 concrete installations, 315 kilometres of wire obstacles, 225 kilometres of anti-tank obstacles, 130 kilometres of anti-tank ditches, more than 3,000 entrenchments, and 254 concrete infantry shelters. Work stopped after the Continuation War began, but resumed in 1944 as the front moved closer to Finland’s old borders. The Salpa Line was never tested in battle, since the Soviet offensive was stopped farther east, but its existence strengthened Finland’s position in the peace talks."},"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::OceaniaStorm","spawnCardName":"card_unit_sissi","soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/SALPA_LINE.SALPA_LINE","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_finland","Key":"card_event_salpa_line_photo","SourceString":"Finnish engineers working on the construction of the Salpa Line in 1942.","LocalizedString":"Finnish engineers working on the construction of the Salpa Line in 1942."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"Notes":"Image needed to be customized","isDefenseBuff":true},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_event_salpa_line","owner":"card_event_salpa_line_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name