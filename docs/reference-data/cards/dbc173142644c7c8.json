{"format":"kards-original-reference","version":1,"id":"dbc173142644c7c8","name":"card_unit_magnificent_seven","package":"/Game/Blueprints/Cards/USA/Homefront/units/card_unit_magnificent_seven","parent":"UBaseCardObject","card":{"title":"MAGNIFICENT SEVENTH","text":"When this unit attacks, the top unit of your deck gets +1+1.","flavorText":"Nicknamed the “Magnificent Seventh”, the 7th Marine Regiment earned a fierce reputation during WWII as part of the US 1st Marine Division. Reactivated in early 1941, the regiment first deployed to Samoa before arriving on Guadalcanal in September 1942. Over four months of brutal combat, the 7th Marines fought in 42 engagements and killed over 6,000 Japanese soldiers. Many Marines fell to disease, fatigue, and wounds, yet the unit held its ground against repeated attacks. After Guadalcanal, the regiment continued its campaign across the Pacific, seeing action in New Guinea and New Britain before landing on Peleliu in September 1944. The battle became one of the bloodiest in Marine Corps history. In 1945, the 7th Marines landed on Okinawa, where they took Dakeshi Ridge and Wana Ridge at heavy cost. These battles, marked by stubborn Japanese resistance and grueling terrain, resulted in over 1,200 casualties. By the end of the war, the regiment had been involved in some of the most intense fighting in the Pacific. Its experience reflected the high toll that extended amphibious operations imposed on US forces.","faction":"USA","type":"infantry","rarity":"Common","cost":2,"operationCost":1,"attack":2,"defense":4},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.bond"],"Name":"card_unit_magnificent_seven","title":{"Namespace":"card_usa","Key":"card_unit_magnificent_seven_title","SourceString":"MAGNIFICENT SEVENTH","LocalizedString":"MAGNIFICENT SEVENTH"},"Type":"ETypeEnum::infantry","attack":2,"defense":4,"range":1,"faction":"EFactionEnum::USA","kredits":2,"Text":{"Namespace":"card_usa","Key":"card_unit_magnificent_seven_text","SourceString":"When this unit attacks, the top unit of your deck gets +1+1.","LocalizedString":"When this unit attacks, the top unit of your deck gets +1+1."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_magnificent_seven_history","SourceString":"Nicknamed the “Magnificent Seventh”, the 7th Marine Regiment earned a fierce reputation during WWII as part of the US 1st Marine Division. Reactivated in early 1941, the regiment first deployed to Samoa before arriving on Guadalcanal in September 1942. Over four months of brutal combat, the 7th Marines fought in 42 engagements and killed over 6,000 Japanese soldiers. Many Marines fell to disease, fatigue, and wounds, yet the unit held its ground against repeated attacks. After Guadalcanal, the regiment continued its campaign across the Pacific, seeing action in New Guinea and New Britain before landing on Peleliu in September 1944. The battle became one of the bloodiest in Marine Corps history. In 1945, the 7th Marines landed on Okinawa, where they took Dakeshi Ridge and Wana Ridge at heavy cost. These battles, marked by stubborn Japanese resistance and grueling terrain, resulted in over 1,200 casualties. By the end of the war, the regiment had been involved in some of the most intense fighting in the Pacific. Its experience reflected the high toll that extended amphibious operations imposed on US forces.","LocalizedString":"Nicknamed the “Magnificent Seventh”, the 7th Marine Regiment earned a fierce reputation during WWII as part of the US 1st Marine Division. Reactivated in early 1941, the regiment first deployed to Samoa before arriving on Guadalcanal in September 1942. Over four months of brutal combat, the 7th Marines fought in 42 engagements and killed over 6,000 Japanese soldiers. Many Marines fell to disease, fatigue, and wounds, yet the unit held its ground against repeated attacks. After Guadalcanal, the regiment continued its campaign across the Pacific, seeing action in New Guinea and New Britain before landing on Peleliu in September 1944. The battle became one of the bloodiest in Marine Corps history. In 1945, the 7th Marines landed on Okinawa, where they took Dakeshi Ridge and Wana Ridge at heavy cost. These battles, marked by stubborn Japanese resistance and grueling terrain, resulted in over 1,200 casualties. By the end of the war, the regiment had been involved in some of the most intense fighting in the Pacific. Its experience reflected the high toll that extended amphibious operations imposed on US forces."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Trigger","hasBlitz":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/MAGNIFICENT_SEVEN.MAGNIFICENT_SEVEN","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_magnificent_seven_photo","SourceString":"Two soldiers of the 7th Infantry Division on Okinawa, 1 April 1945.","LocalizedString":"Two soldiers of the 7th Infantry Division on Okinawa, 1 April 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"unitOnTop","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_magnificent_seven","owner":"card_unit_magnificent_seven_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_bool_True_if_break_was_hit_Variable","type":"bool","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","dire