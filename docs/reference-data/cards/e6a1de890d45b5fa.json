{"format":"kards-original-reference","version":1,"id":"e6a1de890d45b5fa","name":"card_unit_oxford","package":"/Game/Blueprints/Cards/Britain/WorldAtWar/units/card_unit_oxford","parent":"UBaseCardObject","card":{"title":"OXFORD","text":"When you deploy or add a Guard unit, give it +1+3.","flavorText":"The Airspeed Oxford, nicknamed “Ox-box”, was a British twin engined monoplane that was used to train British Commonwealth aircrews during WWII and after. The aircraft was mainly used to prepare bomber aircrews for combat and it could simultanously train pilots, bomb aimers, navigators, gunners and radio operators. Although the Oxford was mostly used as a trainer during the war it provided valuable service as an air ambulance, in anti-submarine roles, in communications and for anti-aircraft cooperation duties. A total of 8,751 aircraft were built, including a few variants, and a great number of them were converted for civilian transportation after the war.","faction":"Britain","type":"fighter","rarity":"Unique","cost":2,"operationCost":1,"attack":1,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_oxford","title":{"Namespace":"card_britain","Key":"card_unit_oxford_title","SourceString":"OXFORD","LocalizedString":"OXFORD"},"Type":"ETypeEnum::fighter","attack":1,"defense":3,"range":2,"faction":"EFactionEnum::Britain","kredits":2,"Text":{"Namespace":"card_britain","Key":"card_unit_oxford_text","SourceString":"When you deploy or add a Guard unit, give it +1+3.","LocalizedString":"When you deploy or add a Guard unit, give it +1+3."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_oxford_history","SourceString":"The Airspeed Oxford, nicknamed “Ox-box”, was a British twin engined monoplane that was used to train British Commonwealth aircrews during WWII and after. The aircraft was mainly used to prepare bomber aircrews for combat and it could simultanously train pilots, bomb aimers, navigators, gunners and radio operators. Although the Oxford was mostly used as a trainer during the war it provided valuable service as an air ambulance, in anti-submarine roles, in communications and for anti-aircraft cooperation duties. A total of 8,751 aircraft were built, including a few variants, and a great number of them were converted for civilian transportation after the war.","LocalizedString":"The Airspeed Oxford, nicknamed “Ox-box”, was a British twin engined monoplane that was used to train British Commonwealth aircrews during WWII and after. The aircraft was mainly used to prepare bomber aircrews for combat and it could simultanously train pilots, bomb aimers, navigators, gunners and radio operators. Although the Oxford was mostly used as a trainer during the war it provided valuable service as an air ambulance, in anti-submarine roles, in communications and for anti-aircraft cooperation duties. A total of 8,751 aircraft were built, including a few variants, and a great number of them were converted for civilian transportation after the war."},"operationCost":1,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::WorldAtWar","returnSet":"ECardSetEnum::NavalWarfare","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardEnterPlay"],"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/CandidateArtwork/t_oxford.t_oxford","SubPathString":""},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/OXFORD.OXFORD","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":391.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_unit_oxford_photo","SourceString":"A formation of Oxford air ambulances in flight during WWII.","LocalizedString":"A formation of Oxford air ambulances in flight during WWII."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftL'","ObjectPath":"kards/Content/Effe