{"format":"kards-original-reference","version":1,"id":"fed3ce2671be60e5","name":"card_unit_654_rifles","package":"/Game/Blueprints/Cards/Soviet/BloodIron/units/card_unit_654_rifles","parent":"UBaseCardObject","card":{"title":"654th RIFLES","text":"Deployment: Add a T-70 to your support line. Give it Shock.","flavorText":"The 654th Infantry Rifle Regiment was part of the 148th Rifle Division. It took part in some of the largest offensives from 1943 until the end of the war. The division fought heavily around Voronezh and then in the northern part of the Kursk salient. It was involved in heavy fighting and a battle of attrition around the train station at Ponyri. Following this, it crossed the Dnieper river and went on to participate in the 1944 summer offensive, during which it liberated Lviv. In the final stages of the war it took part in the Berlin strategic offensive operation and in the liberation of Prague.","faction":"Soviet","type":"infantry","rarity":"Common","cost":4,"operationCost":1,"attack":2,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_654_rifles","title":{"Namespace":"card_soviet","Key":"card_unit_654_rifles_title","SourceString":"654th RIFLES","LocalizedString":"654th RIFLES"},"Type":"ETypeEnum::infantry","attack":2,"defense":4,"range":1,"faction":"EFactionEnum::Soviet","kredits":4,"Text":{"Namespace":"card_soviet","Key":"card_unit_654_rifles_text","SourceString":"Deployment: Add a T-70 to your support line. Give it Shock.","LocalizedString":"Deployment: Add a T-70 to your support line. Give it Shock."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_654_rifles_history","SourceString":"The 654th Infantry Rifle Regiment was part of the 148th Rifle Division. It took part in some of the largest offensives from 1943 until the end of the war. The division fought heavily around Voronezh and then in the northern part of the Kursk salient. It was involved in heavy fighting and a battle of attrition around the train station at Ponyri. Following this, it crossed the Dnieper river and went on to participate in the 1944 summer offensive, during which it liberated Lviv. In the final stages of the war it took part in the Berlin strategic offensive operation and in the liberation of Prague.","LocalizedString":"The 654th Infantry Rifle Regiment was part of the 148th Rifle Division. It took part in some of the largest offensives from 1943 until the end of the war. The division fought heavily around Voronezh and then in the northern part of the Kursk salient. It was involved in heavy fighting and a battle of attrition around the train station at Ponyri. Following this, it crossed the Dnieper river and went on to participate in the 1944 summer offensive, during which it liberated Lviv. In the final stages of the war it took part in the Berlin strategic offensive operation and in the liberation of Prague."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::BloodAndIron","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"hasShock":true,"spawnCardName":"card_unit_t_70","Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/Winter_2024/t_soviet_infantry_y_blood_and_iron.t_soviet_infantry_y_blood_and_iron","SubPathString":""},"artist":"Soviet WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/654th_RIFLES.654th_RIFLES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":316.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_654_rifles_photo","SourceString":"Soviet troops on a T-70 tank passing a knocked out Panzer IV during the Battle of Kursk.","LocalizedString":"Soviet troops on a T-70 tank passing a knocked out Panzer IV during the Battle of Kursk."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionArmourS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionArmourS.31"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLig