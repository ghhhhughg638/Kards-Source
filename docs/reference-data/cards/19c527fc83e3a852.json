{"format":"kards-original-reference","version":1,"id":"19c527fc83e3a852","name":"card_unit_5th_sasebo_snlf","package":"/Game/Blueprints/Cards/Japan/NavalWarfare/units/card_unit_5th_sasebo_snlf","parent":"UBaseCardObject","card":{"title":"5th SASEBO SNLF","text":"Gets +1+1 when you play a Navy card.\r\nDestruction: Shuffle your deck, then draw a card.","flavorText":"The 5th Sasebo Special Naval Landing Force (SNLF) was an elite infantry battalion of the Imperial Japanese Navy, formed at the Sasebo Naval District. As part of Japan’s marine infantry, the unit specialized in amphibious assaults and jungle warfare during WWII. In 1942, the 5th Sasebo SNLF took part in the invasion of Buna–Gona in Papua New Guinea. They landed as part of the Yokoyama Advance Force, supporting the Japanese push along the Kokoda Track toward Port Moresby. Approximately 450 troops from the unit were deployed in this operation. Later that year, during Operation Re, the 5th Sasebo SNLF participated in the Battle of Milne Bay. They were part of a 1,500-strong force that included units from the 3rd and 5th Kure SNLF and the 5th Yokosuka SNLF. The operation faced strong resistance from well-prepared Allied forces.The 5th Sasebo SNLF earned a reputation for their tenacity and discipline, often fighting to the last man. Their actions in New Guinea exemplified the aggressive tactics and high morale characteristic of Japan’s naval infantry during the early Pacific campaigns.","faction":"Japan","type":"infantry","rarity":"Rare","cost":1,"operationCost":0,"attack":1,"defense":1},"defaults":{"UberGraphFrame":{},"Name":"card_unit_5th_sasebo_snlf","title":{"Namespace":"card_japan","Key":"card_unit_5th_sasebo_snlf_title","SourceString":"5th SASEBO SNLF","LocalizedString":"5th SASEBO SNLF"},"Type":"ETypeEnum::infantry","attack":1,"defense":1,"range":1,"faction":"EFactionEnum::Japan","kredits":1,"Text":{"Namespace":"card_japan","Key":"card_unit_5th_sasebo_snlf_text","SourceString":"Gets +1+1 when you play a Navy card.\r\nDestruction: Shuffle your deck, then draw a card.","LocalizedString":"Gets +1+1 when you play a Navy card.\r\nDestruction: Shuffle your deck, then draw a card."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_5th_sasebo_snlf_history","SourceString":"The 5th Sasebo Special Naval Landing Force (SNLF) was an elite infantry battalion of the Imperial Japanese Navy, formed at the Sasebo Naval District. As part of Japan’s marine infantry, the unit specialized in amphibious assaults and jungle warfare during WWII. In 1942, the 5th Sasebo SNLF took part in the invasion of Buna–Gona in Papua New Guinea. They landed as part of the Yokoyama Advance Force, supporting the Japanese push along the Kokoda Track toward Port Moresby. Approximately 450 troops from the unit were deployed in this operation. Later that year, during Operation Re, the 5th Sasebo SNLF participated in the Battle of Milne Bay. They were part of a 1,500-strong force that included units from the 3rd and 5th Kure SNLF and the 5th Yokosuka SNLF. The operation faced strong resistance from well-prepared Allied forces.The 5th Sasebo SNLF earned a reputation for their tenacity and discipline, often fighting to the last man. Their actions in New Guinea exemplified the aggressive tactics and high morale characteristic of Japan’s naval infantry during the early Pacific campaigns.","LocalizedString":"The 5th Sasebo Special Naval Landing Force (SNLF) was an elite infantry battalion of the Imperial Japanese Navy, formed at the Sasebo Naval District. As part of Japan’s marine infantry, the unit specialized in amphibious assaults and jungle warfare during WWII. In 1942, the 5th Sasebo SNLF took part in the invasion of Buna–Gona in Papua New Guinea. They landed as part of the Yokoyama Advance Force, supporting the Japanese push along the Kokoda Track toward Port Moresby. Approximately 450 troops from the unit were deployed in this operation. Later that year, during Operation Re, the 5th Sasebo SNLF participated in the Battle of Milne Bay. They were part of a 1,500-strong force that included units from the 3rd and 5th Kure SNLF and the 5th Yokosuka SNLF. The operation faced strong resistance from well-prepared Allied forces.The 5th Sasebo SNLF earned a reputation for their tenacity and discipline, often fighting to the last man. Their actions in New Guinea exemplified the aggressive tactics and high morale characteristic of Japan’s naval infantry during the early Pacific campaigns."},"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::NavalWarfare","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand","ERegisteredCardFunction::OnBeforeOtherCardPlayedFromHand","ERegisteredCardFunction::OnCounterMeasureTriggered"],"hasDestruction":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/NavalWarfare/t_5th_sasebo_snfl.t_5th_sasebo_snfl","SubPathString":""},"artist":"Erling Seavarsson","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/5th_SASEBO_SNLF.5th_SASEBO_SNLF","SubPathString":""},"historyPhotoSize":{"X":401.0,"Y":512.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_5th_sasebo_snlf_photo","SourceString":"Soldiers of the 5th Sasebo Special Naval Landing Force. Date unknown.","LocalizedString":"Soldiers of the 5th Sasebo Special Naval Landing Force. Date unknown."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"shouldTrigger","type":"bool","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_5th_sasebo_snlf","owner":"card_unit_5th