{"format":"kards-original-reference","version":1,"id":"72d9ad51e15d3db5","name":"card_unit_ki_42_ii_ko","package":"/Game/Blueprints/Cards/Japan/Legions/units/card_unit_ki_42_ii_ko","parent":"UBaseCardObject","card":{"title":"Ki-43-IIb OTSU","text":"Has +2 attack on your turn if the enemy controls no air units.","flavorText":"The Ki-43-IIb Otsu was a variant of the Nakajima Ki-43 Hayabusa, a Japanese fighter aircraft that was in service of the Imperial Japanese Army Air Force between 1941-1945. The Allied reporting name for the Ki-43 was “Oscar” and it soon earned a reputation for being a very good fighter, but the first variants lacked both armor and self sealing fuel tank which caused it to catch fire easily or break after a few hits. Nevertheless the aircraft gained air superiority early in the war, but the tables turned with the introduction of newer Allied aircraft such as the Hellcat, P-51 Mustang, F4U Corsair and Spitfire. The Ki-43-IIb variant first entered service in 1942 and was very similar to the Ki-43-IIa variant, which differed from its predecessors in many ways. It had armor protection installed for the cockpit, a self-sealing fuel tank, smaller wingspan and the capability of carrying 500 kg of bombs. The Ki-43-IIb had minor upgrades such as new radio equipment and the oil cooler and the carburettor intake were also modified. A total of 5,919 K-43’s that were produced throughout the war, including variants.","faction":"Japan","type":"fighter","rarity":"Common","cost":3,"operationCost":2,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_ki_42_ii_ko","title":{"Namespace":"card_japan","Key":"card_unit_ki_42_ii_ko_title","SourceString":"Ki-43-IIb OTSU","LocalizedString":"Ki-43-IIb OTSU"},"Type":"ETypeEnum::fighter","attack":3,"defense":3,"range":2,"faction":"EFactionEnum::Japan","kredits":3,"Text":{"Namespace":"card_japan","Key":"card_unit_ki_42_ii_ko_text","SourceString":"Has +2 attack on your turn if the enemy controls no air units.","LocalizedString":"Has +2 attack on your turn if the enemy controls no air units."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_ki_42_ii_ko_history","SourceString":"The Ki-43-IIb Otsu was a variant of the Nakajima Ki-43 Hayabusa, a Japanese fighter aircraft that was in service of the Imperial Japanese Army Air Force between 1941-1945. The Allied reporting name for the Ki-43 was “Oscar” and it soon earned a reputation for being a very good fighter, but the first variants lacked both armor and self sealing fuel tank which caused it to catch fire easily or break after a few hits. Nevertheless the aircraft gained air superiority early in the war, but the tables turned with the introduction of newer Allied aircraft such as the Hellcat, P-51 Mustang, F4U Corsair and Spitfire. The Ki-43-IIb variant first entered service in 1942 and was very similar to the Ki-43-IIa variant, which differed from its predecessors in many ways. It had armor protection installed for the cockpit, a self-sealing fuel tank, smaller wingspan and the capability of carrying 500 kg of bombs. The Ki-43-IIb had minor upgrades such as new radio equipment and the oil cooler and the carburettor intake were also modified. A total of 5,919 K-43’s that were produced throughout the war, including variants.","LocalizedString":"The Ki-43-IIb Otsu was a variant of the Nakajima Ki-43 Hayabusa, a Japanese fighter aircraft that was in service of the Imperial Japanese Army Air Force between 1941-1945. The Allied reporting name for the Ki-43 was “Oscar” and it soon earned a reputation for being a very good fighter, but the first variants lacked both armor and self sealing fuel tank which caused it to catch fire easily or break after a few hits. Nevertheless the aircraft gained air superiority early in the war, but the tables turned with the introduction of newer Allied aircraft such as the Hellcat, P-51 Mustang, F4U Corsair and Spitfire. The Ki-43-IIb variant first entered service in 1942 and was very similar to the Ki-43-IIa variant, which differed from its predecessors in many ways. It had armor protection installed for the cockpit, a self-sealing fuel tank, smaller wingspan and the capability of carrying 500 kg of bombs. The Ki-43-IIb had minor upgrades such as new radio equipment and the oil cooler and the carburettor intake were also modified. A total of 5,919 K-43’s that were produced throughout the war, including variants."},"operationCost":2,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Legions","isInPermanentPool":true,"showBoostIcon":true,"EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnStartofTurn","ERegisteredCardFunction::OnEndOfTurn","ERegisteredCardFunction::OnAfterOtherCardLeaveBoardOrOwner","ERegisteredCardFunction::OnOtherCardDestroyed","ERegisteredCardFunction::OnOtherCardEnterPlay"],"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/Invasion/t_ki_43_hayabusa_variant.t_ki_43_hayabusa_variant","SubPathString":""},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/Ki-43-IIb_OTSU.Ki-43-IIb_OTSU","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":298.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_ki_42_ii_ko_photo","SourceString":"Ki-43-IIb Otsu in flight, 1944.","LocalizedString":"Ki-43-IIb Otsu in flight, 1944."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackFighter.BP_AttackFighter_C","SubPathString":""},"isHQDamage":true},"variables":[],"functions