{"format":"kards-original-reference","version":1,"id":"6d1ce8a07781da22","name":"card_unit_raf_ground_crew","package":"/Game/Blueprints/Cards/Britain/Breakthrough/units/card_unit_raf_ground_crew","parent":"UBaseCardObject","card":{"title":"RAF GROUND CREW","text":"Your Spitfires cost 2 less to deploy and get +1+1 when deployed.","flavorText":"During WWII every pilot and aircrew in RAF depended on the ground crews to get into the air and to engage the enemy. The Controllers were in direct contact with the aircraft and guided them into battle based on radar technology and Observer Corps info. During the Battle of Britain the Women's Auxiliary Air Force (WAAF) received reports of enemy aircraft movement and updated the map in the Ops Room to give the Controllers an overall picture of the situation who then coordinated the squadrons in the air. Once the enemy aircraft was spotted the commanders in the air took over and were in charge of how the enemy should be attacked. Engineers worked frequently on aircraft, repairing damage after missions and carrying out maintenance to get them ready for flight. Armourers were responsible for bombs, defensive ammunition and flares at the airfields plus arming aircraft guns and fusing and loading bombs onto the aircraft. Riggers and fitters prepared aircraft for mission, wheeling them into position, checking them over and warming the engines before a flying mission.","faction":"Britain","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":1,"attack":0,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_raf_ground_crew","title":{"Namespace":"card_britain","Key":"card_unit_raf_ground_crew_title","SourceString":"RAF GROUND CREW","LocalizedString":"RAF GROUND CREW"},"Type":"ETypeEnum::infantry","defense":4,"range":1,"faction":"EFactionEnum::Britain","kredits":3,"Text":{"Namespace":"card_britain","Key":"card_unit_raf_ground_crew_text","SourceString":"Your Spitfires cost 2 less to deploy and get +1+1 when deployed.","LocalizedString":"Your Spitfires cost 2 less to deploy and get +1+1 when deployed."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_raf_ground_crew_history","SourceString":"During WWII every pilot and aircrew in RAF depended on the ground crews to get into the air and to engage the enemy. The Controllers were in direct contact with the aircraft and guided them into battle based on radar technology and Observer Corps info. During the Battle of Britain the Women's Auxiliary Air Force (WAAF) received reports of enemy aircraft movement and updated the map in the Ops Room to give the Controllers an overall picture of the situation who then coordinated the squadrons in the air. Once the enemy aircraft was spotted the commanders in the air took over and were in charge of how the enemy should be attacked. Engineers worked frequently on aircraft, repairing damage after missions and carrying out maintenance to get them ready for flight. Armourers were responsible for bombs, defensive ammunition and flares at the airfields plus arming aircraft guns and fusing and loading bombs onto the aircraft. Riggers and fitters prepared aircraft for mission, wheeling them into position, checking them over and warming the engines before a flying mission.","LocalizedString":"During WWII every pilot and aircrew in RAF depended on the ground crews to get into the air and to engage the enemy. The Controllers were in direct contact with the aircraft and guided them into battle based on radar technology and Observer Corps info. During the Battle of Britain the Women's Auxiliary Air Force (WAAF) received reports of enemy aircraft movement and updated the map in the Ops Room to give the Controllers an overall picture of the situation who then coordinated the squadrons in the air. Once the enemy aircraft was spotted the commanders in the air took over and were in charge of how the enemy should be attacked. Engineers worked frequently on aircraft, repairing damage after missions and carrying out maintenance to get them ready for flight. Armourers were responsible for bombs, defensive ammunition and flares at the airfields plus arming aircraft guns and fusing and loading bombs onto the aircraft. Riggers and fitters prepared aircraft for mission, wheeling them into position, checking them over and warming the engines before a flying mission."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Breakthrough","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand","ERegisteredCardFunction::OnOtherCardReset","ERegisteredCardFunction::OnOtherCardSpawnedInHand","ERegisteredCardFunction::OnOtherCardDrawnFromDeck"],"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Small'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Small.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/Breakthrough/t_raf_ground_crew.t_raf_ground_crew","SubPathString":""},"ImageAnchor":"EImageAnchor::Bot","artist":"Michael Turner","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/RAF_GROUND_CREW.RAF_GROUND_CREW","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":357.0},"historyPhotoSource":"Imperial War Museum","historyPhotoIdentificationCode":"CH 1458","historyPhotoAuthor":"Devon S A Royal Air Force official photographer","historyPhotoDescription":{"Namespace":"card_britain","Key":"card_unit_raf_ground_crew_photo","SourceString":"Armourer arming a Spitfire at the No 19 squadron in Cambridgeshire, UK, 1940. ","LocalizedString":"Armourer arming a Spitfire at the No 19 squadron in Cambridgeshire, UK, 1940. "},"historyTypeDescription":{"Namespace":"card_britain","Key":"card_unit_raf_ground_crew_header","SourceString":"Personnel","LocalizedString":"Personnel"},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"Bl