{"format":"kards-original-reference","version":1,"id":"e07e48b0c9ad0b55","name":"card_unit_stug_iii_g_schurzen","package":"/Game/Blueprints/Cards/Germany/Breakthrough/units/card_unit_stug_iii_g_schurzen","parent":"UBaseCardObject","card":{"title":"STUG III G SCHÜRZEN","text":"Pincer: +1 Heavy Armor.","flavorText":"The Stug III, full name Sturmgeschütz III, was a German assault gun built on the chassis of the Panzer III tank and the second most produced German armored vehicle during WWII, after the Sd.Kfz. 251 half-track. It was designed as a mobile assault gun for infantry support, but with later modifications it was also used as a tank destroyer. The Stug III G variant had an improved superstructure design and the addition of side-mounted armor (Schürzen) for protection against anti-tank rifles and hollow-charge ammunition. In early Stug III versions armor was retrofitted, but this proved inadequate and later versions would have an improved side-mounted armor.","faction":"Germany","type":"tank","rarity":"Uncommon","cost":3,"operationCost":1,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_stug_iii_g_schurzen","title":{"Namespace":"card_germany","Key":"card_unit_stug_iii_g_schurzen_title","SourceString":"STUG III G SCHÜRZEN","LocalizedString":"STUG III G SCHÜRZEN"},"Type":"ETypeEnum::tank","attack":3,"defense":4,"range":1,"faction":"EFactionEnum::Germany","kredits":3,"Text":{"Namespace":"card_germany","Key":"card_unit_stug_iii_g_schurzen_text","SourceString":"Pincer: +1 Heavy Armor.","LocalizedString":"Pincer: +1 Heavy Armor."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_stug_iii_g_schurzen_history","SourceString":"The Stug III, full name Sturmgeschütz III, was a German assault gun built on the chassis of the Panzer III tank and the second most produced German armored vehicle during WWII, after the Sd.Kfz. 251 half-track. It was designed as a mobile assault gun for infantry support, but with later modifications it was also used as a tank destroyer. The Stug III G variant had an improved superstructure design and the addition of side-mounted armor (Schürzen) for protection against anti-tank rifles and hollow-charge ammunition. In early Stug III versions armor was retrofitted, but this proved inadequate and later versions would have an improved side-mounted armor.","LocalizedString":"The Stug III, full name Sturmgeschütz III, was a German assault gun built on the chassis of the Panzer III tank and the second most produced German armored vehicle during WWII, after the Sd.Kfz. 251 half-track. It was designed as a mobile assault gun for infantry support, but with later modifications it was also used as a tank destroyer. The Stug III G variant had an improved superstructure design and the addition of side-mounted armor (Schürzen) for protection against anti-tank rifles and hollow-charge ammunition. In early Stug III versions armor was retrofitted, but this proved inadequate and later versions would have an improved side-mounted armor."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Breakthrough","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::HeavyArmor1","EHelpBubbleTypes::Pincer"],"hasPincer":true,"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Armor_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Armor_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/CandidateArtwork/t_one_more_stug.t_one_more_stug","SubPathString":""},"ImageAnchor":"EImageAnchor::Bot","artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/STUG_III_G_SCHÜRZEN.STUG_III_G_SCHÜRZEN","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":321.0},"historyPhotoSource":"German Federal Archives","historyPhotoIdentificationCode":"Bild 101I-708-0299-06","historyPhotoAuthor":"Scheerer, Theodor","historyPhotoDescription":{"Namespace":"card_germany","Key":"card_uni