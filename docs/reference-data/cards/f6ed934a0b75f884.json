{"format":"kards-original-reference","version":1,"id":"f6ed934a0b75f884","name":"card_unit_220th_rifles","package":"/Game/Blueprints/Cards/Soviet/NavalWarfare/units/card_unit_220th_rifles","parent":"UBaseCardObject","card":{"title":"220th RIFLES","text":"Has +2 attack for each damaged unit on the battlefield.","flavorText":"The 220th Rifle Regiment was part of the 4th Rifle Division, a Soviet formation with a long service history. During the division’s first formation, it fought in the Russian Civil War, the Polish-Soviet War, the 1939 invasion of Poland, and the Winter War against Finland. In WWII, it took part in the Barvinkove-Losowaja Operation and the Battle of Voronezh in 1942. The 220th, along with the rest of the division, suffered severe losses and the division was disbanded in November 1942. It was reformed in 1943 in the Moscow Military District. From April 1943 to May 1944, it served with the 11th Army on the Baltic Front, before being transferred to the 48th Army. In January 1945, it was part of the 25th Rifle Corps of the 69th Army and fought in the brutal battle for the Puławy bridgehead in Poland. Losses were heavy, reducing the division’s strength to just six battalions. It later fought in the final assault on Berlin in April 1945. The division was disbanded in the summer of 1945. Its personnel were reassigned to other formations under the Group of Soviet Occupation Forces in Germany.","faction":"Soviet","type":"infantry","rarity":"Unique","cost":4,"operationCost":1,"attack":2,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_220th_rifles","title":{"Namespace":"card_soviet","Key":"card_unit_220th_rifles_title","SourceString":"220th RIFLES","LocalizedString":"220th RIFLES"},"Type":"ETypeEnum::infantry","attack":2,"defense":6,"range":1,"faction":"EFactionEnum::Soviet","kredits":4,"Text":{"Namespace":"card_soviet","Key":"card_unit_220th_rifles_text","SourceString":"Has +2 attack for each damaged unit on the battlefield.","LocalizedString":"Has +2 attack for each damaged unit on the battlefield."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_220th_rifles_history","SourceString":"The 220th Rifle Regiment was part of the 4th Rifle Division, a Soviet formation with a long service history. During the division’s first formation, it fought in the Russian Civil War, the Polish-Soviet War, the 1939 invasion of Poland, and the Winter War against Finland. In WWII, it took part in the Barvinkove-Losowaja Operation and the Battle of Voronezh in 1942. The 220th, along with the rest of the division, suffered severe losses and the division was disbanded in November 1942. It was reformed in 1943 in the Moscow Military District. From April 1943 to May 1944, it served with the 11th Army on the Baltic Front, before being transferred to the 48th Army. In January 1945, it was part of the 25th Rifle Corps of the 69th Army and fought in the brutal battle for the Puławy bridgehead in Poland. Losses were heavy, reducing the division’s strength to just six battalions. It later fought in the final assault on Berlin in April 1945. The division was disbanded in the summer of 1945. Its personnel were reassigned to other formations under the Group of Soviet Occupation Forces in Germany.","LocalizedString":"The 220th Rifle Regiment was part of the 4th Rifle Division, a Soviet formation with a long service history. During the division’s first formation, it fought in the Russian Civil War, the Polish-Soviet War, the 1939 invasion of Poland, and the Winter War against Finland. In WWII, it took part in the Barvinkove-Losowaja Operation and the Battle of Voronezh in 1942. The 220th, along with the rest of the division, suffered severe losses and the division was disbanded in November 1942. It was reformed in 1943 in the Moscow Military District. From April 1943 to May 1944, it served with the 11th Army on the Baltic Front, before being transferred to the 48th Army. In January 1945, it was part of the 25th Rifle Corps of the 69th Army and fought in the brutal battle for the Puławy bridgehead in Poland. Losses were heavy, reducing the division’s strength to just six battalions. It later fought in the final assault on Berlin in April 1945. The division was disbanded in the summer of 1945. Its personnel were reassigned to other formations under the Group of Soviet Occupation Forces in Germany."},"operationCost":1,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::NavalWarfare","EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardDealDamage","ERegisteredCardFunction::OnAfterOtherCardLeaveBoardOrOwner","ERegisteredCardFunction::OnAfterOtherCardGainDefense","ERegisteredCardFunction::OnAfterOtherCardDefenseIsSet","ERegisteredCardFunction::OnOtherCardFullyRepaired"],"hasBlitz":true,"hasAmbush":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/NavalWarfare/t_220th_rifles.t_220th_rifles","SubPathString":""},"artist":"Erling Saevarsson","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/220th_RIFLES.220th_RIFLES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":330.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_220th_rifles_photo","SourceString":"Red Army soldiers during the Battle of Voronezh, July 1942.","LocalizedString":"Red Army soldiers during the Battle of Voronezh, July 1942."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"isDefenseBuff":true,"threat_level":0.1},"variables":[{"name":"count","type":"int32","direction":"in"}],"functions":[{"name":"CustomEventOnCardDealDamage","owner":"ca