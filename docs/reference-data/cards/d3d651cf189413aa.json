{"format":"kards-original-reference","version":1,"id":"d3d651cf189413aa","name":"card_unit_3rd_kure_snlf","package":"/Game/Blueprints/Cards/Japan/NavalWarfare/units/card_unit_3rd_kure_snlf","parent":"UBaseCardObject","card":{"title":"3rd KURE SNLF","text":"Reduce the operation cost by 1 until end of turn, when you shuffle your deck.","flavorText":"The 3rd Kure Special Naval Landing Force (SNLF) was an elite naval infantry unit of the Imperial Japanese Navy, formed at the Kure Naval District. It was initially active in China during the late 1930s, but was reconstituted in 1942 to participate in key operations across the Pacific theater. In May 1942, approximately 400 troops from the 3rd Kure SNLF landed on Tulagi Island in the Solomon Islands, where they established a seaplane base and fortifications. However, on August 7, 1942, US Marines launched an assault on Tulagi, and despite fierce resistance, the Japanese garrison, including the 3rd Kure SNLF, was overwhelmed. Out of the 350 men stationed there, 307 were killed, and only a few were taken prisoner. Later that month, on August 29, 1942, elements of the 3rd Kure SNLF participated in the Battle of Milne Bay in Papua New Guinea. Under the command of Commander Minoru Yano, approximately 769 naval troops landed to support earlier Japanese forces. The operation faced strong Allied resistance, and by September 5, the Japanese were forced to evacuate after suffering significant casualties. The heavy losses at Tulagi and Milne Bay marked the decline of the 3rd Kure SNLF's combat effectiveness and the unit was disbanded soon after.","faction":"Japan","type":"infantry","rarity":"Uncommon","cost":2,"operationCost":1,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_3rd_kure_snlf","title":{"Namespace":"card_japan","Key":"card_unit_3rd_kure_snlf_title","SourceString":"3rd KURE SNLF","LocalizedString":"3rd KURE SNLF"},"Type":"ETypeEnum::infantry","attack":3,"defense":3,"range":1,"faction":"EFactionEnum::Japan","kredits":2,"Text":{"Namespace":"card_japan","Key":"card_unit_3rd_kure_snlf_text","SourceString":"Reduce the operation cost by 1 until end of turn, when you shuffle your deck.","LocalizedString":"Reduce the operation cost by 1 until end of turn, when you shuffle your deck."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_3rd_kure_snlf_history","SourceString":"The 3rd Kure Special Naval Landing Force (SNLF) was an elite naval infantry unit of the Imperial Japanese Navy, formed at the Kure Naval District. It was initially active in China during the late 1930s, but was reconstituted in 1942 to participate in key operations across the Pacific theater. In May 1942, approximately 400 troops from the 3rd Kure SNLF landed on Tulagi Island in the Solomon Islands, where they established a seaplane base and fortifications. However, on August 7, 1942, US Marines launched an assault on Tulagi, and despite fierce resistance, the Japanese garrison, including the 3rd Kure SNLF, was overwhelmed. Out of the 350 men stationed there, 307 were killed, and only a few were taken prisoner. Later that month, on August 29, 1942, elements of the 3rd Kure SNLF participated in the Battle of Milne Bay in Papua New Guinea. Under the command of Commander Minoru Yano, approximately 769 naval troops landed to support earlier Japanese forces. The operation faced strong Allied resistance, and by September 5, the Japanese were forced to evacuate after suffering significant casualties. The heavy losses at Tulagi and Milne Bay marked the decline of the 3rd Kure SNLF's combat effectiveness and the unit was disbanded soon after.","LocalizedString":"The 3rd Kure Special Naval Landing Force (SNLF) was an elite naval infantry unit of the Imperial Japanese Navy, formed at the Kure Naval District. It was initially active in China during the late 1930s, but was reconstituted in 1942 to participate in key operations across the Pacific theater. In May 1942, approximately 400 troops from the 3rd Kure SNLF landed on Tulagi Island in the Solomon Islands, where they established a seaplane base and fortifications. However, on August 7, 1942, US Marines launched an assault on Tulagi, and despite fierce resistance, the Japanese garrison, including the 3rd Kure SNLF, was overwhelmed. Out of the 350 men stationed there, 307 were killed, and only a few were taken prisoner. Later that month, on August 29, 1942, elements of the 3rd Kure SNLF participated in the Battle of Milne Bay in Papua New Guinea. Under the command of Commander Minoru Yano, approximately 769 naval troops landed to support earlier Japanese forces. The operation faced strong Allied resistance, and by September 5, the Japanese were forced to evacuate after suffering significant casualties. The heavy losses at Tulagi and Milne Bay marked the decline of the 3rd Kure SNLF's combat effectiveness and the unit was disbanded soon after."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::NavalWarfare","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnDeckShuffled","ERegisteredCardFunction::OnEndOfTurn"],"suppressionExceptionTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"hasBlitz":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/NavalWarfare/t_3rd_kure_snfl.t_3rd_kure_snfl","SubPathString":""},"artist":"Erling Seavarsson","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/3rd_KURE_SNLF.3rd_KURE_SNLF","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":317.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_3rd_kure_snlf_photo","SourceString":"Japanese Special Naval Landing Force troops in Guadalcanal. Date Unknown.","LocalizedString":"Japanese Special Naval Landing Force troops in Guadalcanal. Date Unknown."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectNa