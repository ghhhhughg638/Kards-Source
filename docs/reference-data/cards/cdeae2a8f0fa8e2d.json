{"format":"kards-original-reference","version":1,"id":"cdeae2a8f0fa8e2d","name":"card_unit_panzer_i_a","package":"/Game/Blueprints/Cards/Germany/Homefront/units/card_unit_panzer_i_a","parent":"UBaseCardObject","card":{"title":"PANZER I-A","text":"Deployment: Draw a card if you control an infantry.","flavorText":"The Panzer I Ausf. A was Germany’s first mass-produced tank, developed in secret during the early 1930s to train armored troops and jumpstart domestic tank production. Originally known under code names like \"Agricultural Tractor\", it entered service in 1934. It was manned by a crew of two and equipped with twin 7.92 mm MG13 machine guns. Armor was limited to just 13 mm at its thickest, sufficient only against small arms fire. Powered by a Krupp M305 four-cylinder air-cooled engine delivering 60 horsepower, the Ausf. A could reach 37 km/h on roads but suffered from suspension issues and engine overheating. Although not intended for combat, the Panzer I-A was pressed into front-line service due to Germany's limited armored forces. It fought in the Spanish Civil War, Poland, France, and the early stages of Operation Barbarossa. In Spain, it proved vulnerable to Soviet-supplied T-26 tanks, which prompted attempts to up-gun or replace it .A total of 1,190 combat Panzer I Ausf. A tanks were built across three production series. Despite its shortcomings, the Panzer I-A laid the foundation for Germany’s later armored warfare doctrine and played a crucial role in training the first panzer crews.","faction":"Germany","type":"tank","rarity":"Uncommon","cost":1,"operationCost":1,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_panzer_i_a","title":{"Namespace":"card_germany","Key":"card_unit_panzer_i_a_title","SourceString":"PANZER I-A","LocalizedString":"PANZER I-A"},"Type":"ETypeEnum::tank","attack":1,"defense":2,"range":1,"faction":"EFactionEnum::Germany","kredits":1,"Text":{"Namespace":"card_germany","Key":"card_unit_panzer_i_a_text","SourceString":"Deployment: Draw a card if you control an infantry.","LocalizedString":"Deployment: Draw a card if you control an infantry."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_panzer_i_a_history","SourceString":"The Panzer I Ausf. A was Germany’s first mass-produced tank, developed in secret during the early 1930s to train armored troops and jumpstart domestic tank production. Originally known under code names like \"Agricultural Tractor\", it entered service in 1934. It was manned by a crew of two and equipped with twin 7.92 mm MG13 machine guns. Armor was limited to just 13 mm at its thickest, sufficient only against small arms fire. Powered by a Krupp M305 four-cylinder air-cooled engine delivering 60 horsepower, the Ausf. A could reach 37 km/h on roads but suffered from suspension issues and engine overheating. Although not intended for combat, the Panzer I-A was pressed into front-line service due to Germany's limited armored forces. It fought in the Spanish Civil War, Poland, France, and the early stages of Operation Barbarossa. In Spain, it proved vulnerable to Soviet-supplied T-26 tanks, which prompted attempts to up-gun or replace it .A total of 1,190 combat Panzer I Ausf. A tanks were built across three production series. Despite its shortcomings, the Panzer I-A laid the foundation for Germany’s later armored warfare doctrine and played a crucial role in training the first panzer crews.","LocalizedString":"The Panzer I Ausf. A was Germany’s first mass-produced tank, developed in secret during the early 1930s to train armored troops and jumpstart domestic tank production. Originally known under code names like \"Agricultural Tractor\", it entered service in 1934. It was manned by a crew of two and equipped with twin 7.92 mm MG13 machine guns. Armor was limited to just 13 mm at its thickest, sufficient only against small arms fire. Powered by a Krupp M305 four-cylinder air-cooled engine delivering 60 horsepower, the Ausf. A could reach 37 km/h on roads but suffered from suspension issues and engine overheating. Although not intended for combat, the Panzer I-A was pressed into front-line service due to Germany's limited armored forces. It fought in the Spanish Civil War, Poland, France, and the early stages of Operation Barbarossa. In Spain, it proved vulnerable to Soviet-supplied T-26 tanks, which prompted attempts to up-gun or replace it .A total of 1,190 combat Panzer I Ausf. A tanks were built across three production series. Despite its shortcomings, the Panzer I-A laid the foundation for Germany’s later armored warfare doctrine and played a crucial role in training the first panzer crews."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Homefront","hasDeployment":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/PANZER_I-A.PANZER_I-A","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":358.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_panzer_i_a_photo","SourceString":"A Panzer I Ausf. A. Date unknown.","LocalizedString":"A Panzer I Ausf. A. Date unknown."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionArmourS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionArmourS.31"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Tanks/BP_AttackTank.BP_AttackTank_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_panzer_i_a","owner":"card_unit_panzer_i_a_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_bool_True_if_break_was_hit_Variable","type":"bool","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Cal