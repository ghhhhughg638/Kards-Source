{"format":"kards-original-reference","version":1,"id":"5b9bf44cdd5671d1","name":"card_unit_14th_guards_rifles","package":"/Game/Blueprints/Cards/Soviet/BrothersInArms/units/card_unit_14th_guards_rifles","parent":"UBaseCardObject","card":{"title":"14th GUARD RIFLES","text":"Becomes Veteran at the start of its third turn on the battlefield.","flavorText":"The 14th Guard Rifles was a regiment of the 7th Guards Rifle Division which served as an elite unit throughout the Great Patriotic War. Initially assigned to the Bryansk Front, it later joined the Western Front, actively participating in the early stages of the 1941 winter counteroffensive northwest of Moscow as part of the 16th Army . Early 1942 the division was moved under the command of the 1st Guards Rifle Corps and was deployed to the Northwestern Front and participated in fighting around Demyansk until the German II Army Corps evacuated in February 1943. Throughout the following year, the division engaged in battles within the Staraya Russa region, primarily under the command of the 1st Shock Army. In January 1944, the division was transferred to the 7th Guards Rifle Corps of the 10th Guards Army. During the summer and autumn operations in the Baltic states, the 7th Guards Division distinguished itself, earning a battle honor and the esteemed Order of the Red Banner. In March 1945, it joined the Courland Group of Forces of the Leningrad Front, overseeing the German forces encircled in northwest Latvia along the Baltic coast. After the German surrender, the division was relocated to Estonia and eventually disbanded in 1946.","faction":"Soviet","type":"infantry","rarity":"Common","cost":4,"operationCost":1,"attack":5,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_14th_guards_rifles","title":{"Namespace":"card_soviet","Key":"card_unit_14th_guards_rifles_title","SourceString":"14th GUARD RIFLES","LocalizedString":"14th GUARD RIFLES"},"Type":"ETypeEnum::infantry","attack":5,"defense":5,"range":1,"faction":"EFactionEnum::Soviet","kredits":4,"Text":{"Namespace":"card_soviet","Key":"card_unit_14th_guards_rifles_text","SourceString":"Becomes Veteran at the start of its third turn on the battlefield.","LocalizedString":"Becomes Veteran at the start of its third turn on the battlefield."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_14th_guards_rifles_history","SourceString":"The 14th Guard Rifles was a regiment of the 7th Guards Rifle Division which served as an elite unit throughout the Great Patriotic War. Initially assigned to the Bryansk Front, it later joined the Western Front, actively participating in the early stages of the 1941 winter counteroffensive northwest of Moscow as part of the 16th Army . Early 1942 the division was moved under the command of the 1st Guards Rifle Corps and was deployed to the Northwestern Front and participated in fighting around Demyansk until the German II Army Corps evacuated in February 1943. Throughout the following year, the division engaged in battles within the Staraya Russa region, primarily under the command of the 1st Shock Army. In January 1944, the division was transferred to the 7th Guards Rifle Corps of the 10th Guards Army. During the summer and autumn operations in the Baltic states, the 7th Guards Division distinguished itself, earning a battle honor and the esteemed Order of the Red Banner. In March 1945, it joined the Courland Group of Forces of the Leningrad Front, overseeing the German forces encircled in northwest Latvia along the Baltic coast. After the German surrender, the division was relocated to Estonia and eventually disbanded in 1946.","LocalizedString":"The 14th Guard Rifles was a regiment of the 7th Guards Rifle Division which served as an elite unit throughout the Great Patriotic War. Initially assigned to the Bryansk Front, it later joined the Western Front, actively participating in the early stages of the 1941 winter counteroffensive northwest of Moscow as part of the 16th Army . Early 1942 the division was moved under the command of the 1st Guards Rifle Corps and was deployed to the Northwestern Front and participated in fighting around Demyansk until the German II Army Corps evacuated in February 1943. Throughout the following year, the division engaged in battles within the Staraya Russa region, primarily under the command of the 1st Shock Army. In January 1944, the division was transferred to the 7th Guards Rifle Corps of the 10th Guards Army. During the summer and autumn operations in the Baltic states, the 7th Guards Division distinguished itself, earning a battle honor and the esteemed Order of the Red Banner. In March 1945, it joined the Courland Group of Forces of the Leningrad Front, overseeing the German forces encircled in northwest Latvia along the Baltic coast. After the German surrender, the division was relocated to Estonia and eventually disbanded in 1946."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::BrothersInArms","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Veteran"],"spawnCardName":"card_unit_14th_guards_rifles_vet","soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/Spring2023Candidates/t_soviet_young_soldire.t_soviet_young_soldire","SubPathString":""},"artist":"Look and Learn","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/14th_GUARD_RIFLES.14th_GUARD_RIFLES","SubPathString":""},"historyPhotoSize":{"X":418.0,"Y":512.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_14th_guards_rifles_photo","SourceString":"Soviet troops in the city of Riga, Latvia, 1944.","LocalizedString":"Soviet troops in the city of Riga, Latvia, 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfant