{"format":"kards-original-reference","version":1,"id":"f23f6d41d43b1cc3","name":"card_event_semper_fi","package":"/Game/Blueprints/Cards/USA/NavalWarfare/events/card_event_semper_fi","parent":"UBaseCardObject","card":{"title":"SEMPER FI","text":"Convert 4 of the top 8 cards of your deck into 22nd MARINES. Give them the Navy type.","flavorText":"\"Semper Fi\" is the abbreviation of the Latin phrase \"Semper Fidelis,\" meaning \"Always Faithful\" in English. It's the motto of the United States Marine Corps, adopted in 1883, signifying a Marine's lifelong commitment to the Corps, the country, and their fellow Marines. It represents a dedication to loyalty and unwavering service. \"Semper Fidelis\" is also the title of the official march of the United States Marine Corps, composed by John Philip Sousa in 1889. On the United States Marine Corps Seal, the symbols of the Eagle, Globe, and Anchor emblem holds a ribbon emblazoned \"Semper Fidelis\".","faction":"USA","type":"order","rarity":"Rare","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_semper_fi","title":{"Namespace":"card_usa","Key":"card_event_semper_fi_title","SourceString":"SEMPER FI","LocalizedString":"SEMPER FI"},"Type":"ETypeEnum::order","faction":"EFactionEnum::USA","kredits":1,"Text":{"Namespace":"card_usa","Key":"card_event_semper_fi_text","SourceString":"Convert 4 of the top 8 cards of your deck into 22nd MARINES. Give them the Navy type.","LocalizedString":"Convert 4 of the top 8 cards of your deck into 22nd MARINES. Give them the Navy type."},"flavorText":{"Namespace":"card_usa","Key":"card_event_semper_fi_history","SourceString":"\"Semper Fi\" is the abbreviation of the Latin phrase \"Semper Fidelis,\" meaning \"Always Faithful\" in English. It's the motto of the United States Marine Corps, adopted in 1883, signifying a Marine's lifelong commitment to the Corps, the country, and their fellow Marines. It represents a dedication to loyalty and unwavering service. \"Semper Fidelis\" is also the title of the official march of the United States Marine Corps, composed by John Philip Sousa in 1889. On the United States Marine Corps Seal, the symbols of the Eagle, Globe, and Anchor emblem holds a ribbon emblazoned \"Semper Fidelis\".","LocalizedString":"\"Semper Fi\" is the abbreviation of the Latin phrase \"Semper Fidelis,\" meaning \"Always Faithful\" in English. It's the motto of the United States Marine Corps, adopted in 1883, signifying a Marine's lifelong commitment to the Corps, the country, and their fellow Marines. It represents a dedication to loyalty and unwavering service. \"Semper Fidelis\" is also the title of the official march of the United States Marine Corps, composed by John Philip Sousa in 1889. On the United States Marine Corps Seal, the symbols of the Eagle, Globe, and Anchor emblem holds a ribbon emblazoned \"Semper Fidelis\"."},"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::NavalWarfare","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Convert"],"spawnCardName":"card_unit_22nd_marines","soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/NavalWarfare/t_onslaught.t_onslaught","SubPathString":""},"artist":"US WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/SEMPER_FI.SEMPER_FI","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":403.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_event_semper_fi_photo","SourceString":"US Marines in Okinawa, Japan, 1945.","LocalizedString":"US Marines in Okinawa, Japan, 1945."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"isAttackBuff":true,"isDefenseBuff":true},"variables":[{"name":"cardsToRandom","type":"TArray<int32>","direction":"in"},{"name":"cardsTo