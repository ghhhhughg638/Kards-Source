{"format":"kards-original-reference","version":1,"id":"deb38fd055aa5e75","name":"card_unit_222th_guard_rifles","package":"/Game/Blueprints/Cards/Soviet/Breakthrough/units/card_unit_222th_guard_rifles","parent":"UBaseCardObject","card":{"title":"222nd GUARD RIFLES","text":"Pincer: At the end of your turn, fully repair this unit.","flavorText":"The 222nd Guards Rifle Regiment was part of the 72nd Guards Rifle Division, which previously was known as 29th Rifle Division, but raised to guards status in 1943 after an heroic performance in the Battle of Stalingrad. The division fought for the liberation of the city of Belgorod in 1943 and in 1944 it fought in the Budapest offensive. In 1944 the division was attached to the 24th Guards Rifle Corps and managed to capture an area around the village of Bruty in Slovakia where its advance was halted by the German 1st Battalion of Grenadier Regiment. After the war the division became the 7th Guards Rifle Brigade, and after the fall of Soviet Union it was transferred to Ukraine and is now the 72nd Mechanized Brigade of the Ukrainian Army.","faction":"Soviet","type":"infantry","rarity":"Rare","cost":9,"operationCost":2,"attack":7,"defense":7},"defaults":{"UberGraphFrame":{},"Name":"card_unit_222th_guard_rifles","title":{"Namespace":"card_soviet","Key":"card_unit_222th_guard_rifles_title","SourceString":"222nd GUARD RIFLES","LocalizedString":"222nd GUARD RIFLES"},"Type":"ETypeEnum::infantry","attack":7,"defense":7,"range":1,"faction":"EFactionEnum::Soviet","kredits":9,"Text":{"Namespace":"card_soviet","Key":"card_unit_222th_guard_rifles_text","SourceString":"Pincer: At the end of your turn, fully repair this unit.","LocalizedString":"Pincer: At the end of your turn, fully repair this unit."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_222th_guard_rifles_history","SourceString":"The 222nd Guards Rifle Regiment was part of the 72nd Guards Rifle Division, which previously was known as 29th Rifle Division, but raised to guards status in 1943 after an heroic performance in the Battle of Stalingrad. The division fought for the liberation of the city of Belgorod in 1943 and in 1944 it fought in the Budapest offensive. In 1944 the division was attached to the 24th Guards Rifle Corps and managed to capture an area around the village of Bruty in Slovakia where its advance was halted by the German 1st Battalion of Grenadier Regiment. After the war the division became the 7th Guards Rifle Brigade, and after the fall of Soviet Union it was transferred to Ukraine and is now the 72nd Mechanized Brigade of the Ukrainian Army.","LocalizedString":"The 222nd Guards Rifle Regiment was part of the 72nd Guards Rifle Division, which previously was known as 29th Rifle Division, but raised to guards status in 1943 after an heroic performance in the Battle of Stalingrad. The division fought for the liberation of the city of Belgorod in 1943 and in 1944 it fought in the Budapest offensive. In 1944 the division was attached to the 24th Guards Rifle Corps and managed to capture an area around the village of Bruty in Slovakia where its advance was halted by the German 1st Battalion of Grenadier Regiment. After the war the division became the 7th Guards Rifle Brigade, and after the fall of Soviet Union it was transferred to Ukraine and is now the 72nd Mechanized Brigade of the Ukrainian Army."},"operationCost":2,"rarity":"ERarityEnum::Rare","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Breakthrough","isReserved":true,"usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Pincer"],"hasGuard":true,"hasPincer":true,"soundBlowUp":{"ObjectName":"SoundWave'explosion_large_01'","ObjectPath":"kards/Content/ExplosionSoundPack/ExplosionSounds/Wavs/explosion_large_01.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/WE_Candidates/t_soviet_inf_breakthrough_1.t_soviet_inf_breakthrough_1","SubPathString":""},"artist":"Soviet WWII