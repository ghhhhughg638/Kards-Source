{"format":"kards-original-reference","version":1,"id":"2a8ab75ed54d651b","name":"card_unit_infantry_regiment_25","package":"/Game/Blueprints/Cards/Finland/units/card_unit_infantry_regiment_25","parent":"UBaseCardObject","card":{"title":"INFANTRY REGIMENT 25","text":"Your HQ gets +2 defense when you attack with a unit with 2 or more combat keywords.","flavorText":"Infantry Regiment 25 served under the Finnish 4th Division as part of II Corps during the Continuation War. In the autumn of 1941, the regiment took part in the Karhumäki-Povetsa offensive in East Karelia. This operation aimed to secure the Maaselkä Isthmus, a strategic land corridor between Lake Onega and Lake Seesjärvi. Advancing under the command of General Taavetti Laatikainen, II Corps moved deep into Soviet territory, following earlier successes near Lake Ladoga. The corps attacked north of Petrozavodsk and pushed toward Karhumäki. The town, situated on low ground and surrounded by hills, fell by late November. After securing key positions such as the Krivi railway station and Suurlahti, the Finnish forces established defensive lines as ordered by High Command. Following this advance, II Corps remained stationed in the region and transitioned into trench warfare. From 1942 to 1944, the corps was known as Maaselkä Group and faced repeated Soviet attacks. Despite supply difficulties and morale issues, it held its ground, anchoring Finland’s eastern front until Soviet offensives resumed in 1944.","faction":"Finland","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":1,"attack":2,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_infantry_regiment_25","title":{"Namespace":"card_finland","Key":"card_unit_infantry_regiment_25_title","SourceString":"INFANTRY REGIMENT 25","LocalizedString":"INFANTRY REGIMENT 25"},"Type":"ETypeEnum::infantry","attack":2,"defense":5,"range":1,"faction":"EFactionEnum::Finland","kredits":3,"Text":{"Namespace":"card_finland","Key":"card_unit_infantry_regiment_25_text","SourceString":"Your HQ gets +2 defense when you attack with a unit with 2 or more combat keywords.","LocalizedString":"Your HQ gets +2 defense when you attack with a unit with 2 or more combat keywords."},"flavorText":{"Namespace":"card_finland","Key":"card_unit_infantry_regiment_25_history","SourceString":"Infantry Regiment 25 served under the Finnish 4th Division as part of II Corps during the Continuation War. In the autumn of 1941, the regiment took part in the Karhumäki-Povetsa offensive in East Karelia. This operation aimed to secure the Maaselkä Isthmus, a strategic land corridor between Lake Onega and Lake Seesjärvi. Advancing under the command of General Taavetti Laatikainen, II Corps moved deep into Soviet territory, following earlier successes near Lake Ladoga. The corps attacked north of Petrozavodsk and pushed toward Karhumäki. The town, situated on low ground and surrounded by hills, fell by late November. After securing key positions such as the Krivi railway station and Suurlahti, the Finnish forces established defensive lines as ordered by High Command. Following this advance, II Corps remained stationed in the region and transitioned into trench warfare. From 1942 to 1944, the corps was known as Maaselkä Group and faced repeated Soviet attacks. Despite supply difficulties and morale issues, it held its ground, anchoring Finland’s eastern front until Soviet offensives resumed in 1944.","LocalizedString":"Infantry Regiment 25 served under the Finnish 4th Division as part of II Corps during the Continuation War. In the autumn of 1941, the regiment took part in the Karhumäki-Povetsa offensive in East Karelia. This operation aimed to secure the Maaselkä Isthmus, a strategic land corridor between Lake Onega and Lake Seesjärvi. Advancing under the command of General Taavetti Laatikainen, II Corps moved deep into Soviet territory, following earlier successes near Lake Ladoga. The corps attacked north of Petrozavodsk and pushed toward Karhumäki. The town, situated on low ground and surrounded by hills, fell by late November. After securing key positions such as the Krivi railway station and Suurlahti, the Finnish forces established defensive lines as ordered by High Command. Following this advance, II Corps remained stationed in the region and transitioned into trench warfare. From 1942 to 1944, the corps was known as Maaselkä Group and faced repeated Soviet attacks. Despite supply difficulties and morale issues, it held its ground, anchoring Finland’s eastern front until Soviet offensives resumed in 1944."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnBeforeOtherCardAttacks"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::CombatKeywords"],"hasGuard":true,"hasShock":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/INFANTRY_REGIMENT_25.INFANTRY_REGIMENT_25","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":368.0},"historyPhotoDescription":{"Namespace":"card_finland","Key":"card_unit_infantry_regiment_25_photo","SourceString":"Soldiers of the 4th Division near the city of Karhumäki in Karelia, 1941.","LocalizedString":"Soldiers of the 4th Division near the city of Karhumäki in Karelia, 1941."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_infantry_regiment_25","owner":"card_unit_infantry_regiment_25_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"fl