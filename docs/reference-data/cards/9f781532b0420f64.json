{"format":"kards-original-reference","version":1,"id":"9f781532b0420f64","name":"card_unit_214th_amur","package":"/Game/Blueprints/Cards/Soviet/Legions/units/card_unit_214th_amur","parent":"UBaseCardObject","card":{"title":"214th AMUR","text":"Your T-34 units have +1 Heavy Armor and operate for 1 less.","flavorText":"The 214th Amur Order of the Red Star Rifle Regiment was a unit of the 12th Rifle Division of the Red Army. The division was formed twice and its first formation was active from 1918-1921 and fought in the Russian Civil War and the Polish-Soviet War. The division was formed again in 1923 and was stationed at Omsk in Siberia where it spent WWII. In 1945 the division participated in the Soviet invasion of Manchuria and was involved in capturing several Chinese cities as well as defeating the Japanese Kwantung Army. In 1945 the division was given the honorific “Amur” for its services.","faction":"Soviet","type":"infantry","rarity":"Uncommon","cost":4,"operationCost":2,"attack":3,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_214th_amur","title":{"Namespace":"card_soviet","Key":"card_unit_214th_amur_title","SourceString":"214th AMUR","LocalizedString":"214th AMUR"},"Type":"ETypeEnum::infantry","attack":3,"defense":6,"range":1,"faction":"EFactionEnum::Soviet","kredits":4,"Text":{"Namespace":"card_soviet","Key":"card_unit_214th_amur_text","SourceString":"Your T-34 units have +1 Heavy Armor and operate for 1 less.","LocalizedString":"Your T-34 units have +1 Heavy Armor and operate for 1 less."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_214th_amur_history","SourceString":"The 214th Amur Order of the Red Star Rifle Regiment was a unit of the 12th Rifle Division of the Red Army. The division was formed twice and its first formation was active from 1918-1921 and fought in the Russian Civil War and the Polish-Soviet War. The division was formed again in 1923 and was stationed at Omsk in Siberia where it spent WWII. In 1945 the division participated in the Soviet invasion of Manchuria and was involved in capturing several Chinese cities as well as defeating the Japanese Kwantung Army. In 1945 the division was given the honorific “Amur” for its services.","LocalizedString":"The 214th Amur Order of the Red Star Rifle Regiment was a unit of the 12th Rifle Division of the Red Army. The division was formed twice and its first formation was active from 1918-1921 and fought in the Russian Civil War and the Polish-Soviet War. The division was formed again in 1923 and was stationed at Omsk in Siberia where it spent WWII. In 1945 the division participated in the Soviet invasion of Manchuria and was involved in capturing several Chinese cities as well as defeating the Japanese Kwantung Army. In 1945 the division was given the honorific “Amur” for its services."},"operationCost":2,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Legions","isInPermanentPool":true,"showBoostIcon":true,"EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardEnterPlay","ERegisteredCardFunction::OnOtherCardLeaveBoardOrOwner"],"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/Invasion/t_soviet_engineers.t_soviet_engineers","SubPathString":""},"ImageAnchor":"EImageAnchor::Top","artist":"Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/214th_AMUR.214th_AMUR","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":366.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_214th_amur_photo","SourceString":"Soviet troops advancing during the Soviet invasion of Manchuria, 1945.","LocalizedString":"Soviet troops advancing during the Soviet invasion of Manchuria, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_Explosio