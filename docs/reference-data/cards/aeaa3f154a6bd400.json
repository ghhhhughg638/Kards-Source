{"format":"kards-original-reference","version":1,"id":"aeaa3f154a6bd400","name":"card_unit_15th_wolves_regiment","package":"/Game/Blueprints/Cards/Poland/units/card_unit_15th_wolves_regiment","parent":"UBaseCardObject","card":{"title":"15th WOLVES REGIMENT","text":"Deployment: Convert target unit into ROUTED TROOPS. Draw 2 cards if it was friendly.","flavorText":"The 15th Infantry Regiment, a unit of the Polish Army, belonged to the 28th Infantry Division at the start of WWII. It earned its \"Wolves\" nickname for its relentless combat style during the Polish-Soviet War (1919–21), and its badge featured four wolf heads. In the opening days of the German invasion of Poland, as part of the Łódź Army, the regiment engaged in fierce defensive battles near the Warta River, delaying the enemy’s advance. During the defense of Pabianice on September 7, the regiment held off assaults by the SS Division \"Leibstandarte Adolf Hitler\", inflicting heavy losses. A few hours later, while retreating toward Łódź, they suffered severe casualties during a German ambush. Elements of the regiment then participated in engagements near Stryków and Warsaw’s outskirts. By mid-September, remnants regrouped and helped defend the Modlin Fortress until its capitulation on September 29. After the fall of Poland, surviving members continued to fight within various formations. Some joined the Polish Underground State, fighting in the Home Army, while others escaped and served with Polish forces in exile. In July 1944, with Soviet support, the regiment was reformed as part of the 5th Infantry Division of the Polish People's Army. It fought in major eastern front battles, including the crossing of the Oder River and the Battle of Berlin.","faction":"Poland","type":"infantry","rarity":"Rare","cost":5,"operationCost":1,"attack":4,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_15th_wolves_regiment","title":{"Namespace":"card_poland","Key":"card_unit_15th_wolves_regiment_title","SourceString":"15th WOLVES REGIMENT","LocalizedString":"15th WOLVES REGIMENT"},"Type":"ETypeEnum::infantry","attack":4,"defense":4,"range":1,"faction":"EFactionEnum::Poland","kredits":5,"Text":{"Namespace":"card_poland","Key":"card_unit_15th_wolves_regiment_text","SourceString":"Deployment: Convert target unit into ROUTED TROOPS. Draw 2 cards if it was friendly.","LocalizedString":"Deployment: Convert target unit into ROUTED TROOPS. Draw 2 cards if it was friendly."},"flavorText":{"Namespace":"card_poland","Key":"card_unit_15th_wolves_regiment_history","SourceString":"The 15th Infantry Regiment, a unit of the Polish Army, belonged to the 28th Infantry Division at the start of WWII. It earned its \"Wolves\" nickname for its relentless combat style during the Polish-Soviet War (1919–21), and its badge featured four wolf heads. In the opening days of the German invasion of Poland, as part of the Łódź Army, the regiment engaged in fierce defensive battles near the Warta River, delaying the enemy’s advance. During the defense of Pabianice on September 7, the regiment held off assaults by the SS Division \"Leibstandarte Adolf Hitler\", inflicting heavy losses. A few hours later, while retreating toward Łódź, they suffered severe casualties during a German ambush. Elements of the regiment then participated in engagements near Stryków and Warsaw’s outskirts. By mid-September, remnants regrouped and helped defend the Modlin Fortress until its capitulation on September 29. After the fall of Poland, surviving members continued to fight within various formations. Some joined the Polish Underground State, fighting in the Home Army, while others escaped and served with Polish forces in exile. In July 1944, with Soviet support, the regiment was reformed as part of the 5th Infantry Division of the Polish People's Army. It fought in major eastern front battles, including the crossing of the Oder River and the Battle of Berlin.","LocalizedString":"The 15th Infantry Regiment, a unit of the Polish Army, belonged to the 28th Infantry Division at the start of WWII. It earned its \"Wolves\" nickname for its relentless combat style during the Polish-Soviet War (1919–21), and its badge featured four wolf heads. In the opening days of the German invasion of Poland, as part of the Łódź Army, the regiment engaged in fierce defensive battles near the Warta River, delaying the enemy’s advance. During the defense of Pabianice on September 7, the regiment held off assaults by the SS Division \"Leibstandarte Adolf Hitler\", inflicting heavy losses. A few hours later, while retreating toward Łódź, they suffered severe casualties during a German ambush. Elements of the regiment then participated in engagements near Stryków and Warsaw’s outskirts. By mid-September, remnants regrouped and helped defend the Modlin Fortress until its capitulation on September 29. After the fall of Poland, surviving members continued to fight within various formations. Some joined the Polish Underground State, fighting in the Home Army, while others escaped and served with Polish forces in exile. In July 1944, with Soviet support, the regiment was reformed as part of the 5th Infantry Division of the Polish People's Army. It fought in major eastern front battles, including the crossing of the Oder River and the Battle of Berlin."},"operationCost":1,"rarity":"ERarityEnum::Rare","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::NavalWarfare","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Convert"],"hasDeployment":true,"spawnCardName":"card_unit_routed_troops","Image":{"AssetPathName":"/Game/Assets/Textures/Images/Poland/NavalWarfare/t_3rd_carpathian.t_3rd_carpathian","SubPathString":""},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/15th_WOLVES_REGIMENT.15th_WOLVES_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":347.0},"historyPhotoDescription":{"Namespace":"card_poland","Key":"card_unit_15th_wolves_regiment_photo","SourceString":"Polish infantry in defensive position during the German invasion, September 1939.","LocalizedString":"Polish infantry in defensive position during the German invasion, September 1939."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"tmpCard","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"CanPlayFromHand","owner":"card_unit_15th_wolves_regiment_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","direction":"in"},{"name":"CallFunc_GetTargetedCard_card","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_IsUnit_isIt","type":"bool","direction":"in"}],"body":[{"op":"Context","at":0,"object":{"op":"Variable","name":"cardFunction","type":"ACardFunctionsStub*","scope":"member","sourceOp":"InstanceVariable"},"value":{"op":"LocalVirtualFunction","name":"GetTargetedCard","signature":"CardFunctionsStub.GetTargetedCard","args":[{"op":"Self"},{"op":"Variable","name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","scope":"local","sourceOp":"LocalVariable"},{"op":"Variable","name":"CallFunc_GetTargetedCard_card","type":"UBaseCardObject*","scope":"local","sourceOp":"LocalVariable"}]}},{"op":"JumpIfNot","at":