{"format":"kards-original-reference","version":1,"id":"f65636425d71a4ed","name":"card_event_hmas_warramunga","package":"/Game/Blueprints/Cards/ANZAC/events/card_event_hmas_warramunga","parent":"UBaseCardObject","card":{"title":"HMAS WARRAMUNGA","text":"Choose a card in hand. Move it all the way to the left. Reduce its cost by 1 if it is an ANZAC card.","flavorText":"HMAS Warramunga was a Tribal-class destroyer of the Royal Australian Navy, built at Cockatoo Island Dockyard in Sydney. She was commissioned in late 1942 and first served on convoy escort duty between Queensland and New Guinea. In 1943, she joined the joint Australian and US Task Force 74, supporting Allied operations across the South West Pacific. Warramunga took part in a busy series of amphibious operations. She helped cover the landings at Kiriwina and Woodlark Islands, escorted the damaged cruiser HMAS Hobart after a Japanese torpedo hit, and later supported landings at Arawe and Cape Gloucester. In 1944, she supported the landings in the Admiralty Islands, at Tanamera Bay, Wakde Sarmi, Biak, Morotai, and Leyte. During the Battle of Leyte, she escorted damaged Allied cruisers back to safety. In 1945, Warramunga supported the landings at Lingayen Gulf, Tarakan, and Wewak. She was present in Tokyo Bay when Japan surrendered in September 1945. She was decorated with five battle honours for its service during WWII : Pacific, New Guinea, Leyte Gulf, Lingayen Gulf, and Borneo.","faction":"Anzac","type":"order","rarity":"Common","cost":0,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"GameplayTags":["subtype.navy"],"Name":"card_event_hmas_warramunga","title":{"Namespace":"card_anzac","Key":"card_event_hmas_warramunga_title","SourceString":"HMAS WARRAMUNGA","LocalizedString":"HMAS WARRAMUNGA"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Anzac","Text":{"Namespace":"card_anzac","Key":"card_event_hmas_warramunga_text","SourceString":"Choose a card in hand. Move it all the way to the left. Reduce its cost by 1 if it is an ANZAC card.","LocalizedString":"Choose a card in hand. Move it all the way to the left. Reduce its cost by 1 if it is an ANZAC card."},"flavorText":{"Namespace":"card_anzac","Key":"card_event_hmas_warramunga_history","SourceString":"HMAS Warramunga was a Tribal-class destroyer of the Royal Australian Navy, built at Cockatoo Island Dockyard in Sydney. She was commissioned in late 1942 and first served on convoy escort duty between Queensland and New Guinea. In 1943, she joined the joint Australian and US Task Force 74, supporting Allied operations across the South West Pacific. Warramunga took part in a busy series of amphibious operations. She helped cover the landings at Kiriwina and Woodlark Islands, escorted the damaged cruiser HMAS Hobart after a Japanese torpedo hit, and later supported landings at Arawe and Cape Gloucester. In 1944, she supported the landings in the Admiralty Islands, at Tanamera Bay, Wakde Sarmi, Biak, Morotai, and Leyte. During the Battle of Leyte, she escorted damaged Allied cruisers back to safety. In 1945, Warramunga supported the landings at Lingayen Gulf, Tarakan, and Wewak. She was present in Tokyo Bay when Japan surrendered in September 1945. She was decorated with five battle honours for its service during WWII : Pacific, New Guinea, Leyte Gulf, Lingayen Gulf, and Borneo.","LocalizedString":"HMAS Warramunga was a Tribal-class destroyer of the Royal Australian Navy, built at Cockatoo Island Dockyard in Sydney. She was commissioned in late 1942 and first served on convoy escort duty between Queensland and New Guinea. In 1943, she joined the joint Australian and US Task Force 74, supporting Allied operations across the South West Pacific. Warramunga took part in a busy series of amphibious operations. She helped cover the landings at Kiriwina and Woodlark Islands, escorted the damaged cruiser HMAS Hobart after a Japanese torpedo hit, and later supported landings at Arawe and Cape Gloucester. In 1944, she supported the landings in the Admiralty Islands, at Tanamera Bay, Wakde Sarmi, Biak, Morotai, and Leyte. During the Battle of Leyte, she escorted damaged Allied cruisers back to safety. In 1945, Warramunga supported the landings at Lingayen Gulf, Tarakan, and Wewak. She was present in Tokyo Bay when Japan surrendered in September 1945. She was decorated with five battle honours for its service during WWII : Pacific, New Guinea, Leyte Gulf, Lingayen Gulf, and Borneo."},"rarity":"ERarityEnum::Common","waitWithOnOtherCardPlayedUntilHandTargetSelected":true,"selectHandCardNotifyText":{"Namespace":"","Key":"74EC10044B83B99C2C922588B432FECE","SourceString":"Choose a card to move to left-most in hand","LocalizedString":"Choose a card to move to left-most in hand"},"cardSet":"ECardSetEnum::OceaniaStorm","isInPermanentPool":true,"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Organic_War_Drums_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Organic_War_Drums_3.0"},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/HMAS_WARRAMUNGA.HMAS_WARRAMUNGA","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_anzac","Key":"card_event_hmas_warramunga_photo","SourceString":"HMAS Warramunga in 1944.","LocalizedString":"HMAS Warramunga in 1944."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"Notes":"Image needed to be customized","isDefenseBuff":true},"variables":[{"name":"Hand Target Card ID","type":"int32","direction":"in"},{"name":"selectedLocationNumber","type":"int32","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_hmas_warramunga","owner":"card_event_hmas_warramunga_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name"