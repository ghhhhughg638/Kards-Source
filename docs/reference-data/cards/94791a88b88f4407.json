{"format":"kards-original-reference","version":1,"id":"94791a88b88f4407","name":"card_unit_a5m4_claude","package":"/Game/Blueprints/Cards/Japan/Base/units/card_unit_a5m4_claude","parent":"UBaseCardObject","card":{"title":"A5M4 CLAUDE","text":"Deployment: Give another friendly unit -1 operation cost.","flavorText":"The Mitsubishi A5M was a Japanese carrier based fighter and the world's first monoplane shipboard fighter to enter service, and the predecessor of the famous Mitsubishi A6M \"Zero\". It was introduced in 1936 and was highly effective in the early stages of the Second Sino-Japanese War. Even though the aircraft was only armed with two 7.7 mm machine-guns, it proved effective and damage-tolerant, with excellent maneuverability and robust construction.  Later in WWII the A5M's also provided much-needed escorts for the vulnerable Mitsubishi G3M bombers.","faction":"Japan","type":"fighter","rarity":"Uncommon","cost":2,"operationCost":2,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_a5m4_claude","title":{"Namespace":"card_japan","Key":"card_unit_a5m4_claude_title","SourceString":"A5M4 CLAUDE","LocalizedString":"A5M4 CLAUDE"},"Type":"ETypeEnum::fighter","attack":2,"defense":3,"range":2,"faction":"EFactionEnum::Japan","kredits":2,"Text":{"Namespace":"card_japan","Key":"card_unit_a5m4_claude_text","SourceString":"Deployment: Give another friendly unit -1 operation cost.","LocalizedString":"Deployment: Give another friendly unit -1 operation cost."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_a5m4_claude_history","SourceString":"The Mitsubishi A5M was a Japanese carrier based fighter and the world's first monoplane shipboard fighter to enter service, and the predecessor of the famous Mitsubishi A6M \"Zero\". It was introduced in 1936 and was highly effective in the early stages of the Second Sino-Japanese War. Even though the aircraft was only armed with two 7.7 mm machine-guns, it proved effective and damage-tolerant, with excellent maneuverability and robust construction.  Later in WWII the A5M's also provided much-needed escorts for the vulnerable Mitsubishi G3M bombers.","LocalizedString":"The Mitsubishi A5M was a Japanese carrier based fighter and the world's first monoplane shipboard fighter to enter service, and the predecessor of the famous Mitsubishi A6M \"Zero\". It was introduced in 1936 and was highly effective in the early stages of the Second Sino-Japanese War. Even though the aircraft was only armed with two 7.7 mm machine-guns, it proved effective and damage-tolerant, with excellent maneuverability and robust construction.  Later in WWII the A5M's also provided much-needed escorts for the vulnerable Mitsubishi G3M bombers."},"operationCost":2,"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Basic","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/t_a5m4_claude.t_a5m4_claude","SubPathString":""},"artist":"Roy Grinnell","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/A5M4_CLAUDE.A5M4_CLAUDE","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":219.0},"historyPhotoSource":"Werneth, Ron, Beyond Pearl Harbor: The Untold Stories of Japan's Naval Airmen, Schiffer Military History, Atglen, PA, 2008, p. 247. ","historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_a5m4_claude_photo","SourceString":"Mitsubishi A5M, from the aircraft carrier Akagi, ca 1938-39.","LocalizedString":"Mitsubishi A5M, from the aircraft carrier Akagi, ca 1938-39."},"historyTypeDescription":{"Namespace":"card_japan","Key":"card_unit_a5m4_claude_header","SourceString":"Fighter Aircraft","LocalizedString":"Fighter Aircraft"},"blowUpExplosion":{"ObjectName":"ParticleSyste