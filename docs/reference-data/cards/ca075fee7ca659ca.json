{"format":"kards-original-reference","version":1,"id":"ca075fee7ca659ca","name":"card_unit_79th_infantry_regiment","package":"/Game/Blueprints/Cards/Japan/OceaniaStorm/units/card_unit_79th_infantry_regiment","parent":"UBaseCardObject","card":{"title":"79th INFANTRY REGIMENT","text":"When you play a Sunny card, give your units +2 attack and remove pin on them.","flavorText":"The 79th Infantry Regiment served with the 20th Division, a formation known as the Morning Division. By the time the division was sent to New Guinea, the 79th fought beside the 78th and 80th Infantry Regiments, with artillery, reconnaissance, engineer, and transport units supporting them. In 1943, the 20th Division was transferred to the Japanese Eighteenth Army in New Guinea. Its troops faced a harsh campaign of jungle movement, disease, shortages, and Allied pressure. After Allied landings at Lae and Nadzab, Lieutenant General Shigeru Katagiri led the division on a difficult march of about 200 miles to reinforce Finschhafen. The division fought in the Huon Peninsula campaign and gathered around Sattelberg, but was forced back after defeat there in October 1943. Katagiri was later killed while moving from Madang to Wewak. The remaining troops, later known as Nakai Detachment, continued fighting Australian forces in the Markham, Ramu, and Finisterre campaigns. Of about 25,000 men in the 20th Division, only 1,711 survived the war.","faction":"Japan","type":"infantry","rarity":"Rare","cost":4,"operationCost":1,"attack":4,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_79th_infantry_regiment","title":{"Namespace":"card_japan","Key":"card_unit_79th_infantry_regiment_title","SourceString":"79th INFANTRY REGIMENT","LocalizedString":"79th INFANTRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":4,"defense":5,"range":1,"faction":"EFactionEnum::Japan","kredits":4,"Text":{"Namespace":"card_japan","Key":"card_unit_79th_infantry_regiment_text","SourceString":"When you play a Sunny card, give your units +2 attack and remove pin on them.","LocalizedString":"When you play a Sunny card, give your units +2 attack and remove pin on them."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_79th_infantry_regiment_history","SourceString":"The 79th Infantry Regiment served with the 20th Division, a formation known as the Morning Division. By the time the division was sent to New Guinea, the 79th fought beside the 78th and 80th Infantry Regiments, with artillery, reconnaissance, engineer, and transport units supporting them. In 1943, the 20th Division was transferred to the Japanese Eighteenth Army in New Guinea. Its troops faced a harsh campaign of jungle movement, disease, shortages, and Allied pressure. After Allied landings at Lae and Nadzab, Lieutenant General Shigeru Katagiri led the division on a difficult march of about 200 miles to reinforce Finschhafen. The division fought in the Huon Peninsula campaign and gathered around Sattelberg, but was forced back after defeat there in October 1943. Katagiri was later killed while moving from Madang to Wewak. The remaining troops, later known as Nakai Detachment, continued fighting Australian forces in the Markham, Ramu, and Finisterre campaigns. Of about 25,000 men in the 20th Division, only 1,711 survived the war.","LocalizedString":"The 79th Infantry Regiment served with the 20th Division, a formation known as the Morning Division. By the time the division was sent to New Guinea, the 79th fought beside the 78th and 80th Infantry Regiments, with artillery, reconnaissance, engineer, and transport units supporting them. In 1943, the 20th Division was transferred to the Japanese Eighteenth Army in New Guinea. Its troops faced a harsh campaign of jungle movement, disease, shortages, and Allied pressure. After Allied landings at Lae and Nadzab, Lieutenant General Shigeru Katagiri led the division on a difficult march of about 200 miles to reinforce Finschhafen. The division fought in the Huon Peninsula campaign and gathered around Sattelberg, but was forced back after defeat there in October 1943. Katagiri was later killed while moving from Madang to Wewak. The remaining troops, later known as Nakai Detachment, continued fighting Australian forces in the Markham, Ramu, and Finisterre campaigns. Of about 25,000 men in the 20th Division, only 1,711 survived the war."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"hasBlitz":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/79th_INFANTRY_REGIMENT.79th_INFANTRY_REGIMENT","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_79th_infantry_regiment_photo","SourceString":"Japanese soldiers gathering drinking water along the Kokoda Trail in New Guinea. Date unknown.","LocalizedString":"Japanese soldiers gathering drinking water along the Kokoda Trail in New Guinea. Date unknown."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"isAttackBuff":true,"isDefenseBuff":true},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_79th_infantry_regiment","owner":"card_unit_79th_infantry_regiment_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntI