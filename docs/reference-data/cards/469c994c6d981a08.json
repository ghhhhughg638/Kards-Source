{"format":"kards-original-reference","version":1,"id":"469c994c6d981a08","name":"card_unit_33rd_livorno","package":"/Game/Blueprints/Cards/Italy/units/card_unit_33rd_livorno","parent":"UBaseCardObject","card":{"title":"33rd LIVORNO REGIMENT","text":"Reduce attack of this unit by 1 each time it is attacked, to a minimum of 1.","flavorText":"During WWII the 33rd Livorno Regiment was part of the 4th Infantry Division Livorno, a mountain infantry division of the Italian Army. The division fought in France in 1940 and in 1943 it was located in Sicily where it fought against the invading Allied forces. After heavy fighting the Livorno Division was forced to retreat through the Sicilian towns of Agira and Regalbuto where it suffered heavy losses. Due to total lack of supplies the division was forced to evacuate to mainland Italy, suffering further losses on the way. Only 4200 men of the initial 13000 where evacuated, and following the armistice between Italy and the Allies in 1943, the remainder of the division surrendered to the German forces who had by then occupied Italy.","faction":"Italy","type":"infantry","rarity":"Uncommon","cost":4,"operationCost":1,"attack":5,"defense":7},"defaults":{"Name":"card_unit_33rd_livorno","title":{"Namespace":"card_italy","Key":"card_unit_33rd_livorno_title","SourceString":"33rd LIVORNO REGIMENT","LocalizedString":"33rd LIVORNO REGIMENT"},"Type":"ETypeEnum::infantry","attack":5,"defense":7,"range":1,"faction":"EFactionEnum::Italy","kredits":4,"Text":{"Namespace":"card_italy","Key":"card_unit_33rd_livorno_text","SourceString":"Reduce attack of this unit by 1 each time it is attacked, to a minimum of 1.","LocalizedString":"Reduce attack of this unit by 1 each time it is attacked, to a minimum of 1."},"flavorText":{"Namespace":"card_italy","Key":"card_unit_33rd_livorno_history","SourceString":"During WWII the 33rd Livorno Regiment was part of the 4th Infantry Division Livorno, a mountain infantry division of the Italian Army. The division fought in France in 1940 and in 1943 it was located in Sicily where it fought against the invading Allied forces. After heavy fighting the Livorno Division was forced to retreat through the Sicilian towns of Agira and Regalbuto where it suffered heavy losses. Due to total lack of supplies the division was forced to evacuate to mainland Italy, suffering further losses on the way. Only 4200 men of the initial 13000 where evacuated, and following the armistice between Italy and the Allies in 1943, the remainder of the division surrendered to the German forces who had by then occupied Italy.","LocalizedString":"During WWII the 33rd Livorno Regiment was part of the 4th Infantry Division Livorno, a mountain infantry division of the Italian Army. The division fought in France in 1940 and in 1943 it was located in Sicily where it fought against the invading Allied forces. After heavy fighting the Livorno Division was forced to retreat through the Sicilian towns of Agira and Regalbuto where it suffered heavy losses. Due to total lack of supplies the division was forced to evacuate to mainland Italy, suffering further losses on the way. Only 4200 men of the initial 13000 where evacuated, and following the armistice between Italy and the Allies in 1943, the remainder of the division surrendered to the German forces who had by then occupied Italy."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Expansion2019","isReserved":true,"showBoostIcon":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardAttacks"],"soundEnterPlay":{"ObjectName":"SoundWave'Motorized_INfantry_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Motorized_INfantry_Move_FX.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Motorized_INfantry_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Motorized_INfantry_Move_FX.0"},"soundBlowUp":{"ObjectName":"SoundWave'Explosion02'","ObjectPath":"kards/Content/StarterContent/Audio/E