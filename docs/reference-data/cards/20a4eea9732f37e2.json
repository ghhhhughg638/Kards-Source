{"format":"kards-original-reference","version":1,"id":"20a4eea9732f37e2","name":"card_unit_77th_regiment","package":"/Game/Blueprints/Cards/Japan/BloodIron/units/card_unit_77th_regiment","parent":"UBaseCardObject","card":{"title":"77th REGIMENT","text":"After this unit destroys a unit, add a 20th INFANTRY REGIMENT to your support line.","flavorText":"The 77th Infantry Regiment was a regiment of the 30th Division of the Imperial Japanese Army during WWII. The division was formed in 1943 and was initially stationed on Mindanao in the Philippines, but it was sent to Leyte to reinforce the Japanese defenses during the Battle of Leyte. The division faced heavy fighting, but was unable to stop the US advance. After failing to hold Leyte, the division retreated to Mindanao Island, where it established defensive lines but was overstretched and couldn't prevent US forces from pushing inland. Scattered remnants of the division retreated to the mountains of Central Mindanao, where they survived until Japan's surrender in August 1945. Smaller detachments were eliminated in Sarangani Bay in July 1945.","faction":"Japan","type":"infantry","rarity":"Rare","cost":3,"operationCost":1,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_77th_regiment","title":{"Namespace":"card_japan","Key":"card_unit_77th_regiment_title","SourceString":"77th REGIMENT","LocalizedString":"77th REGIMENT"},"Type":"ETypeEnum::infantry","attack":3,"defense":4,"range":1,"faction":"EFactionEnum::Japan","kredits":3,"Text":{"Namespace":"card_japan","Key":"card_unit_77th_regiment_text","SourceString":"After this unit destroys a unit, add a 20th INFANTRY REGIMENT to your support line.","LocalizedString":"After this unit destroys a unit, add a 20th INFANTRY REGIMENT to your support line."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_77th_regiment_history","SourceString":"The 77th Infantry Regiment was a regiment of the 30th Division of the Imperial Japanese Army during WWII. The division was formed in 1943 and was initially stationed on Mindanao in the Philippines, but it was sent to Leyte to reinforce the Japanese defenses during the Battle of Leyte. The division faced heavy fighting, but was unable to stop the US advance. After failing to hold Leyte, the division retreated to Mindanao Island, where it established defensive lines but was overstretched and couldn't prevent US forces from pushing inland. Scattered remnants of the division retreated to the mountains of Central Mindanao, where they survived until Japan's surrender in August 1945. Smaller detachments were eliminated in Sarangani Bay in July 1945.","LocalizedString":"The 77th Infantry Regiment was a regiment of the 30th Division of the Imperial Japanese Army during WWII. The division was formed in 1943 and was initially stationed on Mindanao in the Philippines, but it was sent to Leyte to reinforce the Japanese defenses during the Battle of Leyte. The division faced heavy fighting, but was unable to stop the US advance. After failing to hold Leyte, the division retreated to Mindanao Island, where it established defensive lines but was overstretched and couldn't prevent US forces from pushing inland. Scattered remnants of the division retreated to the mountains of Central Mindanao, where they survived until Japan's surrender in August 1945. Smaller detachments were eliminated in Sarangani Bay in July 1945."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::BloodAndIron","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardDestroyed"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Shock","EHelpBubbleTypes::Trigger","EHelpBubbleTypes::Blitz"],"hasBlitz":true,"hasShock":true,"spawnCardName":"card_unit_20th_infantry_regiment","Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/Winter_2024/t_77th_regiment_vs2.t_77th_regiment_vs2","SubPathString":""},"artist":"Japanese WWII Postcard","historyPhoto":{"AssetPathName