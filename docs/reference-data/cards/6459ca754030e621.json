{"format":"kards-original-reference","version":1,"id":"6459ca754030e621","name":"card_event_supply_shortage","package":"/Game/Blueprints/Cards/Britain/WorldAtWar/events/card_event_supply_shortage","parent":"UBaseCardObject","card":{"title":"SUPPLY SHORTAGE","text":"Enemy units get: \"Receives 1 damage at the start of owner's turn.\"","flavorText":"A key contributor to the Allied victory in the North African Campaign was Ultra; the Allied intelligence project which allowed them to decrypt high level enemy communications. Ultra provided valuable information about the times and routes of Axis supply shipments across the Mediterranean to Africa and this information was used to intercept and destroy them. It is estimated that 40% to 60% of Axis supply shipping was located and destroyed due to decrypted information. This gave a crippling blow to the Afrika Korps as it was denied essential supplies for the war effort, from fuel to equipment ranging from tanks and guns all the way down to food and uniforms.","faction":"Britain","type":"order","rarity":"Common","cost":3,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_supply_shortage","title":{"Namespace":"card_britain","Key":"card_event_supply_shortage_title","SourceString":"SUPPLY SHORTAGE","LocalizedString":"SUPPLY SHORTAGE"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Britain","kredits":3,"Text":{"Namespace":"card_britain","Key":"card_event_supply_shortage_text","SourceString":"Enemy units get: \"Receives 1 damage at the start of owner's turn.\"","LocalizedString":"Enemy units get: \"Receives 1 damage at the start of owner's turn.\""},"flavorText":{"Namespace":"card_britain","Key":"card_event_supply_shortage_history","SourceString":"A key contributor to the Allied victory in the North African Campaign was Ultra; the Allied intelligence project which allowed them to decrypt high level enemy communications. Ultra provided valuable information about the times and routes of Axis supply shipments across the Mediterranean to Africa and this information was used to intercept and destroy them. It is estimated that 40% to 60% of Axis supply shipping was located and destroyed due to decrypted information. This gave a crippling blow to the Afrika Korps as it was denied essential supplies for the war effort, from fuel to equipment ranging from tanks and guns all the way down to food and uniforms.","LocalizedString":"A key contributor to the Allied victory in the North African Campaign was Ultra; the Allied intelligence project which allowed them to decrypt high level enemy communications. Ultra provided valuable information about the times and routes of Axis supply shipments across the Mediterranean to Africa and this information was used to intercept and destroy them. It is estimated that 40% to 60% of Axis supply shipping was located and destroyed due to decrypted information. This gave a crippling blow to the Afrika Korps as it was denied essential supplies for the war effort, from fuel to equipment ranging from tanks and guns all the way down to food and uniforms."},"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::WorldAtWar","isReserved":true,"usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"draftBaseWeight":0.8,"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/CandidateArtwork/British_torpedoing_ship.British_torpedoing_ship","SubPathString":""},"artist":"Rebellion","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/SUPPLY_SHORTAGE.SUPPLY_SHORTAGE","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":337.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_event_supply_shortage_photo","SourceString":"Italian supply vessel Pietro Querini sinks off of Tunisia after being torpedoed by the British submar