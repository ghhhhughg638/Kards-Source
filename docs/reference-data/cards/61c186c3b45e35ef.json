{"format":"kards-original-reference","version":1,"id":"61c186c3b45e35ef","name":"card_event_task_force_44","package":"/Game/Blueprints/Cards/ANZAC/events/card_event_task_force_44","parent":"UBaseCardObject","card":{"title":"TASK FORCE 44","text":"Forecast. Deal 2 damage to a unit. Deal 3 damage instead if this card was left-most in hand.","flavorText":"Task Force 44 was an Allied naval force made up of US Navy and Royal Australian Navy warships operating during WWII. It was created in 1942 from the ANZAC Squadron and was tasked with defending northeast Australia, New Guinea, and nearby sea routes from Japanese attacks. Its first commander was Rear Admiral John Gregory Crace of the Royal Australian Navy. It was later commanded by Rear Admiral Victor Crutchley of the British Royal Navy. The force’s best known action came during the Battle of the Coral Sea. In May 1942, Crace led HMAS Australia, HMAS Hobart, USS Chicago, and several US destroyers toward the Jomard Passage to block any Japanese ships moving toward Port Moresby, the capital city of Papua New Guinea. Japanese aircraft attacked the force with torpedoes and bombs, but none of the ships were hit. A later mistaken attack by US aircraft also failed to damage the ships. Task Force 44 later helped escort Allied convoys around Australia, New Guinea, and the Coral Sea. It also supported the early Guadalcanal campaign and took part in the Battle of Savo Island. In 1943, it was redesignated Task Force 74 and served under the US Seventh Fleet.","faction":"Anzac","type":"order","rarity":"Common","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.forecast"],"Name":"card_event_task_force_44","title":{"Namespace":"card_anzac","Key":"card_event_task_force_44_title","SourceString":"TASK FORCE 44","LocalizedString":"TASK FORCE 44"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Anzac","kredits":2,"Text":{"Namespace":"card_anzac","Key":"card_event_task_force_44_text","SourceString":"Forecast. Deal 2 damage to a unit. Deal 3 damage instead if this card was left-most in hand.","LocalizedString":"Forecast. Deal 2 damage to a unit. Deal 3 damage instead if this card was left-most in hand."},"flavorText":{"Namespace":"card_anzac","Key":"card_event_task_force_44_history","SourceString":"Task Force 44 was an Allied naval force made up of US Navy and Royal Australian Navy warships operating during WWII. It was created in 1942 from the ANZAC Squadron and was tasked with defending northeast Australia, New Guinea, and nearby sea routes from Japanese attacks. Its first commander was Rear Admiral John Gregory Crace of the Royal Australian Navy. It was later commanded by Rear Admiral Victor Crutchley of the British Royal Navy. The force’s best known action came during the Battle of the Coral Sea. In May 1942, Crace led HMAS Australia, HMAS Hobart, USS Chicago, and several US destroyers toward the Jomard Passage to block any Japanese ships moving toward Port Moresby, the capital city of Papua New Guinea. Japanese aircraft attacked the force with torpedoes and bombs, but none of the ships were hit. A later mistaken attack by US aircraft also failed to damage the ships. Task Force 44 later helped escort Allied convoys around Australia, New Guinea, and the Coral Sea. It also supported the early Guadalcanal campaign and took part in the Battle of Savo Island. In 1943, it was redesignated Task Force 74 and served under the US Seventh Fleet.","LocalizedString":"Task Force 44 was an Allied naval force made up of US Navy and Royal Australian Navy warships operating during WWII. It was created in 1942 from the ANZAC Squadron and was tasked with defending northeast Australia, New Guinea, and nearby sea routes from Japanese attacks. Its first commander was Rear Admiral John Gregory Crace of the Royal Australian Navy. It was later commanded by Rear Admiral Victor Crutchley of the British Royal Navy. The force’s best known action came during the Battle of the Coral Sea. In May 1942, Crace led HMAS Australia, HMAS Hobart, USS Chicago, and several US destroyers toward the Jomard Passage to block any Japanese ships moving toward Port Moresby, the capital city of Papua New Guinea. Japanese aircraft attacked the force with torpedoes and bombs, but none of the ships were hit. A later mistaken attack by US aircraft also failed to damage the ships. Task Force 44 later helped escort Allied convoys around Australia, New Guinea, and the Coral Sea. It also supported the early Guadalcanal campaign and took part in the Battle of Savo Island. In 1943, it was redesignated Task Force 74 and served under the US Seventh Fleet."},"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::OceaniaStorm","usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"spawnCardName":"card_event_sunny1_blue_sky;card_event_rain1_mist;card_event_storm1_gale","soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Organic_War_Drums_4'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Organic_War_Drums_4.0"},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/TASK_FORCE_44.TASK_FORCE_44","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_anzac","Key":"card_event_task_force_44_photo","SourceString":"HMAS Australia under air attack during the Battle of the Coral Sea, 1942.","LocalizedString":"HMAS Australia under air attack during the Battle of the Coral Sea, 1942."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""}},"variables":[],"functions":[{"name":"CanPlayFromHand","owner":"card_event_task_force_44_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","d