{"format":"kards-original-reference","version":1,"id":"c3a7ad6778f883a7","name":"card_unit_342_fusiliers","package":"/Game/Blueprints/Cards/Germany/CovertOp/units/card_unit_342_fusiliers","parent":"UBaseCardObject","card":{"title":"342. FÜSILIERS","text":"When this unit moves into the frontline, units there get +2 attack.","flavorText":"The 342nd Füsilier Battalion was a battalion of the 342nd Infantry Division of the Wehrmacht during WWII. The division was deployed in France in 1940 as part of the occupation forces, but in 1941 it was sent to Belgrade in Yugoslavia and assigned to counterinsurgency operations in the occupied territory of Serbia. In 1942 the division was sent to the Eastern Front where it fought in the Battles of Rzhev. They retreated after the Battle of Kursk as part of the Army Group Centre. In 1944 the 342nd Division fought at Kovel in Ukraine, during the withdrawal across eastern Poland and at the Baranov bridgehead on the Vistula. During the Vistula-Oder Offensive, in 1945, the division suffered significant losses and was nearly destroyed. However, it kept fighting until it was trapped in the Halbe pocket during the Battle of Berlin. A few members of the division managed to break through the encirclement and surrendered to the United States Army in Travemünde, near Lübeck, on the Baltic Sea.","faction":"Germany","type":"infantry","rarity":"Common","cost":3,"operationCost":1,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_342_fusiliers","title":{"Namespace":"card_germany","Key":"card_unit_342_fusiliers_title","SourceString":"342. FÜSILIERS","LocalizedString":"342. FÜSILIERS"},"Type":"ETypeEnum::infantry","attack":3,"defense":4,"range":1,"faction":"EFactionEnum::Germany","kredits":3,"Text":{"Namespace":"card_germany","Key":"card_unit_342_fusiliers_text","SourceString":"When this unit moves into the frontline, units there get +2 attack.","LocalizedString":"When this unit moves into the frontline, units there get +2 attack."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_342_fusiliers_history","SourceString":"The 342nd Füsilier Battalion was a battalion of the 342nd Infantry Division of the Wehrmacht during WWII. The division was deployed in France in 1940 as part of the occupation forces, but in 1941 it was sent to Belgrade in Yugoslavia and assigned to counterinsurgency operations in the occupied territory of Serbia. In 1942 the division was sent to the Eastern Front where it fought in the Battles of Rzhev. They retreated after the Battle of Kursk as part of the Army Group Centre. In 1944 the 342nd Division fought at Kovel in Ukraine, during the withdrawal across eastern Poland and at the Baranov bridgehead on the Vistula. During the Vistula-Oder Offensive, in 1945, the division suffered significant losses and was nearly destroyed. However, it kept fighting until it was trapped in the Halbe pocket during the Battle of Berlin. A few members of the division managed to break through the encirclement and surrendered to the United States Army in Travemünde, near Lübeck, on the Baltic Sea.","LocalizedString":"The 342nd Füsilier Battalion was a battalion of the 342nd Infantry Division of the Wehrmacht during WWII. The division was deployed in France in 1940 as part of the occupation forces, but in 1941 it was sent to Belgrade in Yugoslavia and assigned to counterinsurgency operations in the occupied territory of Serbia. In 1942 the division was sent to the Eastern Front where it fought in the Battles of Rzhev. They retreated after the Battle of Kursk as part of the Army Group Centre. In 1944 the 342nd Division fought at Kovel in Ukraine, during the withdrawal across eastern Poland and at the Baranov bridgehead on the Vistula. During the Vistula-Oder Offensive, in 1945, the division suffered significant losses and was nearly destroyed. However, it kept fighting until it was trapped in the Halbe pocket during the Battle of Berlin. A few members of the division managed to break through the encirclement and surrendered to the United States Army in Travemünde, near Lübeck, on the Baltic Sea."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::CurrentExpansion","EffectType":"ECardEffectTypes::Trigger","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Trigger"],"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/CandidateArtwork/Summer_24/t_fusiliers.t_fusiliers","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/342__FUSILIERS.342__FUSILIERS","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":501.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_342_fusiliers_photo","SourceString":"Infantry and Panzer III tanks of Army Group Centre on the Eastern Front, August 1942.","LocalizedString":"Infantry and Panzer III tanks of Army Group Centre on the Eastern Front, August 1942."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"tempCard","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_342_fusiliers","owner":"card_unit_342_fusiliers_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"CallFunc_IsValid_ReturnValue","type":"bool","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direc