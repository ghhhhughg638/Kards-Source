{"format":"kards-original-reference","version":1,"id":"77d1465c2f1cf56c","name":"card_unit_36_kradschutzen","package":"/Game/Blueprints/Cards/Germany/Homefront/units/card_unit_36_kradschutzen","parent":"UBaseCardObject","card":{"title":"36. KRADSCHÜTZEN","text":"When a friendly German unit moves into the frontline, give it +1 attack and -1 operation cost.","flavorText":"Kradschützen-Bataillon 36 was formed on 9 November 1940 by renaming Machine Gun Battalion 11, which had been based in Lahr, in Wehrkreis V military district. The battalion became part of the 36th Infantry Division (motorized) and served with it during the invasion of the Soviet Union beginning in June 1941. As motorcycle infantry, Kradschützen units were used for rapid movement, reconnaissance, and mobile infantry support, especially during fast-paced operations in the early years of the war. On 15 March 1942, the remnants of Reconnaissance Detachment 36 were absorbed into the battalion. This reorganization provided a new headquarters and added three companies. In March 1943, a plan to rename the unit as Panzer Reconnaissance Detachment 136 was canceled when the entire 36th Division was ordered to give up its vehicles. The battalion was eventually renamed Divisional Fusilier Battalion 36 on 1 January 1944 following a directive issued in November 1943. Replacement troops for Kradschützen-Bataillon 36 were initially supplied by Motorcycle Replacement Battalion 6, and later by Battalion 7, from June 1942.","faction":"Germany","type":"infantry","rarity":"Rare","cost":2,"operationCost":1,"attack":1,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_36_kradschutzen","title":{"Namespace":"card_germany","Key":"card_unit_36_kradschutzen_title","SourceString":"36. KRADSCHÜTZEN","LocalizedString":"36. KRADSCHÜTZEN"},"Type":"ETypeEnum::infantry","attack":1,"defense":4,"range":1,"faction":"EFactionEnum::Germany","kredits":2,"Text":{"Namespace":"card_germany","Key":"card_unit_36_kradschutzen_text","SourceString":"When a friendly German unit moves into the frontline, give it +1 attack and -1 operation cost.","LocalizedString":"When a friendly German unit moves into the frontline, give it +1 attack and -1 operation cost."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_36_kradschutzen_history","SourceString":"Kradschützen-Bataillon 36 was formed on 9 November 1940 by renaming Machine Gun Battalion 11, which had been based in Lahr, in Wehrkreis V military district. The battalion became part of the 36th Infantry Division (motorized) and served with it during the invasion of the Soviet Union beginning in June 1941. As motorcycle infantry, Kradschützen units were used for rapid movement, reconnaissance, and mobile infantry support, especially during fast-paced operations in the early years of the war. On 15 March 1942, the remnants of Reconnaissance Detachment 36 were absorbed into the battalion. This reorganization provided a new headquarters and added three companies. In March 1943, a plan to rename the unit as Panzer Reconnaissance Detachment 136 was canceled when the entire 36th Division was ordered to give up its vehicles. The battalion was eventually renamed Divisional Fusilier Battalion 36 on 1 January 1944 following a directive issued in November 1943. Replacement troops for Kradschützen-Bataillon 36 were initially supplied by Motorcycle Replacement Battalion 6, and later by Battalion 7, from June 1942.","LocalizedString":"Kradschützen-Bataillon 36 was formed on 9 November 1940 by renaming Machine Gun Battalion 11, which had been based in Lahr, in Wehrkreis V military district. The battalion became part of the 36th Infantry Division (motorized) and served with it during the invasion of the Soviet Union beginning in June 1941. As motorcycle infantry, Kradschützen units were used for rapid movement, reconnaissance, and mobile infantry support, especially during fast-paced operations in the early years of the war. On 15 March 1942, the remnants of Reconnaissance Detachment 36 were absorbed into the battalion. This reorganization provided a new headquarters and added three companies. In March 1943, a plan to rename the unit as Panzer Reconnaissance Detachment 136 was canceled when the entire 36th Division was ordered to give up its vehicles. The battalion was eventually renamed Divisional Fusilier Battalion 36 on 1 January 1944 following a directive issued in November 1943. Replacement troops for Kradschützen-Bataillon 36 were initially supplied by Motorcycle Replacement Battalion 6, and later by Battalion 7, from June 1942."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardMoveToFrontline"],"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/36__KRADSCHUTZEN.36__KRADSCHUTZEN","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":355.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_36_kradschutzen_photo","SourceString":"Motorized infantry on the Western Front in January 1940.","LocalizedString":"Motorized infantry on the Western Front in January 1940."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_36_kradschutzen","owner":"card_unit_36_kradschutzen_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"K2Node_Event_cardMoved","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Ev