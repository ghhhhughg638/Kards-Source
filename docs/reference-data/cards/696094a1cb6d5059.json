{"format":"kards-original-reference","version":1,"id":"696094a1cb6d5059","name":"card_unit_panzer_iii_f","package":"/Game/Blueprints/Cards/Germany/Breakthrough/units/card_unit_panzer_iii_f","parent":"UBaseCardObject","card":{"title":"PANZER III-F","text":"Your German tanks have Blitz. Deployment: Your other tanks get +1+1.","flavorText":"The Panzer III, or Panzerkampfwagen III, was a German medium tank that was used by the Axis during WWII. The tank was first used in service in 1939 and used throughout the war, but production was halted in 1943 when more powerful anti tank guns were needed against the Soviet T-34 tank. The Panzer III-F was one of many variants and was the first one to be mass produced, with 450 tanks built, and was used in all theaters of the war. The tank had a crew of 5 (commander, gunner, loader, driver, radio operator/bow machine-gunner), a secondary armament of  2–3 × 7.92 mm Maschinengewehr 34 and a main armament of a 3.7 cm KwK 36 gun, but later models were mounted with a 5 cm KwK 38 gun.","faction":"Germany","type":"tank","rarity":"Rare","cost":3,"operationCost":2,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_panzer_iii_f","title":{"Namespace":"card_germany","Key":"card_unit_panzer_iii_f_title","SourceString":"PANZER III-F","LocalizedString":"PANZER III-F"},"Type":"ETypeEnum::tank","attack":3,"defense":3,"range":1,"faction":"EFactionEnum::Germany","kredits":3,"Text":{"Namespace":"card_germany","Key":"card_unit_panzer_iii_f_text","SourceString":"Your German tanks have Blitz. Deployment: Your other tanks get +1+1.","LocalizedString":"Your German tanks have Blitz. Deployment: Your other tanks get +1+1."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_panzer_iii_f_history","SourceString":"The Panzer III, or Panzerkampfwagen III, was a German medium tank that was used by the Axis during WWII. The tank was first used in service in 1939 and used throughout the war, but production was halted in 1943 when more powerful anti tank guns were needed against the Soviet T-34 tank. The Panzer III-F was one of many variants and was the first one to be mass produced, with 450 tanks built, and was used in all theaters of the war. The tank had a crew of 5 (commander, gunner, loader, driver, radio operator/bow machine-gunner), a secondary armament of  2–3 × 7.92 mm Maschinengewehr 34 and a main armament of a 3.7 cm KwK 36 gun, but later models were mounted with a 5 cm KwK 38 gun.","LocalizedString":"The Panzer III, or Panzerkampfwagen III, was a German medium tank that was used by the Axis during WWII. The tank was first used in service in 1939 and used throughout the war, but production was halted in 1943 when more powerful anti tank guns were needed against the Soviet T-34 tank. The Panzer III-F was one of many variants and was the first one to be mass produced, with 450 tanks built, and was used in all theaters of the war. The tank had a crew of 5 (commander, gunner, loader, driver, radio operator/bow machine-gunner), a secondary armament of  2–3 × 7.92 mm Maschinengewehr 34 and a main armament of a 3.7 cm KwK 36 gun, but later models were mounted with a 5 cm KwK 38 gun."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Breakthrough","isInPermanentPool":true,"showBoostIcon":true,"EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardEnterPlay","ERegisteredCardFunction::OnOtherCardAblitiesChanged"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Blitz","EHelpBubbleTypes::Deployment"],"hasDeployment":true,"hasBlitz":true,"soundEnterPlay":{"ObjectName":"SoundWave'Tank_Medium_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Medium_Move_Fx.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Tank_Medium_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Medium_Move_Fx.0"},"soundAttack":{"ObjectName":"SoundWave'Medium_Tank_Attack_Straight'","ObjectPath":"kards/Content/Assets/Audio/Units/Medium_Tank_Attac