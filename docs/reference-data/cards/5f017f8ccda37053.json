{"format":"kards-original-reference","version":1,"id":"5f017f8ccda37053","name":"card_unit_t_35_winter","package":"/Game/Blueprints/Cards/Soviet/WinterWar/units/card_unit_t_35_winter","parent":"UBaseCardObject","card":{"title":"T-35","text":"Deals 1 damage to each HQ at the end of your turn.","flavorText":"The T-35 was a Soviet multi-turreted heavy tank developed during the interwar period. It was one of the largest and heaviest tanks ever produced, and often called a land battleship. However, by the time WWII began, the T-35 was considered technologically outdated. During the initial stages of the war, the T-35 tanks were still in service with the Red Army and they were used in the early phases of Operation Barbarossa in 1941. But, the tank had several significant issues that hindered its effectiveness and its complicated design made it challenging to maintain and repair. The tank was slow, suffered from mechanical problems and had limited maneuverability. As a result, most T-35 tanks were quickly lost in the early stages of the conflict, either destroyed, disabled, or abandoned due to mechanical issues. Because of its limitations and the impracticality of its design, the T-35 was gradually phased out of service during the early years of the war. A total of 56 T-35 tanks were built and only one survived and is preserved in running condition at the Patriot Park near Moscow.","faction":"Soviet","type":"tank","rarity":"Uncommon","cost":2,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_t_35_winter","title":{"Namespace":"card_soviet","Key":"card_unit_t_35_winter_title","SourceString":"T-35","LocalizedString":"T-35"},"Type":"ETypeEnum::tank","attack":2,"defense":3,"range":1,"faction":"EFactionEnum::Soviet","kredits":2,"Text":{"Namespace":"card_soviet","Key":"card_unit_t_35_winter_text","SourceString":"Deals 1 damage to each HQ at the end of your turn.","LocalizedString":"Deals 1 damage to each HQ at the end of your turn."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_t_35_winter_history","SourceString":"The T-35 was a Soviet multi-turreted heavy tank developed during the interwar period. It was one of the largest and heaviest tanks ever produced, and often called a land battleship. However, by the time WWII began, the T-35 was considered technologically outdated. During the initial stages of the war, the T-35 tanks were still in service with the Red Army and they were used in the early phases of Operation Barbarossa in 1941. But, the tank had several significant issues that hindered its effectiveness and its complicated design made it challenging to maintain and repair. The tank was slow, suffered from mechanical problems and had limited maneuverability. As a result, most T-35 tanks were quickly lost in the early stages of the conflict, either destroyed, disabled, or abandoned due to mechanical issues. Because of its limitations and the impracticality of its design, the T-35 was gradually phased out of service during the early years of the war. A total of 56 T-35 tanks were built and only one survived and is preserved in running condition at the Patriot Park near Moscow.","LocalizedString":"The T-35 was a Soviet multi-turreted heavy tank developed during the interwar period. It was one of the largest and heaviest tanks ever produced, and often called a land battleship. However, by the time WWII began, the T-35 was considered technologically outdated. During the initial stages of the war, the T-35 tanks were still in service with the Red Army and they were used in the early phases of Operation Barbarossa in 1941. But, the tank had several significant issues that hindered its effectiveness and its complicated design made it challenging to maintain and repair. The tank was slow, suffered from mechanical problems and had limited maneuverability. As a result, most T-35 tanks were quickly lost in the early stages of the conflict, either destroyed, disabled, or abandoned due to mechanical issues. Because of its limitations and the impracticality of its design, the T-35 was gradually phased out of service during the early years of the war. A total of 56 T-35 tanks were built and only one survived and is preserved in running condition at the Patriot Park near Moscow."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::WinterWar","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/Winter_War/t_t35.t_t35","SubPathString":""},"artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/T-35.T-35","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":272.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_t_35_winter_photo","SourceString":"A T-35 tank before entering a parade in Moscow’s Red Square, 1940.","LocalizedString":"A T-35 tank before entering a parade in Moscow’s Red Square, 1940."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionArmourS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionArmourS.31"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Tanks/BP_AttackTank.BP_AttackTank_C","SubPathString":""},"threat_level":0.05},"variables":[{"name":"locationIDs","type":"TArray<int32>","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_t_35_winter","owner":"card_unit_t_35_winter_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"CallFunc_IsSideActive_active","type":"bool","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Loo