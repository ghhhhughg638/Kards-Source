{"format":"kards-original-reference","version":1,"id":"a1d8c3c5115f4d77","name":"card_unit_49th_infantry_regiment","package":"/Game/Blueprints/Cards/Italy/units/card_unit_49th_infantry_regiment","parent":"UBaseCardObject","card":{"title":"49th INFANTRY REGIMENT","text":"Deployment: Your HQ gets +4 defense if you control another unit with 4 or more attack.","flavorText":"The 49th Infantry Regiment was a unit of the 49th Infantry Division \"Parma\" of the Italian Royal Army during WWII. Initially, it took part in the Greco-Italian War in 1940, where it faced challenging combat conditions and strong Greek resistance in mountainous terrain. Following this campaign, the division was sent to Yugoslavia in 1941, where it carried out occupation duties in Montenegro and Albania and engaged in anti-partisan operations against local resistance forces. After Italy signed an armistice with the Allies in September 1943, the division was disbanded by German forces occupying the region. Some members of the division joined partisan groups or the Italian Co-belligerent Army to continue the fight.","faction":"Italy","type":"infantry","rarity":"Common","cost":3,"operationCost":1,"attack":4,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_49th_infantry_regiment","title":{"Namespace":"card_italy","Key":"card_unit_49th_infantry_regiment_title","SourceString":"49th INFANTRY REGIMENT","LocalizedString":"49th INFANTRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":4,"defense":3,"range":1,"faction":"EFactionEnum::Italy","kredits":3,"Text":{"Namespace":"card_italy","Key":"card_unit_49th_infantry_regiment_text","SourceString":"Deployment: Your HQ gets +4 defense if you control another unit with 4 or more attack.","LocalizedString":"Deployment: Your HQ gets +4 defense if you control another unit with 4 or more attack."},"flavorText":{"Namespace":"card_italy","Key":"card_unit_49th_infantry_regiment_history","SourceString":"The 49th Infantry Regiment was a unit of the 49th Infantry Division \"Parma\" of the Italian Royal Army during WWII. Initially, it took part in the Greco-Italian War in 1940, where it faced challenging combat conditions and strong Greek resistance in mountainous terrain. Following this campaign, the division was sent to Yugoslavia in 1941, where it carried out occupation duties in Montenegro and Albania and engaged in anti-partisan operations against local resistance forces. After Italy signed an armistice with the Allies in September 1943, the division was disbanded by German forces occupying the region. Some members of the division joined partisan groups or the Italian Co-belligerent Army to continue the fight.","LocalizedString":"The 49th Infantry Regiment was a unit of the 49th Infantry Division \"Parma\" of the Italian Royal Army during WWII. Initially, it took part in the Greco-Italian War in 1940, where it faced challenging combat conditions and strong Greek resistance in mountainous terrain. Following this campaign, the division was sent to Yugoslavia in 1941, where it carried out occupation duties in Montenegro and Albania and engaged in anti-partisan operations against local resistance forces. After Italy signed an armistice with the Allies in September 1943, the division was disbanded by German forces occupying the region. Some members of the division joined partisan groups or the Italian Co-belligerent Army to continue the fight."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::BloodAndIron","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"hasBlitz":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Italy/Winter_2024/t_49_infantry_regiment.t_49_infantry_regiment","SubPathString":""},"artist":"Italian WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/49th_INFANTRY_REGIMENT.49th_INFANTRY_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":342.0},"historyPhotoDescription":{"Namespace":"card_italy","K