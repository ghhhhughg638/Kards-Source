{"format":"kards-original-reference","version":1,"id":"1572136810dd65cd","name":"card_unit_kurume_regiment","package":"/Game/Blueprints/Cards/Japan/CovertOp/units/card_unit_kurume_regiment","parent":"UBaseCardObject","card":{"title":"KURUME REGIMENT","text":"Destruction: End the turn.","flavorText":"The 248th Infantry Regiment (Kurume) was a unit of the 112th Division of the Imperial Japanese Army. The division was active from 1944 to 1945 and was mainly composed of men from the 28th Division. It was stationed in the city of Hunchun, in the Jiandao area which is a border region between Northeastern China and Korea. In August 1945 the Soviet Red Army invaded Manchuria and the division was caught in heavy fighting against the advancing Soviets. Hunchun city was soon lost to Soviet forces but the division continued fighting until it was ordered to lay down arms on August 18th after the general surrender of Japan. Most of the remaining men of the 112th Division were taken prisoners by the Red Army.","faction":"Japan","type":"infantry","rarity":"Rare","cost":2,"operationCost":2,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_kurume_regiment","title":{"Namespace":"card_japan","Key":"card_unit_kurume_regiment_title","SourceString":"KURUME REGIMENT","LocalizedString":"KURUME REGIMENT"},"Type":"ETypeEnum::infantry","attack":3,"defense":3,"range":1,"faction":"EFactionEnum::Japan","kredits":2,"Text":{"Namespace":"card_japan","Key":"card_unit_kurume_regiment_text","SourceString":"Destruction: End the turn.","LocalizedString":"Destruction: End the turn."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_kurume_regiment_history","SourceString":"The 248th Infantry Regiment (Kurume) was a unit of the 112th Division of the Imperial Japanese Army. The division was active from 1944 to 1945 and was mainly composed of men from the 28th Division. It was stationed in the city of Hunchun, in the Jiandao area which is a border region between Northeastern China and Korea. In August 1945 the Soviet Red Army invaded Manchuria and the division was caught in heavy fighting against the advancing Soviets. Hunchun city was soon lost to Soviet forces but the division continued fighting until it was ordered to lay down arms on August 18th after the general surrender of Japan. Most of the remaining men of the 112th Division were taken prisoners by the Red Army.","LocalizedString":"The 248th Infantry Regiment (Kurume) was a unit of the 112th Division of the Imperial Japanese Army. The division was active from 1944 to 1945 and was mainly composed of men from the 28th Division. It was stationed in the city of Hunchun, in the Jiandao area which is a border region between Northeastern China and Korea. In August 1945 the Soviet Red Army invaded Manchuria and the division was caught in heavy fighting against the advancing Soviets. Hunchun city was soon lost to Soviet forces but the division continued fighting until it was ordered to lay down arms on August 18th after the general surrender of Japan. Most of the remaining men of the 112th Division were taken prisoners by the Red Army."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::CurrentExpansion","isInPermanentPool":true,"usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"draftBaseWeight":1.1,"hasDestruction":true,"hasGuard":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/CandidateArtwork/Summer_24/t_kurume_regiment.t_kurume_regiment","SubPathString":""},"artist":"Japanese WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/KURUME_REGIMENT.KURUME_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":341.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_kurume_regiment_photo","SourceString":"Japanese soldiers during the Soviet Invasion of Manchuria, August 1945.","LocalizedString":"Japanese soldiers during the Soviet Invasion of Manchuria, August 1945."},"blowUpExplosionNi