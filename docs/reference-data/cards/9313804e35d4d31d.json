{"format":"kards-original-reference","version":1,"id":"9313804e35d4d31d","name":"card_unit_39_panzergrenadier","package":"/Game/Blueprints/Cards/Germany/BrothersInArms/units/card_unit_39_panzergrenadier","parent":"UBaseCardObject","card":{"title":"39. PANZERGRENADIER","text":"Has +2 attack while in the frontline. Deployment: Swap a position with a friendly unit.","flavorText":"The 39th Panzer Grenadier Regiment was a unit of the 17th Panzer Division of the Wehrmacht during WWII. The division was formed in November 1940 from the 27th Infantry Division, The division unit participated in Operation Barbarossa in June 1941, and during the harsh winter of 1941-1942, it played a crucial role in the Battle of Moscow. In November 1942, the division was deployed to the southern sector of the Eastern Front, taking part in Operation Winter Storm, a failed attempt to relieve the encircled troops at Stalingrad. Remaining in reserve during the Battle of Kursk in 1943, the division subsequently conducted a strategic retreat through Ukraine and Poland, eventually concluding the war in Czechoslovakia.","faction":"Germany","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":1,"attack":4,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_39_panzergrenadier","title":{"Namespace":"card_germany","Key":"card_unit_39_panzergrenadier_title","SourceString":"39. PANZERGRENADIER","LocalizedString":"39. PANZERGRENADIER"},"Type":"ETypeEnum::infantry","attack":4,"defense":3,"range":1,"faction":"EFactionEnum::Germany","kredits":3,"Text":{"Namespace":"card_germany","Key":"card_unit_39_panzergrenadier_text","SourceString":"Has +2 attack while in the frontline. Deployment: Swap a position with a friendly unit.","LocalizedString":"Has +2 attack while in the frontline. Deployment: Swap a position with a friendly unit."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_39_panzergrenadier_history","SourceString":"The 39th Panzer Grenadier Regiment was a unit of the 17th Panzer Division of the Wehrmacht during WWII. The division was formed in November 1940 from the 27th Infantry Division, The division unit participated in Operation Barbarossa in June 1941, and during the harsh winter of 1941-1942, it played a crucial role in the Battle of Moscow. In November 1942, the division was deployed to the southern sector of the Eastern Front, taking part in Operation Winter Storm, a failed attempt to relieve the encircled troops at Stalingrad. Remaining in reserve during the Battle of Kursk in 1943, the division subsequently conducted a strategic retreat through Ukraine and Poland, eventually concluding the war in Czechoslovakia.","LocalizedString":"The 39th Panzer Grenadier Regiment was a unit of the 17th Panzer Division of the Wehrmacht during WWII. The division was formed in November 1940 from the 27th Infantry Division, The division unit participated in Operation Barbarossa in June 1941, and during the harsh winter of 1941-1942, it played a crucial role in the Battle of Moscow. In November 1942, the division was deployed to the southern sector of the Eastern Front, taking part in Operation Winter Storm, a failed attempt to relieve the encircled troops at Stalingrad. Remaining in reserve during the Battle of Kursk in 1943, the division subsequently conducted a strategic retreat through Ukraine and Poland, eventually concluding the war in Czechoslovakia."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::BrothersInArms","isReserved":true,"EffectType":"ECardEffectTypes::Passive","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"soundEnterPlay":{"ObjectName":"SoundWave'Motorcycle'","ObjectPath":"kards/Content/Assets/Audio/Units/Motorcycle.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Motorcycle'","ObjectPath":"kards/Content/Assets/Audio/Units/Motorcycle.0"},"soundBlowUp":{"ObjectName":"SoundWave'Explosion02'","ObjectPath":"kards/Content/StarterC