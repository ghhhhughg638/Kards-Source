{"format":"kards-original-reference","version":1,"id":"04439834691d0f89","name":"card_unit_1005th_rifles","package":"/Game/Blueprints/Cards/Soviet/ToW/units/card_unit_1005th_rifles","parent":"UBaseCardObject","card":{"title":"1005th RIFLES","text":"When the opponent targets 1005th RIFLES with an order, draw a card.","flavorText":"The 1005th Rifle Regiment was made a subordinate unit of the 279th Rifle Division in 1941 and fought with the 50th Army during the Battle of Bryansk, which took place at the early stages of the Moscow Campaign. During the Battle of Bryansk the 50th Army was encircled by the Germans, but the units continued to fight in order to delay the onslaught on Moscow. After almost 20 days of fighting the 279th Rifle Regiment was destroyed, but the only remaining unit was the 1005th Rifle Regiment which became a separate unit under the Bryansk Front. The 297th Rifle Division was officially disbanded by the end of 1941, but reformed  in 1942 and participated in numerous battles and campaigns on the Eastern Front after that. The division ended the war in the Courland Pocket in 1945.","faction":"Soviet","type":"infantry","rarity":"Common","cost":4,"operationCost":1,"attack":5,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_1005th_rifles","title":{"Namespace":"card_soviet","Key":"card_unit_1005th_rifles_title","SourceString":"1005th RIFLES","LocalizedString":"1005th RIFLES"},"Type":"ETypeEnum::infantry","attack":5,"defense":3,"range":1,"faction":"EFactionEnum::Soviet","kredits":4,"Text":{"Namespace":"card_soviet","Key":"card_unit_1005th_rifles_text","SourceString":"When the opponent targets 1005th RIFLES with an order, draw a card.","LocalizedString":"When the opponent targets 1005th RIFLES with an order, draw a card."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_1005th_rifles_history","SourceString":"The 1005th Rifle Regiment was made a subordinate unit of the 279th Rifle Division in 1941 and fought with the 50th Army during the Battle of Bryansk, which took place at the early stages of the Moscow Campaign. During the Battle of Bryansk the 50th Army was encircled by the Germans, but the units continued to fight in order to delay the onslaught on Moscow. After almost 20 days of fighting the 279th Rifle Regiment was destroyed, but the only remaining unit was the 1005th Rifle Regiment which became a separate unit under the Bryansk Front. The 297th Rifle Division was officially disbanded by the end of 1941, but reformed  in 1942 and participated in numerous battles and campaigns on the Eastern Front after that. The division ended the war in the Courland Pocket in 1945.","LocalizedString":"The 1005th Rifle Regiment was made a subordinate unit of the 279th Rifle Division in 1941 and fought with the 50th Army during the Battle of Bryansk, which took place at the early stages of the Moscow Campaign. During the Battle of Bryansk the 50th Army was encircled by the Germans, but the units continued to fight in order to delay the onslaught on Moscow. After almost 20 days of fighting the 279th Rifle Regiment was destroyed, but the only remaining unit was the 1005th Rifle Regiment which became a separate unit under the Bryansk Front. The 297th Rifle Division was officially disbanded by the end of 1941, but reformed  in 1942 and participated in numerous battles and campaigns on the Eastern Front after that. The division ended the war in the Courland Pocket in 1945."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Campaign2020","isReserved":true,"showBoostIcon":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnBeforeOtherCardPlayedFromHand"],"hasAmbush":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/t_soviet_soldier_2.t_soviet_soldier_2","SubPathString":""},"ImageAnchor":"EImageAnchor::Top","artis