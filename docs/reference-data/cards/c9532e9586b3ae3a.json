{"format":"kards-original-reference","version":1,"id":"c9532e9586b3ae3a","name":"card_event_baker_street_irregulars","package":"/Game/Blueprints/Cards/Britain/CovertOp/events/card_event_baker_street_irregulars","parent":"UBaseCardObject","card":{"title":"BAKER STREET IRREGULARS","text":"Develop a British special force unit. If you control a Commando, also Develop a British order.","flavorText":"The Baker Street Irregulars was a nickname given to the Special Operations Executive (SOE), a British special forces organization. Founded in 1940, the SOE played a crucial role in conducting espionage, sabotage, and subversion operations behind enemy lines in occupied Europe and other theaters of war. The SOE recruited and trained agents from various backgrounds, including military personnel, civilians, and members of resistance movements. These agents were deployed in occupied territories to gather intelligence, organize and support resistance networks, and carry out acts of sabotage against enemy targets. The organization employed more than 13,000 people, about 3,200 of whom were women.The SOE operated covertly, often working in collaboration with local resistance fighters and partisan groups to undermine enemy morale and disrupt Axis military operations. The SOE also conducted several deception operations aimed at misleading the Axis forces, most notably Operation Mincemeat, prior to the Allied invasion of Sicily in 1943, and Operation Titanic prior to D-Day in 1944. The organization was nicknamed  \"Baker Street Irregulars\" because it operated from a building on Baker Street in London, and its members used unconventional methods similar to those of the fictional character Sherlock Holmes and his group of streetwise helpers known as the Baker Street Irregulars. Other nicknames were \"Churchill's Secret Army\" and \"Ministry of Ungentlemanly Warfare\".","faction":"Britain","type":"order","rarity":"Rare","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.develop"],"Name":"card_event_baker_street_irregulars","title":{"Namespace":"card_britain","Key":"card_event_baker_street_irregulars_title","SourceString":"BAKER STREET IRREGULARS","LocalizedString":"BAKER STREET IRREGULARS"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Britain","kredits":1,"Text":{"Namespace":"card_britain","Key":"card_event_baker_street_irregulars_text","SourceString":"Develop a British special force unit. If you control a Commando, also Develop a British order.","LocalizedString":"Develop a British special force unit. If you control a Commando, also Develop a British order."},"flavorText":{"Namespace":"card_britain","Key":"card_event_baker_street_irregulars_history","SourceString":"The Baker Street Irregulars was a nickname given to the Special Operations Executive (SOE), a British special forces organization. Founded in 1940, the SOE played a crucial role in conducting espionage, sabotage, and subversion operations behind enemy lines in occupied Europe and other theaters of war. The SOE recruited and trained agents from various backgrounds, including military personnel, civilians, and members of resistance movements. These agents were deployed in occupied territories to gather intelligence, organize and support resistance networks, and carry out acts of sabotage against enemy targets. The organization employed more than 13,000 people, about 3,200 of whom were women.The SOE operated covertly, often working in collaboration with local resistance fighters and partisan groups to undermine enemy morale and disrupt Axis military operations. The SOE also conducted several deception operations aimed at misleading the Axis forces, most notably Operation Mincemeat, prior to the Allied invasion of Sicily in 1943, and Operation Titanic prior to D-Day in 1944. The organization was nicknamed  \"Baker Street Irregulars\" because it operated from a building on Baker Street in London, and its members used unconventional methods similar to those of the fictional character Sherlock Holmes and his group of streetwise helpers known as the Baker Street Irregulars. Other nicknames were \"Churchill's Secret Army\" and \"Ministry of Ungentlemanly Warfare\".","LocalizedString":"The Baker Street Irregulars was a nickname given to the Special Operations Executive (SOE), a British special forces organization. Founded in 1940, the SOE played a crucial role in conducting espionage, sabotage, and subversion operations behind enemy lines in occupied Europe and other theaters of war. The SOE recruited and trained agents from various backgrounds, including military personnel, civilians, and members of resistance movements. These agents were deployed in occupied territories to gather intelligence, organize and support resistance networks, and carry out acts of sabotage against enemy targets. The organization employed more than 13,000 people, about 3,200 of whom were women.The SOE operated covertly, often working in collaboration with local resistance fighters and partisan groups to undermine enemy morale and disrupt Axis military operations. The SOE also conducted several deception operations aimed at misleading the Axis forces, most notably Operation Mincemeat, prior to the Allied invasion of Sicily in 1943, and Operation Titanic prior to D-Day in 1944. The organization was nicknamed  \"Baker Street Irregulars\" because it operated from a building on Baker Street in London, and its members used unconventional methods similar to those of the fictional character Sherlock Holmes and his group of streetwise helpers known as the Baker Street Irregulars. Other nicknames were \"Churchill's Secret Army\" and \"Ministry of Ungentlemanly Warfare\"."},"rarity":"ERarityEnum::Rare","waitWithOnOtherCardPlayedUntilHandTargetSelected":true,"cardSet":"ECardSetEnum::CurrentExpansion","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Develop"],"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/CandidateArtwork/Summer_24/t_baker_street_irregulars.t_baker_street_irregulars","SubPathString":""},"artist":"Rebellion","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/BAKER_STREET_IRREGULARS.BAKER_STREET_IRREGULARS","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":378.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_event_baker_street_irregulars_photo","SourceString":"SOE officers during a special operation in Crete, 1944. Note that two of them are wearing German uniforms.","LocalizedString":"SOE officers during a special operation in Crete, 1944. Note that two of them are wearing German uniforms."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"Notes":"Image needed to be customized","isDefenseBuff":true},"variables":[{"name":"PossibleCards","type":"TArray<UBaseCardObject*>","direction":"in"},{"name":"commandoFound","type":"bool","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_baker_street_irregulars","owner":"card_event_baker_street_irregulars_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_bool_True_if_break_was_hit_Variable","type":"bool","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Not_PreBool_ReturnValue","type":"bool","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_handTargetCardID","type":"int32","direction":"in"},{"name":"K2Node