{"format":"kards-original-reference","version":1,"id":"8d6e0f344538bd1c","name":"card_unit_142nd_infantry_regiment","package":"/Game/Blueprints/Cards/USA/WinterWar/units/card_unit_142nd_infantry_regiment","parent":"UBaseCardObject","card":{"title":"142nd INFANTRY REGIMENT","text":"When this unit destroys an enemy unit, your HQ gains +2 defense.","flavorText":"The 142nd Infantry Regiment is a unit of the US Army which has been active from 1917 to this day. In 1940 the regiment underwent extensive training in various locations across the United States before sailing from New York to North Africa in April 1943. As part of the 34th Infantry Division the regiment was involved in the Italian campaign, taking part in significant battles and operations, including the Naples-Foggia campaign, the assault on Monte Sambucaro, and the fighting at Anzio. After participating in the liberation of Rome, the division retrained in Paestum before making a third amphibious assault in Southern France in August 1944. Their actions included surrounding Livron, liberating Lyon, capturing Remiremont, and battling through the Vosges Mountains. The 142nd fought through various German strongholds, crossed the Rhine River, and continued to advance into Germany. Participating in the 34th Division's advance across the Lech River in April 1945. The regiment concluded the war in Austria and returned to the US in December 1945, marking the end of their active service at Camp Patrick Henry, Virginia.","faction":"USA","type":"infantry","rarity":"Common","cost":2,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_142nd_infantry_regiment","title":{"Namespace":"card_usa","Key":"card_unit_142nd_infantry_regiment_title","SourceString":"142nd INFANTRY REGIMENT","LocalizedString":"142nd INFANTRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":2,"defense":3,"range":1,"faction":"EFactionEnum::USA","kredits":2,"Text":{"Namespace":"card_usa","Key":"card_unit_142nd_infantry_regiment_text","SourceString":"When this unit destroys an enemy unit, your HQ gains +2 defense.","LocalizedString":"When this unit destroys an enemy unit, your HQ gains +2 defense."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_142nd_infantry_regiment_history","SourceString":"The 142nd Infantry Regiment is a unit of the US Army which has been active from 1917 to this day. In 1940 the regiment underwent extensive training in various locations across the United States before sailing from New York to North Africa in April 1943. As part of the 34th Infantry Division the regiment was involved in the Italian campaign, taking part in significant battles and operations, including the Naples-Foggia campaign, the assault on Monte Sambucaro, and the fighting at Anzio. After participating in the liberation of Rome, the division retrained in Paestum before making a third amphibious assault in Southern France in August 1944. Their actions included surrounding Livron, liberating Lyon, capturing Remiremont, and battling through the Vosges Mountains. The 142nd fought through various German strongholds, crossed the Rhine River, and continued to advance into Germany. Participating in the 34th Division's advance across the Lech River in April 1945. The regiment concluded the war in Austria and returned to the US in December 1945, marking the end of their active service at Camp Patrick Henry, Virginia.","LocalizedString":"The 142nd Infantry Regiment is a unit of the US Army which has been active from 1917 to this day. In 1940 the regiment underwent extensive training in various locations across the United States before sailing from New York to North Africa in April 1943. As part of the 34th Infantry Division the regiment was involved in the Italian campaign, taking part in significant battles and operations, including the Naples-Foggia campaign, the assault on Monte Sambucaro, and the fighting at Anzio. After participating in the liberation of Rome, the division retrained in Paestum before making a third amphibious assault in Southern France in August 1944. Their actions included surrounding Livron, liberating Lyon, capturing Remiremont, and battling through the Vosges Mountains. The 142nd fought through various German strongholds, crossed the Rhine River, and continued to advance into Germany. Participating in the 34th Division's advance across the Lech River in April 1945. The regiment concluded the war in Austria and returned to the US in December 1945, marking the end of their active service at Camp Patrick Henry, Virginia."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::WinterWar","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardDestroyed"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Blitz","EHelpBubbleTypes::Trigger"],"hasBlitz":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/CandidateArtwork/Winter_War/t_us_winter_force.t_us_winter_force","SubPathString":""},"artist":"Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/142nd_INFANTRY_REGIMENT.142nd_INFANTRY_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":329.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_142nd_infantry_regiment_photo","SourceString":"Men of the 36th Division coming ashore during the invasion of southern France. 15 August 1944.","LocalizedString":"Men of the 36th Division coming ashore during the invasion of southern France. 15 August 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathStrin