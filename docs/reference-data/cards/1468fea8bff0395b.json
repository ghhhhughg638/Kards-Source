{"format":"kards-original-reference","version":1,"id":"1468fea8bff0395b","name":"card_event_desert_push","package":"/Game/Blueprints/Cards/Italy/events/card_event_desert_push","parent":"UBaseCardObject","card":{"title":"DESERT PUSH","text":"Fully repair target ground unit. If it is pinned, remove pin.","flavorText":"The Desert War took place in the desert of Egypt and Libya and was the main theater of the North African campaign during WWII. It started with the Italian invasion of Egypt in 1940, where the Italians were lightly opposed and managed to advance 100 km to a town called Sidi Barrani, where they stopped and started entrenching themselves. In 1942 the Axis in Northern Africa were under the control of Erwin Rommel who almost managed to kick the British out of Egypt. However, at the First Battle of El Alamein Rommel’s advance was halted by the British only 140 km from Alexandria, the capital of Egypt. From there on it was downhill for the Axis and an Allied victory in Northern Africa was completed in May 1943.","faction":"Italy","type":"order","rarity":"Common","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_desert_push","title":{"Namespace":"card_italy","Key":"card_event_desert_push_title","SourceString":"DESERT PUSH","LocalizedString":"DESERT PUSH"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Italy","kredits":1,"Text":{"Namespace":"card_italy","Key":"card_event_desert_push_text","SourceString":"Fully repair target ground unit. If it is pinned, remove pin.","LocalizedString":"Fully repair target ground unit. If it is pinned, remove pin."},"flavorText":{"Namespace":"card_italy","Key":"card_event_desert_push_history","SourceString":"The Desert War took place in the desert of Egypt and Libya and was the main theater of the North African campaign during WWII. It started with the Italian invasion of Egypt in 1940, where the Italians were lightly opposed and managed to advance 100 km to a town called Sidi Barrani, where they stopped and started entrenching themselves. In 1942 the Axis in Northern Africa were under the control of Erwin Rommel who almost managed to kick the British out of Egypt. However, at the First Battle of El Alamein Rommel’s advance was halted by the British only 140 km from Alexandria, the capital of Egypt. From there on it was downhill for the Axis and an Allied victory in Northern Africa was completed in May 1943.","LocalizedString":"The Desert War took place in the desert of Egypt and Libya and was the main theater of the North African campaign during WWII. It started with the Italian invasion of Egypt in 1940, where the Italians were lightly opposed and managed to advance 100 km to a town called Sidi Barrani, where they stopped and started entrenching themselves. In 1942 the Axis in Northern Africa were under the control of Erwin Rommel who almost managed to kick the British out of Egypt. However, at the First Battle of El Alamein Rommel’s advance was halted by the British only 140 km from Alexandria, the capital of Egypt. From there on it was downhill for the Axis and an Allied victory in Northern Africa was completed in May 1943."},"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Expansion2019","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Pin"],"soundEnterPlay":{"ObjectName":"SoundWave'Naval_Support_17'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Naval_Support_17.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Italy/t_desert_push1.t_desert_push1","SubPathString":""},"artist":"Look and Learn","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/DESERT_PUSH.DESERT_PUSH","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":352.0},"historyPhotoSource":"German Federal Archives","historyPhotoIdentificationCode":"101I-424-0258-32","historyPhotoAuthor":"Sturm","historyPhotoDescription":{"Namespace":"card_italy","Key":"card_event_desert_push