{"format":"kards-original-reference","version":1,"id":"9bca577552dc861a","name":"card_unit_m8_howitzer","package":"/Game/Blueprints/Cards/USA/Allegiance/units/card_unit_m8_howitzer","parent":"UBaseCardObject","card":{"title":"M8 HOWITZER","text":"Deployment: Distribute 3 damage randomly between all enemies.","flavorText":"The 75 mm Howitzer Motor Carriage M8 was an American self-propelled howitzer gun used during WWII by the US Army and the French Army. The M8 had a M116 howitzer in an M7 mount and used the chassis of the M5 Stuart tank. The M8 was used from 1942 and throughout the war but in 1944 the US Army started to replace it with the 105mm howitzer variant of the M4 Sherman tank.The M8 was used in the Italian Campaign, the Pacific War and on the Western Front, by both the US and French Army. A total of 1,778 M8s were built.","faction":"USA","type":"artillery","rarity":"Common","cost":5,"operationCost":2,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_m8_howitzer","title":{"Namespace":"card_usa","Key":"card_unit_m8_howitzer_title","SourceString":"M8 HOWITZER","LocalizedString":"M8 HOWITZER"},"Type":"ETypeEnum::artillery","attack":2,"defense":3,"range":2,"faction":"EFactionEnum::USA","kredits":5,"Text":{"Namespace":"card_usa","Key":"card_unit_m8_howitzer_text","SourceString":"Deployment: Distribute 3 damage randomly between all enemies.","LocalizedString":"Deployment: Distribute 3 damage randomly between all enemies."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_m8_howitzer_history","SourceString":"The 75 mm Howitzer Motor Carriage M8 was an American self-propelled howitzer gun used during WWII by the US Army and the French Army. The M8 had a M116 howitzer in an M7 mount and used the chassis of the M5 Stuart tank. The M8 was used from 1942 and throughout the war but in 1944 the US Army started to replace it with the 105mm howitzer variant of the M4 Sherman tank.The M8 was used in the Italian Campaign, the Pacific War and on the Western Front, by both the US and French Army. A total of 1,778 M8s were built.","LocalizedString":"The 75 mm Howitzer Motor Carriage M8 was an American self-propelled howitzer gun used during WWII by the US Army and the French Army. The M8 had a M116 howitzer in an M7 mount and used the chassis of the M5 Stuart tank. The M8 was used from 1942 and throughout the war but in 1944 the US Army started to replace it with the 105mm howitzer variant of the M4 Sherman tank.The M8 was used in the Italian Campaign, the Pacific War and on the Western Front, by both the US and French Army. A total of 1,778 M8s were built."},"operationCost":2,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Expansion2019","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"draftBaseWeight":0.8,"hasDeployment":true,"soundEnterPlay":{"ObjectName":"SoundWave'Infantry_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Infantry_Move_FX.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Infantry_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Infantry_Move_FX.0"},"soundBlowUp":{"ObjectName":"SoundWave'explosion_large_10'","ObjectPath":"kards/Content/ExplosionSoundPack/ExplosionSounds/Wavs/explosion_large_10.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/t_m8_artillery.t_m8_artillery","SubPathString":""},"artist":"Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/M8_HOWITZER.M8_HOWITZER","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":416.0},"historyPhotoSource":"https://78.media.tumblr.com/","historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_m8_howitzer_photo","SourceString":"75 mm Howitzer Motor Carriage M8 of the 2nd Armored Division, circa 1942-45.","LocalizedString":"75 mm Howitzer Motor Carriage M8 of the 2nd Armored Division, circa 1942-45."},"historyTypeDescription":{"Namespace":"card_usa","Key":"card_unit_m8_howitzer_header","SourceString":"Self Propelled Gu