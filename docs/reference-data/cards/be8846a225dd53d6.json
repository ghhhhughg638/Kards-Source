{"format":"kards-original-reference","version":1,"id":"be8846a225dd53d6","name":"card_unit_kingfisher_us","package":"/Game/Blueprints/Cards/USA/OceaniaStorm/units/card_unit_kingfisher_us","parent":"UBaseCardObject","card":{"title":"KINGFISHER","text":"Forecast after this unit attacks the enemy HQ.","flavorText":"The Vought OS2U Kingfisher was the main shipboard observation seaplane used by the US Navy during WWII. First flown in 1938, it was a compact floatplane that could be launched by catapult from battleships and cruisers, then recovered from the sea by crane. A total of 1,519 Kingfishers were built. The aircraft was not fast, and its 450-horsepower engine gave it only modest performance. Its strength was reliability and usefulness. Kingfishers spotted gunfire for warships, scouted ahead of fleets, searched coastal waters, and supported shore bombardments. They could also carry small bombs or depth charges, and were armed with one fixed machine gun for the pilot, and another on a flexible mount for the observer. The Kingfisher became especially valuable in air-sea rescue. In 1942, one helped recover Eddie Rickenbacker and his crew after weeks adrift in the Pacific. In 1944, Lieutenant John A. Burns used a Kingfisher near Truk Lagoon to rescue downed airmen and taxi them to the submarine USS Tang. The US Coast Guard also used 76 Kingfishers for reconnaissance, anti-submarine patrol, and rescue missions.","faction":"USA","type":"fighter","rarity":"Uncommon","cost":3,"operationCost":1,"attack":2,"defense":4},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.forecast"],"Name":"card_unit_kingfisher_us","title":{"Namespace":"card_usa","Key":"card_unit_kingfisher_us_title","SourceString":"KINGFISHER","LocalizedString":"KINGFISHER"},"Type":"ETypeEnum::fighter","attack":2,"defense":4,"range":2,"faction":"EFactionEnum::USA","kredits":3,"Text":{"Namespace":"card_usa","Key":"card_unit_kingfisher_us_text","SourceString":"Forecast after this unit attacks the enemy HQ.","LocalizedString":"Forecast after this unit attacks the enemy HQ."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_kingfisher_us_history","SourceString":"The Vought OS2U Kingfisher was the main shipboard observation seaplane used by the US Navy during WWII. First flown in 1938, it was a compact floatplane that could be launched by catapult from battleships and cruisers, then recovered from the sea by crane. A total of 1,519 Kingfishers were built. The aircraft was not fast, and its 450-horsepower engine gave it only modest performance. Its strength was reliability and usefulness. Kingfishers spotted gunfire for warships, scouted ahead of fleets, searched coastal waters, and supported shore bombardments. They could also carry small bombs or depth charges, and were armed with one fixed machine gun for the pilot, and another on a flexible mount for the observer. The Kingfisher became especially valuable in air-sea rescue. In 1942, one helped recover Eddie Rickenbacker and his crew after weeks adrift in the Pacific. In 1944, Lieutenant John A. Burns used a Kingfisher near Truk Lagoon to rescue downed airmen and taxi them to the submarine USS Tang. The US Coast Guard also used 76 Kingfishers for reconnaissance, anti-submarine patrol, and rescue missions.","LocalizedString":"The Vought OS2U Kingfisher was the main shipboard observation seaplane used by the US Navy during WWII. First flown in 1938, it was a compact floatplane that could be launched by catapult from battleships and cruisers, then recovered from the sea by crane. A total of 1,519 Kingfishers were built. The aircraft was not fast, and its 450-horsepower engine gave it only modest performance. Its strength was reliability and usefulness. Kingfishers spotted gunfire for warships, scouted ahead of fleets, searched coastal waters, and supported shore bombardments. They could also carry small bombs or depth charges, and were armed with one fixed machine gun for the pilot, and another on a flexible mount for the observer. The Kingfisher became especially valuable in air-sea rescue. In 1942, one helped recover Eddie Rickenbacker and his crew after weeks adrift in the Pacific. In 1944, Lieutenant John A. Burns used a Kingfisher near Truk Lagoon to rescue downed airmen and taxi them to the submarine USS Tang. The US Coast Guard also used 76 Kingfishers for reconnaissance, anti-submarine patrol, and rescue missions."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"spawnCardName":"card_event_sunny1_blue_sky;card_event_rain1_mist;card_event_storm1_gale","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/KINGFISHER.KINGFISHER","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":348.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_kingfisher_us_photo","SourceString":"A US Navy Vought OS2U-2 Kingfisher seaplane in flight, early 1942.","LocalizedString":"A US Navy Vought OS2U-2 Kingfisher seaplane in flight, early 1942."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackFighter.BP_AttackFighter_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_kingfisher_us","owner":"card_unit_kingfisher_us_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"K2Node_Event_defenderCard","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_wasShockAttack","type":"bool","direction":"in"},{"name":"K2Node_Event_attackC