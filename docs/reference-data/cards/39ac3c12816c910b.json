{"format":"kards-original-reference","version":1,"id":"39ac3c12816c910b","name":"card_unit_146th_infantry_regiment","package":"/Game/Blueprints/Cards/Soviet/WinterWar/units/card_unit_146th_infantry_regiment","parent":"UBaseCardObject","card":{"title":"146th INFANTRY REGIMENT","text":"Deployment: Gets +1+2 if you control 3 or more units.","flavorText":"The 146th Infantry Regiment was a unit of the 44th Rifle Division of the Soviet Red Army during the Winter War and WWII. The division was involved in several significant conflicts. During the Finno-Russian Winter War, it was sent to reinforce another Soviet division but faced numerous challenges. The 44th Division, lacking ski troops and being road-bound in deep snow, was ambushed by Finnish forces who used their mobility and better weapons to break the division's movement. The Finnish troops successfully divided and defeated the entire division, causing significant casualties. After its destruction, the division was reformed but faced further losses and ultimately was wiped out in combat against the German forces in the Kirovograd and Uman region on the Eastern Front. It was reconstituted multiple times, participating in battles in northern Russia and Kurland. After the war, it was briefly reactivated and later disbanded in 1959, with some of its regiments transferring to another division.","faction":"Soviet","type":"infantry","rarity":"Common","cost":1,"operationCost":1,"attack":3,"defense":1},"defaults":{"UberGraphFrame":{},"Name":"card_unit_146th_infantry_regiment","title":{"Namespace":"card_soviet","Key":"card_unit_146th_infantry_regiment_title","SourceString":"146th INFANTRY REGIMENT","LocalizedString":"146th INFANTRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":3,"defense":1,"range":1,"faction":"EFactionEnum::Soviet","kredits":1,"Text":{"Namespace":"card_soviet","Key":"card_unit_146th_infantry_regiment_text","SourceString":"Deployment: Gets +1+2 if you control 3 or more units.","LocalizedString":"Deployment: Gets +1+2 if you control 3 or more units."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_146th_infantry_regiment_history","SourceString":"The 146th Infantry Regiment was a unit of the 44th Rifle Division of the Soviet Red Army during the Winter War and WWII. The division was involved in several significant conflicts. During the Finno-Russian Winter War, it was sent to reinforce another Soviet division but faced numerous challenges. The 44th Division, lacking ski troops and being road-bound in deep snow, was ambushed by Finnish forces who used their mobility and better weapons to break the division's movement. The Finnish troops successfully divided and defeated the entire division, causing significant casualties. After its destruction, the division was reformed but faced further losses and ultimately was wiped out in combat against the German forces in the Kirovograd and Uman region on the Eastern Front. It was reconstituted multiple times, participating in battles in northern Russia and Kurland. After the war, it was briefly reactivated and later disbanded in 1959, with some of its regiments transferring to another division.","LocalizedString":"The 146th Infantry Regiment was a unit of the 44th Rifle Division of the Soviet Red Army during the Winter War and WWII. The division was involved in several significant conflicts. During the Finno-Russian Winter War, it was sent to reinforce another Soviet division but faced numerous challenges. The 44th Division, lacking ski troops and being road-bound in deep snow, was ambushed by Finnish forces who used their mobility and better weapons to break the division's movement. The Finnish troops successfully divided and defeated the entire division, causing significant casualties. After its destruction, the division was reformed but faced further losses and ultimately was wiped out in combat against the German forces in the Kirovograd and Uman region on the Eastern Front. It was reconstituted multiple times, participating in battles in northern Russia and Kurland. After the war, it was briefly reactivated and later disbanded in 1959, with some of its regiments transferring to another division."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::WinterWar","isReserved":true,"hasDeployment":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/Winter_War/t_soviet_magnum_pi.t_soviet_magnum_pi","SubPathString":""},"artist":"Soviet WW2 poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/146th_INFANTRY_REGIMENT.146th_INFANTRY_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":510.0,"Y":512.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_146th_infantry_regiment_photo","SourceString":"Red Army soldiers during the Winter War (ca. 1939-1940).","LocalizedString":"Red Army soldiers during the Winter War (ca. 1939-1940)."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"count","type":"int32","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_146th_infantry_regiment","owner":"card_unit_146th_infantry_regiment_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Variable","type":"int32","direction":"in"},{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_Greater_IntInt_ReturnValue","type":"bool","direction":