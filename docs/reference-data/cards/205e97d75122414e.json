{"format":"kards-original-reference","version":1,"id":"205e97d75122414e","name":"card_unit_46th_indian_brigade","package":"/Game/Blueprints/Cards/Britain/OceaniaStorm/units/card_unit_46th_indian_brigade","parent":"UBaseCardObject","card":{"title":"46th INDIAN BRIGADE","text":"Deployment: Draw a card from your deck that did not start there. Get +1+1 and Blitz if you do.","flavorText":"The 46th Indian Infantry Brigade was formed at Ahmednagar in India in 1941 and assigned to the 17th Indian Infantry Division. Its primary units included the 3rd Battalion, 7th Gurkha Rifles; the 7th Battalion, 10th Baluch Regiment; and the 5th Battalion, 17th Dogra Regiment. Like much of the British Indian Army in early WWII, the brigade was soon pulled into a fast-moving campaign where time, transport, and equipment were in short supply. In 1942, the Japanese advance into Burma forced the 17th Indian Division into a difficult retreat toward the Sittang River. The 46th Brigade suffered heavy casualties during this withdrawal and was caught up in the crisis around Sittang Bridge. The bridge was a vital escape route, but confusion and Japanese pressure threatened to trap the division on the wrong side of the river. After the battle, the brigade was broken into scattered groups and ceased to exist as an effective formation. It was not rebuilt and was officially disbanded in February 1942.","faction":"Britain","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":1,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_46th_indian_brigade","title":{"Namespace":"card_britain","Key":"card_unit_46th_indian_brigade_title","SourceString":"46th INDIAN BRIGADE","LocalizedString":"46th INDIAN BRIGADE"},"Type":"ETypeEnum::infantry","attack":3,"defense":4,"range":1,"faction":"EFactionEnum::Britain","kredits":3,"Text":{"Namespace":"card_britain","Key":"card_unit_46th_indian_brigade_text","SourceString":"Deployment: Draw a card from your deck that did not start there. Get +1+1 and Blitz if you do.","LocalizedString":"Deployment: Draw a card from your deck that did not start there. Get +1+1 and Blitz if you do."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_46th_indian_brigade_history","SourceString":"The 46th Indian Infantry Brigade was formed at Ahmednagar in India in 1941 and assigned to the 17th Indian Infantry Division. Its primary units included the 3rd Battalion, 7th Gurkha Rifles; the 7th Battalion, 10th Baluch Regiment; and the 5th Battalion, 17th Dogra Regiment. Like much of the British Indian Army in early WWII, the brigade was soon pulled into a fast-moving campaign where time, transport, and equipment were in short supply. In 1942, the Japanese advance into Burma forced the 17th Indian Division into a difficult retreat toward the Sittang River. The 46th Brigade suffered heavy casualties during this withdrawal and was caught up in the crisis around Sittang Bridge. The bridge was a vital escape route, but confusion and Japanese pressure threatened to trap the division on the wrong side of the river. After the battle, the brigade was broken into scattered groups and ceased to exist as an effective formation. It was not rebuilt and was officially disbanded in February 1942.","LocalizedString":"The 46th Indian Infantry Brigade was formed at Ahmednagar in India in 1941 and assigned to the 17th Indian Infantry Division. Its primary units included the 3rd Battalion, 7th Gurkha Rifles; the 7th Battalion, 10th Baluch Regiment; and the 5th Battalion, 17th Dogra Regiment. Like much of the British Indian Army in early WWII, the brigade was soon pulled into a fast-moving campaign where time, transport, and equipment were in short supply. In 1942, the Japanese advance into Burma forced the 17th Indian Division into a difficult retreat toward the Sittang River. The 46th Brigade suffered heavy casualties during this withdrawal and was caught up in the crisis around Sittang Bridge. The bridge was a vital escape route, but confusion and Japanese pressure threatened to trap the division on the wrong side of the river. After the battle, the brigade was broken into scattered groups and ceased to exist as an effective formation. It was not rebuilt and was officially disbanded in February 1942."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::OceaniaStorm","hasDeployment":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/46th_INDIAN_BRIGADE.46th_INDIAN_BRIGADE","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_unit_46th_indian_brigade_photo","SourceString":"Men of the 17th Indian Infantry Division, Burma, 1945.","LocalizedString":"Men of the 17th Indian Infantry Division, Burma, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"possibleCards","type":"TArray<UBaseCardObject*>","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_46th_indian_brigade","owner":"card_unit_46th_indian_brigade_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_GetDeckByside_deckCardIDs","type":"TArray<int32>","direction":"in"},{"name":"CallFunc_Array_Get_Item","type":