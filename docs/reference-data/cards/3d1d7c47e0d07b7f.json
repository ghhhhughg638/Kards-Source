{"format":"kards-original-reference","version":1,"id":"3d1d7c47e0d07b7f","name":"card_event_forward_base_anzac","package":"/Game/Blueprints/Cards/ANZAC/events/card_event_forward_base_anzac","parent":"UBaseCardObject","card":{"title":"FORWARD BASE","text":"Discard your left-most card. Deal damage to target unit equal to its cost.","flavorText":"A forward base is an advanced military position established close to an active combat zone. It allows troops to receive supplies, reinforcements, medical support and communications without relying entirely on support from distant rear bases. In the Pacific, where operations were often separated by mountains, jungle and long stretches of ocean, forward bases were essential for keeping forces supplied and maintaining pressure on the enemy. Australian and New Zealand forces made extensive use of them during WWII. In New Guinea, locations such as Port Moresby and Milne Bay became vital centres for air operations, logistics and troop movements. In 1942, at Milne Bay, Allied engineers built airfields that allowed aircraft to operate close to Japanese positions and supported Australian troops defending the area. As Allied forces advanced farther along the New Guinea coast, new bases and airfields were established closer to the front. These positions provided food, ammunition, fuel and medical care while giving aircraft and ground forces a staging point for the next operation. Forward bases therefore became a crucial part of the Allied advance through the Southwest Pacific.","faction":"Anzac","type":"order","rarity":"Common","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_forward_base_anzac","title":{"Namespace":"card_anzac","Key":"card_event_forward_base_anzac_title","SourceString":"FORWARD BASE","LocalizedString":"FORWARD BASE"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Anzac","kredits":2,"Text":{"Namespace":"card_anzac","Key":"card_event_forward_base_anzac_text","SourceString":"Discard your left-most card. Deal damage to target unit equal to its cost.","LocalizedString":"Discard your left-most card. Deal damage to target unit equal to its cost."},"flavorText":{"Namespace":"card_anzac","Key":"card_event_forward_base_anzac_history","SourceString":"A forward base is an advanced military position established close to an active combat zone. It allows troops to receive supplies, reinforcements, medical support and communications without relying entirely on support from distant rear bases. In the Pacific, where operations were often separated by mountains, jungle and long stretches of ocean, forward bases were essential for keeping forces supplied and maintaining pressure on the enemy. Australian and New Zealand forces made extensive use of them during WWII. In New Guinea, locations such as Port Moresby and Milne Bay became vital centres for air operations, logistics and troop movements. In 1942, at Milne Bay, Allied engineers built airfields that allowed aircraft to operate close to Japanese positions and supported Australian troops defending the area. As Allied forces advanced farther along the New Guinea coast, new bases and airfields were established closer to the front. These positions provided food, ammunition, fuel and medical care while giving aircraft and ground forces a staging point for the next operation. Forward bases therefore became a crucial part of the Allied advance through the Southwest Pacific.","LocalizedString":"A forward base is an advanced military position established close to an active combat zone. It allows troops to receive supplies, reinforcements, medical support and communications without relying entirely on support from distant rear bases. In the Pacific, where operations were often separated by mountains, jungle and long stretches of ocean, forward bases were essential for keeping forces supplied and maintaining pressure on the enemy. Australian and New Zealand forces made extensive use of them during WWII. In New Guinea, locations such as Port Moresby and Milne Bay became vital centres for air operations, logistics and troop movements. In 1942, at Milne Bay, Allied engineers built airfields that allowed aircraft to operate close to Japanese positions and supported Australian troops defending the area. As Allied forces advanced farther along the New Guinea coast, new bases and airfields were established closer to the front. These positions provided food, ammunition, fuel and medical care while giving aircraft and ground forces a staging point for the next operation. Forward bases therefore became a crucial part of the Allied advance through the Southwest Pacific."},"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::OceaniaStorm","soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Organic_War_Drums_4'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Organic_War_Drums_4.0"},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/FORWARD_BASE.FORWARD_BASE","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_anzac","Key":"card_event_forward_base_anzac_photo","SourceString":"A RAAF P-40 Kittyhawk at Milne Bay airfield, New Guinea, 1942.","LocalizedString":"A RAAF P-40 Kittyhawk at Milne Bay airfield, New Guinea, 1942."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""}},"variables":[{"name":"tmpCard","type":"UBaseCardObject*","direction":"in"},{"name":"locNumber","type":"int32","direction":"in"},{"name":"cardToDiscard","type":"int32","direction":"in"},{"name":"leftCost","type":"int32","direction":"in"}],"functions":[{"name":"CanPlayFromHand","owner":"card_event_forward_base_anzac_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direc