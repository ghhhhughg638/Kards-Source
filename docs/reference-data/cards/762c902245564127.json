{"format":"kards-original-reference","version":1,"id":"762c902245564127","name":"card_unit_32nd_infantry_regiment","package":"/Game/Blueprints/Cards/USA/Breakthrough/units/card_unit_32nd_infantry_regiment","parent":"UBaseCardObject","card":{"title":"32nd INFANTRY REGIMENT","text":"Deployment: Draw a 32nd INFANTRY REGIMENT from your deck.","flavorText":"The 32nd Infantry Regiment of the US Army was first formed in 1916 and has been active to the present day. During WWII the regiment was attached to the 7th Infantry Division which would play a major role in retaking the Attu Islands from the Japanese in 1943. In 1944 the division was one of the first to land on Leyte Island in the Philippines where they saw extensive combat in one of the bloodiest battles in the Pacific. The regiment participated in its last battle in Okinawa in 1945 and they would end the war in Korea where they received the surrender of Japanese troops.","faction":"USA","type":"infantry","rarity":"Common","cost":1,"operationCost":1,"attack":2,"defense":1},"defaults":{"UberGraphFrame":{},"Name":"card_unit_32nd_infantry_regiment","title":{"Namespace":"card_usa","Key":"card_unit_32nd_infantry_regiment_title","SourceString":"32nd INFANTRY REGIMENT","LocalizedString":"32nd INFANTRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":2,"defense":1,"range":1,"faction":"EFactionEnum::USA","kredits":1,"Text":{"Namespace":"card_usa","Key":"card_unit_32nd_infantry_regiment_text","SourceString":"Deployment: Draw a 32nd INFANTRY REGIMENT from your deck.","LocalizedString":"Deployment: Draw a 32nd INFANTRY REGIMENT from your deck."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_32nd_infantry_regiment_history","SourceString":"The 32nd Infantry Regiment of the US Army was first formed in 1916 and has been active to the present day. During WWII the regiment was attached to the 7th Infantry Division which would play a major role in retaking the Attu Islands from the Japanese in 1943. In 1944 the division was one of the first to land on Leyte Island in the Philippines where they saw extensive combat in one of the bloodiest battles in the Pacific. The regiment participated in its last battle in Okinawa in 1945 and they would end the war in Korea where they received the surrender of Japanese troops.","LocalizedString":"The 32nd Infantry Regiment of the US Army was first formed in 1916 and has been active to the present day. During WWII the regiment was attached to the 7th Infantry Division which would play a major role in retaking the Attu Islands from the Japanese in 1943. In 1944 the division was one of the first to land on Leyte Island in the Philippines where they saw extensive combat in one of the bloodiest battles in the Pacific. The regiment participated in its last battle in Okinawa in 1945 and they would end the war in Korea where they received the surrender of Japanese troops."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Breakthrough","returnSet":"ECardSetEnum::NavalWarfare","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion02'","ObjectPath":"kards/Content/StarterContent/Audio/Explosion02.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/CandidateArtwork/WE_Candidates/t_us_chocolate_boys.t_us_chocolate_boys","SubPathString":""},"artist":"Alamy Stock Photos","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/32nd_INFANTRY_REGIMENT.32nd_INFANTRY_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":386.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_32nd_infantry_regiment_photo","SourceString":"Mortar crew of the 7th Infantry Division, Attu Island, 1943.","LocalizedString":"Mortar crew of the 7th Infantry Division, Attu Island, 1943."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCamera