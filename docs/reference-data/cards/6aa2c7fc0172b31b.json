{"format":"kards-original-reference","version":1,"id":"6aa2c7fc0172b31b","name":"card_unit_raf_mustang","package":"/Game/Blueprints/Cards/Britain/Homefront/units/card_unit_raf_mustang","parent":"UBaseCardObject","card":{"title":"RAF MUSTANG","text":"Your non-British cards cost +2. Draw a card when the enemy targets or attacks this unit.","flavorText":"The RAF Mustang I was the first British-operated version of the American-designed North American P-51 Mustang. It entered service in 1942 and was powered by an Allison V-1710 engine that performed best at low altitudes. This made it ideal for tactical reconnaissance and ground attack missions, roles where its speed, range, and low-level agility were fully utilized. The RAF employed the Mustang I extensively for operations over France, the Low Countries, and occupied Europe. Flying low to evade radar and intercept German troop movements, its pilots gathered valuable intelligence and struck targets behind enemy lines. Its range allowed it to fly deep into enemy territory, supporting bombing missions and disrupting supply routes. Although it struggled at higher altitudes compared to fighters like the Spitfire or Bf 109, the Mustang I filled a critical gap in British tactical air power. Its success in these missions encouraged further development. Later versions, fitted with Rolls-Royce Merlin engines, would transform the Mustang into one of the most effective high-altitude escort fighters of the war. But it was the Mustang I that proved the concept in combat.","faction":"Britain","type":"fighter","rarity":"Unique","cost":4,"operationCost":2,"attack":5,"defense":4},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.bond"],"Name":"card_unit_raf_mustang","title":{"Namespace":"card_britain","Key":"card_unit_raf_mustang_title","SourceString":"RAF MUSTANG","LocalizedString":"RAF MUSTANG"},"Type":"ETypeEnum::fighter","attack":5,"defense":4,"range":2,"faction":"EFactionEnum::Britain","kredits":4,"Text":{"Namespace":"card_britain","Key":"card_unit_raf_mustang_text","SourceString":"Your non-British cards cost +2. Draw a card when the enemy targets or attacks this unit.","LocalizedString":"Your non-British cards cost +2. Draw a card when the enemy targets or attacks this unit."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_raf_mustang_history","SourceString":"The RAF Mustang I was the first British-operated version of the American-designed North American P-51 Mustang. It entered service in 1942 and was powered by an Allison V-1710 engine that performed best at low altitudes. This made it ideal for tactical reconnaissance and ground attack missions, roles where its speed, range, and low-level agility were fully utilized. The RAF employed the Mustang I extensively for operations over France, the Low Countries, and occupied Europe. Flying low to evade radar and intercept German troop movements, its pilots gathered valuable intelligence and struck targets behind enemy lines. Its range allowed it to fly deep into enemy territory, supporting bombing missions and disrupting supply routes. Although it struggled at higher altitudes compared to fighters like the Spitfire or Bf 109, the Mustang I filled a critical gap in British tactical air power. Its success in these missions encouraged further development. Later versions, fitted with Rolls-Royce Merlin engines, would transform the Mustang into one of the most effective high-altitude escort fighters of the war. But it was the Mustang I that proved the concept in combat.","LocalizedString":"The RAF Mustang I was the first British-operated version of the American-designed North American P-51 Mustang. It entered service in 1942 and was powered by an Allison V-1710 engine that performed best at low altitudes. This made it ideal for tactical reconnaissance and ground attack missions, roles where its speed, range, and low-level agility were fully utilized. The RAF employed the Mustang I extensively for operations over France, the Low Countries, and occupied Europe. Flying low to evade radar and intercept German troop movements, its pilots gathered valuable intelligence and struck targets behind enemy lines. Its range allowed it to fly deep into enemy territory, supporting bombing missions and disrupting supply routes. Although it struggled at higher altitudes compared to fighters like the Spitfire or Bf 109, the Mustang I filled a critical gap in British tactical air power. Its success in these missions encouraged further development. Later versions, fitted with Rolls-Royce Merlin engines, would transform the Mustang into one of the most effective high-altitude escort fighters of the war. But it was the Mustang I that proved the concept in combat."},"operationCost":2,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnBeforeOtherCardAttacks","ERegisteredCardFunction::OnOtherCardReset","ERegisteredCardFunction::OnOtherCardSpawnedInHand","ERegisteredCardFunction::OnOtherCardDrawnFromDeck","ERegisteredCardFunction::OnOtherCardPlayedFromHand","ERegisteredCardFunction::OnBeforeOtherCardPlayedFromHand"],"hasBlitz":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/RAF_MUSTANG.RAF_MUSTANG","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":391.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_unit_raf_mustang_photo","SourceString":"Two RAF North American Mustang Mk I’s in flight over Cambridgeshire, UK, 1942. ","LocalizedString":"Two RAF North American Mustang Mk I’s in flight over Cambridgeshire, UK, 1942. "},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftL'","ObjectPath":"kards/Content/Effects/Explosions/Large/Aircraft/P_ExplosionAircraftL.201"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName