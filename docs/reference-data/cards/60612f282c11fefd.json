{"format":"kards-original-reference","version":1,"id":"60612f282c11fefd","name":"card_event_entrenched","package":"/Game/Blueprints/Cards/Britain/WinterWar/events/card_event_entrenched","parent":"UBaseCardObject","card":{"title":"ENTRENCHED","text":"Give a friendly Guard unit +3 attack, Fury and Salvage.","flavorText":"While trench warfare was a defining characteristic of WWI, it was not the primary form of warfare in WWII. However, there were instances where trench-like defenses were used in specific locations during WWII, particularly in some defensive positions, sieges, and specific battles. F.ex. during the North African Campaign, Tobruk was subjected to a prolonged siege by the Axis forces in 1941, which lasted 241 days. During this time both sides dug extensive trench networks to defend and attack positions, similar to the trench warfare of WWI. The Siege of Tobruk was finally lifted when the British Eighth Army launched Operation Crusader and managed to break through the Axis lines and relieve the pressure on Tobruk.","faction":"Britain","type":"order","rarity":"Common","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_entrenched","title":{"Namespace":"card_britain","Key":"card_event_entrenched_title","SourceString":"ENTRENCHED","LocalizedString":"ENTRENCHED"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Britain","kredits":2,"Text":{"Namespace":"card_britain","Key":"card_event_entrenched_text","SourceString":"Give a friendly Guard unit +3 attack, Fury and Salvage.","LocalizedString":"Give a friendly Guard unit +3 attack, Fury and Salvage."},"flavorText":{"Namespace":"card_britain","Key":"card_event_entrenched_history","SourceString":"While trench warfare was a defining characteristic of WWI, it was not the primary form of warfare in WWII. However, there were instances where trench-like defenses were used in specific locations during WWII, particularly in some defensive positions, sieges, and specific battles. F.ex. during the North African Campaign, Tobruk was subjected to a prolonged siege by the Axis forces in 1941, which lasted 241 days. During this time both sides dug extensive trench networks to defend and attack positions, similar to the trench warfare of WWI. The Siege of Tobruk was finally lifted when the British Eighth Army launched Operation Crusader and managed to break through the Axis lines and relieve the pressure on Tobruk.","LocalizedString":"While trench warfare was a defining characteristic of WWI, it was not the primary form of warfare in WWII. However, there were instances where trench-like defenses were used in specific locations during WWII, particularly in some defensive positions, sieges, and specific battles. F.ex. during the North African Campaign, Tobruk was subjected to a prolonged siege by the Axis forces in 1941, which lasted 241 days. During this time both sides dug extensive trench networks to defend and attack positions, similar to the trench warfare of WWI. The Siege of Tobruk was finally lifted when the British Eighth Army launched Operation Crusader and managed to break through the Axis lines and relieve the pressure on Tobruk."},"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::WinterWar","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Fury","EHelpBubbleTypes::Salvage"],"soundEnterPlay":{"ObjectName":"SoundCue'AU_Seq_SupplyDrop_1P_Cue'","ObjectPath":"kards/Content/Assets/Audio/Misc/Supply_Drop/AU_Seq_SupplyDrop_1P_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/CandidateArtwork/Winter_War/t_entrenched.t_entrenched","SubPathString":""},"ImageAnchor":"EImageAnchor::Bot","artist":"Rebellion","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/ENTRENCHED.ENTRENCHED","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":387.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_event_entrenched_photo","SourceString":"