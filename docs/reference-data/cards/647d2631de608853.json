{"format":"kards-original-reference","version":1,"id":"647d2631de608853","name":"card_unit_93rd_messina","package":"/Game/Blueprints/Cards/Italy/units/card_unit_93rd_messina","parent":"UBaseCardObject","card":{"title":"93rd MESSINA","text":"Units that did not start in your deck cost 2 less to deploy.","flavorText":"The 93rd Infantry Regiment “Messina” was one of the two infantry regiments of the Italian 18th Infantry Division “Messina”. Its headquarters were located in Ancona, like the divisional headquarters, while the sister 94th Infantry Regiment was based in Fano. The regiment’s lineage went back to the Brigade “Messina”, formed in 1884 with the 93rd and 94th Infantry Regiments. The division was named after the city of Messina but recruited mainly in the Marche region. It remained stationed in Italy during the invasion of France, then moved to Albania in 1941 for the invasion of Yugoslavia. After crossing into Montenegro with XVII Army Corps, the Messina division captured Bar, Cetinje, and Kotor, where much of the Royal Yugoslav Navy was located. It then advanced to Podgorica and remained in the region on occupation duty. In 1942, the division was transferred to Croatia, where it later took part in Operation Alfa around Prozor. After the 1943 armistice, the division refused demands to surrender. The 93rd Regiment and the 108th CC.NN. Legion “Stamira” escaped by sea to southern Italy, while the rest of the division was disbanded by German forces.","faction":"Italy","type":"infantry","rarity":"Common","cost":3,"operationCost":1,"attack":2,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_93rd_messina","title":{"Namespace":"card_italy","Key":"card_unit_93rd_messina_title","SourceString":"93rd MESSINA","LocalizedString":"93rd MESSINA"},"Type":"ETypeEnum::infantry","attack":2,"defense":6,"range":1,"faction":"EFactionEnum::Italy","kredits":3,"Text":{"Namespace":"card_italy","Key":"card_unit_93rd_messina_text","SourceString":"Units that did not start in your deck cost 2 less to deploy.","LocalizedString":"Units that did not start in your deck cost 2 less to deploy."},"flavorText":{"Namespace":"card_italy","Key":"card_unit_93rd_messina_history","SourceString":"The 93rd Infantry Regiment “Messina” was one of the two infantry regiments of the Italian 18th Infantry Division “Messina”. Its headquarters were located in Ancona, like the divisional headquarters, while the sister 94th Infantry Regiment was based in Fano. The regiment’s lineage went back to the Brigade “Messina”, formed in 1884 with the 93rd and 94th Infantry Regiments. The division was named after the city of Messina but recruited mainly in the Marche region. It remained stationed in Italy during the invasion of France, then moved to Albania in 1941 for the invasion of Yugoslavia. After crossing into Montenegro with XVII Army Corps, the Messina division captured Bar, Cetinje, and Kotor, where much of the Royal Yugoslav Navy was located. It then advanced to Podgorica and remained in the region on occupation duty. In 1942, the division was transferred to Croatia, where it later took part in Operation Alfa around Prozor. After the 1943 armistice, the division refused demands to surrender. The 93rd Regiment and the 108th CC.NN. Legion “Stamira” escaped by sea to southern Italy, while the rest of the division was disbanded by German forces.","LocalizedString":"The 93rd Infantry Regiment “Messina” was one of the two infantry regiments of the Italian 18th Infantry Division “Messina”. Its headquarters were located in Ancona, like the divisional headquarters, while the sister 94th Infantry Regiment was based in Fano. The regiment’s lineage went back to the Brigade “Messina”, formed in 1884 with the 93rd and 94th Infantry Regiments. The division was named after the city of Messina but recruited mainly in the Marche region. It remained stationed in Italy during the invasion of France, then moved to Albania in 1941 for the invasion of Yugoslavia. After crossing into Montenegro with XVII Army Corps, the Messina division captured Bar, Cetinje, and Kotor, where much of the Royal Yugoslav Navy was located. It then advanced to Podgorica and remained in the region on occupation duty. In 1942, the division was transferred to Croatia, where it later took part in Operation Alfa around Prozor. After the 1943 armistice, the division refused demands to surrender. The 93rd Regiment and the 108th CC.NN. Legion “Stamira” escaped by sea to southern Italy, while the rest of the division was disbanded by German forces."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardReset","ERegisteredCardFunction::OnOtherCardDrawnFromDeck","ERegisteredCardFunction::OnOtherCardSpawnedInHand"],"hasGuard":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/93rd_MESSINA.93rd_MESSINA","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_italy","Key":"card_unit_93rd_messina_photo","SourceString":"Italian troops in Albania, 1941.","LocalizedString":"Italian troops in Albania, 1941."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"threat_level":0.1},"variables":[{"name":"tempCardID","type":"int32","direction":"in"},{"name":"TempCard","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_93rd_messina","owner":"card_unit_93rd_messina_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | F