{"format":"kards-original-reference","version":1,"id":"29cf78e8bdbf33ec","name":"card_unit_3_7_inch_mountain_howitzer","package":"/Game/Blueprints/Cards/ANZAC/units/card_unit_3_7_inch_mountain_howitzer","parent":"UBaseCardObject","card":{"title":"3.7 inch MOUNTAIN HOWITZER","text":"This unit also deals damage to enemies to the left of the enemy it attacks.","flavorText":"The QF 3.7-inch mountain howitzer was a lightweight artillery piece designed for use in terrain where conventional field guns were difficult to move. It could be broken down into eight separate loads for transport and, with a trained crew, reassembled and made ready to fire in about two minutes. Its high elevation and adjustable suspension made it particularly useful in steep or uneven country. During WWII, the weapon saw service with Commonwealth forces in several theatres, including the Kokoda Campaign in New Guinea. For Australian troops fighting through the mountains and jungles of Papua, the howitzer’s portability allowed artillery support to be brought into positions that heavier guns could not easily reach. Its 20-pound shells could be fired to a maximum range of about 5,900 yards (5.4 km). Australian gunners in Papua New Guinea even used the normally restricted fifth propellant charge for emergencies, giving it the nickname “O’Hara’s charge.” Ultimately, the 3.7-inch mountain howitzer proved well-suited to the difficult terrain faced by Australian forces in the Southwest Pacific.","faction":"Anzac","type":"artillery","rarity":"Uncommon","cost":2,"operationCost":1,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_3_7_inch_mountain_howitzer","title":{"Namespace":"card_anzac","Key":"card_unit_3_7_inch_mountain_howitzer_title","SourceString":"3.7 inch MOUNTAIN HOWITZER","LocalizedString":"3.7 inch MOUNTAIN HOWITZER"},"Type":"ETypeEnum::artillery","attack":1,"defense":2,"range":2,"faction":"EFactionEnum::Anzac","kredits":2,"Text":{"Namespace":"card_anzac","Key":"card_unit_3_7_inch_mountain_howitzer_text","SourceString":"This unit also deals damage to enemies to the left of the enemy it attacks.","LocalizedString":"This unit also deals damage to enemies to the left of the enemy it attacks."},"flavorText":{"Namespace":"card_anzac","Key":"card_unit_3_7_inch_mountain_howitzer_history","SourceString":"The QF 3.7-inch mountain howitzer was a lightweight artillery piece designed for use in terrain where conventional field guns were difficult to move. It could be broken down into eight separate loads for transport and, with a trained crew, reassembled and made ready to fire in about two minutes. Its high elevation and adjustable suspension made it particularly useful in steep or uneven country. During WWII, the weapon saw service with Commonwealth forces in several theatres, including the Kokoda Campaign in New Guinea. For Australian troops fighting through the mountains and jungles of Papua, the howitzer’s portability allowed artillery support to be brought into positions that heavier guns could not easily reach. Its 20-pound shells could be fired to a maximum range of about 5,900 yards (5.4 km). Australian gunners in Papua New Guinea even used the normally restricted fifth propellant charge for emergencies, giving it the nickname “O’Hara’s charge.” Ultimately, the 3.7-inch mountain howitzer proved well-suited to the difficult terrain faced by Australian forces in the Southwest Pacific.","LocalizedString":"The QF 3.7-inch mountain howitzer was a lightweight artillery piece designed for use in terrain where conventional field guns were difficult to move. It could be broken down into eight separate loads for transport and, with a trained crew, reassembled and made ready to fire in about two minutes. Its high elevation and adjustable suspension made it particularly useful in steep or uneven country. During WWII, the weapon saw service with Commonwealth forces in several theatres, including the Kokoda Campaign in New Guinea. For Australian troops fighting through the mountains and jungles of Papua, the howitzer’s portability allowed artillery support to be brought into positions that heavier guns could not easily reach. Its 20-pound shells could be fired to a maximum range of about 5,900 yards (5.4 km). Australian gunners in Papua New Guinea even used the normally restricted fifth propellant charge for emergencies, giving it the nickname “O’Hara’s charge.” Ultimately, the 3.7-inch mountain howitzer proved well-suited to the difficult terrain faced by Australian forces in the Southwest Pacific."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::OceaniaStorm","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Passive","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/3_7_inch_MOUNTAIN_HOWITZER.3_7_inch_MOUNTAIN_HOWITZER","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_anzac","Key":"card_unit_3_7_inch_mountain_howitzer_photo","SourceString":"A QF 3.7-inch mountain howitzer in action in Burma, 1944.","LocalizedString":"A QF 3.7-inch mountain howitzer in action in Burma, 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionArmourS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionArmourS.31"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackArtillery.BP_AttackArtillery_C","SubPathString":""}},"variables":[{"name":"stuffToDamage","type":"TArray<UBaseCardObject*>","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_3_7_inch_mountain_howitzer","owner":"card_unit_3_7_inch_mountain_howitzer_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Loop_Counter_Variable","type":"int32","dire