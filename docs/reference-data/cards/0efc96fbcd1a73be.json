{"format":"kards-original-reference","version":1,"id":"0efc96fbcd1a73be","name":"card_unit_tempest_mk_v","package":"/Game/Blueprints/Cards/Britain/Allegiance/units/card_unit_tempest_mk_v","parent":"UBaseCardObject","card":{"title":"TEMPEST Mk V","text":"Has +4 attack on enemy turns.","flavorText":"The Hawker Tempest was a British fighter aircraft used by the RAF and its Allies during WWII. The aircraft was originally known as Typhoon II and was an improved version of the Hawker Typhoon, designed to improve combat performance at high altitude. However, after considerable alterations from the Typhoon it was decided to rename the aircraft to Tempest, which came to be one of the most powerful fighters of WWII. When the Tempest entered service in 1944 it was used as a low-level interceptor against the V-1 flying bomb and the jet-propelled ME 262, and also as a ground attack aircraft in Operation Market Garden. Later it was also used in combat against Japan in South-East Asia as part of the Commonwealth Tiger Force. A total of 1,702 aircraft were built, including variants.","faction":"Britain","type":"fighter","rarity":"Uncommon","cost":7,"operationCost":2,"attack":3,"defense":7},"defaults":{"UberGraphFrame":{},"Name":"card_unit_tempest_mk_v","title":{"Namespace":"card_britain","Key":"card_unit_tempest_mk_v_title","SourceString":"TEMPEST Mk V","LocalizedString":"TEMPEST Mk V"},"Type":"ETypeEnum::fighter","attack":3,"defense":7,"range":2,"faction":"EFactionEnum::Britain","kredits":7,"Text":{"Namespace":"card_britain","Key":"card_unit_tempest_mk_v_text","SourceString":"Has +4 attack on enemy turns.","LocalizedString":"Has +4 attack on enemy turns."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_tempest_mk_v_history","SourceString":"The Hawker Tempest was a British fighter aircraft used by the RAF and its Allies during WWII. The aircraft was originally known as Typhoon II and was an improved version of the Hawker Typhoon, designed to improve combat performance at high altitude. However, after considerable alterations from the Typhoon it was decided to rename the aircraft to Tempest, which came to be one of the most powerful fighters of WWII. When the Tempest entered service in 1944 it was used as a low-level interceptor against the V-1 flying bomb and the jet-propelled ME 262, and also as a ground attack aircraft in Operation Market Garden. Later it was also used in combat against Japan in South-East Asia as part of the Commonwealth Tiger Force. A total of 1,702 aircraft were built, including variants.","LocalizedString":"The Hawker Tempest was a British fighter aircraft used by the RAF and its Allies during WWII. The aircraft was originally known as Typhoon II and was an improved version of the Hawker Typhoon, designed to improve combat performance at high altitude. However, after considerable alterations from the Typhoon it was decided to rename the aircraft to Tempest, which came to be one of the most powerful fighters of WWII. When the Tempest entered service in 1944 it was used as a low-level interceptor against the V-1 flying bomb and the jet-propelled ME 262, and also as a ground attack aircraft in Operation Market Garden. Later it was also used in combat against Japan in South-East Asia as part of the Commonwealth Tiger Force. A total of 1,702 aircraft were built, including variants."},"operationCost":2,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Expansion2019","isReserved":true,"EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnStartofTurn","ERegisteredCardFunction::OnEndOfTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Ambush"],"hasAmbush":true,"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/Allegiance/t_lowres_tempest.t_lowres_tempest","SubPathString":""},"artist":"Robert Taylor","historyPhoto":{