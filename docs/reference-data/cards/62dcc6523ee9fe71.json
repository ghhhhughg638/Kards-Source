{"format":"kards-original-reference","version":1,"id":"62dcc6523ee9fe71","name":"card_unit_kings_african_rifles","package":"/Game/Blueprints/Cards/Britain/Homefront/units/card_unit_kings_african_rifles","parent":"UBaseCardObject","card":{"title":"KING'S AFRICAN RIFLES","text":"Deployment: Choose a unit in hand. Give it +1+1 and Bond. +3+3 instead if it already has Bond.","flavorText":"The King’s African Rifles (KAR) was a multi-battalion regiment of African soldiers under British command, drawn from Britain’s East African colonies. At the start of WWII, the regiment consisted of only six battalions. Wartime expansion saw it grow to 43 battalions by 1943, including support units like engineers, signals, and medical detachments. Recruits came from Kenya, Tanganyika, Uganda, Nyasaland, and Northern Rhodesia. KAR units fought in the East African Campaign against Italian forces in Ethiopia and Somaliland, conducting mountain warfare in challenging terrain. In 1942, the regiment took part in the invasion of Madagascar, helping to remove the Vichy French presence. Later, KAR formations were sent to Burma. The 11th (East African) Division, formed largely from KAR units, fought in the Arakan and across central Burma. African soldiers of the KAR crossed the Irrawaddy River, helped take Mandalay, and advanced on Rangoon. They proved adept at jungle warfare, often using machetes instead of bayonets, and showed strong discipline and adaptability despite racial inequities in pay and rations. By the end of the war, over 100,000 African troops had served in the KAR, making it one of the largest African formations in the British Empire.","faction":"Britain","type":"infantry","rarity":"Rare","cost":3,"operationCost":1,"attack":4,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_kings_african_rifles","title":{"Namespace":"card_britain","Key":"card_unit_kings_african_rifles_title","SourceString":"KING'S AFRICAN RIFLES","LocalizedString":"KING'S AFRICAN RIFLES"},"Type":"ETypeEnum::infantry","attack":4,"defense":4,"range":1,"faction":"EFactionEnum::Britain","kredits":3,"Text":{"Namespace":"card_britain","Key":"card_unit_kings_african_rifles_text","SourceString":"Deployment: Choose a unit in hand. Give it +1+1 and Bond. +3+3 instead if it already has Bond.","LocalizedString":"Deployment: Choose a unit in hand. Give it +1+1 and Bond. +3+3 instead if it already has Bond."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_kings_african_rifles_history","SourceString":"The King’s African Rifles (KAR) was a multi-battalion regiment of African soldiers under British command, drawn from Britain’s East African colonies. At the start of WWII, the regiment consisted of only six battalions. Wartime expansion saw it grow to 43 battalions by 1943, including support units like engineers, signals, and medical detachments. Recruits came from Kenya, Tanganyika, Uganda, Nyasaland, and Northern Rhodesia. KAR units fought in the East African Campaign against Italian forces in Ethiopia and Somaliland, conducting mountain warfare in challenging terrain. In 1942, the regiment took part in the invasion of Madagascar, helping to remove the Vichy French presence. Later, KAR formations were sent to Burma. The 11th (East African) Division, formed largely from KAR units, fought in the Arakan and across central Burma. African soldiers of the KAR crossed the Irrawaddy River, helped take Mandalay, and advanced on Rangoon. They proved adept at jungle warfare, often using machetes instead of bayonets, and showed strong discipline and adaptability despite racial inequities in pay and rations. By the end of the war, over 100,000 African troops had served in the KAR, making it one of the largest African formations in the British Empire.","LocalizedString":"The King’s African Rifles (KAR) was a multi-battalion regiment of African soldiers under British command, drawn from Britain’s East African colonies. At the start of WWII, the regiment consisted of only six battalions. Wartime expansion saw it grow to 43 battalions by 1943, including support units like engineers, signals, and medical detachments. Recruits came from Kenya, Tanganyika, Uganda, Nyasaland, and Northern Rhodesia. KAR units fought in the East African Campaign against Italian forces in Ethiopia and Somaliland, conducting mountain warfare in challenging terrain. In 1942, the regiment took part in the invasion of Madagascar, helping to remove the Vichy French presence. Later, KAR formations were sent to Burma. The 11th (East African) Division, formed largely from KAR units, fought in the Arakan and across central Burma. African soldiers of the KAR crossed the Irrawaddy River, helped take Mandalay, and advanced on Rangoon. They proved adept at jungle warfare, often using machetes instead of bayonets, and showed strong discipline and adaptability despite racial inequities in pay and rations. By the end of the war, over 100,000 African troops had served in the KAR, making it one of the largest African formations in the British Empire."},"operationCost":1,"rarity":"ERarityEnum::Rare","waitWithOnOtherCardPlayedUntilHandTargetSelected":true,"selectHandCardNotifyText":{"Namespace":"","Key":"70A1C06347E081F7AFB86DBA3D1488A8","SourceString":"Choose a unit in hand.","LocalizedString":"Choose a unit in hand."},"cardSet":"ECardSetEnum::Homefront","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Bond"],"hasDeployment":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/KING_S_AFRICAN_RIFLES.KING_S_AFRICAN_RIFLES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":508.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_unit_kings_african_rifles_photo","SourceString":"Men of 11th East African Division on the road to Kalewa, Burma, 1945.","LocalizedString":"Men of 11th East African Division on the road to Kalewa, Burma, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_kings_african_rifles","owner":"card_unit_kings_african_rifles_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"K2Node_Event_handTargetCardID","type":"int32","direction":"in"},{"name":"K2Node_Event_instigatorID","type":"int32","direction":"in"},{"name":"CallFunc_GiveBond_qqq","type":"int32","direction":"in"},{"name":"CallFunc_GetCardFromID_card","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_ChangeDefense_qqq","type":"bool","direction":"in"},{"name":"CallFunc_selectTargetFromHand_qqq","type":"int32","direction":"in"},{"name":"CallFunc_ChangeDefense_qqq_1","type":"bool","direction":"in"},{"name":"CallFunc_ChangeAttack_qqq","type":"bool","direction":"in"},{"name":"CallFunc_ChangeAttack_qqq_1","type":"bool","direction":"in"},{"name":"CallFunc_HasBond_hasIt","type":"bool","direction":"in"},{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"}],"body":[{"op":"ComputedJump","at":0,"value":{"op":"Variable","name":"EntryPoint","type":"int32","scope":"local","sourceOp":"LocalVariable"}},{"op":"Context","at":10,"object":{"op":"Variable","name":"cardFunction","type":"ACardFunctionsStub*","scope":"member","sourceOp":"InstanceVariable"},"value":{"op":"LocalVirtualFunction","name":"GetCardFromID","signature":"CardFunctionsStub.GetCardFromID","args":[{"op":"Variable","name":"K2Node_Event_handTargetCardID","type":"int32","scope":"local","sourceOp":"LocalVariable"},{"op":"Variable","name":"CallFunc_GetCardFromID_card","type":"UBaseCardObject*","sc