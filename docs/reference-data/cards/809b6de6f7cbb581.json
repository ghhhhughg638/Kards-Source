{"format":"kards-original-reference","version":1,"id":"809b6de6f7cbb581","name":"card_unit_c47_skytrain","package":"/Game/Blueprints/Cards/USA/Breakthrough/units/card_unit_c47_skytrain","parent":"UBaseCardObject","card":{"title":"C-47 SKYTRAIN","text":"At the end of your turn, add a random 1-cost US infantry to your support line.","flavorText":"The Douglas C-47 Skytrain, also known as R4D transports and the C-47 Dakota, was an American military transport aircraft manufactured by the Douglas Aircraft Company and used by the US Army Air Forces and the Allies in WWII. The C-47 was based on the design of the civilian passenger airliner DC-3. The aircraft served in all theaters of the war and was used to airlift military supplies, to evacuate wounded from remote islands suchs as the Guadalcanal and to drop paratroopers. Over 10,000 aircraft were produced, including variants, and they were still in service during the Korean and Vietnam war.","faction":"USA","type":"fighter","rarity":"Unique","cost":3,"operationCost":2,"attack":0,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_c47_skytrain","title":{"Namespace":"card_usa","Key":"card_unit_c47_skytrain_title","SourceString":"C-47 SKYTRAIN","LocalizedString":"C-47 SKYTRAIN"},"Type":"ETypeEnum::fighter","defense":4,"range":2,"faction":"EFactionEnum::USA","kredits":3,"Text":{"Namespace":"card_usa","Key":"card_unit_c47_skytrain_text","SourceString":"At the end of your turn, add a random 1-cost US infantry to your support line.","LocalizedString":"At the end of your turn, add a random 1-cost US infantry to your support line."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_c47_skytrain_history","SourceString":"The Douglas C-47 Skytrain, also known as R4D transports and the C-47 Dakota, was an American military transport aircraft manufactured by the Douglas Aircraft Company and used by the US Army Air Forces and the Allies in WWII. The C-47 was based on the design of the civilian passenger airliner DC-3. The aircraft served in all theaters of the war and was used to airlift military supplies, to evacuate wounded from remote islands suchs as the Guadalcanal and to drop paratroopers. Over 10,000 aircraft were produced, including variants, and they were still in service during the Korean and Vietnam war.","LocalizedString":"The Douglas C-47 Skytrain, also known as R4D transports and the C-47 Dakota, was an American military transport aircraft manufactured by the Douglas Aircraft Company and used by the US Army Air Forces and the Allies in WWII. The C-47 was based on the design of the civilian passenger airliner DC-3. The aircraft served in all theaters of the war and was used to airlift military supplies, to evacuate wounded from remote islands suchs as the Guadalcanal and to drop paratroopers. Over 10,000 aircraft were produced, including variants, and they were still in service during the Korean and Vietnam war."},"operationCost":2,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::Breakthrough","returnSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"soundEnterPlay":{"ObjectName":"SoundCue'AU__Bomber_IntoPos_Cue'","ObjectPath":"kards/Content/Assets/Audio/Bomber/AU__Bomber_IntoPos_Cue.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'AU_AirCraft_Bomber_flyby_04_6s'","ObjectPath":"kards/Content/Assets/Audio/Bomber/AU_AirCraft_Bomber_flyby_04_6s.0"},"soundAttack":{"ObjectName":"SoundWave'AU_AirCraft_Bomber_flyby_04_6s'","ObjectPath":"kards/Content/Assets/Audio/Bomber/AU_AirCraft_Bomber_flyby_04_6s.0"},"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Large_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Large_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/CandidateArtwork/t_airdrop.t_airdrop","SubPathString":""},"artist":"Robert Taylor","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/C-47_SKYTRAIN.C-47_SKYTRAIN",