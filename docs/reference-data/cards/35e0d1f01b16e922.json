{"format":"kards-original-reference","version":1,"id":"35e0d1f01b16e922","name":"card_unit_utsunomiya_regiment","package":"/Game/Blueprints/Cards/Japan/Breakthrough/units/card_unit_utsunomiya_regiment","parent":"UBaseCardObject","card":{"title":"UTSUNOMIYA REGIMENT","text":"When the enemy gives an order, deal 2 damage to the enemy HQ.","flavorText":"The 59th Infantry regiment Utsunomiya was a regiment of the 14th Division (codenamed the Shining Division) of the Imperial Japanese Army and was first formed in 1905. During WWII the division was assigned to garrison duty in China in 1942. As the situation in the Pacific deteriorated the division was split up and deployed on various islands in the Pacific, including Angaur and Peleliu. One battalion of the 59th Infantry Regiment was stationed in the island of Angaur and the rest were sent to the Babeldaob island. The island of Babeldaob was never invaded by the Allies, but the Battle of Angaur and the Battle of Peleliu were among the bloodiest battles in the Pacific War and almost all defenders were killed.","faction":"Japan","type":"infantry","rarity":"Common","cost":5,"operationCost":1,"attack":4,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_utsunomiya_regiment","title":{"Namespace":"card_japan","Key":"card_unit_utsunomiya_regiment_title","SourceString":"UTSUNOMIYA REGIMENT","LocalizedString":"UTSUNOMIYA REGIMENT"},"Type":"ETypeEnum::infantry","attack":4,"defense":6,"range":1,"faction":"EFactionEnum::Japan","kredits":5,"Text":{"Namespace":"card_japan","Key":"card_unit_utsunomiya_regiment_text","SourceString":"When the enemy gives an order, deal 2 damage to the enemy HQ.","LocalizedString":"When the enemy gives an order, deal 2 damage to the enemy HQ."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_utsunomiya_regiment_history","SourceString":"The 59th Infantry regiment Utsunomiya was a regiment of the 14th Division (codenamed the Shining Division) of the Imperial Japanese Army and was first formed in 1905. During WWII the division was assigned to garrison duty in China in 1942. As the situation in the Pacific deteriorated the division was split up and deployed on various islands in the Pacific, including Angaur and Peleliu. One battalion of the 59th Infantry Regiment was stationed in the island of Angaur and the rest were sent to the Babeldaob island. The island of Babeldaob was never invaded by the Allies, but the Battle of Angaur and the Battle of Peleliu were among the bloodiest battles in the Pacific War and almost all defenders were killed.","LocalizedString":"The 59th Infantry regiment Utsunomiya was a regiment of the 14th Division (codenamed the Shining Division) of the Imperial Japanese Army and was first formed in 1905. During WWII the division was assigned to garrison duty in China in 1942. As the situation in the Pacific deteriorated the division was split up and deployed on various islands in the Pacific, including Angaur and Peleliu. One battalion of the 59th Infantry Regiment was stationed in the island of Angaur and the rest were sent to the Babeldaob island. The island of Babeldaob was never invaded by the Allies, but the Battle of Angaur and the Battle of Peleliu were among the bloodiest battles in the Pacific War and almost all defenders were killed."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Breakthrough","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnBeforeOtherCardPlayedFromHand"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Trigger"],"soundBlowUp":{"ObjectName":"SoundCue'au_inf_conrete'","ObjectPath":"kards/Content/Explosions_SFX/Cues/au_inf_conrete.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/DontUseOrTemp/t_jap_inf6.t_jap_inf6","SubPathString":""},"artist":"Asgeir Jon","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/UTSUNOMIYA_REGIMENT.UTSUNOMIYA_REGIMENT","SubPathString":""},"historyPhotoSi