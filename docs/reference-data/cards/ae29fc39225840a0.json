{"format":"kards-original-reference","version":1,"id":"ae29fc39225840a0","name":"card_unit_kanazawa_regiment","package":"/Game/Blueprints/Cards/Japan/Homefront/units/card_unit_kanazawa_regiment","parent":"UBaseCardObject","card":{"title":"KANAZAWA REGIMENT","text":"When an undestroyed unit leaves the battlefield, deal 2 damage to the enemy HQ, give yours +2 defense.","flavorText":"The 283rd Infantry regiment (Kanazawa) belonged to the 128th Division, an infantry formation created by the Imperial Japanese Army in January 1945 as Japan braced for invasion. The division was assembled during the final stage of the war, with its regiments, including the 283rd Regiment, drawn from the Toyama region. Initially tasked with defending the Japanese coastline, the division was soon redirected to the Asian mainland. In August 1945, the 128th Division was stationed in Manchuria under the command of the Kwantung Army when the Soviet Union launched a massive invasion. During this brief but intense campaign, the division faced overwhelming Soviet armored and air assaults. Despite being under-equipped and hastily organized, units like the Kanazawa Regiment attempted to resist the Soviet advance across northeastern Manchuria. The fighting was short-lived. Japan surrendered within days of the Soviet attack, and the 128th Division ceased operations soon after. Many of its soldiers were taken prisoner and interned in Soviet labor camps. Though formed late and given little time to prepare, the division saw real combat in the final hours of Japan’s war effort.","faction":"Japan","type":"infantry","rarity":"Uncommon","cost":5,"operationCost":1,"attack":5,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_kanazawa_regiment","title":{"Namespace":"card_japan","Key":"card_unit_kanazawa_regiment_title","SourceString":"KANAZAWA REGIMENT","LocalizedString":"KANAZAWA REGIMENT"},"Type":"ETypeEnum::infantry","attack":5,"defense":5,"range":1,"faction":"EFactionEnum::Japan","kredits":5,"Text":{"Namespace":"card_japan","Key":"card_unit_kanazawa_regiment_text","SourceString":"When an undestroyed unit leaves the battlefield, deal 2 damage to the enemy HQ, give yours +2 defense.","LocalizedString":"When an undestroyed unit leaves the battlefield, deal 2 damage to the enemy HQ, give yours +2 defense."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_kanazawa_regiment_history","SourceString":"The 283rd Infantry regiment (Kanazawa) belonged to the 128th Division, an infantry formation created by the Imperial Japanese Army in January 1945 as Japan braced for invasion. The division was assembled during the final stage of the war, with its regiments, including the 283rd Regiment, drawn from the Toyama region. Initially tasked with defending the Japanese coastline, the division was soon redirected to the Asian mainland. In August 1945, the 128th Division was stationed in Manchuria under the command of the Kwantung Army when the Soviet Union launched a massive invasion. During this brief but intense campaign, the division faced overwhelming Soviet armored and air assaults. Despite being under-equipped and hastily organized, units like the Kanazawa Regiment attempted to resist the Soviet advance across northeastern Manchuria. The fighting was short-lived. Japan surrendered within days of the Soviet attack, and the 128th Division ceased operations soon after. Many of its soldiers were taken prisoner and interned in Soviet labor camps. Though formed late and given little time to prepare, the division saw real combat in the final hours of Japan’s war effort.","LocalizedString":"The 283rd Infantry regiment (Kanazawa) belonged to the 128th Division, an infantry formation created by the Imperial Japanese Army in January 1945 as Japan braced for invasion. The division was assembled during the final stage of the war, with its regiments, including the 283rd Regiment, drawn from the Toyama region. Initially tasked with defending the Japanese coastline, the division was soon redirected to the Asian mainland. In August 1945, the 128th Division was stationed in Manchuria under the command of the Kwantung Army when the Soviet Union launched a massive invasion. During this brief but intense campaign, the division faced overwhelming Soviet armored and air assaults. Despite being under-equipped and hastily organized, units like the Kanazawa Regiment attempted to resist the Soviet advance across northeastern Manchuria. The fighting was short-lived. Japan surrendered within days of the Soviet attack, and the 128th Division ceased operations soon after. Many of its soldiers were taken prisoner and interned in Soviet labor camps. Though formed late and given little time to prepare, the division saw real combat in the final hours of Japan’s war effort."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardLeaveBoardOrOwner"],"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/KANAZAWA_REGIMENT.KANAZAWA_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":341.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_kanazawa_regiment_photo","SourceString":"Japanese soldiers surrendering to Soviet troops in Manchuria, August 1945.","LocalizedString":"Japanese soldiers surrendering to Soviet troops in Manchuria, August 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"isAttackBuff":true,"isDefenseBuff":true},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_kanaz