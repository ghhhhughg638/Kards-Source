{"format":"kards-original-reference","version":1,"id":"64f501a0c8fc31c1","name":"card_unit_62nd_armored_infantry","package":"/Game/Blueprints/Cards/USA/BloodIron/units/card_unit_62nd_armored_infantry","parent":"UBaseCardObject","card":{"title":"62nd ARMORED INFANTRY","text":"Deployment: Your Shermans get +2+2. If you have none, add a M4 SHERMAN to your hand.","flavorText":"The 62nd Armored Infantry Regiment was a regiment of the 14th Armored Division of the United States Army. The division was formed in 1942 and was officially nicknamed the \"Liberators\". Although it was inactivated in 1945, it remains eligible for reactivation whenever needed. The division landed in Marseilles, southern France, in November 1944 and participated in heavy combat as part of the U.S. 6th Army Group, and later, the U.S. Seventh Army. In December 1944, just before New Year's Eve, the 14th Division was caught in Operation Northwind, the last major German counteroffensive of the war. The division engaged in heavy defensive fighting in January 1945, and although the Germans achieved some success, the main thrust of Operation Northwind was halted by the 14th Armored Division. In March 1945, the division advanced into Germany, breaking through the Siegfried Line. It later participated in the Capture of Heilbronn and the Battle of Nuremberg. During the advance, the division liberated several POW camps, including Stalag XIII-C, Oflag XIII-B, and Stalag VII-A, the largest prisoner-of-war camp in Germany. Later, the men of the 14th Armored Division liberated several sub-camps of the Dachau concentration camp. The division earned its nickname, the \"Liberators,\" during the final days of the war after freeing around 200,000 Allied prisoners of war from German prison camps. In September 1945, the division was inactivated.","faction":"USA","type":"infantry","rarity":"Uncommon","cost":4,"operationCost":1,"attack":4,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_62nd_armored_infantry","title":{"Namespace":"card_usa","Key":"card_unit_62nd_armored_infantry_title","SourceString":"62nd ARMORED INFANTRY","LocalizedString":"62nd ARMORED INFANTRY"},"Type":"ETypeEnum::infantry","attack":4,"defense":4,"range":1,"faction":"EFactionEnum::USA","kredits":4,"Text":{"Namespace":"card_usa","Key":"card_unit_62nd_armored_infantry_text","SourceString":"Deployment: Your Shermans get +2+2. If you have none, add a M4 SHERMAN to your hand.","LocalizedString":"Deployment: Your Shermans get +2+2. If you have none, add a M4 SHERMAN to your hand."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_62nd_armored_infantry_history","SourceString":"The 62nd Armored Infantry Regiment was a regiment of the 14th Armored Division of the United States Army. The division was formed in 1942 and was officially nicknamed the \"Liberators\". Although it was inactivated in 1945, it remains eligible for reactivation whenever needed. The division landed in Marseilles, southern France, in November 1944 and participated in heavy combat as part of the U.S. 6th Army Group, and later, the U.S. Seventh Army. In December 1944, just before New Year's Eve, the 14th Division was caught in Operation Northwind, the last major German counteroffensive of the war. The division engaged in heavy defensive fighting in January 1945, and although the Germans achieved some success, the main thrust of Operation Northwind was halted by the 14th Armored Division. In March 1945, the division advanced into Germany, breaking through the Siegfried Line. It later participated in the Capture of Heilbronn and the Battle of Nuremberg. During the advance, the division liberated several POW camps, including Stalag XIII-C, Oflag XIII-B, and Stalag VII-A, the largest prisoner-of-war camp in Germany. Later, the men of the 14th Armored Division liberated several sub-camps of the Dachau concentration camp. The division earned its nickname, the \"Liberators,\" during the final days of the war after freeing around 200,000 Allied prisoners of war from German prison camps. In September 1945, the division was inactivated.","LocalizedString":"The 62nd Armored Infantry Regiment was a regiment of the 14th Armored Division of the United States Army. The division was formed in 1942 and was officially nicknamed the \"Liberators\". Although it was inactivated in 1945, it remains eligible for reactivation whenever needed. The division landed in Marseilles, southern France, in November 1944 and participated in heavy combat as part of the U.S. 6th Army Group, and later, the U.S. Seventh Army. In December 1944, just before New Year's Eve, the 14th Division was caught in Operation Northwind, the last major German counteroffensive of the war. The division engaged in heavy defensive fighting in January 1945, and although the Germans achieved some success, the main thrust of Operation Northwind was halted by the 14th Armored Division. In March 1945, the division advanced into Germany, breaking through the Siegfried Line. It later participated in the Capture of Heilbronn and the Battle of Nuremberg. During the advance, the division liberated several POW camps, including Stalag XIII-C, Oflag XIII-B, and Stalag VII-A, the largest prisoner-of-war camp in Germany. Later, the men of the 14th Armored Division liberated several sub-camps of the Dachau concentration camp. The division earned its nickname, the \"Liberators,\" during the final days of the war after freeing around 200,000 Allied prisoners of war from German prison camps. In September 1945, the division was inactivated."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::BloodAndIron","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"draftBaseWeight":0.95,"hasDeployment":true,"spawnCardName":"card_unit_m4_sherman","Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/Winter_2024/t_us_armored_inf_not_final_vs.t_us_armored_inf_not_final_vs","SubPathString":""},"ImageAnchor":"EImageAnchor::Bot","artist":"US WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/62nd_ARMORED_INFANTRY.62nd_ARMORED_INFANTRY","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":288.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_62nd_armored_infantry_photo","SourceString":"Men of the 62nd Armored Infantry Regiment making their way through the ruins of Gemünden, Germany, 1945.","LocalizedString":"Men of the 62nd Armored Infantry Regiment making their way through the ruins of Gemünden, Germany, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"isDirectDamage":true},"variables":[{"name":"count","type":"int32","direction":"in"},{"name":"tempCard","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_62nd_armored_infantry","owner":"card_unit_62nd_armored_infantry_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"CallFunc_getHasGameplayTag_hasTag","type":"bool","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Variable","type":"int32","direction":"in"},{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_Less_IntInt_ReturnValue","type":"bool","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue_1","type":"int32","direction":"in"},{"nam