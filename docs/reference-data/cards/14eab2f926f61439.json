{"format":"kards-original-reference","version":1,"id":"14eab2f926f61439","name":"card_event_winter_war","package":"/Game/Blueprints/Cards/Soviet/Base/events/card_event_winter_war","parent":"UBaseCardObject","card":{"title":"WINTER WARFARE","text":"Deal 1 damage to all.","flavorText":"The Russian winter was a substantial contributing factor in the Soviet victory over the invading German forces in WWII. The winter temperature in Moscow isn't extremely cold, but it so happens that the winter of 1941-1942 was the coldest of the 20th century. The Wehrmacht was by no means prepared for a winter war, the German high command thought the war would be over long before it would hit, and before winter struck they were already overextended and badly supplied. The Soviets were better prepared, with winter uniforms, equipment designed for the cold and having the huge advantage of being on the defending side, compared to attacking in winter cold.","faction":"Soviet","type":"order","rarity":"Uncommon","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_winter_war","title":{"Namespace":"card_soviet","Key":"card_event_winter_war_title","SourceString":"WINTER WARFARE","LocalizedString":"WINTER WARFARE"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Soviet","kredits":1,"Text":{"Namespace":"card_soviet","Key":"card_event_winter_war_text","SourceString":"Deal 1 damage to all.","LocalizedString":"Deal 1 damage to all."},"flavorText":{"Namespace":"card_soviet","Key":"card_event_winter_war_history","SourceString":"The Russian winter was a substantial contributing factor in the Soviet victory over the invading German forces in WWII. The winter temperature in Moscow isn't extremely cold, but it so happens that the winter of 1941-1942 was the coldest of the 20th century. The Wehrmacht was by no means prepared for a winter war, the German high command thought the war would be over long before it would hit, and before winter struck they were already overextended and badly supplied. The Soviets were better prepared, with winter uniforms, equipment designed for the cold and having the huge advantage of being on the defending side, compared to attacking in winter cold.","LocalizedString":"The Russian winter was a substantial contributing factor in the Soviet victory over the invading German forces in WWII. The winter temperature in Moscow isn't extremely cold, but it so happens that the winter of 1941-1942 was the coldest of the 20th century. The Wehrmacht was by no means prepared for a winter war, the German high command thought the war would be over long before it would hit, and before winter struck they were already overextended and badly supplied. The Soviets were better prepared, with winter uniforms, equipment designed for the cold and having the huge advantage of being on the defending side, compared to attacking in winter cold."},"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Basic","isInPermanentPool":true,"soundEnterPlay":{"ObjectName":"SoundWave'The_Hammer'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/The_Hammer.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/t_winter_warfare2.t_winter_warfare2","SubPathString":""},"artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/WINTER_WARFARE.WINTER_WARFARE","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":337.0},"historyPhotoSource":"Russian International News Agency","historyPhotoIdentificationCode":"4406","historyPhotoAuthor":"Victor Kinelovskiy","historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_event_winter_war_photo","SourceString":"Surrendered German troops near Moscow, Russia, December 1941.","LocalizedString":"Surrendered German troops near Moscow, Russia, December 1941."},"OnPlayedFromHandVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_Order_WinterAttack.BP_Order_WinterAttack_C","SubPathString":""},"isDirectDamage":true},"variable