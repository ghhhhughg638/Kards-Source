{"format":"kards-original-reference","version":1,"id":"f6829f9ac89dfb1f","name":"card_unit_panzer_iii_g_desert","package":"/Game/Blueprints/Cards/Germany/ToW/units/card_unit_panzer_iii_g_desert","parent":"UBaseCardObject","card":{"title":"PANZER III-G","text":"Pincer: Cannot be pinned.","flavorText":"The Panzer III-G was one of many versions in the Panzer III medium tank series. Similar to the previous models of the G series it had a main armament of a 3.7 cm KwK 36 gun, although later productions had a 5 cm KwK 38 L/42 gun, and for secondary armament it had 2–3 x 7.92 mm Maschinengewehr 34. It was very similar to the F series, which was the first mass produced model, except the gun mantlet had extra armor. The Panzer III-G had a crew of 5 (commander, gunner, loader, driver, radio operator/bow machine-gunner) and 594 units of this model were produced.","faction":"Germany","type":"tank","rarity":"Uncommon","cost":3,"operationCost":2,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_panzer_iii_g_desert","title":{"Namespace":"card_germany","Key":"card_unit_panzer_iii_g_desert_title","SourceString":"PANZER III-G","LocalizedString":"PANZER III-G"},"Type":"ETypeEnum::tank","attack":3,"defense":4,"range":1,"faction":"EFactionEnum::Germany","kredits":3,"Text":{"Namespace":"card_germany","Key":"card_unit_panzer_iii_g_desert_text","SourceString":"Pincer: Cannot be pinned.","LocalizedString":"Pincer: Cannot be pinned."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_panzer_iii_g_desert_history","SourceString":"The Panzer III-G was one of many versions in the Panzer III medium tank series. Similar to the previous models of the G series it had a main armament of a 3.7 cm KwK 36 gun, although later productions had a 5 cm KwK 38 L/42 gun, and for secondary armament it had 2–3 x 7.92 mm Maschinengewehr 34. It was very similar to the F series, which was the first mass produced model, except the gun mantlet had extra armor. The Panzer III-G had a crew of 5 (commander, gunner, loader, driver, radio operator/bow machine-gunner) and 594 units of this model were produced.","LocalizedString":"The Panzer III-G was one of many versions in the Panzer III medium tank series. Similar to the previous models of the G series it had a main armament of a 3.7 cm KwK 36 gun, although later productions had a 5 cm KwK 38 L/42 gun, and for secondary armament it had 2–3 x 7.92 mm Maschinengewehr 34. It was very similar to the F series, which was the first mass produced model, except the gun mantlet had extra armor. The Panzer III-G had a crew of 5 (commander, gunner, loader, driver, radio operator/bow machine-gunner) and 594 units of this model were produced."},"operationCost":2,"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Campaign2020","isReserved":true,"showBoostIcon":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Pin","EHelpBubbleTypes::Pincer"],"hasBlitz":true,"hasPincer":true,"soundEnterPlay":{"ObjectName":"SoundWave'Tank_Medium_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Medium_Move_Fx.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Tank_Medium_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Medium_Move_Fx.0"},"soundAttack":{"ObjectName":"SoundWave'Medium_Tank_Attack_Straight'","ObjectPath":"kards/Content/Assets/Audio/Units/Medium_Tank_Attack_Straight.0"},"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Armor_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Armor_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/t_panzer_iii_afrika_toto.t_panzer_iii_afrika_toto","SubPathString":""},"artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/PANZER_III-G_01.PANZER_III-G_01","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":311.0},"historyPhotoSource":"pinterest","historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_panzer_iii_g_des