{"format":"kards-original-reference","version":1,"id":"8207f2147ae9cf72","name":"card_unit_blue_and_gray","package":"/Game/Blueprints/Cards/USA/CovertOp/units/card_unit_blue_and_gray","parent":"UBaseCardObject","card":{"title":"BLUE AND GRAY","text":"When a friendly unit (including this) is destroyed, add an OUTRAGE to your hand.","flavorText":"The 29th Infantry Division, also known as the Blue and Gray Division, is a division of the US Army formed in 1917 during WWI. At the outbreak of WWII, the division was called into active service and in May 1942 it was sent to England where it began training for the invasion across the English Channel. In 1944 the division was finally put to action and it landed on Omaha Beach in Normandy on D-Day, June 6, where it suffered heavy losses. What followed was bitter fighting in the Normandy hedgerow country, and ultimately the division managed to capture the city of Saint-Lô. After a short rest they started pushing towards Germany, and would later participate in the Battle of Aachen, followed by Operation Grenade, a major offensive which involved the crossing of the Roer river between Roermond and Düren with the US Ninth Army. After the armistice in Europe in May 1945, the division was tasked with military occupation duties in the Bremen enclave, where it remained until the end of the year. In 1946 the Blue and Gray Division finally returned to the US where it was demobilized. ","faction":"USA","type":"infantry","rarity":"Rare","cost":6,"operationCost":2,"attack":6,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_blue_and_gray","title":{"Namespace":"card_usa","Key":"card_unit_blue_and_gray_title","SourceString":"BLUE AND GRAY","LocalizedString":"BLUE AND GRAY"},"Type":"ETypeEnum::infantry","attack":6,"defense":6,"range":1,"faction":"EFactionEnum::USA","kredits":6,"Text":{"Namespace":"card_usa","Key":"card_unit_blue_and_gray_text","SourceString":"When a friendly unit (including this) is destroyed, add an OUTRAGE to your hand.","LocalizedString":"When a friendly unit (including this) is destroyed, add an OUTRAGE to your hand."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_blue_and_gray_history","SourceString":"The 29th Infantry Division, also known as the Blue and Gray Division, is a division of the US Army formed in 1917 during WWI. At the outbreak of WWII, the division was called into active service and in May 1942 it was sent to England where it began training for the invasion across the English Channel. In 1944 the division was finally put to action and it landed on Omaha Beach in Normandy on D-Day, June 6, where it suffered heavy losses. What followed was bitter fighting in the Normandy hedgerow country, and ultimately the division managed to capture the city of Saint-Lô. After a short rest they started pushing towards Germany, and would later participate in the Battle of Aachen, followed by Operation Grenade, a major offensive which involved the crossing of the Roer river between Roermond and Düren with the US Ninth Army. After the armistice in Europe in May 1945, the division was tasked with military occupation duties in the Bremen enclave, where it remained until the end of the year. In 1946 the Blue and Gray Division finally returned to the US where it was demobilized. ","LocalizedString":"The 29th Infantry Division, also known as the Blue and Gray Division, is a division of the US Army formed in 1917 during WWI. At the outbreak of WWII, the division was called into active service and in May 1942 it was sent to England where it began training for the invasion across the English Channel. In 1944 the division was finally put to action and it landed on Omaha Beach in Normandy on D-Day, June 6, where it suffered heavy losses. What followed was bitter fighting in the Normandy hedgerow country, and ultimately the division managed to capture the city of Saint-Lô. After a short rest they started pushing towards Germany, and would later participate in the Battle of Aachen, followed by Operation Grenade, a major offensive which involved the crossing of the Roer river between Roermond and Düren with the US Ninth Army. After the armistice in Europe in May 1945, the division was tasked with military occupation duties in the Bremen enclave, where it remained until the end of the year. In 1946 the Blue and Gray Division finally returned to the US where it was demobilized. "},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::CurrentExpansion","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardDestroyed"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Trigger","EHelpBubbleTypes::Develop","EHelpBubbleTypes::Destruction"],"hasDestruction":true,"spawnCardName":"card_event_retribution","Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/CandidateArtwork/Summer_24/t_blue_and_gray.t_blue_and_gray","SubPathString":""},"artist":"Ken Smith","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/BLUE_AND_GRAY.BLUE_AND_GRAY","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":436.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_blue_and_gray_photo","SourceString":"Men of the  29th Infantry Division entering Saint-Lô, France. July 20th, 1944.","LocalizedString":"Men of the  29th Infantry Division entering Saint-Lô, France. July 20th, 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"isDirectDamage":true},"variables":[{"name":"tmpCard","type":"UBaseCardObject*","direction":"in"},{"name":"retFound","type":"bool","direction":"in"}],