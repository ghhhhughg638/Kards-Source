{"format":"kards-original-reference","version":1,"id":"d5ba350937763d4f","name":"card_unit_116th_infantry_regiment","package":"/Game/Blueprints/Cards/USA/OceaniaStorm/units/card_unit_116th_infantry_regiment","parent":"UBaseCardObject","card":{"title":"116th INFANTRY REGIMENT","text":"Deployment: Give a friendly infantry and all units with the same name in hand and deck +5+5.","flavorText":"The 116th Infantry Regiment, part of the Virginia National Guard, served with the 29th Infantry Division during WWII. Its lineage goes back to the colonial era, but the regiment became especially famous for its role in the Normandy landings. On D-Day, 6 June 1944, the 116th led the assault on the western sector of Omaha Beach. Companies A, E, F, and G landed in the first wave and faced intense German fire. Company A, drawn largely from Bedford, Virginia, was hit particularly hard, with most of its men injured or killed. Despite severe losses, survivors pushed inland, helped open routes off the beach, and continued the advance through Normandy. The regiment later fought in the Battle of Saint-Lô, the capture of Brest, and along the Siegfried Line. It then advanced across western Germany, crossed the Roer, and took part in operations against the Ruhr Pocket. By late April 1945, the 116th had reached the Elbe, where the 29th Infantry Division linked up with Soviet forces shortly before Germany’s surrender.","faction":"USA","type":"infantry","rarity":"Rare","cost":5,"operationCost":3,"attack":5,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_116th_infantry_regiment","title":{"Namespace":"card_usa","Key":"card_unit_116th_infantry_regiment_title","SourceString":"116th INFANTRY REGIMENT","LocalizedString":"116th INFANTRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":5,"defense":5,"range":1,"faction":"EFactionEnum::USA","kredits":5,"Text":{"Namespace":"card_usa","Key":"card_unit_116th_infantry_regiment_text","SourceString":"Deployment: Give a friendly infantry and all units with the same name in hand and deck +5+5.","LocalizedString":"Deployment: Give a friendly infantry and all units with the same name in hand and deck +5+5."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_116th_infantry_regiment_history","SourceString":"The 116th Infantry Regiment, part of the Virginia National Guard, served with the 29th Infantry Division during WWII. Its lineage goes back to the colonial era, but the regiment became especially famous for its role in the Normandy landings. On D-Day, 6 June 1944, the 116th led the assault on the western sector of Omaha Beach. Companies A, E, F, and G landed in the first wave and faced intense German fire. Company A, drawn largely from Bedford, Virginia, was hit particularly hard, with most of its men injured or killed. Despite severe losses, survivors pushed inland, helped open routes off the beach, and continued the advance through Normandy. The regiment later fought in the Battle of Saint-Lô, the capture of Brest, and along the Siegfried Line. It then advanced across western Germany, crossed the Roer, and took part in operations against the Ruhr Pocket. By late April 1945, the 116th had reached the Elbe, where the 29th Infantry Division linked up with Soviet forces shortly before Germany’s surrender.","LocalizedString":"The 116th Infantry Regiment, part of the Virginia National Guard, served with the 29th Infantry Division during WWII. Its lineage goes back to the colonial era, but the regiment became especially famous for its role in the Normandy landings. On D-Day, 6 June 1944, the 116th led the assault on the western sector of Omaha Beach. Companies A, E, F, and G landed in the first wave and faced intense German fire. Company A, drawn largely from Bedford, Virginia, was hit particularly hard, with most of its men injured or killed. Despite severe losses, survivors pushed inland, helped open routes off the beach, and continued the advance through Normandy. The regiment later fought in the Battle of Saint-Lô, the capture of Brest, and along the Siegfried Line. It then advanced across western Germany, crossed the Roer, and took part in operations against the Ruhr Pocket. By late April 1945, the 116th had reached the Elbe, where the 29th Infantry Division linked up with Soviet forces shortly before Germany’s surrender."},"operationCost":3,"rarity":"ERarityEnum::Rare","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardEnterPlay"],"hasDeployment":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/116th_INFANTRY_REGIMENT.116th_INFANTRY_REGIMENT","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_116th_infantry_regiment_photo","SourceString":"Men of the 116th Infantry Regiment approaching Omaha Beach in an LCVP landing craft, D-Day, 1944.","LocalizedString":"Men of the 116th Infantry Regiment approaching Omaha Beach in an LCVP landing craft, D-Day, 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"tempCard","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"CanPlayFromHand","owner":"card_unit_116th_infantry_regiment_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | F