{"format":"kards-original-reference","version":1,"id":"e573306b6537b8bc","name":"card_event_uss_fitch","package":"/Game/Blueprints/Cards/USA/NavalWarfare/events/card_event_uss_fitch","parent":"UBaseCardObject","card":{"title":"USS FITCH","text":"Give your units +1+1. Give them +2+2 instead if there is a Navy card on top of your deck.","flavorText":"The USS Fitch (DD-462/DMS-25) was a Gleaves-class destroyer of the U.S. Navy which served with distinction during World War II. She was commissioned in 1942, and first operated in the Atlantic where she escorted convoys and participated in the invasion of North Africa (Operation Torch) in November 1942. Fitch then supported the Normandy landings in June 1944 where she provided naval gunfire support at Omaha Beach on D-Day and aided in minesweeping. She later participated in the invasion of southern France (Operation Dragoon) in August 1944. Afterward, she was converted to a high-speed minesweeper and redesignated DMS-25 in 1945. Fitch joined the Pacific Fleet near the end of the war and was present in Tokyo Bay during the Japanese surrender on September 2, 1945.","faction":"USA","type":"order","rarity":"Rare","cost":3,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"GameplayTags":["subtype.navy"],"Name":"card_event_uss_fitch","title":{"Namespace":"card_usa","Key":"card_event_uss_fitch_title","SourceString":"USS FITCH","LocalizedString":"USS FITCH"},"Type":"ETypeEnum::order","faction":"EFactionEnum::USA","kredits":3,"Text":{"Namespace":"card_usa","Key":"card_event_uss_fitch_text","SourceString":"Give your units +1+1. Give them +2+2 instead if there is a Navy card on top of your deck.","LocalizedString":"Give your units +1+1. Give them +2+2 instead if there is a Navy card on top of your deck."},"flavorText":{"Namespace":"card_usa","Key":"card_event_uss_fitch_history","SourceString":"The USS Fitch (DD-462/DMS-25) was a Gleaves-class destroyer of the U.S. Navy which served with distinction during World War II. She was commissioned in 1942, and first operated in the Atlantic where she escorted convoys and participated in the invasion of North Africa (Operation Torch) in November 1942. Fitch then supported the Normandy landings in June 1944 where she provided naval gunfire support at Omaha Beach on D-Day and aided in minesweeping. She later participated in the invasion of southern France (Operation Dragoon) in August 1944. Afterward, she was converted to a high-speed minesweeper and redesignated DMS-25 in 1945. Fitch joined the Pacific Fleet near the end of the war and was present in Tokyo Bay during the Japanese surrender on September 2, 1945.","LocalizedString":"The USS Fitch (DD-462/DMS-25) was a Gleaves-class destroyer of the U.S. Navy which served with distinction during World War II. She was commissioned in 1942, and first operated in the Atlantic where she escorted convoys and participated in the invasion of North Africa (Operation Torch) in November 1942. Fitch then supported the Normandy landings in June 1944 where she provided naval gunfire support at Omaha Beach on D-Day and aided in minesweeping. She later participated in the invasion of southern France (Operation Dragoon) in August 1944. Afterward, she was converted to a high-speed minesweeper and redesignated DMS-25 in 1945. Fitch joined the Pacific Fleet near the end of the war and was present in Tokyo Bay during the Japanese surrender on September 2, 1945."},"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::NavalWarfare","soundEnterPlay":{"ObjectName":"SoundWave'Naval_Support_17'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Naval_Support_17.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/NavalWarfare/t_uss_fitch.t_uss_fitch","SubPathString":""},"artist":"Tom Freeman","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/USS_FITCH.USS_FITCH","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":259.0},"historyPhotoDescription":{"Namespace":"card_us