{"format":"kards-original-reference","version":1,"id":"d6d9d274faf24451","name":"card_unit_461st_rifles","package":"/Game/Blueprints/Cards/Soviet/Legions/units/card_unit_461st_rifles","parent":"UBaseCardObject","card":{"title":"461st RIFLES","text":"When this unit is dealt damage, your HQ gets equal amount of defense.","flavorText":"The 461st Rifle Regiment was a unit of the 142nd Rifle Division of the Red Army. The division was formed in 1939 and participated in the Winter War against Finland, but didn’t see much combat until 1944 during the Soviet Vyborg–Petrozavodsk Offensive. In 1945 the division participated in the Vistula-Oder Offensive against the Germans, and later in the East Pomeranian Offensive, where they managed to capture the town of Graudenz in northern Poland. The division finished the war on the Baltic coast where it was disbanded in the summer of 1945.","faction":"Soviet","type":"infantry","rarity":"Common","cost":5,"operationCost":1,"attack":5,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_461st_rifles","title":{"Namespace":"card_soviet","Key":"card_unit_461st_rifles_title","SourceString":"461st RIFLES","LocalizedString":"461st RIFLES"},"Type":"ETypeEnum::infantry","attack":5,"defense":3,"range":1,"faction":"EFactionEnum::Soviet","kredits":5,"Text":{"Namespace":"card_soviet","Key":"card_unit_461st_rifles_text","SourceString":"When this unit is dealt damage, your HQ gets equal amount of defense.","LocalizedString":"When this unit is dealt damage, your HQ gets equal amount of defense."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_461st_rifles_history","SourceString":"The 461st Rifle Regiment was a unit of the 142nd Rifle Division of the Red Army. The division was formed in 1939 and participated in the Winter War against Finland, but didn’t see much combat until 1944 during the Soviet Vyborg–Petrozavodsk Offensive. In 1945 the division participated in the Vistula-Oder Offensive against the Germans, and later in the East Pomeranian Offensive, where they managed to capture the town of Graudenz in northern Poland. The division finished the war on the Baltic coast where it was disbanded in the summer of 1945.","LocalizedString":"The 461st Rifle Regiment was a unit of the 142nd Rifle Division of the Red Army. The division was formed in 1939 and participated in the Winter War against Finland, but didn’t see much combat until 1944 during the Soviet Vyborg–Petrozavodsk Offensive. In 1945 the division participated in the Vistula-Oder Offensive against the Germans, and later in the East Pomeranian Offensive, where they managed to capture the town of Graudenz in northern Poland. The division finished the war on the Baltic coast where it was disbanded in the summer of 1945."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Legions","isReserved":true,"showBoostIcon":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardDealDamage"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Trigger"],"hasAmbush":true,"soundBlowUp":{"ObjectName":"SoundWave'explosion_large_01'","ObjectPath":"kards/Content/ExplosionSoundPack/ExplosionSounds/Wavs/explosion_large_01.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/Invasion/t_sov_order_or_infantry.t_sov_order_or_infantry","SubPathString":""},"artist":"Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/461st_RIFLES.461st_RIFLES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":388.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_461st_rifles_photo","SourceString":"Red Army tank and infantry during the Vyborg–Petrozavodsk offensive, 1944.","LocalizedString":"Red Army tank and infantry during the Vyborg–Petrozavodsk offensive, 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName