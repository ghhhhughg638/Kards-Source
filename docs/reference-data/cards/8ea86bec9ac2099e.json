{"format":"kards-original-reference","version":1,"id":"8ea86bec9ac2099e","name":"card_unit_24th_cavalry_regiment","package":"/Game/Blueprints/Cards/Japan/BrothersInArms/units/card_unit_24th_cavalry_regiment","parent":"UBaseCardObject","card":{"title":"24th CAVALRY REGIMENT","text":"Destruction: Draw a 24th CAVALRY REGIMENT from your deck.","flavorText":"The 24th Cavalry Regiment was a regiment of the 8th Division of the Imperial Japanese Army and played a significant role during the pre-war and during WWII. Initially, the 4th Brigade of the division participated in the Japanese invasion of Manchuria in 1931. The division arrived in Manchukuo in 1932 and served as a garrison force. It was later subordinated to the Kwantung Army in 1937. In 1939, the division underwent reorganization and became a triangular division. During the Pacific War, the 8th Division remained in Manchukuo until February 1944 when a detachment was sent to Poluwat due to worsening conditions in the Pacific. In July 1944, the division was reassigned to the Philippines and faced heavy losses during the Battle of Leyte and the Battle of Manila. The remnants of the division surrendered in September 1945. The division was officially dissolved in December 1947. Notably, Hiroo Onoda, a Japanese holdout, belonged to the 8th Division and did not surrender until 1974.","faction":"Japan","type":"infantry","rarity":"Common","cost":2,"operationCost":1,"attack":3,"defense":1},"defaults":{"UberGraphFrame":{},"Name":"card_unit_24th_cavalry_regiment","title":{"Namespace":"card_japan","Key":"card_unit_24th_cavalry_regiment_title","SourceString":"24th CAVALRY REGIMENT","LocalizedString":"24th CAVALRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":3,"defense":1,"range":1,"faction":"EFactionEnum::Japan","kredits":2,"Text":{"Namespace":"card_japan","Key":"card_unit_24th_cavalry_regiment_text","SourceString":"Destruction: Draw a 24th CAVALRY REGIMENT from your deck.","LocalizedString":"Destruction: Draw a 24th CAVALRY REGIMENT from your deck."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_24th_cavalry_regiment_history","SourceString":"The 24th Cavalry Regiment was a regiment of the 8th Division of the Imperial Japanese Army and played a significant role during the pre-war and during WWII. Initially, the 4th Brigade of the division participated in the Japanese invasion of Manchuria in 1931. The division arrived in Manchukuo in 1932 and served as a garrison force. It was later subordinated to the Kwantung Army in 1937. In 1939, the division underwent reorganization and became a triangular division. During the Pacific War, the 8th Division remained in Manchukuo until February 1944 when a detachment was sent to Poluwat due to worsening conditions in the Pacific. In July 1944, the division was reassigned to the Philippines and faced heavy losses during the Battle of Leyte and the Battle of Manila. The remnants of the division surrendered in September 1945. The division was officially dissolved in December 1947. Notably, Hiroo Onoda, a Japanese holdout, belonged to the 8th Division and did not surrender until 1974.","LocalizedString":"The 24th Cavalry Regiment was a regiment of the 8th Division of the Imperial Japanese Army and played a significant role during the pre-war and during WWII. Initially, the 4th Brigade of the division participated in the Japanese invasion of Manchuria in 1931. The division arrived in Manchukuo in 1932 and served as a garrison force. It was later subordinated to the Kwantung Army in 1937. In 1939, the division underwent reorganization and became a triangular division. During the Pacific War, the 8th Division remained in Manchukuo until February 1944 when a detachment was sent to Poluwat due to worsening conditions in the Pacific. In July 1944, the division was reassigned to the Philippines and faced heavy losses during the Battle of Leyte and the Battle of Manila. The remnants of the division surrendered in September 1945. The division was officially dissolved in December 1947. Notably, Hiroo Onoda, a Japanese holdout, belonged to the 8th Division and did not surrender until 1974."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::BrothersInArms","isReserved":true,"hasDestruction":true,"hasBlitz":true,"soundBlowUp":{"ObjectName":"SoundWave'explosion_small_01'","ObjectPath":"kards/Content/ExplosionSoundPack/ExplosionSounds/Wavs/explosion_small_01.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/Spring2023Candidates/t_japanese_infantry_volmi30.t_japanese_infantry_volmi30","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/24th_CAVALRY_REGIMENT.24th_CAVALRY_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":350.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_24th_cavalry_regiment_photo","SourceString":"Hiroo Onoda offers his military sword to Philippine President Ferdinand Marcos on the day of his surrender, 1974.","LocalizedString":"Hiroo Onoda offers his military sword to Philippine President Ferdinand Marcos on the day of his surrender, 1974."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"24thCards","type":"TArray<UBaseCardObject*>","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_24th_cavalry_regiment","owner":"card_unit_24th_cavalry_regiment_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Array_