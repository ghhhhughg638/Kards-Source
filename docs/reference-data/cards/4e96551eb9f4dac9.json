{"format":"kards-original-reference","version":1,"id":"4e96551eb9f4dac9","name":"card_unit_f4f_3_wildcat_cam1","package":"/Game/Blueprints/Cards/USA/specialCards/card_unit_f4f_3_wildcat_cam1","parent":"UBaseCardObject","card":{"title":"F4F-3 WILDCAT","text":"","flavorText":"The Grumman F4F Wildcat was an American carrier based fighter aircraft that was used during WWII by the US Navy and the Royal Navy. The aircraft was first used by the British in 1940 during the Battle of the Atlantic, and from 1941 to 1942 it was the only fighter available to the Marine Corps and the US Navy during the Pacific War. The aircraft was slower and less maneuverable than the Japanese Zero, but it had greater firepower and it was more durable and could withstand heavy battering without going down. A total of 7,885 Wildcats were manufactured, including quite a few variants, and most of them served on escort carriers.","faction":"USA","type":"fighter","rarity":"Common","cost":2,"operationCost":2,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_f4f_3_wildcat_cam1","title":{"Namespace":"card_usa","Key":"card_unit_f4f_3_wildcat_cam1_title","SourceString":"F4F-3 WILDCAT","LocalizedString":"F4F-3 WILDCAT"},"Type":"ETypeEnum::fighter","attack":2,"defense":3,"range":2,"faction":"EFactionEnum::USA","kredits":2,"flavorText":{"Namespace":"card_usa","Key":"card_unit_f4f_3_wildcat_cam1_text","SourceString":"The Grumman F4F Wildcat was an American carrier based fighter aircraft that was used during WWII by the US Navy and the Royal Navy. The aircraft was first used by the British in 1940 during the Battle of the Atlantic, and from 1941 to 1942 it was the only fighter available to the Marine Corps and the US Navy during the Pacific War. The aircraft was slower and less maneuverable than the Japanese Zero, but it had greater firepower and it was more durable and could withstand heavy battering without going down. A total of 7,885 Wildcats were manufactured, including quite a few variants, and most of them served on escort carriers.","LocalizedString":"The Grumman F4F Wildcat was an American carrier based fighter aircraft that was used during WWII by the US Navy and the Royal Navy. The aircraft was first used by the British in 1940 during the Battle of the Atlantic, and from 1941 to 1942 it was the only fighter available to the Marine Corps and the US Navy during the Pacific War. The aircraft was slower and less maneuverable than the Japanese Zero, but it had greater firepower and it was more durable and could withstand heavy battering without going down. A total of 7,885 Wildcats were manufactured, including quite a few variants, and most of them served on escort carriers."},"operationCost":2,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Special","campaignUpgradable":true,"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Small_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Small_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/t_wildcat_2.t_wildcat_2","SubPathString":""},"artist":"Roy Grinnell","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/F4F-3_WILDCAT.F4F-3_WILDCAT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":404.0},"historyPhotoSource":"United States Navy Naval History and Heritage Command","historyPhotoIdentificationCode":"NH 97493","historyPhotoDescription":{"Namespace":"card_usa","Key":"48FBA72447A8F69026D4C39A9F492CEA","SourceString":"Wildcat fighter in flight, 1942.","LocalizedString":"Wildcat fighter in flight, 1942."},"historyTypeDescription":{"Namespace":"card_usa","Key":"69392AFD4344A1D9176015B23FC8CFB9","SourceString":"Fighter Aircraft","LocalizedString":"Fighter Aircraft"},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftS'","ObjectPath":"kards/Content/Effects/Explosions/Small/Aircraft/P_ExplosionAircraftS.119"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Co