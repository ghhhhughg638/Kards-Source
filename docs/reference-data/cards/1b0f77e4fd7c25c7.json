{"format":"kards-original-reference","version":1,"id":"1b0f77e4fd7c25c7","name":"card_event_the_commonwealth","package":"/Game/Blueprints/Cards/Britain/Base/events/card_event_the_commonwealth","parent":"UBaseCardObject","card":{"title":"THE COMMONWEALTH","text":"Deal 20 damage to target HQ if your HQ has 30 or more defense. Draw 4 cards.","flavorText":"Forces from the countries of the British Commonwealth were involved in all major theaters of the war. There were self-governing Dominions of Australia, Canada, New Zealand and South Africa. Then there were those Dominions that were wholly or partly governed from London, including India as well as the West Indies and British colonies in Africa and the Far East. At the outbreak of war in 1939, India and the other colonial Dominions of the Empire had no choice and automatically joined in the war on the side of Britain. The Dominions made their own decision to enter the war on the British side. The Irish Free State decided on neutrality.","faction":"Britain","type":"order","rarity":"Unique","cost":12,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_the_commonwealth","title":{"Namespace":"card_britain","Key":"card_event_the_commonwealth_title","SourceString":"THE COMMONWEALTH","LocalizedString":"THE COMMONWEALTH"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Britain","kredits":12,"Text":{"Namespace":"card_britain","Key":"card_event_the_commonwealth_text","SourceString":"Deal 20 damage to target HQ if your HQ has 30 or more defense. Draw 4 cards.","LocalizedString":"Deal 20 damage to target HQ if your HQ has 30 or more defense. Draw 4 cards."},"flavorText":{"Namespace":"card_britain","Key":"card_event_the_commonwealth_history","SourceString":"Forces from the countries of the British Commonwealth were involved in all major theaters of the war. There were self-governing Dominions of Australia, Canada, New Zealand and South Africa. Then there were those Dominions that were wholly or partly governed from London, including India as well as the West Indies and British colonies in Africa and the Far East. At the outbreak of war in 1939, India and the other colonial Dominions of the Empire had no choice and automatically joined in the war on the side of Britain. The Dominions made their own decision to enter the war on the British side. The Irish Free State decided on neutrality.","LocalizedString":"Forces from the countries of the British Commonwealth were involved in all major theaters of the war. There were self-governing Dominions of Australia, Canada, New Zealand and South Africa. Then there were those Dominions that were wholly or partly governed from London, including India as well as the West Indies and British colonies in Africa and the Far East. At the outbreak of war in 1939, India and the other colonial Dominions of the Empire had no choice and automatically joined in the war on the side of Britain. The Dominions made their own decision to enter the war on the British side. The Irish Free State decided on neutrality."},"rarity":"ERarityEnum::Unique","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Basic","isReserved":true,"soundEnterPlay":{"ObjectName":"SoundWave'For_the_Queen'","ObjectPath":"kards/Content/Assets/Audio/Misc/For_the_Queen.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/Base/t_commonwealth_2.t_commonwealth_2","SubPathString":""},"artist":"Eddie Gerald / Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/THE_COMMONWEALTH.THE_COMMONWEALTH","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":403.0},"historyPhotoSource":"South African War Museum","historyPhotoDescription":{"Namespace":"card_britain","Key":"card_event_the_commonwealth_photo","SourceString":"South African forces at Moyale with captured Italian flag, 1941.","LocalizedString":"South African forces at Moyale with captured Italian flag, 1941."},"OnAttackVisualsSoft":{"AssetPathName":"/Gam