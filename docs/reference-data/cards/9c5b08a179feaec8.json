{"format":"kards-original-reference","version":1,"id":"9c5b08a179feaec8","name":"card_unit_3rd_yokosuka","package":"/Game/Blueprints/Cards/Japan/WorldAtWar/units/card_unit_3rd_yokosuka","parent":"UBaseCardObject","card":{"title":"3rd YOKOSUKA","text":"Has +1 attack for each adjacent Japanese unit.","flavorText":"The 3rd Yokosuka was a unit of the Special Naval Landing Forces (SNLF or Rikusentai) of the Imperial Japanese Navy during WWII. The SNLF paratroopers were lightly armed and their main objectives were to assault coastal areas, support amphibious landings or attack other strategic objectives such as airfields. The SNLF was composed of three battalion sized formations, the 1st, 2nd and 3rd Yokosuka, and although they were trained as paratrooper units they took little or no part in airborne operations throughout the war. The 1st Yokosuka carried out one airborne assault during the Battle of Manado, in the Netherlands East Indies in 1942. The 2nd Yokosuka never saw action as paratroopers, but instead they were part of an amphibious landing force in the Borneo Campaign from 1941. The 3rd Yokosuka participated in an airborne assault during the Battle of Timor and suffered heavy casualties. Later they took part in an unopposed landings on islands in the East Indies archipelago in 1942 and returned to Japan shortly after. Note that the SNLF paratroopers (Rikusentai) should not be confused with the Imperial Japanese Army paratroopers known as Teishin.","faction":"Japan","type":"infantry","rarity":"Rare","cost":1,"operationCost":0,"attack":1,"defense":1},"defaults":{"UberGraphFrame":{},"Name":"card_unit_3rd_yokosuka","title":{"Namespace":"card_japan","Key":"card_unit_3rd_yokosuka_title","SourceString":"3rd YOKOSUKA","LocalizedString":"3rd YOKOSUKA"},"Type":"ETypeEnum::infantry","attack":1,"defense":1,"range":1,"faction":"EFactionEnum::Japan","kredits":1,"Text":{"Namespace":"card_japan","Key":"card_unit_3rd_yokosuka_text","SourceString":"Has +1 attack for each adjacent Japanese unit.","LocalizedString":"Has +1 attack for each adjacent Japanese unit."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_3rd_yokosuka_history","SourceString":"The 3rd Yokosuka was a unit of the Special Naval Landing Forces (SNLF or Rikusentai) of the Imperial Japanese Navy during WWII. The SNLF paratroopers were lightly armed and their main objectives were to assault coastal areas, support amphibious landings or attack other strategic objectives such as airfields. The SNLF was composed of three battalion sized formations, the 1st, 2nd and 3rd Yokosuka, and although they were trained as paratrooper units they took little or no part in airborne operations throughout the war. The 1st Yokosuka carried out one airborne assault during the Battle of Manado, in the Netherlands East Indies in 1942. The 2nd Yokosuka never saw action as paratroopers, but instead they were part of an amphibious landing force in the Borneo Campaign from 1941. The 3rd Yokosuka participated in an airborne assault during the Battle of Timor and suffered heavy casualties. Later they took part in an unopposed landings on islands in the East Indies archipelago in 1942 and returned to Japan shortly after. Note that the SNLF paratroopers (Rikusentai) should not be confused with the Imperial Japanese Army paratroopers known as Teishin.","LocalizedString":"The 3rd Yokosuka was a unit of the Special Naval Landing Forces (SNLF or Rikusentai) of the Imperial Japanese Navy during WWII. The SNLF paratroopers were lightly armed and their main objectives were to assault coastal areas, support amphibious landings or attack other strategic objectives such as airfields. The SNLF was composed of three battalion sized formations, the 1st, 2nd and 3rd Yokosuka, and although they were trained as paratrooper units they took little or no part in airborne operations throughout the war. The 1st Yokosuka carried out one airborne assault during the Battle of Manado, in the Netherlands East Indies in 1942. The 2nd Yokosuka never saw action as paratroopers, but instead they were part of an amphibious landing force in the Borneo Campaign from 1941. The 3rd Yokosuka participated in an airborne assault during the Battle of Timor and suffered heavy casualties. Later they took part in an unopposed landings on islands in the East Indies archipelago in 1942 and returned to Japan shortly after. Note that the SNLF paratroopers (Rikusentai) should not be confused with the Imperial Japanese Army paratroopers known as Teishin."},"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::WorldAtWar","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardLocationMoved"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Blitz"],"hasBlitz":true,"soundEnterPlay":{"ObjectName":"SoundWave'Infantry_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Infantry_Move_FX.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Infantry_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Infantry_Move_FX.0"},"soundAttack":{"ObjectName":"SoundWave'AU_infantry_small_fire_02'","ObjectPath":"kards/Content/Assets/Audio/Projectiles_and_Impacts/Infantry/AU_infantry_small_fire_02.0"},"soundBlowUp":{"ObjectName":"SoundWave'explosion_small_01'","ObjectPath":"kards/Content/ExplosionSoundPack/ExplosionSounds/Wavs/explosion_small_01.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/CandidateArtwork/t_japanese_para_2.t_japanese_para_2","SubPathString":""},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/3rd_YOKOSUKA.3rd_YOKOSUKA","SubPathString":""},"historyPhotoSize":{"X":515.0,"Y":612.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_3rd_yokosuka_photo","SourceString":"A Yokosuka paratrooper posing in a field uniform. Date unknown.","LocalizedString":"A Yokosuka paratrooper posing in a field uniform. Date unknown."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfant