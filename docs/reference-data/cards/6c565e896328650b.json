{"format":"kards-original-reference","version":1,"id":"6c565e896328650b","name":"card_unit_73rd_infantry_regiment","package":"/Game/Blueprints/Cards/Japan/Homefront/units/card_unit_73rd_infantry_regiment","parent":"UBaseCardObject","card":{"title":"73rd INFANTRY REGIMENT","text":"Deployment: Trigger the destruction effects of all friendly units destroyed since the start of your last turn.","flavorText":"The 73rd Infantry Regiment was part of the 19th Division, an Imperial Japanese Army unit established in 1915 as a permanent garrison force in Korea. Headquartered at Ranam in North Hamgyong Province, the division initially faced challenges from disease and limited resources, delaying its full operational readiness until 1918. Known as the “Tiger Division”, it remained stationed in the region to guard the Empire’s northeastern frontier. In 1938, the division engaged Soviet forces in the Battle of Lake Khasan. This brief but intense clash near the Korean-Soviet border resulted in over 1,400 casualties for the division in less than a week. Following the battle, it returned to garrison duties in Korea. However, as Japan’s position in the Pacific deteriorated, the 19th Division was transferred to the Philippines in late 1944 under the Fourteenth Area Army. Deployed to defend Luzon’s mountainous interior against advancing US forces, the division was virtually annihilated by early 1945, ceasing to function as a coherent unit.","faction":"Japan","type":"infantry","rarity":"Rare","cost":6,"operationCost":1,"attack":6,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_73rd_infantry_regiment","title":{"Namespace":"card_japan","Key":"card_unit_73rd_infantry_regiment_title","SourceString":"73rd INFANTRY REGIMENT","LocalizedString":"73rd INFANTRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":6,"defense":5,"range":1,"faction":"EFactionEnum::Japan","kredits":6,"Text":{"Namespace":"card_japan","Key":"card_unit_73rd_infantry_regiment_text","SourceString":"Deployment: Trigger the destruction effects of all friendly units destroyed since the start of your last turn.","LocalizedString":"Deployment: Trigger the destruction effects of all friendly units destroyed since the start of your last turn."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_73rd_infantry_regiment_history","SourceString":"The 73rd Infantry Regiment was part of the 19th Division, an Imperial Japanese Army unit established in 1915 as a permanent garrison force in Korea. Headquartered at Ranam in North Hamgyong Province, the division initially faced challenges from disease and limited resources, delaying its full operational readiness until 1918. Known as the “Tiger Division”, it remained stationed in the region to guard the Empire’s northeastern frontier. In 1938, the division engaged Soviet forces in the Battle of Lake Khasan. This brief but intense clash near the Korean-Soviet border resulted in over 1,400 casualties for the division in less than a week. Following the battle, it returned to garrison duties in Korea. However, as Japan’s position in the Pacific deteriorated, the 19th Division was transferred to the Philippines in late 1944 under the Fourteenth Area Army. Deployed to defend Luzon’s mountainous interior against advancing US forces, the division was virtually annihilated by early 1945, ceasing to function as a coherent unit.","LocalizedString":"The 73rd Infantry Regiment was part of the 19th Division, an Imperial Japanese Army unit established in 1915 as a permanent garrison force in Korea. Headquartered at Ranam in North Hamgyong Province, the division initially faced challenges from disease and limited resources, delaying its full operational readiness until 1918. Known as the “Tiger Division”, it remained stationed in the region to guard the Empire’s northeastern frontier. In 1938, the division engaged Soviet forces in the Battle of Lake Khasan. This brief but intense clash near the Korean-Soviet border resulted in over 1,400 casualties for the division in less than a week. Following the battle, it returned to garrison duties in Korea. However, as Japan’s position in the Pacific deteriorated, the 19th Division was transferred to the Philippines in late 1944 under the Fourteenth Area Army. Deployed to defend Luzon’s mountainous interior against advancing US forces, the division was virtually annihilated by early 1945, ceasing to function as a coherent unit."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Homefront","hasDeployment":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/73rd_INFANTRY_REGIMENT.73rd_INFANTRY_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":347.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_73rd_infantry_regiment_photo","SourceString":"Japanese soldiers posing with a damaged Soviet machine gun during the Battle of Lake Khasan,1938.","LocalizedString":"Japanese soldiers posing with a damaged Soviet machine gun during the Battle of Lake Khasan,1938."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"isAttackBuff":true,"isDefenseBuff":true},"variables":[{"name":"unitsToTrigger","type":"TArray<UBaseCardObject*>","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_73rd_infantry_regiment","owner":"card_unit_73rd_infantry_regiment_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Loop_