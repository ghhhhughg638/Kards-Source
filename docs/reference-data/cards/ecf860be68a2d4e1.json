{"format":"kards-original-reference","version":1,"id":"ecf860be68a2d4e1","name":"card_event_distant_front","package":"/Game/Blueprints/Cards/Japan/WinterWar/events/card_event_distant_front","parent":"UBaseCardObject","card":{"title":"DISTANT FRONT","text":"Remove target unit with attack 3 or less from the battlefield. Return it at the start of your next turn.","flavorText":"The Japanese occupation of the Aleutian Islands off the coast of Alaska during WWII marked a strategic but challenging expansion into American territory. Initiated with the unopposed landing on Attu and Kiska islands in June 1942, the occupation aimed to divert American attention away from the Pacific theater and threaten North America. While the capture provided a foothold on American soil, the harsh environmental conditions, logistical difficulties, and lack of a clear strategic advantage made the occupation challenging. The Japanese garrisons faced supply issues, extreme weather, and isolation. Despite efforts to fortify the islands and the initial success in taking American territory, the Aleutian occupation became a drain on Japanese resources without impacting the overall war effort. Eventually, in July 1943 an evacuation of the Japanese forces on Kiska island was conducted stealthily under the cover of fog and darkness, deceiving the US forces into believing that the Japanese were still present. As a result, the Americans launched an amphibious assault to retake Kiska on August 15th, 1943, only to discover that the Japanese had already left the island.","faction":"Japan","type":"order","rarity":"Common","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_distant_front","title":{"Namespace":"card_japan","Key":"card_event_distant_front_title","SourceString":"DISTANT FRONT","LocalizedString":"DISTANT FRONT"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Japan","kredits":1,"Text":{"Namespace":"card_japan","Key":"card_event_distant_front_text","SourceString":"Remove target unit with attack 3 or less from the battlefield. Return it at the start of your next turn.","LocalizedString":"Remove target unit with attack 3 or less from the battlefield. Return it at the start of your next turn."},"flavorText":{"Namespace":"card_japan","Key":"card_event_distant_front_history","SourceString":"The Japanese occupation of the Aleutian Islands off the coast of Alaska during WWII marked a strategic but challenging expansion into American territory. Initiated with the unopposed landing on Attu and Kiska islands in June 1942, the occupation aimed to divert American attention away from the Pacific theater and threaten North America. While the capture provided a foothold on American soil, the harsh environmental conditions, logistical difficulties, and lack of a clear strategic advantage made the occupation challenging. The Japanese garrisons faced supply issues, extreme weather, and isolation. Despite efforts to fortify the islands and the initial success in taking American territory, the Aleutian occupation became a drain on Japanese resources without impacting the overall war effort. Eventually, in July 1943 an evacuation of the Japanese forces on Kiska island was conducted stealthily under the cover of fog and darkness, deceiving the US forces into believing that the Japanese were still present. As a result, the Americans launched an amphibious assault to retake Kiska on August 15th, 1943, only to discover that the Japanese had already left the island.","LocalizedString":"The Japanese occupation of the Aleutian Islands off the coast of Alaska during WWII marked a strategic but challenging expansion into American territory. Initiated with the unopposed landing on Attu and Kiska islands in June 1942, the occupation aimed to divert American attention away from the Pacific theater and threaten North America. While the capture provided a foothold on American soil, the harsh environmental conditions, logistical difficulties, and lack of a clear strategic advantage made the occupation challenging. The Japanese garrisons faced supply issues, extreme weather, and isolation. Despite efforts to fortify the islands and the initial success in taking American territory, the Aleutian occupation became a drain on Japanese resources without impacting the overall war effort. Eventually, in July 1943 an evacuation of the Japanese forces on Kiska island was conducted stealthily under the cover of fog and darkness, deceiving the US forces into believing that the Japanese were still present. As a result, the Americans launched an amphibious assault to retake Kiska on August 15th, 1943, only to discover that the Japanese had already left the island."},"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::WinterWar","isReserved":true,"usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Taiko_Hits_2'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Taiko_Hits_2.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/CandidateArtwork/Winter_war/t_distant_front.t_distant_front","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/DISTANT_FRONT.DISTANT_FRONT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":315.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_event_distant_front_photo","SourceString":"Japanese soldiers and a tank. Attu Island, Alaska, ca. 1942-43.","LocalizedString":"Japanese soldiers and a tank. Attu Island, Alaska, ca. 1942-43."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"isRemoval":true},"variables":[],"functions":[{"name":"CanPlayFromHand","owner":"card_event_distant_front_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},