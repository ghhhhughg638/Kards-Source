{"format":"kards-original-reference","version":1,"id":"c827b5f2a6e7836f","name":"card_unit_pzl_7","package":"/Game/Blueprints/Cards/Poland/units/card_unit_pzl_7","parent":"UBaseCardObject","card":{"title":"PZL P.7","text":"When an enemy unit moves into the frontline, retreat this unit.","flavorText":"The PZL P.7 was a Polish fighter aircraft that was first introduced in 1933 and approximately 150 aircraft were built between 1932-33. Despite being obsolete at the outbreak of WWII (most had been replaced by PZL P.11 in 1935) the aircraft was used in Poland's defense against the invading German forces. Although the PZL P.7 had better maneuverability than many of its counterparts, it lacked speed and armament and stood little chance in combat. Most PZL P.7 fighters owned by the Polish Air Force were destroyed in 1939, both in combat and on the ground. A few aircraft were withdrawn to Romania or captured by the German or Soviet forces and used for training purposes.","faction":"Poland","type":"fighter","rarity":"Common","cost":1,"operationCost":1,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_pzl_7","title":{"Namespace":"card_poland","Key":"card_unit_pzl_7_title","SourceString":"PZL P.7","LocalizedString":"PZL P.7"},"Type":"ETypeEnum::fighter","attack":1,"defense":2,"range":2,"faction":"EFactionEnum::Poland","kredits":1,"Text":{"Namespace":"card_poland","Key":"card_unit_pzl_7_text","SourceString":"When an enemy unit moves into the frontline, retreat this unit.","LocalizedString":"When an enemy unit moves into the frontline, retreat this unit."},"flavorText":{"Namespace":"card_poland","Key":"card_unit_pzl_7_history","SourceString":"The PZL P.7 was a Polish fighter aircraft that was first introduced in 1933 and approximately 150 aircraft were built between 1932-33. Despite being obsolete at the outbreak of WWII (most had been replaced by PZL P.11 in 1935) the aircraft was used in Poland's defense against the invading German forces. Although the PZL P.7 had better maneuverability than many of its counterparts, it lacked speed and armament and stood little chance in combat. Most PZL P.7 fighters owned by the Polish Air Force were destroyed in 1939, both in combat and on the ground. A few aircraft were withdrawn to Romania or captured by the German or Soviet forces and used for training purposes.","LocalizedString":"The PZL P.7 was a Polish fighter aircraft that was first introduced in 1933 and approximately 150 aircraft were built between 1932-33. Despite being obsolete at the outbreak of WWII (most had been replaced by PZL P.11 in 1935) the aircraft was used in Poland's defense against the invading German forces. Although the PZL P.7 had better maneuverability than many of its counterparts, it lacked speed and armament and stood little chance in combat. Most PZL P.7 fighters owned by the Polish Air Force were destroyed in 1939, both in combat and on the ground. A few aircraft were withdrawn to Romania or captured by the German or Soviet forces and used for training purposes."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Legions","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardMoveToFrontline"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Blitz","EHelpBubbleTypes::Retreat"],"hasBlitz":true,"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Small_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Small_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Poland/t_pzl_7.t_pzl_7","SubPathString":""},"artist":"Jarosław Wróbel","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/PZL_P_7.PZL_P_7","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":288.0},"historyPhotoDescription":{"Namespace":"card_poland","Key":"card_unit_pzl_7_photo","SourceString":"PZL P.7, date unknown.","LocalizedString":"PZL P.7, date unknown."},"blowUpExplosion":{"ObjectName":"ParticleSys