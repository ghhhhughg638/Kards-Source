{"format":"kards-original-reference","version":1,"id":"48327d8c03c95f96","name":"card_unit_yak_9_pl","package":"/Game/Blueprints/Cards/Poland/units/card_unit_yak_9_pl","parent":"UBaseCardObject","card":{"title":"YAK 9 PL","text":"Your Exile units have Blitz.","flavorText":"The Yakovlev Yak-9 was a Soviet fighter aircraft that played a significant role in the Soviet Air Force during WWII. It was a development of the earlier Yak-7 and Yak-1 fighters, incorporating improvements and modifications based on combat experience.The Yak-9 was designed by Alexander Yakovlev and entered service with the Soviet Air Force in 1942. It was a versatile aircraft that saw action in various roles, including air superiority, ground attack, and escort missions. The aircraft was known for its agility, robustness, and adaptability. While the majority of the Polish Air Force was disbanded or incorporated into foreign air forces after the German and Soviet occupations of Poland, a significant number of Polish pilots managed to escape and join Allied air forces. Some of these Polish pilots, while serving in Soviet-controlled units, flew Soviet aircraft, including the Yak-9. The most notable example is the Air Force of the Polish Army which was created alongside the Polish People's Army, a subordinate to the Red Army. It was the primary Polish air force formation within the Polish Armed Forces in the East during WWII.","faction":"Poland","type":"fighter","rarity":"Rare","cost":4,"operationCost":2,"attack":3,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_yak_9_pl","title":{"Namespace":"card_poland","Key":"card_unit_yak_9_pl_title","SourceString":"YAK 9 PL","LocalizedString":"YAK 9 PL"},"Type":"ETypeEnum::fighter","attack":3,"defense":5,"range":2,"faction":"EFactionEnum::Poland","kredits":4,"Text":{"Namespace":"card_poland","Key":"card_unit_yak_9_pl_text","SourceString":"Your Exile units have Blitz.","LocalizedString":"Your Exile units have Blitz."},"flavorText":{"Namespace":"card_poland","Key":"card_unit_yak_9_pl_history","SourceString":"The Yakovlev Yak-9 was a Soviet fighter aircraft that played a significant role in the Soviet Air Force during WWII. It was a development of the earlier Yak-7 and Yak-1 fighters, incorporating improvements and modifications based on combat experience.The Yak-9 was designed by Alexander Yakovlev and entered service with the Soviet Air Force in 1942. It was a versatile aircraft that saw action in various roles, including air superiority, ground attack, and escort missions. The aircraft was known for its agility, robustness, and adaptability. While the majority of the Polish Air Force was disbanded or incorporated into foreign air forces after the German and Soviet occupations of Poland, a significant number of Polish pilots managed to escape and join Allied air forces. Some of these Polish pilots, while serving in Soviet-controlled units, flew Soviet aircraft, including the Yak-9. The most notable example is the Air Force of the Polish Army which was created alongside the Polish People's Army, a subordinate to the Red Army. It was the primary Polish air force formation within the Polish Armed Forces in the East during WWII.","LocalizedString":"The Yakovlev Yak-9 was a Soviet fighter aircraft that played a significant role in the Soviet Air Force during WWII. It was a development of the earlier Yak-7 and Yak-1 fighters, incorporating improvements and modifications based on combat experience.The Yak-9 was designed by Alexander Yakovlev and entered service with the Soviet Air Force in 1942. It was a versatile aircraft that saw action in various roles, including air superiority, ground attack, and escort missions. The aircraft was known for its agility, robustness, and adaptability. While the majority of the Polish Air Force was disbanded or incorporated into foreign air forces after the German and Soviet occupations of Poland, a significant number of Polish pilots managed to escape and join Allied air forces. Some of these Polish pilots, while serving in Soviet-controlled units, flew Soviet aircraft, including the Yak-9. The most notable example is the Air Force of the Polish Army which was created alongside the Polish People's Army, a subordinate to the Red Army. It was the primary Polish air force formation within the Polish Armed Forces in the East during WWII."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::BrothersInArms","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardEnterPlay"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Exile","EHelpBubbleTypes::Blitz"],"hasBlitz":true,"exileNation":"EFactionEnum::Soviet","soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Poland/Spring2023Candidates/t_jak_9_pl.t_jak_9_pl","SubPathString":""},"ImageAnchor":"EImageAnchor::Bot","artist":"Jarosław Wróbel","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/YAK-9_PL.YAK-9_PL","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":379.0},"historyPhotoDescription":{"Namespace":"card_poland","Key":"card_unit_yak_9_pl_photo","SourceString":"YAK-9 aircraft of the Air Force of the Polish Army. Date unknown.","LocalizedString":"YAK-9 aircraft of the Air Force of the Polish Army. Date unknown."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftL'","ObjectPath":"kards/Content/Effects/Explosions/Large/Aircraft/P_ExplosionAircraftL.201"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackFighter.BP_AttackFighter_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_yak_9_pl","owner":"card_unit_