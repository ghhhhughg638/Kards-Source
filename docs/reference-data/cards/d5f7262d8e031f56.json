{"format":"kards-original-reference","version":1,"id":"d5f7262d8e031f56","name":"card_unit_m4_sherman","package":"/Game/Blueprints/Cards/USA/Base/units/card_unit_m4_sherman","parent":"UBaseCardObject","card":{"title":"M4 SHERMAN","text":"Deployment: If you have a US unit in the frontline, draw 2 cards.","flavorText":"The M4 Sherman was a medium tank used by the American and Allied forces during WWII. It had a crew of 5 and was mounted with a 75 or 76 mm gun, or a 105 mm howitzer, a.50 caliber Browning machine gun and 2—.30 caliber Browning machine guns. It was considered very reliable, relatively cheap to produce and was available in great numbers.The M4 Sherman did well against German lighter tanks and Italian tanks, but later in the war it lacked in firepower and armor compared to the heavier German tanks. To compensate for this some M4 variants were fitted with bigger guns, such as 76 mm gun M1, or as the British Sherman Firefly that was refitted with an Ordnance QF 17-pounder.","faction":"USA","type":"tank","rarity":"Common","cost":4,"operationCost":2,"attack":4,"defense":4},"defaults":{"UberGraphFrame":{},"GameplayTags":["subtype.sherman"],"Name":"card_unit_m4_sherman","title":{"Namespace":"card_usa","Key":"card_unit_m4_sherman_title","SourceString":"M4 SHERMAN","LocalizedString":"M4 SHERMAN"},"Type":"ETypeEnum::tank","attack":4,"defense":4,"range":1,"faction":"EFactionEnum::USA","kredits":4,"Text":{"Namespace":"card_usa","Key":"card_unit_m4_sherman_text","SourceString":"Deployment: If you have a US unit in the frontline, draw 2 cards.","LocalizedString":"Deployment: If you have a US unit in the frontline, draw 2 cards."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_m4_sherman_history","SourceString":"The M4 Sherman was a medium tank used by the American and Allied forces during WWII. It had a crew of 5 and was mounted with a 75 or 76 mm gun, or a 105 mm howitzer, a.50 caliber Browning machine gun and 2—.30 caliber Browning machine guns. It was considered very reliable, relatively cheap to produce and was available in great numbers.The M4 Sherman did well against German lighter tanks and Italian tanks, but later in the war it lacked in firepower and armor compared to the heavier German tanks. To compensate for this some M4 variants were fitted with bigger guns, such as 76 mm gun M1, or as the British Sherman Firefly that was refitted with an Ordnance QF 17-pounder.","LocalizedString":"The M4 Sherman was a medium tank used by the American and Allied forces during WWII. It had a crew of 5 and was mounted with a 75 or 76 mm gun, or a 105 mm howitzer, a.50 caliber Browning machine gun and 2—.30 caliber Browning machine guns. It was considered very reliable, relatively cheap to produce and was available in great numbers.The M4 Sherman did well against German lighter tanks and Italian tanks, but later in the war it lacked in firepower and armor compared to the heavier German tanks. To compensate for this some M4 variants were fitted with bigger guns, such as 76 mm gun M1, or as the British Sherman Firefly that was refitted with an Ordnance QF 17-pounder."},"operationCost":2,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Basic","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"draftBaseWeight":0.8,"hasDeployment":true,"soundEnterPlay":{"ObjectName":"SoundWave'Tank_Medium_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Medium_Move_Fx.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Tank_Medium_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Medium_Move_Fx.0"},"soundAttack":{"ObjectName":"SoundWave'Medium_Tank_Attack_Straight'","ObjectPath":"kards/Content/Assets/Audio/Units/Medium_Tank_Attack_Straight.0"},"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Armor_Large_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Armor_Large_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/t_sherman_jumbo.t_sherman_jumbo","SubPathSt