{"format":"kards-original-reference","version":1,"id":"5aaaefe862c30366","name":"card_event_lotta_svard","package":"/Game/Blueprints/Cards/Finland/events/card_event_lotta_svard","parent":"UBaseCardObject","card":{"title":"LOTTA SVÄRD","text":"Your units get +1 defense and -1 operation cost.","flavorText":"Lotta Svärd was a Finnish voluntary auxiliary paramilitary organization for women, formed originally in 1918 in support of the White Guard during the Finnish Civil War. During WWII, it was mobilized in order to replace men conscripted into the army. The women of Lotta Svärd mainly served in hospitals, at air raid warning positions, and other auxiliary tasks in close cooperation with the army. The women were officially unarmed except for a voluntary anti-aircraft battery in Helsinki in the summer of 1944. This unit was also issued rifles for self-protection, making them the only armed female military unit in the Finnish Defence Forces history. The Lotta Svärd organization was disbanded after WWII.","faction":"Finland","type":"order","rarity":"Uncommon","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_lotta_svard","title":{"Namespace":"card_finland","Key":"card_event_lotta_svard_title","SourceString":"LOTTA SVÄRD","LocalizedString":"LOTTA SVÄRD"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Finland","kredits":2,"Text":{"Namespace":"card_finland","Key":"card_event_lotta_svard_text","SourceString":"Your units get +1 defense and -1 operation cost.","LocalizedString":"Your units get +1 defense and -1 operation cost."},"flavorText":{"Namespace":"card_finland","Key":"card_event_lotta_svard_history","SourceString":"Lotta Svärd was a Finnish voluntary auxiliary paramilitary organization for women, formed originally in 1918 in support of the White Guard during the Finnish Civil War. During WWII, it was mobilized in order to replace men conscripted into the army. The women of Lotta Svärd mainly served in hospitals, at air raid warning positions, and other auxiliary tasks in close cooperation with the army. The women were officially unarmed except for a voluntary anti-aircraft battery in Helsinki in the summer of 1944. This unit was also issued rifles for self-protection, making them the only armed female military unit in the Finnish Defence Forces history. The Lotta Svärd organization was disbanded after WWII.","LocalizedString":"Lotta Svärd was a Finnish voluntary auxiliary paramilitary organization for women, formed originally in 1918 in support of the White Guard during the Finnish Civil War. During WWII, it was mobilized in order to replace men conscripted into the army. The women of Lotta Svärd mainly served in hospitals, at air raid warning positions, and other auxiliary tasks in close cooperation with the army. The women were officially unarmed except for a voluntary anti-aircraft battery in Helsinki in the summer of 1944. This unit was also issued rifles for self-protection, making them the only armed female military unit in the Finnish Defence Forces history. The Lotta Svärd organization was disbanded after WWII."},"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::WinterWar","isInPermanentPool":true,"soundEnterPlay":{"ObjectName":"SoundCue'War_UI_Drum_Movement_Field_Snares_5_Cue'","ObjectPath":"kards/Content/War_UI/Cues/Drum_Movements/War_UI_Drum_Movement_Field_Snares_5_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Finland/06_Winter_War/T_lotta_svard.T_lotta_svard","SubPathString":""},"artist":"Finnish WW2 booklet","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/LOTTA_SVARD.LOTTA_SVARD","SubPathString":""},"historyPhotoSize":{"X":389.0,"Y":512.0},"historyPhotoDescription":{"Namespace":"card_finland","Key":"card_event_lotta_svard_photo","SourceString":"Lotta Svärd members at an air raid warning position. Date unknown.","LocalizedString":"Lotta Svärd members at an air raid warning position. Date unknown."}},"variables":[],"f