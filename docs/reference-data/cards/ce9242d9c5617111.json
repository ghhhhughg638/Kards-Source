{"format":"kards-original-reference","version":1,"id":"ce9242d9c5617111","name":"card_unit_infantry_regiment_61","package":"/Game/Blueprints/Cards/Finland/units/card_unit_infantry_regiment_61","parent":"UBaseCardObject","card":{"title":"INFANTRY REGIMENT 61","text":"Salvaged units you deploy get +3+3.","flavorText":"The 61st Infantry Regiment was a unit of the 17th Division of the Finnish Army during the Continuation War (1941-1944). The 17th Division operated primarily in the Karelian Isthmus and along the Svir River and engaged in numerous defensive and offensive operations throughout the war, including the Battles of Svir and Jandeba in 1941 and the Battle of Tienhaara in June 1944, where it successfully defended against the Soviet offensive. The men and officers of the regiment didn’t speak Finnish as this regiment recruited exclusively among Swedish-speaking Finns. This formation also included no small number of Swedish volunteers. The 61st Infantry Regiment went down in Finnish history books as the Sextiettan, meaning “61” in Swedish.","faction":"Finland","type":"infantry","rarity":"Rare","cost":4,"operationCost":1,"attack":4,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_infantry_regiment_61","title":{"Namespace":"card_finland","Key":"card_unit_infantry_regiment_61_title","SourceString":"INFANTRY REGIMENT 61","LocalizedString":"INFANTRY REGIMENT 61"},"Type":"ETypeEnum::infantry","attack":4,"defense":6,"range":1,"faction":"EFactionEnum::Finland","kredits":4,"Text":{"Namespace":"card_finland","Key":"card_unit_infantry_regiment_61_text","SourceString":"Salvaged units you deploy get +3+3.","LocalizedString":"Salvaged units you deploy get +3+3."},"flavorText":{"Namespace":"card_finland","Key":"card_unit_infantry_regiment_61_history","SourceString":"The 61st Infantry Regiment was a unit of the 17th Division of the Finnish Army during the Continuation War (1941-1944). The 17th Division operated primarily in the Karelian Isthmus and along the Svir River and engaged in numerous defensive and offensive operations throughout the war, including the Battles of Svir and Jandeba in 1941 and the Battle of Tienhaara in June 1944, where it successfully defended against the Soviet offensive. The men and officers of the regiment didn’t speak Finnish as this regiment recruited exclusively among Swedish-speaking Finns. This formation also included no small number of Swedish volunteers. The 61st Infantry Regiment went down in Finnish history books as the Sextiettan, meaning “61” in Swedish.","LocalizedString":"The 61st Infantry Regiment was a unit of the 17th Division of the Finnish Army during the Continuation War (1941-1944). The 17th Division operated primarily in the Karelian Isthmus and along the Svir River and engaged in numerous defensive and offensive operations throughout the war, including the Battles of Svir and Jandeba in 1941 and the Battle of Tienhaara in June 1944, where it successfully defended against the Soviet offensive. The men and officers of the regiment didn’t speak Finnish as this regiment recruited exclusively among Swedish-speaking Finns. This formation also included no small number of Swedish volunteers. The 61st Infantry Regiment went down in Finnish history books as the Sextiettan, meaning “61” in Swedish."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::WinterWar","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnBeforeOtherCardPlayedFromHand"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Trigger"],"hasSalvage":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Finland/t_infantry_regiment_61.t_infantry_regiment_61","SubPathString":""},"artist":"Ken Smith","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/INFANTRY_REGIMENT_61.INFANTRY_REGIMENT_61","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":401.0},"historyPhotoDescription":{"Namespace":"card_finland","Key":"card_unit_infantry_regiment_61_photo","SourceString":"Men of the 61st Infantry Regiment in a trench near the village of Shemenski, 1942.","LocalizedString":"Men of the 61st Infantry Regiment in a trench near the village of Shemenski, 1942."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"tempCard","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_infantry_regiment_61","owner":"card_unit_infantry_regiment_61_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"CallFunc_IsValid_ReturnValue","type":"bool","direction":"in"},{"name":"CallFunc_IsLocatedOnBoard_isIt","type":"bool","direction":"in"},{"name":"K2Node_Event_cardPlayed","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_ChangeAttack_qqq","type":"bool","direction":"in"},{"name":"CallFunc_ChangeDefense_qqq","type":"bool","direction":"in"},{"name":"CallFunc_EqualEqual_ByteByte_ReturnValue","type":"bool","direction":"in"},{"name":"CallFunc_BooleanAND_ReturnValue","type":"bool","direction":"in"}],"body":[{"op":"ComputedJump","at":0,"value":{"op":"Variable","name":"EntryPoint","type":"int32","scope":"local","sourceOp":"LocalVariable"}},{"op":"LetBool","at":10,"target":{"op":"Variable","name":"CallFunc_IsValid_ReturnValue","type":"bool","scope":"local","sourceOp":"LocalVariable"},"value":{"op":"CallMath","name":"IsValid","signature":"KismetSystemLibrary.IsValid","args":[{"op":"Variable","name":"tempCard","type":"UBaseCardObject*","scope":"member","sourceOp":"InstanceVar