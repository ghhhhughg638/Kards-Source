{"format":"kards-original-reference","version":1,"id":"4a5af07eafd19256","name":"card_event_timely_supplies","package":"/Game/Blueprints/Cards/Britain/Legions/events/card_event_timely_supplies","parent":"UBaseCardObject","card":{"title":"TIMELY SUPPLIES","text":"Draw a card. It costs 2 less this turn.","flavorText":"In 1940 the US was still a neutral country but nevertheless they started to provide the Allies with significant supplies, most of them going to the United Kingdom. At the time the majority of Americans opposed direct participation in the war, and although President Roosevelt was willing to help the Allied cause, he could simply not provide them with supplies as a gift. Instead he initiated the Lend-Lease program, which meant that the US would “lend” supplies to the United Kingdom and other Allies, but would not insist on being paid back immediately. Throughout the war the US would provide over 30 countries with aid through the Lend-Lease program, in the approximate amount of 50 billion dollars.","faction":"Britain","type":"order","rarity":"Common","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_timely_supplies","title":{"Namespace":"card_britain","Key":"card_event_timely_supplies_title","SourceString":"TIMELY SUPPLIES","LocalizedString":"TIMELY SUPPLIES"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Britain","kredits":2,"Text":{"Namespace":"card_britain","Key":"card_event_timely_supplies_text","SourceString":"Draw a card. It costs 2 less this turn.","LocalizedString":"Draw a card. It costs 2 less this turn."},"flavorText":{"Namespace":"card_britain","Key":"card_event_timely_supplies_history","SourceString":"In 1940 the US was still a neutral country but nevertheless they started to provide the Allies with significant supplies, most of them going to the United Kingdom. At the time the majority of Americans opposed direct participation in the war, and although President Roosevelt was willing to help the Allied cause, he could simply not provide them with supplies as a gift. Instead he initiated the Lend-Lease program, which meant that the US would “lend” supplies to the United Kingdom and other Allies, but would not insist on being paid back immediately. Throughout the war the US would provide over 30 countries with aid through the Lend-Lease program, in the approximate amount of 50 billion dollars.","LocalizedString":"In 1940 the US was still a neutral country but nevertheless they started to provide the Allies with significant supplies, most of them going to the United Kingdom. At the time the majority of Americans opposed direct participation in the war, and although President Roosevelt was willing to help the Allied cause, he could simply not provide them with supplies as a gift. Instead he initiated the Lend-Lease program, which meant that the US would “lend” supplies to the United Kingdom and other Allies, but would not insist on being paid back immediately. Throughout the war the US would provide over 30 countries with aid through the Lend-Lease program, in the approximate amount of 50 billion dollars."},"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Legions","isReserved":true,"usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"soundEnterPlay":{"ObjectName":"SoundWave'Naval_Support_17'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Naval_Support_17.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/Invasion/t_convoy_order4.t_convoy_order4","SubPathString":""},"artist":"Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/TIMELY_SUPPLIES.TIMELY_SUPPLIES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":405.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_event_timely_supplies_photo","SourceString":"President Roosevelt signs the Lend-Lease bill, March, 1941.","LocalizedString":"President Roosevelt signs the Lend-Lease bill, March, 1941."},"OnAttackVi