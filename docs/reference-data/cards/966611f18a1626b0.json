{"format":"kards-original-reference","version":1,"id":"966611f18a1626b0","name":"card_event_lost_convoy","package":"/Game/Blueprints/Cards/Germany/Legions/events/card_event_lost_convoy","parent":"UBaseCardObject","card":{"title":"LOST CONVOY","text":"When the enemy deploys a unit, give it -2 attack.","flavorText":"Convoy PQ-17 was an Allied convoy that was located through German signals intelligence and cryptanalysis, shadowed for days and continuously attacked by the German Kriegsmarine and Luftwaffe. The convoy was the first large joint Anglo-American naval operation under British command and the ships were sailing from Hvalfjord in Iceland to Arkhangelsk in the Soviet Union with vital supplies for the war effort on the Eastern Front. At first PQ 17 had a strong escort of warships, but when the British Admiralty got word that the Bismarck-class battleship Tirpitz was on its way to intercept the convoy, the order was given to scatter since they didn’t want to risk losing their warships. They believed that scattering the convoy would make it harder for the Germans to sink the ships, but what happened was the exact opposite. Contrary to what the British believed, the Tirpitz was not heading towards the convoy, and the merchant ships became easy targets for the German submarines and aircraft which managed to sink 24 ships out of 35.","faction":"Germany","type":"gotcha","rarity":"Common","cost":0,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_lost_convoy","title":{"Namespace":"card_germany","Key":"card_event_lost_convoy_title","SourceString":"LOST CONVOY","LocalizedString":"LOST CONVOY"},"Type":"ETypeEnum::gotcha","faction":"EFactionEnum::Germany","Text":{"Namespace":"card_germany","Key":"card_event_lost_convoy_text","SourceString":"When the enemy deploys a unit, give it -2 attack.","LocalizedString":"When the enemy deploys a unit, give it -2 attack."},"flavorText":{"Namespace":"card_germany","Key":"card_event_lost_convoy_history","SourceString":"Convoy PQ-17 was an Allied convoy that was located through German signals intelligence and cryptanalysis, shadowed for days and continuously attacked by the German Kriegsmarine and Luftwaffe. The convoy was the first large joint Anglo-American naval operation under British command and the ships were sailing from Hvalfjord in Iceland to Arkhangelsk in the Soviet Union with vital supplies for the war effort on the Eastern Front. At first PQ 17 had a strong escort of warships, but when the British Admiralty got word that the Bismarck-class battleship Tirpitz was on its way to intercept the convoy, the order was given to scatter since they didn’t want to risk losing their warships. They believed that scattering the convoy would make it harder for the Germans to sink the ships, but what happened was the exact opposite. Contrary to what the British believed, the Tirpitz was not heading towards the convoy, and the merchant ships became easy targets for the German submarines and aircraft which managed to sink 24 ships out of 35.","LocalizedString":"Convoy PQ-17 was an Allied convoy that was located through German signals intelligence and cryptanalysis, shadowed for days and continuously attacked by the German Kriegsmarine and Luftwaffe. The convoy was the first large joint Anglo-American naval operation under British command and the ships were sailing from Hvalfjord in Iceland to Arkhangelsk in the Soviet Union with vital supplies for the war effort on the Eastern Front. At first PQ 17 had a strong escort of warships, but when the British Admiralty got word that the Bismarck-class battleship Tirpitz was on its way to intercept the convoy, the order was given to scatter since they didn’t want to risk losing their warships. They believed that scattering the convoy would make it harder for the Germans to sink the ships, but what happened was the exact opposite. Contrary to what the British believed, the Tirpitz was not heading towards the convoy, and the merchant ships became easy targets for the German submarines and aircraft which managed to sink 24 ships out of 35."},"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Legions","isReserved":true,"usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Class_Specific_Engineer_Socket_Crank_Sequence_2'","ObjectPath":"kards/Content/War_UI/Waves/Class_Specific/War_UI_Class_Specific_Engineer_Socket_Crank_Sequence_2.0"},"soundAttack":{"ObjectName":"SoundWave'Naval_Support_17'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Naval_Support_17.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/CandidateArtwork/t_sinking_ship.t_sinking_ship","SubPathString":""},"artist":"Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/LOST_CONVOY.LOST_CONVOY","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":355.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_event_lost_convoy_photo","SourceString":"German aerial reconnaissance photo of the PQ-17 convoy, 1942.","LocalizedString":"German aerial reconnaissance photo of the PQ-17 convoy, 1942."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"customName1":"gotchaAfterPlayFromHand","isDirectDamage":true},"variables":[{"name":"tempCard","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_lost_convoy","owner":"card_event_lost_convoy_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"CallFunc_GetOppositeSide_oppositeSide","type":"ESideEnum","direction":"in"},{"name":"CallFunc_IsLocatedOnBoard_isIt","type":"bool","direction":"in"},{"name":"CallFunc_IsUnit_isIt","type":"bool","direction":"in"},{"name":"CallFunc_ShouldGotchaTrigger_shouldIt","type":"bool","direction":"in"},