{"format":"kards-original-reference","version":1,"id":"78ef0f291eb6e713","name":"card_unit_336th_guards_naval","package":"/Game/Blueprints/Cards/Soviet/NavalWarfare/units/card_unit_336th_guards_naval","parent":"UBaseCardObject","card":{"title":"336th GUARDS NAVAL","text":"Deployment: Choose a unit in hand with a cost of 3 or less. Add a copy to your support line.","flavorText":"The 336th Guards Naval Infantry Brigade traces its origins to the 347th Rifle Regiment of the 308th Rifle Division, formed in March 1942. Comprising personnel from the Omsk Infantry School and recruits from the Omsk Region, Altai Territory and its capital city Gorno-Altaysk (southern Siberia), the division was deployed to the Stalingrad Front in September 1942. It engaged in intense combat near the Kotluban state farm and later within Stalingrad itself, particularly around the Barrikady Factory. For its actions during this period, the 308th Division was awarded the Order of the Red Banner in June 1943. After rebuilding, it participated in Operation Kutuzov and was subsequently honored with Guards status, becoming the 120th Guards Rifle Division. The 347th Rifle Regiment was redesignated as the 336th Guards Rifle Regiment. The unit continued to distinguish itself in operations across Orel, Bryansk, and Gomel-Rechitsa. In August 1944, it was awarded the honorary title \"Bialystok\" for its role in liberating the city. Later, it received the Orders of Suvorov and Alexander Nevsky for its exemplary performance.","faction":"Soviet","type":"infantry","rarity":"Unique","cost":4,"operationCost":1,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_336th_guards_naval","title":{"Namespace":"card_soviet","Key":"card_unit_336th_guards_naval_title","SourceString":"336th GUARDS NAVAL","LocalizedString":"336th GUARDS NAVAL"},"Type":"ETypeEnum::infantry","attack":3,"defense":4,"range":1,"faction":"EFactionEnum::Soviet","kredits":4,"Text":{"Namespace":"card_soviet","Key":"card_unit_336th_guards_naval_text","SourceString":"Deployment: Choose a unit in hand with a cost of 3 or less. Add a copy to your support line.","LocalizedString":"Deployment: Choose a unit in hand with a cost of 3 or less. Add a copy to your support line."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_336th_guards_naval_history","SourceString":"The 336th Guards Naval Infantry Brigade traces its origins to the 347th Rifle Regiment of the 308th Rifle Division, formed in March 1942. Comprising personnel from the Omsk Infantry School and recruits from the Omsk Region, Altai Territory and its capital city Gorno-Altaysk (southern Siberia), the division was deployed to the Stalingrad Front in September 1942. It engaged in intense combat near the Kotluban state farm and later within Stalingrad itself, particularly around the Barrikady Factory. For its actions during this period, the 308th Division was awarded the Order of the Red Banner in June 1943. After rebuilding, it participated in Operation Kutuzov and was subsequently honored with Guards status, becoming the 120th Guards Rifle Division. The 347th Rifle Regiment was redesignated as the 336th Guards Rifle Regiment. The unit continued to distinguish itself in operations across Orel, Bryansk, and Gomel-Rechitsa. In August 1944, it was awarded the honorary title \"Bialystok\" for its role in liberating the city. Later, it received the Orders of Suvorov and Alexander Nevsky for its exemplary performance.","LocalizedString":"The 336th Guards Naval Infantry Brigade traces its origins to the 347th Rifle Regiment of the 308th Rifle Division, formed in March 1942. Comprising personnel from the Omsk Infantry School and recruits from the Omsk Region, Altai Territory and its capital city Gorno-Altaysk (southern Siberia), the division was deployed to the Stalingrad Front in September 1942. It engaged in intense combat near the Kotluban state farm and later within Stalingrad itself, particularly around the Barrikady Factory. For its actions during this period, the 308th Division was awarded the Order of the Red Banner in June 1943. After rebuilding, it participated in Operation Kutuzov and was subsequently honored with Guards status, becoming the 120th Guards Rifle Division. The 347th Rifle Regiment was redesignated as the 336th Guards Rifle Regiment. The unit continued to distinguish itself in operations across Orel, Bryansk, and Gomel-Rechitsa. In August 1944, it was awarded the honorary title \"Bialystok\" for its role in liberating the city. Later, it received the Orders of Suvorov and Alexander Nevsky for its exemplary performance."},"operationCost":1,"rarity":"ERarityEnum::Unique","waitWithOnOtherCardPlayedUntilHandTargetSelected":true,"selectHandCardNotifyText":{"Namespace":"","Key":"1F29F32D48D5111CBB23B4B7EE447ECB","SourceString":"Choose a unit in hand with a cost of 3 or less","LocalizedString":"Choose a unit in hand with a cost of 3 or less"},"cardSet":"ECardSetEnum::NavalWarfare","hasDeployment":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/NavalWarfare/t_soviet_naval_infantry_nw.t_soviet_naval_infantry_nw","SubPathString":""},"artist":"Soviet WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/336th_GUARDS_NAVAL.336th_GUARDS_NAVAL","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":284.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_336th_guards_naval_photo","SourceString":"Soviet Naval infantry marching in Leningrad in 1941.","LocalizedString":"Soviet Naval infantry marching in Leningrad in 1941."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_Attac