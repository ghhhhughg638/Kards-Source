{"format":"kards-original-reference","version":1,"id":"6c3f6cc798991a8e","name":"card_unit_1st_defense_battalion","package":"/Game/Blueprints/Cards/USA/Homefront/units/card_unit_1st_defense_battalion","parent":"UBaseCardObject","card":{"title":"1st DEFENSE BATTALION","text":"Deployment: Gets +1 attack if you have a US unit in the frontline.","flavorText":"The 1st Defense Battalion of the United States Marine Corps was formed in 1939 with the mission of providing coastal and air defense for key Pacific outposts. Although equipped for static defense, the Marines of this unit embodied the Corps’ principle that \"every Marine is a rifleman.\" When called upon, they fought not just behind coastal guns, but in direct combat too. By December 1941, elements of the battalion were actively engaged at Johnston, Palmyra, and Wake Island, with the Wake detachment earning a legendary reputation. When Japanese forces launched their first amphibious assault on the island, the Marines responded with remarkable discipline. Their coastal batteries sank the destroyer Hayate and helped repel the landing force, the first major Japanese setback of the war. Despite being isolated and outnumbered, the Wake garrison held out for 15 days before finally being overrun. While the survivors endured years as prisoners of war, other detachments of the battalion continued to serve across the Pacific, later reorganized as antiaircraft units.","faction":"USA","type":"infantry","rarity":"Uncommon","cost":1,"operationCost":0,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.bond"],"Name":"card_unit_1st_defense_battalion","title":{"Namespace":"card_usa","Key":"card_unit_1st_defense_battalion_title","SourceString":"1st DEFENSE BATTALION","LocalizedString":"1st DEFENSE BATTALION"},"Type":"ETypeEnum::infantry","attack":1,"defense":2,"range":1,"faction":"EFactionEnum::USA","kredits":1,"Text":{"Namespace":"card_usa","Key":"card_unit_1st_defense_battalion_text","SourceString":"Deployment: Gets +1 attack if you have a US unit in the frontline.","LocalizedString":"Deployment: Gets +1 attack if you have a US unit in the frontline."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_1st_defense_battalion_history","SourceString":"The 1st Defense Battalion of the United States Marine Corps was formed in 1939 with the mission of providing coastal and air defense for key Pacific outposts. Although equipped for static defense, the Marines of this unit embodied the Corps’ principle that \"every Marine is a rifleman.\" When called upon, they fought not just behind coastal guns, but in direct combat too. By December 1941, elements of the battalion were actively engaged at Johnston, Palmyra, and Wake Island, with the Wake detachment earning a legendary reputation. When Japanese forces launched their first amphibious assault on the island, the Marines responded with remarkable discipline. Their coastal batteries sank the destroyer Hayate and helped repel the landing force, the first major Japanese setback of the war. Despite being isolated and outnumbered, the Wake garrison held out for 15 days before finally being overrun. While the survivors endured years as prisoners of war, other detachments of the battalion continued to serve across the Pacific, later reorganized as antiaircraft units.","LocalizedString":"The 1st Defense Battalion of the United States Marine Corps was formed in 1939 with the mission of providing coastal and air defense for key Pacific outposts. Although equipped for static defense, the Marines of this unit embodied the Corps’ principle that \"every Marine is a rifleman.\" When called upon, they fought not just behind coastal guns, but in direct combat too. By December 1941, elements of the battalion were actively engaged at Johnston, Palmyra, and Wake Island, with the Wake detachment earning a legendary reputation. When Japanese forces launched their first amphibious assault on the island, the Marines responded with remarkable discipline. Their coastal batteries sank the destroyer Hayate and helped repel the landing force, the first major Japanese setback of the war. Despite being isolated and outnumbered, the Wake garrison held out for 15 days before finally being overrun. While the survivors endured years as prisoners of war, other detachments of the battalion continued to serve across the Pacific, later reorganized as antiaircraft units."},"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Homefront","hasDeployment":true,"hasBlitz":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/1st_DEFENSE_BATTALION.1st_DEFENSE_BATTALION","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":403.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_1st_defense_battalion_photo","SourceString":"Men of the 1st Defense Battalion on NAS Palmyra Island in 1942.","LocalizedString":"Men of the 1st Defense Battalion on NAS Palmyra Island in 1942."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_1st_defense_battalion","owner":"card_unit_1st_defense_battalion_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"Temp_bool_True_if_break_was_hit_Variable","type":"bool","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"CallFunc_Not_PreBool_ReturnValue","type":"bool",