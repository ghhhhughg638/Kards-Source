{"format":"kards-original-reference","version":1,"id":"a289950ae9c6d228","name":"card_event_first_responders","package":"/Game/Blueprints/Cards/Britain/CovertOp/events/card_event_first_responders","parent":"UBaseCardObject","card":{"title":"FIRST RESPONDERS","text":"At the end of the enemy turn, add a 5th BRIGADE to your support line. Give it +3+3 if enemy has 3 or more units.","flavorText":"The Battles of Kohima and Imphal in 1944, part of the Burma Campaign during WWII, were the turning point of the Japanese U-Go offensive into India, and a notable example of Allied logistical superiority at the time. The battles took place from April 4 to June 22- 1944, in the vicinity of Kohima, now the capital of Nagaland in Northeast India, and near the city of Imphal. Despite having numeral superiority, the Japanese underestimated the Allies’ defensive skills, and their ability to bring up reinforcements. The Allied reinforcements started to arrive on April 14th and from then on the battle turned in their favor. During the battle, the RAF managed to airlift the 5th Indian Division and its equipment from Arakan to Imphal (525 km) in only two days, and to evacuate around 13,000 casualties from the battle. The Japanese suffered a bitter defeat, with 53,000 men dead or missing, most being the result of starvation, disease and exhaustion. Despite their victory the Allies also suffered heavy losses, 4,000 casualties at Koshima and another 12,500 at Imphal.","faction":"Britain","type":"gotcha","rarity":"Common","cost":3,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_first_responders","title":{"Namespace":"card_britain","Key":"card_event_first_responders_title","SourceString":"FIRST RESPONDERS","LocalizedString":"FIRST RESPONDERS"},"Type":"ETypeEnum::gotcha","faction":"EFactionEnum::Britain","kredits":3,"Text":{"Namespace":"card_britain","Key":"card_event_first_responders_text","SourceString":"At the end of the enemy turn, add a 5th BRIGADE to your support line. Give it +3+3 if enemy has 3 or more units.","LocalizedString":"At the end of the enemy turn, add a 5th BRIGADE to your support line. Give it +3+3 if enemy has 3 or more units."},"flavorText":{"Namespace":"card_britain","Key":"card_event_first_responders_history","SourceString":"The Battles of Kohima and Imphal in 1944, part of the Burma Campaign during WWII, were the turning point of the Japanese U-Go offensive into India, and a notable example of Allied logistical superiority at the time. The battles took place from April 4 to June 22- 1944, in the vicinity of Kohima, now the capital of Nagaland in Northeast India, and near the city of Imphal. Despite having numeral superiority, the Japanese underestimated the Allies’ defensive skills, and their ability to bring up reinforcements. The Allied reinforcements started to arrive on April 14th and from then on the battle turned in their favor. During the battle, the RAF managed to airlift the 5th Indian Division and its equipment from Arakan to Imphal (525 km) in only two days, and to evacuate around 13,000 casualties from the battle. The Japanese suffered a bitter defeat, with 53,000 men dead or missing, most being the result of starvation, disease and exhaustion. Despite their victory the Allies also suffered heavy losses, 4,000 casualties at Koshima and another 12,500 at Imphal.","LocalizedString":"The Battles of Kohima and Imphal in 1944, part of the Burma Campaign during WWII, were the turning point of the Japanese U-Go offensive into India, and a notable example of Allied logistical superiority at the time. The battles took place from April 4 to June 22- 1944, in the vicinity of Kohima, now the capital of Nagaland in Northeast India, and near the city of Imphal. Despite having numeral superiority, the Japanese underestimated the Allies’ defensive skills, and their ability to bring up reinforcements. The Allied reinforcements started to arrive on April 14th and from then on the battle turned in their favor. During the battle, the RAF managed to airlift the 5th Indian Division and its equipment from Arakan to Imphal (525 km) in only two days, and to evacuate around 13,000 casualties from the battle. The Japanese suffered a bitter defeat, with 53,000 men dead or missing, most being the result of starvation, disease and exhaustion. Despite their victory the Allies also suffered heavy losses, 4,000 casualties at Koshima and another 12,500 at Imphal."},"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::CurrentExpansion","isInPermanentPool":true,"usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"draftBaseWeight":0.8,"spawnCardName":"card_unit_5th_brigade","soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Class_Specific_Engineer_Socket_Crank_Sequence_2'","ObjectPath":"kards/Content/War_UI/Waves/Class_Specific/War_UI_Class_Specific_Engineer_Socket_Crank_Sequence_2.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/CandidateArtwork/Summer_24/t_first_responders.t_first_responders","SubPathString":""},"artist":"Michael Turner","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/FIRST_RESPONDERS.FIRST_RESPONDERS","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":341.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_event_first_responders_photo","SourceString":"A M3 Lee tank crossing a river north of Imphal to meet the Japanese advance, 1944.","LocalizedString":"A M3 Lee tank crossing a river north of Imphal to meet the Japanese advance, 1944."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""}},"variables":[{"name":"count","type":"int32","direction":"in"},{"name":"tempCard","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_first_responders","owner":"card_event_first_responders_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_F