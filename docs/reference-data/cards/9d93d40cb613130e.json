{"format":"kards-original-reference","version":1,"id":"9d93d40cb613130e","name":"card_unit_1st_recon","package":"/Game/Blueprints/Cards/Japan/OceaniaStorm/units/card_unit_1st_recon","parent":"UBaseCardObject","card":{"title":"7th RECON","text":"Destruction: Draw a card if you know a card in the enemy hand.","flavorText":"The 7th Reconnaissance Regiment served as the reconnaissance element of Japan’s 7th Division, scouting ahead of the main force and reporting on enemy positions and movements. By 1941, it was listed among the division’s principal components alongside its three infantry regiments, artillery, engineers and support units. The 7th Division was known as the “Bear Division” and was one of the Imperial Japanese Army’s oldest formations. Based in Hokkaido, it had a long military history dating back to the late 19th century and remained closely associated with the defense of Japan’s northern territories. During the Pacific War, parts of the division were sent overseas. The 28th Infantry Regiment  fought on Guadalcanal, where it suffered catastrophic losses at the battles of Tenaru and Edson’s Ridge, while another detachment took part in the occupation of Attu in the Aleutian Islands. Most of the division, however, remained in Hokkaido, where it built defensive positions, preparing for a potential Allied invasion. It remained there until Japan surrendered in September 1945.","faction":"Japan","type":"infantry","rarity":"Common","cost":1,"operationCost":1,"attack":2,"defense":1},"defaults":{"UberGraphFrame":{},"Name":"card_unit_1st_recon","title":{"Namespace":"card_japan","Key":"card_unit_1st_recon_title","SourceString":"7th RECON","LocalizedString":"7th RECON"},"Type":"ETypeEnum::infantry","attack":2,"defense":1,"range":1,"faction":"EFactionEnum::Japan","kredits":1,"Text":{"Namespace":"card_japan","Key":"card_unit_1st_recon_text","SourceString":"Destruction: Draw a card if you know a card in the enemy hand.","LocalizedString":"Destruction: Draw a card if you know a card in the enemy hand."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_1st_recon_history","SourceString":"The 7th Reconnaissance Regiment served as the reconnaissance element of Japan’s 7th Division, scouting ahead of the main force and reporting on enemy positions and movements. By 1941, it was listed among the division’s principal components alongside its three infantry regiments, artillery, engineers and support units. The 7th Division was known as the “Bear Division” and was one of the Imperial Japanese Army’s oldest formations. Based in Hokkaido, it had a long military history dating back to the late 19th century and remained closely associated with the defense of Japan’s northern territories. During the Pacific War, parts of the division were sent overseas. The 28th Infantry Regiment  fought on Guadalcanal, where it suffered catastrophic losses at the battles of Tenaru and Edson’s Ridge, while another detachment took part in the occupation of Attu in the Aleutian Islands. Most of the division, however, remained in Hokkaido, where it built defensive positions, preparing for a potential Allied invasion. It remained there until Japan surrendered in September 1945.","LocalizedString":"The 7th Reconnaissance Regiment served as the reconnaissance element of Japan’s 7th Division, scouting ahead of the main force and reporting on enemy positions and movements. By 1941, it was listed among the division’s principal components alongside its three infantry regiments, artillery, engineers and support units. The 7th Division was known as the “Bear Division” and was one of the Imperial Japanese Army’s oldest formations. Based in Hokkaido, it had a long military history dating back to the late 19th century and remained closely associated with the defense of Japan’s northern territories. During the Pacific War, parts of the division were sent overseas. The 28th Infantry Regiment  fought on Guadalcanal, where it suffered catastrophic losses at the battles of Tenaru and Edson’s Ridge, while another detachment took part in the occupation of Attu in the Aleutian Islands. Most of the division, however, remained in Hokkaido, where it built defensive positions, preparing for a potential Allied invasion. It remained there until Japan surrendered in September 1945."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::OceaniaStorm","hasDestruction":true,"hasAmbush":true,"cipher":1,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/7th_RECON.7th_RECON","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":419.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_1st_recon_photo","SourceString":"An Imperial Army Type 97 tankette of a Japanese Reconnaissance Regiment, Phillipines, 1942.","LocalizedString":"An Imperial Army Type 97 tankette of a Japanese Reconnaissance Regiment, Phillipines, 1942."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"seenFound","type":"bool","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_1st_recon","owner":"card_unit_1st_recon_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_bool_True_if_break_was_hit_Variable","type":"bool","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Not_PreBool_ReturnValue","type":"bool","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add