{"format":"kards-original-reference","version":1,"id":"b4a3513cb70001a5","name":"card_unit_5_panzergrenadier","package":"/Game/Blueprints/Cards/Germany/Breakthrough/units/card_unit_5_panzergrenadier","parent":"UBaseCardObject","card":{"title":"5. PANZERGRENADIER","text":"Pincer: After this unit attacks and survives combat, your other units with an active Pincer get +1+1.","flavorText":"The 5th Panzergrenadier regiment was part of the 12th Panzer Division which was an armored division of the Wehrmacht during WWII. In 1941 the division participated in Operation Barbarossa, and as part of Army Group North it participated in the drive towards Leningrad where it suffered heavy casualties in the Soviet Counteroffensive of 1941-42. The division participated in the Battle of Kursk in 1943 and was eventually entrapped in the Courland Pocket during Operation Bagration in 1944, where it surrendered to the Red Army in May 1945.","faction":"Germany","type":"infantry","rarity":"Common","cost":3,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_5_panzergrenadier","title":{"Namespace":"card_germany","Key":"card_unit_5_panzergrenadier_title","SourceString":"5. PANZERGRENADIER","LocalizedString":"5. PANZERGRENADIER"},"Type":"ETypeEnum::infantry","attack":2,"defense":3,"range":1,"faction":"EFactionEnum::Germany","kredits":3,"Text":{"Namespace":"card_germany","Key":"card_unit_5_panzergrenadier_text","SourceString":"Pincer: After this unit attacks and survives combat, your other units with an active Pincer get +1+1.","LocalizedString":"Pincer: After this unit attacks and survives combat, your other units with an active Pincer get +1+1."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_5_panzergrenadier_history","SourceString":"The 5th Panzergrenadier regiment was part of the 12th Panzer Division which was an armored division of the Wehrmacht during WWII. In 1941 the division participated in Operation Barbarossa, and as part of Army Group North it participated in the drive towards Leningrad where it suffered heavy casualties in the Soviet Counteroffensive of 1941-42. The division participated in the Battle of Kursk in 1943 and was eventually entrapped in the Courland Pocket during Operation Bagration in 1944, where it surrendered to the Red Army in May 1945.","LocalizedString":"The 5th Panzergrenadier regiment was part of the 12th Panzer Division which was an armored division of the Wehrmacht during WWII. In 1941 the division participated in Operation Barbarossa, and as part of Army Group North it participated in the drive towards Leningrad where it suffered heavy casualties in the Soviet Counteroffensive of 1941-42. The division participated in the Battle of Kursk in 1943 and was eventually entrapped in the Courland Pocket during Operation Bagration in 1944, where it surrendered to the Red Army in May 1945."},"operationCost":1,"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Breakthrough","isReserved":true,"usedTriggers":["ERegisteredCardFunction::OnOtherCardSurvivedCombat"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Pincer"],"hasPincer":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion02'","ObjectPath":"kards/Content/StarterContent/Audio/Explosion02.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/t_panzergren_x.t_panzergren_x","SubPathString":""},"artist":"Jarosław Wróbel","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/5__PANZERGRENADIER_replacement_photo.5__PANZERGRENADIER_replacement_photo","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":358.0},"historyPhotoDescription":{"Namespace":"","Key":"2FFF2BD0445ECC03531BA2B6CA41ED5C","SourceString":"Panzergrenadiers riding a Panzer III tank. Battle of Kursk, 1943. ","LocalizedString":"Panzergrenadiers riding a Panzer III tank. Battle of Kursk, 1943. "},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Con