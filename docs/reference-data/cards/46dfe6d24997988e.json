{"format":"kards-original-reference","version":1,"id":"46dfe6d24997988e","name":"card_unit_yokosuka_e14y","package":"/Game/Blueprints/Cards/Japan/OceaniaStorm/units/card_unit_yokosuka_e14y","parent":"UBaseCardObject","card":{"title":"YOKOSUKA E14Y","text":"Deployment: Forecast. Draw a card if you have 0 kredits.","flavorText":"The Yokosuka E14Y was a submarine based reconnaissance seaplane used by the Imperial Japanese Navy during WWII. It first flew in 1939, entered service in 1941, and 126 were built. The aircraft was carried in a watertight hangar aboard large submarines such as I 25. Its wings could fold for storage, and it was launched by catapult when the submarine surfaced. After completing a mission, it landed on floats beside the submarine and was lifted back aboard. The E14Y, nicknamed Glen by the Allies, carried a crew of two and usually served as a scouting aircraft. In 1942, E14Ys flew reconnaissance missions over Melbourne, Wellington, Auckland, and Sydney. One flight preceded the Japanese midget submarine attack on Sydney Harbour. The aircraft is best known for the Lookout Air Raid in Oregon, when it was launched from a submarine and dropped two incendiary bombs in an attempt to start forest fires. The attack caused no serious damage, but it made the E14Y the only submarine-based aircraft to bomb the US mainland during WWII.","faction":"Japan","type":"fighter","rarity":"Uncommon","cost":3,"operationCost":1,"attack":2,"defense":2},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.forecast"],"Name":"card_unit_yokosuka_e14y","title":{"Namespace":"card_japan","Key":"card_unit_yokosuka_e14y_title","SourceString":"YOKOSUKA E14Y","LocalizedString":"YOKOSUKA E14Y"},"Type":"ETypeEnum::fighter","attack":2,"defense":2,"range":2,"faction":"EFactionEnum::Japan","kredits":3,"Text":{"Namespace":"card_japan","Key":"card_unit_yokosuka_e14y_text","SourceString":"Deployment: Forecast. Draw a card if you have 0 kredits.","LocalizedString":"Deployment: Forecast. Draw a card if you have 0 kredits."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_yokosuka_e14y_history","SourceString":"The Yokosuka E14Y was a submarine based reconnaissance seaplane used by the Imperial Japanese Navy during WWII. It first flew in 1939, entered service in 1941, and 126 were built. The aircraft was carried in a watertight hangar aboard large submarines such as I 25. Its wings could fold for storage, and it was launched by catapult when the submarine surfaced. After completing a mission, it landed on floats beside the submarine and was lifted back aboard. The E14Y, nicknamed Glen by the Allies, carried a crew of two and usually served as a scouting aircraft. In 1942, E14Ys flew reconnaissance missions over Melbourne, Wellington, Auckland, and Sydney. One flight preceded the Japanese midget submarine attack on Sydney Harbour. The aircraft is best known for the Lookout Air Raid in Oregon, when it was launched from a submarine and dropped two incendiary bombs in an attempt to start forest fires. The attack caused no serious damage, but it made the E14Y the only submarine-based aircraft to bomb the US mainland during WWII.","LocalizedString":"The Yokosuka E14Y was a submarine based reconnaissance seaplane used by the Imperial Japanese Navy during WWII. It first flew in 1939, entered service in 1941, and 126 were built. The aircraft was carried in a watertight hangar aboard large submarines such as I 25. Its wings could fold for storage, and it was launched by catapult when the submarine surfaced. After completing a mission, it landed on floats beside the submarine and was lifted back aboard. The E14Y, nicknamed Glen by the Allies, carried a crew of two and usually served as a scouting aircraft. In 1942, E14Ys flew reconnaissance missions over Melbourne, Wellington, Auckland, and Sydney. One flight preceded the Japanese midget submarine attack on Sydney Harbour. The aircraft is best known for the Lookout Air Raid in Oregon, when it was launched from a submarine and dropped two incendiary bombs in an attempt to start forest fires. The attack caused no serious damage, but it made the E14Y the only submarine-based aircraft to bomb the US mainland during WWII."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::OceaniaStorm","usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"hasDeployment":true,"hasBlitz":true,"spawnCardName":"card_event_sunny1_blue_sky;card_event_rain1_mist;card_event_storm1_gale","cipher":2,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/YOKOSUKA_E14Y.YOKOSUKA_E14Y","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_yokosuka_e14y_photo","SourceString":"A Yokosuka E14Y being launched from a submarine. Date unknown.","LocalizedString":"A Yokosuka E14Y being launched from a submarine. Date unknown."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftS'","ObjectPath":"kards/Content/Effects/Explosions/Small/Aircraft/P_ExplosionAircraftS.119"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackFighter.BP_AttackFighter_C","SubPathString":""},"isDraw":true},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_yokosuka_e14y","owner":"card_unit_yokosuka_e14y_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_DrawCardsFromDeckBySide_cardsIDs","type":"TArray<int32>","direction":"in"},{"name":"CallFunc_Forecast_qqq","type":"int32","direction":"in"},{"name":"K2Node_Event_turnnumber","type":"int32","direction":"in"},{"name":"CallFunc_GetKreditsBySide_kredits","type":"int32","direction":"in"},{