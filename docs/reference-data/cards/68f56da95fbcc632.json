{"format":"kards-original-reference","version":1,"id":"68f56da95fbcc632","name":"card_unit_tupolev_tu_2","package":"/Game/Blueprints/Cards/Soviet/OceaniaStorm/units/card_unit_tupolev_tu_2","parent":"UBaseCardObject","card":{"title":"TUPOLEV TU-2","text":"Draw a random unit from your deck when a friendly unit becomes Veteran.","flavorText":"The Tupolev Tu-2 was a Soviet twin-engine medium bomber designed for speed, range, and a heavy bomb load. It first flew in 1941 and entered service in 1942. A total of 2,257 were built. The aircraft was created under difficult conditions, since Andrei Tupolev had been arrested during the Soviet purges but was still placed in charge of an aircraft design team because of his value to the war effort. The Tu-2 was intended to match the German Junkers Ju 88 as a fast daylight bomber and dive bomber. It could carry up to 1.5 tons of bombs internally, and 2.2 externally, while two forward-firing 20 mm cannons and defensive machine guns gave it useful protection. Crews valued it because it was fast, handled well, and could survive heavy damage. Its combat debut happened around Velikiye Luki in late 1942 with the 132nd Bomber Aviation Regiment. Production problems and engine changes slowed wider use, but some improved versions went into production in 1943. The Tu-2 became one of the Soviet Union’s most important twin-engine bombers, and played a key role in the Red Army’s final offensives.","faction":"Soviet","type":"bomber","rarity":"Uncommon","cost":4,"operationCost":2,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_tupolev_tu_2","title":{"Namespace":"card_soviet","Key":"card_unit_tupolev_tu_2_title","SourceString":"TUPOLEV TU-2","LocalizedString":"TUPOLEV TU-2"},"Type":"ETypeEnum::bomber","attack":3,"defense":4,"range":2,"faction":"EFactionEnum::Soviet","kredits":4,"Text":{"Namespace":"card_soviet","Key":"card_unit_tupolev_tu_2_text","SourceString":"Draw a random unit from your deck when a friendly unit becomes Veteran.","LocalizedString":"Draw a random unit from your deck when a friendly unit becomes Veteran."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_tupolev_tu_2_history","SourceString":"The Tupolev Tu-2 was a Soviet twin-engine medium bomber designed for speed, range, and a heavy bomb load. It first flew in 1941 and entered service in 1942. A total of 2,257 were built. The aircraft was created under difficult conditions, since Andrei Tupolev had been arrested during the Soviet purges but was still placed in charge of an aircraft design team because of his value to the war effort. The Tu-2 was intended to match the German Junkers Ju 88 as a fast daylight bomber and dive bomber. It could carry up to 1.5 tons of bombs internally, and 2.2 externally, while two forward-firing 20 mm cannons and defensive machine guns gave it useful protection. Crews valued it because it was fast, handled well, and could survive heavy damage. Its combat debut happened around Velikiye Luki in late 1942 with the 132nd Bomber Aviation Regiment. Production problems and engine changes slowed wider use, but some improved versions went into production in 1943. The Tu-2 became one of the Soviet Union’s most important twin-engine bombers, and played a key role in the Red Army’s final offensives.","LocalizedString":"The Tupolev Tu-2 was a Soviet twin-engine medium bomber designed for speed, range, and a heavy bomb load. It first flew in 1941 and entered service in 1942. A total of 2,257 were built. The aircraft was created under difficult conditions, since Andrei Tupolev had been arrested during the Soviet purges but was still placed in charge of an aircraft design team because of his value to the war effort. The Tu-2 was intended to match the German Junkers Ju 88 as a fast daylight bomber and dive bomber. It could carry up to 1.5 tons of bombs internally, and 2.2 externally, while two forward-firing 20 mm cannons and defensive machine guns gave it useful protection. Crews valued it because it was fast, handled well, and could survive heavy damage. Its combat debut happened around Velikiye Luki in late 1942 with the 132nd Bomber Aviation Regiment. Production problems and engine changes slowed wider use, but some improved versions went into production in 1943. The Tu-2 became one of the Soviet Union’s most important twin-engine bombers, and played a key role in the Red Army’s final offensives."},"operationCost":2,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardBecomingVeteran"],"hasSmokescreen":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/TUPOLEV_TU-2.TUPOLEV_TU-2","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_tupolev_tu_2_photo","SourceString":"A Tupolev Tu-2 being prepared for a cold weather start, with heated oil circulated through its engines in freezing winter conditions. Date unknown.","LocalizedString":"A Tupolev Tu-2 being prepared for a cold weather start, with heated oil circulated through its engines in freezing winter conditions. Date unknown."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackBomber.BP_AttackBomber_C","SubPathString":""},"Notes":"Needs artwork licensed or new","isHQDamage":true,"threat_level":0.1},"variables":[{"name":"my_deck_units","type":"TArray<UBaseCardObject*>","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_tupolev_tu_2","owner":"card_unit_tupolev_tu_2_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_