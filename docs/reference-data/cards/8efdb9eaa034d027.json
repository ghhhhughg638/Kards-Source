{"format":"kards-original-reference","version":1,"id":"8efdb9eaa034d027","name":"card_unit_2e_rima","package":"/Game/Blueprints/Cards/France/units/card_unit_2e_rima","parent":"UBaseCardObject","card":{"title":"2e RIMa","text":"At the end of your turn, give adjacent units Mobilize.","flavorText":"The 2nd Marine Infantry Regiment (French: 2e Régiment d'Infanterie de Marine or 2e RIMa) is a regiment of the Troupes de marine in the French Army which has been active from 1831 to the present day. During WWII, the regiment took part in the Battle of France and resisted the German invasion forces at Amiens, but was dissolved following the fall of France in 1940. The 2e RIMa was restored by the Free French Forces in 1941 and participated in the Battle of Keren during the East African Campaign, as part of the Free French Brigade of the Orient. In 1942 the regiment joined the 2nd Free French Brigade, which in 1943 became part of the 1st Free French Division (1re Division Française Libre or 1re DFL). They were involved in operations and campaigns in Libya and Tunisia, including the Battle of El Alamein and the Battle of Takrouna. The 1re DFL joined the Italian Campaign in April 1944 where it fought in the Battle of Pontecorvo, and landed in Provence during Operation Dragoon, which was the Allied landing in Southern France. Finally in 1945, as part of the French First Army, the division fought German forces in the Colmar Pocket and participated in the city’s liberation.","faction":"France","type":"infantry","rarity":"Uncommon","cost":5,"operationCost":1,"attack":4,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_2e_rima","title":{"Namespace":"card_france","Key":"card_unit_2e_rima_title","SourceString":"2e RIMa","LocalizedString":"2e RIMa"},"Type":"ETypeEnum::infantry","attack":4,"defense":6,"range":1,"faction":"EFactionEnum::France","kredits":5,"Text":{"Namespace":"card_france","Key":"card_unit_2e_rima_text","SourceString":"At the end of your turn, give adjacent units Mobilize.","LocalizedString":"At the end of your turn, give adjacent units Mobilize."},"flavorText":{"Namespace":"card_france","Key":"card_unit_2e_rima_history","SourceString":"The 2nd Marine Infantry Regiment (French: 2e Régiment d'Infanterie de Marine or 2e RIMa) is a regiment of the Troupes de marine in the French Army which has been active from 1831 to the present day. During WWII, the regiment took part in the Battle of France and resisted the German invasion forces at Amiens, but was dissolved following the fall of France in 1940. The 2e RIMa was restored by the Free French Forces in 1941 and participated in the Battle of Keren during the East African Campaign, as part of the Free French Brigade of the Orient. In 1942 the regiment joined the 2nd Free French Brigade, which in 1943 became part of the 1st Free French Division (1re Division Française Libre or 1re DFL). They were involved in operations and campaigns in Libya and Tunisia, including the Battle of El Alamein and the Battle of Takrouna. The 1re DFL joined the Italian Campaign in April 1944 where it fought in the Battle of Pontecorvo, and landed in Provence during Operation Dragoon, which was the Allied landing in Southern France. Finally in 1945, as part of the French First Army, the division fought German forces in the Colmar Pocket and participated in the city’s liberation.","LocalizedString":"The 2nd Marine Infantry Regiment (French: 2e Régiment d'Infanterie de Marine or 2e RIMa) is a regiment of the Troupes de marine in the French Army which has been active from 1831 to the present day. During WWII, the regiment took part in the Battle of France and resisted the German invasion forces at Amiens, but was dissolved following the fall of France in 1940. The 2e RIMa was restored by the Free French Forces in 1941 and participated in the Battle of Keren during the East African Campaign, as part of the Free French Brigade of the Orient. In 1942 the regiment joined the 2nd Free French Brigade, which in 1943 became part of the 1st Free French Division (1re Division Française Libre or 1re DFL). They were involved in operations and campaigns in Libya and Tunisia, including the Battle of El Alamein and the Battle of Takrouna. The 1re DFL joined the Italian Campaign in April 1944 where it fought in the Battle of Pontecorvo, and landed in Provence during Operation Dragoon, which was the Allied landing in Southern France. Finally in 1945, as part of the French First Army, the division fought German forces in the Colmar Pocket and participated in the city’s liberation."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::WorldAtWar","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Mobilize","EHelpBubbleTypes::Guard"],"draftBaseWeight":0.7,"hasGuard":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Small'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Small.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/France/t_franch_naval_inf.t_franch_naval_inf","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/2e_RIMa.2e_RIMa","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":310.0},"historyPhotoDescription":{"Namespace":"card_france","Key":"card_unit_2e_rima_photo","SourceString":"French soldiers of the First Free French Army in the Colmar Pocket, 1945.","LocalizedString":"French soldiers of the First Free French Army in the Colmar Pocket, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInf