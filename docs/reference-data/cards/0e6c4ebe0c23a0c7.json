{"format":"kards-original-reference","version":1,"id":"0e6c4ebe0c23a0c7","name":"card_unit_3_panzergrenadier","package":"/Game/Blueprints/Cards/Germany/OceaniaStorm/units/card_unit_3_panzergrenadier","parent":"UBaseCardObject","card":{"title":"3. PANZERGRENADIER","text":"Gets +1+1 after you operate a German unit.","flavorText":"Panzer Grenadier Regiment 3 was part of the 3rd Panzer Division, serving alongside Panzer Grenadier Regiment 394 in the division’s 1943 Eastern Front organization. The 3rd Panzer Division was one of Germany’s first three tank divisions, formed in 1935 and headquartered in Berlin. It fought in Poland in 1939, where it was the strongest German panzer division by tank numbers, with 391 tanks. In 1940 it advanced through Belgium toward Brussels and into France. Afterward, one of its two tank regiments was removed to help form new panzer divisions, and the division gained more infantry. Panzer Grenadier Regiments were formed to fill the motorized infantry role that German panzer divisions needed after losing some armored strength and reorganizing for a longer war. In 1941 the 3rd Panzer division joined Operation Barbarossa. It fought first in the central sector, then in Ukraine during the Battle of Kiev, and later drove toward Tula during the Battle of Moscow. In 1942 it advanced toward the Caucasus during Case Blue, but suffered heavy losses near Mozdok. It later fought at Kursk and remained on the Eastern Front until 1945, ending the war in Styria where it surrendered to US forces.","faction":"Germany","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":1,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_3_panzergrenadier","title":{"Namespace":"card_germany","Key":"card_unit_3_panzergrenadier_title","SourceString":"3. PANZERGRENADIER","LocalizedString":"3. PANZERGRENADIER"},"Type":"ETypeEnum::infantry","attack":3,"defense":3,"range":1,"faction":"EFactionEnum::Germany","kredits":3,"Text":{"Namespace":"card_germany","Key":"card_unit_3_panzergrenadier_text","SourceString":"Gets +1+1 after you operate a German unit.","LocalizedString":"Gets +1+1 after you operate a German unit."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_3_panzergrenadier_history","SourceString":"Panzer Grenadier Regiment 3 was part of the 3rd Panzer Division, serving alongside Panzer Grenadier Regiment 394 in the division’s 1943 Eastern Front organization. The 3rd Panzer Division was one of Germany’s first three tank divisions, formed in 1935 and headquartered in Berlin. It fought in Poland in 1939, where it was the strongest German panzer division by tank numbers, with 391 tanks. In 1940 it advanced through Belgium toward Brussels and into France. Afterward, one of its two tank regiments was removed to help form new panzer divisions, and the division gained more infantry. Panzer Grenadier Regiments were formed to fill the motorized infantry role that German panzer divisions needed after losing some armored strength and reorganizing for a longer war. In 1941 the 3rd Panzer division joined Operation Barbarossa. It fought first in the central sector, then in Ukraine during the Battle of Kiev, and later drove toward Tula during the Battle of Moscow. In 1942 it advanced toward the Caucasus during Case Blue, but suffered heavy losses near Mozdok. It later fought at Kursk and remained on the Eastern Front until 1945, ending the war in Styria where it surrendered to US forces.","LocalizedString":"Panzer Grenadier Regiment 3 was part of the 3rd Panzer Division, serving alongside Panzer Grenadier Regiment 394 in the division’s 1943 Eastern Front organization. The 3rd Panzer Division was one of Germany’s first three tank divisions, formed in 1935 and headquartered in Berlin. It fought in Poland in 1939, where it was the strongest German panzer division by tank numbers, with 391 tanks. In 1940 it advanced through Belgium toward Brussels and into France. Afterward, one of its two tank regiments was removed to help form new panzer divisions, and the division gained more infantry. Panzer Grenadier Regiments were formed to fill the motorized infantry role that German panzer divisions needed after losing some armored strength and reorganizing for a longer war. In 1941 the 3rd Panzer division joined Operation Barbarossa. It fought first in the central sector, then in Ukraine during the Battle of Kiev, and later drove toward Tula during the Battle of Moscow. In 1942 it advanced toward the Caucasus during Case Blue, but suffered heavy losses near Mozdok. It later fought at Kursk and remained on the Eastern Front until 1945, ending the war in Styria where it surrendered to US forces."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnAfterOtherCardAttacks","ERegisteredCardFunction::OnOtherCardMoveToFrontline"],"hasBlitz":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/3__PANZERGRENADIER.3__PANZERGRENADIER","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_3_panzergrenadier_photo","SourceString":"German Panzergrenadiers and a Tiger I at Kursk in 1943.","LocalizedString":"German Panzergrenadiers and a Tiger I at Kursk in 1943."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_3_panzergrenadier","owner":"card_unit_3_panzergrenadier_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flag