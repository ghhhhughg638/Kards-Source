{"format":"kards-original-reference","version":1,"id":"d46457f38327a367","name":"card_unit_641st_rifles","package":"/Game/Blueprints/Cards/Soviet/OceaniaStorm/units/card_unit_641st_rifles","parent":"UBaseCardObject","card":{"title":"641st RIFLES","text":"Becomes Veteran at the start of your turn if damaged.","flavorText":"The 641st Rifle Regiment served in both formations of the Soviet 165th Rifle Division. In the first formation, the division moved from the North Caucasus Military District to the Kyiv front in 1941. There, the 165th fought south of the Ukrainian capital before being caught in the encirclement of the Southwestern Front, the largest encirclement in the history of warfare, and effectively destroyed. A new 165th Rifle Division was formed in the Ural Military District in early 1942, and the 641st Rifle Regiment was again included in its order of battle. The rebuilt division went north to the Leningrad sector, where it fought in difficult operations around Lyuban, Krasny Bor, and Mga. It later moved west, fought near Nevel, and joined the advance through Belorussia and Poland. In 1944, the division was awarded the Order of the Red Banner and received the honorific title “Siedlce” after helping capture the city. In 1945, the 641st Rifle Regiment earned its own Order of the Red Banner during the East Pomeranian offensive, before the division ended the war near the Baltic coast.","faction":"Soviet","type":"infantry","rarity":"Unique","cost":3,"operationCost":1,"attack":1,"defense":8},"defaults":{"UberGraphFrame":{},"Name":"card_unit_641st_rifles","title":{"Namespace":"card_soviet","Key":"card_unit_641st_rifles_title","SourceString":"641st RIFLES","LocalizedString":"641st RIFLES"},"Type":"ETypeEnum::infantry","attack":1,"defense":8,"range":1,"faction":"EFactionEnum::Soviet","kredits":3,"Text":{"Namespace":"card_soviet","Key":"card_unit_641st_rifles_text","SourceString":"Becomes Veteran at the start of your turn if damaged.","LocalizedString":"Becomes Veteran at the start of your turn if damaged."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_641st_rifles_history","SourceString":"The 641st Rifle Regiment served in both formations of the Soviet 165th Rifle Division. In the first formation, the division moved from the North Caucasus Military District to the Kyiv front in 1941. There, the 165th fought south of the Ukrainian capital before being caught in the encirclement of the Southwestern Front, the largest encirclement in the history of warfare, and effectively destroyed. A new 165th Rifle Division was formed in the Ural Military District in early 1942, and the 641st Rifle Regiment was again included in its order of battle. The rebuilt division went north to the Leningrad sector, where it fought in difficult operations around Lyuban, Krasny Bor, and Mga. It later moved west, fought near Nevel, and joined the advance through Belorussia and Poland. In 1944, the division was awarded the Order of the Red Banner and received the honorific title “Siedlce” after helping capture the city. In 1945, the 641st Rifle Regiment earned its own Order of the Red Banner during the East Pomeranian offensive, before the division ended the war near the Baltic coast.","LocalizedString":"The 641st Rifle Regiment served in both formations of the Soviet 165th Rifle Division. In the first formation, the division moved from the North Caucasus Military District to the Kyiv front in 1941. There, the 165th fought south of the Ukrainian capital before being caught in the encirclement of the Southwestern Front, the largest encirclement in the history of warfare, and effectively destroyed. A new 165th Rifle Division was formed in the Ural Military District in early 1942, and the 641st Rifle Regiment was again included in its order of battle. The rebuilt division went north to the Leningrad sector, where it fought in difficult operations around Lyuban, Krasny Bor, and Mga. It later moved west, fought near Nevel, and joined the advance through Belorussia and Poland. In 1944, the division was awarded the Order of the Red Banner and received the honorific title “Siedlce” after helping capture the city. In 1945, the 641st Rifle Regiment earned its own Order of the Red Banner during the East Pomeranian offensive, before the division ended the war near the Baltic coast."},"operationCost":1,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::OceaniaStorm","usedTriggers":["ERegisteredCardFunction::OnStartofTurn","ERegisteredCardFunction::OnBeforeStartOfTurn","ERegisteredCardFunction::OnOtherCardDestroyed"],"hasBlitz":true,"hasGuard":true,"spawnCardName":"card_unit_641st_rifles_vet","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/641st_RIFLES.641st_RIFLES","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_641st_rifles_photo","SourceString":"Red Army artillery crew during the East Pomeranian offensive, 1945.","LocalizedString":"Red Army artillery crew during the East Pomeranian offensive, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"customName1":"endofturn2","isDefenseBuff":true},"variables":[{"name":"tempCard","type":"UBaseCardObject*","direction":"in"},{"name":"hasKilledThisTurn","type":"bool","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_641st_rifles","owner":"card_unit_641st_rifles_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"K2Node_Event_turnnumber","type":"int32","direction":"in"},{"na