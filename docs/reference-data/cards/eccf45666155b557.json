{"format":"kards-original-reference","version":1,"id":"eccf45666155b557","name":"card_unit_103rd_cavalry_recon","package":"/Game/Blueprints/Cards/USA/CovertOp/units/card_unit_103rd_cavalry_recon","parent":"UBaseCardObject","card":{"title":"103rd CAVALRY RECON","text":"Reveal: Your units get +1+1 if this unit was Covert for 2 or more turns.","flavorText":"The 103rd Cavalry Reconnaissance Troop was a mechanized unit of the 103rd Infantry Division, nicknamed “Cactus Division” of the US Army. The division served in the US Seventh Army of the 6th Army Group during WWII. It was ordered into active service in November 1942 to undergo training. In 1944, the division underwent significant changes as it lost 2,550 enlisted men through transfers, and refilled its ranks with personnel from various units and training programs. In October 1944 the 103rd Division arrived in Marseille, France, and what followed was intense combat. The division managed to capture the towns of Saint-Dié and Sélestat near the German border, and then penetrated the defenses of the Siegfried Line. Under the command of General Anthony \"Nuts\" McAuliffe, from January to July 1945, the division continued its offensive, liberating the Kaufering concentration camp in Landsberg and advancing through Germany and Austria. After the Armistice in Europe, the division assumed occupational duties until its return to the United States on September 10th, 1945, and inactivation on September 22nd, 1945.","faction":"USA","type":"infantry","rarity":"Common","cost":3,"operationCost":1,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_103rd_cavalry_recon","title":{"Namespace":"card_usa","Key":"card_unit_103rd_cavalry_recon_title","SourceString":"103rd CAVALRY RECON","LocalizedString":"103rd CAVALRY RECON"},"Type":"ETypeEnum::infantry","attack":3,"defense":4,"range":1,"faction":"EFactionEnum::USA","kredits":3,"Text":{"Namespace":"card_usa","Key":"card_unit_103rd_cavalry_recon_text","SourceString":"Reveal: Your units get +1+1 if this unit was Covert for 2 or more turns.","LocalizedString":"Reveal: Your units get +1+1 if this unit was Covert for 2 or more turns."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_103rd_cavalry_recon_history","SourceString":"The 103rd Cavalry Reconnaissance Troop was a mechanized unit of the 103rd Infantry Division, nicknamed “Cactus Division” of the US Army. The division served in the US Seventh Army of the 6th Army Group during WWII. It was ordered into active service in November 1942 to undergo training. In 1944, the division underwent significant changes as it lost 2,550 enlisted men through transfers, and refilled its ranks with personnel from various units and training programs. In October 1944 the 103rd Division arrived in Marseille, France, and what followed was intense combat. The division managed to capture the towns of Saint-Dié and Sélestat near the German border, and then penetrated the defenses of the Siegfried Line. Under the command of General Anthony \"Nuts\" McAuliffe, from January to July 1945, the division continued its offensive, liberating the Kaufering concentration camp in Landsberg and advancing through Germany and Austria. After the Armistice in Europe, the division assumed occupational duties until its return to the United States on September 10th, 1945, and inactivation on September 22nd, 1945.","LocalizedString":"The 103rd Cavalry Reconnaissance Troop was a mechanized unit of the 103rd Infantry Division, nicknamed “Cactus Division” of the US Army. The division served in the US Seventh Army of the 6th Army Group during WWII. It was ordered into active service in November 1942 to undergo training. In 1944, the division underwent significant changes as it lost 2,550 enlisted men through transfers, and refilled its ranks with personnel from various units and training programs. In October 1944 the 103rd Division arrived in Marseille, France, and what followed was intense combat. The division managed to capture the towns of Saint-Dié and Sélestat near the German border, and then penetrated the defenses of the Siegfried Line. Under the command of General Anthony \"Nuts\" McAuliffe, from January to July 1945, the division continued its offensive, liberating the Kaufering concentration camp in Landsberg and advancing through Germany and Austria. After the Armistice in Europe, the division assumed occupational duties until its return to the United States on September 10th, 1945, and inactivation on September 22nd, 1945."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::CurrentExpansion","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Trigger"],"draftBaseWeight":0.9,"hasCovert":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/CandidateArtwork/Summer_24/t_103rd_cavalry_recon.t_103rd_cavalry_recon","SubPathString":""},"artist":"Rebellion","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/103rd_CAVALRY_RECON.103rd_CAVALRY_RECON","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":391.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_103rd_cavalry_recon_photo","SourceString":"A German soldier surrendering to soldiers of the 103rd Infantry Division in Austria. May 1st, 1945.","LocalizedString":"A German soldier surrendering to soldiers of the 103rd Infantry Division in Austria. May 1st, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"visualCardWeight":"EVisualCardWeight::Light"}