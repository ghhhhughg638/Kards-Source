{"format":"kards-original-reference","version":1,"id":"5c6af81446bf5508","name":"card_unit_a20_havoc","package":"/Game/Blueprints/Cards/USA/Base/units/card_unit_a20_havoc","parent":"UBaseCardObject","card":{"title":"A-20 HAVOC","text":"Deployment: Your bombers operate for 2 less this turn.","flavorText":"The Douglas A-20 Havoc was an American light bomber, intruder, and reconnaissance aircraft used in WWII by the United States Army Air Force (USAAF) and several Allied air forces. The A-20 variant was ordered by the USAAF for high-altitude bombing and performed well as such. The first operation involving A-20 Havoc bombers took place in 1942, when several of them engaged in an attack from Port Moresby against Japanese positions further north in Australian Papua on the island of New Guinea. By 1944, 370 A-20 Havoc bombers were in active duty with the Fifth Air Force who deployed them in the Allied campaigns in the South Pacific, both as low altitude bombers and ground attack aircraft.","faction":"USA","type":"bomber","rarity":"Common","cost":4,"operationCost":2,"attack":2,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_a20_havoc","title":{"Namespace":"card_usa","Key":"card_unit_a20_havoc_title","SourceString":"A-20 HAVOC","LocalizedString":"A-20 HAVOC"},"Type":"ETypeEnum::bomber","attack":2,"defense":2,"range":2,"faction":"EFactionEnum::USA","kredits":4,"Text":{"Namespace":"card_usa","Key":"card_unit_a20_havoc_text","SourceString":"Deployment: Your bombers operate for 2 less this turn.","LocalizedString":"Deployment: Your bombers operate for 2 less this turn."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_a20_havoc_history","SourceString":"The Douglas A-20 Havoc was an American light bomber, intruder, and reconnaissance aircraft used in WWII by the United States Army Air Force (USAAF) and several Allied air forces. The A-20 variant was ordered by the USAAF for high-altitude bombing and performed well as such. The first operation involving A-20 Havoc bombers took place in 1942, when several of them engaged in an attack from Port Moresby against Japanese positions further north in Australian Papua on the island of New Guinea. By 1944, 370 A-20 Havoc bombers were in active duty with the Fifth Air Force who deployed them in the Allied campaigns in the South Pacific, both as low altitude bombers and ground attack aircraft.","LocalizedString":"The Douglas A-20 Havoc was an American light bomber, intruder, and reconnaissance aircraft used in WWII by the United States Army Air Force (USAAF) and several Allied air forces. The A-20 variant was ordered by the USAAF for high-altitude bombing and performed well as such. The first operation involving A-20 Havoc bombers took place in 1942, when several of them engaged in an attack from Port Moresby against Japanese positions further north in Australian Papua on the island of New Guinea. By 1944, 370 A-20 Havoc bombers were in active duty with the Fifth Air Force who deployed them in the Allied campaigns in the South Pacific, both as low altitude bombers and ground attack aircraft."},"operationCost":2,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Basic","isInPermanentPool":true,"usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Blitz","EHelpBubbleTypes::Deployment"],"suppressionExceptionTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"hasDeployment":true,"hasBlitz":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/t_a20_havoc.t_a20_havoc","SubPathString":""},"artist":"Nicolas Trudgian","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/A-20_HAVOC.A-20_HAVOC","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":311.0},"historyPhotoSource":"USAF Museum website","historyPhotoIdentificationCode":"051118-F-1234P-041","historyPhotoAuthor":"USAAF ","histor