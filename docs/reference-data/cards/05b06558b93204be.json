{"format":"kards-original-reference","version":1,"id":"05b06558b93204be","name":"card_unit_me_410_hornisse","package":"/Game/Blueprints/Cards/Germany/Breakthrough/units/card_unit_me_410_hornisse","parent":"UBaseCardObject","card":{"title":"ME 410 HORNISSE","text":"At the start of your turn, draw a card. Deal damage equal to its cost to the enemy HQ.","flavorText":"The Messerschmitt Me 410 Hornisse (e. Hornet) was a German heavy fighter, used by the Luftwaffe in WWII. The aircraft was produced from 1943 to 1944 and was an improved version of the Me 220 that was renamed to Me 410. Shortly after the Me 410 came into service it was used against British aircraft and was moderately successful against unescorted bombers. Later it would be used as a bomber destroyer but it proved to be extremely vulnerable against British and American fighters. In 1944 production ceased and the Me 410 would be used in reconnaissance missions only. In total 1,160 units were produced, including a few variants.","faction":"Germany","type":"fighter","rarity":"Unique","cost":7,"operationCost":2,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_me_410_hornisse","title":{"Namespace":"card_germany","Key":"card_unit_me_410_hornisse_title","SourceString":"ME 410 HORNISSE","LocalizedString":"ME 410 HORNISSE"},"Type":"ETypeEnum::fighter","attack":3,"defense":4,"range":2,"faction":"EFactionEnum::Germany","kredits":7,"Text":{"Namespace":"card_germany","Key":"card_unit_me_410_hornisse_text","SourceString":"At the start of your turn, draw a card. Deal damage equal to its cost to the enemy HQ.","LocalizedString":"At the start of your turn, draw a card. Deal damage equal to its cost to the enemy HQ."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_me_410_hornisse_history","SourceString":"The Messerschmitt Me 410 Hornisse (e. Hornet) was a German heavy fighter, used by the Luftwaffe in WWII. The aircraft was produced from 1943 to 1944 and was an improved version of the Me 220 that was renamed to Me 410. Shortly after the Me 410 came into service it was used against British aircraft and was moderately successful against unescorted bombers. Later it would be used as a bomber destroyer but it proved to be extremely vulnerable against British and American fighters. In 1944 production ceased and the Me 410 would be used in reconnaissance missions only. In total 1,160 units were produced, including a few variants.","LocalizedString":"The Messerschmitt Me 410 Hornisse (e. Hornet) was a German heavy fighter, used by the Luftwaffe in WWII. The aircraft was produced from 1943 to 1944 and was an improved version of the Me 220 that was renamed to Me 410. Shortly after the Me 410 came into service it was used against British aircraft and was moderately successful against unescorted bombers. Later it would be used as a bomber destroyer but it proved to be extremely vulnerable against British and American fighters. In 1944 production ceased and the Me 410 would be used in reconnaissance missions only. In total 1,160 units were produced, including a few variants."},"operationCost":2,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::Breakthrough","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/CandidateArtwork/WE_Candidates/t_me_410.t_me_410","SubPathString":""},"artist":"Marii Chernev","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/ME_410_HORNISSE.ME_410_HORNISSE","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":239.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_me_410_hornisse_photo","SourceString":"Me 410 Hornisse aircraft in flight, ca. 1942-1944","LocalizedString":"Me 410 Hornisse aircraft in flight, ca. 19