{"format":"kards-original-reference","version":1,"id":"caf5cd21caea7474","name":"card_event_naval_battle","package":"/Game/Blueprints/Cards/USA/OceaniaStorm/events/card_event_naval_battle","parent":"UBaseCardObject","card":{"title":"NAVAL BATTLE","text":"Choose One - Destroy all units with an odd cost OR even cost.","flavorText":"The Battle of Sunda Strait was fought on the night of 28 February to 1 March 1942, as Japanese forces moved to invade Java in the Dutch East Indies. After the defeat in Battle of the Java Sea, the American heavy cruiser USS Houston and the Australian light cruiser HMAS Perth reached Tanjung Priok, then received orders to sail through Sunda Strait toward Tjilatjap. The Dutch destroyer HNLMS Evertsen followed behind. The Allied ships expected only friendly patrol craft in the strait. Instead, they ran into a large Japanese invasion convoy entering Bantam Bay, escorted by destroyers, cruisers, and other warships. The battle began after Perth challenged a ship near Saint Nicolaas Point and received the wrong reply. Japanese torpedoes and gunfire soon filled the night. Houston and Perth fought while trying to force a path westward, even firing into the transport group, but they were surrounded and badly outnumbered. Both cruisers were sunk after midnight. Some Japanese ships were also lost, several to friendly fire. Houston’s captain, Albert H. Rooks, was killed and received the Medal of Honor posthumously.","faction":"USA","type":"order","rarity":"Unique","cost":7,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_naval_battle","title":{"Namespace":"card_usa","Key":"card_event_naval_battle_title","SourceString":"NAVAL BATTLE","LocalizedString":"NAVAL BATTLE"},"Type":"ETypeEnum::order","faction":"EFactionEnum::USA","kredits":7,"Text":{"Namespace":"card_usa","Key":"card_event_naval_battle_text","SourceString":"Choose One - Destroy all units with an odd cost OR even cost.","LocalizedString":"Choose One - Destroy all units with an odd cost OR even cost."},"flavorText":{"Namespace":"card_usa","Key":"card_event_naval_battle_history","SourceString":"The Battle of Sunda Strait was fought on the night of 28 February to 1 March 1942, as Japanese forces moved to invade Java in the Dutch East Indies. After the defeat in Battle of the Java Sea, the American heavy cruiser USS Houston and the Australian light cruiser HMAS Perth reached Tanjung Priok, then received orders to sail through Sunda Strait toward Tjilatjap. The Dutch destroyer HNLMS Evertsen followed behind. The Allied ships expected only friendly patrol craft in the strait. Instead, they ran into a large Japanese invasion convoy entering Bantam Bay, escorted by destroyers, cruisers, and other warships. The battle began after Perth challenged a ship near Saint Nicolaas Point and received the wrong reply. Japanese torpedoes and gunfire soon filled the night. Houston and Perth fought while trying to force a path westward, even firing into the transport group, but they were surrounded and badly outnumbered. Both cruisers were sunk after midnight. Some Japanese ships were also lost, several to friendly fire. Houston’s captain, Albert H. Rooks, was killed and received the Medal of Honor posthumously.","LocalizedString":"The Battle of Sunda Strait was fought on the night of 28 February to 1 March 1942, as Japanese forces moved to invade Java in the Dutch East Indies. After the defeat in Battle of the Java Sea, the American heavy cruiser USS Houston and the Australian light cruiser HMAS Perth reached Tanjung Priok, then received orders to sail through Sunda Strait toward Tjilatjap. The Dutch destroyer HNLMS Evertsen followed behind. The Allied ships expected only friendly patrol craft in the strait. Instead, they ran into a large Japanese invasion convoy entering Bantam Bay, escorted by destroyers, cruisers, and other warships. The battle began after Perth challenged a ship near Saint Nicolaas Point and received the wrong reply. Japanese torpedoes and gunfire soon filled the night. Houston and Perth fought while trying to force a path westward, even firing into the transport group, but they were surrounded and badly outnumbered. Both cruisers were sunk after midnight. Some Japanese ships were also lost, several to friendly fire. Houston’s captain, Albert H. Rooks, was killed and received the Medal of Honor posthumously."},"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::OceaniaStorm","chooseOneCards":[{"cardText":{"Namespace":"","Key":"B095CDA64D55B7F50A9927AD706D78EF","SourceString":"Destroy all units with an odd cost.","LocalizedString":"Destroy all units with an odd cost."},"selectTargetOnPlayedFromHand":false},{"cardText":{"Namespace":"","Key":"94763CFB498E49695EFB89B7D6FA1720","SourceString":"Destroy all units with an even cost.","LocalizedString":"Destroy all units with an even cost."},"selectTargetOnPlayedFromHand":false}],"soundEnterPlay":{"ObjectName":"SoundWave'NAVAL_SUPPORT'","ObjectPath":"kards/Content/Assets/Audio/Misc/NAVAL_SUPPORT.0"},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/NAVAL_BATTLE.NAVAL_BATTLE","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_event_naval_battle_photo","SourceString":"The Royal Navy cruiser HMS Exeter and the Australian cruiser HMAS Hobart under aerial attack by Japanese aircraft during the Battle of Sunda Strait.","LocalizedString":"The Royal Navy cruiser HMS Exeter and the Australian cruiser HMAS Hobart under aerial attack by Japanese aircraft during the Battle of Sunda Strait."},"OnPlayedFromHandVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_OrderDiveBomber.BP_OrderDiveBomber_C","SubPathString":""},"isRemoval":true},"variables":[{"name":"cardsToDestroy","type":"TArray<int32>","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_naval_battle","owner":"card_event_naval_battle_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":f