{"format":"kards-original-reference","version":1,"id":"18ae44b79bec30f8","name":"card_unit_isu_152","package":"/Game/Blueprints/Cards/Soviet/Base/units/card_unit_isu_152","parent":"UBaseCardObject","card":{"title":"ISU-152","text":"Deployment: Destroy all other damaged units.","flavorText":"The ISU-152 was a self propelled gun developed and used by the Soviet Army in WWII. It was nicknamed the \"beast killer\" in response to German tanks bearing names such as Tiger and Panther. The ISU-152 had no turret, so repositioning the gun required turning the tank itself. Due to this it was often used as mobile artillery to support more mobile infantry and armor attacks. The  ISU-152 had a crew of 5 (driver, commander, gunner, breech operator and loader), a main armament of 152.4 mm ML-20S gun-howitzer and a secondary armament of 12.7 x 108 mm DShK anti-aircraft machine gun.","faction":"Soviet","type":"tank","rarity":"Unique","cost":9,"operationCost":3,"attack":6,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_isu_152","title":{"Namespace":"card_soviet","Key":"card_unit_isu_152_title","SourceString":"ISU-152","LocalizedString":"ISU-152"},"Type":"ETypeEnum::tank","attack":6,"defense":4,"range":1,"faction":"EFactionEnum::Soviet","kredits":9,"Text":{"Namespace":"card_soviet","Key":"card_unit_isu_152_text","SourceString":"Deployment: Destroy all other damaged units.","LocalizedString":"Deployment: Destroy all other damaged units."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_isu_152_history","SourceString":"The ISU-152 was a self propelled gun developed and used by the Soviet Army in WWII. It was nicknamed the \"beast killer\" in response to German tanks bearing names such as Tiger and Panther. The ISU-152 had no turret, so repositioning the gun required turning the tank itself. Due to this it was often used as mobile artillery to support more mobile infantry and armor attacks. The  ISU-152 had a crew of 5 (driver, commander, gunner, breech operator and loader), a main armament of 152.4 mm ML-20S gun-howitzer and a secondary armament of 12.7 x 108 mm DShK anti-aircraft machine gun.","LocalizedString":"The ISU-152 was a self propelled gun developed and used by the Soviet Army in WWII. It was nicknamed the \"beast killer\" in response to German tanks bearing names such as Tiger and Panther. The ISU-152 had no turret, so repositioning the gun required turning the tank itself. Due to this it was often used as mobile artillery to support more mobile infantry and armor attacks. The  ISU-152 had a crew of 5 (driver, commander, gunner, breech operator and loader), a main armament of 152.4 mm ML-20S gun-howitzer and a secondary armament of 12.7 x 108 mm DShK anti-aircraft machine gun."},"operationCost":3,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::Basic","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::HeavyArmor2","EHelpBubbleTypes::Deployment"],"hasDeployment":true,"heavyArmor":2,"soundEnterPlay":{"ObjectName":"SoundWave'Tank_Heavy_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Heavy_Move_Fx.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Tank_Heavy_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Heavy_Move_Fx.0"},"soundAttack":{"ObjectName":"SoundWave'Heavy_artillery_2'","ObjectPath":"kards/Content/ExplosionSoundPack/ExplosionSounds/Wavs/Heavy_artillery_2.0"},"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Armor_Large_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Armor_Large_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/t_isu_temp.t_isu_temp","SubPathString":""},"artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/ISU_152.ISU_152","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":306.0},"historyPhotoSource":"http://wio.ru/","historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_isu_152_photo","SourceString":"Soviet ISU-152, date unknown.","LocalizedString