{"format":"kards-original-reference","version":1,"id":"3bdc4e929b8ab828","name":"card_event_white_death","package":"/Game/Blueprints/Cards/Finland/events/card_event_white_death","parent":"UBaseCardObject","card":{"title":"THE WHITE DEATH","text":"Suppress all enemy units. Add a SISSI to your support line with Blitz.","flavorText":"Simo Häyhä, known as \"The White Death,\" was a Finnish sniper during WWII, specifically the 1939–1940 Winter War against the Soviet Union. He used a Finnish M/28-30 rifle and a Suomi KP/-31 submachine gun. Häyhä is credited with over 500 kills during this conflict, making him the deadliest sniper in any major war. He chronicled his experiences in a private memoir titled \"Sotamuistoja\" (War memoirs) written in 1940, shortly after being wounded. This memoir, hidden for many years, was discovered in 2017. The name \"White Death\" has been suggested to originate entirely in Finnish propaganda, rather than having been given to Häyhä by Soviet soldiers, to whom at the time \"White Death\" generally referred to a severe frost in the deep forests of Finland. Häyhä having the nickname \"White Death\" first appeared in the Finnish Winter War literature of the late 1980s, but during the war, the \"White Death\" was one of the leading themes of Finnish propaganda. Finnish newspapers frequently featured the invisible Finnish soldier, thus creating a hero of mythical proportions. But even though Simo Häyhä’s nickname can be debated, he is widely regarded as the most skilled and successful sniper there ever was.","faction":"Finland","type":"order","rarity":"Rare","cost":4,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_white_death","title":{"Namespace":"card_finland","Key":"card_event_white_death_title","SourceString":"THE WHITE DEATH","LocalizedString":"THE WHITE DEATH"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Finland","kredits":4,"Text":{"Namespace":"card_finland","Key":"card_event_white_death_text","SourceString":"Suppress all enemy units. Add a SISSI to your support line with Blitz.","LocalizedString":"Suppress all enemy units. Add a SISSI to your support line with Blitz."},"flavorText":{"Namespace":"card_finland","Key":"card_event_white_death_history","SourceString":"Simo Häyhä, known as \"The White Death,\" was a Finnish sniper during WWII, specifically the 1939–1940 Winter War against the Soviet Union. He used a Finnish M/28-30 rifle and a Suomi KP/-31 submachine gun. Häyhä is credited with over 500 kills during this conflict, making him the deadliest sniper in any major war. He chronicled his experiences in a private memoir titled \"Sotamuistoja\" (War memoirs) written in 1940, shortly after being wounded. This memoir, hidden for many years, was discovered in 2017. The name \"White Death\" has been suggested to originate entirely in Finnish propaganda, rather than having been given to Häyhä by Soviet soldiers, to whom at the time \"White Death\" generally referred to a severe frost in the deep forests of Finland. Häyhä having the nickname \"White Death\" first appeared in the Finnish Winter War literature of the late 1980s, but during the war, the \"White Death\" was one of the leading themes of Finnish propaganda. Finnish newspapers frequently featured the invisible Finnish soldier, thus creating a hero of mythical proportions. But even though Simo Häyhä’s nickname can be debated, he is widely regarded as the most skilled and successful sniper there ever was.","LocalizedString":"Simo Häyhä, known as \"The White Death,\" was a Finnish sniper during WWII, specifically the 1939–1940 Winter War against the Soviet Union. He used a Finnish M/28-30 rifle and a Suomi KP/-31 submachine gun. Häyhä is credited with over 500 kills during this conflict, making him the deadliest sniper in any major war. He chronicled his experiences in a private memoir titled \"Sotamuistoja\" (War memoirs) written in 1940, shortly after being wounded. This memoir, hidden for many years, was discovered in 2017. The name \"White Death\" has been suggested to originate entirely in Finnish propaganda, rather than having been given to Häyhä by Soviet soldiers, to whom at the time \"White Death\" generally referred to a severe frost in the deep forests of Finland. Häyhä having the nickname \"White Death\" first appeared in the Finnish Winter War literature of the late 1980s, but during the war, the \"White Death\" was one of the leading themes of Finnish propaganda. Finnish newspapers frequently featured the invisible Finnish soldier, thus creating a hero of mythical proportions. But even though Simo Häyhä’s nickname can be debated, he is widely regarded as the most skilled and successful sniper there ever was."},"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::WinterWar","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Suppress"],"draftBaseWeight":0.8,"spawnCardName":"card_unit_sissi","soundEnterPlay":{"ObjectName":"SoundWave'Eagle_Claws'","ObjectPath":"kards/Content/Assets/Audio/Misc/Eagle_Claws.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Finland/t_the_white_death.t_the_white_death","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/WHITE_DEATH.WHITE_DEATH","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":338.0},"historyPhotoDescription":{"Namespace":"card_finland","Key":"card_event_white_death_photo","SourceString":"Simo Häyhä posing with his winter camouflage, 1940.","LocalizedString":"Simo Häyhä posing with his winter camouflage, 1940."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"isDirectDamage":true},"variables":[{"name":"cardsToSuppress","type":"TArray<int32>","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_white_death","owner":"card_event_white_death_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"e