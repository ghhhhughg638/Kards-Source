{"format":"kards-original-reference","version":1,"id":"acbb8705236eef26","name":"card_unit_112th_infantry_regiment","package":"/Game/Blueprints/Cards/USA/WorldAtWar/units/card_unit_112th_infantry_regiment","parent":"UBaseCardObject","card":{"title":"112th INFANTRY REGIMENT","text":"Has +2 attack for each adjacent unit.","flavorText":"The 112th Infantry Regiment of the US Army dates back to the American Civil war and has since participated in several conflicts, including WWI and WWII. During WWII the regiment landed in Normandy in 1944, after D-Day, where it became the 112th Infantry Regimental Combat Team (RCT). Apart from the infantry the RCT included several support units, the 229th Field Artillery Battalion, the 103rd Engineer Battalion, Company C, 447th Antiaircraft Artillery Battalion, and Company C, 630th Tank Destroyer Battalion. After Normandy the 112th participated in the liberation of Paris and later the Battle of Hürtgen Forest (19 September to 16 December 1944) where the regiment was at one point reduced to 300 men during an engagement. The US soldiers nicknamed the Battle for Hürtgen Forest “the meat grinder”, and for good reason since it is the longest single battle US forces have ever fought and one of the bloodiest. Following Hürtgen Forest the 112th RCT fought in the Battle of the Bulge, where it defended a sector of 100 km where 9 German divisions concentrated their attacks. During the Battle of the Bulge the 112th RCT managed to inflict 1600 casualties and destroy 18 enemy tanks, for which it received the Distinguished Unit Citation which is rewarded for extraordinary heroism in action.","faction":"USA","type":"infantry","rarity":"Common","cost":1,"operationCost":1,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_112th_infantry_regiment","title":{"Namespace":"card_usa","Key":"card_unit_112th_infantry_regiment_title","SourceString":"112th INFANTRY REGIMENT","LocalizedString":"112th INFANTRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":1,"defense":2,"range":1,"faction":"EFactionEnum::USA","kredits":1,"Text":{"Namespace":"card_usa","Key":"card_unit_112th_infantry_regiment_text","SourceString":"Has +2 attack for each adjacent unit.","LocalizedString":"Has +2 attack for each adjacent unit."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_112th_infantry_regiment_history","SourceString":"The 112th Infantry Regiment of the US Army dates back to the American Civil war and has since participated in several conflicts, including WWI and WWII. During WWII the regiment landed in Normandy in 1944, after D-Day, where it became the 112th Infantry Regimental Combat Team (RCT). Apart from the infantry the RCT included several support units, the 229th Field Artillery Battalion, the 103rd Engineer Battalion, Company C, 447th Antiaircraft Artillery Battalion, and Company C, 630th Tank Destroyer Battalion. After Normandy the 112th participated in the liberation of Paris and later the Battle of Hürtgen Forest (19 September to 16 December 1944) where the regiment was at one point reduced to 300 men during an engagement. The US soldiers nicknamed the Battle for Hürtgen Forest “the meat grinder”, and for good reason since it is the longest single battle US forces have ever fought and one of the bloodiest. Following Hürtgen Forest the 112th RCT fought in the Battle of the Bulge, where it defended a sector of 100 km where 9 German divisions concentrated their attacks. During the Battle of the Bulge the 112th RCT managed to inflict 1600 casualties and destroy 18 enemy tanks, for which it received the Distinguished Unit Citation which is rewarded for extraordinary heroism in action.","LocalizedString":"The 112th Infantry Regiment of the US Army dates back to the American Civil war and has since participated in several conflicts, including WWI and WWII. During WWII the regiment landed in Normandy in 1944, after D-Day, where it became the 112th Infantry Regimental Combat Team (RCT). Apart from the infantry the RCT included several support units, the 229th Field Artillery Battalion, the 103rd Engineer Battalion, Company C, 447th Antiaircraft Artillery Battalion, and Company C, 630th Tank Destroyer Battalion. After Normandy the 112th participated in the liberation of Paris and later the Battle of Hürtgen Forest (19 September to 16 December 1944) where the regiment was at one point reduced to 300 men during an engagement. The US soldiers nicknamed the Battle for Hürtgen Forest “the meat grinder”, and for good reason since it is the longest single battle US forces have ever fought and one of the bloodiest. Following Hürtgen Forest the 112th RCT fought in the Battle of the Bulge, where it defended a sector of 100 km where 9 German divisions concentrated their attacks. During the Battle of the Bulge the 112th RCT managed to inflict 1600 casualties and destroy 18 enemy tanks, for which it received the Distinguished Unit Citation which is rewarded for extraordinary heroism in action."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::WorldAtWar","isReserved":true,"EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardLocationMoved"],"soundEnterPlay":{"ObjectName":"SoundWave'Infantry_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Infantry_Move_FX.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Infantry_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Infantry_Move_FX.0"},"soundAttack":{"ObjectName":"SoundWave'AU_infantry_small_fire_02'","ObjectPath":"kards/Content/Assets/Audio/Projectiles_and_Impacts/Infantry/AU_infantry_small_fire_02.0"},"soundBlowUp":{"ObjectName":"SoundCue'explosion_small_01_Cue'","ObjectPath":"kards/Content/ExplosionSoundPack/ExplosionSounds/Cues/explosion_small_01_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/CandidateArtwork/t_use_inf_waw_4.t_use_inf_waw_4","SubPathString":""},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos