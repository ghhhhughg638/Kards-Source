{"format":"kards-original-reference","version":1,"id":"54c8334ec01a2656","name":"card_unit_ki_61_tony","package":"/Game/Blueprints/Cards/Japan/Allegiance/units/card_unit_ki_61_tony","parent":"UBaseCardObject","card":{"title":"Ki-61-II TONY","text":"Spend 7 kredits at the end of enemy turn and add it to the battlefield.","flavorText":"The Kawasaki Ki-61 Hien (e. flying swallow) was a Japanese fighter aircraft used by the Imperial Japanese Air Service during WWII. It was first introduced in 1942 and used in front line service throughout the war. It took some time for the Allied pilots to identify the aircraft, first they mistook it for the German Messerschmitt Bf 109s and later the Italian Macchi C.202 which led to the Allied codename “Tony”. The Ki-61-II variant was introduced in 1943 and had a more powerful engine than its predecessor. Later variants would focus on increasing the speed and firepower. A total of 3,078 aircraft were built.","faction":"Japan","type":"fighter","rarity":"Uncommon","cost":6,"operationCost":3,"attack":5,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_ki_61_tony","title":{"Namespace":"card_japan","Key":"card_unit_ki_61_tony_title","SourceString":"Ki-61-II TONY","LocalizedString":"Ki-61-II TONY"},"Type":"ETypeEnum::fighter","attack":5,"defense":4,"range":2,"faction":"EFactionEnum::Japan","kredits":6,"Text":{"Namespace":"card_japan","Key":"card_unit_ki_61_tony_text","SourceString":"Spend 7 kredits at the end of enemy turn and add it to the battlefield.","LocalizedString":"Spend 7 kredits at the end of enemy turn and add it to the battlefield."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_ki_61_tony_history","SourceString":"The Kawasaki Ki-61 Hien (e. flying swallow) was a Japanese fighter aircraft used by the Imperial Japanese Air Service during WWII. It was first introduced in 1942 and used in front line service throughout the war. It took some time for the Allied pilots to identify the aircraft, first they mistook it for the German Messerschmitt Bf 109s and later the Italian Macchi C.202 which led to the Allied codename “Tony”. The Ki-61-II variant was introduced in 1943 and had a more powerful engine than its predecessor. Later variants would focus on increasing the speed and firepower. A total of 3,078 aircraft were built.","LocalizedString":"The Kawasaki Ki-61 Hien (e. flying swallow) was a Japanese fighter aircraft used by the Imperial Japanese Air Service during WWII. It was first introduced in 1942 and used in front line service throughout the war. It took some time for the Allied pilots to identify the aircraft, first they mistook it for the German Messerschmitt Bf 109s and later the Italian Macchi C.202 which led to the Allied codename “Tony”. The Ki-61-II variant was introduced in 1943 and had a more powerful engine than its predecessor. Later variants would focus on increasing the speed and firepower. A total of 3,078 aircraft were built."},"operationCost":3,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Expansion2019","returnSet":"ECardSetEnum::Homefront","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Blitz"],"draftBaseWeight":1.2,"hasBlitz":true,"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/t_tony_2.t_tony_2","SubPathString":""},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/Ki-61-II_TONY.Ki-61-II_TONY","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":344.0},"historyPhotoSource":"https://www.flickr.com/photos/sdasmarchives/21607868101","historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_ki_61_tony_photo","SourceString":"Kawasaki Ki-61-II Hien, date unknown.","LocalizedString":"Kawasaki Ki-61-II Hien, date unknown."},"historyTypeDescription":{"Namespace":"card_japan","Key":"card_unit_ki_6