{"format":"kards-original-reference","version":1,"id":"e89a4d8e418242da","name":"card_unit_la_division_leclerc","package":"/Game/Blueprints/Cards/France/units/card_unit_la_division_leclerc","parent":"UBaseCardObject","card":{"title":"LA DIVISION LECLERC","text":"Gets +3+3 the first time you shuffle your deck each turn.","flavorText":"La Division Leclerc refers to the troops of the Free French Forces regrouped under the command of General Leclerc. It was initially named Leclerc Column, and won its first victory against the Italians at the Battle of Kufra, Libya, in February 1941. At the end of the battle, the French made the “Oath of Kufra”, swearing to “not lay down our arms until our colors, our beautiful colors, fly over Strasbourg Cathedral.\" The Column distinguished itself in Libya and during the Tunisian campaign in 1942 and 1943, and was expanded and transformed into the 2nd Armored Division (French: 2e Division Blindée, or 2e DB) in August 1943, and equipped with modern American military equipment. They fought in the Battle of Normandy from August 1944, and they were the first Allied unit to enter Paris, on August 24. Then they took part in fierce fighting in Lorraine and Alsace, and liberated Strasbourg on 23 November 1944, fulfilling their oath. The Division Leclerc pushed the offensive into Germany and ended the war at the “Eagle’s Nest”, at Berchtesgaden in the Bavarian Alps.","faction":"France","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":2,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_la_division_leclerc","title":{"Namespace":"card_france","Key":"card_unit_la_division_leclerc_title","SourceString":"LA DIVISION LECLERC","LocalizedString":"LA DIVISION LECLERC"},"Type":"ETypeEnum::infantry","attack":3,"defense":3,"range":1,"faction":"EFactionEnum::France","kredits":3,"Text":{"Namespace":"card_france","Key":"card_unit_la_division_leclerc_text","SourceString":"Gets +3+3 the first time you shuffle your deck each turn.","LocalizedString":"Gets +3+3 the first time you shuffle your deck each turn."},"flavorText":{"Namespace":"card_france","Key":"card_unit_la_division_leclerc_history","SourceString":"La Division Leclerc refers to the troops of the Free French Forces regrouped under the command of General Leclerc. It was initially named Leclerc Column, and won its first victory against the Italians at the Battle of Kufra, Libya, in February 1941. At the end of the battle, the French made the “Oath of Kufra”, swearing to “not lay down our arms until our colors, our beautiful colors, fly over Strasbourg Cathedral.\" The Column distinguished itself in Libya and during the Tunisian campaign in 1942 and 1943, and was expanded and transformed into the 2nd Armored Division (French: 2e Division Blindée, or 2e DB) in August 1943, and equipped with modern American military equipment. They fought in the Battle of Normandy from August 1944, and they were the first Allied unit to enter Paris, on August 24. Then they took part in fierce fighting in Lorraine and Alsace, and liberated Strasbourg on 23 November 1944, fulfilling their oath. The Division Leclerc pushed the offensive into Germany and ended the war at the “Eagle’s Nest”, at Berchtesgaden in the Bavarian Alps.","LocalizedString":"La Division Leclerc refers to the troops of the Free French Forces regrouped under the command of General Leclerc. It was initially named Leclerc Column, and won its first victory against the Italians at the Battle of Kufra, Libya, in February 1941. At the end of the battle, the French made the “Oath of Kufra”, swearing to “not lay down our arms until our colors, our beautiful colors, fly over Strasbourg Cathedral.\" The Column distinguished itself in Libya and during the Tunisian campaign in 1942 and 1943, and was expanded and transformed into the 2nd Armored Division (French: 2e Division Blindée, or 2e DB) in August 1943, and equipped with modern American military equipment. They fought in the Battle of Normandy from August 1944, and they were the first Allied unit to enter Paris, on August 24. Then they took part in fierce fighting in Lorraine and Alsace, and liberated Strasbourg on 23 November 1944, fulfilling their oath. The Division Leclerc pushed the offensive into Germany and ended the war at the “Eagle’s Nest”, at Berchtesgaden in the Bavarian Alps."},"operationCost":2,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::NavalWarfare","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnDeckShuffled","ERegisteredCardFunction::OnEndOfTurn"],"hasGuard":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/France/NavalWarfare/t_la_division_leclerc.t_la_division_leclerc","SubPathString":""},"artist":"French WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/DIVISION_LECLERC.DIVISION_LECLERC","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":320.0},"historyPhotoDescription":{"Namespace":"card_france","Key":"card_unit_la_division_leclerc_photo","SourceString":"Sherman tanks and soldiers of the French 2nd Armored Division (2e DB) advancing toward Strasbourg, Alsace, November 1944.","LocalizedString":"Sherman tanks and soldiers of the French 2nd Armored Division (2e DB) advancing toward Strasbourg, Alsace, November 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"threat_level":0.05},"variables":[{"name":"ShuffledThisTurn","type":"bool","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_la_division_leclerc","owner":"card_unit_la_division_leclerc_C","params":[{"name":"EntryPoi