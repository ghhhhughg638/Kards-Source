{"format":"kards-original-reference","version":1,"id":"88bc085d39b0a0be","name":"card_unit_128th_rifles","package":"/Game/Blueprints/Cards/Soviet/Breakthrough/units/card_unit_128th_rifles","parent":"UBaseCardObject","card":{"title":"128th RIFLES","text":"Pincer: Ambush.","flavorText":"The 128th Rifle Regiment was part of the 29th Rifle Division of the Red Army which was formed in 1920 during the Russian Civil War. In 1939 the division participated in the Soviet invasion of Poland and in  1941 it defended against the German invasion of Soviet Union in Operation Barbarossa. After being destroyed and reformed two times the division was ordered to Stalingrad where it joined the 64th Army in the defense of the city. After the Soviet victory at Stalingrad the division was redesignated the 72nd Guards Rifle Division for its distinguished service during the battle and the 128th Rifles Regiment became the 224th Guards Rifle Regiment. For the remainder of the war the division fought in several battles on the Eastern Front and lastly it participated in the Budapest Offensive where it ended the war in a captured area around the Slovakian city of Bruty near the Hungarian border. The division is still active today but was transferred to Ukraine after the fall of Soviet Union and is now known as the 72nd Mechanized Brigade of the Ukrainian Army.","faction":"Soviet","type":"infantry","rarity":"Common","cost":1,"operationCost":1,"attack":3,"defense":1},"defaults":{"UberGraphFrame":{},"Name":"card_unit_128th_rifles","title":{"Namespace":"card_soviet","Key":"card_unit_128th_rifles_title","SourceString":"128th RIFLES","LocalizedString":"128th RIFLES"},"Type":"ETypeEnum::infantry","attack":3,"defense":1,"range":1,"faction":"EFactionEnum::Soviet","kredits":1,"Text":{"Namespace":"card_soviet","Key":"card_unit_128th_rifles_text","SourceString":"Pincer: Ambush.","LocalizedString":"Pincer: Ambush."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_128th_rifles_history","SourceString":"The 128th Rifle Regiment was part of the 29th Rifle Division of the Red Army which was formed in 1920 during the Russian Civil War. In 1939 the division participated in the Soviet invasion of Poland and in  1941 it defended against the German invasion of Soviet Union in Operation Barbarossa. After being destroyed and reformed two times the division was ordered to Stalingrad where it joined the 64th Army in the defense of the city. After the Soviet victory at Stalingrad the division was redesignated the 72nd Guards Rifle Division for its distinguished service during the battle and the 128th Rifles Regiment became the 224th Guards Rifle Regiment. For the remainder of the war the division fought in several battles on the Eastern Front and lastly it participated in the Budapest Offensive where it ended the war in a captured area around the Slovakian city of Bruty near the Hungarian border. The division is still active today but was transferred to Ukraine after the fall of Soviet Union and is now known as the 72nd Mechanized Brigade of the Ukrainian Army.","LocalizedString":"The 128th Rifle Regiment was part of the 29th Rifle Division of the Red Army which was formed in 1920 during the Russian Civil War. In 1939 the division participated in the Soviet invasion of Poland and in  1941 it defended against the German invasion of Soviet Union in Operation Barbarossa. After being destroyed and reformed two times the division was ordered to Stalingrad where it joined the 64th Army in the defense of the city. After the Soviet victory at Stalingrad the division was redesignated the 72nd Guards Rifle Division for its distinguished service during the battle and the 128th Rifles Regiment became the 224th Guards Rifle Regiment. For the remainder of the war the division fought in several battles on the Eastern Front and lastly it participated in the Budapest Offensive where it ended the war in a captured area around the Slovakian city of Bruty near the Hungarian border. The division is still active today but was transferred to Ukraine after the fall of Soviet Union and is now known as the 72nd Mechanized Brigade of the Ukrainian Army."},"operationCost":1,"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Breakthrough","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Pincer","EHelpBubbleTypes::Ambush"],"hasPincer":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Small'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Small.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/WE_Candidates/t_soviet_inf_breakthrough_2.t_soviet_inf_breakthrough_2","SubPathString":""},"artist":"Soviet WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/128th_RIFLES.128th_RIFLES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":370.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_128th_rifles_photo","SourceString":"Mortar crew of the 29th Rifle Division, date unknown. ","LocalizedString":"Mortar crew of the 29th Rifle Division, date unknown. "},"historyTypeDescription":{"Namespace":"card_soviet","Key":"card_unit_128th_rifles_header","SourceString":"Infantry","LocalizedString":"Infantry"},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"CanPlayFromHand","owner":"card_unit_128th_rifles_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type"