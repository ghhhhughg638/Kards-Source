{"format":"kards-original-reference","version":1,"id":"879a8f282eb2b854","name":"card_unit_p47d_thunderbolt","package":"/Game/Blueprints/Cards/USA/Base/units/card_unit_p47d_thunderbolt","parent":"UBaseCardObject","card":{"title":"P-47D THUNDERBOLT","text":"When this unit destroys an enemy unit, draw a card.","flavorText":"The Republic P-47 Thunderbolt was an American fighter aircraft produced from 1941 to 1945 and used by the US Air force and Allied air forces during WWII. The Thunderbolt was effective as a short-to-medium range escort fighter in high-altitude air-to-air combat and ground attack in both the European and Pacific Theaters. The aircraft was equipped with a primary armament of eight .50-caliber machine guns and in the fighter-bomber ground-attack role it could carry five-inch rockets or a bomb load of 1,103 kg (2,500 pounds). By the end of the war 15,636 units had been built, including variants.","faction":"USA","type":"fighter","rarity":"Rare","cost":5,"operationCost":2,"attack":4,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_p47d_thunderbolt","title":{"Namespace":"card_usa","Key":"card_unit_p47d_thunderbolt_title","SourceString":"P-47D THUNDERBOLT","LocalizedString":"P-47D THUNDERBOLT"},"Type":"ETypeEnum::fighter","attack":4,"defense":6,"range":2,"faction":"EFactionEnum::USA","kredits":5,"Text":{"Namespace":"card_usa","Key":"card_unit_p47d_thunderbolt_text","SourceString":"When this unit destroys an enemy unit, draw a card.","LocalizedString":"When this unit destroys an enemy unit, draw a card."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_p47d_thunderbolt_history","SourceString":"The Republic P-47 Thunderbolt was an American fighter aircraft produced from 1941 to 1945 and used by the US Air force and Allied air forces during WWII. The Thunderbolt was effective as a short-to-medium range escort fighter in high-altitude air-to-air combat and ground attack in both the European and Pacific Theaters. The aircraft was equipped with a primary armament of eight .50-caliber machine guns and in the fighter-bomber ground-attack role it could carry five-inch rockets or a bomb load of 1,103 kg (2,500 pounds). By the end of the war 15,636 units had been built, including variants.","LocalizedString":"The Republic P-47 Thunderbolt was an American fighter aircraft produced from 1941 to 1945 and used by the US Air force and Allied air forces during WWII. The Thunderbolt was effective as a short-to-medium range escort fighter in high-altitude air-to-air combat and ground attack in both the European and Pacific Theaters. The aircraft was equipped with a primary armament of eight .50-caliber machine guns and in the fighter-bomber ground-attack role it could carry five-inch rockets or a bomb load of 1,103 kg (2,500 pounds). By the end of the war 15,636 units had been built, including variants."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Basic","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardDestroyed"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Trigger"],"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/t_p47d_thunderbolt.t_p47d_thunderbolt","SubPathString":""},"artist":"Robert Taylor","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/P-47D_THUNDERBOLT.P-47D_THUNDERBOLT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":401.0},"historyPhotoSource":" http://www.af.mil/photos/index.asp?galleryID=161&page=6","historyPhotoAuthor":"US Air Force photo","historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_p47d_thunderbolt_photo","SourceString":"Republic P-47D Thunderbolt in flight, 1940s.","LocalizedString":"Republic P-47D Thunderbolt in flight, 1940s."},"historyTypeDescription":{"Namespace":"card_usa","Key":"car