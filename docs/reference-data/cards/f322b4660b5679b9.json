{"format":"kards-original-reference","version":1,"id":"f322b4660b5679b9","name":"card_unit_5th_medical_battalion","package":"/Game/Blueprints/Cards/USA/WorldAtWar/units/card_unit_5th_medical_battalion","parent":"UBaseCardObject","card":{"title":"5th MEDICAL BATTALION","text":"Your other units have +1 attack and are fully repaired at the end of your turn.","flavorText":"A medical battalion was a divisional unit that offered medical support to the division in the field. Its main role was to conduct necessary evacuation and to administer medical care for the casualties of the division. The 5th Medical Battalion was attached to the 5th Infantry Division, aka “Red Devils”, of the US Army during WWII. In 1942 the division was shipped to Iceland, where the British occupation force was replaced by the US forces, but from there it was sent to England in 1943 to prepare for the Allied invasion of Europe. After two years of training the 5th Division landed in Normandy in 1944, over a month after the D-Day landings, and in the following months it participated in heavy combat during the Battle of France. In December 1944 the division was sent to reinforce the Allied southern flank in Belgium during the Battle of the Bulge. After that the division fought its way towards Germany along with the Allied forces and ended the war in Czechoslovakia in 1945.","faction":"USA","type":"infantry","rarity":"Unique","cost":4,"operationCost":1,"attack":0,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_5th_medical_battalion","title":{"Namespace":"card_usa","Key":"card_unit_5th_medical_battalion_title","SourceString":"5th MEDICAL BATTALION","LocalizedString":"5th MEDICAL BATTALION"},"Type":"ETypeEnum::infantry","defense":5,"range":1,"faction":"EFactionEnum::USA","kredits":4,"Text":{"Namespace":"card_usa","Key":"card_unit_5th_medical_battalion_text","SourceString":"Your other units have +1 attack and are fully repaired at the end of your turn.","LocalizedString":"Your other units have +1 attack and are fully repaired at the end of your turn."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_5th_medical_battalion_history","SourceString":"A medical battalion was a divisional unit that offered medical support to the division in the field. Its main role was to conduct necessary evacuation and to administer medical care for the casualties of the division. The 5th Medical Battalion was attached to the 5th Infantry Division, aka “Red Devils”, of the US Army during WWII. In 1942 the division was shipped to Iceland, where the British occupation force was replaced by the US forces, but from there it was sent to England in 1943 to prepare for the Allied invasion of Europe. After two years of training the 5th Division landed in Normandy in 1944, over a month after the D-Day landings, and in the following months it participated in heavy combat during the Battle of France. In December 1944 the division was sent to reinforce the Allied southern flank in Belgium during the Battle of the Bulge. After that the division fought its way towards Germany along with the Allied forces and ended the war in Czechoslovakia in 1945.","LocalizedString":"A medical battalion was a divisional unit that offered medical support to the division in the field. Its main role was to conduct necessary evacuation and to administer medical care for the casualties of the division. The 5th Medical Battalion was attached to the 5th Infantry Division, aka “Red Devils”, of the US Army during WWII. In 1942 the division was shipped to Iceland, where the British occupation force was replaced by the US forces, but from there it was sent to England in 1943 to prepare for the Allied invasion of Europe. After two years of training the 5th Division landed in Normandy in 1944, over a month after the D-Day landings, and in the following months it participated in heavy combat during the Battle of France. In December 1944 the division was sent to reinforce the Allied southern flank in Belgium during the Battle of the Bulge. After that the division fought its way towards Germany along with the Allied forces and ended the war in Czechoslovakia in 1945."},"operationCost":1,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::WorldAtWar","isReserved":true,"showBoostIcon":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn","ERegisteredCardFunction::OnOtherCardEnterPlay","ERegisteredCardFunction::OnOtherCardLeaveBoardOrOwner","ERegisteredCardFunction::OnBeforeOtherCardPlayedFromHand"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Trigger"],"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/CandidateArtwork/t_medic_corps_test.t_medic_corps_test","SubPathString":""},"ImageAnchor":"EImageAnchor::Top","artist":"US WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/5th_MEDICAL_BATTALION.5th_MEDICAL_BATTALION","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":399.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_5th_medical_battalion_photo","SourceString":"Medics of the 5th Medical Battalion going through captured German equipment, Luxemburg, 1945.","LocalizedString":"Medics of the 5th Medical Battalion going through captured German equipment, Luxemburg, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"threat_level":0.35},"variables":[{"name":"_tmp_card","type":"UBaseCardObject*","direction":"in"},{"name":"CardsBuffed","type":"TArra