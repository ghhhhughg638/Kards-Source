{"format":"kards-original-reference","version":1,"id":"65004ce7a2487bd5","name":"card_unit_flammpanzer","package":"/Game/Blueprints/Cards/Germany/Allegiance/units/card_unit_flammpanzer","parent":"UBaseCardObject","card":{"title":"FLAMMPANZER","text":"Deployment: Destroy target enemy unit with cost 1 or less.","flavorText":"The German Pz.Kpfw III (fl), or Flammpanzer III, was a Panzer III medium tank variant with a mounted 14mm flamethrower nozzle. In order to disguise the tank’s role it had a fake barrel installed that was 1.5 meters long. The tank could carry 1020 liters of flammable liquid and the flame gun, which was fired via a foot pedal, had a range of up to 60 meters. In order to protect the tank and the flammable liquids inside it had 20 mm of extra armor and additionally it had a 30 mm plate added to the upper and lower hull front. For protection the tank also carried 5 fire extinguishers, 3 on the inside and 2 on the tank’s exterior. The Flammpanzer III first saw action in 1943 and was used on the Eastern Front and in the Italian Campaign. A total of 100 Flammpanzer IIIs were produced.","faction":"Germany","type":"tank","rarity":"Uncommon","cost":3,"operationCost":2,"attack":4,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_flammpanzer","title":{"Namespace":"card_germany","Key":"card_unit_flammpanzer_title","SourceString":"FLAMMPANZER","LocalizedString":"FLAMMPANZER"},"Type":"ETypeEnum::tank","attack":4,"defense":3,"range":1,"faction":"EFactionEnum::Germany","kredits":3,"Text":{"Namespace":"card_germany","Key":"card_unit_flammpanzer_text","SourceString":"Deployment: Destroy target enemy unit with cost 1 or less.","LocalizedString":"Deployment: Destroy target enemy unit with cost 1 or less."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_flammpanzer_history","SourceString":"The German Pz.Kpfw III (fl), or Flammpanzer III, was a Panzer III medium tank variant with a mounted 14mm flamethrower nozzle. In order to disguise the tank’s role it had a fake barrel installed that was 1.5 meters long. The tank could carry 1020 liters of flammable liquid and the flame gun, which was fired via a foot pedal, had a range of up to 60 meters. In order to protect the tank and the flammable liquids inside it had 20 mm of extra armor and additionally it had a 30 mm plate added to the upper and lower hull front. For protection the tank also carried 5 fire extinguishers, 3 on the inside and 2 on the tank’s exterior. The Flammpanzer III first saw action in 1943 and was used on the Eastern Front and in the Italian Campaign. A total of 100 Flammpanzer IIIs were produced.","LocalizedString":"The German Pz.Kpfw III (fl), or Flammpanzer III, was a Panzer III medium tank variant with a mounted 14mm flamethrower nozzle. In order to disguise the tank’s role it had a fake barrel installed that was 1.5 meters long. The tank could carry 1020 liters of flammable liquid and the flame gun, which was fired via a foot pedal, had a range of up to 60 meters. In order to protect the tank and the flammable liquids inside it had 20 mm of extra armor and additionally it had a 30 mm plate added to the upper and lower hull front. For protection the tank also carried 5 fire extinguishers, 3 on the inside and 2 on the tank’s exterior. The Flammpanzer III first saw action in 1943 and was used on the Eastern Front and in the Italian Campaign. A total of 100 Flammpanzer IIIs were produced."},"operationCost":2,"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Expansion2019","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"soundAttack":{"ObjectName":"SoundCue'AU_FlameThrower_attack_Cue'","ObjectPath":"kards/Content/Assets/Audio/Projectiles_and_Impacts/Tanks/AU_FlameThrower_attack_Cue.0"},"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Armor_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Armor_Medium_Cue.0"},"Image":{"Ass