{"format":"kards-original-reference","version":1,"id":"58ed76eacf930368","name":"card_unit_henschel_hs_126","package":"/Game/Blueprints/Cards/Germany/Allegiance/units/card_unit_henschel_hs_126","parent":"UBaseCardObject","card":{"title":"HENSCHEL HS 126","text":"Deployment: Give a friendly tank +1+1 for each non-tank unit type in the same line.","flavorText":"The Henschel Hs 126 was a German reconnaissance aircraft, used during WWII by the Luftwaffe and the Axis allies. The aircraft was two seated and carried a pilot seated in the front of the cockpit and a gunner in the rear. The Hs 126 first entered service in 1938 and it was used early in the war by the Luftwaffe, but by then it was superseded by more advanced reconnaissance aircraft and was mainly retired from front line services in 1942. Later in the war the aircraft was used in night ground attacks and for glider towing. In 1943 ten Henschel Hs 126’s were used to tow DFS 230 attack gliders on a raid to rescue the imprisoned Benito Mussolini.","faction":"Germany","type":"fighter","rarity":"Common","cost":2,"operationCost":1,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_henschel_hs_126","title":{"Namespace":"card_germany","Key":"card_unit_henschel_hs_126_title","SourceString":"HENSCHEL HS 126","LocalizedString":"HENSCHEL HS 126"},"Type":"ETypeEnum::fighter","attack":1,"defense":2,"range":2,"faction":"EFactionEnum::Germany","kredits":2,"Text":{"Namespace":"card_germany","Key":"card_unit_henschel_hs_126_text","SourceString":"Deployment: Give a friendly tank +1+1 for each non-tank unit type in the same line.","LocalizedString":"Deployment: Give a friendly tank +1+1 for each non-tank unit type in the same line."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_henschel_hs_126_history","SourceString":"The Henschel Hs 126 was a German reconnaissance aircraft, used during WWII by the Luftwaffe and the Axis allies. The aircraft was two seated and carried a pilot seated in the front of the cockpit and a gunner in the rear. The Hs 126 first entered service in 1938 and it was used early in the war by the Luftwaffe, but by then it was superseded by more advanced reconnaissance aircraft and was mainly retired from front line services in 1942. Later in the war the aircraft was used in night ground attacks and for glider towing. In 1943 ten Henschel Hs 126’s were used to tow DFS 230 attack gliders on a raid to rescue the imprisoned Benito Mussolini.","LocalizedString":"The Henschel Hs 126 was a German reconnaissance aircraft, used during WWII by the Luftwaffe and the Axis allies. The aircraft was two seated and carried a pilot seated in the front of the cockpit and a gunner in the rear. The Hs 126 first entered service in 1938 and it was used early in the war by the Luftwaffe, but by then it was superseded by more advanced reconnaissance aircraft and was mainly retired from front line services in 1942. Later in the war the aircraft was used in night ground attacks and for glider towing. In 1943 ten Henschel Hs 126’s were used to tow DFS 230 attack gliders on a raid to rescue the imprisoned Benito Mussolini."},"operationCost":1,"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Expansion2019","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"soundEnterPlay":{"ObjectName":"SoundCue'AU_depl_biplane_Cue'","ObjectPath":"kards/Content/Assets/Audio/Biplane/AU_depl_biplane_Cue.0"},"soundMoveToFrontline":{"ObjectName":"SoundCue'AU_move_biplane_01_Cue'","ObjectPath":"kards/Content/Assets/Audio/Biplane/AU_move_biplane_01_Cue.0"},"soundAttack":{"ObjectName":"SoundCue'AU_move_biplane_01_Cue'","ObjectPath":"kards/Content/Assets/Audio/Biplane/AU_move_biplane_01_Cue.0"},"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Small_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Small_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germa