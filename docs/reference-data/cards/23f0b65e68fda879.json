{"format":"kards-original-reference","version":1,"id":"23f0b65e68fda879","name":"card_event_covert_operation","package":"/Game/Blueprints/Cards/Soviet/CovertOp/events/card_event_covert_operation","parent":"UBaseCardObject","card":{"title":"COVERT OPERATION","text":"Add the top Covert unit of your deck to your support line. Duplicate it.","flavorText":"Operation Berezino, also known as \"Operation Scherhorn\" was a covert operation undertaken by the Soviet NKVD during WWII.  The primary goal of the operation was to create the illusion of a substantial German military unit operating within Soviet-held territories. The aim was to exhaust Nazi intelligence assets by intercepting and eliminating field operatives that were sent to aid these fictitious forces. The NKVD orchestrated a simulated German \"resistance pocket,\" led by Lieutenant-Colonel Heinrich Scherhorn, who was an actual German prisoner that was coerced into collaboration with the Soviets. In response, the Germans launched an operation, led by Otto Skorzeny, which aimed at helping the fake resistance pocket achieve their goals. However, when Skorzeny's commandos arrived to the rescue, they were promptly detained and coerced into participating in the Soviet deception. Although German support waned over time, the illusion of \"Group Scherhorn\" persisted until May 1945, as proved the maintained radio communications with German command.","faction":"Soviet","type":"order","rarity":"Common","cost":5,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_covert_operation","title":{"Namespace":"card_soviet","Key":"card_event_covert_operation_title","SourceString":"COVERT OPERATION","LocalizedString":"COVERT OPERATION"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Soviet","kredits":5,"Text":{"Namespace":"card_soviet","Key":"card_event_covert_operation_text","SourceString":"Add the top Covert unit of your deck to your support line. Duplicate it.","LocalizedString":"Add the top Covert unit of your deck to your support line. Duplicate it."},"flavorText":{"Namespace":"card_soviet","Key":"card_event_covert_operation_history","SourceString":"Operation Berezino, also known as \"Operation Scherhorn\" was a covert operation undertaken by the Soviet NKVD during WWII.  The primary goal of the operation was to create the illusion of a substantial German military unit operating within Soviet-held territories. The aim was to exhaust Nazi intelligence assets by intercepting and eliminating field operatives that were sent to aid these fictitious forces. The NKVD orchestrated a simulated German \"resistance pocket,\" led by Lieutenant-Colonel Heinrich Scherhorn, who was an actual German prisoner that was coerced into collaboration with the Soviets. In response, the Germans launched an operation, led by Otto Skorzeny, which aimed at helping the fake resistance pocket achieve their goals. However, when Skorzeny's commandos arrived to the rescue, they were promptly detained and coerced into participating in the Soviet deception. Although German support waned over time, the illusion of \"Group Scherhorn\" persisted until May 1945, as proved the maintained radio communications with German command.","LocalizedString":"Operation Berezino, also known as \"Operation Scherhorn\" was a covert operation undertaken by the Soviet NKVD during WWII.  The primary goal of the operation was to create the illusion of a substantial German military unit operating within Soviet-held territories. The aim was to exhaust Nazi intelligence assets by intercepting and eliminating field operatives that were sent to aid these fictitious forces. The NKVD orchestrated a simulated German \"resistance pocket,\" led by Lieutenant-Colonel Heinrich Scherhorn, who was an actual German prisoner that was coerced into collaboration with the Soviets. In response, the Germans launched an operation, led by Otto Skorzeny, which aimed at helping the fake resistance pocket achieve their goals. However, when Skorzeny's commandos arrived to the rescue, they were promptly detained and coerced into participating in the Soviet deception. Although German support waned over time, the illusion of \"Group Scherhorn\" persisted until May 1945, as proved the maintained radio communications with German command."},"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::CurrentExpansion","isReserved":true,"soundEnterPlay":{"ObjectName":"SoundWave'Patriotic_Push'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Patriotic_Push.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/Summer_24/t_covert_operation.t_covert_operation","SubPathString":""},"artist":"Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/COVERT_OPERATION.COVERT_OPERATION","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":346.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_event_covert_operation_photo","SourceString":"Photograph of NKVD officer Pavel Sudoplatov who was in charge of Operation Berezino. Date unknown.","LocalizedString":"Photograph of NKVD officer Pavel Sudoplatov who was in charge of Operation Berezino. Date unknown."},"isAttackBuff":true,"isDefenseBuff":true},"variables":[{"name":"unitFound","type":"bool","direction":"in"},{"name":"tmpName","type":"FName","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_covert_operation","owner":"card_event_covert_operation_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"Temp_bool_True_if_break_was_hit_Variable","type":"bool","direction":"in"},{"name":"CallFunc_Not_PreBool_ReturnValue","ty