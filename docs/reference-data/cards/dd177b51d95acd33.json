{"format":"kards-original-reference","version":1,"id":"dd177b51d95acd33","name":"card_unit_39th_rifle_regiment","package":"/Game/Blueprints/Cards/Soviet/WorldAtWar/units/card_unit_39th_rifle_regiment","parent":"UBaseCardObject","card":{"title":"39th RIFLE REGIMENT","text":"Deployment: Take control of an enemy unit with cost 2 or less.","flavorText":"The 39th Rifle Regiment was a regiment of the 4th Rifle Division of the Soviet Red Army. The division was first formed in 1919 during the Russian Civil War and fought on the western front in that war, and later in the Polish Soviet War of 1919 -1921. In 1939 the division participated in the Finnish Winter War as part of the 13th Army and suffered heavy losses in the Battle of Kelja. In 1941, after Operation Barbarossa, the division was fighting the invading German forces as part of 12th Army, but it was disbanded in 1942 after heavy losses in the Battle of the Caucasus. The 4th Division was reformed in 1943 and participated in the Lublin-Brest Offensive in 1944 and the Battle of Berlin in May 1945. Shortly after the war ended in Europe the division was disbanded.","faction":"Soviet","type":"infantry","rarity":"Unique","cost":5,"operationCost":1,"attack":5,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_39th_rifle_regiment","title":{"Namespace":"card_soviet","Key":"card_unit_39th_rifle_regiment_title","SourceString":"39th RIFLE REGIMENT","LocalizedString":"39th RIFLE REGIMENT"},"Type":"ETypeEnum::infantry","attack":5,"defense":5,"range":1,"faction":"EFactionEnum::Soviet","kredits":5,"Text":{"Namespace":"card_soviet","Key":"card_unit_39th_rifle_regiment_text","SourceString":"Deployment: Take control of an enemy unit with cost 2 or less.","LocalizedString":"Deployment: Take control of an enemy unit with cost 2 or less."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_39th_rifle_regiment_history","SourceString":"The 39th Rifle Regiment was a regiment of the 4th Rifle Division of the Soviet Red Army. The division was first formed in 1919 during the Russian Civil War and fought on the western front in that war, and later in the Polish Soviet War of 1919 -1921. In 1939 the division participated in the Finnish Winter War as part of the 13th Army and suffered heavy losses in the Battle of Kelja. In 1941, after Operation Barbarossa, the division was fighting the invading German forces as part of 12th Army, but it was disbanded in 1942 after heavy losses in the Battle of the Caucasus. The 4th Division was reformed in 1943 and participated in the Lublin-Brest Offensive in 1944 and the Battle of Berlin in May 1945. Shortly after the war ended in Europe the division was disbanded.","LocalizedString":"The 39th Rifle Regiment was a regiment of the 4th Rifle Division of the Soviet Red Army. The division was first formed in 1919 during the Russian Civil War and fought on the western front in that war, and later in the Polish Soviet War of 1919 -1921. In 1939 the division participated in the Finnish Winter War as part of the 13th Army and suffered heavy losses in the Battle of Kelja. In 1941, after Operation Barbarossa, the division was fighting the invading German forces as part of 12th Army, but it was disbanded in 1942 after heavy losses in the Battle of the Caucasus. The 4th Division was reformed in 1943 and participated in the Lublin-Brest Offensive in 1944 and the Battle of Berlin in May 1945. Shortly after the war ended in Europe the division was disbanded."},"operationCost":1,"rarity":"ERarityEnum::Unique","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::WorldAtWar","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment","EHelpBubbleTypes::UnderEnemyControl"],"hasDeployment":true,"soundEnterPlay":{"ObjectName":"SoundWave'Infantry_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Infantry_Move_FX.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Infantry_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Infantry_Move_FX.