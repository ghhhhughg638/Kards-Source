{"format":"kards-original-reference","version":1,"id":"287e1c77e4e5a48e","name":"card_unit_2_2nd_pioneers","package":"/Game/Blueprints/Cards/ANZAC/units/card_unit_2_2nd_pioneers","parent":"UBaseCardObject","card":{"title":"2/2nd PIONEERS","text":"Your other units get +1+1 when you Forecast.","flavorText":"The 2/2nd Pioneer Battalion was an Australian unit raised in 1940 as part of the Second Australian Imperial Force. Pioneer battalions were trained to support infantry with practical battlefield work, such as building tracks, digging positions, clearing obstacles, and handling smaller engineering tasks. In combat, they could also fight as infantry when needed. The 2/2nd was assigned to the 7th Division and first served in the Middle East. During the Syria-Lebanon campaign in 1941, it fought mainly as infantry, including costly engagements around Merdjayoun, El Mtolle, and Damour. In 1942, the battalion was sent back to Australia but got diverted to Java after Japan entered the war. There, it joined Blackforce, a 3.000 man pioneer infantry unit named after its commander, Brigadier Arthur Blackburn, and fought briefly before the Allied force surrendered. More than 800 men were captured, and 258 later died in captivity. The battalion was rebuilt in Australia and sent to New Guinea in 1943. It helped build an airfield after the landing at Nadzab, fought toward Lae, and later served in the Finisterre Range around Shaggy Ridge. Its final campaign was in Borneo in 1945.","faction":"Anzac","type":"infantry","rarity":"Rare","cost":3,"operationCost":1,"attack":1,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_2_2nd_pioneers","title":{"Namespace":"card_anzac","Key":"card_unit_2_2nd_pioneers_title","SourceString":"2/2nd PIONEERS","LocalizedString":"2/2nd PIONEERS"},"Type":"ETypeEnum::infantry","attack":1,"defense":6,"range":1,"faction":"EFactionEnum::Anzac","kredits":3,"Text":{"Namespace":"card_anzac","Key":"card_unit_2_2nd_pioneers_text","SourceString":"Your other units get +1+1 when you Forecast.","LocalizedString":"Your other units get +1+1 when you Forecast."},"flavorText":{"Namespace":"card_anzac","Key":"card_unit_2_2nd_pioneers_history","SourceString":"The 2/2nd Pioneer Battalion was an Australian unit raised in 1940 as part of the Second Australian Imperial Force. Pioneer battalions were trained to support infantry with practical battlefield work, such as building tracks, digging positions, clearing obstacles, and handling smaller engineering tasks. In combat, they could also fight as infantry when needed. The 2/2nd was assigned to the 7th Division and first served in the Middle East. During the Syria-Lebanon campaign in 1941, it fought mainly as infantry, including costly engagements around Merdjayoun, El Mtolle, and Damour. In 1942, the battalion was sent back to Australia but got diverted to Java after Japan entered the war. There, it joined Blackforce, a 3.000 man pioneer infantry unit named after its commander, Brigadier Arthur Blackburn, and fought briefly before the Allied force surrendered. More than 800 men were captured, and 258 later died in captivity. The battalion was rebuilt in Australia and sent to New Guinea in 1943. It helped build an airfield after the landing at Nadzab, fought toward Lae, and later served in the Finisterre Range around Shaggy Ridge. Its final campaign was in Borneo in 1945.","LocalizedString":"The 2/2nd Pioneer Battalion was an Australian unit raised in 1940 as part of the Second Australian Imperial Force. Pioneer battalions were trained to support infantry with practical battlefield work, such as building tracks, digging positions, clearing obstacles, and handling smaller engineering tasks. In combat, they could also fight as infantry when needed. The 2/2nd was assigned to the 7th Division and first served in the Middle East. During the Syria-Lebanon campaign in 1941, it fought mainly as infantry, including costly engagements around Merdjayoun, El Mtolle, and Damour. In 1942, the battalion was sent back to Australia but got diverted to Java after Japan entered the war. There, it joined Blackforce, a 3.000 man pioneer infantry unit named after its commander, Brigadier Arthur Blackburn, and fought briefly before the Allied force surrendered. More than 800 men were captured, and 258 later died in captivity. The battalion was rebuilt in Australia and sent to New Guinea in 1943. It helped build an airfield after the landing at Nadzab, fought toward Lae, and later served in the Finisterre Range around Shaggy Ridge. Its final campaign was in Borneo in 1945."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardForecasted"],"hasGuard":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/2_2nd_PIONEERS.2_2nd_PIONEERS","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_anzac","Key":"card_unit_2_2nd_pioneers_photo","SourceString":"Men of the 2/2nd Pioneer Battalion digging in, Syria, 1941. ","LocalizedString":"Men of the 2/2nd Pioneer Battalion digging in, Syria, 1941. "},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"threat_level":0.1},"variables":[{"name":"tempCardID","type":"int32","direction":"in"},{"name":"TempCard","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_2_2nd_pioneers","owner":"card_unit_2_2nd_pioneers_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunctio