{"format":"kards-original-reference","version":1,"id":"2184695d4800e0f4","name":"card_unit_ruffians","package":"/Game/Blueprints/Cards/USA/OceaniaStorm/units/card_unit_ruffians","parent":"UBaseCardObject","card":{"title":"RUFFIANS","text":"Deployment: Gets +1+1 for each other infantry you control.","flavorText":"“Ruffians” refers to Raff’s Ruffians, the nickname given to the 507th Parachute Infantry Regiment after Colonel Edson Raff took its command in Normandy. The regiment was formed at Fort Benning in 1942 and first assigned to the 82nd Airborne Division. It made its combat debut on D-Day. During Mission Boston, the 507th was dropped into Normandy to help secure crossings over the Merderet River. Its intended drop zone laid north of Amfreville, but clouds, anti-aircraft fire and confusion scattered many aircraft. Small groups of paratroopers had to fight their way through the flooded fields and hedgerows, often far from their planned objectives. The regiment suffered heavy losses in Normandy before returning to England in July 1944. It later joined the 17th Airborne Division, fought during the Battle of the Bulge and jumped again in Operation Varsity, the airborne crossing of the Rhine in 1945. After advancing into Germany, the 507th ended the war there in May, was shipped home and inactivated later that year.","faction":"USA","type":"infantry","rarity":"Common","cost":2,"operationCost":1,"attack":1,"defense":1},"defaults":{"UberGraphFrame":{},"Name":"card_unit_ruffians","title":{"Namespace":"card_usa","Key":"card_unit_ruffians_title","SourceString":"RUFFIANS","LocalizedString":"RUFFIANS"},"Type":"ETypeEnum::infantry","attack":1,"defense":1,"range":1,"faction":"EFactionEnum::USA","kredits":2,"Text":{"Namespace":"card_usa","Key":"card_unit_ruffians_text","SourceString":"Deployment: Gets +1+1 for each other infantry you control.","LocalizedString":"Deployment: Gets +1+1 for each other infantry you control."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_ruffians_history","SourceString":"“Ruffians” refers to Raff’s Ruffians, the nickname given to the 507th Parachute Infantry Regiment after Colonel Edson Raff took its command in Normandy. The regiment was formed at Fort Benning in 1942 and first assigned to the 82nd Airborne Division. It made its combat debut on D-Day. During Mission Boston, the 507th was dropped into Normandy to help secure crossings over the Merderet River. Its intended drop zone laid north of Amfreville, but clouds, anti-aircraft fire and confusion scattered many aircraft. Small groups of paratroopers had to fight their way through the flooded fields and hedgerows, often far from their planned objectives. The regiment suffered heavy losses in Normandy before returning to England in July 1944. It later joined the 17th Airborne Division, fought during the Battle of the Bulge and jumped again in Operation Varsity, the airborne crossing of the Rhine in 1945. After advancing into Germany, the 507th ended the war there in May, was shipped home and inactivated later that year.","LocalizedString":"“Ruffians” refers to Raff’s Ruffians, the nickname given to the 507th Parachute Infantry Regiment after Colonel Edson Raff took its command in Normandy. The regiment was formed at Fort Benning in 1942 and first assigned to the 82nd Airborne Division. It made its combat debut on D-Day. During Mission Boston, the 507th was dropped into Normandy to help secure crossings over the Merderet River. Its intended drop zone laid north of Amfreville, but clouds, anti-aircraft fire and confusion scattered many aircraft. Small groups of paratroopers had to fight their way through the flooded fields and hedgerows, often far from their planned objectives. The regiment suffered heavy losses in Normandy before returning to England in July 1944. It later joined the 17th Airborne Division, fought during the Battle of the Bulge and jumped again in Operation Varsity, the airborne crossing of the Rhine in 1945. After advancing into Germany, the 507th ended the war there in May, was shipped home and inactivated later that year."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::OceaniaStorm","hasDeployment":true,"hasBlitz":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/RUFFIANS.RUFFIANS","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":288.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_ruffians_photo","SourceString":"Men of the 507th Parachute Infantry Regiment during Operation Varsity, Germany, 1945.","LocalizedString":"Men of the 507th Parachute Infantry Regiment during Operation Varsity, Germany, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"count","type":"int32","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_ruffians","owner":"card_unit_ruffians_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"Temp_int_Variable","type":"int32","direction":"in"},{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_GetAllUnitsOnBoard_cards","type":"TArray<UBaseCardObject*>","direction":"in"},{"name":"CallFunc_IsLocatedOnBoard_isIt","type":"bool","direction":"in"},{"name":"CallFunc_Array_Get_Item","type":