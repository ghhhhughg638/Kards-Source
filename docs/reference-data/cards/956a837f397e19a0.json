{"format":"kards-original-reference","version":1,"id":"956a837f397e19a0","name":"card_unit_58th_infantry_regiment","package":"/Game/Blueprints/Cards/Japan/BloodIron/units/card_unit_58th_infantry_regiment","parent":"UBaseCardObject","card":{"title":"58th INFANTRY REGIMENT","text":"Has +2 attack while it has Shock.","flavorText":"The 58th Infantry Regiment was part of the 31st Division of the Imperial Japanese Army during WWII. The division was formed in Thailand in March 1943 and became part of the Japanese Burma Area Army. On March 15, 1944, the division participated in the Japanese U-GO offensive with the objective of capturing the city of Kohima in British India. During its advance, the division faced strong opposition from Indian and British troops in the Battle of Sangshak, which significantly delayed their progress. The division began the siege of Kohima on April 3, 1944, launching attacks that forced British and Indian defenders into a small defensive area, later known as the Battle of the Tennis Court. By April 17, the defenders were in a desperate situation, but British artillery and RAF air support struck Japanese positions, halting their attacks. The British had gathered significant artillery, while the Japanese had limited artillery and ammunition. With the road to Kohima reopened, the siege was lifted. The remaining forces of the 31st Division continued resisting the Allied reoccupation of Burma but had lost their strength and were no longer an effective fighting unit.","faction":"Japan","type":"infantry","rarity":"Common","cost":1,"operationCost":1,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_58th_infantry_regiment","title":{"Namespace":"card_japan","Key":"card_unit_58th_infantry_regiment_title","SourceString":"58th INFANTRY REGIMENT","LocalizedString":"58th INFANTRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":1,"defense":2,"range":1,"faction":"EFactionEnum::Japan","kredits":1,"Text":{"Namespace":"card_japan","Key":"card_unit_58th_infantry_regiment_text","SourceString":"Has +2 attack while it has Shock.","LocalizedString":"Has +2 attack while it has Shock."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_58th_infantry_regiment_history","SourceString":"The 58th Infantry Regiment was part of the 31st Division of the Imperial Japanese Army during WWII. The division was formed in Thailand in March 1943 and became part of the Japanese Burma Area Army. On March 15, 1944, the division participated in the Japanese U-GO offensive with the objective of capturing the city of Kohima in British India. During its advance, the division faced strong opposition from Indian and British troops in the Battle of Sangshak, which significantly delayed their progress. The division began the siege of Kohima on April 3, 1944, launching attacks that forced British and Indian defenders into a small defensive area, later known as the Battle of the Tennis Court. By April 17, the defenders were in a desperate situation, but British artillery and RAF air support struck Japanese positions, halting their attacks. The British had gathered significant artillery, while the Japanese had limited artillery and ammunition. With the road to Kohima reopened, the siege was lifted. The remaining forces of the 31st Division continued resisting the Allied reoccupation of Burma but had lost their strength and were no longer an effective fighting unit.","LocalizedString":"The 58th Infantry Regiment was part of the 31st Division of the Imperial Japanese Army during WWII. The division was formed in Thailand in March 1943 and became part of the Japanese Burma Area Army. On March 15, 1944, the division participated in the Japanese U-GO offensive with the objective of capturing the city of Kohima in British India. During its advance, the division faced strong opposition from Indian and British troops in the Battle of Sangshak, which significantly delayed their progress. The division began the siege of Kohima on April 3, 1944, launching attacks that forced British and Indian defenders into a small defensive area, later known as the Battle of the Tennis Court. By April 17, the defenders were in a desperate situation, but British artillery and RAF air support struck Japanese positions, halting their attacks. The British had gathered significant artillery, while the Japanese had limited artillery and ammunition. With the road to Kohima reopened, the siege was lifted. The remaining forces of the 31st Division continued resisting the Allied reoccupation of Burma but had lost their strength and were no longer an effective fighting unit."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::BloodAndIron","EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardAblitiesChanged"],"hasBlitz":true,"hasShock":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/08_Blood_And_Iron/T_58th_infantry_regiment.T_58th_infantry_regiment","SubPathString":""},"artist":"Japanese WWII Postcard","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/58th_INFANTRY_REGIMENT.58th_INFANTRY_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":335.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_58th_infantry_regiment_photo","SourceString":"Japanese and Indian soldiers fighting in Burma, 1944.","LocalizedString":"Japanese and Indian soldiers fighting in Burma, 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"threat_level":0.1},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_58th_infantr