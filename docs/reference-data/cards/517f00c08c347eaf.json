{"format":"kards-original-reference","version":1,"id":"517f00c08c347eaf","name":"card_unit_7th_scottish_borderers","package":"/Game/Blueprints/Cards/Britain/CovertOp/units/card_unit_7th_scottish_borderers","parent":"UBaseCardObject","card":{"title":"7th SCOTTISH BORDERERS","text":"Deal 1 damage to the enemy HQ for each excess Intel you get.","flavorText":"The 7th Battalion was a unit of the King's Own Scottish Borderers, an infantry regiment of the British Army that was first raised in 1689 and stayed active until 2006 when it was merged with the Royal Scots Battalion to form the Royal Scots Borderers. During the interwar period the battalions of the regiment were in service all over the British Empire, but they were called back home when WWII started in 1939. Between 1939 and 1943, the 7th Battalion was stationed in Great Britain on home defense duties, but in July 1943 it was transferred to the 1st Airlanding Brigade and started training as an airborne unit. On September 17th, 1944, the 7th Battalion participated in Operation Market Garden and landed in gliders at Arnhem, where they fought fiercely against a larger German force before withdrawing across the Lower Rhine. After Arnhem, the battalion joined Operation Doomsday to oversee the German surrender in Norway, but tragically lost four men in a plane crash during the journey. The battalion was disbanded on November 28th, 1945, with its members dispersed to other units.","faction":"Britain","type":"infantry","rarity":"Uncommon","cost":2,"operationCost":1,"attack":1,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_7th_scottish_borderers","title":{"Namespace":"card_britain","Key":"card_unit_7th_scottish_borderers_title","SourceString":"7th SCOTTISH BORDERERS","LocalizedString":"7th SCOTTISH BORDERERS"},"Type":"ETypeEnum::infantry","attack":1,"defense":3,"range":1,"faction":"EFactionEnum::Britain","kredits":2,"Text":{"Namespace":"card_britain","Key":"card_unit_7th_scottish_borderers_text","SourceString":"Deal 1 damage to the enemy HQ for each excess Intel you get.","LocalizedString":"Deal 1 damage to the enemy HQ for each excess Intel you get."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_7th_scottish_borderers_history","SourceString":"The 7th Battalion was a unit of the King's Own Scottish Borderers, an infantry regiment of the British Army that was first raised in 1689 and stayed active until 2006 when it was merged with the Royal Scots Battalion to form the Royal Scots Borderers. During the interwar period the battalions of the regiment were in service all over the British Empire, but they were called back home when WWII started in 1939. Between 1939 and 1943, the 7th Battalion was stationed in Great Britain on home defense duties, but in July 1943 it was transferred to the 1st Airlanding Brigade and started training as an airborne unit. On September 17th, 1944, the 7th Battalion participated in Operation Market Garden and landed in gliders at Arnhem, where they fought fiercely against a larger German force before withdrawing across the Lower Rhine. After Arnhem, the battalion joined Operation Doomsday to oversee the German surrender in Norway, but tragically lost four men in a plane crash during the journey. The battalion was disbanded on November 28th, 1945, with its members dispersed to other units.","LocalizedString":"The 7th Battalion was a unit of the King's Own Scottish Borderers, an infantry regiment of the British Army that was first raised in 1689 and stayed active until 2006 when it was merged with the Royal Scots Battalion to form the Royal Scots Borderers. During the interwar period the battalions of the regiment were in service all over the British Empire, but they were called back home when WWII started in 1939. Between 1939 and 1943, the 7th Battalion was stationed in Great Britain on home defense duties, but in July 1943 it was transferred to the 1st Airlanding Brigade and started training as an airborne unit. On September 17th, 1944, the 7th Battalion participated in Operation Market Garden and landed in gliders at Arnhem, where they fought fiercely against a larger German force before withdrawing across the Lower Rhine. After Arnhem, the battalion joined Operation Doomsday to oversee the German surrender in Norway, but tragically lost four men in a plane crash during the journey. The battalion was disbanded on November 28th, 1945, with its members dispersed to other units."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::CurrentExpansion","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnIntelTriggered"],"draftBaseWeight":0.9,"hasSmokescreen":true,"cipher":3,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/Spring2023Candidates/t_airborne_storm.t_airborne_storm","SubPathString":""},"artist":"Simon Smith","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/7th_SCOTTISH_BORDERERS.7th_SCOTTISH_BORDERERS","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":344.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_unit_7th_scottish_borderers_photo","SourceString":"7th Battalion during Operation Market Garden, 1944.","LocalizedString":"7th Battalion during Operation Market Garden, 1944."},"historyTypeDescription":{"Namespace":"","Key":"0DBC5F184A8F0CFAA1A9D6BB449E2AC6","SourceString":"Infantry","LocalizedString":"Infantry"},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"threat_level":0.2},"variables":[{"name":"unseenCards","type":"int32","direction":"in"},{"name":"intelValue","type":"int32",