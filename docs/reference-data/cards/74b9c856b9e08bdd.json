{"format":"kards-original-reference","version":1,"id":"74b9c856b9e08bdd","name":"card_event_area_bombardment","package":"/Game/Blueprints/Cards/Britain/OceaniaStorm/events/card_event_area_bombardment","parent":"UBaseCardObject","card":{"title":"AREA BOMBARDMENT","text":"Add a LANCASTER Mk I to your support line. Shuffle it into your deck at the end of turn.","flavorText":"Area bombardment became a central part of RAF Bomber Command’s night war against Germany. Early hopes of striking individual factories or military targets often failed due to darkness and poor weather. The 1941 Butt Report used photographs to measure results and showed how often crews missed their aiming points. Many bombs fell far from the intended target, which pushed the RAF toward attacks on wider industrial areas rather than single buildings. This did not mean the RAF gave up trying to improve accuracy. In 1942 it created the Pathfinder Force, made up of selected crews who flew ahead of the main bomber group. Their job was to locate the target and mark it with flares and target indicators. They also received navigation systems such as Gee, Oboe, and H2S earlier than many other units. In 1943, the force was redesignated No. 8 Group, with the motto “We Guide to Strike”. The Pathfinders helped concentrate area bombardment and reduced the waste caused by scattered bombing.","faction":"Britain","type":"order","rarity":"Common","cost":6,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_area_bombardment","title":{"Namespace":"card_britain","Key":"card_event_area_bombardment_title","SourceString":"AREA BOMBARDMENT","LocalizedString":"AREA BOMBARDMENT"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Britain","kredits":6,"Text":{"Namespace":"card_britain","Key":"card_event_area_bombardment_text","SourceString":"Add a LANCASTER Mk I to your support line. Shuffle it into your deck at the end of turn.","LocalizedString":"Add a LANCASTER Mk I to your support line. Shuffle it into your deck at the end of turn."},"flavorText":{"Namespace":"card_britain","Key":"card_event_area_bombardment_history","SourceString":"Area bombardment became a central part of RAF Bomber Command’s night war against Germany. Early hopes of striking individual factories or military targets often failed due to darkness and poor weather. The 1941 Butt Report used photographs to measure results and showed how often crews missed their aiming points. Many bombs fell far from the intended target, which pushed the RAF toward attacks on wider industrial areas rather than single buildings. This did not mean the RAF gave up trying to improve accuracy. In 1942 it created the Pathfinder Force, made up of selected crews who flew ahead of the main bomber group. Their job was to locate the target and mark it with flares and target indicators. They also received navigation systems such as Gee, Oboe, and H2S earlier than many other units. In 1943, the force was redesignated No. 8 Group, with the motto “We Guide to Strike”. The Pathfinders helped concentrate area bombardment and reduced the waste caused by scattered bombing.","LocalizedString":"Area bombardment became a central part of RAF Bomber Command’s night war against Germany. Early hopes of striking individual factories or military targets often failed due to darkness and poor weather. The 1941 Butt Report used photographs to measure results and showed how often crews missed their aiming points. Many bombs fell far from the intended target, which pushed the RAF toward attacks on wider industrial areas rather than single buildings. This did not mean the RAF gave up trying to improve accuracy. In 1942 it created the Pathfinder Force, made up of selected crews who flew ahead of the main bomber group. Their job was to locate the target and mark it with flares and target indicators. They also received navigation systems such as Gee, Oboe, and H2S earlier than many other units. In 1943, the force was redesignated No. 8 Group, with the motto “We Guide to Strike”. The Pathfinders helped concentrate area bombardment and reduced the waste caused by scattered bombing."},"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::OceaniaStorm","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"spawnCardName":"card_unit_lancaster","soundEnterPlay":{"ObjectName":"SoundCue'War_UI_Drum_Movement_Field_Snares_3_Cue'","ObjectPath":"kards/Content/War_UI/Cues/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3_Cue.0"},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/AREA_BOMBARDMENT.AREA_BOMBARDMENT","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_event_area_bombardment_photo","SourceString":"A formation of Wellington bombers over Stradishall, 1939.","LocalizedString":"A formation of Wellington bombers over Stradishall, 1939."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_event_area_bombardment","owner":"card_event_area_bombardment_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_text_Variable","type":"FText","direction":"in"},{"name":"K2Node_Event_turnnumber","type":"int32","direction":"in"},{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_SpawnCardOnBattlefield_spawnedCardID","type":"int32","direction":"in"},{"name":"CallFunc_JSON_SetInt_found","type":"bool","direction":"in"},{"name":"CallFunc_JSON_GetInt_value","type":"int32","direction":"in"},{"name":"CallFunc_JSON_GetInt_found","type":"bool","direction":"in"},{"name":"CallFunc_MoveCardToTopOfOwnersDeck_qqq","type":"int32","direction":"in"},{"name":"CallFunc_ShuffleDeckBySide_qqq","type":"bool","direction":"in"},{"name":"CallFunc_JSON_Clear_found","type":"bool","direc