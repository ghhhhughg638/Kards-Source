{"format":"kards-original-reference","version":1,"id":"ba5bd53be152a040","name":"card_event_defend_in_depth","package":"/Game/Blueprints/Cards/France/events/card_event_defend_in_depth","parent":"UBaseCardObject","card":{"title":"DEFEND IN DEPTH","text":"Deal damage to target unit equal to cards in the enemy hand.","flavorText":"Defense in depth, also known as elastic defense, is a military strategy which aims at delaying the attackers advance rather than trying to stop it altogether. Rather than having one line of defense, the defense in depth tactic focuses on having multiple lines of fortified defenses, each protecting the other, and aims at weakening the enemy over time. The French had built the Maginot line in the 1930s, which was an elaborate chain of concrete fortifications along the German border. However, since the defenses did not cover the French-Belgian border, the Germans bypassed it by invading Belgium first and from there they crossed over to France.","faction":"France","type":"order","rarity":"Uncommon","cost":3,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_defend_in_depth","title":{"Namespace":"card_france","Key":"card_event_defend_in_depth_title","SourceString":"DEFEND IN DEPTH","LocalizedString":"DEFEND IN DEPTH"},"Type":"ETypeEnum::order","faction":"EFactionEnum::France","kredits":3,"Text":{"Namespace":"card_france","Key":"card_event_defend_in_depth_text","SourceString":"Deal damage to target unit equal to cards in the enemy hand.","LocalizedString":"Deal damage to target unit equal to cards in the enemy hand."},"flavorText":{"Namespace":"card_france","Key":"card_event_defend_in_depth_history","SourceString":"Defense in depth, also known as elastic defense, is a military strategy which aims at delaying the attackers advance rather than trying to stop it altogether. Rather than having one line of defense, the defense in depth tactic focuses on having multiple lines of fortified defenses, each protecting the other, and aims at weakening the enemy over time. The French had built the Maginot line in the 1930s, which was an elaborate chain of concrete fortifications along the German border. However, since the defenses did not cover the French-Belgian border, the Germans bypassed it by invading Belgium first and from there they crossed over to France.","LocalizedString":"Defense in depth, also known as elastic defense, is a military strategy which aims at delaying the attackers advance rather than trying to stop it altogether. Rather than having one line of defense, the defense in depth tactic focuses on having multiple lines of fortified defenses, each protecting the other, and aims at weakening the enemy over time. The French had built the Maginot line in the 1930s, which was an elaborate chain of concrete fortifications along the German border. However, since the defenses did not cover the French-Belgian border, the Germans bypassed it by invading Belgium first and from there they crossed over to France."},"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Breakthrough","isInPermanentPool":true,"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_4'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_4.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/France/t_french_army_mixed.t_french_army_mixed","SubPathString":""},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/DEFENSE_IN_DEPTH.DEFENSE_IN_DEPTH","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":384.0},"historyPhotoDescription":{"Namespace":"card_france","Key":"card_event_defend_in_depth_photo","SourceString":"French troops march on top of a fortification of the Maginot line, 1938.","LocalizedString":"French troops march on top of a fortification of the Maginot line, 1938."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","