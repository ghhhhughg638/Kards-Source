{"format":"kards-original-reference","version":1,"id":"46d8e583b3ee8c38","name":"card_event_secret_operatives","package":"/Game/Blueprints/Cards/Britain/Allegiance/events/card_event_secret_operatives","parent":"UBaseCardObject","card":{"title":"SECRET OPERATIVES","text":"Counter an order that targets a friendly unit. Give the unit +2 defense.","flavorText":"The Special Operations Executive (SOE) was a British organization formed at the start of WWII. Very few people knew of SOE’s existence, but those who were a part of it were also known as “Churchill’s Secret Army”, “The Ministry of Ungentlemanly Warfare” or “Baker Street Irregulars”, named after the location of their London HQ. The SOE operated behind enemy lines in all territories occupied by the Axis and the organization counted 13,000 operatives, both men and women. The purpose of the SOE was to conduct sabotage, espionage, reconnaissance and to aid local resistance movements in the occupied countries. The most famous operations executed by SOE were perhaps the assassination of SS-Obergruppenführer Reinhard Heydrich in Czechoslovakia and the heavy water sabotage in Norway.","faction":"Britain","type":"gotcha","rarity":"Rare","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_secret_operatives","title":{"Namespace":"card_britain","Key":"card_event_secret_operatives_title","SourceString":"SECRET OPERATIVES","LocalizedString":"SECRET OPERATIVES"},"Type":"ETypeEnum::gotcha","faction":"EFactionEnum::Britain","kredits":1,"Text":{"Namespace":"card_britain","Key":"card_event_secret_operatives_text","SourceString":"Counter an order that targets a friendly unit. Give the unit +2 defense.","LocalizedString":"Counter an order that targets a friendly unit. Give the unit +2 defense."},"flavorText":{"Namespace":"card_britain","Key":"card_event_secret_operatives_history","SourceString":"The Special Operations Executive (SOE) was a British organization formed at the start of WW