{"format":"kards-original-reference","version":1,"id":"6e6acda462e9abd5","name":"card_unit_4_pioneer","package":"/Game/Blueprints/Cards/Germany/Base/units/card_unit_4_pioneer","parent":"UBaseCardObject","card":{"title":"4. PIONEER BATTALION","text":"Deployment: Give all friendly ground units in the frontline +1 defense.","flavorText":"German combat pioneers (German: Sturmpioniere) were foremost assault troops and tasked with overcoming man-made and natural obstacles and to support the infantry as specialist assault troops. This included attacking fortified positions with demolitions and flamethrowers. Their job was also to construct fortifications and shelters, place obstacles, lay minefields, plant booby traps, maintain supply routes etc. The 4th Pioneer Battalion was attached to the 13th Infantry Division of the Wehrmacht and first saw combat in the Polish Campaign. They fought in France and on the Eastern Front until they finally surrendered to the American Army in Herford Germany in 1945.","faction":"Germany","type":"infantry","rarity":"Common","cost":1,"operationCost":1,"attack":1,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_4_pioneer","title":{"Namespace":"card_germany","Key":"card_unit_4_pioneer_title","SourceString":"4. PIONEER BATTALION","LocalizedString":"4. PIONEER BATTALION"},"Type":"ETypeEnum::infantry","attack":1,"defense":3,"range":1,"faction":"EFactionEnum::Germany","kredits":1,"Text":{"Namespace":"card_germany","Key":"card_unit_4_pioneer_text","SourceString":"Deployment: Give all friendly ground units in the frontline +1 defense.","LocalizedString":"Deployment: Give all friendly ground units in the frontline +1 defense."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_4_pioneer_history","SourceString":"German combat pioneers (German: Sturmpioniere) were foremost assault troops and tasked with overcoming man-made and natural obstacles and to support the infantry as specialist assault troops. This included attacking fortified positions with demolitions and flamethrowers. Their job was also to construct fortifications and shelters, place obstacles, lay minefields, plant booby traps, maintain supply routes etc. The 4th Pioneer Battalion was attached to the 13th Infantry Division of the Wehrmacht and first saw combat in the Polish Campaign. They fought in France and on the Eastern Front until they finally surrendered to the American Army in Herford Germany in 1945.","LocalizedString":"German combat pioneers (German: Sturmpioniere) were foremost assault troops and tasked with overcoming man-made and natural obstacles and to support the infantry as specialist assault troops. This included attacking fortified positions with demolitions and flamethrowers. Their job was also to construct fortifications and shelters, place obstacles, lay minefields, plant booby traps, maintain supply routes etc. The 4th Pioneer Battalion was attached to the 13th Infantry Division of the Wehrmacht and first saw combat in the Polish Campaign. They fought in France and on the Eastern Front until they finally surrendered to the American Army in Herford Germany in 1945."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Basic","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion02'","ObjectPath":"kards/Content/StarterContent/Audio/Explosion02.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/t_engineers_3.t_engineers_3","SubPathString":""},"ImageAnchor":"EImageAnchor::Top","artist":"Look and Learn / Elgar Collection","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/COMBAT_ENGINEERS.COMBAT_ENGINEERS","SubPathString":""},"historyPhotoSize":{"X":357.0,"Y":512.0},"historyPhotoSource":"German Federal Archive","historyPhotoIdentificationCode":"183-J08355","historyPhotoAuthor":"Schwahn","historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_4_pione