{"format":"kards-original-reference","version":1,"id":"aa80f88df2738acd","name":"card_unit_cruiser_mk_iii","package":"/Game/Blueprints/Cards/Britain/Breakthrough/units/card_unit_cruiser_mk_iii","parent":"UBaseCardObject","card":{"title":"CRUISER Mk III","text":"Pincer: +2 attack.","flavorText":"The Cruiser tank, also known as A13 Mark I, was a British cruiser tank used by the British Army during WWII. The Mk I and Mk II versions were first developed in the mid 1930s and it was the first British cruiser tank to use the Christie suspension system which gave it high speed and good off road performance. The Mk III variant came into service in 1939, it had a crew of 4 (commander, gunner, loader, driver), weighed 14 tons and had a top speed of 48 km/h. For main armament it used a QF 2-pounder gun and a .303 Vickers machine gun for secondary armament. The Cruiser Mk III did live up to its speed requirements, but it was mechanically unreliable and the armor was insufficient which made it vulnerable in combat. Only 65 Mk III’s were produced.","faction":"Britain","type":"tank","rarity":"Uncommon","cost":4,"operationCost":1,"attack":2,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_cruiser_mk_iii","title":{"Namespace":"card_britain","Key":"card_unit_cruiser_mk_iii_title","SourceString":"CRUISER Mk III","LocalizedString":"CRUISER Mk III"},"Type":"ETypeEnum::tank","attack":2,"defense":5,"range":1,"faction":"EFactionEnum::Britain","kredits":4,"Text":{"Namespace":"card_britain","Key":"card_unit_cruiser_mk_iii_text","SourceString":"Pincer: +2 attack.","LocalizedString":"Pincer: +2 attack."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_cruiser_mk_iii_history","SourceString":"The Cruiser tank, also known as A13 Mark I, was a British cruiser tank used by the British Army during WWII. The Mk I and Mk II versions were first developed in the mid 1930s and it was the first British cruiser tank to use the Christie suspension system which gave it high speed and good off road performance. The Mk III variant came into service in 1939, it had a crew of 4 (commander, gunner, loader, driver), weighed 14 tons and had a top speed of 48 km/h. For main armament it used a QF 2-pounder gun and a .303 Vickers machine gun for secondary armament. The Cruiser Mk III did live up to its speed requirements, but it was mechanically unreliable and the armor was insufficient which made it vulnerable in combat. Only 65 Mk III’s were produced.","LocalizedString":"The Cruiser tank, also known as A13 Mark I, was a British cruiser tank used by the British Army during WWII. The Mk I and Mk II versions were first developed in the mid 1930s and it was the first British cruiser tank to use the Christie suspension system which gave it high speed and good off road performance. The Mk III variant came into service in 1939, it had a crew of 4 (commander, gunner, loader, driver), weighed 14 tons and had a top speed of 48 km/h. For main armament it used a QF 2-pounder gun and a .303 Vickers machine gun for secondary armament. The Cruiser Mk III did live up to its speed requirements, but it was mechanically unreliable and the armor was insufficient which made it vulnerable in combat. Only 65 Mk III’s were produced."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Breakthrough","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Pincer"],"draftBaseWeight":1.4,"hasPincer":true,"soundBlowUp":{"ObjectName":"SoundWave'explosion_large_01'","ObjectPath":"kards/Content/ExplosionSoundPack/ExplosionSounds/Wavs/explosion_large_01.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/Breakthrough/t_crusader_iii_a13.t_crusader_iii_a13","SubPathString":""},"artist":"Jarosław Wróbel","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/Cruiser_Mk_III.Cruiser_Mk_III","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":343.0},"historyPhotoDescription":{"Namespace":"c