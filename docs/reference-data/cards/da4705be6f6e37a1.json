{"format":"kards-original-reference","version":1,"id":"da4705be6f6e37a1","name":"card_event_hms_belfast","package":"/Game/Blueprints/Cards/Britain/NavalWarfare/events/card_event_hms_belfast","parent":"UBaseCardObject","card":{"title":"HMS BELFAST","text":"Put a unit on top of owner's deck. Shuffle the deck if there is a Navy card on top of your deck.","flavorText":"HMS Belfast was a British Royal Navy light cruiser launched in 1938 which played a significant role during WWII. Early in the war, the ship was damaged by a German mine and spent over two years undergoing repairs. She returned to action in 1942, equipped with advanced radar and heavy artillery, and at first her main role was to escort Arctic convoys to the Soviet Union where vital supplies were delivered for the Allied war effort on the Eastern Front. In December 1943, Belfast took part in the Battle of North Cape where she helped to sink the German battlecruiser Scharnhorst. Later it participated in Operation Tungsten, which was a major Fleet Air Arm strike on the German battleship Tirpitz. Most famously, HMS Belfast was one of the first ships to open fire on D-Day, bombarding German positions to support Allied landings on the beaches of Normandy. After the war, HMS Belfast served in Korea before being retired. Today, she is preserved as a museum ship on the river Thames in London where her wartime service is commemorated.","faction":"Britain","type":"order","rarity":"Rare","cost":4,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"GameplayTags":["subtype.navy"],"Name":"card_event_hms_belfast","title":{"Namespace":"card_britain","Key":"card_event_hms_belfast_title","SourceString":"HMS BELFAST","LocalizedString":"HMS BELFAST"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Britain","kredits":4,"Text":{"Namespace":"card_britain","Key":"card_event_hms_belfast_text","SourceString":"Put a unit on top of owner's deck. Shuffle the deck if there is a Navy card on top of your deck.","LocalizedString":"Put a unit on top of owner's deck. Shuffle the deck if there is a Navy card on top of your deck."},"flavorText":{"Namespace":"card_britain","Key":"card_event_hms_belfast_history","SourceString":"HMS Belfast was a British Royal Navy light cruiser launched in 1938 which played a significant role during WWII. Early in the war, the ship was damaged by a German mine and spent over two years undergoing repairs. She returned to action in 1942, equipped with advanced radar and heavy artillery, and at first her main role was to escort Arctic convoys to the Soviet Union where vital supplies were delivered for the Allied war effort on the Eastern Front. In December 1943, Belfast took part in the Battle of North Cape where she helped to sink the German battlecruiser Scharnhorst. Later it participated in Operation Tungsten, which was a major Fleet Air Arm strike on the German battleship Tirpitz. Most famously, HMS Belfast was one of the first ships to open fire on D-Day, bombarding German positions to support Allied landings on the beaches of Normandy. After the war, HMS Belfast served in Korea before being retired. Today, she is preserved as a museum ship on the river Thames in London where her wartime service is commemorated.","LocalizedString":"HMS Belfast was a British Royal Navy light cruiser launched in 1938 which played a significant role during WWII. Early in the war, the ship was damaged by a German mine and spent over two years undergoing repairs. She returned to action in 1942, equipped with advanced radar and heavy artillery, and at first her main role was to escort Arctic convoys to the Soviet Union where vital supplies were delivered for the Allied war effort on the Eastern Front. In December 1943, Belfast took part in the Battle of North Cape where she helped to sink the German battlecruiser Scharnhorst. Later it participated in Operation Tungsten, which was a major Fleet Air Arm strike on the German battleship Tirpitz. Most famously, HMS Belfast was one of the first ships to open fire on D-Day, bombarding German positions to support Allied landings on the beaches of Normandy. After the war, HMS Belfast served in Korea before being retired. Today, she is preserved as a museum ship on the river Thames in London where her wartime service is commemorated."},"rarity":"ERarityEnum::Rare","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::NavalWarfare","soundEnterPlay":{"ObjectName":"SoundWave'Naval_Support_17'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Naval_Support_17.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/NavalWarfare/t_hms_belfast.t_hms_belfast","SubPathString":""},"artist":"Robert Taylor","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/HMS_BELFAST.HMS_BELFAST","SubPathString":""},"historyPhotoSize":{"X":390.0,"Y":512.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_event_hms_belfast_photo","SourceString":"HMS Belfast bombarding German positions in Normandy at night, June 1944.","LocalizedString":"HMS Belfast bombarding German positions in Normandy at night, June 1944."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""}},"variables":[{"name":"tmpCard","type":"UBaseCardObject*","direction":"in"},{"name":"shouldShuffle","type":"bool","direction":"in"}],"functions":[{"name":"CanPlayFromHand","owner":"card_event_hms_belfast_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","direction":"in"},{"name":"CallFunc_Ge