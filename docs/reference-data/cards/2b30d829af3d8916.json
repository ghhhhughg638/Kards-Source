{"format":"kards-original-reference","version":1,"id":"2b30d829af3d8916","name":"card_unit_layforce","package":"/Game/Blueprints/Cards/Britain/Homefront/units/card_unit_layforce","parent":"UBaseCardObject","card":{"title":"LAYFORCE","text":"Your non-British cards cost +1. Gets +1+1 when the enemy targets or attacks it.","flavorText":"Layforce was a temporary commando formation created in early 1941 to strike Axis positions across the Mediterranean. Named after its commander, Colonel Robert Laycock, the unit drew men from several British commando battalions, including No. 3, No. 7, No. 8 (Guards), No. 11 (Scottish), No. 50 and No. 52 Commandos. Initially intended for raids on enemy-held islands like Rhodes, Layforce instead found itself pressed into more conventional roles as the Allied situation worsened. In March 1941, elements of Layforce took part in the Bardia raid in Libya. In May, they were rushed to Crete where they fought fiercely during the German airborne invasion but suffered heavy casualties. Later that summer, they supported regular troops in the Syria-Lebanon campaign and helped defend Tobruk, notably participating in a daring assault known as the Twin Pimples raid. In August 1941, the unit was disbanded, its survivors moving on to other special forces like the SAS and the Special Boat Section. Though short-lived, Layforce proved the value of unconventional troops in the Mediterranean theater.","faction":"Britain","type":"infantry","rarity":"Common","cost":1,"operationCost":1,"attack":2,"defense":2},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.bond","subtype.commando"],"Name":"card_unit_layforce","title":{"Namespace":"card_britain","Key":"card_unit_layforce_title","SourceString":"LAYFORCE","LocalizedString":"LAYFORCE"},"Type":"ETypeEnum::infantry","attack":2,"defense":2,"range":1,"faction":"EFactionEnum::Britain","kredits":1,"Text":{"Namespace":"card_britain","Key":"card_unit_layforce_text","SourceString":"Your non-British cards cost +1. Gets +1+1 when the enemy targets or attacks it.","LocalizedString":"Your non-British cards cost +1. Gets +1+1 when the enemy targets or attacks it."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_layforce_history","SourceString":"Layforce was a temporary commando formation created in early 1941 to strike Axis positions across the Mediterranean. Named after its commander, Colonel Robert Laycock, the unit drew men from several British commando battalions, including No. 3, No. 7, No. 8 (Guards), No. 11 (Scottish), No. 50 and No. 52 Commandos. Initially intended for raids on enemy-held islands like Rhodes, Layforce instead found itself pressed into more conventional roles as the Allied situation worsened. In March 1941, elements of Layforce took part in the Bardia raid in Libya. In May, they were rushed to Crete where they fought fiercely during the German airborne invasion but suffered heavy casualties. Later that summer, they supported regular troops in the Syria-Lebanon campaign and helped defend Tobruk, notably participating in a daring assault known as the Twin Pimples raid. In August 1941, the unit was disbanded, its survivors moving on to other special forces like the SAS and the Special Boat Section. Though short-lived, Layforce proved the value of unconventional troops in the Mediterranean theater.","LocalizedString":"Layforce was a temporary commando formation created in early 1941 to strike Axis positions across the Mediterranean. Named after its commander, Colonel Robert Laycock, the unit drew men from several British commando battalions, including No. 3, No. 7, No. 8 (Guards), No. 11 (Scottish), No. 50 and No. 52 Commandos. Initially intended for raids on enemy-held islands like Rhodes, Layforce instead found itself pressed into more conventional roles as the Allied situation worsened. In March 1941, elements of Layforce took part in the Bardia raid in Libya. In May, they were rushed to Crete where they fought fiercely during the German airborne invasion but suffered heavy casualties. Later that summer, they supported regular troops in the Syria-Lebanon campaign and helped defend Tobruk, notably participating in a daring assault known as the Twin Pimples raid. In August 1941, the unit was disbanded, its survivors moving on to other special forces like the SAS and the Special Boat Section. Though short-lived, Layforce proved the value of unconventional troops in the Mediterranean theater."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnBeforeOtherCardAttacks","ERegisteredCardFunction::OnOtherCardReset","ERegisteredCardFunction::OnOtherCardSpawnedInHand","ERegisteredCardFunction::OnOtherCardDrawnFromDeck","ERegisteredCardFunction::OnOtherCardPlayedFromHand","ERegisteredCardFunction::OnBeforeOtherCardPlayedFromHand"],"hasBlitz":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/LAYFORCE.LAYFORCE","SubPathString":""},"historyPhotoSize":{"X":389.0,"Y":512.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_unit_layforce_photo","SourceString":"British Royal Navy commandos during a drill off the coast of England, 1944.","LocalizedString":"British Royal Navy commandos during a drill off the coast of England, 1944."},"historyTypeDescription":{"Namespace":"","Key":"0DBC5F184A8F0CFAA1A9D6BB449E2AC6","SourceString":"Infantry","LocalizedString":"Infantry"},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"tempCardID","type":"int32","direction":"in"}