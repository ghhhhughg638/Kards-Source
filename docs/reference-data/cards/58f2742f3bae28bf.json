 fresh eggs. These gardens transformed neighborhoods into productive spaces and helped maintain morale during a time of scarcity."},"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::Homefront","usedTriggers":["ERegisteredCardFunction::OnOtherCardDestroyed"],"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/10_Homefront/T_victory_garden.T_victory_garden","SubPathString":""},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/VICTORY_GARDEN.VICTORY_GARDEN","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_event_victory_garden_photo","SourceString":"Children working in their school’s Victory Garden, New York, USA, June 1944.","LocalizedString":"Children working in their school’s Victory Garden, New York, USA, June 1944."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"isAttackBuff":true,"isDefenseBuff":true},"variables":[{"name":"TempCard","type":"UBaseCardObject*","direction":"in"},{"name":"unitOnTop","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_victory_garden","owner":"card_event_victory_garden_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_bool_Variable","type":"bool","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"Temp_bool_True_if_break_was_hit_Variable","type":"bool","direction":"in"},{"name":"Temp_int_Array_Index_Variable_1","type":"int32","direction":"in"},{"name":"CallFu