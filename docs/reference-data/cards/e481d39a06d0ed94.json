{"format":"kards-original-reference","version":1,"id":"e481d39a06d0ed94","name":"card_unit_74_panzergrenadier","package":"/Game/Blueprints/Cards/Germany/Homefront/units/card_unit_74_panzergrenadier","parent":"UBaseCardObject","card":{"title":"74. PANZERGRENADIER","text":"Deployment: Send a friendly unit to hand. Gets +1+1 if you do.","flavorText":"The 74th Panzergrenadier Regiment was a unit of the 19th Panzer Division, formed in late 1940. The division participated in Germany's push into the Soviet Union during Operation Barbarossa in 1941. By the end of the first summer, the division had suffered such losses that one of its three tank battalions was disbanded. Throughout the war, the division fought in grueling battles, including Moscow in 1941 and Kursk in 1943. During the harsh winter of 1941-42, further losses reduced the division's armored strength. As the frontlines shifted, the division was redeployed to support Axis defenses along the Don in 1942 and during the brutal retreat westward through Ukraine and Poland. In 1944, its units were briefly pulled back to the Netherlands for refitting. By 1945, the division was fighting in the desperate defense of Germany, including the Vistula-Oder and Prague offensives. It finally surrendered to Soviet forces in Czechoslovakia in May 1945.","faction":"Germany","type":"infantry","rarity":"Common","cost":2,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.bond"],"Name":"card_unit_74_panzergrenadier","title":{"Namespace":"card_germany","Key":"card_unit_74_panzergrenadier_title","SourceString":"74. PANZERGRENADIER","LocalizedString":"74. PANZERGRENADIER"},"Type":"ETypeEnum::infantry","attack":2,"defense":3,"range":1,"faction":"EFactionEnum::Germany","kredits":2,"Text":{"Namespace":"card_germany","Key":"card_unit_74_panzergrenadier_text","SourceString":"Deployment: Send a friendly unit to hand. Gets +1+1 if you do.","LocalizedString":"Deployment: Send a friendly unit to hand. Gets +1+1 if you do."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_74_panzergrenadier_history","SourceString":"The 74th Panzergrenadier Regiment was a unit of the 19th Panzer Division, formed in late 1940. The division participated in Germany's push into the Soviet Union during Operation Barbarossa in 1941. By the end of the first summer, the division had suffered such losses that one of its three tank battalions was disbanded. Throughout the war, the division fought in grueling battles, including Moscow in 1941 and Kursk in 1943. During the harsh winter of 1941-42, further losses reduced the division's armored strength. As the frontlines shifted, the division was redeployed to support Axis defenses along the Don in 1942 and during the brutal retreat westward through Ukraine and Poland. In 1944, its units were briefly pulled back to the Netherlands for refitting. By 1945, the division was fighting in the desperate defense of Germany, including the Vistula-Oder and Prague offensives. It finally surrendered to Soviet forces in Czechoslovakia in May 1945.","LocalizedString":"The 74th Panzergrenadier Regiment was a unit of the 19th Panzer Division, formed in late 1940. The division participated in Germany's push into the Soviet Union during Operation Barbarossa in 1941. By the end of the first summer, the division had suffered such losses that one of its three tank battalions was disbanded. Throughout the war, the division fought in grueling battles, including Moscow in 1941 and Kursk in 1943. During the harsh winter of 1941-42, further losses reduced the division's armored strength. As the frontlines shifted, the division was redeployed to support Axis defenses along the Don in 1942 and during the brutal retreat westward through Ukraine and Poland. In 1944, its units were briefly pulled back to the Netherlands for refitting. By 1945, the division was fighting in the desperate defense of Germany, including the Vistula-Oder and Prague offensives. It finally surrendered to Soviet forces in Czechoslovakia in May 1945."},"operationCost":1,"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Homefront","hasDeployment":true,"hasBlitz":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/74__PANZERGRENADIER.74__PANZERGRENADIER","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":356.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_74_panzergrenadier_photo","SourceString":"Panzergrenadiers of the 19th Panzer Division in a trench in Ukraine, July 1942.","LocalizedString":"Panzergrenadiers of the 19th Panzer Division in a trench in Ukraine, July 1942."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"CanPlayFromHand","owner":"card_unit_74_panzergrenadier_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","direction":"in"},{"name":"CallFunc_GetTargetedCard_card","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_IsSameSideUnit_isIt","type":"bool","direction":"in"}],"body":[{"op":"Context","at":0,"object":{"op":"Variable","name":"cardFunction","type":"ACardFunctions