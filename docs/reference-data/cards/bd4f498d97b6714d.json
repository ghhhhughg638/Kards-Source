{"format":"kards-original-reference","version":1,"id":"bd4f498d97b6714d","name":"card_unit_6th_brigade_nz","package":"/Game/Blueprints/Cards/ANZAC/units/card_unit_6th_brigade_nz","parent":"UBaseCardObject","card":{"title":"6th BRIGADE NZ","text":"Deployment: Becomes Veteran if deployed from right-most in hand.","flavorText":"The 6th Infantry Brigade was part of the 2nd New Zealand Division during WWII. The brigade was formed in 1940, shipped to the Middle East and trained in Egypt before joining the 2nd Division’s first major operations. In Greece, the brigade held positions on the Aliakmon Line, then withdrew through Olympus Pass as German forces advanced. It helped cover the Allied evacuation and embarked from Monemvasia in April 1941. In North Africa, the brigade fought in Operation Crusader and was heavily engaged around Sidi Rezegh. Its battalions attacked Point 175 and suffered severe losses when surrounded during the fighting near Tobruk. The brigade later served at El Alamein, where it held defensive positions before taking part in the wider Eighth Army offensive. It pushed west through Libya and Tunisia, fighting  in battles such as El Agheila and the Tebaga Gap. In Italy, the brigade crossed the Sangro River, fought around Orsogna, and attacked Cassino in 1944. During the final 1945 offensive, it crossed several northern Italian rivers before reaching the Trieste area. It was disbanded in late 1945.","faction":"Anzac","type":"infantry","rarity":"Common","cost":3,"operationCost":1,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_6th_brigade_nz","title":{"Namespace":"card_anzac","Key":"card_unit_6th_brigade_nz_title","SourceString":"6th BRIGADE NZ","LocalizedString":"6th BRIGADE NZ"},"Type":"ETypeEnum::infantry","attack":3,"defense":4,"range":1,"faction":"EFactionEnum::Anzac","kredits":3,"Text":{"Namespace":"card_anzac","Key":"card_unit_6th_brigade_nz_text","SourceString":"Deployment: Becomes Veteran if deployed from right-most in hand.","LocalizedString":"Deployment: Becomes Veteran if deployed from right-most in hand."},"flavorText":{"Namespace":"card_anzac","Key":"card_unit_6th_brigade_nz_history","SourceString":"The 6th Infantry Brigade was part of the 2nd New Zealand Division during WWII. The brigade was formed in 1940, shipped to the Middle East and trained in Egypt before joining the 2nd Division’s first major operations. In Greece, the brigade held positions on the Aliakmon Line, then withdrew through Olympus Pass as German forces advanced. It helped cover the Allied evacuation and embarked from Monemvasia in April 1941. In North Africa, the brigade fought in Operation Crusader and was heavily engaged around Sidi Rezegh. Its battalions attacked Point 175 and suffered severe losses when surrounded during the fighting near Tobruk. The brigade later served at El Alamein, where it held defensive positions before taking part in the wider Eighth Army offensive. It pushed west through Libya and Tunisia, fighting  in battles such as El Agheila and the Tebaga Gap. In Italy, the brigade crossed the Sangro River, fought around Orsogna, and attacked Cassino in 1944. During the final 1945 offensive, it crossed several northern Italian rivers before reaching the Trieste area. It was disbanded in late 1945.","LocalizedString":"The 6th Infantry Brigade was part of the 2nd New Zealand Division during WWII. The brigade was formed in 1940, shipped to the Middle East and trained in Egypt before joining the 2nd Division’s first major operations. In Greece, the brigade held positions on the Aliakmon Line, then withdrew through Olympus Pass as German forces advanced. It helped cover the Allied evacuation and embarked from Monemvasia in April 1941. In North Africa, the brigade fought in Operation Crusader and was heavily engaged around Sidi Rezegh. Its battalions attacked Point 175 and suffered severe losses when surrounded during the fighting near Tobruk. The brigade later served at El Alamein, where it held defensive positions before taking part in the wider Eighth Army offensive. It pushed west through Libya and Tunisia, fighting  in battles such as El Agheila and the Tebaga Gap. In Italy, the brigade crossed the Sangro River, fought around Orsogna, and attacked Cassino in 1944. During the final 1945 offensive, it crossed several northern Italian rivers before reaching the Trieste area. It was disbanded in late 1945."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::OceaniaStorm","isInPermanentPool":true,"usedTriggers":["ERegisteredCardFunction::OnOtherCardBecomingVeteran"],"hasDeployment":true,"hasBlitz":true,"spawnCardName":"card_unit_6th_brigade_nz_vet","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/6th_BRIGADE_NZ.6th_BRIGADE_NZ","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_anzac","Key":"card_unit_6th_brigade_nz_photo","SourceString":"Men of the 6th Brigade marching through the village of Barbiano, Italy, 1945.","LocalizedString":"Men of the 6th Brigade marching through the village of Barbiano, Italy, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_6th_brigade_nz","owner":"card_unit_6th_brigade_nz_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_WasRightMostCardWhenPlayedFromHand_WasRightMost","type":"bool","direction":"i