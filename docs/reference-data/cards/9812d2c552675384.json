{"format":"kards-original-reference","version":1,"id":"9812d2c552675384","name":"card_unit_909th_roslavl","package":"/Game/Blueprints/Cards/Soviet/OceaniaStorm/units/card_unit_909th_roslavl","parent":"UBaseCardObject","card":{"title":"909th ROSLAVL","text":"Your infantry have Blitz.","flavorText":"The 909th Rifle Regiment was one of the original infantry regiments of the Soviet 247th Rifle Division. The division was first formed in 1941 from NKVD personnel, then placed under Red Army command. It first fought during the Battle of Moscow, but was caught in the Vyazma encirclement during Operation Typhoon. Survivors broke out in small groups, and the division was soon disbanded. A second 247th Rifle Division was formed in late 1941 with the 909th Regiment again in its order of battle. It fought through the hard battles around Rzhev, crossed the Vazuza River during Operation Mars and briefly gained ground before suffering heavy losses. In 1943, the division joined the Smolensk offensive. It advanced across the Desna River and helped liberate Roslavl in September, earning the honorific title “Roslavl”. The division later fought through Belorussia, Poland, and Germany. In 1945, the 909th Regiment received honors for its actions in Brandenburg and Berlin, while the division was decorated with the Order of the Red Banner.","faction":"Soviet","type":"infantry","rarity":"Unique","cost":5,"operationCost":1,"attack":3,"defense":8},"defaults":{"UberGraphFrame":{},"Name":"card_unit_909th_roslavl","title":{"Namespace":"card_soviet","Key":"card_unit_909th_roslavl_title","SourceString":"909th ROSLAVL","LocalizedString":"909th ROSLAVL"},"Type":"ETypeEnum::infantry","attack":3,"defense":8,"range":1,"faction":"EFactionEnum::Soviet","kredits":5,"Text":{"Namespace":"card_soviet","Key":"card_unit_909th_roslavl_text","SourceString":"Your infantry have Blitz.","LocalizedString":"Your infantry have Blitz."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_909th_roslavl_history","SourceString":"The 909th Rifle Regiment was one of the original infantry regiments of the Soviet 247th Rifle Division. The division was first formed in 1941 from NKVD personnel, then placed under Red Army command. It first fought during the Battle of Moscow, but was caught in the Vyazma encirclement during Operation Typhoon. Survivors broke out in small groups, and the division was soon disbanded. A second 247th Rifle Division was formed in late 1941 with the 909th Regiment again in its order of battle. It fought through the hard battles around Rzhev, crossed the Vazuza River during Operation Mars and briefly gained ground before suffering heavy losses. In 1943, the division joined the Smolensk offensive. It advanced across the Desna River and helped liberate Roslavl in September, earning the honorific title “Roslavl”. The division later fought through Belorussia, Poland, and Germany. In 1945, the 909th Regiment received honors for its actions in Brandenburg and Berlin, while the division was decorated with the Order of the Red Banner.","LocalizedString":"The 909th Rifle Regiment was one of the original infantry regiments of the Soviet 247th Rifle Division. The division was first formed in 1941 from NKVD personnel, then placed under Red Army command. It first fought during the Battle of Moscow, but was caught in the Vyazma encirclement during Operation Typhoon. Survivors broke out in small groups, and the division was soon disbanded. A second 247th Rifle Division was formed in late 1941 with the 909th Regiment again in its order of battle. It fought through the hard battles around Rzhev, crossed the Vazuza River during Operation Mars and briefly gained ground before suffering heavy losses. In 1943, the division joined the Smolensk offensive. It advanced across the Desna River and helped liberate Roslavl in September, earning the honorific title “Roslavl”. The division later fought through Belorussia, Poland, and Germany. In 1945, the 909th Regiment received honors for its actions in Brandenburg and Berlin, while the division was decorated with the Order of the Red Banner."},"operationCost":1,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardEnterPlay","ERegisteredCardFunction::OnOtherCardAblitiesChanged","ERegisteredCardFunction::OnAfterOtherCardSuppressed"],"hasGuard":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/909th_ROSLAVL.909th_ROSLAVL","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_909th_roslavl_photo","SourceString":"Red Army infantry during street combat in Berlin, 1945.","LocalizedString":"Red Army infantry during street combat in Berlin, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"tempCard","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_909th_roslavl","owner":"card_unit_909th_roslavl_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable_1","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue_1","type":"int32","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Array_Index_Variable_1","type":"