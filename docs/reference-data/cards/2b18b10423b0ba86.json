{"format":"kards-original-reference","version":1,"id":"2b18b10423b0ba86","name":"card_unit_102_rifles","package":"/Game/Blueprints/Cards/Soviet/OceaniaStorm/units/card_unit_102_rifles","parent":"UBaseCardObject","card":{"title":"102nd RIFLES","text":"Becomes Veteran at the start of your turn. Destruction: Draw a card.","flavorText":"The 102nd Rifle Regiment served as part of the Soviet 41st Rifle Division. The division had been formed at Kryvyi Rih before the war and entered the German Soviet War in June 1941 with the 6th Army on the Southwestern Front. It was destroyed near Kiev during the disastrous defeat in September 1941. Recreated at Chapayevsk in March 1942, the 41st Rifle Division was wiped out again near Izyum during the Second Battle of Kharkov in May. A third formation followed in October 1942, built from the 118th Rifle Brigade. This incarnation survived to fight at Kursk, through Belarus and into Poland, including the Lublin-Brest Offensive. Serving with the 69th Army of the 1st Belorussian Front, the division later took part in the Battle of Berlin in April and May 1945. It was disbanded in summer.","faction":"Soviet","type":"infantry","rarity":"Common","cost":3,"operationCost":1,"attack":1,"defense":1},"defaults":{"UberGraphFrame":{},"Name":"card_unit_102_rifles","title":{"Namespace":"card_soviet","Key":"card_unit_102_rifles_title","SourceString":"102nd RIFLES","LocalizedString":"102nd RIFLES"},"Type":"ETypeEnum::infantry","attack":1,"defense":1,"range":1,"faction":"EFactionEnum::Soviet","kredits":3,"Text":{"Namespace":"card_soviet","Key":"card_unit_102_rifles_text","SourceString":"Becomes Veteran at the start of your turn. Destruction: Draw a card.","LocalizedString":"Becomes Veteran at the start of your turn. Destruction: Draw a card."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_102_rifles_history","SourceString":"The 102nd Rifle Regiment served as part of the Soviet 41st Rifle Division. The division had been formed at Kryvyi Rih before the war and entered the German Soviet War in June 1941 with the 6th Army on the Southwestern Front. It was destroyed near Kiev during the disastrous defeat in September 1941. Recreated at Chapayevsk in March 1942, the 41st Rifle Division was wiped out again near Izyum during the Second Battle of Kharkov in May. A third formation followed in October 1942, built from the 118th Rifle Brigade. This incarnation survived to fight at Kursk, through Belarus and into Poland, including the Lublin-Brest Offensive. Serving with the 69th Army of the 1st Belorussian Front, the division later took part in the Battle of Berlin in April and May 1945. It was disbanded in summer.","LocalizedString":"The 102nd Rifle Regiment served as part of the Soviet 41st Rifle Division. The division had been formed at Kryvyi Rih before the war and entered the German Soviet War in June 1941 with the 6th Army on the Southwestern Front. It was destroyed near Kiev during the disastrous defeat in September 1941. Recreated at Chapayevsk in March 1942, the 41st Rifle Division was wiped out again near Izyum during the Second Battle of Kharkov in May. A third formation followed in October 1942, built from the 118th Rifle Brigade. This incarnation survived to fight at Kursk, through Belarus and into Poland, including the Lublin-Brest Offensive. Serving with the 69th Army of the 1st Belorussian Front, the division later took part in the Battle of Berlin in April and May 1945. It was disbanded in summer."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"hasDestruction":true,"spawnCardName":"card_unit_102_rifles_vet;card_event_the_hammer","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/102nd_RIFLES.102nd_RIFLES","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_102_rifles_photo","SourceString":"Red Army infan