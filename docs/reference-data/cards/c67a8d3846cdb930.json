{"format":"kards-original-reference","version":1,"id":"c67a8d3846cdb930","name":"card_event_spars","package":"/Game/Blueprints/Cards/USA/Homefront/events/card_event_spars","parent":"UBaseCardObject","card":{"title":"SPARS","text":"Choose One - Draw the top unit of your deck OR give it Ambush and Shock.","flavorText":"SPARS was the women's reserve of the US Coast Guard during WWII, established in 1942. The name came from the Coast Guard’s motto: Semper Paratus (e. Always Ready). At a time when military branches were expanding women's roles, SPARS was created to free men for sea duty by placing women in shore-based positions. Over 11,000 women served in SPARS, including officers and enlisted personnel. SPARS filled a wide range of roles, from clerical and communications to more technical work like radioman, pharmacist's mate, and parachute rigger. Training initially took place at Oklahoma A&M for enlisted recruits and at the Coast Guard Academy for officers, later moving to Palm Beach and other locations. SPARS recruited primarily white women initially, but by late 1944, African American women were allowed to enlist following policy changes. SPARS units were never deployed overseas, but their work was vital. They handled logistics, intelligence, supply chains, and support roles that ensured the Coast Guard's wartime operations continued smoothly. Disbanded after the war in 1946, SPARS laid groundwork for integrating women more fully into the Coast Guard, which ultimately led to accepting women in 1973.","faction":"USA","type":"order","rarity":"Uncommon","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_spars","title":{"Namespace":"card_usa","Key":"card_event_spars_title","SourceString":"SPARS","LocalizedString":"SPARS"},"Type":"ETypeEnum::order","faction":"EFactionEnum::USA","kredits":1,"Text":{"Namespace":"card_usa","Key":"card_event_spars_text","SourceString":"Choose One - Draw the top unit of your deck OR give it Ambush and Shock.","LocalizedString":"Choose One - Draw the top unit of your deck OR give it Ambush and Shock."},"flavorText":{"Namespace":"card_usa","Key":"card_event_boot_camp_history","SourceString":"SPARS was the women's reserve of the US Coast Guard during WWII, established in 1942. The name came from the Coast Guard’s motto: Semper Paratus (e. Always Ready). At a time when military branches were expanding women's roles, SPARS was created to free men for sea duty by placing women in shore-based positions. Over 11,000 women served in SPARS, including officers and enlisted personnel. SPARS filled a wide range of roles, from clerical and communications to more technical work like radioman, pharmacist's mate, and parachute rigger. Training initially took place at Oklahoma A&M for enlisted recruits and at the Coast Guard Academy for officers, later moving to Palm Beach and other locations. SPARS recruited primarily white women initially, but by late 1944, African American women were allowed to enlist following policy changes. SPARS units were never deployed overseas, but their work was vital. They handled logistics, intelligence, supply chains, and support roles that ensured the Coast Guard's wartime operations continued smoothly. Disbanded after the war in 1946, SPARS laid groundwork for integrating women more fully into the Coast Guard, which ultimately led to accepting women in 1973.","LocalizedString":"SPARS was the women's reserve of the US Coast Guard during WWII, established in 1942. The name came from the Coast Guard’s motto: Semper Paratus (e. Always Ready). At a time when military branches were expanding women's roles, SPARS was created to free men for sea duty by placing women in shore-based positions. Over 11,000 women served in SPARS, including officers and enlisted personnel. SPARS filled a wide range of roles, from clerical and communications to more technical work like radioman, pharmacist's mate, and parachute rigger. Training initially took place at Oklahoma A&M for enlisted recruits and at the Coast Guard Academy for officers, later moving to Palm Beach and other locations. SPARS recruited primarily white women initially, but by late 1944, African American women were allowed to enlist following policy changes. SPARS units were never deployed overseas, but their work was vital. They handled logistics, intelligence, supply chains, and support roles that ensured the Coast Guard's wartime operations continued smoothly. Disbanded after the war in 1946, SPARS laid groundwork for integrating women more fully into the Coast Guard, which ultimately led to accepting women in 1973."},"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Homefront","chooseOneCards":[{"cardText":{"Namespace":"","Key":"DAADCB0047AA0587759B52B32B7CC64A","SourceString":"Draw the top unit of your deck","LocalizedString":"Draw the top unit of your deck"},"selectTargetOnPlayedFromHand":false},{"cardText":{"Namespace":"","Key":"B876F26F44E00A75DE3B07867D4B0A10","SourceString":"Give the top unit of your deck Ambush and Shock","LocalizedString":"Give the top unit of your deck Ambush and Shock"},"selectTargetOnPlayedFromHand":false}],"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/10_Homefront/T_spars.T_spars","SubPathString":""},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/SPARS.SPARS","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_event_boot_camp_photo","SourceString":"Two women of the US Coast Guard during WWII. ","LocalizedString":"Two women of the US Coast Guard during WWII. "},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"isAttackBuff":true,"isDefenseBuff":true},"variables":[{"name":"cardFound","type":"bool","direction":"