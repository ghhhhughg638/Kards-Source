{"format":"kards-original-reference","version":1,"id":"3f4e634a9797fbf5","name":"card_unit_bryansk_irregulars","package":"/Game/Blueprints/Cards/Soviet/WorldAtWar/units/card_unit_bryansk_irregulars","parent":"UBaseCardObject","card":{"title":"BRYANSK IRREGULARS","text":"Destruction: Deal 3 damage to each unit that dealt damage to this unit this turn.","flavorText":"It is believed that there were around 60,000 Soviet partisans operating in and around Bryansk during WWII and by 1942 they effectively held an area of 14,000 km². The partisans often fought alongside other Red Army forces in battles, but their main goal was to operate behind the enemy lines, to interrupt supply lines and communications or to gather intelligence. The Bryansk region is known for its dense woodland which formed an excellent natural defense, it gave the partisans protection during their raids as well as making it easy for them to hide their movements and their bases. The partisan units in Bryansk were mostly supplied by air and had at least three operative air strips under their control, and several partisan brigades operated their own aircraft.","faction":"Soviet","type":"infantry","rarity":"Uncommon","cost":2,"operationCost":1,"attack":0,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_bryansk_irregulars","title":{"Namespace":"card_soviet","Key":"card_unit_bryansk_irregulars_title","SourceString":"BRYANSK IRREGULARS","LocalizedString":"BRYANSK IRREGULARS"},"Type":"ETypeEnum::infantry","defense":6,"range":1,"faction":"EFactionEnum::Soviet","kredits":2,"Text":{"Namespace":"card_soviet","Key":"card_unit_bryansk_irregulars_text","SourceString":"Destruction: Deal 3 damage to each unit that dealt damage to this unit this turn.","LocalizedString":"Destruction: Deal 3 damage to each unit that dealt damage to this unit this turn."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_bryansk_irregulars_history","SourceString":"It is believed that there were around 60,000 Soviet partisans operating in and around Bryansk during WWII and by 1942 they effectively held an area of 14,000 km². The partisans often fought alongside other Red Army forces in battles, but their main goal was to operate behind the enemy lines, to interrupt supply lines and communications or to gather intelligence. The Bryansk region is known for its dense woodland which formed an excellent natural defense, it gave the partisans protection during their raids as well as making it easy for them to hide their movements and their bases. The partisan units in Bryansk were mostly supplied by air and had at least three operative air strips under their control, and several partisan brigades operated their own aircraft.","LocalizedString":"It is believed that there were around 60,000 Soviet partisans operating in and around Bryansk during WWII and by 1942 they effectively held an area of 14,000 km². The partisans often fought alongside other Red Army forces in battles, but their main goal was to operate behind the enemy lines, to interrupt supply lines and communications or to gather intelligence. The Bryansk region is known for its dense woodland which formed an excellent natural defense, it gave the partisans protection during their raids as well as making it easy for them to hide their movements and their bases. The partisan units in Bryansk were mostly supplied by air and had at least three operative air strips under their control, and several partisan brigades operated their own aircraft."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::WorldAtWar","returnSet":"ECardSetEnum::Homefront","usedTriggers":["ERegisteredCardFunction::OnBeforeStartOfTurn","ERegisteredCardFunction::OnOtherCardReset"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Destruction"],"hasDestruction":true,"hasGuard":true,"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Infantry_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Infantry_Medium_Cue.0"},"Image":{"