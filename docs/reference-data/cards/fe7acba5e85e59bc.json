{"format":"kards-original-reference","version":1,"id":"fe7acba5e85e59bc","name":"card_event_night_raid","package":"/Game/Blueprints/Cards/Britain/Base/events/card_event_night_raid","parent":"UBaseCardObject","card":{"title":"NIGHT RAID","text":"Copy random order from enemy deck. Add a No. 10 COMMANDO to support line.","flavorText":"British and Allied commandos served in all the theaters of war and their operations ranged from small groups of men landing from the sea or by parachute, to a brigade of assault troops spearheading the Allied invasions. Operation Frankton was a commando raid conducted in 1942, and by night against the vessels in Bay of Biscay’s Bordeaux port in France, which was occupied by the Germans. The plan involved taking 12 men on six canoes, by submarine, and to paddle from the Gironde Estuary area to Bordeaux by night. Although only 2 of 12 men survived the mission, the raid was considered a success and Winston Churchill believed it to have shortened the war by 6 whole months.","faction":"Britain","type":"order","rarity":"Rare","cost":4,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_night_raid","title":{"Namespace":"card_britain","Key":"card_event_night_raid_title","SourceString":"NIGHT RAID","LocalizedString":"NIGHT RAID"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Britain","kredits":4,"Text":{"Namespace":"card_britain","Key":"card_event_night_raid_text","SourceString":"Copy random order from enemy deck. Add a No. 10 COMMANDO to support line.","LocalizedString":"Copy random order from enemy deck. Add a No. 10 COMMANDO to support line."},"flavorText":{"Namespace":"card_britain","Key":"card_event_night_raid_history","SourceString":"British and Allied commandos served in all the theaters of war and their operations ranged from small groups of men landing from the sea or by parachute, to a brigade of assault troops spearheading the Allied invasions. Operation Frankton was a commando raid conducted in 1942, and by night against the vessels in Bay of Biscay’s Bordeaux port in France, which was occupied by the Germans. The plan involved taking 12 men on six canoes, by submarine, and to paddle from the Gironde Estuary area to Bordeaux by night. Although only 2 of 12 men survived the mission, the raid was considered a success and Winston Churchill believed it to have shortened the war by 6 whole months.","LocalizedString":"British and Allied commandos served in all the theaters of war and their operations ranged from small groups of men landing from the sea or by parachute, to a brigade of assault troops spearheading the Allied invasions. Operation Frankton was a commando raid conducted in 1942, and by night against the vessels in Bay of Biscay’s Bordeaux port in France, which was occupied by the Germans. The plan involved taking 12 men on six canoes, by submarine, and to paddle from the Gironde Estuary area to Bordeaux by night. Although only 2 of 12 men survived the mission, the raid was considered a success and Winston Churchill believed it to have shortened the war by 6 whole months."},"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Basic","isInPermanentPool":true,"spawnCardName":"card_unit_commandos","soundEnterPlay":{"ObjectName":"SoundWave'For_the_Queen'","ObjectPath":"kards/Content/Assets/Audio/Misc/For_the_Queen.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/Base/t_night_commandos.t_night_commandos","SubPathString":""},"artist":"War Picture Library / Rebellion","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/NIGHT_RAID.NIGHT_RAID","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":299.0},"historyPhotoSource":"http://www.royalmarinesmuseum.co.uk","historyPhotoDescription":{"Namespace":"card_britain","Key":"card_event_night_raid_photo","SourceString":"Operation Frankton at the beginning of the attack on the Port of Bordeaux, 1942","LocalizedString":"Operation Frankton at the beginning of the attack on t