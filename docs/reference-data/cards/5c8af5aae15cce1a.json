{"format":"kards-original-reference","version":1,"id":"5c8af5aae15cce1a","name":"card_unit_78th_yongsan","package":"/Game/Blueprints/Cards/Japan/OceaniaStorm/units/card_unit_78th_yongsan","parent":"UBaseCardObject","card":{"title":"78th YONGSAN","text":"Has +1 attack for each kredit slot the enemy has over you.","flavorText":"The 78th Infantry Regiment was part of the 20th Division, an Imperial Japanese Army formation based at Yongsan in Korea. The division carried the code name Morning Division and was originally raised as a Korean garrison force. During WWII, its role changed when it was sent to New Guinea as part of the Japanese Eighteenth Army. By that time, the division included the 78th, 79th, and 80th Infantry Regiments, along with artillery, reconnaissance, engineer, and transport units. In 1943, the 20th Division moved under Lieutenant General Shigemasa Aoki, but he soon died of malaria. Lieutenant General Shigeru Katagiri then led the division during the Huon Peninsula campaign. After Allied landings at Lae and Nadzab, Japanese troops marched about 200 miles to reinforce Finschhafen. They fought at Finschhafen and Sattelberg, then withdrew after being defeated in October 1943. Katagiri was later killed during the Battle of Hollandia. The division’s surviving troops fought in New Guinea under Masutaro Nakai until Japan’s surrender. Of about 25,000 men, only 1,711 survived the war.","faction":"Japan","type":"infantry","rarity":"Common","cost":1,"operationCost":0,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_78th_yongsan","title":{"Namespace":"card_japan","Key":"card_unit_78th_yongsan_title","SourceString":"78th YONGSAN","LocalizedString":"78th YONGSAN"},"Type":"ETypeEnum::infantry","attack":1,"defense":2,"range":1,"faction":"EFactionEnum::Japan","kredits":1,"Text":{"Namespace":"card_japan","Key":"card_unit_78th_yongsan_text","SourceString":"Has +1 attack for each kredit slot the enemy has over you.","LocalizedString":"Has +1 attack for each kredit slot the enemy has over you."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_78th_yongsan_history","SourceString":"The 78th Infantry Regiment was part of the 20th Division, an Imperial Japanese Army formation based at Yongsan in Korea. The division carried the code name Morning Division and was originally raised as a Korean garrison force. During WWII, its role changed when it was sent to New Guinea as part of the Japanese Eighteenth Army. By that time, the division included the 78th, 79th, and 80th Infantry Regiments, along with artillery, reconnaissance, engineer, and transport units. In 1943, the 20th Division moved under Lieutenant General Shigemasa Aoki, but he soon died of malaria. Lieutenant General Shigeru Katagiri then led the division during the Huon Peninsula campaign. After Allied landings at Lae and Nadzab, Japanese troops marched about 200 miles to reinforce Finschhafen. They fought at Finschhafen and Sattelberg, then withdrew after being defeated in October 1943. Katagiri was later killed during the Battle of Hollandia. The division’s surviving troops fought in New Guinea under Masutaro Nakai until Japan’s surrender. Of about 25,000 men, only 1,711 survived the war.","LocalizedString":"The 78th Infantry Regiment was part of the 20th Division, an Imperial Japanese Army formation based at Yongsan in Korea. The division carried the code name Morning Division and was originally raised as a Korean garrison force. During WWII, its role changed when it was sent to New Guinea as part of the Japanese Eighteenth Army. By that time, the division included the 78th, 79th, and 80th Infantry Regiments, along with artillery, reconnaissance, engineer, and transport units. In 1943, the 20th Division moved under Lieutenant General Shigemasa Aoki, but he soon died of malaria. Lieutenant General Shigeru Katagiri then led the division during the Huon Peninsula campaign. After Allied landings at Lae and Nadzab, Japanese troops marched about 200 miles to reinforce Finschhafen. They fought at Finschhafen and Sattelberg, then withdrew after being defeated in October 1943. Katagiri was later killed during the Battle of Hollandia. The division’s surviving troops fought in New Guinea under Masutaro Nakai until Japan’s surrender. Of about 25,000 men, only 1,711 survived the war."},"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnStartofTurn","ERegisteredCardFunction::NotAvailable"],"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/78th_YONGSAN.78th_YONGSAN","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_78th_yongsan_photo","SourceString":"Soldiers of the 20th Division on Papua New Guinea, 1943.","LocalizedString":"Soldiers of the 20th Division on Papua New Guinea, 1943."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"_checkAndSetBuff","owner":"card_unit_78th_yongsan_C","params":[],"pure":false,"event":false,"flags":"FUNC_Public | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"_currentBuff","type":"int32","direction":"in"},{"name":"_kreditsUnderEnemy","type":"int32","direction":"in"},{"name":"CallFunc_Subtract_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"CallFunc_ChangeAttack_qqq","type":"bool","direction":"in"},{"name":"CallFunc_NotEqual_IntInt_ReturnValue","type":"bool","direction":"in"},{"name":"CallFunc_getAttackTempBuffAmount_tempAmount","type":"int32","direction":"in"},{"name":"Cal