{"format":"kards-original-reference","version":1,"id":"8c5cc750319371d6","name":"card_event_yank_the_army_weekly","package":"/Game/Blueprints/Cards/USA/CovertOp/events/card_event_yank_the_army_weekly","parent":"UBaseCardObject","card":{"title":"YANK","text":"Your HQ gets: \"This battle, the first time you Develop each turn, also Develop a RETRIBUTION.\"","flavorText":"Yank, the Army Weekly was a weekly magazine published by the United States military during WWII. Yank was first published in 1942 and was made available to all serving members in the US military, with a circulation that exceeded 2.5 million in 41 countries with 21 editions. The last issue was published on December 28th, 1945. Each issue was edited in New York City and then sent to different locations worldwide for printing, where local editors added local stories. A popular “morale booster” among the troops was the inclusion of a pin-up girl in every issue, often dressed in swimwear or other alluring attire. These pin-ups featured famous actresses and stage performers.","faction":"USA","type":"order","rarity":"Unique","cost":7,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_yank_the_army_weekly","title":{"Namespace":"card_usa","Key":"card_event_yank_the_army_weekly_title","SourceString":"YANK","LocalizedString":"YANK"},"Type":"ETypeEnum::order","faction":"EFactionEnum::USA","kredits":7,"Text":{"Namespace":"card_usa","Key":"card_event_yank_the_army_weekly_text","SourceString":"Your HQ gets: \"This battle, the first time you Develop each turn, also Develop a RETRIBUTION.\"","LocalizedString":"Your HQ gets: \"This battle, the first time you Develop each turn, also Develop a RETRIBUTION.\""},"flavorText":{"Namespace":"card_usa","Key":"card_event_yank_the_army_weekly_history","SourceString":"Yank, the Army Weekly was a weekly magazine published by the United States military during WWII. Yank was first published in 1942 and was made available to all serving members in the US military, with a circulation that exceeded 2.5 million in 41 countries with 21 editions. The last issue was published on December 28th, 1945. Each issue was edited in New York City and then sent to different locations worldwide for printing, where local editors added local stories. A popular “morale booster” among the troops was the inclusion of a pin-up girl in every issue, often dressed in swimwear or other alluring attire. These pin-ups featured famous actresses and stage performers.","LocalizedString":"Yank, the Army Weekly was a weekly magazine published by the United States military during WWII. Yank was first published in 1942 and was made available to all serving members in the US military, with a circulation that exceeded 2.5 million in 41 countries with 21 editions. The last issue was published on December 28th, 1945. Each issue was edited in New York City and then sent to different locations worldwide for printing, where local editors added local stories. A popular “morale booster” among the troops was the inclusion of a pin-up girl in every issue, often dressed in swimwear or other alluring attire. These pin-ups featured famous actresses and stage performers."},"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::CurrentExpansion","isReserved":true,"usedTriggers":["ERegisteredCardFunction::OnOtherCardDeveloped","ERegisteredCardFunction::OnEndOfTurn","ERegisteredCardFunction::OnOtherCardCreatedAlterCard"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Develop"],"draftBaseWeight":0.8,"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/CandidateArtwork/Summer_24/t_yank.t_yank","SubPathString":""},"artist":"US WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/YANK.YANK","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":497.0}