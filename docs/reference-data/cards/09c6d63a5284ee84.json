{"format":"kards-original-reference","version":1,"id":"09c6d63a5284ee84","name":"card_unit_bloch_mb_150","package":"/Game/Blueprints/Cards/France/units/card_unit_bloch_mb_150","parent":"UBaseCardObject","card":{"title":"BLOCH MB.152","text":"Deployment: If this is the first unit you deploy this turn, draw a card.","flavorText":"The Bloch MB.151 was a French all metal fighter aircraft used during WWII by the French Air Force and later the Axis. The first variant, MB.150 made its first flight in 1937 and after a series of service trials and modifications, 25 aircraft were ordered. However, none of them were delivered due to many technical problems with the design. The aircraft was redesigned which led to the parallel design and production of the MB.151.01 and MB.152.01 variants. By the outbreak of WWII 120 of the new variants had been delivered to the French Air Force. However, most of them were non-operational as they were either missing a propeller or gunsight, or both. When the Germans attacked in May 1940, eight pursuit groups of the French Air Force were equipped with Bloch 151 or 152 fighters, and although the aircraft was sturdy and could withstand heavy punishment it was no match to the Messerschmitt Bf 109E and the Bf 110 and the Bloch groups suffered heavy losses. Following the Armistice in 1940 further variants of Bloch were produced by the Axis powers and were used in the service of the Vichy French Air Force, Luftwaffe and the Royal Romanian Air force. A total of 663 Bloch aircraft were produced throughout the war.","faction":"France","type":"fighter","rarity":"Rare","cost":3,"operationCost":2,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_bloch_mb_150","title":{"Namespace":"card_france","Key":"card_unit_bloch_mb_150_title","SourceString":"BLOCH MB.152","LocalizedString":"BLOCH MB.152"},"Type":"ETypeEnum::fighter","attack":3,"defense":3,"range":2,"faction":"EFactionEnum::France","kredits":3,"Text":{"Namespace":"card_france","Key":"card_unit_bloch_mb_150_text","SourceString":"Deployment: If this is the first unit you deploy this turn, draw a card.","LocalizedString":"Deployment: If this is the first unit you deploy this turn, draw a card."},"flavorText":{"Namespace":"card_france","Key":"card_unit_bloch_mb_150_history","SourceString":"The Bloch MB.151 was a French all metal fighter aircraft used during WWII by the French Air Force and later the Axis. The first variant, MB.150 made its first flight in 1937 and after a series of service trials and modifications, 25 aircraft were ordered. However, none of them were delivered due to many technical problems with the design. The aircraft was redesigned which led to the parallel design and production of the MB.151.01 and MB.152.01 variants. By the outbreak of WWII 120 of the new variants had been delivered to the French Air Force. However, most of them were non-operational as they were either missing a propeller or gunsight, or both. When the Germans attacked in May 1940, eight pursuit groups of the French Air Force were equipped with Bloch 151 or 152 fighters, and although the aircraft was sturdy and could withstand heavy punishment it was no match to the Messerschmitt Bf 109E and the Bf 110 and the Bloch groups suffered heavy losses. Following the Armistice in 1940 further variants of Bloch were produced by the Axis powers and were used in the service of the Vichy French Air Force, Luftwaffe and the Royal Romanian Air force. A total of 663 Bloch aircraft were produced throughout the war.","LocalizedString":"The Bloch MB.151 was a French all metal fighter aircraft used during WWII by the French Air Force and later the Axis. The first variant, MB.150 made its first flight in 1937 and after a series of service trials and modifications, 25 aircraft were ordered. However, none of them were delivered due to many technical problems with the design. The aircraft was redesigned which led to the parallel design and production of the MB.151.01 and MB.152.01 variants. By the outbreak of WWII 120 of the new variants had been delivered to the French Air Force. However, most of them were non-operational as they were either missing a propeller or gunsight, or both. When the Germans attacked in May 1940, eight pursuit groups of the French Air Force were equipped with Bloch 151 or 152 fighters, and although the aircraft was sturdy and could withstand heavy punishment it was no match to the Messerschmitt Bf 109E and the Bf 110 and the Bloch groups suffered heavy losses. Following the Armistice in 1940 further variants of Bloch were produced by the Axis powers and were used in the service of the Vichy French Air Force, Luftwaffe and the Royal Romanian Air force. A total of 663 Bloch aircraft were produced throughout the war."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Breakthrough","isInPermanentPool":true,"usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::HeavyArmor1","EHelpBubbleTypes::Deployment"],"hasDeployment":true,"heavyArmor":1,"soundBlowUp":{"ObjectName":"SoundWave'AU_ArmorExplosion_01'","ObjectPath":"kards/Content/Assets/Audio/Explosions/AU_ArmorExplosion_01.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/France/t_bloch_mb_152.t_bloch_mb_152","SubPathString":""},"artist":"Darryl Legg","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/Bloch_MB_151.Bloch_MB_151","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":406.0},"historyPhotoDescription":{"Namespace":"card_france","Key":"card_unit_bloch_mb_150_photo","SourceString":"Bloch MB.151 fighter in flight, ca. 1939. ","LocalizedString":"Bloch MB.151 fighter in flight, ca. 1939. "},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionArmourS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionArmourS.31"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Bluep