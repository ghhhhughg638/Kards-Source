{"format":"kards-original-reference","version":1,"id":"1dbe8a062fcc95ff","name":"card_unit_2nd_infantry_regiment","package":"/Game/Blueprints/Cards/Poland/units/card_unit_2nd_infantry_regiment","parent":"UBaseCardObject","card":{"title":"2nd INFANTRY REGIMENT","text":"Deployment: Get the combat keywords of a target unit.","flavorText":"The 2nd Infantry Regiment was part of the 1st Tadeusz Kościuszko Infantry Division, the first Polish unit formed under Soviet command during WWII. Established in 1943 near the Oka River, this division marked the revival of Polish armed forces in the East. It was named in honor of Tadeusz Kościuszko, a national hero in both Poland and the US, where he fought in the American revolutionary war. Trained and equipped by the Red Army, the division included many Polish citizens released from Soviet labor camps and prisons. Soviet officers initially held most command positions. The unit saw its first combat during the Battle of Lenino in October 1943. Despite heavy casualties and mixed results, Lenino served as a symbol of Poland’s renewed military effort against Nazi Germany. The division grew into a full army corps and later formed the core of the Polish First Army. It took part in major operations, including the liberation of Warsaw and the storming of Berlin. By the end of the war, the division had become a significant force.","faction":"Poland","type":"infantry","rarity":"Common","cost":4,"operationCost":1,"attack":5,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_2nd_infantry_regiment","title":{"Namespace":"card_poland","Key":"card_unit_2nd_infantry_regiment_title","SourceString":"2nd INFANTRY REGIMENT","LocalizedString":"2nd INFANTRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":5,"defense":4,"range":1,"faction":"EFactionEnum::Poland","kredits":4,"Text":{"Namespace":"card_poland","Key":"card_unit_2nd_infantry_regiment_text","SourceString":"Deployment: Get the combat keywords of a target unit.","LocalizedString":"Deployment: Get the combat keywords of a target unit."},"flavorText":{"Namespace":"card_poland","Key":"card_unit_2nd_infantry_regiment_history","SourceString":"The 2nd Infantry Regiment was part of the 1st Tadeusz Kościuszko Infantry Division, the first Polish unit formed under Soviet command during WWII. Established in 1943 near the Oka River, this division marked the revival of Polish armed forces in the East. It was named in honor of Tadeusz Kościuszko, a national hero in both Poland and the US, where he fought in the American revolutionary war. Trained and equipped by the Red Army, the division included many Polish citizens released from Soviet labor camps and prisons. Soviet officers initially held most command positions. The unit saw its first combat during the Battle of Lenino in October 1943. Despite heavy casualties and mixed results, Lenino served as a symbol of Poland’s renewed military effort against Nazi Germany. The division grew into a full army corps and later formed the core of the Polish First Army. It took part in major operations, including the liberation of Warsaw and the storming of Berlin. By the end of the war, the division had become a significant force.","LocalizedString":"The 2nd Infantry Regiment was part of the 1st Tadeusz Kościuszko Infantry Division, the first Polish unit formed under Soviet command during WWII. Established in 1943 near the Oka River, this division marked the revival of Polish armed forces in the East. It was named in honor of Tadeusz Kościuszko, a national hero in both Poland and the US, where he fought in the American revolutionary war. Trained and equipped by the Red Army, the division included many Polish citizens released from Soviet labor camps and prisons. Soviet officers initially held most command positions. The unit saw its first combat during the Battle of Lenino in October 1943. Despite heavy casualties and mixed results, Lenino served as a symbol of Poland’s renewed military effort against Nazi Germany. The division grew into a full army corps and later formed the core of the Polish First Army. It took part in major operations, including the liberation of Warsaw and the storming of Berlin. By the end of the war, the division had become a significant force."},"operationCost":1,"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Trigger","hasDeployment":true,"exileNation":"EFactionEnum::Soviet","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/2nd_INFANTRY_REGIMENT.2nd_INFANTRY_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":364.0},"historyPhotoDescription":{"Namespace":"card_poland","Key":"card_unit_2nd_infantry_regiment_photo","SourceString":"Soldiers of the 1st Tadeusz Kościuszko Infantry Division in 1943.","LocalizedString":"Soldiers of the 1st Tadeusz Kościuszko Infantry Division in 1943."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"CanPlayFromHand","owner":"card_unit_2nd_infantry_regiment_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","direction":"in"},{"name":"CallFunc_GetTa