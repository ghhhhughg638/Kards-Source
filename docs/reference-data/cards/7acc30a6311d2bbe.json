{"format":"kards-original-reference","version":1,"id":"7acc30a6311d2bbe","name":"card_unit_27_fusiliers","package":"/Game/Blueprints/Cards/Germany/Homefront/units/card_unit_27_fusiliers","parent":"UBaseCardObject","card":{"title":"27. FÜSILIERS","text":"When a German unit enters your hand, reduce its cost by 1, to a minimum of 1.","flavorText":"The 27th Fusilier Regiment was part of the German 12th Infantry Division, a unit formed in 1934 and based in Schwerin. It originated under the cover name Infanterieführer II to conceal German rearmament, receiving its official designation when the Wehrmacht was created in 1935. Built from Pomeranian recruits, the division took part in the invasion of Poland in 1939 as part of I Army Corps, 1st Army. In 1940, it participated in the campaign through the Low Countries and France, helping repel an Anglo-French counterattack during their retreat through Belgium. The division remained stationed in Western Europe until May 1941, then joined Operation Barbarossa under Army Group Center. On the Eastern Front, it endured heavy combat and attrition, and was destroyed in mid-1944 during the Soviet summer offensive, Operation Bagration. In September 1944, a new formation under the same name was raised and deployed on the Western Front, where it fought until its final surrender in April 1945.","faction":"Germany","type":"infantry","rarity":"Uncommon","cost":2,"operationCost":1,"attack":2,"defense":4},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.bond"],"Name":"card_unit_27_fusiliers","title":{"Namespace":"card_germany","Key":"card_unit_27_fusiliers_title","SourceString":"27. FÜSILIERS","LocalizedString":"27. FÜSILIERS"},"Type":"ETypeEnum::infantry","attack":2,"defense":4,"range":1,"faction":"EFactionEnum::Germany","kredits":2,"Text":{"Namespace":"card_germany","Key":"card_unit_27_fusiliers_text","SourceString":"When a German unit enters your hand, reduce its cost by 1, to a minimum of 1.","LocalizedString":"When a German unit enters your hand, reduce its cost by 1, to a minimum of 1."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_27_fusiliers_history","SourceString":"The 27th Fusilier Regiment was part of the German 12th Infantry Division, a unit formed in 1934 and based in Schwerin. It originated under the cover name Infanterieführer II to conceal German rearmament, receiving its official designation when the Wehrmacht was created in 1935. Built from Pomeranian recruits, the division took part in the invasion of Poland in 1939 as part of I Army Corps, 1st Army. In 1940, it participated in the campaign through the Low Countries and France, helping repel an Anglo-French counterattack during their retreat through Belgium. The division remained stationed in Western Europe until May 1941, then joined Operation Barbarossa under Army Group Center. On the Eastern Front, it endured heavy combat and attrition, and was destroyed in mid-1944 during the Soviet summer offensive, Operation Bagration. In September 1944, a new formation under the same name was raised and deployed on the Western Front, where it fought until its final surrender in April 1945.","LocalizedString":"The 27th Fusilier Regiment was part of the German 12th Infantry Division, a unit formed in 1934 and based in Schwerin. It originated under the cover name Infanterieführer II to conceal German rearmament, receiving its official designation when the Wehrmacht was created in 1935. Built from Pomeranian recruits, the division took part in the invasion of Poland in 1939 as part of I Army Corps, 1st Army. In 1940, it participated in the campaign through the Low Countries and France, helping repel an Anglo-French counterattack during their retreat through Belgium. The division remained stationed in Western Europe until May 1941, then joined Operation Barbarossa under Army Group Center. On the Eastern Front, it endured heavy combat and attrition, and was destroyed in mid-1944 during the Soviet summer offensive, Operation Bagration. In September 1944, a new formation under the same name was raised and deployed on the Western Front, where it fought until its final surrender in April 1945."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardReset","ERegisteredCardFunction::OnOtherCardDrawnFromDeck","ERegisteredCardFunction::OnOtherCardSpawnedInHand"],"hasShock":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/27__FUSILIERS.27__FUSILIERS","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":280.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_27_fusiliers_photo","SourceString":"German machinegunners of Army Group Center near Baravucha, Belarus, 1941.","LocalizedString":"German machinegunners of Army Group Center near Baravucha, Belarus, 1941."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_27_fusiliers","owner":"card_unit_27_fusiliers_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"K2Node_Event_cardReset","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_resetCardID","type":"int32","direction":"in"},{"name":"CallFunc_IsLocatedInHand_isIt","type":"bool","direction":"in"},{"name":"CallFunc_IsUnit_isIt","type":"bool","direction":"in"},{"name":"CallFunc_getAndDecryptKredit_decryptedKredit","type":"int32","direction":"in"},{"name":"CallF