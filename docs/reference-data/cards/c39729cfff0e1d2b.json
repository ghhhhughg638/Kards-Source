{"format":"kards-original-reference","version":1,"id":"c39729cfff0e1d2b","name":"card_unit_25th_infantry_regiment","package":"/Game/Blueprints/Cards/Soviet/Breakthrough/units/card_unit_25th_infantry_regiment","parent":"UBaseCardObject","card":{"title":"25th INFANTRY REGIMENT","text":"At the end of your turn, add a LIGHT INFANTRY to the same front.","flavorText":"The 25th Infantry Regiment was a unit of the 44th Rifle Division of the Red Army. The division was formed in 1918 during the Russian Civil war and participated in the Finnish Winter War and WWII. The division was destroyed during the Winter War in 1940 and recreated in 1941 and became part of the 13th Rifle Corps of the 12th Army. The division was once more wiped out in combat, but recreated again and fought throughout the war with the 54th Army of the Volkhov Front and later with the 67th Army of the Leningrad Front.","faction":"Soviet","type":"infantry","rarity":"Common","cost":8,"operationCost":2,"attack":6,"defense":7},"defaults":{"UberGraphFrame":{},"Name":"card_unit_25th_infantry_regiment","title":{"Namespace":"card_soviet","Key":"card_unit_25th_infantry_regiment_title","SourceString":"25th INFANTRY REGIMENT","LocalizedString":"25th INFANTRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":6,"defense":7,"range":1,"faction":"EFactionEnum::Soviet","kredits":8,"Text":{"Namespace":"card_soviet","Key":"card_unit_25th_infantry_regiment_text","SourceString":"At the end of your turn, add a LIGHT INFANTRY to the same front.","LocalizedString":"At the end of your turn, add a LIGHT INFANTRY to the same front."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_25th_infantry_regiment_history","SourceString":"The 25th Infantry Regiment was a unit of the 44th Rifle Division of the Red Army. The division was formed in 1918 during the Russian Civil war and participated in the Finnish Winter War and WWII. The division was destroyed during the Winter War in 1940 and recreated in 1941 and became part of the 13th Rifle Corps of the 12th Army. The division was once more wiped out in combat, but recreated again and fought throughout the war with the 54th Army of the Volkhov Front and later with the 67th Army of the Leningrad Front.","LocalizedString":"The 25th Infantry Regiment was a unit of the 44th Rifle Division of the Red Army. The division was formed in 1918 during the Russian Civil war and participated in the Finnish Winter War and WWII. The division was destroyed during the Winter War in 1940 and recreated in 1941 and became part of the 13th Rifle Corps of the 12th Army. The division was once more wiped out in combat, but recreated again and fought throughout the war with the 54th Army of the Volkhov Front and later with the 67th Army of the Leningrad Front."},"operationCost":2,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Breakthrough","returnSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Trigger"],"hasGuard":true,"spawnCardName":"card_unit_light_infantry","soundBlowUp":{"ObjectName":"SoundWave'explosion_concrete_medium'","ObjectPath":"kards/Content/Explosions_SFX/Wavs/explosion_concrete_medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/WE_Candidates/t_25th_soviet_inf.t_25th_soviet_inf","SubPathString":""},"artist":"Soviet WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/25th_INFANTRY_REGIMENT.25th_INFANTRY_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":324.0},"historyPhotoDescription":{"Namespace":"card_unit_25th_infantry_regiment_photo","Key":"8391519F40C4C803E249069E48FE12A1","SourceString":"Volkhov Front attack, ca. 1941-42.","LocalizedString":"Volkhov Front attack, ca. 1941-42."},"historyTypeDescription":{"Namespace":"card_unit_25th_infantry_regiment_header","Key":"EB91FB32479AD54BA440CEACCD6C1FCD","SourceString":"Infantry","LocalizedStri