{"format":"kards-original-reference","version":1,"id":"9533272fa8f62306","name":"card_event_anzac_spirit","package":"/Game/Blueprints/Cards/ANZAC/events/card_event_anzac_spirit","parent":"UBaseCardObject","card":{"title":"THE ANZAC SPIRIT","text":"Deal 2 damage to all enemies. Draw 2 cards. Gain 2 extra kredit slots.","flavorText":"The Anzac spirit is a shared idea in Australian and New Zealand memory, shaped by the 1915 Gallipoli campaign. It is often associated with courage, endurance, initiative, good humour, and mateship. Early reports from Anzac Cove praised the Australians and New Zealanders for landing under fire and pushing inland despite confusion and danger. Australian official historian Charles Bean helped turn these stories into a wider legend. For many, the Anzac spirit came to describe ordinary soldiers facing hardship while supporting their mates. The idea has been debated by historians, but it remains central to Anzac Day remembrance and to the close wartime bond between Australia and New Zealand.","faction":"Anzac","type":"order","rarity":"Rare","cost":8,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_anzac_spirit","title":{"Namespace":"card_anzac","Key":"card_event_anzac_spirit_title","SourceString":"THE ANZAC SPIRIT","LocalizedString":"THE ANZAC SPIRIT"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Anzac","kredits":8,"Text":{"Namespace":"card_anzac","Key":"card_event_anzac_spirit_text","SourceString":"Deal 2 damage to all enemies. Draw 2 cards. Gain 2 extra kredit slots.","LocalizedString":"Deal 2 damage to all enemies. Draw 2 cards. Gain 2 extra kredit slots."},"flavorText":{"Namespace":"card_anzac","Key":"card_event_anzac_spirit_history","SourceString":"The Anzac spirit is a shared idea in Australian and New Zealand memory, shaped by the 1915 Gallipoli campaign. It is often associated with courage, endurance, initiative, good humour, and mateship. Early reports from Anzac Cove praised the Australians and New Zealanders for landing under fire and pushing inland despite confusion and danger. Australian official historian Charles Bean helped turn these stories into a wider legend. For many, the Anzac spirit came to describe ordinary soldiers facing hardship while supporting their mates. The idea has been debated by historians, but it remains central to Anzac Day remembrance and to the close wartime bond between Australia and New Zealand.","LocalizedString":"The Anzac spirit is a shared idea in Australian and New Zealand memory, shaped by the 1915 Gallipoli campaign. It is often associated with courage, endurance, initiative, good humour, and mateship. Early reports from Anzac Cove praised the Australians and New Zealanders for landing under fire and pushing inland despite confusion and danger. Australian official historian Charles Bean helped turn these stories into a wider legend. For many, the Anzac spirit came to describe ordinary soldiers facing hardship while supporting their mates. The idea has been debated by historians, but it remains central to Anzac Day remembrance and to the close wartime bond between Australia and New Zealand."},"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::OceaniaStorm","isInPermanentPool":true,"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Organic_War_Drums_4'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Organic_War_Drums_4.0"},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/THE_ANZAC_SPIRIT.THE_ANZAC_SPIRIT","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_anzac","Key":"card_event_anzac_spirit_photo","SourceString":"Members of the Australian 9th Division during a parade at Gaza airport in 1942.","LocalizedString":"Members of the Australian 9th Division during a parade at Gaza airport in 1942."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"Notes":"Image needed 