{"format":"kards-original-reference","version":1,"id":"cb0623e9ab8f3f78","name":"card_event_yamato","package":"/Game/Blueprints/Cards/Japan/Breakthrough/events/card_event_yamato","parent":"UBaseCardObject","card":{"title":"IJN YAMATO","text":"Your Japanese units everywhere get: \"Destruction: Deal 2 damage to the enemy HQ.\"","flavorText":"The Yamato battleship, named after the ancient Japanese Yamato Province, was the lead ship of the Yamato class of the Imperial Japanese Navy during WWII. Yamato and her sister ship Musashi were the heaviest and most powerfully armed battleships ever built in history. Yamato exceeded other countries' battleships not only by the displacement and the calibre of her guns, but also by the construction of her hull, armour protection, gunnery and optics which gave her tremendous precision to her main gunfire. The construction of these ships was an incredible achievement for the Japanese naval engineering and shipbuilding industry by any international standard. In 1945 Yamato was dispatched on a mission to Okinawa with orders to beach herself and defend the island until destroyed. On her way to Okinawa she was spotted by US aircraft and submarines and sunk in an air raid of carrier based bombers and torpedo bombers. The Yamato was lost with almost all hands. Her sister ship Musashi was sunk during the Battle of Leyte Gulf in 1944.","faction":"Japan","type":"order","rarity":"Unique","cost":10,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"GameplayTags":["subtype.navy"],"Name":"card_event_yamato","title":{"Namespace":"card_japan","Key":"card_event_yamato_title","SourceString":"IJN YAMATO","LocalizedString":"IJN YAMATO"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Japan","kredits":10,"Text":{"Namespace":"card_japan","Key":"card_event_yamato_text","SourceString":"Your Japanese units everywhere get: \"Destruction: Deal 2 damage to the enemy HQ.\"","LocalizedString":"Your Japanese units everywhere get: \"Destruction: Deal 2 damage to the enemy HQ.\""},"flavorText":{"Namespace":"card_japan","Key":"card_event_yamato_history","SourceString":"The Yamato battleship, named after the ancient Japanese Yamato Province, was the lead ship of the Yamato class of the Imperial Japanese Navy during WWII. Yamato and her sister ship Musashi were the heaviest and most powerfully armed battleships ever built in history. Yamato exceeded other countries' battleships not only by the displacement and the calibre of her guns, but also by the construction of her hull, armour protection, gunnery and optics which gave her tremendous precision to her main gunfire. The construction of these ships was an incredible achievement for the Japanese naval engineering and shipbuilding industry by any international standard. In 1945 Yamato was dispatched on a mission to Okinawa with orders to beach herself and defend the island until destroyed. On her way to Okinawa she was spotted by US aircraft and submarines and sunk in an air raid of carrier based bombers and torpedo bombers. The Yamato was lost with almost all hands. Her sister ship Musashi was sunk during the Battle of Leyte Gulf in 1944.","LocalizedString":"The Yamato battleship, named after the ancient Japanese Yamato Province, was the lead ship of the Yamato class of the Imperial Japanese Navy during WWII. Yamato and her sister ship Musashi were the heaviest and most powerfully armed battleships ever built in history. Yamato exceeded other countries' battleships not only by the displacement and the calibre of her guns, but also by the construction of her hull, armour protection, gunnery and optics which gave her tremendous precision to her main gunfire. The construction of these ships was an incredible achievement for the Japanese naval engineering and shipbuilding industry by any international standard. In 1945 Yamato was dispatched on a mission to Okinawa with orders to beach herself and defend the island until destroyed. On her way to Okinawa she was spotted by US aircraft and submarines and sunk in an air raid of carrier based bombers and torpedo bombers. The Yamato was lost with almost all hands. Her sister ship Musashi was sunk during the Battle of Leyte Gulf in 1944."},"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::Breakthrough","isReserved":true,"usedTriggers":["ERegisteredCardFunction::OnOtherCardDestroyed"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Destruction"],"soundEnterPlay":{"ObjectName":"SoundWave'Naval_Support_17'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Naval_Support_17.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/DontUseOrTemp/t_yamato.t_yamato","SubPathString":""},"artist":"Yoshiyuki Takani","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/YAMATO.YAMATO","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":262.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_event_yamato_photo","SourceString":"Yamato outside Sukumo Bay, Japan, 1941.","LocalizedString":"Yamato outside Sukumo Bay, Japan, 1941."},"OnPlayedFromHandVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_OrderAmphibianAssault.BP_OrderAmphibianAssault_C","SubPathString":""},"isDraw":true,"isDefenseBuff":true},"variables":[{"name":"TempCard","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_yamato","owner":"card_event_yamato_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"CallFunc_IsUnrevealedCovertCard_isIt","type":"bool","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_bool_Variable","type":"bool","direction":"in"},{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_cardDestroyed","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_killer","type"