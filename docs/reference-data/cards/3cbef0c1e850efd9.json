{"format":"kards-original-reference","version":1,"id":"3cbef0c1e850efd9","name":"card_unit_104_panzergrenadier","package":"/Game/Blueprints/Cards/Germany/Legions/units/card_unit_104_panzergrenadier","parent":"UBaseCardObject","card":{"title":"104. PANZERGRENADIER","text":"Deployment: Reduce the operation cost by 1 if you control a tank.","flavorText":"The 104th Panzergrenadier Regiment was a unit of the 15th Panzergrenadier Division, which was a mobilized division of the Wehrmacht. The division was formed in 1943 out of the former Sicily Division and remnants of the 15th Panzer Division. Shortly after being formed the division participated in fighting in Sicily against the invading US forces, which ended in retreat and evacuation from the island. The division would later participate in the Italian Campaign and defend against the Allied forces in the Battle of Monte Cassino and the Battle of Anzio. The 15th Division spent the rest of the war on the Western Front where they fought in the Battle of the Bulge before surrendering to the British when the war ended.","faction":"Germany","type":"infantry","rarity":"Uncommon","cost":2,"operationCost":1,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_104_panzergrenadier","title":{"Namespace":"card_germany","Key":"card_unit_104_panzergrenadier_title","SourceString":"104. PANZERGRENADIER","LocalizedString":"104. PANZERGRENADIER"},"Type":"ETypeEnum::infantry","attack":3,"defense":3,"range":1,"faction":"EFactionEnum::Germany","kredits":2,"Text":{"Namespace":"card_germany","Key":"card_unit_104_panzergrenadier_text","SourceString":"Deployment: Reduce the operation cost by 1 if you control a tank.","LocalizedString":"Deployment: Reduce the operation cost by 1 if you control a tank."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_104_panzergrenadier_history","SourceString":"The 104th Panzergrenadier Regiment was a unit of the 15th Panzergrenadier Division, which was a mobilized division of the Wehrmacht. The division was formed in 1943 out of the former Sicily Division and remnants of the 15th Panzer Division. Shortly after being formed the division participated in fighting in Sicily against the invading US forces, which ended in retreat and evacuation from the island. The division would later participate in the Italian Campaign and defend against the Allied forces in the Battle of Monte Cassino and the Battle of Anzio. The 15th Division spent the rest of the war on the Western Front where they fought in the Battle of the Bulge before surrendering to the British when the war ended.","LocalizedString":"The 104th Panzergrenadier Regiment was a unit of the 15th Panzergrenadier Division, which was a mobilized division of the Wehrmacht. The division was formed in 1943 out of the former Sicily Division and remnants of the 15th Panzer Division. Shortly after being formed the division participated in fighting in Sicily against the invading US forces, which ended in retreat and evacuation from the island. The division would later participate in the Italian Campaign and defend against the Allied forces in the Battle of Monte Cassino and the Battle of Anzio. The 15th Division spent the rest of the war on the Western Front where they fought in the Battle of the Bulge before surrendering to the British when the war ended."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Legions","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion02'","ObjectPath":"kards/Content/StarterContent/Audio/Explosion02.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/Invasion/t_motorized_grenadiers.t_motorized_grenadiers","SubPathString":""},"artist":"Roy Huxley","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/104__PANZERGRENADIER.104__PANZERGRENADIER","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":358.0},"historyPhotoDescri