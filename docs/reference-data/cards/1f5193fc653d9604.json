{"format":"kards-original-reference","version":1,"id":"1f5193fc653d9604","name":"card_unit_heinkel_he_219","package":"/Game/Blueprints/Cards/Germany/Allegiance/units/card_unit_heinkel_he_219","parent":"UBaseCardObject","card":{"title":"HEINKEL HE 219","text":"Deployment: Fight target enemy unit.","flavorText":"The Heinkel He 219 Uhu (e. Eagle Owl) was a German night fighter in service during WWII. The He 219 was introduced in 1943 and the design was advanced for its time, equipped with an airborne Lichtenstein intercept radar and the first aircraft that had an ejection seat installed. The He 219 could obtain the speed of 580 km/h which made it capable of hunting down several enemy bombers in a single sortie. Some aircraft had their excess weight removed which allowed it to obtain a speed of 650 km/h. The He 219 was a very capable night fighter, but did not play a significant role in the war since only a limited number of aircraft were built (approx. 300) and they saw limited service.","faction":"Germany","type":"fighter","rarity":"Uncommon","cost":5,"operationCost":2,"attack":5,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_heinkel_he_219","title":{"Namespace":"card_germany","Key":"card_unit_heinkel_he_219_title","SourceString":"HEINKEL HE 219","LocalizedString":"HEINKEL HE 219"},"Type":"ETypeEnum::fighter","attack":5,"defense":5,"range":2,"faction":"EFactionEnum::Germany","kredits":5,"Text":{"Namespace":"card_germany","Key":"card_unit_heinkel_he_219_text","SourceString":"Deployment: Fight target enemy unit.","LocalizedString":"Deployment: Fight target enemy unit."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_heinkel_he_219_history","SourceString":"The Heinkel He 219 Uhu (e. Eagle Owl) was a German night fighter in service during WWII. The He 219 was introduced in 1943 and the design was advanced for its time, equipped with an airborne Lichtenstein intercept radar and the first aircraft that had an ejection seat installed. The He 219 could obtain the speed of 580 km/h which made it capable of hunting down several enemy bombers in a single sortie. Some aircraft had their excess weight removed which allowed it to obtain a speed of 650 km/h. The He 219 was a very capable night fighter, but did not play a significant role in the war since only a limited number of aircraft were built (approx. 300) and they saw limited service.","LocalizedString":"The Heinkel He 219 Uhu (e. Eagle Owl) was a German night fighter in service during WWII. The He 219 was introduced in 1943 and the design was advanced for its time, equipped with an airborne Lichtenstein intercept radar and the first aircraft that had an ejection seat installed. The He 219 could obtain the speed of 580 km/h which made it capable of hunting down several enemy bombers in a single sortie. Some aircraft had their excess weight removed which allowed it to obtain a speed of 650 km/h. The He 219 was a very capable night fighter, but did not play a significant role in the war since only a limited number of aircraft were built (approx. 300) and they saw limited service."},"operationCost":2,"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Expansion2019","isInPermanentPool":true,"hasDeployment":true,"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/t_he_219.t_he_219","SubPathString":""},"artist":"Jarosław Wróbel","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/HEINKEL_HE_291.HEINKEL_HE_291","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":292.0},"historyPhotoAuthor":"Otto Gögerheim","historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_heinkel_he_219_photo","SourceString":"Heinkel He 219 Uhu, date unknown.","LocalizedString":"Heinkel He 219 Uhu, date unknown."},"historyTypeDescription":{"Namespace":"car