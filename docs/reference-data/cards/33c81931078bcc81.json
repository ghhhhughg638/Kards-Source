{"format":"kards-original-reference","version":1,"id":"33c81931078bcc81","name":"card_unit_4th_guards_rifles","package":"/Game/Blueprints/Cards/Soviet/BloodIron/units/card_unit_4th_guards_rifles","parent":"UBaseCardObject","card":{"title":"4th GUARDS RIFLES","text":"If in your hand, reduce cost by 1 each time the enemy draws a card.","flavorText":"The 4th Guards Rifle Regiment was an infantry regiment of the 6th Guards Rifle Division, known as \"Rovenskaya\". It was awarded the Orders of Lenin, the Red Banner, and Suvorov, and it was one of the most notable units that fought in the Oryol region during WWII. It was formed in Livny as the 120th Rifle Division and fought continuously in this area from October 1941 to the summer of 1943. The division took part in major battles, including Moscow, Kursk, and Kyiv, and played a role in the liberation of cities like Yelnya and Rovno. Three of its commanders became Heroes of the Soviet Union: Filipp Cherokmanov, Dmitry Onuprienko, and Georgy Ivanov.","faction":"Soviet","type":"infantry","rarity":"Unique","cost":9,"operationCost":2,"attack":9,"defense":9},"defaults":{"UberGraphFrame":{},"Name":"card_unit_4th_guards_rifles","title":{"Namespace":"card_soviet","Key":"card_unit_4th_guards_rifles_title","SourceString":"4th GUARDS RIFLES","LocalizedString":"4th GUARDS RIFLES"},"Type":"ETypeEnum::infantry","attack":9,"defense":9,"range":1,"faction":"EFactionEnum::Soviet","kredits":9,"Text":{"Namespace":"card_soviet","Key":"card_unit_4th_guards_rifles_text","SourceString":"If in your hand, reduce cost by 1 each time the enemy draws a card.","LocalizedString":"If in your hand, reduce cost by 1 each time the enemy draws a card."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_4th_guards_rifles_history","SourceString":"The 4th Guards Rifle Regiment was an infantry regiment of the 6th Guards Rifle Division, known as \"Rovenskaya\". It was awarded the Orders of Lenin, the Red Banner, and Suvorov, and it was one of the most notable units that fought in the Oryol region during WWII. It was formed in Livny as the 120th Rifle Division and fought continuously in this area from October 1941 to the summer of 1943. The division took part in major battles, including Moscow, Kursk, and Kyiv, and played a role in the liberation of cities like Yelnya and Rovno. Three of its commanders became Heroes of the Soviet Union: Filipp Cherokmanov, Dmitry Onuprienko, and Georgy Ivanov.","LocalizedString":"The 4th Guards Rifle Regiment was an infantry regiment of the 6th Guards Rifle Division, known as \"Rovenskaya\". It was awarded the Orders of Lenin, the Red Banner, and Suvorov, and it was one of the most notable units that fought in the Oryol region during WWII. It was formed in Livny as the 120th Rifle Division and fought continuously in this area from October 1941 to the summer of 1943. The division took part in major battles, including Moscow, Kursk, and Kyiv, and played a role in the liberation of cities like Yelnya and Rovno. Three of its commanders became Heroes of the Soviet Union: Filipp Cherokmanov, Dmitry Onuprienko, and Georgy Ivanov."},"operationCost":2,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::BloodAndIron","usedTriggers":["ERegisteredCardFunction::OnOtherCardDrawnFromDeck"],"hasGuard":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/Winter_2024/t_4th_guards_rifles.t_4th_guards_rifles","SubPathString":""},"artist":"Soviet WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/4th_GUARDS_RIFLES.4th_GUARDS_RIFLES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":359.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_4th_guards_rifles_photo","SourceString":"Soviet troops enter the city of Yelnya, September 6, 1941.","LocalizedString":"Soviet troops enter the city of Yelnya, September 6, 1941."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niag