{"format":"kards-original-reference","version":1,"id":"40ac37a807e2fdfe","name":"card_unit_royal_sussex_regiment","package":"/Game/Blueprints/Cards/Britain/OceaniaStorm/units/card_unit_royal_sussex_regiment","parent":"UBaseCardObject","card":{"title":"ROYAL SUSSEX REGIMENT","text":"Your BLASTS deal +1 damage.\r\nYour PLANS draw +1 card.\r\nYour PRODUCTIONS give +1 kredit.","flavorText":"The Royal Sussex Regiment was a British line infantry regiment formed in 1881 from the 35th Royal Sussex Regiment of Foot and the 107th Regiment of Foot. In WWII, its battalions served across several theatres. The 1st Battalion was stationed in Egypt and Palestine before joining the 4th Indian Infantry Division. It fought in the Western Desert, then in Italy, where it endured hard fighting at Monte Cassino, before moving to Greece in late 1944. The 2nd Battalion fought with the British Expeditionary Force in France in 1940 and was evacuated from Dunkirk. It later served in North Africa, including Alam el Halfa and El Alamein. In 1943, men from the 2nd, 4th, and 5th Battalions helped form the 10th Parachute Battalion, which was engaged at Taranto and later at Arnhem. The 9th Battalion took a different route. After briefly converting to armour, it returned to infantry and fought in Burma with the 36th Division. It saw action in the Arakan, was airlifted into Myitkyina, and advanced toward Mandalay in 1945.","faction":"Britain","type":"infantry","rarity":"Rare","cost":5,"operationCost":1,"attack":4,"defense":7},"defaults":{"UberGraphFrame":{},"Name":"card_unit_royal_sussex_regiment","title":{"Namespace":"card_britain","Key":"card_unit_royal_sussex_regiment_title","SourceString":"ROYAL SUSSEX REGIMENT","LocalizedString":"ROYAL SUSSEX REGIMENT"},"Type":"ETypeEnum::infantry","attack":4,"defense":7,"range":1,"faction":"EFactionEnum::Britain","kredits":5,"Text":{"Namespace":"card_britain","Key":"card_unit_royal_sussex_regiment_text","SourceString":"Your BLASTS deal +1 damage.\r\nYour PLANS draw +1 card.\r\nYour PRODUCTIONS give +1 kredit.","LocalizedString":"Your BLASTS deal +1 damage.\r\nYour PLANS draw +1 card.\r\nYour PRODUCTIONS give +1 kredit."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_royal_sussex_regiment_history","SourceString":"The Royal Sussex Regiment was a British line infantry regiment formed in 1881 from the 35th Royal Sussex Regiment of Foot and the 107th Regiment of Foot. In WWII, its battalions served across several theatres. The 1st Battalion was stationed in Egypt and Palestine before joining the 4th Indian Infantry Division. It fought in the Western Desert, then in Italy, where it endured hard fighting at Monte Cassino, before moving to Greece in late 1944. The 2nd Battalion fought with the British Expeditionary Force in France in 1940 and was evacuated from Dunkirk. It later served in North Africa, including Alam el Halfa and El Alamein. In 1943, men from the 2nd, 4th, and 5th Battalions helped form the 10th Parachute Battalion, which was engaged at Taranto and later at Arnhem. The 9th Battalion took a different route. After briefly converting to armour, it returned to infantry and fought in Burma with the 36th Division. It saw action in the Arakan, was airlifted into Myitkyina, and advanced toward Mandalay in 1945.","LocalizedString":"The Royal Sussex Regiment was a British line infantry regiment formed in 1881 from the 35th Royal Sussex Regiment of Foot and the 107th Regiment of Foot. In WWII, its battalions served across several theatres. The 1st Battalion was stationed in Egypt and Palestine before joining the 4th Indian Infantry Division. It fought in the Western Desert, then in Italy, where it endured hard fighting at Monte Cassino, before moving to Greece in late 1944. The 2nd Battalion fought with the British Expeditionary Force in France in 1940 and was evacuated from Dunkirk. It later served in North Africa, including Alam el Halfa and El Alamein. In 1943, men from the 2nd, 4th, and 5th Battalions helped form the 10th Parachute Battalion, which was engaged at Taranto and later at Arnhem. The 9th Battalion took a different route. After briefly converting to armour, it returned to infantry and fought in Burma with the 36th Division. It saw action in the Arakan, was airlifted into Myitkyina, and advanced toward Mandalay in 1945."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardDealDamageAddDamage","ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"spawnCardName":"card_event_blast;card_event_plan;card_event_production","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/ROYAL_SUSSEX_REGIMENT.ROYAL_SUSSEX_REGIMENT","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_unit_royal_sussex_regiment_photo","SourceString":"Private Putterill of the Royal Sussex Regiment, 9th Battalion, during a patrol in Burma, 1944.","LocalizedString":"Private Putterill of the Royal Sussex Regiment, 9th Battalion, during a patrol in Burma, 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_royal_sussex_regiment","owner":"card_unit_royal_sussex_regiment_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"K2Node_Event_cardPlayed","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_IsLocatedOnBoard_isIt","type":"bool",