{"format":"kards-original-reference","version":1,"id":"f81b65b850c56573","name":"card_event_seac","package":"/Game/Blueprints/Cards/Britain/OceaniaStorm/events/card_event_seac","parent":"UBaseCardObject","card":{"title":"SEAC","text":"Draw a card from your deck that did not start there. Duplicate it.","flavorText":"South East Asia Command, known as SEAC, was created by the Allies in 1943 to direct operations against Japan in the South-East Asian Theatre. Its first Supreme Allied Commander was Admiral Lord Louis Mountbatten, with US General Joseph Stilwell serving as his deputy. SEAC was formally created in November 1943 and later moved its headquarters to Kandy in Ceylon. The command faced a difficult task. Southeast Asia was a secondary theatre while Allied resources were focused first on Germany and then on the Central Pacific. SEAC had to coordinate British, Indian, American, Chinese, and Commonwealth forces across a vast region. Its main wartime focus became the Burma campaign, where the Fourteenth Army, Chinese formations, American-led forces and various Allied air and naval units all had to be fitted into one strategy. By 1945, SEAC had helped support the reconquest of Burma and was preparing for operations toward Malaya when Japan surrendered. After the war, its role shifted to overseeing the Japanese surrender, recovering prisoners, restoring order, and managing occupied territories. SEAC was disbanded in 1946.","faction":"Britain","type":"order","rarity":"Unique","cost":3,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_seac","title":{"Namespace":"card_britain","Key":"card_event_seac_title","SourceString":"SEAC","LocalizedString":"SEAC"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Britain","kredits":3,"Text":{"Namespace":"card_britain","Key":"card_event_seac_text","SourceString":"Draw a card from your deck that did not start there. Duplicate it.","LocalizedString":"Draw a card from your deck that did not start there. Duplicate it."},"flavorText":{"Namespace":"card_britain","Key":"card_event_seac_history","SourceString":"South East Asia Command, known as SEAC, was created by the Allies in 1943 to direct operations against Japan in the South-East Asian Theatre. Its first Supreme Allied Commander was Admiral Lord Louis Mountbatten, with US General Joseph Stilwell serving as his deputy. SEAC was formally created in November 1943 and later moved its headquarters to Kandy in Ceylon. The command faced a difficult task. Southeast Asia was a secondary theatre while Allied resources were focused first on Germany and then on the Central Pacific. SEAC had to coordinate British, Indian, American, Chinese, and Commonwealth forces across a vast region. Its main wartime focus became the Burma campaign, where the Fourteenth Army, Chinese formations, American-led forces and various Allied air and naval units all had to be fitted into one strategy. By 1945, SEAC had helped support the reconquest of Burma and was preparing for operations toward Malaya when Japan surrendered. After the war, its role shifted to overseeing the Japanese surrender, recovering prisoners, restoring order, and managing occupied territories. SEAC was disbanded in 1946.","LocalizedString":"South East Asia Command, known as SEAC, was created by the Allies in 1943 to direct operations against Japan in the South-East Asian Theatre. Its first Supreme Allied Commander was Admiral Lord Louis Mountbatten, with US General Joseph Stilwell serving as his deputy. SEAC was formally created in November 1943 and later moved its headquarters to Kandy in Ceylon. The command faced a difficult task. Southeast Asia was a secondary theatre while Allied resources were focused first on Germany and then on the Central Pacific. SEAC had to coordinate British, Indian, American, Chinese, and Commonwealth forces across a vast region. Its main wartime focus became the Burma campaign, where the Fourteenth Army, Chinese formations, American-led forces and various Allied air and naval units all had to be fitted into one strategy. By 1945, SEAC had helped support the reconquest of Burma and was preparing for operations toward Malaya when Japan surrendered. After the war, its role shifted to overseeing the Japanese surrender, recovering prisoners, restoring order, and managing occupied territories. SEAC was disbanded in 1946."},"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::OceaniaStorm","soundEnterPlay":{"ObjectName":"SoundWave'For_the_Queen'","ObjectPath":"kards/Content/Assets/Audio/Misc/For_the_Queen.0"},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/SEAC.SEAC","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_event_seac_photo","SourceString":"British soldiers in Burma, ca. 1944.","LocalizedString":"British soldiers in Burma, ca. 1944."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"Notes":"Image needed to be customized","isDefenseBuff":true},"variables":[{"name":"possibleCards","type":"TArray<UBaseCardObject*>","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_seac","owner":"card_event_seac_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_text_Variable","type":"FText","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"Temp_text_Variable_1","type":"FText","direction":"in"},{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_GetDeckByside_deckCardIDs","type":"TArray<int32>","direction":"in"},{"name":"CallFunc_Array_Get_Item","type":"int32","direction":"in"},{"name":"CallFunc_A