{"format":"kards-original-reference","version":1,"id":"2baa21c980da99da","name":"card_unit_186th_recon_company","package":"/Game/Blueprints/Cards/Soviet/CovertOp/units/card_unit_186th_recon_company","parent":"UBaseCardObject","card":{"title":"186th RECON COMPANY","text":"When a friendly Covert unit is Revealed, give your units +1+1.","flavorText":"The 186th Reconnaissance Company was a unit of the 160th Rifle Division of the Soviet Red Army during WWII. In 1941 the division faced near destruction during the Battle of Moscow and temporarily disappeared from the Red Army's order of battle. It re-entered combat within the 33rd Army in January 1942, but it was understrength and reinforced with two rifle regiments from other divisions. The division assumed minor roles during the Battles of Rzhev, but later played a more active part in the 1943 summer offensive toward Smolensk under the 33rd Army. Following the disbandment of the Western Front in early 1944, the division joined the 2nd Belorussian Front and served under the 70th Army, and later with the 114th Rifle Corps during Operation Bagration. The 160th Division earned the Order of the Red Banner and the honorific \"Brest\" for its role in liberating the city. Afterwards the division participated in the Vistula-Oder and East Pomeranian Offensives where some of its units earned the honorific \"Gdańsk\". During the advance towards Germany the division fought through the Oder River and northward to the Baltic, ending the war in northern Germany before being disbanded in June 1945.","faction":"Soviet","type":"infantry","rarity":"Rare","cost":2,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_186th_recon_company","title":{"Namespace":"card_soviet","Key":"card_unit_186th_recon_company_title","SourceString":"186th RECON COMPANY","LocalizedString":"186th RECON COMPANY"},"Type":"ETypeEnum::infantry","attack":2,"defense":3,"range":1,"faction":"EFactionEnum::Soviet","kredits":2,"Text":{"Namespace":"card_soviet","Key":"card_unit_186th_recon_company_text","SourceString":"When a friendly Covert unit is Revealed, give your units +1+1.","LocalizedString":"When a friendly Covert unit is Revealed, give your units +1+1."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_186th_recon_company_history","SourceString":"The 186th Reconnaissance Company was a unit of the 160th Rifle Division of the Soviet Red Army during WWII. In 1941 the division faced near destruction during the Battle of Moscow and temporarily disappeared from the Red Army's order of battle. It re-entered combat within the 33rd Army in January 1942, but it was understrength and reinforced with two rifle regiments from other divisions. The division assumed minor roles during the Battles of Rzhev, but later played a more active part in the 1943 summer offensive toward Smolensk under the 33rd Army. Following the disbandment of the Western Front in early 1944, the division joined the 2nd Belorussian Front and served under the 70th Army, and later with the 114th Rifle Corps during Operation Bagration. The 160th Division earned the Order of the Red Banner and the honorific \"Brest\" for its role in liberating the city. Afterwards the division participated in the Vistula-Oder and East Pomeranian Offensives where some of its units earned the honorific \"Gdańsk\". During the advance towards Germany the division fought through the Oder River and northward to the Baltic, ending the war in northern Germany before being disbanded in June 1945.","LocalizedString":"The 186th Reconnaissance Company was a unit of the 160th Rifle Division of the Soviet Red Army during WWII. In 1941 the division faced near destruction during the Battle of Moscow and temporarily disappeared from the Red Army's order of battle. It re-entered combat within the 33rd Army in January 1942, but it was understrength and reinforced with two rifle regiments from other divisions. The division assumed minor roles during the Battles of Rzhev, but later played a more active part in the 1943 summer offensive toward Smolensk under the 33rd Army. Following the disbandment of the Western Front in early 1944, the division joined the 2nd Belorussian Front and served under the 70th Army, and later with the 114th Rifle Corps during Operation Bagration. The 160th Division earned the Order of the Red Banner and the honorific \"Brest\" for its role in liberating the city. Afterwards the division participated in the Vistula-Oder and East Pomeranian Offensives where some of its units earned the honorific \"Gdańsk\". During the advance towards Germany the division fought through the Oder River and northward to the Baltic, ending the war in northern Germany before being disbanded in June 1945."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::CurrentExpansion","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardRevealed"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Covert","EHelpBubbleTypes::Trigger"],"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/Summer_24/t_186th_recon_company_2.t_186th_recon_company_2","SubPathString":""},"ImageAnchor":"EImageAnchor::Top","artist":"Soviet WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/186th_RECON_COMPANY.186th_RECON_COMPANY","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":288.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_186th_recon_company_photo","SourceString":"Red Army soldiers attacking during Operation Bagration, 1943.","LocalizedString":"Red Army soldiers attacking during Operation Bagration, 1943."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLi