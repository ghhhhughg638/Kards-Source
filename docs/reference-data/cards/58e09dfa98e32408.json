{"format":"kards-original-reference","version":1,"id":"58e09dfa98e32408","name":"card_unit_dornier_do_17","package":"/Game/Blueprints/Cards/Germany/Homefront/units/card_unit_dornier_do_17","parent":"UBaseCardObject","card":{"title":"DORNIER DO 17Z","text":"Once per turn, gain 2 kredits and draw a card when an undestroyed unit leaves the battlefield.","flavorText":"Nicknamed the \"flying pencil\" for its slender fuselage, the Dornier Do 17 was one of the Luftwaffe’s primary light bombers in the early years of WWII. Designed in the early 1930s as a fast bomber capable of outrunning enemy fighters, the Do 17 entered Luftwaffe service in 1937 and soon saw combat in the Spanish Civil War. Crews favored its handling, particularly at low altitudes, where it proved harder to hit than its contemporaries. The most produced version, the Do 17Z, featured a glazed nose for improved visibility and typically carried a payload of 1,000 kilograms of bombs. Powered by twin Bramo 323 radial engines, it could reach speeds up to 410 km/h. The Do 17Z served in major campaigns including Poland, France, the Battle of Britain, and the early stages of Operation Barbarossa. However, its limited range and bomb load reduced its effectiveness as the war progressed. By late 1941, the Do 17 was largely removed from frontline duties and reassigned to secondary roles such as training, reconnaissance, and glider towing. A total of 2,139 Do 17s were built before production ended in 1940.","faction":"Germany","type":"bomber","rarity":"Rare","cost":3,"operationCost":2,"attack":2,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_dornier_do_17","title":{"Namespace":"card_germany","Key":"card_unit_dornier_do_17_title","SourceString":"DORNIER DO 17Z","LocalizedString":"DORNIER DO 17Z"},"Type":"ETypeEnum::bomber","attack":2,"defense":4,"range":2,"faction":"EFactionEnum::Germany","kredits":3,"Text":{"Namespace":"card_germany","Key":"card_unit_dornier_do_17_text","SourceString":"Once per turn, gain 2 kredits and draw a card when an undestroyed unit leaves the battlefield.","LocalizedString":"Once per turn, gain 2 kredits and draw a card when an undestroyed unit leaves the battlefield."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_dornier_do_17_history","SourceString":"Nicknamed the \"flying pencil\" for its slender fuselage, the Dornier Do 17 was one of the Luftwaffe’s primary light bombers in the early years of WWII. Designed in the early 1930s as a fast bomber capable of outrunning enemy fighters, the Do 17 entered Luftwaffe service in 1937 and soon saw combat in the Spanish Civil War. Crews favored its handling, particularly at low altitudes, where it proved harder to hit than its contemporaries. The most produced version, the Do 17Z, featured a glazed nose for improved visibility and typically carried a payload of 1,000 kilograms of bombs. Powered by twin Bramo 323 radial engines, it could reach speeds up to 410 km/h. The Do 17Z served in major campaigns including Poland, France, the Battle of Britain, and the early stages of Operation Barbarossa. However, its limited range and bomb load reduced its effectiveness as the war progressed. By late 1941, the Do 17 was largely removed from frontline duties and reassigned to secondary roles such as training, reconnaissance, and glider towing. A total of 2,139 Do 17s were built before production ended in 1940.","LocalizedString":"Nicknamed the \"flying pencil\" for its slender fuselage, the Dornier Do 17 was one of the Luftwaffe’s primary light bombers in the early years of WWII. Designed in the early 1930s as a fast bomber capable of outrunning enemy fighters, the Do 17 entered Luftwaffe service in 1937 and soon saw combat in the Spanish Civil War. Crews favored its handling, particularly at low altitudes, where it proved harder to hit than its contemporaries. The most produced version, the Do 17Z, featured a glazed nose for improved visibility and typically carried a payload of 1,000 kilograms of bombs. Powered by twin Bramo 323 radial engines, it could reach speeds up to 410 km/h. The Do 17Z served in major campaigns including Poland, France, the Battle of Britain, and the early stages of Operation Barbarossa. However, its limited range and bomb load reduced its effectiveness as the war progressed. By late 1941, the Do 17 was largely removed from frontline duties and reassigned to secondary roles such as training, reconnaissance, and glider towing. A total of 2,139 Do 17s were built before production ended in 1940."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardLeaveBoardOrOwner","ERegisteredCardFunction::OnStartofTurn"],"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/DORNIER_DO_17Z.DORNIER_DO_17Z","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":357.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_dornier_do_17_photo","SourceString":"A formation of Dornier Do 17Z’s over France, summer 1940.","LocalizedString":"A formation of Dornier Do 17Z’s over France, summer 1940."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackBomber.BP_AttackBomber_C","SubPathString":""},"threat_level":0.4},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_dornier_do_17","owner":"card_unit_dornier_do_17_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"K2Node_Event_turnnumber","type":"int32","direction":"in"},{"name