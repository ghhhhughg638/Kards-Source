{"format":"kards-original-reference","version":1,"id":"f121d4cb53f54aa5","name":"card_unit_wespe_desert","package":"/Game/Blueprints/Cards/Germany/ToW/units/card_unit_wespe_desert","parent":"UBaseCardObject","card":{"title":"WESPE","text":"Has +1 attack if you control a tank.","flavorText":"The Sd.Kfz. 124 Wespe (German for wasp) was a German made self-propelled gun on a Panzer II chassis used during WWII. The gun was produced from early 1943 to June 1944 and 676 units were manufactured, including 159 without the gun to serve as ammunition carriers. The Wespe was first used in combat on the Eastern-Front and it’s reliability and mobility made it a great addition to the artillery formations of the Panzer divisions. The Wespe was also used in the North Africa campaign and proved very valuable for the Afrika Korps that operated in the inhospitable desert. The Wespe had a maximum speed of 40 km/h (25 mph), a crew of 5 (commander, driver and 3x gunners) and a main armament it had a 10.5 cm leFH 18/2 L/28 gun.","faction":"Germany","type":"artillery","rarity":"Uncommon","cost":3,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_wespe_desert","title":{"Namespace":"card_germany","Key":"card_unit_wespe_desert_title","SourceString":"WESPE","LocalizedString":"WESPE"},"Type":"ETypeEnum::artillery","attack":2,"defense":3,"range":2,"faction":"EFactionEnum::Germany","kredits":3,"Text":{"Namespace":"card_germany","Key":"card_unit_wespe_desert_text","SourceString":"Has +1 attack if you control a tank.","LocalizedString":"Has +1 attack if you control a tank."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_wespe_desert_history","SourceString":"The Sd.Kfz. 124 Wespe (German for wasp) was a German made self-propelled gun on a Panzer II chassis used during WWII. The gun was produced from early 1943 to June 1944 and 676 units were manufactured, including 159 without the gun to serve as ammunition carriers. The Wespe was first used in combat on the Eastern-Front and it’s reliability and mobility made it a great addition to the artillery formations of the Panzer divisions. The Wespe was also used in the North Africa campaign and proved very valuable for the Afrika Korps that operated in the inhospitable desert. The Wespe had a maximum speed of 40 km/h (25 mph), a crew of 5 (commander, driver and 3x gunners) and a main armament it had a 10.5 cm leFH 18/2 L/28 gun.","LocalizedString":"The Sd.Kfz. 124 Wespe (German for wasp) was a German made self-propelled gun on a Panzer II chassis used during WWII. The gun was produced from early 1943 to June 1944 and 676 units were manufactured, including 159 without the gun to serve as ammunition carriers. The Wespe was first used in combat on the Eastern-Front and it’s reliability and mobility made it a great addition to the artillery formations of the Panzer divisions. The Wespe was also used in the North Africa campaign and proved very valuable for the Afrika Korps that operated in the inhospitable desert. The Wespe had a maximum speed of 40 km/h (25 mph), a crew of 5 (commander, driver and 3x gunners) and a main armament it had a 10.5 cm leFH 18/2 L/28 gun."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Campaign2020","isInPermanentPool":true,"showBoostIcon":true,"EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnAfterOtherCardLeaveBoardOrOwner","ERegisteredCardFunction::OnOtherCardEnterPlay"],"soundEnterPlay":{"ObjectName":"SoundWave'Tank_Heavy_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Heavy_Move_Fx.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Tank_Heavy_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Heavy_Move_Fx.0"},"soundAttack":{"ObjectName":"SoundCue'AU_Artillery_medium_fire_Cue'","ObjectPath":"kards/Content/Assets/Audio/Projectiles_and_Impacts/Artillery/AU_Artillery_medium_fire_Cue.0"},"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","Objec