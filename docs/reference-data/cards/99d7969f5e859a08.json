{"format":"kards-original-reference","version":1,"id":"99d7969f5e859a08","name":"card_unit_semovente_75_18","package":"/Game/Blueprints/Cards/Italy/units/card_unit_semovente_75_18","parent":"UBaseCardObject","card":{"title":"SEMOVENTE DA 75/18","text":"Deals double damage against tanks.","flavorText":"The Semovente da 75/18 was an Italian self-propelled gun manufactured by Fiat-Ansaldo and used in WWII from 1942 to 1944. The idea was to build a self-propelled gun similar to the German StuG III and initially an M13 chassis was used, but later models used an M14 chassis. The gun had a crew of 3 (commander/gunner, driver, loader/radio operator), a main armament of a 75 mm obice da 75/18 model 34 gun and for secondary armament it used an 8 mm Breda model 38 or a 6.5 mm Breda model 30 machine gun. 262 units were built during the war, including a few variants.","faction":"Italy","type":"tank","rarity":"Rare","cost":3,"operationCost":1,"attack":3,"defense":3},"defaults":{"Name":"card_unit_semovente_75_18","title":{"Namespace":"card_italy","Key":"card_unit_semovente_75_18_title","SourceString":"SEMOVENTE DA 75/18","LocalizedString":"SEMOVENTE DA 75/18"},"Type":"ETypeEnum::tank","attack":3,"defense":3,"range":1,"faction":"EFactionEnum::Italy","kredits":3,"Text":{"Namespace":"card_italy","Key":"card_unit_semovente_75_18_text","SourceString":"Deals double damage against tanks.","LocalizedString":"Deals double damage against tanks."},"flavorText":{"Namespace":"card_italy","Key":"card_unit_semovente_75_18_history","SourceString":"The Semovente da 75/18 was an Italian self-propelled gun manufactured by Fiat-Ansaldo and used in WWII from 1942 to 1944. The idea was to build a self-propelled gun similar to the German StuG III and initially an M13 chassis was used, but later models used an M14 chassis. The gun had a crew of 3 (commander/gunner, driver, loader/radio operator), a main armament of a 75 mm obice da 75/18 model 34 gun and for secondary armament it used an 8 mm Breda model 38 or a 6.5 mm Breda model 30 machine gun. 262 units were built during the war, including a few variants.","LocalizedString":"The Semovente da 75/18 was an Italian self-propelled gun manufactured by Fiat-Ansaldo and used in WWII from 1942 to 1944. The idea was to build a self-propelled gun similar to the German StuG III and initially an M13 chassis was used, but later models used an M14 chassis. The gun had a crew of 3 (commander/gunner, driver, loader/radio operator), a main armament of a 75 mm obice da 75/18 model 34 gun and for secondary armament it used an 8 mm Breda model 38 or a 6.5 mm Breda model 30 machine gun. 262 units were built during the war, including a few variants."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Expansion2019","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Passive","hasBlitz":true,"heavyArmor":1,"soundEnterPlay":{"ObjectName":"SoundWave'Tank_Medium_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Medium_Move_Fx.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Tank_Medium_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Medium_Move_Fx.0"},"soundAttack":{"ObjectName":"SoundWave'Medium_Tank_Attack_Straight'","ObjectPath":"kards/Content/Assets/Audio/Units/Medium_Tank_Attack_Straight.0"},"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Armor_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Armor_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Italy/t_semovente_da_75_18.t_semovente_da_75_18","SubPathString":""},"artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/SEMOVENTE_DA_75-18.SEMOVENTE_DA_75-18","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":309.0},"historyPhotoSource":"German Federal Archives ","historyPhotoIdentificationCode":"101I-784-0208-17A","historyPhotoAuthor":"Moosmüller","historyPhotoDescription":{"Namespace":"card_italy","Key":"card_unit_semovente_75_18_photo","Sou