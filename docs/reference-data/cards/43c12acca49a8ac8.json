{"format":"kards-original-reference","version":1,"id":"43c12acca49a8ac8","name":"card_unit_456th_rifle_regiment","package":"/Game/Blueprints/Cards/Soviet/Breakthrough/units/card_unit_456th_rifle_regiment","parent":"UBaseCardObject","card":{"title":"456th RIFLE REGIMENT","text":"Gets +1+1 and Guard when your HQ takes damage.","flavorText":"The 456th Rifle Regiment was a unit of the 109th Rifle Division of the Red Army which was formed three times from 1939-1942. The 1st formation was short lived and the 2nd formation served for 6 months in 1942 in the defense of the fortress of Sevastopol where it was destroyed. The 3rd formation, mostly composed of redesignated NKVD regiments, distinguished itself in combat throughout the war. The division spent most time fighting in the Leningrad Oblast, but in 1944 the division was transferred north where they joined the 21st Army in the fight against Finnish forces in Karelia. After the capitulation of the Finnish forces the 109th Division was transferred to the 8th Army in Estonia where they assisted in clearing the Baltic coast and islands. The division was disbanded in 1946.","faction":"Soviet","type":"infantry","rarity":"Common","cost":2,"operationCost":1,"attack":1,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_456th_rifle_regiment","title":{"Namespace":"card_soviet","Key":"card_unit_456th_rifle_regiment_title","SourceString":"456th RIFLE REGIMENT","LocalizedString":"456th RIFLE REGIMENT"},"Type":"ETypeEnum::infantry","attack":1,"defense":3,"range":1,"faction":"EFactionEnum::Soviet","kredits":2,"Text":{"Namespace":"card_soviet","Key":"card_unit_456th_rifle_regiment_text","SourceString":"Gets +1+1 and Guard when your HQ takes damage.","LocalizedString":"Gets +1+1 and Guard when your HQ takes damage."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_456th_rifle_regiment_history","SourceString":"The 456th Rifle Regiment was a unit of the 109th Rifle Division of the Red Army which was formed three times from 1939-1942. The 1st formation was short lived and the 2nd formation served for 6 months in 1942 in the defense of the fortress of Sevastopol where it was destroyed. The 3rd formation, mostly composed of redesignated NKVD regiments, distinguished itself in combat throughout the war. The division spent most time fighting in the Leningrad Oblast, but in 1944 the division was transferred north where they joined the 21st Army in the fight against Finnish forces in Karelia. After the capitulation of the Finnish forces the 109th Division was transferred to the 8th Army in Estonia where they assisted in clearing the Baltic coast and islands. The division was disbanded in 1946.","LocalizedString":"The 456th Rifle Regiment was a unit of the 109th Rifle Division of the Red Army which was formed three times from 1939-1942. The 1st formation was short lived and the 2nd formation served for 6 months in 1942 in the defense of the fortress of Sevastopol where it was destroyed. The 3rd formation, mostly composed of redesignated NKVD regiments, distinguished itself in combat throughout the war. The division spent most time fighting in the Leningrad Oblast, but in 1944 the division was transferred north where they joined the 21st Army in the fight against Finnish forces in Karelia. After the capitulation of the Finnish forces the 109th Division was transferred to the 8th Army in Estonia where they assisted in clearing the Baltic coast and islands. The division was disbanded in 1946."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Breakthrough","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardDealDamage"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Guard"],"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Small'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Small.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/WE_Candidates/t_volmi_soviei