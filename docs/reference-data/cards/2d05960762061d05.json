{"format":"kards-original-reference","version":1,"id":"2d05960762061d05","name":"card_unit_type_1_37mm","package":"/Game/Blueprints/Cards/Japan/Allegiance/units/card_unit_type_1_37mm","parent":"UBaseCardObject","card":{"title":"TYPE 1 37mm","text":"Deployment: Gets +1+1 and Blitz if your HQ has 10 or less defense.","flavorText":"The Type 1 37mm was an anti-tank gun used and developed by the Imperial Japanese Army during WWII. Prior to that time they had been using the Type 93 37 mm AT Gun, but it had its shortcomings and was not capable of piercing the armor of new Soviet tanks. The solution was to modify the Type 93 AT Gun with a longer barrel which would provide it with greater firepower. The new gun was designated Type 1 37mm Anti-tank Gun and 2,300 guns were produced. The gun was used in frontline service in the Pacific Theater and was moderately effective against Allied light tanks but did little damage against medium tanks such as the M4 Sherman.","faction":"Japan","type":"artillery","rarity":"Common","cost":2,"operationCost":1,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_type_1_37mm","title":{"Namespace":"card_japan","Key":"card_unit_type_1_37mm_title","SourceString":"TYPE 1 37mm","LocalizedString":"TYPE 1 37mm"},"Type":"ETypeEnum::artillery","attack":1,"defense":2,"range":2,"faction":"EFactionEnum::Japan","kredits":2,"Text":{"Namespace":"card_japan","Key":"card_unit_type_1_37mm_text","SourceString":"Deployment: Gets +1+1 and Blitz if your HQ has 10 or less defense.","LocalizedString":"Deployment: Gets +1+1 and Blitz if your HQ has 10 or less defense."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_type_1_37mm_history","SourceString":"The Type 1 37mm was an anti-tank gun used and developed by the Imperial Japanese Army during WWII. Prior to that time they had been using the Type 93 37 mm AT Gun, but it had its shortcomings and was not capable of piercing the armor of new Soviet tanks. The solution was to modify the Type 93 AT Gun with a longer barrel which would provide it with greater firepower. The new gun was designated Type 1 37mm Anti-tank Gun and 2,300 guns were produced. The gun was used in frontline service in the Pacific Theater and was moderately effective against Allied light tanks but did little damage against medium tanks such as the M4 Sherman.","LocalizedString":"The Type 1 37mm was an anti-tank gun used and developed by the Imperial Japanese Army during WWII. Prior to that time they had been using the Type 93 37 mm AT Gun, but it had its shortcomings and was not capable of piercing the armor of new Soviet tanks. The solution was to modify the Type 93 AT Gun with a longer barrel which would provide it with greater firepower. The new gun was designated Type 1 37mm Anti-tank Gun and 2,300 guns were produced. The gun was used in frontline service in the Pacific Theater and was moderately effective against Allied light tanks but did little damage against medium tanks such as the M4 Sherman."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Expansion2019","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment","EHelpBubbleTypes::Blitz"],"hasDeployment":true,"soundEnterPlay":{"ObjectName":"SoundWave'Artillery_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Artillery_Move_FX.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Artillery_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Artillery_Move_FX.0"},"soundAttack":{"ObjectName":"SoundWave'Medium_Artillery'","ObjectPath":"kards/Content/Assets/Audio/Units/Medium_Artillery.0"},"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/t_type1_37mm_aa.t_type1_37mm_aa","SubPathString":""},"artist":"Volmi","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/TYPE_1_37mm.TYPE_1_37mm","SubPathString":""},"historyPhotoSiz