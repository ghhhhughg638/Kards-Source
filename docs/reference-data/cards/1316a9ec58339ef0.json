{"format":"kards-original-reference","version":1,"id":"1316a9ec58339ef0","name":"card_event_fortified_position","package":"/Game/Blueprints/Cards/France/events/card_event_fortified_position","parent":"UBaseCardObject","card":{"title":"FORTIFIED POSITION","text":"Pin an enemy unit. If it is in the frontline, it Retreats.","flavorText":"Prior to WWII the French had built the heavily fortified Maginot Line along the German borders. Although the bulk of the invading German forces managed to bypass the defenses of the Maginot Line, they did attack a few of its fortified positions. The German 16th Army attacked a fortified sector called “petit ouvrage” La Feré, southeast of Sedan, and backed up by heavy artillery fire they managed to take the fortification in 4 days. Another attack was made near Wissembourg, which the French defenders managed to stop, but for most parts there were only small skirmishes along the Maginot Line. In the end all the defenders of Maginot Line were ordered out and taken as prisoners of war.","faction":"France","type":"order","rarity":"Common","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_fortified_position","title":{"Namespace":"card_france","Key":"card_event_fortified_position_title","SourceString":"FORTIFIED POSITION","LocalizedString":"FORTIFIED POSITION"},"Type":"ETypeEnum::order","faction":"EFactionEnum::France","kredits":1,"Text":{"Namespace":"card_france","Key":"card_event_fortified_position_text","SourceString":"Pin an enemy unit. If it is in the frontline, it Retreats.","LocalizedString":"Pin an enemy unit. If it is in the frontline, it Retreats."},"flavorText":{"Namespace":"card_france","Key":"card_event_fortified_position_history","SourceString":"Prior to WWII the French had built the heavily fortified Maginot Line along the German borders. Although the bulk of the invading German forces managed to bypass the defenses of the Maginot Line, they did attack a few of its fortified positions. The German 16th Army attacked a fortified sector called “petit ouvrage” La Feré, southeast of Sedan, and backed up by heavy artillery fire they managed to take the fortification in 4 days. Another attack was made near Wissembourg, which the French defenders managed to stop, but for most parts there were only small skirmishes along the Maginot Line. In the end all the defenders of Maginot Line were ordered out and taken as prisoners of war.","LocalizedString":"Prior to WWII the French had built the heavily fortified Maginot Line along the German borders. Although the bulk of the invading German forces managed to bypass the defenses of the Maginot Line, they did attack a few of its fortified positions. The German 16th Army attacked a fortified sector called “petit ouvrage” La Feré, southeast of Sedan, and backed up by heavy artillery fire they managed to take the fortification in 4 days. Another attack was made near Wissembourg, which the French defenders managed to stop, but for most parts there were only small skirmishes along the Maginot Line. In the end all the defenders of Maginot Line were ordered out and taken as prisoners of war."},"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Expansion2019","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Pin","EHelpBubbleTypes::Retreat"],"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_4'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_4.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/France/02_Allegiance/T_fortified_position.T_fortified_position","SubPathString":""},"artist":"French WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/FORTIFIED_POSITION.FORTIFIED_POSITION","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":368.0},"historyPhotoSource":"historywars.tumblr.com","historyPhotoDescription":{"Namespace":"card_france","Key":"card_e