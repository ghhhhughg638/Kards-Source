{"format":"kards-original-reference","version":1,"id":"0d255dee78e39ac1","name":"card_unit_trento_division","package":"/Game/Blueprints/Cards/Italy/units/card_unit_trento_division","parent":"UBaseCardObject","card":{"title":"TRENTO DIVISION","text":"Deployment: Destroy an enemy unit if you control another unit with 4 or more attack.","flavorText":"The 102nd Motorised Division Trento was an Italian Army division that served during WWII, primarily in North Africa as part of the Army of the Po (Italian: Armata del Po). Formed in 1935, the Trento Division was motorized for improved mobility.Its core units included the 61st and 62nd Infantry Regiments, the 7th Bersaglieri Regiment  and the 46th Artillery Regiment, with additional support units for anti-tank, engineering, and signals capabilities. The Trento Division was deployed to North Africa in 1941, where it participated in several major campaigns and battles, most notably the Siege of Tobruk and the First and Second Battles of El Alamein. During these operations, the division fought alongside German units from Rommel's Afrika Korps. Despite its efforts, the Trento Division was hampered by logistical difficulties, equipment shortages, and the harsh desert conditions. During the Second Battle of El Alamein in 1942, the division suffered significant casualties, and after the subsequent Axis retreat from North Africa, the Trento Division was declared lost.","faction":"Italy","type":"infantry","rarity":"Rare","cost":8,"operationCost":1,"attack":5,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_trento_division","title":{"Namespace":"card_italy","Key":"card_unit_trento_division_title","SourceString":"TRENTO DIVISION","LocalizedString":"TRENTO DIVISION"},"Type":"ETypeEnum::infantry","attack":5,"defense":6,"range":1,"faction":"EFactionEnum::Italy","kredits":8,"Text":{"Namespace":"card_italy","Key":"card_unit_trento_division_text","SourceString":"Deployment: Destroy an enemy unit if you control another unit with 4 or more attack.","LocalizedString":"Deployment: Destroy an enemy unit if you control another unit with 4 or more attack."},"flavorText":{"Namespace":"card_italy","Key":"card_unit_trento_division_history","SourceString":"The 102nd Motorised Division Trento was an Italian Army division that served during WWII, primarily in North Africa as part of the Army of the Po (Italian: Armata del Po). Formed in 1935, the Trento Division was motorized for improved mobility.Its core units included the 61st and 62nd Infantry Regiments, the 7th Bersaglieri Regiment  and the 46th Artillery Regiment, with additional support units for anti-tank, engineering, and signals capabilities. The Trento Division was deployed to North Africa in 1941, where it participated in several major campaigns and battles, most notably the Siege of Tobruk and the First and Second Battles of El Alamein. During these operations, the division fought alongside German units from Rommel's Afrika Korps. Despite its efforts, the Trento Division was hampered by logistical difficulties, equipment shortages, and the harsh desert conditions. During the Second Battle of El Alamein in 1942, the division suffered significant casualties, and after the subsequent Axis retreat from North Africa, the Trento Division was declared lost.","LocalizedString":"The 102nd Motorised Division Trento was an Italian Army division that served during WWII, primarily in North Africa as part of the Army of the Po (Italian: Armata del Po). Formed in 1935, the Trento Division was motorized for improved mobility.Its core units included the 61st and 62nd Infantry Regiments, the 7th Bersaglieri Regiment  and the 46th Artillery Regiment, with additional support units for anti-tank, engineering, and signals capabilities. The Trento Division was deployed to North Africa in 1941, where it participated in several major campaigns and battles, most notably the Siege of Tobruk and the First and Second Battles of El Alamein. During these operations, the division fought alongside German units from Rommel's Afrika Korps. Despite its efforts, the Trento Division was hampered by logistical difficulties, equipment shortages, and the harsh desert conditions. During the Second Battle of El Alamein in 1942, the division suffered significant casualties, and after the subsequent Axis retreat from North Africa, the Trento Division was declared lost."},"operationCost":1,"rarity":"ERarityEnum::Rare","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::BloodAndIron","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"hasBlitz":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Italy/Winter_2024/t_trento_division.t_trento_division","SubPathString":""},"artist":"Ken Smith","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/TRENTO_DIVISION.TRENTO_DIVISION","SubPathString":""},"historyPhotoSize":{"X":358.0,"Y":512.0},"historyPhotoDescription":{"Namespace":"card_italy","Key":"card_unit_trento_division_photo","SourceString":"Italian infantry during the Siege of Tobruk, 1941.","LocalizedString":"Italian infantry during the Siege of Tobruk, 1941."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"CanPlayFromHand","owner":"card_unit_trento_division_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}]