{"format":"kards-original-reference","version":1,"id":"e155aa18d070a19b","name":"card_unit_p_38_lightning_home","package":"/Game/Blueprints/Cards/USA/Homefront/units/card_unit_p_38_lightning_home","parent":"UBaseCardObject","card":{"title":"P-38H LIGHTNING","text":"Destruction: The top unit of your deck gets +3 attack and Blitz.","flavorText":"The Lockheed P-38 Lightning was a distinctive twin-engine fighter with a twin-boom design and a central nacelle for the pilot. Developed for high-altitude interception, it was the only US fighter in production from the beginning to the end of WWII. Over 10,000 were built, including around 600 P-38H variants. Introduced in mid-1943, the P-38H was powered by two Allison V-1710-89/91 engines and featured improved intercoolers and a stronger airframe. It carried a 20 mm cannon and four .50 caliber machine guns in the nose, allowing for concentrated fire without convergence issues. The H model could carry up to 3,200 pounds of bombs or drop tanks, making it highly versatile. The P-38 saw its greatest success in the Pacific, where its long range made it ideal for escort missions and island-hopping campaigns. It was flown by America’s top aces, including Richard Bong and Thomas McGuire. Though eventually overshadowed in Europe by the P-51 Mustang, the Lightning remained crucial in multiple roles, as fighter, bomber, pathfinder and reconnaissance aircraft. With its quiet engines and forgiving handling, the P-38H offered a balance of firepower, endurance and adaptability that proved vital in the air war.","faction":"USA","type":"fighter","rarity":"Rare","cost":5,"operationCost":2,"attack":4,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_p_38_lightning_home","title":{"Namespace":"card_usa","Key":"card_unit_p_38_lightning_home_title","SourceString":"P-38H LIGHTNING","LocalizedString":"P-38H LIGHTNING"},"Type":"ETypeEnum::fighter","attack":4,"defense":5,"range":2,"faction":"EFactionEnum::USA","kredits":5,"Text":{"Namespace":"card_usa","Key":"card_unit_p_38_lightning_home_text","SourceString":"Destruction: The top unit of your deck gets +3 attack and Blitz.","LocalizedString":"Destruction: The top unit of your deck gets +3 attack and Blitz."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_p_38_lightning_home_history","SourceString":"The Lockheed P-38 Lightning was a distinctive twin-engine fighter with a twin-boom design and a central nacelle for the pilot. Developed for high-altitude interception, it was the only US fighter in production from the beginning to the end of WWII. Over 10,000 were built, including around 600 P-38H variants. Introduced in mid-1943, the P-38H was powered by two Allison V-1710-89/91 engines and featured improved intercoolers and a stronger airframe. It carried a 20 mm cannon and four .50 caliber machine guns in the nose, allowing for concentrated fire without convergence issues. The H model could carry up to 3,200 pounds of bombs or drop tanks, making it highly versatile. The P-38 saw its greatest success in the Pacific, where its long range made it ideal for escort missions and island-hopping campaigns. It was flown by America’s top aces, including Richard Bong and Thomas McGuire. Though eventually overshadowed in Europe by the P-51 Mustang, the Lightning remained crucial in multiple roles, as fighter, bomber, pathfinder and reconnaissance aircraft. With its quiet engines and forgiving handling, the P-38H offered a balance of firepower, endurance and adaptability that proved vital in the air war.","LocalizedString":"The Lockheed P-38 Lightning was a distinctive twin-engine fighter with a twin-boom design and a central nacelle for the pilot. Developed for high-altitude interception, it was the only US fighter in production from the beginning to the end of WWII. Over 10,000 were built, including around 600 P-38H variants. Introduced in mid-1943, the P-38H was powered by two Allison V-1710-89/91 engines and featured improved intercoolers and a stronger airframe. It carried a 20 mm cannon and four .50 caliber machine guns in the nose, allowing for concentrated fire without convergence issues. The H model could carry up to 3,200 pounds of bombs or drop tanks, making it highly versatile. The P-38 saw its greatest success in the Pacific, where its long range made it ideal for escort missions and island-hopping campaigns. It was flown by America’s top aces, including Richard Bong and Thomas McGuire. Though eventually overshadowed in Europe by the P-51 Mustang, the Lightning remained crucial in multiple roles, as fighter, bomber, pathfinder and reconnaissance aircraft. With its quiet engines and forgiving handling, the P-38H offered a balance of firepower, endurance and adaptability that proved vital in the air war."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Homefront","hasDestruction":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/P-38H_LIGHTNING.P-38H_LIGHTNING","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_p_38_lightning_home_photo","SourceString":"A Lockheed P-38H Lightning in flight, 1944.","LocalizedString":"A Lockheed P-38H Lightning in flight, 1944."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackFighter.BP_AttackFighter_C","SubPathString":""}},"variables":[{"name":"unitOnTop","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_p_38_lightning_home","owner":"card_unit_p_38_lightning_home_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction |