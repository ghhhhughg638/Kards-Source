{"format":"kards-original-reference","version":1,"id":"c7fdd9ae5351600f","name":"card_unit_144th_infantry_regiment","package":"/Game/Blueprints/Cards/Japan/Allegiance/units/card_unit_144th_infantry_regiment","parent":"UBaseCardObject","card":{"title":"144th INFANTRY REGIMENT","text":"Destruction: Deal damage to the enemy HQ equal to the kredit slots you have lost this battle.","flavorText":"The 144th Infantry Regiment was attached to the 55th Division of the Imperial Japanese Army during WWII. In 1941 the regiment became part of the South Seas Detachment, a brigade sized force used to seize the islands of Guam. After a failed attempt to seize Wake Island the 144th Regiment was sent back to rejoin the 55th Division for the New Guinea Campaign where it fought in several battles and campaigns. That last major engagement was a failed offensive against the British and Commonwealth forces in what became known as the Battle of the Admin Box and took place in Myanmar. After that the division was on retreat and was located in Cambodia when Japan surrendered in 1945.","faction":"Japan","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":0,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_144th_infantry_regiment","title":{"Namespace":"card_japan","Key":"card_unit_144th_infantry_regiment_title","SourceString":"144th INFANTRY REGIMENT","LocalizedString":"144th INFANTRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":3,"defense":3,"range":1,"faction":"EFactionEnum::Japan","kredits":3,"Text":{"Namespace":"card_japan","Key":"card_unit_144th_infantry_regiment_text","SourceString":"Destruction: Deal damage to the enemy HQ equal to the kredit slots you have lost this battle.","LocalizedString":"Destruction: Deal damage to the enemy HQ equal to the kredit slots you have lost this battle."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_144th_infantry_regiment_history","SourceString":"The 144th Infantry Regiment was attached to the 55th Division of the Imperial Japanese Army during WWII. In 1941 the regiment became part of the South Seas Detachment, a brigade sized force used to seize the islands of Guam. After a failed attempt to seize Wake Island the 144th Regiment was sent back to rejoin the 55th Division for the New Guinea Campaign where it fought in several battles and campaigns. That last major engagement was a failed offensive against the British and Commonwealth forces in what became known as the Battle of the Admin Box and took place in Myanmar. After that the division was on retreat and was located in Cambodia when Japan surrendered in 1945.","LocalizedString":"The 144th Infantry Regiment was attached to the 55th Division of the Imperial Japanese Army during WWII. In 1941 the regiment became part of the South Seas Detachment, a brigade sized force used to seize the islands of Guam. After a failed attempt to seize Wake Island the 144th Regiment was sent back to rejoin the 55th Division for the New Guinea Campaign where it fought in several battles and campaigns. That last major engagement was a failed offensive against the British and Commonwealth forces in what became known as the Battle of the Admin Box and took place in Myanmar. After that the division was on retreat and was located in Cambodia when Japan surrendered in 1945."},"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Expansion2019","returnSet":"ECardSetEnum::CurrentExpansion","usedTriggers":["ERegisteredCardFunction::OnOtherCardCreatedAlterCard"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Destruction"],"hasDestruction":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/t_inf_wrobel.t_inf_wrobel","SubPathString":""},"artist":"Jarosław Wróbel","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/144th_INFANTRY_REGIMENT.144th_INFANTRY_REGIMENT","SubPathString":""},"h