{"format":"kards-original-reference","version":1,"id":"5e4e502f303347aa","name":"card_unit_katyusha","package":"/Game/Blueprints/Cards/Soviet/Base/units/card_unit_katyusha","parent":"UBaseCardObject","card":{"title":"KATYUSHA","text":"When KATYUSHA attacks, it deals 0-1 additional damage.","flavorText":"The Katyusha was a Soviet multiple rocket launcher that was first built and used in WWII. The Katyucha rocket launcher was cheap to produce, it could be fitted on any type of chassis, and mostly it was mounted on ordinary trucks. The rocket launcher could deliver explosives to a target more quickly than conventional artillery, but the accuracy was lower and it took a longer time to reload. Red Army troops nicknamed the rocket launcher Katyusha from Mikhail Isakovsky's popular wartime song bearing the same name. The German troops nicknamed it \"Stalin's organ\" since the launcher array resembled pipe organs, and due to the howling sound of the rocket motors when it launched.","faction":"Soviet","type":"artillery","rarity":"Uncommon","cost":2,"operationCost":1,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_katyusha","title":{"Namespace":"card_soviet","Key":"card_unit_katyusha_title","SourceString":"KATYUSHA","LocalizedString":"KATYUSHA"},"Type":"ETypeEnum::artillery","attack":1,"defense":2,"range":2,"faction":"EFactionEnum::Soviet","kredits":2,"Text":{"Namespace":"card_soviet","Key":"card_unit_katyusha_text","SourceString":"When KATYUSHA attacks, it deals 0-1 additional damage.","LocalizedString":"When KATYUSHA attacks, it deals 0-1 additional damage."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_katyusha_history","SourceString":"The Katyusha was a Soviet multiple rocket launcher that was first built and used in WWII. The Katyucha rocket launcher was cheap to produce, it could be fitted on any type of chassis, and mostly it was mounted on ordinary trucks. The rocket launcher could deliver explosives to a target more quickly than conventional artillery, but the accuracy was lower and it took a longer time to reload. Red Army troops nicknamed the rocket launcher Katyusha from Mikhail Isakovsky's popular wartime song bearing the same name. The German troops nicknamed it \"Stalin's organ\" since the launcher array resembled pipe organs, and due to the howling sound of the rocket motors when it launched.","LocalizedString":"The Katyusha was a Soviet multiple rocket launcher that was first built and used in WWII. The Katyucha rocket launcher was cheap to produce, it could be fitted on any type of chassis, and mostly it was mounted on ordinary trucks. The rocket launcher could deliver explosives to a target more quickly than conventional artillery, but the accuracy was lower and it took a longer time to reload. Red Army troops nicknamed the rocket launcher Katyusha from Mikhail Isakovsky's popular wartime song bearing the same name. The German troops nicknamed it \"Stalin's organ\" since the launcher array resembled pipe organs, and due to the howling sound of the rocket motors when it launched."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Basic","isInPermanentPool":true,"EffectType":"ECardEffectTypes::Trigger","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Blitz","EHelpBubbleTypes::Trigger"],"hasBlitz":true,"soundEnterPlay":{"ObjectName":"SoundCue'AU_Rocket_Art_Katyusha_IntoPos_Cue'","ObjectPath":"kards/Content/Assets/Audio/Artillary/AU_Rocket_Art_Katyusha_IntoPos_Cue.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Artillery_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Artillery_Move_FX.0"},"soundAttack":{"ObjectName":"SoundCue'AU_Rocket_Art_Katyusha_fire_Cue'","ObjectPath":"kards/Content/Assets/Audio/Artillary/AU_Rocket_Art_Katyusha_fire_Cue.0"},"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/Katyusha_new.Katyu