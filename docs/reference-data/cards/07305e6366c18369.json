a’s aircraft later found USS Yorktown and shadowed her for hours. Cruiser scouts gave commanders vital information, but delays, mistakes, and fragile communications could turn even successful sightings into missed chances."},"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::OceaniaStorm","usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"spawnCardName":"card_event_sunny1_blue_sky;card_event_rain1_mist;card_event_storm1_gale","soundEnterPlay":{"ObjectName":"SoundWave'Naval_Support_17'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Naval_Support_17.0"},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/CRUISER_SCOUTS.CRUISER_SCOUTS","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_event_cruiser_scouts_photo","SourceString":"Japanese heavy cruiser Chikuma. Date unknown.","LocalizedString":"Japanese heavy cruiser Chikuma. Date unknown."},"isDraw":true,"isDefenseBuff":true},"variables":[],"functions":[{"name":"CanPlayFromHand","owner":"card_event_cruiser_scouts_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","direction":"in"},{"name":"CallFunc_GetTargetedCard_card","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_IsUnit_isIt","type":"bool","direction":"in"}],"body":[{"op":"Context","at":0,"object":{"op":"Variable","name":"cardFunction","type":"ACardFunctionsStub*","scope":"member","sourceOp":"InstanceVariable"},"value":{"op":"LocalVirtualFunction","name":"GetTargetedCard","signature":"CardFunctionsStu