{"format":"kards-original-reference","version":1,"id":"75cb5f297752908e","name":"card_unit_nara_regiment","package":"/Game/Blueprints/Cards/Japan/Legions/units/card_unit_nara_regiment","parent":"UBaseCardObject","card":{"title":"NARA REGIMENT","text":"Ignore \"Cannot attack the enemy HQ\" on your units.","flavorText":"The Nara Regiment was a unit of the 29th Division (call sign Thunder Division) of the Imperial Japanese Army during WWII. The division was active from 1941-1945 and was to begin with part of the Kwantung Army and tasked with the defense of the Liaoyang area in Manchukuo state. In early March 1944 the division was assigned to the 31st Army and sent to Guam to participate in the defense of the island together with the 48th Independent Mixed Brigade. From 21 July to 10 August 1944 the division participated in the Battle of Guam which ended in an American victory and the surrender of the remaining Japanese forces, although a few Japanese soldiers held out in the jungle for much longer. One of them, Sergeant Shoichi Yokoi, surrendered in 1972 after living alone in a cave for 27 years.","faction":"Japan","type":"infantry","rarity":"Rare","cost":4,"operationCost":2,"attack":3,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_nara_regiment","title":{"Namespace":"card_japan","Key":"card_unit_nara_regiment_title","SourceString":"NARA REGIMENT","LocalizedString":"NARA REGIMENT"},"Type":"ETypeEnum::infantry","attack":3,"defense":6,"range":1,"faction":"EFactionEnum::Japan","kredits":4,"Text":{"Namespace":"card_japan","Key":"card_unit_nara_regiment_text","SourceString":"Ignore \"Cannot attack the enemy HQ\" on your units.","LocalizedString":"Ignore \"Cannot attack the enemy HQ\" on your units."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_nara_regiment_history","SourceString":"The Nara Regiment was a unit of the 29th Division (call sign Thunder Division) of the Imperial Japanese Army during WWII. The division was active from 1941-1945 and was to begin with part of the Kwantung Army and tasked with the defense of the Liaoyang area in Manchukuo state. In early March 1944 the division was assigned to the 31st Army and sent to Guam to participate in the defense of the island together with the 48th Independent Mixed Brigade. From 21 July to 10 August 1944 the division participated in the Battle of Guam which ended in an American victory and the surrender of the remaining Japanese forces, although a few Japanese soldiers held out in the jungle for much longer. One of them, Sergeant Shoichi Yokoi, surrendered in 1972 after living alone in a cave for 27 years.","LocalizedString":"The Nara Regiment was a unit of the 29th Division (call sign Thunder Division) of the Imperial Japanese Army during WWII. The division was active from 1941-1945 and was to begin with part of the Kwantung Army and tasked with the defense of the Liaoyang area in Manchukuo state. In early March 1944 the division was assigned to the 31st Army and sent to Guam to participate in the defense of the island together with the 48th Independent Mixed Brigade. From 21 July to 10 August 1944 the division participated in the Battle of Guam which ended in an American victory and the surrender of the remaining Japanese forces, although a few Japanese soldiers held out in the jungle for much longer. One of them, Sergeant Shoichi Yokoi, surrendered in 1972 after living alone in a cave for 27 years."},"operationCost":2,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Legions","isInPermanentPool":true,"showBoostIcon":true,"EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardEnterPlay","ERegisteredCardFunction::OnOtherCardLeaveBoardOrOwner","ERegisteredCardFunction::OnOtherCardSuppressed"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Guard"],"hasGuard":true,"soundBlowUp":{"ObjectName":"SoundCue'au_inf_conrete'","ObjectPath":"kards/Content/Explosions_SFX/Cues/au_inf_conrete.0"},"Image":{"AssetPathName":"/Game/