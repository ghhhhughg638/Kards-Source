{"format":"kards-original-reference","version":1,"id":"4acbb64d286d4b9d","name":"card_event_shinyo_motorboats","package":"/Game/Blueprints/Cards/Japan/OceaniaStorm/events/card_event_shinyo_motorboats","parent":"UBaseCardObject","card":{"title":"SHINYO MOTORBOATS","text":"Lose a kredit slot. Deal damage to target unit equal to kredit slots lost this battle plus 1.","flavorText":"Shinyo motorboats were fast explosive suicide boats developed by Japan during WWII as part of the Special Attack Units program. Their name meant “Sea Quake”. The program began in 1944 after Japan’s situation in the war had worsened. Early plans used steel hulls, but shortages led to a switch to wooden construction. Production ran from April 1944 to June 1945, and 6,197 boats were completed for the Imperial Japanese Navy. The standard Shinyo was a small one-man craft powered by a Toyota Type B engine. Type 1 boats could reach about 26 knots, while the larger Type 5 could reach about 30 knots and was manned by a crew of two. Each boat carried a bow-mounted explosive charge of about 270 kilograms, with two anti-ship rockets mounted behind the driver. Shinyo boats saw their main use during the Philippines campaign, in 1944 and 1945. They sank or damaged several Allied vessels around Luzon, Corregidor and Okinawa. By the end of the war, hundreds had been sent to Okinawa, Formosa, Hong Kong, and the Japanese home islands.","faction":"Japan","type":"order","rarity":"Uncommon","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_shinyo_motorboats","title":{"Namespace":"card_japan","Key":"card_event_shinyo_motorboats_title","SourceString":"SHINYO MOTORBOATS","LocalizedString":"SHINYO MOTORBOATS"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Japan","kredits":1,"Text":{"Namespace":"card_japan","Key":"card_event_shinyo_motorboats_text","SourceString":"Lose a kredit slot. Deal damage to target unit equal to kredit slots lost this battle plus 1.","LocalizedString":"Lose a kredit slot. Deal damage to target unit equal to kredit slots lost this battle plus 1."},"flavorText":{"Namespace":"card_japan","Key":"card_event_shinyo_motorboats_history","SourceString":"Shinyo motorboats were fast explosive suicide boats developed by Japan during WWII as part of the Special Attack Units program. Their name meant “Sea Quake”. The program began in 1944 after Japan’s situation in the war had worsened. Early plans used steel hulls, but shortages led to a switch to wooden construction. Production ran from April 1944 to June 1945, and 6,197 boats were completed for the Imperial Japanese Navy. The standard Shinyo was a small one-man craft powered by a Toyota Type B engine. Type 1 boats could reach about 26 knots, while the larger Type 5 could reach about 30 knots and was manned by a crew of two. Each boat carried a bow-mounted explosive charge of about 270 kilograms, with two anti-ship rockets mounted behind the driver. Shinyo boats saw their main use during the Philippines campaign, in 1944 and 1945. They sank or damaged several Allied vessels around Luzon, Corregidor and Okinawa. By the end of the war, hundreds had been sent to Okinawa, Formosa, Hong Kong, and the Japanese home islands.","LocalizedString":"Shinyo motorboats were fast explosive suicide boats developed by Japan during WWII as part of the Special Attack Units program. Their name meant “Sea Quake”. The program began in 1944 after Japan’s situation in the war had worsened. Early plans used steel hulls, but shortages led to a switch to wooden construction. Production ran from April 1944 to June 1945, and 6,197 boats were completed for the Imperial Japanese Navy. The standard Shinyo was a small one-man craft powered by a Toyota Type B engine. Type 1 boats could reach about 26 knots, while the larger Type 5 could reach about 30 knots and was manned by a crew of two. Each boat carried a bow-mounted explosive charge of about 270 kilograms, with two anti-ship rockets mounted behind the driver. Shinyo boats saw their main use during the Philippines campaign, in 1944 and 1945. They sank or damaged several Allied vessels around Luzon, Corregidor and Okinawa. By the end of the war, hundreds had been sent to Okinawa, Formosa, Hong Kong, and the Japanese home islands."},"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::OceaniaStorm","usedTriggers":["ERegisteredCardFunction::OnOtherCardDealDamageAddDamage"],"soundEnterPlay":{"ObjectName":"SoundWave'Naval_Support_17'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Naval_Support_17.0"},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/SHINYO_MOTORBOATS.SHINYO_MOTORBOATS","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_event_shinyo_motorboats_photo","SourceString":"A captured Shinyo suicide motorboat, 1945.","LocalizedString":"A captured Shinyo suicide motorboat, 1945."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"isRemoval":true},"variables":[{"name":"kamFound","type":"bool","direction":"in"}],"functions":[{"name":"CanPlayFromHand","owner":"card_event_shinyo_motorboats_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","direction":"in"},{"name":"CallFunc_GetTargetedCard_card","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_IsUnit_isIt","type":"bool","direction":"in"}],"body":[{"op":"Context","at":0,"object":{"op":"Variable","name":"cardFunction","type":"ACar