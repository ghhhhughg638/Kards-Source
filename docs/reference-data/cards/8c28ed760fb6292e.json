{"format":"kards-original-reference","version":1,"id":"8c28ed760fb6292e","name":"card_unit_the_polar_bears","package":"/Game/Blueprints/Cards/Britain/Homefront/units/card_unit_the_polar_bears","parent":"UBaseCardObject","card":{"title":"THE POLAR BEARS","text":"Deployment: Gets +1+1 if you deployed a British infantry last turn.","flavorText":"The 49th (West Riding) Infantry Division earned the nickname \"The Polar Bears\" during their deployment to Iceland in 1940. Tasked with garrison duties to prevent German occupation, they adopted the polar bear as their divisional insignia. After returning to Britain in 1942, the division underwent extensive training before joining the Normandy campaign in June 1944. Attached to I Corps, they were initially tasked with securing the left flank of the Allied beachhead, fighting around Caen and advancing through the Bocage. The Polar Bears played a key role in Operation Martlet and the costly battles for Rauray and Fontenay-le-Pesnel. In the final push into the Low Countries and Germany, they participated in clearing the Scheldt estuary and crossed the Rhine in March 1945. Under the command of Major General Evelyn Barker, the division developed a reputation for discipline and toughness in battle. By war's end, they had advanced deep into northwestern Germany, contributing significantly to the Allied victory in Europe.","faction":"Britain","type":"infantry","rarity":"Common","cost":2,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.bond"],"Name":"card_unit_the_polar_bears","title":{"Namespace":"card_britain","Key":"card_unit_the_polar_bears_title","SourceString":"THE POLAR BEARS","LocalizedString":"THE POLAR BEARS"},"Type":"ETypeEnum::infantry","attack":2,"defense":3,"range":1,"faction":"EFactionEnum::Britain","kredits":2,"Text":{"Namespace":"card_britain","Key":"card_unit_the_polar_bears_text","SourceString":"Deployment: Gets +1+1 if you deployed a British infantry last turn.","LocalizedString":"Deployment: Gets +1+1 if you deployed a British infantry last turn."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_the_polar_bears_history","SourceString":"The 49th (West Riding) Infantry Division earned the nickname \"The Polar Bears\" during their deployment to Iceland in 1940. Tasked with garrison duties to prevent German occupation, they adopted the polar bear as their divisional insignia. After returning to Britain in 1942, the division underwent extensive training before joining the Normandy campaign in June 1944. Attached to I Corps, they were initially tasked with securing the left flank of the Allied beachhead, fighting around Caen and advancing through the Bocage. The Polar Bears played a key role in Operation Martlet and the costly battles for Rauray and Fontenay-le-Pesnel. In the final push into the Low Countries and Germany, they participated in clearing the Scheldt estuary and crossed the Rhine in March 1945. Under the command of Major General Evelyn Barker, the division developed a reputation for discipline and toughness in battle. By war's end, they had advanced deep into northwestern Germany, contributing significantly to the Allied victory in Europe.","LocalizedString":"The 49th (West Riding) Infantry Division earned the nickname \"The Polar Bears\" during their deployment to Iceland in 1940. Tasked with garrison duties to prevent German occupation, they adopted the polar bear as their divisional insignia. After returning to Britain in 1942, the division underwent extensive training before joining the Normandy campaign in June 1944. Attached to I Corps, they were initially tasked with securing the left flank of the Allied beachhead, fighting around Caen and advancing through the Bocage. The Polar Bears played a key role in Operation Martlet and the costly battles for Rauray and Fontenay-le-Pesnel. In the final push into the Low Countries and Germany, they participated in clearing the Scheldt estuary and crossed the Rhine in March 1945. Under the command of Major General Evelyn Barker, the division developed a reputation for discipline and toughness in battle. By war's end, they had advanced deep into northwestern Germany, contributing significantly to the Allied victory in Europe."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Homefront","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"hasDeployment":true,"hasFury":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/THE_POLAR_BEARS.THE_POLAR_BEARS","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":512.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_unit_the_polar_bears_photo","SourceString":"Infantrymen of the Polar Bears Division in the village of Fontenay-le-Pesnel, Normandy, France, 25 June 1944.","LocalizedString":"Infantrymen of the Polar Bears Division in the village of Fontenay-le-Pesnel, Normandy, France, 25 June 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"name":"didPlayBritishInfantryLastTurn","owner":"card_unit_the_polar_bears_C","params":[{"name":"didSo","type":"bool","direction":"out"}],"pure":true,"event":false,"flags":"FUNC_Public | FUNC_HasOutParms | FUNC_HasDefaults | FUNC_BlueprintCallable | FUNC_BlueprintEvent | FUNC_BlueprintPure","locals":[{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in