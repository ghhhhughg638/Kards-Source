{"format":"kards-original-reference","version":1,"id":"2be3b776292aadc2","name":"card_event_vystrel_course","package":"/Game/Blueprints/Cards/Soviet/BloodIron/events/card_event_vystrel_course","parent":"UBaseCardObject","card":{"title":"VYSTREL COURSE","text":"Target a friendly tank or infantry. At the start of your next turn give it +3+3.","flavorText":"The Higher Rifle Tactical Course for the Improvement of Infantry Commanders \"Vystrel\", commonly called Vystrel Course, was an officer training course of the Soviet Armed Forces. The school's task was officer training for the infantry, but also research and development of weaponry and the production of educational literature. The course, provided twice a year for five and a half month periods, trained battalion and regiment level command and political personnel for the rifle arm (infantry) of the Red Army. A reasonable combination of theory and practice in training yielded high results, and good feedback was received from the troops about the graduates of the course. Officers who attended the Vystrel course formed the core of officers and more than 200 graduates were awarded the title Hero of the Soviet Union.","faction":"Soviet","type":"order","rarity":"Common","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_vystrel_course","title":{"Namespace":"card_soviet","Key":"card_event_vystrel_course_title","SourceString":"VYSTREL COURSE","LocalizedString":"VYSTREL COURSE"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Soviet","kredits":2,"Text":{"Namespace":"card_soviet","Key":"card_event_vystrel_course_text","SourceString":"Target a friendly tank or infantry. At the start of your next turn give it +3+3.","LocalizedString":"Target a friendly tank or infantry. At the start of your next turn give it +3+3."},"flavorText":{"Namespace":"card_soviet","Key":"card_event_vystrel_course_history","SourceString":"The Higher Rifle Tactical Course for the Improvement of Infantry Commanders \"Vystrel\", commonly called Vystrel Course, was an officer training course of the Soviet Armed Forces. The school's task was officer training for the infantry, but also research and development of weaponry and the production of educational literature. The course, provided twice a year for five and a half month periods, trained battalion and regiment level command and political personnel for the rifle arm (infantry) of the Red Army. A reasonable combination of theory and practice in training yielded high results, and good feedback was received from the troops about the graduates of the course. Officers who attended the Vystrel course formed the core of officers and more than 200 graduates were awarded the title Hero of the Soviet Union.","LocalizedString":"The Higher Rifle Tactical Course for the Improvement of Infantry Commanders \"Vystrel\", commonly called Vystrel Course, was an officer training course of the Soviet Armed Forces. The school's task was officer training for the infantry, but also research and development of weaponry and the production of educational literature. The course, provided twice a year for five and a half month periods, trained battalion and regiment level command and political personnel for the rifle arm (infantry) of the Red Army. A reasonable combination of theory and practice in training yielded high results, and good feedback was received from the troops about the graduates of the course. Officers who attended the Vystrel course formed the core of officers and more than 200 graduates were awarded the title Hero of the Soviet Union."},"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::BloodAndIron","usedTriggers":["ERegisteredCardFunction::OnStartofTurn","ERegisteredCardFunction::OnOtherCardReset"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Countdown"],"soundEnterPlay":{"ObjectName":"SoundWave'Workers_Unite'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Workers_Unite