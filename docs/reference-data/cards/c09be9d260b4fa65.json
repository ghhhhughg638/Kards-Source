{"format":"kards-original-reference","version":1,"id":"c09be9d260b4fa65","name":"card_unit_13e_dragons","package":"/Game/Blueprints/Cards/France/units/card_unit_13e_dragons","parent":"UBaseCardObject","card":{"title":"13e DRAGONS","text":"Cannot be deployed if you have deployed a unit this turn.","flavorText":"The 13th Dragons Regiment is a unit of the French Army formed in 1791 during the French Revolution. Formerly a cavalry unit, it was transformed into an armored unit in 1936, during the mechanization of the French cavalry. Its motto is “Beyond what’s possible”. At the beginning of WWII, the 13e Dragons was equipped with Hotchkiss H35 and Somua S35 tanks, and was part of the 2nd Light Mechanized Division. They crossed the Belgian border on May 10th 1940 when the Dyle Plan was launched. Between 12 and 14 May, they fought the German XVI Motorized Corps at the Battle of Hannut, the largest tank battle in History at that time, where 400 French tanks faced 600 German tanks. The 13e Dragons kept fighting in Belgium and northern France during the second half of May. Surrounded at Dunkirk, they evacuated to England at the end of May, leaving their equipment behind. They quickly came back to France and reformed the 2nd Light Mechanized Division, charged with covering the retreat until the Armistice was signed on June 22nd, 1940. The 13e Dragons was disbanded in July, after suffering 90% casualties. It was reformed on 16 October 1944 at Orléans, and took part in the fighting against the remaining German pockets of resistance on the Atlantic coast. They notably participated in the liberation of Royan and Oléron, and the siege of La Rochelle. They were sent to Germany in May 1945, where they remained stationed until April 1946.","faction":"France","type":"infantry","rarity":"Common","cost":0,"operationCost":0,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_13e_dragons","title":{"Namespace":"card_france","Key":"card_unit_13e_dragons_title","SourceString":"13e DRAGONS","LocalizedString":"13e DRAGONS"},"Type":"ETypeEnum::infantry","attack":1,"defense":2,"range":1,"faction":"EFactionEnum::France","Text":{"Namespace":"card_france","Key":"card_unit_13e_dragons_text","SourceString":"Cannot be deployed if you have deployed a unit this turn.","LocalizedString":"Cannot be deployed if you have deployed a unit this turn."},"flavorText":{"Namespace":"card_france","Key":"card_unit_13e_dragons_history","SourceString":"The 13th Dragons Regiment is a unit of the French Army formed in 1791 during the French Revolution. Formerly a cavalry unit, it was transformed into an armored unit in 1936, during the mechanization of the French cavalry. Its motto is “Beyond what’s possible”. At the beginning of WWII, the 13e Dragons was equipped with Hotchkiss H35 and Somua S35 tanks, and was part of the 2nd Light Mechanized Division. They crossed the Belgian border on May 10th 1940 when the Dyle Plan was launched. Between 12 and 14 May, they fought the German XVI Motorized Corps at the Battle of Hannut, the largest tank battle in History at that time, where 400 French tanks faced 600 German tanks. The 13e Dragons kept fighting in Belgium and northern France during the second half of May. Surrounded at Dunkirk, they evacuated to England at the end of May, leaving their equipment behind. They quickly came back to France and reformed the 2nd Light Mechanized Division, charged with covering the retreat until the Armistice was signed on June 22nd, 1940. The 13e Dragons was disbanded in July, after suffering 90% casualties. It was reformed on 16 October 1944 at Orléans, and took part in the fighting against the remaining German pockets of resistance on the Atlantic coast. They notably participated in the liberation of Royan and Oléron, and the siege of La Rochelle. They were sent to Germany in May 1945, where they remained stationed until April 1946.","LocalizedString":"The 13th Dragons Regiment is a unit of the French Army formed in 1791 during the French Revolution. Formerly a cavalry unit, it was transformed into an armored unit in 1936, during the mechanization of the French cavalry. Its motto is “Beyond what’s possible”. At the beginning of WWII, the 13e Dragons was equipped with Hotchkiss H35 and Somua S35 tanks, and was part of the 2nd Light Mechanized Division. They crossed the Belgian border on May 10th 1940 when the Dyle Plan was launched. Between 12 and 14 May, they fought the German XVI Motorized Corps at the Battle of Hannut, the largest tank battle in History at that time, where 400 French tanks faced 600 German tanks. The 13e Dragons kept fighting in Belgium and northern France during the second half of May. Surrounded at Dunkirk, they evacuated to England at the end of May, leaving their equipment behind. They quickly came back to France and reformed the 2nd Light Mechanized Division, charged with covering the retreat until the Armistice was signed on June 22nd, 1940. The 13e Dragons was disbanded in July, after suffering 90% casualties. It was reformed on 16 October 1944 at Orléans, and took part in the fighting against the remaining German pockets of resistance on the Atlantic coast. They notably participated in the liberation of Royan and Oléron, and the siege of La Rochelle. They were sent to Germany in May 1945, where they remained stationed until April 1946."},"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::BloodAndIron","EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnStartofTurn","ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"hasBlitz":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/France/Mini_Ally_Expansion_25/t_13e_dragons.t_13e_dragons","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/13e_DRAGONS.13e_DRAGONS","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":314.0},"historyPhotoDescription":{"Namespace":"card_france","Key":"card_unit_13e_dragons_photo","SourceString":"French Hotchkiss H35 tank, Belgium, May 1940.","LocalizedString":"French Hotchkiss H35 tank, Belgium, May 1940."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"otherUnitPlayed","type":"bool","direction":"in"}],"functions":[{"name":"BlockCardFromBeingPlayedFromHand","owner":"card_unit_13e_dragons_C","params":[{"name":"blocked","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[],"body":[{"op":"JumpIfNot","at":0,"to":117,"condition":{"op":"Variable","name":"otherUnitPlayed","type":"bool","scope":"member","sourceOp":"InstanceVariable"}},{"op":"LetBool","at":14,"target":{"op":"Variable","name":"blocked","type":"bool","scope":"local","sourceOp":"LocalOutVariable"},"value":{"op":"True"}},{"op":"Let","at":25,"target":{"op":"Variable","name":"reason","type":"FString","scope":"local","sourceOp":"LocalOutVariable"},"value":{"op":"StringConst","value":"must_be_first_unit_deployed"}},{"op":"Let","at":72,"target":{"op":"Variable","name":"reasonParam1","type":"FString","scope":"local","sourceOp":"LocalOutVariable"},"value":{"op":"StringConst","value":""}},{"op":"Let","at":92,"target":{"op":"Variable","name":"reasonParam2","type":"FString","scope":"local","sourceOp":"LocalOutVariable"},"value":{"op":"StringConst","value":""}},{"op":"Jump","at":112,"to":188},{"op"