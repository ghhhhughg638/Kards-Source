{"format":"kards-original-reference","version":1,"id":"f1f7bac86585f5a8","name":"card_event_monastyr","package":"/Game/Blueprints/Cards/Soviet/WorldAtWar/events/card_event_monastyr","parent":"UBaseCardObject","card":{"title":"MONASTYR","text":"Destroy all units with 1 or fewer combat keywords.","flavorText":"Operation Monastyr (e. Operation Monastery) was a Soviet intelligence operation that lasted from 1941 to 1944 and involved using a “radio game” which was standard technique in radio counterintelligence at the time. The operation was conducted by NKVD agents and the goal was to use Soviet moles to relay misinformation to the Abwehr, the German military intelligence. The operation was considered a great success, it resulted in the capture of several German agents and collaborators. However, one of its major contributions was disinformation about major Soviet offensive operations near the town of Rzhev, which the Germans took at face value. This was partly true, but this rendered the Germans blind to the much more important Operation Uranus, the major Soviet offensive at Stalingrad.","faction":"Soviet","type":"order","rarity":"Unique","cost":8,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_monastyr","title":{"Namespace":"card_soviet","Key":"card_event_monastyr_title","SourceString":"MONASTYR","LocalizedString":"MONASTYR"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Soviet","kredits":8,"Text":{"Namespace":"card_soviet","Key":"card_event_monastyr_text","SourceString":"Destroy all units with 1 or fewer combat keywords.","LocalizedString":"Destroy all units with 1 or fewer combat keywords."},"flavorText":{"Namespace":"card_soviet","Key":"card_event_monastyr_history","SourceString":"Operation Monastyr (e. Operation Monastery) was a Soviet intelligence operation that lasted from 1941 to 1944 and involved using a “radio game” which was standard technique in radio counterintelligence at the time. The operation was conducted by NKVD agents and the goal was to use Soviet moles to relay misinformation to the Abwehr, the German military intelligence. The operation was considered a great success, it resulted in the capture of several German agents and collaborators. However, one of its major contributions was disinformation about major Soviet offensive operations near the town of Rzhev, which the Germans took at face value. This was partly true, but this rendered the Germans blind to the much more important Operation Uranus, the major Soviet offensive at Stalingrad.","LocalizedString":"Operation Monastyr (e. Operation Monastery) was a Soviet intelligence operation that lasted from 1941 to 1944 and involved using a “radio game” which was standard technique in radio counterintelligence at the time. The operation was conducted by NKVD agents and the goal was to use Soviet moles to relay misinformation to the Abwehr, the German military intelligence. The operation was considered a great success, it resulted in the capture of several German agents and collaborators. However, one of its major contributions was disinformation about major Soviet offensive operations near the town of Rzhev, which the Germans took at face value. This was partly true, but this rendered the Germans blind to the much more important Operation Uranus, the major Soviet offensive at Stalingrad."},"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::WorldAtWar","returnSet":"ECardSetEnum::Homefront","soundEnterPlay":{"ObjectName":"SoundWave'October_Red'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/October_Red.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/t_soviet_espion.t_soviet_espion","SubPathString":""},"artist":"Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/MONASTYR.MONASTYR","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":323.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_event_monastyr_photo"