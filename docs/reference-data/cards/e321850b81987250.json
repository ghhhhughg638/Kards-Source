{"format":"kards-original-reference","version":1,"id":"e321850b81987250","name":"card_unit_6th_marine_regiment","package":"/Game/Blueprints/Cards/USA/OceaniaStorm/units/card_unit_6th_marine_regiment","parent":"UBaseCardObject","card":{"title":"6th MARINE REGIMENT","text":"Has Blitz and 0 operation cost if Sunny or Rain was played this turn.","flavorText":"The 6th Marine Regiment, known as the Fighting 6th Marines, entered WWII as part of the 2nd Marine Division. After the US joined the war, the regiment first garrisoned Iceland before returning to the division and sailing for the South Pacific. It landed on Guadalcanal in January 1943 and joined the final American push from Kokumbona to Cape Esperance, helping clear the last organized Japanese forces from the island. Later that year, the regiment fought at the Battle of Tarawa, in the Gilbert Islands. The 6th Marines served as the division’s floating reserve, but fierce resistance on Betio forced its commitment early. The 1st and 3rd Battalions landed on Green Beach and pushed across the island, while the 2nd Battalion blocked the enemy on nearby Bairiki Island. The regiment suffered 355 casualties and received a Presidential Unit Citation for Tarawa. In 1944, the 6th Marines fought at Saipan and Tinian. Saipan was its costliest WWII battle, with 356 killed and 1,208 wounded. After Tinian, the regiment prepared for Okinawa and later the planned invasion of Japan, but the war ended before that landing happened.","faction":"USA","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":2,"attack":4,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_6th_marine_regiment","title":{"Namespace":"card_usa","Key":"card_unit_6th_marine_regiment_title","SourceString":"6th MARINE REGIMENT","LocalizedString":"6th MARINE REGIMENT"},"Type":"ETypeEnum::infantry","attack":4,"defense":5,"range":1,"faction":"EFactionEnum::USA","kredits":3,"Text":{"Namespace":"card_usa","Key":"card_unit_6th_marine_regiment_text","SourceString":"Has Blitz and 0 operation cost if Sunny or Rain was played this turn.","LocalizedString":"Has Blitz and 0 operation cost if Sunny or Rain was played this turn."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_6th_marine_regiment_history","SourceString":"The 6th Marine Regiment, known as the Fighting 6th Marines, entered WWII as part of the 2nd Marine Division. After the US joined the war, the regiment first garrisoned Iceland before returning to the division and sailing for the South Pacific. It landed on Guadalcanal in January 1943 and joined the final American push from Kokumbona to Cape Esperance, helping clear the last organized Japanese forces from the island. Later that year, the regiment fought at the Battle of Tarawa, in the Gilbert Islands. The 6th Marines served as the division’s floating reserve, but fierce resistance on Betio forced its commitment early. The 1st and 3rd Battalions landed on Green Beach and pushed across the island, while the 2nd Battalion blocked the enemy on nearby Bairiki Island. The regiment suffered 355 casualties and received a Presidential Unit Citation for Tarawa. In 1944, the 6th Marines fought at Saipan and Tinian. Saipan was its costliest WWII battle, with 356 killed and 1,208 wounded. After Tinian, the regiment prepared for Okinawa and later the planned invasion of Japan, but the war ended before that landing happened.","LocalizedString":"The 6th Marine Regiment, known as the Fighting 6th Marines, entered WWII as part of the 2nd Marine Division. After the US joined the war, the regiment first garrisoned Iceland before returning to the division and sailing for the South Pacific. It landed on Guadalcanal in January 1943 and joined the final American push from Kokumbona to Cape Esperance, helping clear the last organized Japanese forces from the island. Later that year, the regiment fought at the Battle of Tarawa, in the Gilbert Islands. The 6th Marines served as the division’s floating reserve, but fierce resistance on Betio forced its commitment early. The 1st and 3rd Battalions landed on Green Beach and pushed across the island, while the 2nd Battalion blocked the enemy on nearby Bairiki Island. The regiment suffered 355 casualties and received a Presidential Unit Citation for Tarawa. In 1944, the 6th Marines fought at Saipan and Tinian. Saipan was its costliest WWII battle, with 356 killed and 1,208 wounded. After Tinian, the regiment prepared for Okinawa and later the planned invasion of Japan, but the war ended before that landing happened."},"operationCost":2,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand","ERegisteredCardFunction::OnEndOfTurn"],"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/6th_MARINE_REGIMENT.6th_MARINE_REGIMENT","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_6th_marine_regiment_photo","SourceString":"US Marines advancing on a Japanese pillbox on Tarawa Island, 1943.","LocalizedString":"US Marines advancing on a Japanese pillbox on Tarawa Island, 1943."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"rainFound","type":"bool","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_6th_marine_regiment","owner":"card_unit_6th_marine_regiment_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_bool_True