{"format":"kards-original-reference","version":1,"id":"5ac1b8a6e922f714","name":"card_unit_breda_ba_65","package":"/Game/Blueprints/Cards/Italy/units/card_unit_breda_ba_65","parent":"UBaseCardObject","card":{"title":"BREDA Ba.65","text":"Deployment: Deal 1 damage to each enemy.","flavorText":"The Breda Ba.65 was an Italian multirole combat aircraft developed in the 1930s and used during the Spanish Civil War by the Aviazione Legionaria, as well as in the early stages of World War II. The aircraft was a single-engine, all-metal monoplane designed for ground-attack, reconnaissance, and light bombing missions. It was powered by a Fiat A.80 radial engine, had a top speed of 430 km/h (267 mph), was armed with four machine guns and embarked up to 1,000 kg (2,200 lbs) of bombs. Its robust design featured a retractable landing gear and an enclosed cockpit, but its heavy armament often strained its performance. The Ba.65 first saw action in the Spanish Civil War, where it performed effectively in ground-attack roles but proved to be vulnerable to enemy fighters. When WWII broke out, the aircraft was already outdated and struggled against more advanced Allied planes and anti-aircraft defenses. It saw limited use in North Africa before being phased out due to its slow speed, mechanical issues and poor combat effectiveness. A total of 218 Ba.65s were manufactured between 1935 and 1939, with the majority serving in the Regia Aeronautica. However, 55 were exported and used by the air forces of Iraq, Chile and Portugal.","faction":"Italy","type":"bomber","rarity":"Uncommon","cost":4,"operationCost":2,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_breda_ba_65","title":{"Namespace":"card_italy","Key":"card_unit_breda_ba_65_title","SourceString":"BREDA Ba.65","LocalizedString":"BREDA Ba.65"},"Type":"ETypeEnum::bomber","attack":3,"defense":3,"range":2,"faction":"EFactionEnum::Italy","kredits":4,"Text":{"Namespace":"card_italy","Key":"card_unit_breda_ba_65_text","SourceString":"Deployment: Deal 1 damage to each enemy.","LocalizedString":"Deployment: Deal 1 damage to each enemy."},"flavorText":{"Namespace":"card_italy","Key":"card_unit_breda_ba_65_history","SourceString":"The Breda Ba.65 was an Italian multirole combat aircraft developed in the 1930s and used during the Spanish Civil War by the Aviazione Legionaria, as well as in the early stages of World War II. The aircraft was a single-engine, all-metal monoplane designed for ground-attack, reconnaissance, and light bombing missions. It was powered by a Fiat A.80 radial engine, had a top speed of 430 km/h (267 mph), was armed with four machine guns and embarked up to 1,000 kg (2,200 lbs) of bombs. Its robust design featured a retractable landing gear and an enclosed cockpit, but its heavy armament often strained its performance. The Ba.65 first saw action in the Spanish Civil War, where it performed effectively in ground-attack roles but proved to be vulnerable to enemy fighters. When WWII broke out, the aircraft was already outdated and struggled against more advanced Allied planes and anti-aircraft defenses. It saw limited use in North Africa before being phased out due to its slow speed, mechanical issues and poor combat effectiveness. A total of 218 Ba.65s were manufactured between 1935 and 1939, with the majority serving in the Regia Aeronautica. However, 55 were exported and used by the air forces of Iraq, Chile and Portugal.","LocalizedString":"The Breda Ba.65 was an Italian multirole combat aircraft developed in the 1930s and used during the Spanish Civil War by the Aviazione Legionaria, as well as in the early stages of World War II. The aircraft was a single-engine, all-metal monoplane designed for ground-attack, reconnaissance, and light bombing missions. It was powered by a Fiat A.80 radial engine, had a top speed of 430 km/h (267 mph), was armed with four machine guns and embarked up to 1,000 kg (2,200 lbs) of bombs. Its robust design featured a retractable landing gear and an enclosed cockpit, but its heavy armament often strained its performance. The Ba.65 first saw action in the Spanish Civil War, where it performed effectively in ground-attack roles but proved to be vulnerable to enemy fighters. When WWII broke out, the aircraft was already outdated and struggled against more advanced Allied planes and anti-aircraft defenses. It saw limited use in North Africa before being phased out due to its slow speed, mechanical issues and poor combat effectiveness. A total of 218 Ba.65s were manufactured between 1935 and 1939, with the majority serving in the Regia Aeronautica. However, 55 were exported and used by the air forces of Iraq, Chile and Portugal."},"operationCost":2,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::BloodAndIron","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment"],"hasDeployment":true,"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Italy/Mini_Ally_Expansion_25/t_breda_ba_65.t_breda_ba_65","SubPathString":""},"ImageAnchor":"EImageAnchor::Bot","artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/BREDA_Ba_65.BREDA_Ba_65","SubPathString":""},"historyPhotoSize":{"X":1000.0,"Y":584.0},"historyPhotoDescription":{"Namespace":"card_italy","Key":"card_unit_breda_ba_65_photo","SourceString":"Regia Aeronautica Breda Ba.65 in flight. Date unknown.","LocalizedString":"Regia Aeronautica Breda Ba.65 in flight. Date unknown."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"Ass