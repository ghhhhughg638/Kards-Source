{"format":"kards-original-reference","version":1,"id":"38137227ea7ecb54","name":"card_unit_yak_7","package":"/Game/Blueprints/Cards/Soviet/Breakthrough/units/card_unit_yak_7","parent":"UBaseCardObject","card":{"title":"YAK 7","text":"At the start of your turn, draw a card and deal 1 damage to your HQ.","flavorText":"The Yakovlev Yak-7 was a Soviet fighter that was originally designed to be a two-seat trainer version of the Yak-1 fighter, but was modified to a single-seat fighter that proved to be superior to the Yak-1. The Yak 7 was first used in front line service in 1942 where it was mostly used as a fighter-bomber, but also as an interceptor and fighter. The Yak-7 was a very capable aircraft and 6,399 aircraft were produced throughout the war, including variants. In 1944 the aircraft was retired from combat service and resumed its role as a trainer.","faction":"Soviet","type":"fighter","rarity":"Unique","cost":2,"operationCost":1,"attack":2,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_yak_7","title":{"Namespace":"card_soviet","Key":"card_unit_yak_7_title","SourceString":"YAK 7","LocalizedString":"YAK 7"},"Type":"ETypeEnum::fighter","attack":2,"defense":2,"range":2,"faction":"EFactionEnum::Soviet","kredits":2,"Text":{"Namespace":"card_soviet","Key":"card_unit_yak_7_text","SourceString":"At the start of your turn, draw a card and deal 1 damage to your HQ.","LocalizedString":"At the start of your turn, draw a card and deal 1 damage to your HQ."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_yak_7_history","SourceString":"The Yakovlev Yak-7 was a Soviet fighter that was originally designed to be a two-seat trainer version of the Yak-1 fighter, but was modified to a single-seat fighter that proved to be superior to the Yak-1. The Yak 7 was first used in front line service in 1942 where it was mostly used as a fighter-bomber, but also as an interceptor and fighter. The Yak-7 was a very capable aircraft and 6,399 aircraft were produced throughout the war, including variants. In 1944 the aircraft was retired from combat service and resumed its role as a trainer.","LocalizedString":"The Yakovlev Yak-7 was a Soviet fighter that was originally designed to be a two-seat trainer version of the Yak-1 fighter, but was modified to a single-seat fighter that proved to be superior to the Yak-1. The Yak 7 was first used in front line service in 1942 where it was mostly used as a fighter-bomber, but also as an interceptor and fighter. The Yak-7 was a very capable aircraft and 6,399 aircraft were produced throughout the war, including variants. In 1944 the aircraft was retired from combat service and resumed its role as a trainer."},"operationCost":1,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::Breakthrough","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Trigger"],"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/t_jak_7.t_jak_7","SubPathString":""},"artist":"Marii Chernev","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/YAK_7.YAK_7","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":316.0},"historyPhotoAuthor":"Shagin, Ivan Mihayloviç","historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_yak_7_photo","SourceString":"Yak-7s built by the Komsomol members of Novosibirsk, 1942.","LocalizedString":"Yak-7s built by the Komsomol members of Novosibirsk, 1942."},"historyTypeDescription":{"Namespace":"card_soviet","Key":"card_unit_yak_7_header","SourceString":"Fighter Aircraft","LocalizedString":"Fighter Aircraft"},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"