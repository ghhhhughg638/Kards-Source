{"format":"kards-original-reference","version":1,"id":"545993d4b44f2baf","name":"card_event_entrapment","package":"/Game/Blueprints/Cards/Germany/Breakthrough/events/card_event_entrapment","parent":"UBaseCardObject","card":{"title":"ENTRAPMENT","text":"When a unit attacks, destroy it. Your units get +1+1.","flavorText":"During the opening stages of WWII the German Blitzkrieg operations focused on breaking through the enemies line of defence by using short, fast and powerful attacks by motorized force. The aim was to knock holes in the enemy defensive lines, to set up objectives in the rear and encircle the enemy. During the early phases of the war this proved to be a successful tactic and resulted in the entrapment of large pockets of Allied troops and equipment which could easily be finished off. These tactics proved successful in the Invasion of Poland, the invasion of the low countries and France. At the start of Operation Barbarossa Blitzkrieg tactics resulted in huge encirclements that ended in heavy losses for the Red Army, with nearly 3.5 million prisoners of war being taken along with masses of equipment.","faction":"Germany","type":"gotcha","rarity":"Common","cost":5,"operationCost":0,"attack":0,"defense":0},"defaults":{"Name":"card_event_entrapment","title":{"Namespace":"card_germany","Key":"card_event_entrapment_title","SourceString":"ENTRAPMENT","LocalizedString":"ENTRAPMENT"},"Type":"ETypeEnum::gotcha","faction":"EFactionEnum::Germany","kredits":5,"Text":{"Namespace":"card_germany","Key":"card_event_entrapment_text","SourceString":"When a unit attacks, destroy it. Your units get +1+1.","LocalizedString":"When a unit attacks, destroy it. Your units get +1+1."},"flavorText":{"Namespace":"card_germany","Key":"card_event_entrapment_history","SourceString":"During the opening stages of WWII the German Blitzkrieg operations focused on breaking through the enemies line of defence by using short, fast and powerful attacks by motorized force. The aim was to knock holes in the enemy defensive lines, to set up objectives in the rear and encircle the enemy. During the early phases of the war this proved to be a successful tactic and resulted in the entrapment of large pockets of Allied troops and equipment which could easily be finished off. These tactics proved successful in the Invasion of Poland, the invasion of the low countries and France. At the start of Operation Barbarossa Blitzkrieg tactics resulted in huge encirclements that ended in heavy losses for the Red Army, with nearly 3.5 million prisoners of war being taken along with masses of equipment.","LocalizedString":"During the opening stages of WWII the German Blitzkrieg operations focused on breaking through the enemies line of defence by using short, fast and powerful attacks by motorized force. The aim was to knock holes in the enemy defensive lines, to set up objectives in the rear and encircle the enemy. During the early phases of the war this proved to be a successful tactic and resulted in the entrapment of large pockets of Allied troops and equipment which could easily be finished off. These tactics proved successful in the Invasion of Poland, the invasion of the low countries and France. At the start of Operation Barbarossa Blitzkrieg tactics resulted in huge encirclements that ended in heavy losses for the Red Army, with nearly 3.5 million prisoners of war being taken along with masses of equipment."},"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Breakthrough","returnSet":"ECardSetEnum::NavalWarfare","usedTriggers":["ERegisteredCardFunction::OnOtherCardAttacks"],"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Class_Specific_Engineer_Socket_Crank_Sequence_2'","ObjectPath":"kards/Content/War_UI/Waves/Class_Specific/War_UI_Class_Specific_Engineer_Socket_Crank_Sequence_2.0"},"soundAttack":{"ObjectName":"SoundWave'Anihilation_17'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Anihilation_17.0"},"Image":{"AssetPathName":"/Game/Assets/Text