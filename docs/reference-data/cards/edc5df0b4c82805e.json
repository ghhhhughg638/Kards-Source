{"format":"kards-original-reference","version":1,"id":"edc5df0b4c82805e","name":"card_unit_su_152","package":"/Game/Blueprints/Cards/Soviet/Base/units/card_unit_su_152","parent":"UBaseCardObject","card":{"title":"SU 152","text":"Deployment: Your other tanks get +1 attack and +1 Heavy Armor.","flavorText":"The SU-152 (Samokhodnaya Ustanovka-152) was a Soviet self-propelled heavy howitzer used in WWII. It mounted a 152 mm gun-howitzer on the chassis of a KV-1S heavy tank and an optional 1× 12.7 mm DShK machine gun as secondary armament. The SU-152 was cheap to produce and proved to be an effective heavy tank killer although it was not initially designed for that purpose. In combat it was used either for long range artillery fire support or as a heavy tank destroyer, usually in ambush.","faction":"Soviet","type":"tank","rarity":"Uncommon","cost":4,"operationCost":1,"attack":4,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_su_152","title":{"Namespace":"card_soviet","Key":"card_unit_su_152_title","SourceString":"SU 152","LocalizedString":"SU 152"},"Type":"ETypeEnum::tank","attack":4,"defense":4,"range":1,"faction":"EFactionEnum::Soviet","kredits":4,"Text":{"Namespace":"card_soviet","Key":"card_unit_su_152_text","SourceString":"Deployment: Your other tanks get +1 attack and +1 Heavy Armor.","LocalizedString":"Deployment: Your other tanks get +1 attack and +1 Heavy Armor."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_su_152_history","SourceString":"The SU-152 (Samokhodnaya Ustanovka-152) was a Soviet self-propelled heavy howitzer used in WWII. It mounted a 152 mm gun-howitzer on the chassis of a KV-1S heavy tank and an optional 1× 12.7 mm DShK machine gun as secondary armament. The SU-152 was cheap to produce and proved to be an effective heavy tank killer although it was not initially designed for that purpose. In combat it was used either for long range artillery fire support or as a heavy tank destroyer, usually in ambush.","LocalizedString":"The SU-152 (Samokhodnaya Ustanovka-152) was a Soviet self-propelled heavy howitzer used in WWII. It mounted a 152 mm gun-howitzer on the chassis of a KV-1S heavy tank and an optional 1× 12.7 mm DShK machine gun as secondary armament. The SU-152 was cheap to produce and proved to be an effective heavy tank killer although it was not initially designed for that purpose. In combat it was used either for long range artillery fire support or as a heavy tank destroyer, usually in ambush."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Basic","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment","EHelpBubbleTypes::HeavyArmor1"],"hasDeployment":true,"heavyArmor":1,"soundEnterPlay":{"ObjectName":"SoundWave'Tank_Heavy_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Heavy_Move_Fx.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Tank_Heavy_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Heavy_Move_Fx.0"},"soundAttack":{"ObjectName":"SoundWave'Heavy_artillery_2'","ObjectPath":"kards/Content/ExplosionSoundPack/ExplosionSounds/Wavs/Heavy_artillery_2.0"},"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Armor_Large_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Armor_Large_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/t_su_destroyer.t_su_destroyer","SubPathString":""},"artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/Historical_Photos/SU_152.SU_152","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":323.0},"historyPhotoSource":"http://wio.ru","historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_su_152_photo","SourceString":"Soviet SU 152, date unknown.","LocalizedString":"Soviet SU 152, date unknown."},"historyTypeDescription":{"Namespace":"card_soviet","Key":"card_unit_su_152_header","SourceString":"Self-Propelled Heavy Howitzer","LocalizedString":"Self-Propelled Heavy Howitzer"},"blowUp