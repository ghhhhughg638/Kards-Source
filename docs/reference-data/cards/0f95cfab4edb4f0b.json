{"format":"kards-original-reference","version":1,"id":"0f95cfab4edb4f0b","name":"card_unit_93rd_guards","package":"/Game/Blueprints/Cards/Soviet/Base/units/card_unit_93rd_guards","parent":"UBaseCardObject","card":{"title":"1st RIFLES","text":"Destruction: Add a 2nd RIFLES to your support line.","flavorText":"The 1st Rifles Regiment was attached to the 99th Rifle Division of the Red Army. In 1939 it took part in the Soviet invasion of Poland as part of 13th Rifle Corps of the 12th Army. In 1941, during Operation Barbarossa, most of the division was killed or captured in the Battle of Uman, and again in the Second Battle of Kharkov. The division was reorganized in 1942 and sent to fight in Stalingrad and from there it was transferred to the Don Front. In April 1943 the division was raised to Guards status and became the 88th Guards Rifle Division. During the final stages of the war the division fought with the 46th Army of the 2nd Ukrainian Front and by the end of the war it was disbanded.","faction":"Soviet","type":"infantry","rarity":"Unique","cost":4,"operationCost":1,"attack":3,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_93rd_guards","title":{"Namespace":"card_soviet","Key":"card_unit_93rd_guards_title","SourceString":"1st RIFLES","LocalizedString":"1st RIFLES"},"Type":"ETypeEnum::infantry","attack":3,"defense":5,"range":1,"faction":"EFactionEnum::Soviet","kredits":4,"Text":{"Namespace":"card_soviet","Key":"card_unit_93rd_guards_text","SourceString":"Destruction: Add a 2nd RIFLES to your support line.","LocalizedString":"Destruction: Add a 2nd RIFLES to your support line."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_93rd_guards_history","SourceString":"The 1st Rifles Regiment was attached to the 99th Rifle Division of the Red Army. In 1939 it took part in the Soviet invasion of Poland as part of 13th Rifle Corps of the 12th Army. In 1941, during Operation Barbarossa, most of the division was killed or captured in the Battle of Uman, and again in the Second Battle of Kharkov. The division was reorganized in 1942 and sent to fight in Stalingrad and from there it was transferred to the Don Front. In April 1943 the division was raised to Guards status and became the 88th Guards Rifle Division. During the final stages of the war the division fought with the 46th Army of the 2nd Ukrainian Front and by the end of the war it was disbanded.","LocalizedString":"The 1st Rifles Regiment was attached to the 99th Rifle Division of the Red Army. In 1939 it took part in the Soviet invasion of Poland as part of 13th Rifle Corps of the 12th Army. In 1941, during Operation Barbarossa, most of the division was killed or captured in the Battle of Uman, and again in the Second Battle of Kharkov. The division was reorganized in 1942 and sent to fight in Stalingrad and from there it was transferred to the Don Front. In April 1943 the division was raised to Guards status and became the 88th Guards Rifle Division. During the final stages of the war the division fought with the 46th Army of the 2nd Ukrainian Front and by the end of the war it was disbanded."},"operationCost":1,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::Basic","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Guard","EHelpBubbleTypes::Destruction"],"hasDestruction":true,"hasGuard":true,"spawnCardName":"card_unit_2nd_motor","soundBlowUp":{"ObjectName":"SoundWave'Explosion_Small'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Small.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/t_93rd_guards.t_93rd_guards","SubPathString":""},"artist":"Soviet WWII poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/93rd_GUARDS.93rd_GUARDS","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":380.0},"historyPhotoSource":"https://ww2db.com","historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_93rd_guards_photo","SourceString":"Soviet soldiers waiting for a German attack, S