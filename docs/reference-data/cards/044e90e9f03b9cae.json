{"format":"kards-original-reference","version":1,"id":"044e90e9f03b9cae","name":"card_event_kettenkrad_home","package":"/Game/Blueprints/Cards/Germany/Homefront/events/card_event_kettenkrad_home","parent":"UBaseCardObject","card":{"title":"KETTENKRAD","text":"Send a friendly unit to hand. Your German units everywhere get +1 attack.","flavorText":"The Kettenkrad, officially designated Sd.Kfz. 2, was a unique German half-track motorcycle developed before WWII. Built by NSU Motorenwerke, it combined motorcycle agility with the off-road capabilities of tracked vehicles. Weighing just over 1.5 tons, it was light enough to be transported inside a Junkers Ju 52 aircraft, making it suitable for airborne operations. First deployed during the 1941 invasion of the Soviet Union, the Kettenkrad served as a gun tractor, cable layer, and general utility vehicle. It could carry two passengers behind the driver and reach speeds up to 70 km/h. Steering involved both a front wheel and track braking, and the wheel could be removed entirely for better performance on rough terrain. Its compact size and versatility made it ideal for reconnaissance, airfield maintenance, and even towing aircraft in muddy conditions. Production continued until 1948, with around 8,000 units built. Though not a frontline combat vehicle, the Kettenkrad’s adaptability ensured it remained in use across various theaters throughout the war.","faction":"Germany","type":"order","rarity":"Uncommon","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_kettenkrad_home","title":{"Namespace":"card_germany","Key":"card_event_kettenkrad_home_title","SourceString":"KETTENKRAD","LocalizedString":"KETTENKRAD"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Germany","kredits":2,"Text":{"Namespace":"card_germany","Key":"card_event_kettenkrad_home_text","SourceString":"Send a friendly unit to hand. Your German units everywhere get +1 attack.","LocalizedString":"Send a friendly unit to hand. Your German units everywhere get +1 attack."},"flavorText":{"Namespace":"card_germany","Key":"card_event_kettenkrad_home_history","SourceString":"The Kettenkrad, officially designated Sd.Kfz. 2, was a unique German half-track motorcycle developed before WWII. Built by NSU Motorenwerke, it combined motorcycle agility with the off-road capabilities of tracked vehicles. Weighing just over 1.5 tons, it was light enough to be transported inside a Junkers Ju 52 aircraft, making it suitable for airborne operations. First deployed during the 1941 invasion of the Soviet Union, the Kettenkrad served as a gun tractor, cable layer, and general utility vehicle. It could carry two passengers behind the driver and reach speeds up to 70 km/h. Steering involved both a front wheel and track braking, and the wheel could be removed entirely for better performance on rough terrain. Its compact size and versatility made it ideal for reconnaissance, airfield maintenance, and even towing aircraft in muddy conditions. Production continued until 1948, with around 8,000 units built. Though not a frontline combat vehicle, the Kettenkrad’s adaptability ensured it remained in use across various theaters throughout the war.","LocalizedString":"The Kettenkrad, officially designated Sd.Kfz. 2, was a unique German half-track motorcycle developed before WWII. Built by NSU Motorenwerke, it combined motorcycle agility with the off-road capabilities of tracked vehicles. Weighing just over 1.5 tons, it was light enough to be transported inside a Junkers Ju 52 aircraft, making it suitable for airborne operations. First deployed during the 1941 invasion of the Soviet Union, the Kettenkrad served as a gun tractor, cable layer, and general utility vehicle. It could carry two passengers behind the driver and reach speeds up to 70 km/h. Steering involved both a front wheel and track braking, and the wheel could be removed entirely for better performance on rough terrain. Its compact size and versatility made it ideal for reconnaissance, airfield maintenance, and even towing aircraft in muddy conditions. Production continued until 1948, with around 8,000 units built. Though not a frontline combat vehicle, the Kettenkrad’s adaptability ensured it remained in use across various theaters throughout the war."},"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Homefront","soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/10_Homefront/T_kettenkrad_home.T_kettenkrad_home","SubPathString":""},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/KETTENKRAD.KETTENKRAD","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":351.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_event_kettenkrad_home_photo","SourceString":"German soldiers riding a Kettenkrad on the Eastern Front, 1941.","LocalizedString":"German soldiers riding a Kettenkrad on the Eastern Front, 1941."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""}},"variables":[],"functions":[{"name":"CanPlayFromHand","owner":"card_event_kettenkrad_home_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","direction":"in"},{"name":"CallFunc_GetTargetedCard_card","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_IsSameSideUnit_isIt","typ