{"format":"kards-original-reference","version":1,"id":"ef1890b264c01d39","name":"card_unit_feldhernhalle_rifles","package":"/Game/Blueprints/Cards/Germany/BloodIron/units/card_unit_feldhernhalle_rifles","parent":"UBaseCardObject","card":{"title":"FELDHERRNHALLE RIFLES","text":"Once per turn, gain 2 kredits when you deploy another unit with 4 or more attack.","flavorText":"The Panzergrenadier Division Feldherrnhalle was a semi-armored formation of the German Wehrmacht during WWII. The division was formed in September 1943 in France and soon after it participated in the forced disarmament of the 8th Italian Army following Italy’s armistice with the Allies. In December 1944 the Feldherrnhalle Division was sent to the Eastern Front where it joined the 3rd Panzer Army of the Army Group Centre, and took up defensive positions near the city of Vitebsk. In February 1944 the division participated in the Battle of Narva, but in May that same year it returned to Army Group Centre where it defended against the Soviet Mogilev Offensive, which was part of Operation Bagration, the Soviet Byelorussian strategic offensive operation. The Feldherrnhalle Division was destroyed in July 1944 during the Soviet Minsk Offensive, then reformed in September 1944 in Hungary, where it was renamed as Panzer-Division Feldherrnhalle. The division was destroyed a second time during the Battle of Budapest, but once again it was recreated as Panzer-Division Feldherrnhalle 1. The remnants of the division surrendered to the Soviets in May 1945 in Czechoslovakia.","faction":"Germany","type":"infantry","rarity":"Rare","cost":3,"operationCost":1,"attack":4,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_feldhernhalle_rifles","title":{"Namespace":"card_germany","Key":"card_unit_feldhernhalle_rifles_title","SourceString":"FELDHERRNHALLE RIFLES","LocalizedString":"FELDHERRNHALLE RIFLES"},"Type":"ETypeEnum::infantry","attack":4,"defense":4,"range":1,"faction":"EFactionEnum::Germany","kredits":3,"Text":{"Namespace":"card_germany","Key":"card_unit_feldhernhalle_rifles_text","SourceString":"Once per turn, gain 2 kredits when you deploy another unit with 4 or more attack.","LocalizedString":"Once per turn, gain 2 kredits when you deploy another unit with 4 or more attack."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_feldhernhalle_rifles_history","SourceString":"The Panzergrenadier Division Feldherrnhalle was a semi-armored formation of the German Wehrmacht during WWII. The division was formed in September 1943 in France and soon after it participated in the forced disarmament of the 8th Italian Army following Italy’s armistice with the Allies. In December 1944 the Feldherrnhalle Division was sent to the Eastern Front where it joined the 3rd Panzer Army of the Army Group Centre, and took up defensive positions near the city of Vitebsk. In February 1944 the division participated in the Battle of Narva, but in May that same year it returned to Army Group Centre where it defended against the Soviet Mogilev Offensive, which was part of Operation Bagration, the Soviet Byelorussian strategic offensive operation. The Feldherrnhalle Division was destroyed in July 1944 during the Soviet Minsk Offensive, then reformed in September 1944 in Hungary, where it was renamed as Panzer-Division Feldherrnhalle. The division was destroyed a second time during the Battle of Budapest, but once again it was recreated as Panzer-Division Feldherrnhalle 1. The remnants of the division surrendered to the Soviets in May 1945 in Czechoslovakia.","LocalizedString":"The Panzergrenadier Division Feldherrnhalle was a semi-armored formation of the German Wehrmacht during WWII. The division was formed in September 1943 in France and soon after it participated in the forced disarmament of the 8th Italian Army following Italy’s armistice with the Allies. In December 1944 the Feldherrnhalle Division was sent to the Eastern Front where it joined the 3rd Panzer Army of the Army Group Centre, and took up defensive positions near the city of Vitebsk. In February 1944 the division participated in the Battle of Narva, but in May that same year it returned to Army Group Centre where it defended against the Soviet Mogilev Offensive, which was part of Operation Bagration, the Soviet Byelorussian strategic offensive operation. The Feldherrnhalle Division was destroyed in July 1944 during the Soviet Minsk Offensive, then reformed in September 1944 in Hungary, where it was renamed as Panzer-Division Feldherrnhalle. The division was destroyed a second time during the Battle of Budapest, but once again it was recreated as Panzer-Division Feldherrnhalle 1. The remnants of the division surrendered to the Soviets in May 1945 in Czechoslovakia."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::BloodAndIron","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand","ERegisteredCardFunction::OnEndOfTurn"],"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/Winter_2024/t_feldhernhalle_rifles.t_feldhernhalle_rifles","SubPathString":""},"artist":"German WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/FELDHERRNHALLE_RIFLES.FELDHERRNHALLE_RIFLES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":344.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_feldhernhalle_rifles_photo","SourceString":"Panzergrenadiers of the Panzer-Division Feldherrnhalle 1 in Hungary 1945.","LocalizedString":"Panzergrenadiers of the Panzer-Division Feldherrnhalle 1 in Hungary 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprint