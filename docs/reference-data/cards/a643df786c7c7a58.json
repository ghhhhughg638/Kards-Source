{"format":"kards-original-reference","version":1,"id":"a643df786c7c7a58","name":"card_unit_3_inch_m5","package":"/Game/Blueprints/Cards/USA/BrothersInArms/units/card_unit_3_inch_m5","parent":"UBaseCardObject","card":{"title":"3-inch M5","text":"Has +1 attack for each friendly unit in the frontline.","flavorText":"The 3-inch M5 gun was a US anti-tank artillery piece, derived from the British QF 17-pounder, and used during WWII by the US forces. In terms of effectiveness, the M5 gun demonstrated its capability against medium and select heavy tanks encountered during the war. Its armor-piercing rounds possessed the necessary penetration power to disable or destroy enemy tanks, contributing significantly to the U.S. Army and Marine Corps anti-tank capabilities and it saw service both in the European and Pacific theaters. As the war progressed, the M5 gun eventually gave way to the more powerful 90mm M3 gun, which became the primary anti-tank weapon for the US Army.","faction":"USA","type":"artillery","rarity":"Uncommon","cost":4,"operationCost":1,"attack":1,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_3_inch_m5","title":{"Namespace":"card_usa","Key":"card_unit_3_inch_m5_title","SourceString":"3-inch M5","LocalizedString":"3-inch M5"},"Type":"ETypeEnum::artillery","attack":1,"defense":3,"range":2,"faction":"EFactionEnum::USA","kredits":4,"Text":{"Namespace":"card_usa","Key":"card_unit_3_inch_m5_text","SourceString":"Has +1 attack for each friendly unit in the frontline.","LocalizedString":"Has +1 attack for each friendly unit in the frontline."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_3_inch_m5_history","SourceString":"The 3-inch M5 gun was a US anti-tank artillery piece, derived from the British QF 17-pounder, and used during WWII by the US forces. In terms of effectiveness, the M5 gun demonstrated its capability against medium and select heavy tanks encountered during the war. Its armor-piercing rounds possessed the necessary penetration power to disable or destroy enemy tanks, contributing significantly to the U.S. Army and Marine Corps anti-tank capabilities and it saw service both in the European and Pacific theaters. As the war progressed, the M5 gun eventually gave way to the more powerful 90mm M3 gun, which became the primary anti-tank weapon for the US Army.","LocalizedString":"The 3-inch M5 gun was a US anti-tank artillery piece, derived from the British QF 17-pounder, and used during WWII by the US forces. In terms of effectiveness, the M5 gun demonstrated its capability against medium and select heavy tanks encountered during the war. Its armor-piercing rounds possessed the necessary penetration power to disable or destroy enemy tanks, contributing significantly to the U.S. Army and Marine Corps anti-tank capabilities and it saw service both in the European and Pacific theaters. As the war progressed, the M5 gun eventually gave way to the more powerful 90mm M3 gun, which became the primary anti-tank weapon for the US Army."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::BrothersInArms","isReserved":true,"EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardLocationMoved"],"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/Spring2023Candidates/t_us_at_gun.t_us_at_gun","SubPathString":""},"artist":"Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/3-inch_M5.3-inch_M5","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":392.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_3_inch_m5_photo","SourceString":"US Army artillerymen firing a 3-inch M5 at German Defenses in Saint Malo, France 1944.","LocalizedString":"US Army artillerymen firing a 3-inch M5 at German Defenses in Saint Malo, France 1944."},"blowUpExplosionNiagara":{"Object