{"format":"kards-original-reference","version":1,"id":"95c8b4418cc24873","name":"card_event_cross_of_lorraine","package":"/Game/Blueprints/Cards/France/events/card_event_cross_of_lorraine","parent":"UBaseCardObject","card":{"title":"CROSS OF LORRAINE","text":"Costs 1 less for each card in the enemy hand. Deal 3 damage to an enemy.","flavorText":"The Cross of Lorraine (French: Croix de Lorraine) is a cross with one vertical and two horizontal bars which was used as a symbol for Free France led by Général Charles De Gaulle, the Free French Forces and the French resistance during WWII. The cross is known in French history as the Cross of Anjou and dates back to the 15th century, but the use of the double cross symbol can be traced to the middle ages and can also be found in the coat of arms of Hungary, Slovakia, Belarus and Lithuania. It became, through the course of history, an emblem of Lorraine in Eastern France. After the defeat in the Franco-Prussian war in 1871, Alsace and part of Lorraine were annexed by Germany until 1918. During that period, the Cross served as a rallying point for French ambitions to recover its lost provinces and became a symbol of French patriotism. When the same thing happened in 1940, Capitaine de corvette Thierry d'Argenlieu suggested the Cross of Lorraine as the symbol of the Free French Forces. The Cross was displayed on the flags of Free French warships, on the fuselages of aircrafts and on the tanks. The medal of the Order of Liberation bears the Cross of Lorraine. De Gaulle himself is memorialized by a 43 meter (141 ft) high Cross of Lorraine in his home village of Colombey-les-Deux-Églises.","faction":"France","type":"order","rarity":"Rare","cost":9,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_cross_of_lorraine","title":{"Namespace":"card_france","Key":"card_event_cross_of_lorraine_title","SourceString":"CROSS OF LORRAINE","LocalizedString":"CROSS OF LORRAINE"},"Type":"ETypeEnum::order","faction":"EFactionEnum::France","kredits":9,"Text":{"Namespace":"card_france","Key":"card_event_cross_of_lorraine_text","SourceString":"Costs 1 less for each card in the enemy hand. Deal 3 damage to an enemy.","LocalizedString":"Costs 1 less for each card in the enemy hand. Deal 3 damage to an enemy."},"flavorText":{"Namespace":"card_france","Key":"card_event_cross_of_lorraine_history","SourceString":"The Cross of Lorraine (French: Croix de Lorraine) is a cross with one vertical and two horizontal bars which was used as a symbol for Free France led by Général Charles De Gaulle, the Free French Forces and the French resistance during WWII. The cross is known in French history as the Cross of Anjou and dates back to the 15th century, but the use of the double cross symbol can be traced to the middle ages and can also be found in the coat of arms of Hungary, Slovakia, Belarus and Lithuania. It became, through the course of history, an emblem of Lorraine in Eastern France. After the defeat in the Franco-Prussian war in 1871, Alsace and part of Lorraine were annexed by Germany until 1918. During that period, the Cross served as a rallying point for French ambitions to recover its lost provinces and became a symbol of French patriotism. When the same thing happened in 1940, Capitaine de corvette Thierry d'Argenlieu suggested the Cross of Lorraine as the symbol of the Free French Forces. The Cross was displayed on the flags of Free French warships, on the fuselages of aircrafts and on the tanks. The medal of the Order of Liberation bears the Cross of Lorraine. De Gaulle himself is memorialized by a 43 meter (141 ft) high Cross of Lorraine in his home village of Colombey-les-Deux-Églises.","LocalizedString":"The Cross of Lorraine (French: Croix de Lorraine) is a cross with one vertical and two horizontal bars which was used as a symbol for Free France led by Général Charles De Gaulle, the Free French Forces and the French resistance during WWII. The cross is known in French history as the Cross of Anjou and dates back to the 15th century, but the use of the double cross symbol can be traced to the middle ages and can also be found in the coat of arms of Hungary, Slovakia, Belarus and Lithuania. It became, through the course of history, an emblem of Lorraine in Eastern France. After the defeat in the Franco-Prussian war in 1871, Alsace and part of Lorraine were annexed by Germany until 1918. During that period, the Cross served as a rallying point for French ambitions to recover its lost provinces and became a symbol of French patriotism. When the same thing happened in 1940, Capitaine de corvette Thierry d'Argenlieu suggested the Cross of Lorraine as the symbol of the Free French Forces. The Cross was displayed on the flags of Free French warships, on the fuselages of aircrafts and on the tanks. The medal of the Order of Liberation bears the Cross of Lorraine. De Gaulle himself is memorialized by a 43 meter (141 ft) high Cross of Lorraine in his home village of Colombey-les-Deux-Églises."},"rarity":"ERarityEnum::Rare","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Legions","returnSet":"ECardSetEnum::OceaniaStorm","usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand","ERegisteredCardFunction::OnOtherCardDiscarded","ERegisteredCardFunction::ERegisteredCardFunction_MAX","ERegisteredCardFunction::OnStartofTurn","ERegisteredCardFunction::OnOtherCardSpawnedInHand","ERegisteredCardFunction::OnOtherCardDrawnFromDeck","ERegisteredCardFunction::OnOtherCardReset","ERegisteredCardFunction::OnOtherCovertCardPlayedFromHand"],"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_5'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_5.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/France/t_liberte.t_liberte","SubPathString":""},"artist":"French WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/CROSS_OF_LORRAINE.CROSS_OF_LORRAINE","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":694.0},"historyPhotoDescription":{"Namespace":"card_france","Key":"card_event_cross_of_lorraine_photo","SourceString":"Volunteers of the Free French Forces boarding a destroyer of Free Poles, Normandy, 1944. Note the flag with the Cross of Lorraine in the background.","LocalizedString":"Volunteers of the Free French Forces boarding a destroyer of Free Poles, Normandy, 1944. Note the flag with the Cross of Lorraine in the background."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"isDirectDamage":true},"variables":[{"name":"count","type":"int32","direction":"in"},{"name":"Temp Amount","type":"int32","direction":"in"}],"functions":[{"name":"CanPlayFromHand","owner":"card_event_cross_of_lorraine_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_GetOppositeSide_oppositeSide","type":"ESideEnum","direction":"in"},{"name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","direction":"in"},{"name":"CallFunc_GetTargetedCard_card","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_EqualEqual_ByteByte_ReturnValue","type":"bool","direction":"in"}],"body":[{"op":"Context","at":0,"object":{"op":"Variable","name":"cardFunction","type":"ACardFunctionsStub*","scope":"member","sourceOp":"InstanceVariable"},"value":{"op":"LocalVirtualFunction","name":"GetTargetedCard","signature":"CardFunctionsStub.GetTargetedCard","args":[{"op":"Self"},{"op":"Variable","name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","scope":"local","so