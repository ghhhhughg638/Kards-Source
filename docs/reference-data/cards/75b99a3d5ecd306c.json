{"format":"kards-original-reference","version":1,"id":"75b99a3d5ecd306c","name":"card_unit_stuka_brothers","package":"/Game/Blueprints/Cards/Germany/BrothersInArms/units/card_unit_stuka_brothers","parent":"UBaseCardObject","card":{"title":"STUKA 87G","text":"Becomes Veteran after an enemy ground unit is destroyed.","flavorText":"The Ju 87G was a variant of the Junkers Ju 87 Stuka dive bomber that came into service in 1943 and was used by the German Luftwaffe throughout WWII. The G variant was primarily designed as an anti-tank aircraft and it featured two Bordkanone BK 3,7 cannons mounted under the wings in gun pods. These cannons fired high-explosive armor-piercing rounds that were primarily effective against lightly armored or unarmored targets. The gun's effectiveness was limited against heavily armored tanks, but to compensate for this the pilots often attacked tanks from above or from the rear, where the armor was usually thinner. The gun pods were removable and could be replaced with ordinary bomb racks that could carry a 1,000 kg (2,200 lb) bomb load, which meant that the G variant could be used in other ground attack roles. In addition the G variant came with an enhanced armor protection that safeguarded the crew against ground fire. This was copied from the Soviet made Ilyushin Il-2 Sturmovik.","faction":"Germany","type":"bomber","rarity":"Unique","cost":4,"operationCost":2,"attack":3,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_stuka_brothers","title":{"Namespace":"card_germany","Key":"card_unit_stuka_brothers_title","SourceString":"STUKA 87G","LocalizedString":"STUKA 87G"},"Type":"ETypeEnum::bomber","attack":3,"defense":2,"range":2,"faction":"EFactionEnum::Germany","kredits":4,"Text":{"Namespace":"card_germany","Key":"card_unit_stuka_brothers_text","SourceString":"Becomes Veteran after an enemy ground unit is destroyed.","LocalizedString":"Becomes Veteran after an enemy ground unit is destroyed."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_stuka_brothers_history","SourceString":"The Ju 87G was a variant of the Junkers Ju 87 Stuka dive bomber that came into service in 1943 and was used by the German Luftwaffe throughout WWII. The G variant was primarily designed as an anti-tank aircraft and it featured two Bordkanone BK 3,7 cannons mounted under the wings in gun pods. These cannons fired high-explosive armor-piercing rounds that were primarily effective against lightly armored or unarmored targets. The gun's effectiveness was limited against heavily armored tanks, but to compensate for this the pilots often attacked tanks from above or from the rear, where the armor was usually thinner. The gun pods were removable and could be replaced with ordinary bomb racks that could carry a 1,000 kg (2,200 lb) bomb load, which meant that the G variant could be used in other ground attack roles. In addition the G variant came with an enhanced armor protection that safeguarded the crew against ground fire. This was copied from the Soviet made Ilyushin Il-2 Sturmovik.","LocalizedString":"The Ju 87G was a variant of the Junkers Ju 87 Stuka dive bomber that came into service in 1943 and was used by the German Luftwaffe throughout WWII. The G variant was primarily designed as an anti-tank aircraft and it featured two Bordkanone BK 3,7 cannons mounted under the wings in gun pods. These cannons fired high-explosive armor-piercing rounds that were primarily effective against lightly armored or unarmored targets. The gun's effectiveness was limited against heavily armored tanks, but to compensate for this the pilots often attacked tanks from above or from the rear, where the armor was usually thinner. The gun pods were removable and could be replaced with ordinary bomb racks that could carry a 1,000 kg (2,200 lb) bomb load, which meant that the G variant could be used in other ground attack roles. In addition the G variant came with an enhanced armor protection that safeguarded the crew against ground fire. This was copied from the Soviet made Ilyushin Il-2 Sturmovik."},"operationCost":2,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::BrothersInArms","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardDestroyed","ERegisteredCardFunction::OnBeforeOtherCardDestroyed"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Blitz","EHelpBubbleTypes::Veteran"],"hasBlitz":true,"spawnCardName":"card_unit_stuka_brothers_vet","soundAttack":{"ObjectName":"SoundCue'au_stuka_attack_psby_Cue'","ObjectPath":"kards/Content/Assets/Audio/Bomber/Stuka/au_stuka_attack_psby_Cue.0"},"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/Spring2023Candidates/t_stuka_cannons.t_stuka_cannons","SubPathString":""},"artist":"Nicolas Trudgian","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/STUKA_87G.STUKA_87G","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":374.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_stuka_brothers_photo","SourceString":"Stuka 87G in flight. Date unknown.","LocalizedString":"Stuka 87G in flight. Date unknown."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackBomber.BP_AttackBomber_C","SubPathString":""},"threat_level":0.4},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_stuka_brothers","owner":"card_unit_stuka_brothers_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals"