{"format":"kards-original-reference","version":1,"id":"4f12fb9f583675e7","name":"card_unit_266th_guards_rifles","package":"/Game/Blueprints/Cards/Soviet/BrothersInArms/units/card_unit_266th_guards_rifles","parent":"UBaseCardObject","card":{"title":"266th GUARD RIFLES","text":"Becomes Veteran if the enemy has no Veteran units at the start of your turn.","flavorText":"The 266th Guard Rifle Regiment was part of the 88th Guards Rifle Division during WWII. The 88th Division was reformed in April 1943 from the 1st formation of the 99th Rifle Division and became one of the most decorated rifle divisions in the Red Army. It played a significant role in the liberation of Zaporozhye and fought alongside the 3rd Ukrainian Front in battles near the Dnieper River. The division earned the Order of Suvorov for its actions along the Inhulets River and participated in the liberation of Odessa. It also broke the German defense west of Kovel during Operation Bagration and secured a bridgehead over the Vistula at Magnuszew. In the Vistula-Oder Offensive, the division's regiments were recognized for their successes in the advance into Poland. The division then contributed to the expansion of a bridgehead over the Oder River near Küstrin and took part in the final offensive on Berlin. It ended the war near the Zoological Garden and later served in occupation duty in the Soviet sector of Germany until disbanding in early 1947.","faction":"Soviet","type":"infantry","rarity":"Uncommon","cost":6,"operationCost":2,"attack":5,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_266th_guards_rifles","title":{"Namespace":"card_soviet","Key":"card_unit_266th_guards_rifles_title","SourceString":"266th GUARD RIFLES","LocalizedString":"266th GUARD RIFLES"},"Type":"ETypeEnum::infantry","attack":5,"defense":6,"range":1,"faction":"EFactionEnum::Soviet","kredits":6,"Text":{"Namespace":"card_soviet","Key":"card_unit_266th_guards_rifles_text","SourceString":"Becomes Veteran if the enemy has no Veteran units at the start of your turn.","LocalizedString":"Becomes Veteran if the enemy has no Veteran units at the start of your turn."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_266th_guards_rifles_history","SourceString":"The 266th Guard Rifle Regiment was part of the 88th Guards Rifle Division during WWII. The 88th Division was reformed in April 1943 from the 1st formation of the 99th Rifle Division and became one of the most decorated rifle divisions in the Red Army. It played a significant role in the liberation of Zaporozhye and fought alongside the 3rd Ukrainian Front in battles near the Dnieper River. The division earned the Order of Suvorov for its actions along the Inhulets River and participated in the liberation of Odessa. It also broke the German defense west of Kovel during Operation Bagration and secured a bridgehead over the Vistula at Magnuszew. In the Vistula-Oder Offensive, the division's regiments were recognized for their successes in the advance into Poland. The division then contributed to the expansion of a bridgehead over the Oder River near Küstrin and took part in the final offensive on Berlin. It ended the war near the Zoological Garden and later served in occupation duty in the Soviet sector of Germany until disbanding in early 1947.","LocalizedString":"The 266th Guard Rifle Regiment was part of the 88th Guards Rifle Division during WWII. The 88th Division was reformed in April 1943 from the 1st formation of the 99th Rifle Division and became one of the most decorated rifle divisions in the Red Army. It played a significant role in the liberation of Zaporozhye and fought alongside the 3rd Ukrainian Front in battles near the Dnieper River. The division earned the Order of Suvorov for its actions along the Inhulets River and participated in the liberation of Odessa. It also broke the German defense west of Kovel during Operation Bagration and secured a bridgehead over the Vistula at Magnuszew. In the Vistula-Oder Offensive, the division's regiments were recognized for their successes in the advance into Poland. The division then contributed to the expansion of a bridgehead over the Oder River near Küstrin and took part in the final offensive on Berlin. It ended the war near the Zoological Garden and later served in occupation duty in the Soviet sector of Germany until disbanding in early 1947."},"operationCost":2,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::BrothersInArms","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnStartofTurn","ERegisteredCardFunction::OnEndOfTurn","ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Veteran"],"spawnCardName":"card_unit_266th_guards_rifles_vet","soundBlowUp":{"ObjectName":"SoundWave'explosion_large_01'","ObjectPath":"kards/Content/ExplosionSoundPack/ExplosionSounds/Wavs/explosion_large_01.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/Spring2023Candidates/t_soviet_soldiers_forest.t_soviet_soldiers_forest","SubPathString":""},"artist":"Look and Learn","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/266th_GUARDS_RIFLES.266th_GUARDS_RIFLES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":344.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_266th_guards_rifles_photo","SourceString":"Soviet troops fighting in the city Krakow, Poland 1944.","LocalizedString":"Soviet troops fighting in the city Krakow, Poland 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[