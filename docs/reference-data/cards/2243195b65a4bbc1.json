{"format":"kards-original-reference","version":1,"id":"2243195b65a4bbc1","name":"card_unit_44th_silesia","package":"/Game/Blueprints/Cards/Soviet/Homefront/units/card_unit_44th_silesia","parent":"UBaseCardObject","card":{"title":"44th SILESIA","text":"Deployment: Draw a card for each friendly unit with two or more combat keywords.","flavorText":"The 44th Silesia was one of the regiments within the Soviet 15th Guards Rifle Division, a formation which earned numerous distinctions through intense combat across the Eastern Front during WWII. Originally formed as the 1st Rifle Division, it was redesignated 15th Guards Rifle Division in early 1942 following its performance during the defense of Moscow. The division fought in the counteroffensive that pushed German forces back from the capital, then participated in the grinding battles around Smolensk and the Dnieper line. In 1944, the 15th Division advanced during Operation Bagration, helping liberate Belarus by breaking through entrenched German positions. That summer, the division moved westward, reaching the outskirts of East Prussia. In January 1945, it joined the Vistula-Oder Offensive, helping to clear the path into Silesia, where regiments like the 44th earned their battle honor titles. The division continued pushing into Germany and ended the war near Prague. Its achievements were recognized with multiple awards, including the Order of Lenin and the Red Banner.","faction":"Soviet","type":"infantry","rarity":"Rare","cost":3,"operationCost":1,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_44th_silesia","title":{"Namespace":"card_soviet","Key":"card_unit_44th_silesia_title","SourceString":"44th SILESIA","LocalizedString":"44th SILESIA"},"Type":"ETypeEnum::infantry","attack":3,"defense":3,"range":1,"faction":"EFactionEnum::Soviet","kredits":3,"Text":{"Namespace":"card_soviet","Key":"card_unit_44th_silesia_text","SourceString":"Deployment: Draw a card for each friendly unit with two or more combat keywords.","LocalizedString":"Deployment: Draw a card for each friendly unit with two or more combat keywords."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_44th_silesia_history","SourceString":"The 44th Silesia was one of the regiments within the Soviet 15th Guards Rifle Division, a formation which earned numerous distinctions through intense combat across the Eastern Front during WWII. Originally formed as the 1st Rifle Division, it was redesignated 15th Guards Rifle Division in early 1942 following its performance during the defense of Moscow. The division fought in the counteroffensive that pushed German forces back from the capital, then participated in the grinding battles around Smolensk and the Dnieper line. In 1944, the 15th Division advanced during Operation Bagration, helping liberate Belarus by breaking through entrenched German positions. That summer, the division moved westward, reaching the outskirts of East Prussia. In January 1945, it joined the Vistula-Oder Offensive, helping to clear the path into Silesia, where regiments like the 44th earned their battle honor titles. The division continued pushing into Germany and ended the war near Prague. Its achievements were recognized with multiple awards, including the Order of Lenin and the Red Banner.","LocalizedString":"The 44th Silesia was one of the regiments within the Soviet 15th Guards Rifle Division, a formation which earned numerous distinctions through intense combat across the Eastern Front during WWII. Originally formed as the 1st Rifle Division, it was redesignated 15th Guards Rifle Division in early 1942 following its performance during the defense of Moscow. The division fought in the counteroffensive that pushed German forces back from the capital, then participated in the grinding battles around Smolensk and the Dnieper line. In 1944, the 15th Division advanced during Operation Bagration, helping liberate Belarus by breaking through entrenched German positions. That summer, the division moved westward, reaching the outskirts of East Prussia. In January 1945, it joined the Vistula-Oder Offensive, helping to clear the path into Silesia, where regiments like the 44th earned their battle honor titles. The division continued pushing into Germany and ended the war near Prague. Its achievements were recognized with multiple awards, including the Order of Lenin and the Red Banner."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Homefront","extraHelpTextBubbleTypes":["EHelpBubbleTypes::CombatKeywords"],"hasDeployment":true,"hasBlitz":true,"hasAmbush":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/44th_SILESIA.44th_SILESIA","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_44th_silesia_photo","SourceString":"Soldier of the 15th Guards Rifle Division holding a German panzerfaust in the village of Niklasdorf, Silesia, 1945.","LocalizedString":"Soldier of the 15th Guards Rifle Division holding a German panzerfaust in the village of Niklasdorf, Silesia, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"keyUnits","type":"int32","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_44th_silesia","owner":"card_unit_44th_silesia_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Variable","type":"int32","direction":"in