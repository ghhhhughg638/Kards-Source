{"format":"kards-original-reference","version":1,"id":"609a37e4631eb894","name":"card_unit_wolfhounds","package":"/Game/Blueprints/Cards/USA/OceaniaStorm/units/card_unit_wolfhounds","parent":"UBaseCardObject","card":{"title":"WOLFHOUNDS","text":"Gets +1+1 when you deploy or add an infantry, then becomes Veteran if it has 6 or more attack.","flavorText":"The 27th Infantry Regiment, known as the Wolfhounds, was part of the 25th Infantry Division during WWII. Its nickname came from its deployment to Siberia during the Russian Civil war, where the regiment’s determined pursuit tactics earned the respect of Bolshevik opponents. In 1941 the Wolfhounds were stationed in Hawaii, and some of them were among the first to fire back during the attack on Pearl Harbor. In the Pacific War, the regiment saw hard fighting on Guadalcanal. It took part in the Battle of Mount Austen, the Galloping Horse, and the Sea Horse, where the 25th Infantry Division fought through rough jungle terrain against strong Japanese defenses. The regiment was later engaged in the New Georgia campaign, advancing on the right flank toward Munda in the Solomon Islands. The Wolfhounds also served in the Philippines campaign, and in the occupation of Japan after the end of the war. There they earned another nickname, the Gentle Wolfhounds, through their support of the Holy Family Home orphanage in Osaka. What began as a Christmas visit in 1949 became a long relationship, with gifts, supplies, and medical help.","faction":"USA","type":"infantry","rarity":"Rare","cost":3,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_wolfhounds","title":{"Namespace":"card_usa","Key":"card_unit_wolfhounds_title","SourceString":"WOLFHOUNDS","LocalizedString":"WOLFHOUNDS"},"Type":"ETypeEnum::infantry","attack":2,"defense":3,"range":1,"faction":"EFactionEnum::USA","kredits":3,"Text":{"Namespace":"card_usa","Key":"card_unit_wolfhounds_text","SourceString":"Gets +1+1 when you deploy or add an infantry, then becomes Veteran if it has 6 or more attack.","LocalizedString":"Gets +1+1 when you deploy or add an infantry, then becomes Veteran if it has 6 or more attack."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_wolfhounds_history","SourceString":"The 27th Infantry Regiment, known as the Wolfhounds, was part of the 25th Infantry Division during WWII. Its nickname came from its deployment to Siberia during the Russian Civil war, where the regiment’s determined pursuit tactics earned the respect of Bolshevik opponents. In 1941 the Wolfhounds were stationed in Hawaii, and some of them were among the first to fire back during the attack on Pearl Harbor. In the Pacific War, the regiment saw hard fighting on Guadalcanal. It took part in the Battle of Mount Austen, the Galloping Horse, and the Sea Horse, where the 25th Infantry Division fought through rough jungle terrain against strong Japanese defenses. The regiment was later engaged in the New Georgia campaign, advancing on the right flank toward Munda in the Solomon Islands. The Wolfhounds also served in the Philippines campaign, and in the occupation of Japan after the end of the war. There they earned another nickname, the Gentle Wolfhounds, through their support of the Holy Family Home orphanage in Osaka. What began as a Christmas visit in 1949 became a long relationship, with gifts, supplies, and medical help.","LocalizedString":"The 27th Infantry Regiment, known as the Wolfhounds, was part of the 25th Infantry Division during WWII. Its nickname came from its deployment to Siberia during the Russian Civil war, where the regiment’s determined pursuit tactics earned the respect of Bolshevik opponents. In 1941 the Wolfhounds were stationed in Hawaii, and some of them were among the first to fire back during the attack on Pearl Harbor. In the Pacific War, the regiment saw hard fighting on Guadalcanal. It took part in the Battle of Mount Austen, the Galloping Horse, and the Sea Horse, where the 25th Infantry Division fought through rough jungle terrain against strong Japanese defenses. The regiment was later engaged in the New Georgia campaign, advancing on the right flank toward Munda in the Solomon Islands. The Wolfhounds also served in the Philippines campaign, and in the occupation of Japan after the end of the war. There they earned another nickname, the Gentle Wolfhounds, through their support of the Holy Family Home orphanage in Osaka. What began as a Christmas visit in 1949 became a long relationship, with gifts, supplies, and medical help."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardEnterPlay","ERegisteredCardFunction::OnBeforeStartOfTurn"],"spawnCardName":"card_unit_wolfhounds_vet","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/WOLFHOUNDS.WOLFHOUNDS","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":377.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_wolfhounds_photo","SourceString":"Men of the 25th Infantry Division closing in on a Japanese position in Luzon, Philippines, 1945.","LocalizedString":"Men of the 25th Infantry Division closing in on a Japanese position in Luzon, Philippines, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"threat_level":0.2},"variables":[{"name":"triggered","type":"bool","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_wolfhounds","owner":"card_unit_wolfhounds_C","params":[{"name":"EntryPoint","type":"int32","direction