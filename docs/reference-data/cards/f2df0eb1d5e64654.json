{"format":"kards-original-reference","version":1,"id":"f2df0eb1d5e64654","name":"card_event_frozen_assets","package":"/Game/Blueprints/Cards/Finland/events/card_event_frozen_assets","parent":"UBaseCardObject","card":{"title":"FROZEN ASSETS","text":"Add a SISSI adjacent to a friendly unit. It has Blitz and Salvage.","flavorText":"The Winter War started on 30 November 1939 and ended on 13 March 1940, three and a half months later, with the Moscow Peace Treaty, which ceded 11% of Finland's territory to the Soviet Union. Early on the Finns managed to repel Soviet attacks successfully, but finally the Soviet forces broke the stalemate and the Finns were forced to sue for peace. Despite the Soviet Union being the victor of the Winter War, the Red Army suffered devastating losses: 168,000 soldiers were killed, 207,538 wounded and frostbitten, while 1,000 aircraft, 2,300 tanks and armored cars and an enormous amount of other war materials were lost. Finland's losses were limited to 25,904 dead or missing and 43,557 wounded.","faction":"Finland","type":"order","rarity":"Common","cost":4,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_frozen_assets","title":{"Namespace":"card_finland","Key":"card_event_frozen_assets_title","SourceString":"FROZEN ASSETS","LocalizedString":"FROZEN ASSETS"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Finland","kredits":4,"Text":{"Namespace":"card_finland","Key":"card_event_frozen_assets_text","SourceString":"Add a SISSI adjacent to a friendly unit. It has Blitz and Salvage.","LocalizedString":"Add a SISSI adjacent to a friendly unit. It has Blitz and Salvage."},"flavorText":{"Namespace":"card_finland","Key":"card_event_frozen_assets_history","SourceString":"The Winter War started on 30 November 1939 and ended on 13 March 1940, three and a half months later, with the Moscow Peace Treaty, which ceded 11% of Finland's territory to the Soviet Union. Early on the Finns managed to repel Soviet attacks successfully, but finally the Soviet forces broke the stalemate and the Finns were forced to sue for peace. Despite the Soviet Union being the victor of the Winter War, the Red Army suffered devastating losses: 168,000 soldiers were killed, 207,538 wounded and frostbitten, while 1,000 aircraft, 2,300 tanks and armored cars and an enormous amount of other war materials were lost. Finland's losses were limited to 25,904 dead or missing and 43,557 wounded.","LocalizedString":"The Winter War started on 30 November 1939 and ended on 13 March 1940, three and a half months later, with the Moscow Peace Treaty, which ceded 11% of Finland's territory to the Soviet Union. Early on the Finns managed to repel Soviet attacks successfully, but finally the Soviet forces broke the stalemate and the Finns were forced to sue for peace. Despite the Soviet Union being the victor of the Winter War, the Red Army suffered devastating losses: 168,000 soldiers were killed, 207,538 wounded and frostbitten, while 1,000 aircraft, 2,300 tanks and armored cars and an enormous amount of other war materials were lost. Finland's losses were limited to 25,904 dead or missing and 43,557 wounded."},"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::WinterWar","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Salvage","EHelpBubbleTypes::Blitz"],"draftBaseWeight":0.7,"spawnCardName":"card_unit_sissi","soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_5'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_5.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Finland/t_frozen_assets.t_frozen_assets","SubPathString":""},"artist":"Finnish WW2 poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/FROZEN_ASSETS.FROZEN_ASSETS","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":322.0},"historyPhotoDescription":{"Namespace":"card_finland","Key":"card_event_f