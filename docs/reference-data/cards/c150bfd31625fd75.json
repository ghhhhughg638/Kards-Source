{"format":"kards-original-reference","version":1,"id":"c150bfd31625fd75","name":"card_unit_the_123s","package":"/Game/Blueprints/Cards/USA/NavalWarfare/units/card_unit_the_123s","parent":"UBaseCardObject","card":{"title":"123s","text":"When you deploy a unit, this unit is Converted into it and gains this ability.","flavorText":"The 123rd Infantry Regiment, part of the Illinois Army National Guard, was reactivated in 1942 and assigned to the 33rd Infantry Division. Its motto, \"1, 2, 3 Go!\", reflects its designation and readiness for action. Initially trained in desert warfare in California, the regiment was later redirected to the Pacific Theater. After additional jungle warfare training in Hawaii, the 123rd landed at Maffin Bay, New Guinea, in September 1944. There, designated as \"Task Force Tornado\", they conducted extensive patrols to secure the Wakde airstrip and the Toem–Sarmi sector. Their operations effectively neutralized Japanese forces in the area, with over 4,000 enemy casualties reported. In February 1945, the regiment participated in the Luzon campaign in the Philippines. They advanced through challenging mountainous terrain, engaging in fierce battles to capture strategic positions, including the city of Baguio. Their efforts contributed significantly to the liberation of the Philippines from Japanese occupation. Following Japan's surrender, the 123rd Infantry Regiment served as part of the occupation forces in Japan until its demobilization in early 1946.","faction":"USA","type":"infantry","rarity":"Uncommon","cost":3,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_the_123s","title":{"Namespace":"card_usa","Key":"card_unit_the_123s_title","SourceString":"123s","LocalizedString":"123s"},"Type":"ETypeEnum::infantry","attack":2,"defense":3,"range":1,"faction":"EFactionEnum::USA","kredits":3,"Text":{"Namespace":"card_usa","Key":"card_unit_the_123s_text","SourceString":"When you deploy a unit, this unit is Converted into it and gains this ability.","LocalizedString":"When you deploy a unit, this unit is Converted into it and gains this ability."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_the_123s_history","SourceString":"The 123rd Infantry Regiment, part of the Illinois Army National Guard, was reactivated in 1942 and assigned to the 33rd Infantry Division. Its motto, \"1, 2, 3 Go!\", reflects its designation and readiness for action. Initially trained in desert warfare in California, the regiment was later redirected to the Pacific Theater. After additional jungle warfare training in Hawaii, the 123rd landed at Maffin Bay, New Guinea, in September 1944. There, designated as \"Task Force Tornado\", they conducted extensive patrols to secure the Wakde airstrip and the Toem–Sarmi sector. Their operations effectively neutralized Japanese forces in the area, with over 4,000 enemy casualties reported. In February 1945, the regiment participated in the Luzon campaign in the Philippines. They advanced through challenging mountainous terrain, engaging in fierce battles to capture strategic positions, including the city of Baguio. Their efforts contributed significantly to the liberation of the Philippines from Japanese occupation. Following Japan's surrender, the 123rd Infantry Regiment served as part of the occupation forces in Japan until its demobilization in early 1946.","LocalizedString":"The 123rd Infantry Regiment, part of the Illinois Army National Guard, was reactivated in 1942 and assigned to the 33rd Infantry Division. Its motto, \"1, 2, 3 Go!\", reflects its designation and readiness for action. Initially trained in desert warfare in California, the regiment was later redirected to the Pacific Theater. After additional jungle warfare training in Hawaii, the 123rd landed at Maffin Bay, New Guinea, in September 1944. There, designated as \"Task Force Tornado\", they conducted extensive patrols to secure the Wakde airstrip and the Toem–Sarmi sector. Their operations effectively neutralized Japanese forces in the area, with over 4,000 enemy casualties reported. In February 1945, the regiment participated in the Luzon campaign in the Philippines. They advanced through challenging mountainous terrain, engaging in fierce battles to capture strategic positions, including the city of Baguio. Their efforts contributed significantly to the liberation of the Philippines from Japanese occupation. Following Japan's surrender, the 123rd Infantry Regiment served as part of the occupation forces in Japan until its demobilization in early 1946."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::NavalWarfare","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand","ERegisteredCardFunction::OnOtherCardReset","ERegisteredCardFunction::OnOtherCardSuppressed"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Convert","EHelpBubbleTypes::Trigger"],"draftBaseWeight":0.9,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/NavalWarfare/t_123s.t_123s","SubPathString":""},"artist":"US WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/THE_123s.THE_123s","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":384.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_the_123s_photo","SourceString":"Soldiers of the 33rd Infantry Division patrolling the streets of Baguio, Luzon, Philippines, 1945.","LocalizedString":"Soldiers of the 33rd Infantry Division patrolling the streets of Baguio, Luzon, Philippines, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_Atta