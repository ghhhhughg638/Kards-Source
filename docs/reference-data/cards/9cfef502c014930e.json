{"format":"kards-original-reference","version":1,"id":"9cfef502c014930e","name":"card_unit_190th_guard_rifles","package":"/Game/Blueprints/Cards/Soviet/BloodIron/units/card_unit_190th_guard_rifles","parent":"UBaseCardObject","card":{"title":"190th GUARD RIFLES","text":"Cannot attack or move. Becomes Veteran when you have destroyed 4 enemy units.","flavorText":"The 190th Guards Rifle Regiment was a unit of the 5th Rifle Division of the Soviet Red Army. The division was formed in 1918 and fought in the Russian Revolution and the Polish-Soviet War (1919-1921). After the launch of Operation Barbarossa in 1941, the division fought in the Baltic Operation and the Leningrad Strategic Defensive. In the winter of 1941-1942, it took part in the Battle of Moscow, fighting near Kalinin (now Tver). In the summer of 1942, the division participated in the Rzhev-Vyazma Offensive and was raised to Guards status for its performance. In February 1943, it fought in offensives around Mtsensk and Kalinin and in July it participated in Operation Kutuzov where it captured the city of Orel, earning the \"Orel\" honorific. It then fought in the Bryansk and Gomel-Rechitsa Offensives, reaching the Dnieper. In early 1944, it took part in the Rogachev-Zhlobin Offensive, receiving the Order of the Red Banner. During Operation Bagration, it was awarded the Order of Suvorov and later the Order of Kutuzov for capturing Vawkavysk. In 1945, it fought in the Berlin Offensive and was awarded the Order of Lenin before disbanding in June 1946.","faction":"Soviet","type":"infantry","rarity":"Uncommon","cost":2,"operationCost":1,"attack":6,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_190th_guard_rifles","title":{"Namespace":"card_soviet","Key":"card_unit_190th_guard_rifles_title","SourceString":"190th GUARD RIFLES","LocalizedString":"190th GUARD RIFLES"},"Type":"ETypeEnum::infantry","attack":6,"defense":6,"range":1,"faction":"EFactionEnum::Soviet","kredits":2,"Text":{"Namespace":"card_soviet","Key":"card_unit_190th_guard_rifles_text","SourceString":"Cannot attack or move. Becomes Veteran when you have destroyed 4 enemy units.","LocalizedString":"Cannot attack or move. Becomes Veteran when you have destroyed 4 enemy units."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_190th_guard_rifles_history","SourceString":"The 190th Guards Rifle Regiment was a unit of the 5th Rifle Division of the Soviet Red Army. The division was formed in 1918 and fought in the Russian Revolution and the Polish-Soviet War (1919-1921). After the launch of Operation Barbarossa in 1941, the division fought in the Baltic Operation and the Leningrad Strategic Defensive. In the winter of 1941-1942, it took part in the Battle of Moscow, fighting near Kalinin (now Tver). In the summer of 1942, the division participated in the Rzhev-Vyazma Offensive and was raised to Guards status for its performance. In February 1943, it fought in offensives around Mtsensk and Kalinin and in July it participated in Operation Kutuzov where it captured the city of Orel, earning the \"Orel\" honorific. It then fought in the Bryansk and Gomel-Rechitsa Offensives, reaching the Dnieper. In early 1944, it took part in the Rogachev-Zhlobin Offensive, receiving the Order of the Red Banner. During Operation Bagration, it was awarded the Order of Suvorov and later the Order of Kutuzov for capturing Vawkavysk. In 1945, it fought in the Berlin Offensive and was awarded the Order of Lenin before disbanding in June 1946.","LocalizedString":"The 190th Guards Rifle Regiment was a unit of the 5th Rifle Division of the Soviet Red Army. The division was formed in 1918 and fought in the Russian Revolution and the Polish-Soviet War (1919-1921). After the launch of Operation Barbarossa in 1941, the division fought in the Baltic Operation and the Leningrad Strategic Defensive. In the winter of 1941-1942, it took part in the Battle of Moscow, fighting near Kalinin (now Tver). In the summer of 1942, the division participated in the Rzhev-Vyazma Offensive and was raised to Guards status for its performance. In February 1943, it fought in offensives around Mtsensk and Kalinin and in July it participated in Operation Kutuzov where it captured the city of Orel, earning the \"Orel\" honorific. It then fought in the Bryansk and Gomel-Rechitsa Offensives, reaching the Dnieper. In early 1944, it took part in the Rogachev-Zhlobin Offensive, receiving the Order of the Red Banner. During Operation Bagration, it was awarded the Order of Suvorov and later the Order of Kutuzov for capturing Vawkavysk. In 1945, it fought in the Berlin Offensive and was awarded the Order of Lenin before disbanding in June 1946."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::BloodAndIron","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardDestroyed","ERegisteredCardFunction::OnStartofTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Veteran","EHelpBubbleTypes::Guard","EHelpBubbleTypes::Shock"],"spawnCardName":"card_unit_190th_guard_rifles_vet","receivedAbilitiesFromCards":[{"Key":"cantMove","Value":{"CardsGivingAbility":[0]}},{"Key":"cantAttack","Value":{"CardsGivingAbility":[0]}}],"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/Winter_2024/t_190th_guard_rifles.t_190th_guard_rifles","SubPathString":""},"artist":"Soviet WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/190th_GUARD_RIFLES.190th_GUARD_RIFLES","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":338.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_190th_guard_rifles_photo","SourceString":"Soviet infantry and tanks near the city of Orel, 1943.","LocalizedString":"Soviet infantry and tanks near the city of Orel, 1943."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName"