{"format":"kards-original-reference","version":1,"id":"f81564be6fa52da3","name":"card_unit_blue_legion","package":"/Game/Blueprints/Cards/Germany/OceaniaStorm/units/card_unit_blue_legion","parent":"UBaseCardObject","card":{"title":"BLUE LEGION","text":"After you operate a unit, give it +1+1 for each kredit spent to operate it.","flavorText":"The Blue Legion was the nickname of the Spanish Volunteer Legion, a small infantry force that remained on the Eastern Front after Spain withdrew most of the Blue Division in 1943. Spanish leader Francisco Franco had begun negotiations with the Allies, making the continued presence of a large Spanish formation in German service politically difficult. Around 2,133 Falangist volunteers stayed behind at first, officially organized into two battalions under German Army command. Later estimates place the number of Spaniards connected to the legion at over 3,000. The unit was active from November 1943 to April 1944 and fought during the later stages of the war on the Eastern Front, including the Leningrad Novgorod offensive. Its soldiers wore a sleeve patch representing a shield in Spain’s red and yellow colors, marked with the word ESPAÑA, which distinguished them from German troops while still showing their place in German service. Some Spanish volunteers refused repatriation even after the Blue Legion was dissolved. Small groups were absorbed into other German units, and a few later fought in Pomerania, Brandenburg, and Berlin in 1945.","faction":"Germany","type":"infantry","rarity":"Rare","cost":3,"operationCost":1,"attack":3,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_blue_legion","title":{"Namespace":"card_germany","Key":"card_unit_blue_legion_title","SourceString":"BLUE LEGION","LocalizedString":"BLUE LEGION"},"Type":"ETypeEnum::infantry","attack":3,"defense":5,"range":1,"faction":"EFactionEnum::Germany","kredits":3,"Text":{"Namespace":"card_germany","Key":"card_unit_blue_legion_text","SourceString":"After you operate a unit, give it +1+1 for each kredit spent to operate it.","LocalizedString":"After you operate a unit, give it +1+1 for each kredit spent to operate it."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_blue_legion_history","SourceString":"The Blue Legion was the nickname of the Spanish Volunteer Legion, a small infantry force that remained on the Eastern Front after Spain withdrew most of the Blue Division in 1943. Spanish leader Francisco Franco had begun negotiations with the Allies, making the continued presence of a large Spanish formation in German service politically difficult. Around 2,133 Falangist volunteers stayed behind at first, officially organized into two battalions under German Army command. Later estimates place the number of Spaniards connected to the legion at over 3,000. The unit was active from November 1943 to April 1944 and fought during the later stages of the war on the Eastern Front, including the Leningrad Novgorod offensive. Its soldiers wore a sleeve patch representing a shield in Spain’s red and yellow colors, marked with the word ESPAÑA, which distinguished them from German troops while still showing their place in German service. Some Spanish volunteers refused repatriation even after the Blue Legion was dissolved. Small groups were absorbed into other German units, and a few later fought in Pomerania, Brandenburg, and Berlin in 1945.","LocalizedString":"The Blue Legion was the nickname of the Spanish Volunteer Legion, a small infantry force that remained on the Eastern Front after Spain withdrew most of the Blue Division in 1943. Spanish leader Francisco Franco had begun negotiations with the Allies, making the continued presence of a large Spanish formation in German service politically difficult. Around 2,133 Falangist volunteers stayed behind at first, officially organized into two battalions under German Army command. Later estimates place the number of Spaniards connected to the legion at over 3,000. The unit was active from November 1943 to April 1944 and fought during the later stages of the war on the Eastern Front, including the Leningrad Novgorod offensive. Its soldiers wore a sleeve patch representing a shield in Spain’s red and yellow colors, marked with the word ESPAÑA, which distinguished them from German troops while still showing their place in German service. Some Spanish volunteers refused repatriation even after the Blue Legion was dissolved. Small groups were absorbed into other German units, and a few later fought in Pomerania, Brandenburg, and Berlin in 1945."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnAfterOtherCardAttacks","ERegisteredCardFunction::OnOtherCardMoveToFrontline"],"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/BLUE_LEGION.BLUE_LEGION","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_blue_legion_photo","SourceString":"Soldiers of the Spanish Blue Legion at the Battle of Leningrad in 1943.","LocalizedString":"Soldiers of the Spanish Blue Legion at the Battle of Leningrad in 1943."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"threat_level":0.1},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_blue_legion","owner":"card_unit_blue_legion_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction","locals":[{"name":"K2Node_Event_defenderCard_1","type":"UBaseCardObj