{"format":"kards-original-reference","version":1,"id":"8aa30f5ea28c1d54","name":"card_unit_bergmann_battalion","package":"/Game/Blueprints/Cards/Germany/NavalWarfare/units/card_unit_bergmann_battalion","parent":"UBaseCardObject","card":{"title":"BERGMANN BATTALION","text":"Once per turn, draw a card when you Convert one or more cards.","flavorText":"The Bergmann Battalion was a special German unit formed in 1942, composed of volunteers and Soviet prisoners of war from the Caucasus region, including Georgians, Armenians, Azerbaijanis, and other ethnic minorities. Organized by the Abwehr, Germany’s military intelligence, the battalion drew heavily from anti-Soviet exiles as well as POWs who agreed to serve in exchange for better conditions and the chance to fight against the Soviet regime. Trained for reconnaissance, sabotage, and mountain warfare, the Bergmann Battalion was used for difficult commando missions behind Soviet lines and anti-partisan operations. Their knowledge of local languages and terrain made them useful in the Caucasus, Crimea, and the Balkans, where they served during the German advance and later in defensive battles as the war situation worsened for Germany. The unit suffered heavy losses, and its history reflects both the complex loyalties and harsh realities faced by foreign volunteers and POWs in German service during WWII.","faction":"Germany","type":"infantry","rarity":"Uncommon","cost":2,"operationCost":1,"attack":2,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_bergmann_battalion","title":{"Namespace":"card_germany","Key":"card_unit_bergmann_battalion_title","SourceString":"BERGMANN BATTALION","LocalizedString":"BERGMANN BATTALION"},"Type":"ETypeEnum::infantry","attack":2,"defense":3,"range":1,"faction":"EFactionEnum::Germany","kredits":2,"Text":{"Namespace":"card_germany","Key":"card_unit_bergmann_battalion_text","SourceString":"Once per turn, draw a card when you Convert one or more cards.","LocalizedString":"Once per turn, draw a card when you Convert one or more cards."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_bergmann_battalion_history","SourceString":"The Bergmann Battalion was a special German unit formed in 1942, composed of volunteers and Soviet prisoners of war from the Caucasus region, including Georgians, Armenians, Azerbaijanis, and other ethnic minorities. Organized by the Abwehr, Germany’s military intelligence, the battalion drew heavily from anti-Soviet exiles as well as POWs who agreed to serve in exchange for better conditions and the chance to fight against the Soviet regime. Trained for reconnaissance, sabotage, and mountain warfare, the Bergmann Battalion was used for difficult commando missions behind Soviet lines and anti-partisan operations. Their knowledge of local languages and terrain made them useful in the Caucasus, Crimea, and the Balkans, where they served during the German advance and later in defensive battles as the war situation worsened for Germany. The unit suffered heavy losses, and its history reflects both the complex loyalties and harsh realities faced by foreign volunteers and POWs in German service during WWII.","LocalizedString":"The Bergmann Battalion was a special German unit formed in 1942, composed of volunteers and Soviet prisoners of war from the Caucasus region, including Georgians, Armenians, Azerbaijanis, and other ethnic minorities. Organized by the Abwehr, Germany’s military intelligence, the battalion drew heavily from anti-Soviet exiles as well as POWs who agreed to serve in exchange for better conditions and the chance to fight against the Soviet regime. Trained for reconnaissance, sabotage, and mountain warfare, the Bergmann Battalion was used for difficult commando missions behind Soviet lines and anti-partisan operations. Their knowledge of local languages and terrain made them useful in the Caucasus, Crimea, and the Balkans, where they served during the German advance and later in defensive battles as the war situation worsened for Germany. The unit suffered heavy losses, and its history reflects both the complex loyalties and harsh realities faced by foreign volunteers and POWs in German service during WWII."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::NavalWarfare","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardConverted","ERegisteredCardFunction::OnEndOfTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Convert","EHelpBubbleTypes::Trigger"],"hasBlitz":true,"hasAlpine":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/NavalWarfare/t_bergmann_battalion.t_bergmann_battalion","SubPathString":""},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/BERGMANN_BATTALION.BERGMANN_BATTALION","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":303.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_bergmann_battalion_photo","SourceString":"Men of the Bergmann Battalion. Date unknown.","LocalizedString":"Men of the Bergmann Battalion. Date unknown."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[{"name":"triggered","type":"bool","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_bergmann_battalion","owner":"card_unit_bergmann_battalion_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"K2Node_Event_oldCardIDs","type":"TArray<int32>","direction":"in"},{"name":"K2Node_Event_newCardIDs","typ