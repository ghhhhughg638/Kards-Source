{"format":"kards-original-reference","version":1,"id":"a1dbda8dc8f9c14c","name":"card_unit_115th_separate_btn","package":"/Game/Blueprints/Cards/Soviet/CovertOp/units/card_unit_115th_separate_btn","parent":"UBaseCardObject","card":{"title":"115th SEPARATE BTN","text":"Reveal: Gets +2+1 for each friendly turn it ends as Covert.","flavorText":"The 115th Separate Battalion was a unit of the 30th Rifle Division of the Soviet Red Army during WWII. The division was formed in 1918, but reformed at the outbreak of WWII and stationed at the Soviet-Romanian border. In August 1941 the 30th Rifle Division was transferred to the Separate Coastal Army which was ordered to defend Odessa. The division was cut off before reaching its destination and forced to withdraw.  In 1942 the division was involved in numerous defensive battles in the southwest regions of the Soviet Union and for its meritorious actions it was transformed into the 55th Guards Rifle Division. Between 1943 and 1945 the division took part in the liberation of North Caucasus and the Taman Peninsula. It participated in the Kerch–Eltigen operation, landing on the beach in Danger, Yenikale, and fought on the Kerch Peninsula until April 1944. It was later involved in strategic operations in Belarus and eastern Poland, and in the East Prussian, Berlin and Prague offensives. The division was disbanded with the Northern Group of Forces during the summer of 1945.","faction":"Soviet","type":"infantry","rarity":"Common","cost":3,"operationCost":1,"attack":1,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_115th_separate_btn","title":{"Namespace":"card_soviet","Key":"card_unit_115th_separate_btn_title","SourceString":"115th SEPARATE BTN","LocalizedString":"115th SEPARATE BTN"},"Type":"ETypeEnum::infantry","attack":1,"defense":2,"range":1,"faction":"EFactionEnum::Soviet","kredits":3,"Text":{"Namespace":"card_soviet","Key":"card_unit_115th_separate_btn_text","SourceString":"Reveal: Gets +2+1 for each friendly turn it ends as Covert.","LocalizedString":"Reveal: Gets +2+1 for each friendly turn it ends as Covert."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_115th_separate_btn_history","SourceString":"The 115th Separate Battalion was a unit of the 30th Rifle Division of the Soviet Red Army during WWII. The division was formed in 1918, but reformed at the outbreak of WWII and stationed at the Soviet-Romanian border. In August 1941 the 30th Rifle Division was transferred to the Separate Coastal Army which was ordered to defend Odessa. The division was cut off before reaching its destination and forced to withdraw.  In 1942 the division was involved in numerous defensive battles in the southwest regions of the Soviet Union and for its meritorious actions it was transformed into the 55th Guards Rifle Division. Between 1943 and 1945 the division took part in the liberation of North Caucasus and the Taman Peninsula. It participated in the Kerch–Eltigen operation, landing on the beach in Danger, Yenikale, and fought on the Kerch Peninsula until April 1944. It was later involved in strategic operations in Belarus and eastern Poland, and in the East Prussian, Berlin and Prague offensives. The division was disbanded with the Northern Group of Forces during the summer of 1945.","LocalizedString":"The 115th Separate Battalion was a unit of the 30th Rifle Division of the Soviet Red Army during WWII. The division was formed in 1918, but reformed at the outbreak of WWII and stationed at the Soviet-Romanian border. In August 1941 the 30th Rifle Division was transferred to the Separate Coastal Army which was ordered to defend Odessa. The division was cut off before reaching its destination and forced to withdraw.  In 1942 the division was involved in numerous defensive battles in the southwest regions of the Soviet Union and for its meritorious actions it was transformed into the 55th Guards Rifle Division. Between 1943 and 1945 the division took part in the liberation of North Caucasus and the Taman Peninsula. It participated in the Kerch–Eltigen operation, landing on the beach in Danger, Yenikale, and fought on the Kerch Peninsula until April 1944. It was later involved in strategic operations in Belarus and eastern Poland, and in the East Prussian, Berlin and Prague offensives. The division was disbanded with the Northern Group of Forces during the summer of 1945."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::CurrentExpansion","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"hasCovert":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/Summer_24/t_115th_separate_btn.t_115th_separate_btn","SubPathString":""},"artist":"Soviet WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/115th_SEPARATE_BN.115th_SEPARATE_BN","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":363.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_115th_separate_btn_photo","SourceString":"Soviet troops during the Kerch-Eltigen operation, 1943-1944.","LocalizedString":"Soviet troops during the Kerch-Eltigen operation, 1943-1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"visualCardWeight":"EVisualCardWeight::Light","isDefenseBuff":true},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_unit_115th_separate_btn","owner":"card_unit_115th_separate_btn_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"CallFunc_IsSideA