{"format":"kards-original-reference","version":1,"id":"bbcee5a8ae128d9f","name":"card_event_counter_offensive","package":"/Game/Blueprints/Cards/Soviet/Allegiance/events/card_event_counter_offensive","parent":"UBaseCardObject","card":{"title":"COUNTER OFFENSIVE","text":"Target infantry or tank gets +2+1 for each damaged unit on the battlefield.","flavorText":"A counter offensive is an attack made in response to one from an enemy. The codename for one of the most famous Soviet counter offensives on the Eastern Front was Operation Uranus. This counter offensive was launched during the Battle of Stalingrad in the winter of 1942 and with it the Red Army won a decisive victory in the battle. As a result the Red Army managed to encircle the German 6th Army, the 3rd and 4th Romanian armies and portions of the German Fourth Panzer Army. This counter offensive turned the tide on the Eastern Front and after it the Axis forces were fighting a defensive war on all fronts.","faction":"Soviet","type":"order","rarity":"Uncommon","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_counter_offensive","title":{"Namespace":"card_soviet","Key":"card_event_counter_offensive_title","SourceString":"COUNTER OFFENSIVE","LocalizedString":"COUNTER OFFENSIVE"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Soviet","kredits":2,"Text":{"Namespace":"card_soviet","Key":"card_event_counter_offensive_text","SourceString":"Target infantry or tank gets +2+1 for each damaged unit on the battlefield.","LocalizedString":"Target infantry or tank gets +2+1 for each damaged unit on the battlefield."},"flavorText":{"Namespace":"card_soviet","Key":"card_event_counter_offensive_history","SourceString":"A counter offensive is an attack made in response to one from an enemy. The codename for one of the most famous Soviet counter offensives on the Eastern Front was Operation Uranus. This counter offensive was launched during the Battle of Stalingrad in the winter of 1942 and with it the Red Army won a decisive victory in the battle. As a result the Red Army managed to encircle the German 6th Army, the 3rd and 4th Romanian armies and portions of the German Fourth Panzer Army. This counter offensive turned the tide on the Eastern Front and after it the Axis forces were fighting a defensive war on all fronts.","LocalizedString":"A counter offensive is an attack made in response to one from an enemy. The codename for one of the most famous Soviet counter offensives on the Eastern Front was Operation Uranus. This counter offensive was launched during the Battle of Stalingrad in the winter of 1942 and with it the Red Army won a decisive victory in the battle. As a result the Red Army managed to encircle the German 6th Army, the 3rd and 4th Romanian armies and portions of the German Fourth Panzer Army. This counter offensive turned the tide on the Eastern Front and after it the Axis forces were fighting a defensive war on all fronts."},"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Expansion2019","isInPermanentPool":true,"soundEnterPlay":{"ObjectName":"SoundCue'AU_Seq_SupplyDrop_1P_Cue'","ObjectPath":"kards/Content/Assets/Audio/Misc/Supply_Drop/AU_Seq_SupplyDrop_1P_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/t_counter_offensive.t_counter_offensive","SubPathString":""},"artist":"Soviet WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/COUNTER_OFFENSIVE.COUNTER_OFFENSIVE","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":314.0},"historyPhotoSource":"http://pix.avaxnews.com/","historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_event_counter_offensive_photo","SourceString":"Soviet soldiers attacking German positions. Stalingrad 1942.","LocalizedString":"Soviet soldiers attacking German positions. Stalingrad 1942."},"OnPlayedFromHandVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_OrderSupplyDrop.BP_