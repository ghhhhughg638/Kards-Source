{"format":"kards-original-reference","version":1,"id":"778866f1568f860f","name":"card_event_do_or_die","package":"/Game/Blueprints/Cards/Soviet/OceaniaStorm/events/card_event_do_or_die","parent":"UBaseCardObject","card":{"title":"DO OR DIE","text":"When a friendly unit is destroyed this turn, add a BLAST and a PRODUCTION to your hand.","flavorText":"Pavlov’s House was a four-story apartment block in central Stalingrad, close to the Volga and overlooking 9th January Square. In late 1942, soldiers of the 42nd Guards Rifle Regiment, 13th Guards Rifle Division, took the building back from German forces and turned it into a fortified strongpoint. Its popular name came from Sergeant Yakov Pavlov, who led the small group that first seized it, though Lieutenant Ivan Afanasiev later commanded the position. The defenders mined the approaches, put barbed wire around the building, and placed machine guns and anti-tank rifles in windows and on upper floors. They broke holes through walls to move inside the building and dug a trench to connect with Soviet positions near the Volga. Supplies reached them through this trench or by boats crossing under fire. The garrison held the position for roughly two months, with soldiers and civilians sheltering in the same ruined structure. Some later accounts made Pavlov’s House more famous than wartime records suggest, but it remains one of the best known examples of Stalingrad street fighting.","faction":"Soviet","type":"order","rarity":"Rare","cost":2,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_do_or_die","title":{"Namespace":"card_soviet","Key":"card_event_do_or_die_title","SourceString":"DO OR DIE","LocalizedString":"DO OR DIE"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Soviet","kredits":2,"Text":{"Namespace":"card_soviet","Key":"card_event_do_or_die_text","SourceString":"When a friendly unit is destroyed this turn, add a BLAST and a PRODUCTION to your hand.","LocalizedString":"When a friendly unit is destroyed this turn, add a BLAST and a PRODUCTION to your hand."},"flavorText":{"Namespace":"card_soviet","Key":"card_event_do_or_die_history","SourceString":"Pavlov’s House was a four-story apartment block in central Stalingrad, close to the Volga and overlooking 9th January Square. In late 1942, soldiers of the 42nd Guards Rifle Regiment, 13th Guards Rifle Division, took the building back from German forces and turned it into a fortified strongpoint. Its popular name came from Sergeant Yakov Pavlov, who led the small group that first seized it, though Lieutenant Ivan Afanasiev later commanded the position. The defenders mined the approaches, put barbed wire around the building, and placed machine guns and anti-tank rifles in windows and on upper floors. They broke holes through walls to move inside the building and dug a trench to connect with Soviet positions near the Volga. Supplies reached them through this trench or by boats crossing under fire. The garrison held the position for roughly two months, with soldiers and civilians sheltering in the same ruined structure. Some later accounts made Pavlov’s House more famous than wartime records suggest, but it remains one of the best known examples of Stalingrad street fighting.","LocalizedString":"Pavlov’s House was a four-story apartment block in central Stalingrad, close to the Volga and overlooking 9th January Square. In late 1942, soldiers of the 42nd Guards Rifle Regiment, 13th Guards Rifle Division, took the building back from German forces and turned it into a fortified strongpoint. Its popular name came from Sergeant Yakov Pavlov, who led the small group that first seized it, though Lieutenant Ivan Afanasiev later commanded the position. The defenders mined the approaches, put barbed wire around the building, and placed machine guns and anti-tank rifles in windows and on upper floors. They broke holes through walls to move inside the building and dug a trench to connect with Soviet positions near the Volga. Supplies reached them through this trench or by boats crossing under fire. The garrison held the position for roughly two months, with soldiers and civilians sheltering in the same ruined structure. Some later accounts made Pavlov’s House more famous than wartime records suggest, but it remains one of the best known examples of Stalingrad street fighting."},"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::OceaniaStorm","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn","ERegisteredCardFunction::OnOtherCardDestroyed"],"spawnCardName":"card_event_blast;card_event_production","soundEnterPlay":{"ObjectName":"SoundWave'Patriotic_Push'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Patriotic_Push.0"},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/DO_OR_DIE.DO_OR_DIE","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_event_do_or_die_photo","SourceString":"Pavlov's House, Stalingrad, 1943.","LocalizedString":"Pavlov's House, Stalingrad, 1943."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_OrderDiveBomber.BP_OrderDiveBomber_C","SubPathString":""},"customName1":"endofturn2","isDirectDamage":true},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_event_do_or_die","owner":"card_event_do_or_die_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_text_Variable","type":"FText","direction":"in"},{"name":"Temp_text_Variable_1","type":"FText","direction":"in"},{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_JSON_SetBool_found","type":"bool","direction":"in"},{"name":"K2Node_Event_cardDestroyed","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_killer","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_TriggerNotDestroyed","type":"bool","directi