{"format":"kards-original-reference","version":1,"id":"ea6bf8c63066d3a4","name":"card_unit_wakamatsu_regiment","package":"/Game/Blueprints/Cards/Japan/Breakthrough/units/card_unit_wakamatsu_regiment","parent":"UBaseCardObject","card":{"title":"WAKAMATSU REGIMENT","text":"Destruction: Destroy all of your WAKAMATSU REGIMENT units.","flavorText":"The 29th Infantry Regiment Wakamatsu was from 1940 attached to the 2nd Division of the Imperial Japanese Army, nicknamed the \"Courageous Division\". It was one of the divisions that occupied the Dutch East Indies in 1940. In 1942 it was transferred to Papua New Guinea, but from there it was deployed on Guadalcanal where it landed on the west coast of Matanikau River and suffered heavy losses in the Actions along the Matanikau and in the Battle for Henderson Field. After Guadalcanal the 2nd Division was assigned to garrison duties in Malaya and Singapore, but in 1944 the division was sent to Burma where it was almost destroyed while fighting the British reoccupation. The 29th Wakamatsu Regiment was disbanded after the war along with the 2nd Division.","faction":"Japan","type":"infantry","rarity":"Common","cost":1,"operationCost":1,"attack":2,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_wakamatsu_regiment","title":{"Namespace":"card_japan","Key":"card_unit_wakamatsu_regiment_title","SourceString":"WAKAMATSU REGIMENT","LocalizedString":"WAKAMATSU REGIMENT"},"Type":"ETypeEnum::infantry","attack":2,"defense":2,"range":1,"faction":"EFactionEnum::Japan","kredits":1,"Text":{"Namespace":"card_japan","Key":"card_unit_wakamatsu_regiment_text","SourceString":"Destruction: Destroy all of your WAKAMATSU REGIMENT units.","LocalizedString":"Destruction: Destroy all of your WAKAMATSU REGIMENT units."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_wakamatsu_regiment_history","SourceString":"The 29th Infantry Regiment Wakamatsu was from 1940 attached to the 2nd Division of the Imperial Japanese Army, nicknamed the \"Courageous Division\". It was one of the divisions that occupied the Dutch East Indies in 1940. In 1942 it was transferred to Papua New Guinea, but from there it was deployed on Guadalcanal where it landed on the west coast of Matanikau River and suffered heavy losses in the Actions along the Matanikau and in the Battle for Henderson Field. After Guadalcanal the 2nd Division was assigned to garrison duties in Malaya and Singapore, but in 1944 the division was sent to Burma where it was almost destroyed while fighting the British reoccupation. The 29th Wakamatsu Regiment was disbanded after the war along with the 2nd Division.","LocalizedString":"The 29th Infantry Regiment Wakamatsu was from 1940 attached to the 2nd Division of the Imperial Japanese Army, nicknamed the \"Courageous Division\". It was one of the divisions that occupied the Dutch East Indies in 1940. In 1942 it was transferred to Papua New Guinea, but from there it was deployed on Guadalcanal where it landed on the west coast of Matanikau River and suffered heavy losses in the Actions along the Matanikau and in the Battle for Henderson Field. After Guadalcanal the 2nd Division was assigned to garrison duties in Malaya and Singapore, but in 1944 the division was sent to Burma where it was almost destroyed while fighting the British reoccupation. The 29th Wakamatsu Regiment was disbanded after the war along with the 2nd Division."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::Breakthrough","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Destruction","EHelpBubbleTypes::Fury"],"hasDestruction":true,"hasFury":true,"soundBlowUp":{"ObjectName":"SoundWave'explosion_small_01'","ObjectPath":"kards/Content/ExplosionSoundPack/ExplosionSounds/Wavs/explosion_small_01.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/CandidateArtwork/WE_Candidates/t_japanese_soldier_asgeir_2.t_japanese_soldier_asgeir_2","SubPathString":""},"artist":"Asgeir Jon","historyPhot