{"format":"kards-original-reference","version":1,"id":"ccb2ac3e2cbe89ef","name":"card_event_uss_yorktown","package":"/Game/Blueprints/Cards/USA/NavalWarfare/events/card_event_uss_yorktown","parent":"UBaseCardObject","card":{"title":"USS YORKTOWN","text":"Add four BREWSTER F2A to the battlefield, in the frontline if possible.","flavorText":"The USS Yorktown (CV-5) was the lead ship of her class and one of the US Navy's most important aircraft carriers during the early phase of WWII. Commissioned in 1937, she initially served in the Atlantic but was transferred to the Pacific shortly after the attack on Pearl Harbor. As the flagship of Task Force 17, Yorktown played a crucial role in several key battles. In May 1942, during the Battle of the Coral Sea, Yorktown's aircraft were instrumental in sinking the Japanese light carrier Shōhō and damaging the aircraft carrier Shōkaku. Although Yorktown was damaged in the battle, emergency repairs at Pearl Harbor were completed in just three days, allowing her to join the decisive Battle of Midway in early June. At Midway, Yorktown’s air groups helped sink the Japanese carriers Sōryū and Hiryū. However, she was struck by bombs and torpedoes from Hiryū-launched aircraft. Though initially kept afloat, Yorktown was later hit by torpedoes from the submarine I-168 while under tow and sank on June 7, 1942.","faction":"USA","type":"order","rarity":"Rare","cost":5,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"GameplayTags":["subtype.navy"],"Name":"card_event_uss_yorktown","title":{"Namespace":"card_usa","Key":"card_event_uss_yorktown_title","SourceString":"USS YORKTOWN","LocalizedString":"USS YORKTOWN"},"Type":"ETypeEnum::order","faction":"EFactionEnum::USA","kredits":5,"Text":{"Namespace":"card_usa","Key":"card_event_uss_yorktown_text","SourceString":"Add four BREWSTER F2A to the battlefield, in the frontline if possible.","LocalizedString":"Add four BREWSTER F2A to the battlefield, in the frontline if possible."},"flavorText":{"Namespace":"card_usa","Key":"card_event_uss_yorktown_history","SourceString":"The USS Yorktown (CV-5) was the lead ship of her class and one of the US Navy's most important aircraft carriers during the early phase of WWII. Commissioned in 1937, she initially served in the Atlantic but was transferred to the Pacific shortly after the attack on Pearl Harbor. As the flagship of Task Force 17, Yorktown played a crucial role in several key battles. In May 1942, during the Battle of the Coral Sea, Yorktown's aircraft were instrumental in sinking the Japanese light carrier Shōhō and damaging the aircraft carrier Shōkaku. Although Yorktown was damaged in the battle, emergency repairs at Pearl Harbor were completed in just three days, allowing her to join the decisive Battle of Midway in early June. At Midway, Yorktown’s air groups helped sink the Japanese carriers Sōryū and Hiryū. However, she was struck by bombs and torpedoes from Hiryū-launched aircraft. Though initially kept afloat, Yorktown was later hit by torpedoes from the submarine I-168 while under tow and sank on June 7, 1942.","LocalizedString":"The USS Yorktown (CV-5) was the lead ship of her class and one of the US Navy's most important aircraft carriers during the early phase of WWII. Commissioned in 1937, she initially served in the Atlantic but was transferred to the Pacific shortly after the attack on Pearl Harbor. As the flagship of Task Force 17, Yorktown played a crucial role in several key battles. In May 1942, during the Battle of the Coral Sea, Yorktown's aircraft were instrumental in sinking the Japanese light carrier Shōhō and damaging the aircraft carrier Shōkaku. Although Yorktown was damaged in the battle, emergency repairs at Pearl Harbor were completed in just three days, allowing her to join the decisive Battle of Midway in early June. At Midway, Yorktown’s air groups helped sink the Japanese carriers Sōryū and Hiryū. However, she was struck by bombs and torpedoes from Hiryū-launched aircraft. Though initially kept afloat, Yorktown was later hit by torpedoes from the submarine I-168 while under tow and sank on June 7, 1942."},"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::NavalWarfare","spawnCardName":"card_unit_brewster_f2a","soundEnterPlay":{"ObjectName":"SoundCue'AU_Flyby_Fighter_small_Cue'","ObjectPath":"kards/Content/Assets/Audio/Fighters/AU_Flyby_Fighter_small_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/USA/NavalWarfare/t_uss_yorktown.t_uss_yorktown","SubPathString":""},"artist":"Tom Freeman","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/USS_Yorktown_02.USS_Yorktown_02","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":379.0},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_event_uss_yorktown_photo","SourceString":"USS Yorktown in July 1944.","LocalizedString":"USS Yorktown in July 1944."},"OnPlayedFromHandVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_OrderAmphibianAssault.BP_OrderAmphibianAssault_C","SubPathString":""},"isAttackBuff":true,"isDefenseBuff":true},"variables":[],"functions":[{"name":"ExecuteUbergraph_card_event_uss_yorktown","owner":"card_event_uss_yorktown_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_text_Variable","type":"FText","direction":"in"},{"name":"Temp_int_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"CallFunc_LessEqual_IntInt_ReturnValue","type":"bool","direction":"in"},{"name":"Temp_bool_Variable","type":"bool","direction":"in"},{"name":"CallFunc_Not_PreBool_ReturnValue","type":"bool","direction":"in"},{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_BooleanAND_ReturnValue","type":"bool","direction":"in"},{"name":"CallFunc_GetOppositeSide_oppositeSide","type