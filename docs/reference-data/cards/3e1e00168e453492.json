{"format":"kards-original-reference","version":1,"id":"3e1e00168e453492","name":"card_unit_171_infantry_regiment","package":"/Game/Blueprints/Cards/Germany/CovertOp/units/card_unit_171_infantry_regiment","parent":"UBaseCardObject","card":{"title":"171. INFANTRY REGIMENT","text":"Has +4 attack if this is your only unit.","flavorText":"The 171st Infantry Regiment was a unit of the 56th Infantry Division of the German Wehrmacht during WWII. The division was formed in 1939 and spent a short time on occupation duty in Poland before seeing combat for the first time in 1940 during the Battle of France. After that the 56th Division spent the remainder of the war on the Eastern Front where it participated in the Battle of Moscow and the Battle of Kursk, where it suffered heavy losses. It was disbanded shortly after. The division was reformed in East Prussia in September 1944 but was again destroyed during the Soviet East Prussian Offensive in early 1945.","faction":"Germany","type":"infantry","rarity":"Uncommon","cost":5,"operationCost":1,"attack":3,"defense":7},"defaults":{"UberGraphFrame":{},"Name":"card_unit_171_infantry_regiment","title":{"Namespace":"card_germany","Key":"card_unit_171_infantry_regiment_title","SourceString":"171. INFANTRY REGIMENT","LocalizedString":"171. INFANTRY REGIMENT"},"Type":"ETypeEnum::infantry","attack":3,"defense":7,"range":1,"faction":"EFactionEnum::Germany","kredits":5,"Text":{"Namespace":"card_germany","Key":"card_unit_171_infantry_regiment_text","SourceString":"Has +4 attack if this is your only unit.","LocalizedString":"Has +4 attack if this is your only unit."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_171_infantry_regiment_history","SourceString":"The 171st Infantry Regiment was a unit of the 56th Infantry Division of the German Wehrmacht during WWII. The division was formed in 1939 and spent a short time on occupation duty in Poland before seeing combat for the first time in 1940 during the Battle of France. After that the 56th Division spent the remainder of the war on the Eastern Front where it participated in the Battle of Moscow and the Battle of Kursk, where it suffered heavy losses. It was disbanded shortly after. The division was reformed in East Prussia in September 1944 but was again destroyed during the Soviet East Prussian Offensive in early 1945.","LocalizedString":"The 171st Infantry Regiment was a unit of the 56th Infantry Division of the German Wehrmacht during WWII. The division was formed in 1939 and spent a short time on occupation duty in Poland before seeing combat for the first time in 1940 during the Battle of France. After that the 56th Division spent the remainder of the war on the Eastern Front where it participated in the Battle of Moscow and the Battle of Kursk, where it suffered heavy losses. It was disbanded shortly after. The division was reformed in East Prussia in September 1944 but was again destroyed during the Soviet East Prussian Offensive in early 1945."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::CurrentExpansion","isReserved":true,"EffectType":"ECardEffectTypes::Passive","usedTriggers":["ERegisteredCardFunction::OnOtherCardEnterPlay","ERegisteredCardFunction::OnAfterOtherCardLeaveBoardOrOwner","ERegisteredCardFunction::OnOtherCovertCardPlayedFromHand"],"hasBlitz":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/CandidateArtwork/Summer_24/t_171_infantry_regiment.t_171_infantry_regiment","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/171__INFANTRY_REGIMENT.171__INFANTRY_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":343.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_171_infantry_regiment_photo","SourceString":"German infantry in East Prussia, 1945.","LocalizedString":"German infantry in East Prussia, 1945."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'