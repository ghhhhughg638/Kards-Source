{"format":"kards-original-reference","version":1,"id":"b05555bd96484a54","name":"card_unit_t_34_76d","package":"/Game/Blueprints/Cards/Soviet/BloodIron/units/card_unit_t_34_76d","parent":"UBaseCardObject","card":{"title":"T-34/76D","text":"Destruction: Draw a T-34 from your deck and reduce its cost by 2.","flavorText":"The T-34 was a legendary Soviet tank which entered production in 1940 after the Red Army realized the deficiencies of their existing T-26 and BT tanks during the battles of Khalkhin Gol and the Winter War. It was designed to fulfill the need for a more heavily armed and armored universal tank. Throughout the war the T-34 was constantly upgraded and the T-34/76D was introduced in 1943. Its main feature was the new hexagonal turret, nicknamed “Mickey Mouse” because of its appearance with the twin, round turret hatches open. This variant of T-34 tanks would be the main Soviet battle tank of the important battle of Kursk and the following Soviet offensive.","faction":"Soviet","type":"tank","rarity":"Common","cost":4,"operationCost":2,"attack":4,"defense":4},"defaults":{"UberGraphFrame":{},"GameplayTags":["subtype.t34"],"Name":"card_unit_t_34_76d","title":{"Namespace":"card_soviet","Key":"card_unit_t_34_76d_title","SourceString":"T-34/76D","LocalizedString":"T-34/76D"},"Type":"ETypeEnum::tank","attack":4,"defense":4,"range":1,"faction":"EFactionEnum::Soviet","kredits":4,"Text":{"Namespace":"card_soviet","Key":"card_unit_t_34_76d_text","SourceString":"Destruction: Draw a T-34 from your deck and reduce its cost by 2.","LocalizedString":"Destruction: Draw a T-34 from your deck and reduce its cost by 2."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_t_34_76d_history","SourceString":"The T-34 was a legendary Soviet tank which entered production in 1940 after the Red Army realized the deficiencies of their existing T-26 and BT tanks during the battles of Khalkhin Gol and the Winter War. It was designed to fulfill the need for a more heavily armed and armored universal tank. Throughout the war the T-34 was constantly upgraded and the T-34/76D was introduced in 1943. Its main feature was the new hexagonal turret, nicknamed “Mickey Mouse” because of its appearance with the twin, round turret hatches open. This variant of T-34 tanks would be the main Soviet battle tank of the important battle of Kursk and the following Soviet offensive.","LocalizedString":"The T-34 was a legendary Soviet tank which entered production in 1940 after the Red Army realized the deficiencies of their existing T-26 and BT tanks during the battles of Khalkhin Gol and the Winter War. It was designed to fulfill the need for a more heavily armed and armored universal tank. Throughout the war the T-34 was constantly upgraded and the T-34/76D was introduced in 1943. Its main feature was the new hexagonal turret, nicknamed “Mickey Mouse” because of its appearance with the twin, round turret hatches open. This variant of T-34 tanks would be the main Soviet battle tank of the important battle of Kursk and the following Soviet offensive."},"operationCost":2,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::BloodAndIron","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Destruction"],"hasDestruction":true,"heavyArmor":1,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/Winter_2024/t_34_76_d.t_34_76_d","SubPathString":""},"artist":"Nicolas Trudgian","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/T-3476D.T-3476D","SubPathString":""},"historyPhotoSize":{"X":333.0,"Y":512.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_t_34_76d_photo","SourceString":"T-34/76 D in the summer of 1943. Note the hexagonal turret with hatches open, giving the tank the “Mickey Mouse” nickname.","LocalizedString":"T-34/76 D in the summer of 1943. Note the hexagonal turret with hatches open, giving the tank the “Mickey Mouse” nickname."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionArmourM'","