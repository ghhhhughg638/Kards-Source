{"format":"kards-original-reference","version":1,"id":"4530552a1d541b51","name":"card_event_orp_blyskawica","package":"/Game/Blueprints/Cards/Poland/events/card_event_orp_blyskawica","parent":"UBaseCardObject","card":{"title":"ORP BŁYSKAWICA","text":"Copy a random order in the enemy deck. Gain HQ defense equal to its cost.","flavorText":"ORP Błyskawica (Lightning) was one of two Grom-Class destroyers that were built for the Polish Navy by the British company J. Samuel White and were among the most heavily armed and fastest destroyers of WWII. Two days before the war started the Błyskawica, its sister ship Grom, and the Burza destroyer escaped unhindered from the Baltic Sea to Britain from where it worked closely together with the Royal Navy's Home Fleet. Both Błyskawica and Grom participated in the Norwegian Campaign where the latter was sunk by an attacking Heinkel He 111 bomber.  The Błyskawica participated in Operation Dynamo, the evacuation of British troops from Dunkirk, but would for the remainder of the war take part in convoy and patrol duties in the Atlantic and the Mediterranean. After the war the Błyskawica was used as a training ship for the Polish Navy, but was decommissioned in 1976 and has since then been on display as part of the Naval Museum in Gdynia.","faction":"Poland","type":"order","rarity":"Rare","cost":3,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"GameplayTags":["subtype.navy"],"Name":"card_event_orp_blyskawica","title":{"Namespace":"card_poland","Key":"card_event_orp_blyskawica_title","SourceString":"ORP BŁYSKAWICA","LocalizedString":"ORP BŁYSKAWICA"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Poland","kredits":3,"Text":{"Namespace":"card_poland","Key":"card_event_orp_blyskawica_text","SourceString":"Copy a random order in the enemy deck. Gain HQ defense equal to its cost.","LocalizedString":"Copy a random order in the enemy deck. Gain HQ defense equal to its cost."},"flavorText":{"Namespace":"card_poland","Key":"card_event_orp_blyskawica_history","SourceString":"ORP Błyskawica (Lightning) was one of two Grom-Class destroyers that were built for the Polish Navy by the British company J. Samuel White and were among the most heavily armed and fastest destroyers of WWII. Two days before the war started the Błyskawica, its sister ship Grom, and the Burza destroyer escaped unhindered from the Baltic Sea to Britain from where it worked closely together with the Royal Navy's Home Fleet. Both Błyskawica and Grom participated in the Norwegian Campaign where the latter was sunk by an attacking Heinkel He 111 bomber.  The Błyskawica participated in Operation Dynamo, the evacuation of British troops from Dunkirk, but would for the remainder of the war take part in convoy and patrol duties in the Atlantic and the Mediterranean. After the war the Błyskawica was used as a training ship for the Polish Navy, but was decommissioned in 1976 and has since then been on display as part of the Naval Museum in Gdynia.","LocalizedString":"ORP Błyskawica (Lightning) was one of two Grom-Class destroyers that were built for the Polish Navy by the British company J. Samuel White and were among the most heavily armed and fastest destroyers of WWII. Two days before the war started the Błyskawica, its sister ship Grom, and the Burza destroyer escaped unhindered from the Baltic Sea to Britain from where it worked closely together with the Royal Navy's Home Fleet. Both Błyskawica and Grom participated in the Norwegian Campaign where the latter was sunk by an attacking Heinkel He 111 bomber.  The Błyskawica participated in Operation Dynamo, the evacuation of British troops from Dunkirk, but would for the remainder of the war take part in convoy and patrol duties in the Atlantic and the Mediterranean. After the war the Błyskawica was used as a training ship for the Polish Navy, but was decommissioned in 1976 and has since then been on display as part of the Naval Museum in Gdynia."},"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::WorldAtWar","isReserved":true,"cipher":2,"exileNation":"EFactionEnum::Britain","soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Field_Snares_3'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Field_Snares_3.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Poland/t_orp_blyskawica.t_orp_blyskawica","SubPathString":""},"artist":"Jarosław Wróbel","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/ORP_BLYSKAWICA.ORP_BLYSKAWICA","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":344.0},"historyPhotoDescription":{"Namespace":"card_poland","Key":"card_event_orp_blyskawica_photo","SourceString":"ORP Błyskawica and ORP Grom after reaching British waters in September 1939.","LocalizedString":"ORP Błyskawica and ORP Grom after reaching British waters in September 1939."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackOrder.BP_AttackOrder_C","SubPathString":""},"Notes":"Image needed to be customized","isDefenseBuff":true},"variables":[{"name":"possibleOrders","type":"TArray<UBaseCardObject*>","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_event_orp_blyskawica","owner":"card_event_orp_blyskawica_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"K2Node_Event_targetCard","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_Array_Length_ReturnValue","type":"int32","direction":"in"},{"name":"CallFunc_Greater_IntInt_ReturnValue","type":"bool","direction":"in"},{"name":"CallFunc_GetHandLocationBySide_handLocation","type":"ECardLocationEnum","direction":"in"},{"name":"CallFunc_