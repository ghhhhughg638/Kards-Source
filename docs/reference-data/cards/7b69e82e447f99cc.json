{"format":"kards-original-reference","version":1,"id":"7b69e82e447f99cc","name":"card_event_hms_formidable","package":"/Game/Blueprints/Cards/Britain/NavalWarfare/events/card_event_hms_formidable","parent":"UBaseCardObject","card":{"title":"HMS FORMIDABLE","text":"Change the attack of a friendly unit to be equal to its defense. It fights all enemy units in random order.","flavorText":"HMS Formidable was an Illustrious-class aircraft carrier of the British Royal Navy, commissioned in 1940. She was built with an armored flight deck designed to withstand heavy air attacks, which was a critical feature during the intense naval battles of WWII. HMS Formidable first saw action in the Mediterranean where it launched strikes against Italian targets and played a key role in the Battle of Cape Matapan in 1941. She later supported operations in the Pacific and Indian Oceans, including air raids against Japanese positions in Sumatra and the invasion of Okinawa. In May 1945, she was hit directly by a kamikaze attack, but thanks to her armored design, took only limited damage and was back in action within hours. Throughout the war, Formidable's aircraft flew thousands of sorties and provided vital support to Allied naval and ground forces. After the war, HMS Formidable was used to transport former POWs and military personnel across the British Empire. Her final troop transport mission concluded in February 1947. She was then decommissioned in 1953 and sold for scrap.","faction":"Britain","type":"order","rarity":"Rare","cost":4,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"GameplayTags":["subtype.navy"],"Name":"card_event_hms_formidable","title":{"Namespace":"card_britain","Key":"card_event_hms_formidable_title","SourceString":"HMS FORMIDABLE","LocalizedString":"HMS FORMIDABLE"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Britain","kredits":4,"Text":{"Namespace":"card_britain","Key":"card_event_hms_formidable_text","SourceString":"Change the attack of a friendly unit to be equal to its defense. It fights all enemy units in random order.","LocalizedString":"Change the attack of a friendly unit to be equal to its defense. It fights all enemy units in random order."},"flavorText":{"Namespace":"card_britain","Key":"card_event_hms_formidable_history","SourceString":"HMS Formidable was an Illustrious-class aircraft carrier of the British Royal Navy, commissioned in 1940. She was built with an armored flight deck designed to withstand heavy air attacks, which was a critical feature during the intense naval battles of WWII. HMS Formidable first saw action in the Mediterranean where it launched strikes against Italian targets and played a key role in the Battle of Cape Matapan in 1941. She later supported operations in the Pacific and Indian Oceans, including air raids against Japanese positions in Sumatra and the invasion of Okinawa. In May 1945, she was hit directly by a kamikaze attack, but thanks to her armored design, took only limited damage and was back in action within hours. Throughout the war, Formidable's aircraft flew thousands of sorties and provided vital support to Allied naval and ground forces. After the war, HMS Formidable was used to transport former POWs and military personnel across the British Empire. Her final troop transport mission concluded in February 1947. She was then decommissioned in 1953 and sold for scrap.","LocalizedString":"HMS Formidable was an Illustrious-class aircraft carrier of the British Royal Navy, commissioned in 1940. She was built with an armored flight deck designed to withstand heavy air attacks, which was a critical feature during the intense naval battles of WWII. HMS Formidable first saw action in the Mediterranean where it launched strikes against Italian targets and played a key role in the Battle of Cape Matapan in 1941. She later supported operations in the Pacific and Indian Oceans, including air raids against Japanese positions in Sumatra and the invasion of Okinawa. In May 1945, she was hit directly by a kamikaze attack, but thanks to her armored design, took only limited damage and was back in action within hours. Throughout the war, Formidable's aircraft flew thousands of sorties and provided vital support to Allied naval and ground forces. After the war, HMS Formidable was used to transport former POWs and military personnel across the British Empire. Her final troop transport mission concluded in February 1947. She was then decommissioned in 1953 and sold for scrap."},"rarity":"ERarityEnum::Rare","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::NavalWarfare","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Fight"],"soundEnterPlay":{"ObjectName":"SoundWave'Naval_Support_17'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Naval_Support_17.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/NavalWarfare/t_hms_formidable.t_hms_formidable","SubPathString":""},"artist":"Yoshiyuki Takani","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/HMS_FORMIDABLE.HMS_FORMIDABLE","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":360.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_event_hms_formidable_photo","SourceString":"An Albacore taking off HMS Formidable in 1942.","LocalizedString":"An Albacore taking off HMS Formidable in 1942."},"OnPlayedFromHandVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_OrderAmphibianAssault.BP_OrderAmphibianAssault_C","SubPathString":""}},"variables":[{"name":"tempCard","type":"UBaseCardObject*","direction":"in"},{"name":"cardsToFight","type":"TArray<UBaseCardObject*>","direction":"in"},{"name":"maximumFights","type":"int32","direction":"in"},{"name":"cardPicked","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"CanPlayFromHand","owner":"card_event_hms_formidable_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonPa