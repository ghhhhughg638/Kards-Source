{"format":"kards-original-reference","version":1,"id":"3b61619bf3a5dc87","name":"card_unit_short_sunderland","package":"/Game/Blueprints/Cards/Britain/Breakthrough/units/card_unit_short_sunderland","parent":"UBaseCardObject","card":{"title":"SUNDERLAND Mk V","text":"At the end of your turn, draw a random Navy card from your deck.","flavorText":"The Short Sunderland was a British flying boat patrol bomber, used in anti-shipping strikes and reconnaissance- and rescue missions, used by RAF and other Allied air forces during WWII. The aircraft played a vital role against German U-boats and in anti-shipping strikes during the Battle of the Atlantic, as well as being in high demand for convoy escort roles due to its ability to land on water and rescue crews from torpedo hit ships. Due to its excellent endurance and armament the Sunderland became notorious among German sea and air crews who gave it the nickname “Flying Porcupine”. The aircraft was produced from 1938 to 1946 and 749 of them were built, including a few variants.","faction":"Britain","type":"bomber","rarity":"Unique","cost":4,"operationCost":2,"attack":2,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_short_sunderland","title":{"Namespace":"card_britain","Key":"card_unit_short_sunderland_title","SourceString":"SUNDERLAND Mk V","LocalizedString":"SUNDERLAND Mk V"},"Type":"ETypeEnum::bomber","attack":2,"defense":5,"range":2,"faction":"EFactionEnum::Britain","kredits":4,"Text":{"Namespace":"card_britain","Key":"card_unit_short_sunderland_text","SourceString":"At the end of your turn, draw a random Navy card from your deck.","LocalizedString":"At the end of your turn, draw a random Navy card from your deck."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_short_sunderland_history","SourceString":"The Short Sunderland was a British flying boat patrol bomber, used in anti-shipping strikes and reconnaissance- and rescue missions, used by RAF and other Allied air forces during WWII. The aircraft played a vital role against German U-boats and in anti-shipping strikes during the Battle of the Atlantic, as well as being in high demand for convoy escort roles due to its ability to land on water and rescue crews from torpedo hit ships. Due to its excellent endurance and armament the Sunderland became notorious among German sea and air crews who gave it the nickname “Flying Porcupine”. The aircraft was produced from 1938 to 1946 and 749 of them were built, including a few variants.","LocalizedString":"The Short Sunderland was a British flying boat patrol bomber, used in anti-shipping strikes and reconnaissance- and rescue missions, used by RAF and other Allied air forces during WWII. The aircraft played a vital role against German U-boats and in anti-shipping strikes during the Battle of the Atlantic, as well as being in high demand for convoy escort roles due to its ability to land on water and rescue crews from torpedo hit ships. Due to its excellent endurance and armament the Sunderland became notorious among German sea and air crews who gave it the nickname “Flying Porcupine”. The aircraft was produced from 1938 to 1946 and 749 of them were built, including a few variants."},"operationCost":2,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::Breakthrough","returnSet":"ECardSetEnum::NavalWarfare","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Trigger"],"soundBlowUp":{"ObjectName":"SoundCue'au_aircraft_large'","ObjectPath":"kards/Content/Explosions_SFX/Cues/au_aircraft_large.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/Breakthrough/t_sunderland.t_sunderland","SubPathString":""},"artist":"Robert Taylor","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/SUNDERLAND.SUNDERLAND","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":272.0},"historyPhotoSource":"Imperial War Museum","historyPhotoIdentificationCode":"CH