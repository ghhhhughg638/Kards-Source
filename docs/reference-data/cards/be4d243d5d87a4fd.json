{"format":"kards-original-reference","version":1,"id":"be4d243d5d87a4fd","name":"card_unit_1er_marins_commandos","package":"/Game/Blueprints/Cards/France/units/card_unit_1er_marins_commandos","parent":"UBaseCardObject","card":{"title":"COMMANDOS KIEFFER","text":"Deal 1 damage to a random enemy when your HQ gains defense.","flavorText":"The 1er Bataillon de Fusiliers Marins Commandos, aka Commandos Kieffer, was a battalion sized commando unit that was formed in 1942 by the Free French Navy. The battalion was split into three troops, designated 1, 8 and 9. Members of Troop 1 took part in the Operation Jubilee, or the Dieppe Raid in 1942, and that same year they participated in a night raid on a bridge at Plouézec in France. In February 1944 they participated in the raid on the beach of Wassenaar in the Netherlands, which was the launch site of the German V-2 rockets. On 6 June 1944, D-Day, the battalion participated in the Normandy landings and disembarked on Sword Beach, and with No.4 Commando they supported the landings of the British 3rd Infantry Division. Despite heavy losses they managed to capture a 50 mm AT gun and a fortified artillery position. That same day the 1er Marins linked up with the British 6th Airborne Division at Pegasus Bridge (aka Bénouville Bridge) where more fighting took place. By the evening of 6 June the battalion had lost 25% of its men (27 KIA and many wounded), but they managed to hold their position. For the next couple of months Commandos Keiffer fought in Normandy, but in November 1944 they took part in the Allied landings on the island of Walcheren in the Netherlands where the city of Flessingue was captured. After WWII the unit was returned to French control and is still serving as part of the Naval Commandos of the French Navy.","faction":"France","type":"infantry","rarity":"Rare","cost":2,"operationCost":1,"attack":0,"defense":1},"defaults":{"UberGraphFrame":{},"GameplayTags":["subtype.commando"],"Name":"card_unit_1er_marins_commandos","title":{"Namespace":"card_france","Key":"card_unit_1er_marins_commandos_title","SourceString":"COMMANDOS KIEFFER","LocalizedString":"COMMANDOS KIEFFER"},"Type":"ETypeEnum::infantry","defense":1,"range":1,"faction":"EFactionEnum::France","kredits":2,"Text":{"Namespace":"card_france","Key":"card_unit_1er_marins_commandos_text","SourceString":"Deal 1 damage to a random enemy when your HQ gains defense.","LocalizedString":"Deal 1 damage to a random enemy when your HQ gains defense."},"flavorText":{"Namespace":"card_france","Key":"card_unit_1er_marins_commandos_history","SourceString":"The 1er Bataillon de Fusiliers Marins Commandos, aka Commandos Kieffer, was a battalion sized commando unit that was formed in 1942 by the Free French Navy. The battalion was split into three troops, designated 1, 8 and 9. Members of Troop 1 took part in the Operation Jubilee, or the Dieppe Raid in 1942, and that same year they participated in a night raid on a bridge at Plouézec in France. In February 1944 they participated in the raid on the beach of Wassenaar in the Netherlands, which was the launch site of the German V-2 rockets. On 6 June 1944, D-Day, the battalion participated in the Normandy landings and disembarked on Sword Beach, and with No.4 Commando they supported the landings of the British 3rd Infantry Division. Despite heavy losses they managed to capture a 50 mm AT gun and a fortified artillery position. That same day the 1er Marins linked up with the British 6th Airborne Division at Pegasus Bridge (aka Bénouville Bridge) where more fighting took place. By the evening of 6 June the battalion had lost 25% of its men (27 KIA and many wounded), but they managed to hold their position. For the next couple of months Commandos Keiffer fought in Normandy, but in November 1944 they took part in the Allied landings on the island of Walcheren in the Netherlands where the city of Flessingue was captured. After WWII the unit was returned to French control and is still serving as part of the Naval Commandos of the French Navy.","LocalizedString":"The 1er Bataillon de Fusiliers Marins Commandos, aka Commandos Kieffer, was a battalion sized commando unit that was formed in 1942 by the Free French Navy. The battalion was split into three troops, designated 1, 8 and 9. Members of Troop 1 took part in the Operation Jubilee, or the Dieppe Raid in 1942, and that same year they participated in a night raid on a bridge at Plouézec in France. In February 1944 they participated in the raid on the beach of Wassenaar in the Netherlands, which was the launch site of the German V-2 rockets. On 6 June 1944, D-Day, the battalion participated in the Normandy landings and disembarked on Sword Beach, and with No.4 Commando they supported the landings of the British 3rd Infantry Division. Despite heavy losses they managed to capture a 50 mm AT gun and a fortified artillery position. That same day the 1er Marins linked up with the British 6th Airborne Division at Pegasus Bridge (aka Bénouville Bridge) where more fighting took place. By the evening of 6 June the battalion had lost 25% of its men (27 KIA and many wounded), but they managed to hold their position. For the next couple of months Commandos Keiffer fought in Normandy, but in November 1944 they took part in the Allied landings on the island of Walcheren in the Netherlands where the city of Flessingue was captured. After WWII the unit was returned to French control and is still serving as part of the Naval Commandos of the French Navy."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::WorldAtWar","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnAfterOtherCardGainDefense"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Mobilize","EHelpBubbleTypes::Smokescreen"],"hasSmokescreen":true,"hasMobilize":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Small'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Small.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/France/t_marin_commando.t_marin_commando","SubPathString":""},"ImageAnchor":"EImageAnchor::Bot","artist":"French WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/KIEFER_COMMANDOS.KIEFER_COMMANDOS","SubPathString":""},"historyPhotoSize":{"X":507.0,"Y":512.0},"historyPhotoDescription":{"Namespace":"card_france","Key":"card_unit_1er_marins_commandos_photo","SourceString":"Philippe Kieffer, commanding officer of Commandos Kieffer with men of the 6th Airborne, D-Day 1944.","LocalizedString":"Philippe Kieffer, commanding officer of Commandos Kieffer with men of the 6th Airborne, D-Day 1944."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryS.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeLight_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeLight.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"threat_level":0.3},"variables":[{"name":"PossibleCards","type":"TArray<UBaseCardObject*>","direction":"in"},{"name":"cardInLoop","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_1er_marins_commandos","owner":"card_unit_1er_marins_commandos_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Array_IsNotEmpty_ReturnValue","type":"bool","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"K2Node_Event_cardGainingDefense","type":"UBaseCardObject*","direction":"in"},{"name":"K2Node_Event_defenseGained