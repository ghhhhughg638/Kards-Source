{"format":"kards-original-reference","version":1,"id":"c7bfa9cedd07884f","name":"card_unit_m13_40","package":"/Game/Blueprints/Cards/Italy/units/card_unit_m13_40","parent":"UBaseCardObject","card":{"title":"M13/40","text":"Deployment: Gains Blitz if you control an infantry.","flavorText":"The Carro Armato M13/40 was an Italian medium tank that was used during WWII. The tank was influenced by the British Vickers 6-tonne tank and its Italian predecessor the M11/39. It was used in 1940 in the Greek Campaign and in the North African Campaign in 1941. The tank lacked firepower and from 1942 the Italians deployed it alongside a Semovente 75/18 self-propelled gun in order to make up for it. The M13/40 had a crew of 4 (commander, driver, gunner, loader), a main armament of a 47 mm cannone da 47/32 AT gun and a secondary armament of 4 x 8 mm Breda mod. 38 machine guns.","faction":"Italy","type":"tank","rarity":"Uncommon","cost":3,"operationCost":1,"attack":3,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_m13_40","title":{"Namespace":"card_italy","Key":"card_unit_m13_40_title","SourceString":"M13/40","LocalizedString":"M13/40"},"Type":"ETypeEnum::tank","attack":3,"defense":4,"range":1,"faction":"EFactionEnum::Italy","kredits":3,"Text":{"Namespace":"card_italy","Key":"card_unit_m13_40_text","SourceString":"Deployment: Gains Blitz if you control an infantry.","LocalizedString":"Deployment: Gains Blitz if you control an infantry."},"flavorText":{"Namespace":"card_italy","Key":"card_unit_m13_40_history","SourceString":"The Carro Armato M13/40 was an Italian medium tank that was used during WWII. The tank was influenced by the British Vickers 6-tonne tank and its Italian predecessor the M11/39. It was used in 1940 in the Greek Campaign and in the North African Campaign in 1941. The tank lacked firepower and from 1942 the Italians deployed it alongside a Semovente 75/18 self-propelled gun in order to make up for it. The M13/40 had a crew of 4 (commander, driver, gunner, loader), a main armament of a 47 mm cannone da 47/32 AT gun and a secondary armament of 4 x 8 mm Breda mod. 38 machine guns.","LocalizedString":"The Carro Armato M13/40 was an Italian medium tank that was used during WWII. The tank was influenced by the British Vickers 6-tonne tank and its Italian predecessor the M11/39. It was used in 1940 in the Greek Campaign and in the North African Campaign in 1941. The tank lacked firepower and from 1942 the Italians deployed it alongside a Semovente 75/18 self-propelled gun in order to make up for it. The M13/40 had a crew of 4 (commander, driver, gunner, loader), a main armament of a 47 mm cannone da 47/32 AT gun and a secondary armament of 4 x 8 mm Breda mod. 38 machine guns."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Campaign2020","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment","EHelpBubbleTypes::Blitz"],"hasDeployment":true,"soundEnterPlay":{"ObjectName":"SoundWave'Tank_Light_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Light_Move_Fx.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Tank_Light_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Light_Move_Fx.0"},"soundAttack":{"ObjectName":"SoundWave'Medium_Tank_Attack_Straight'","ObjectPath":"kards/Content/Assets/Audio/Units/Medium_Tank_Attack_Straight.0"},"soundBlowUp":{"ObjectName":"SoundWave'Explosion02'","ObjectPath":"kards/Content/StarterContent/Audio/Explosion02.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Italy/t_m13_40_pentland.t_m13_40_pentland","SubPathString":""},"artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/M13-40.M13-40","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":327.0},"historyPhotoSource":"German Federal Archives","historyPhotoIdentificationCode":"Bild 101I-783-0104-38","historyPhotoAuthor":"Moosmüller","historyPhotoDescription":{"Namespace":"card_italy","Key":"card_unit_m13_40