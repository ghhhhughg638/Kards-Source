{"format":"kards-original-reference","version":1,"id":"c2dfe3e54e6b77fc","name":"card_event_zhukov","package":"/Game/Blueprints/Cards/Soviet/Base/events/card_event_zhukov","parent":"UBaseCardObject","card":{"title":"ZHUKOV","text":"Draw a random Soviet infantry. It gets +1+1 and Blitz when deployed.","flavorText":"Georgy Konstantinovich Zhukov (1896 –1974) was a Soviet Red Army General who became Chief of General Staff, Deputy Commander-in-Chief, Minister of Defense and a member of the Politburo (Political Bureau of the Central Committee of the Communist Party of the Soviet Union). He participated in multiple battles and ended up being commander at the 1st Belorussian Front in the Battle of Berlin, which resulted in the defeat of Germany. Zhukov received multiple decorations and was awarded the Hero of the Soviet Union four times. There is controversy about his legacy as a military commander, but in the end he was a winning general and it is claimed that he never lost a battle.","faction":"Soviet","type":"order","rarity":"Unique","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_zhukov","title":{"Namespace":"card_soviet","Key":"card_event_zhukov_title","SourceString":"ZHUKOV","LocalizedString":"ZHUKOV"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Soviet","kredits":1,"Text":{"Namespace":"card_soviet","Key":"card_event_zhukov_text","SourceString":"Draw a random Soviet infantry. It gets +1+1 and Blitz when deployed.","LocalizedString":"Draw a random Soviet infantry. It gets +1+1 and Blitz when deployed."},"flavorText":{"Namespace":"card_soviet","Key":"card_event_zhukov_history","SourceString":"Georgy Konstantinovich Zhukov (1896 –1974) was a Soviet Red Army General who became Chief of General Staff, Deputy Commander-in-Chief, Minister of Defense and a member of the Politburo (Political Bureau of the Central Committee of the Communist Party of the Soviet Union). He participated in multiple battles and ended up being commander at the 1st Belorussian Front in the Battle of Berlin, which resulted in the defeat of Germany. Zhukov received multiple decorations and was awarded the Hero of the Soviet Union four times. There is controversy about his legacy as a military commander, but in the end he was a winning general and it is claimed that he never lost a battle.","LocalizedString":"Georgy Konstantinovich Zhukov (1896 –1974) was a Soviet Red Army General who became Chief of General Staff, Deputy Commander-in-Chief, Minister of Defense and a member of the Politburo (Political Bureau of the Central Committee of the Communist Party of the Soviet Union). He participated in multiple battles and ended up being commander at the 1st Belorussian Front in the Battle of Berlin, which resulted in the defeat of Germany. Zhukov received multiple decorations and was awarded the Hero of the Soviet Union four times. There is controversy about his legacy as a military commander, but in the end he was a winning general and it is claimed that he never lost a battle."},"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::Basic","isInPermanentPool":true,"usedTriggers":["ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"soundEnterPlay":{"ObjectName":"SoundWave'Order_227'","ObjectPath":"kards/Content/Assets/Audio/Misc/OrdersFeb17/Order_227.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/t_zhukov.t_zhukov","SubPathString":""},"artist":" Heritage Image Partnership Ltd / Alamy Stock Photo","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/ZHUKOV.ZHUKOV","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":395.0},"historyPhotoSource":"https://ww2db.com","historyPhotoAuthor":"Yakov Ryumkin","historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_event_zhukov_photo","SourceString":"Georgy Zhukov in a parade, date unkown.","LocalizedString":"Georgy Zhukov in a parade, date unkown."},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_At