{"format":"kards-original-reference","version":1,"id":"9d1e1dbfddddb8a0","name":"card_unit_spitfire_mk_iia","package":"/Game/Blueprints/Cards/Britain/WorldAtWar/units/card_unit_spitfire_mk_iia","parent":"UBaseCardObject","card":{"title":"SPITFIRE Mk IIa","text":"Deployment: Gets +2+2 if your enemy controls an air unit. Gets Fury if not.","flavorText":"The Spitfire Mk II variant was a modification of the Mk I and came with factory fitted armour and a Merlin Mk XII powerplant that made it more powerful and faster than its predecessor. The Mk IIa was fitted with eight .303 Browning machine guns and the Mk IIb was fitted with four .303 Brownings and twin 20mm Hispano cannons. Some early Mk II’s were used in the Battle of Britain in 1940, but most were used during the Allied offensive in Europe, until superseded by the Mk V. A total of 921 Mk II’s were built, some were converted into MK V’s and 50 of them were converted for air-sea rescue work.","faction":"Britain","type":"fighter","rarity":"Unique","cost":4,"operationCost":2,"attack":4,"defense":4},"defaults":{"UberGraphFrame":{},"GameplayTags":["subtype.spitfire"],"Name":"card_unit_spitfire_mk_iia","title":{"Namespace":"card_britain","Key":"card_unit_spitfire_mk_iia_title","SourceString":"SPITFIRE Mk IIa","LocalizedString":"SPITFIRE Mk IIa"},"Type":"ETypeEnum::fighter","attack":4,"defense":4,"range":2,"faction":"EFactionEnum::Britain","kredits":4,"Text":{"Namespace":"card_britain","Key":"card_unit_spitfire_mk_iia_text","SourceString":"Deployment: Gets +2+2 if your enemy controls an air unit. Gets Fury if not.","LocalizedString":"Deployment: Gets +2+2 if your enemy controls an air unit. Gets Fury if not."},"flavorText":{"Namespace":"card_britain","Key":"card_unit_spitfire_mk_iia_history","SourceString":"The Spitfire Mk II variant was a modification of the Mk I and came with factory fitted armour and a Merlin Mk XII powerplant that made it more powerful and faster than its predecessor. The Mk IIa was fitted with eight .303 Browning machine guns and the Mk IIb was fitted with four .303 Brownings and twin 20mm Hispano cannons. Some early Mk II’s were used in the Battle of Britain in 1940, but most were used during the Allied offensive in Europe, until superseded by the Mk V. A total of 921 Mk II’s were built, some were converted into MK V’s and 50 of them were converted for air-sea rescue work.","LocalizedString":"The Spitfire Mk II variant was a modification of the Mk I and came with factory fitted armour and a Merlin Mk XII powerplant that made it more powerful and faster than its predecessor. The Mk IIa was fitted with eight .303 Browning machine guns and the Mk IIb was fitted with four .303 Brownings and twin 20mm Hispano cannons. Some early Mk II’s were used in the Battle of Britain in 1940, but most were used during the Allied offensive in Europe, until superseded by the Mk V. A total of 921 Mk II’s were built, some were converted into MK V’s and 50 of them were converted for air-sea rescue work."},"operationCost":2,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::WorldAtWar","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Deployment","EHelpBubbleTypes::Fury"],"hasDeployment":true,"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/CandidateArtwork/t_spitfire_IIa.t_spitfire_IIa","SubPathString":""},"artist":"Nicolas Trudgian","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/SPITFIRE_Mk_IIA.SPITFIRE_Mk_IIA","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":314.0},"historyPhotoDescription":{"Namespace":"card_britain","Key":"card_unit_spitfire_mk_iia_photo","SourceString":"Supermarine Spitfire Mk IIa aircraft in flight, 1942.","LocalizedString":"Supermarine Spitfire Mk IIa aircraft in flight, 1942."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'",