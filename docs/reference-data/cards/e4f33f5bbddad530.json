{"format":"kards-original-reference","version":1,"id":"e4f33f5bbddad530","name":"card_event_mikura","package":"/Game/Blueprints/Cards/Japan/NavalWarfare/events/card_event_mikura","parent":"UBaseCardObject","card":{"title":"IJN MIKURA","text":"Pin target unit. At the end of turn, draw an IJN MIKURA from your deck.","flavorText":"The Mikura was the lead ship of the Mikura-class escort ships used by the Imperial Japanese Navy during WWII. She was launched in 1943 and designed for convoy escort and anti-submarine warfare. The Mikura was armed with depth charges, anti-aircraft guns and sonar equipment, and with her sister ships she was part of Japan’s effort to defend vital shipping lanes. She mainly operated around Japan and the East China Sea where she escorted supply convoys and hunted Allied submarines. Mikura was involved in several anti-submarine actions, claiming some successes, though records on confirmed kills are unclear. Like many Japanese escorts, she often faced overwhelming American submarine and air attacks, and on March 28, 1945, Mikura was sunk by US aircraft south of the Japanese Island Kyushu. Overall, Mikura was part of Japan’s late-war attempt to improve convoy protection, but despite her design and purpose, she operated under increasingly difficult conditions with limited impact on the overall course of the war.","faction":"Japan","type":"order","rarity":"Common","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"GameplayTags":["subtype.navy"],"Name":"card_event_mikura","title":{"Namespace":"card_japan","Key":"card_event_mikura_title","SourceString":"IJN MIKURA","LocalizedString":"IJN MIKURA"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Japan","kredits":1,"Text":{"Namespace":"card_japan","Key":"card_event_mikura_text","SourceString":"Pin target unit. At the end of turn, draw an IJN MIKURA from your deck.","LocalizedString":"Pin target unit. At the end of turn, draw an IJN MIKURA from your deck."},"flavorText":{"Namespace":"card_japan","Key":"card_event_mikura_history","SourceString":"The Mikura was the lead ship of the Mikura-class escort ships used by the Imperial Japanese Navy during WWII. She was launched in 1943 and designed for convoy escort and anti-submarine warfare. The Mikura was armed with depth charges, anti-aircraft guns and sonar equipment, and with her sister ships she was part of Japan’s effort to defend vital shipping lanes. She mainly operated around Japan and the East China Sea where she escorted supply convoys and hunted Allied submarines. Mikura was involved in several anti-submarine actions, claiming some successes, though records on confirmed kills are unclear. Like many Japanese escorts, she often faced overwhelming American submarine and air attacks, and on March 28, 1945, Mikura was sunk by US aircraft south of the Japanese Island Kyushu. Overall, Mikura was part of Japan’s late-war attempt to improve convoy protection, but despite her design and purpose, she operated under increasingly difficult conditions with limited impact on the overall course of the war.","LocalizedString":"The Mikura was the lead ship of the Mikura-class escort ships used by the Imperial Japanese Navy during WWII. She was launched in 1943 and designed for convoy escort and anti-submarine warfare. The Mikura was armed with depth charges, anti-aircraft guns and sonar equipment, and with her sister ships she was part of Japan’s effort to defend vital shipping lanes. She mainly operated around Japan and the East China Sea where she escorted supply convoys and hunted Allied submarines. Mikura was involved in several anti-submarine actions, claiming some successes, though records on confirmed kills are unclear. Like many Japanese escorts, she often faced overwhelming American submarine and air attacks, and on March 28, 1945, Mikura was sunk by US aircraft south of the Japanese Island Kyushu. Overall, Mikura was part of Japan’s late-war attempt to improve convoy protection, but despite her design and purpose, she operated under increasingly difficult conditions with limited impact on the overall course of the war."},"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::NavalWarfare","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Pin"],"draftBaseWeight":1.1,"soundEnterPlay":{"ObjectName":"SoundWave'War_UI_Drum_Movement_Taiko_Hits_2'","ObjectPath":"kards/Content/War_UI/Waves/Drum_Movements/War_UI_Drum_Movement_Taiko_Hits_2.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/NavalWarfare/t_mikura.t_mikura","SubPathString":""},"artist":"Pit-Road","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/IJN_MIKURA.IJN_MIKURA","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":258.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_event_mikura_photo","SourceString":"IJN Mikura in 1943.","LocalizedString":"IJN Mikura in 1943."},"isDraw":true,"isDefenseBuff":true},"variables":[{"name":"mikuraFound","type":"bool","direction":"in"},{"name":"mikuraCardid","type":"TArray<UBaseCardObject*>","direction":"in"}],"functions":[{"name":"CanPlayFromHand","owner":"card_event_mikura_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","direction":"out"},{"name":"reasonParam1","type":"FString","direction":"out"},{"name":"reasonParam2","type":"FString","direction":"out"},{"name":"targetedCard","type":"UBaseCardObject*","direction":"out"}],"pure":false,"event":true,"flags":"FUNC_Event | FUNC_Public | FUNC_HasOutParms | FUNC_BlueprintCallable | FUNC_BlueprintEvent","locals":[{"name":"CallFunc_GetTargetedCard_hasTarget","type":"bool","direction":"in"},{"name":"CallFunc_GetTargetedCard_card","type":"UBaseCardObject*","direction":"in"},{"name":"CallFunc_IsUnit_isIt","type":"bool","direction":"in"}],"body":[{"op":"Context","at":0,"object":{"op":"Variable","name":"cardFunction","type":"ACar