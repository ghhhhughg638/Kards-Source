{"format":"kards-original-reference","version":1,"id":"f46ffdd7ccfb0bd2","name":"card_unit_list_regiment","package":"/Game/Blueprints/Cards/Germany/BrothersInArms/units/card_unit_list_regiment","parent":"UBaseCardObject","card":{"title":"LIST REGIMENT","text":"Deployment: If you control the frontline, target enemy unit must retreat.","flavorText":"The 19th Grenadier Regiment, given the honorific title “Infanterie-Regiment List '' in 1944, was an infantry regiment of the 7th Infantry Division of the Wehrmacht during WWII. In 1938, the 7th Division participated in the occupation of Austria. During the 1939 Polish Campaign, it fought under XVII Army Corps, engaging Polish forces and advancing eastwards. In the French campaign of 1940, the division served as a diversionary force against the French and British. It fought against the British Expeditionary Force and took up positions on the eastern section of the German lines near Lille. After the Dunkirk Pocket was eliminated, the division was placed in reserve. During Operation Barbarossa, the division fought in the siege of Mogilev and participated in the unsuccessful thrust towards Moscow in December 1941. It spent 1942 in the central sector of the Eastern Front and joined the Kursk offensive in July 1943. In 1944, it conducted a fighting retreat through Poland to the Vistula line. In January 1945, it found itself isolated on the Hela peninsula and surrendered to the Allied forces on May 8, 1945.","faction":"Germany","type":"infantry","rarity":"Uncommon","cost":5,"operationCost":1,"attack":5,"defense":6},"defaults":{"UberGraphFrame":{},"Name":"card_unit_list_regiment","title":{"Namespace":"card_germany","Key":"card_unit_list_regiment_title","SourceString":"LIST REGIMENT","LocalizedString":"LIST REGIMENT"},"Type":"ETypeEnum::infantry","attack":5,"defense":6,"range":1,"faction":"EFactionEnum::Germany","kredits":5,"Text":{"Namespace":"card_germany","Key":"card_unit_list_regiment_text","SourceString":"Deployment: If you control the frontline, target enemy unit must retreat.","LocalizedString":"Deployment: If you control the frontline, target enemy unit must retreat."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_list_regiment_history","SourceString":"The 19th Grenadier Regiment, given the honorific title “Infanterie-Regiment List '' in 1944, was an infantry regiment of the 7th Infantry Division of the Wehrmacht during WWII. In 1938, the 7th Division participated in the occupation of Austria. During the 1939 Polish Campaign, it fought under XVII Army Corps, engaging Polish forces and advancing eastwards. In the French campaign of 1940, the division served as a diversionary force against the French and British. It fought against the British Expeditionary Force and took up positions on the eastern section of the German lines near Lille. After the Dunkirk Pocket was eliminated, the division was placed in reserve. During Operation Barbarossa, the division fought in the siege of Mogilev and participated in the unsuccessful thrust towards Moscow in December 1941. It spent 1942 in the central sector of the Eastern Front and joined the Kursk offensive in July 1943. In 1944, it conducted a fighting retreat through Poland to the Vistula line. In January 1945, it found itself isolated on the Hela peninsula and surrendered to the Allied forces on May 8, 1945.","LocalizedString":"The 19th Grenadier Regiment, given the honorific title “Infanterie-Regiment List '' in 1944, was an infantry regiment of the 7th Infantry Division of the Wehrmacht during WWII. In 1938, the 7th Division participated in the occupation of Austria. During the 1939 Polish Campaign, it fought under XVII Army Corps, engaging Polish forces and advancing eastwards. In the French campaign of 1940, the division served as a diversionary force against the French and British. It fought against the British Expeditionary Force and took up positions on the eastern section of the German lines near Lille. After the Dunkirk Pocket was eliminated, the division was placed in reserve. During Operation Barbarossa, the division fought in the siege of Mogilev and participated in the unsuccessful thrust towards Moscow in December 1941. It spent 1942 in the central sector of the Eastern Front and joined the Kursk offensive in July 1943. In 1944, it conducted a fighting retreat through Poland to the Vistula line. In January 1945, it found itself isolated on the Hela peninsula and surrendered to the Allied forces on May 8, 1945."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::BrothersInArms","isReserved":true,"usedTriggers":["ERegisteredCardFunction::OnOtherCardDealDamageAddDamage"],"draftBaseWeight":0.9,"hasDeployment":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion02'","ObjectPath":"kards/Content/StarterContent/Audio/Explosion02.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/Spring2023Candidates/t_wehrmacht_soldat.t_wehrmacht_soldat","SubPathString":""},"ImageAnchor":"EImageAnchor::Top","artist":"German WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/LIST_REGIMENT.LIST_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":355.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_list_regiment_photo","SourceString":"German machine-gun during the advance to Mogilev. Belarus, July 1941.","LocalizedString":"German machine-gun during the advance to Mogilev. Belarus, July 1941."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""}},"variables":[],"functions":[{"n