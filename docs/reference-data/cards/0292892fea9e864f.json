{"format":"kards-original-reference","version":1,"id":"0292892fea9e864f","name":"card_unit_gifu_regiment","package":"/Game/Blueprints/Cards/Japan/NavalWarfare/units/card_unit_gifu_regiment","parent":"UBaseCardObject","card":{"title":"GIFU REGIMENT","text":"Once per turn, gains Shock and you draw a card when you play a Navy card.","flavorText":"The 136th Mixed Regiment (Gifu) was part of the 43rd Division of the Imperial Japanese Army, formed in June 1943. In April 1944, the division was reorganized into a marine (mixed) division and assigned to the 31st Army. The division departed from Tateyama, in Chiba Prefecture, on May 14, 1944, and arrived in Saipan on May 19, 1944. Upon arrival, approximately 9,000 troops and 13 artillery pieces of the 43rd Division fortified positions around Mount Tapochau. They managed to add a line of trenches to existing defenses before the US invasion fleet arrived on June 13, 1944. The Battle of Saipan started the next day. The 43rd Division, alongside the 9th Armored Regiment of the 1st Tank Division, launched a counterattack and temporarily recaptured high ground around Hinashita Hill. However, US forces regained these positions shortly after. After weeks of fighting the division was reduced to four infantry battalions and a half battalion of artillery. After being denied evacuation and reinforcements the division faced imminent defeat. With approximately 4,000 men remaining, many already wounded, their commander decided to lead a final banzai charge on July 7. This assault resulted in the annihilation of the 43rd Division.","faction":"Japan","type":"infantry","rarity":"Common","cost":4,"operationCost":1,"attack":4,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_gifu_regiment","title":{"Namespace":"card_japan","Key":"card_unit_gifu_regiment_title","SourceString":"GIFU REGIMENT","LocalizedString":"GIFU REGIMENT"},"Type":"ETypeEnum::infantry","attack":4,"defense":5,"range":1,"faction":"EFactionEnum::Japan","kredits":4,"Text":{"Namespace":"card_japan","Key":"card_unit_gifu_regiment_text","SourceString":"Once per turn, gains Shock and you draw a card when you play a Navy card.","LocalizedString":"Once per turn, gains Shock and you draw a card when you play a Navy card."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_gifu_regiment_history","SourceString":"The 136th Mixed Regiment (Gifu) was part of the 43rd Division of the Imperial Japanese Army, formed in June 1943. In April 1944, the division was reorganized into a marine (mixed) division and assigned to the 31st Army. The division departed from Tateyama, in Chiba Prefecture, on May 14, 1944, and arrived in Saipan on May 19, 1944. Upon arrival, approximately 9,000 troops and 13 artillery pieces of the 43rd Division fortified positions around Mount Tapochau. They managed to add a line of trenches to existing defenses before the US invasion fleet arrived on June 13, 1944. The Battle of Saipan started the next day. The 43rd Division, alongside the 9th Armored Regiment of the 1st Tank Division, launched a counterattack and temporarily recaptured high ground around Hinashita Hill. However, US forces regained these positions shortly after. After weeks of fighting the division was reduced to four infantry battalions and a half battalion of artillery. After being denied evacuation and reinforcements the division faced imminent defeat. With approximately 4,000 men remaining, many already wounded, their commander decided to lead a final banzai charge on July 7. This assault resulted in the annihilation of the 43rd Division.","LocalizedString":"The 136th Mixed Regiment (Gifu) was part of the 43rd Division of the Imperial Japanese Army, formed in June 1943. In April 1944, the division was reorganized into a marine (mixed) division and assigned to the 31st Army. The division departed from Tateyama, in Chiba Prefecture, on May 14, 1944, and arrived in Saipan on May 19, 1944. Upon arrival, approximately 9,000 troops and 13 artillery pieces of the 43rd Division fortified positions around Mount Tapochau. They managed to add a line of trenches to existing defenses before the US invasion fleet arrived on June 13, 1944. The Battle of Saipan started the next day. The 43rd Division, alongside the 9th Armored Regiment of the 1st Tank Division, launched a counterattack and temporarily recaptured high ground around Hinashita Hill. However, US forces regained these positions shortly after. After weeks of fighting the division was reduced to four infantry battalions and a half battalion of artillery. After being denied evacuation and reinforcements the division faced imminent defeat. With approximately 4,000 men remaining, many already wounded, their commander decided to lead a final banzai charge on July 7. This assault resulted in the annihilation of the 43rd Division."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::NavalWarfare","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn","ERegisteredCardFunction::OnOtherCardPlayedFromHand","ERegisteredCardFunction::OnBeforeOtherCardPlayedFromHand","ERegisteredCardFunction::OnCounterMeasureTriggered"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Trigger","EHelpBubbleTypes::Shock"],"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/NavalWarfare/t_gifu_regiment.t_gifu_regiment","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/GIFU_REGIMENT02.GIFU_REGIMENT02","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":406.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_gifu_regiment_photo","SourceString":"Japanese soldiers at attention. Date unknown.","LocalizedString":"Japanese soldiers at attention. Date unknown."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"Blueprin