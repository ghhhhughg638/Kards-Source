{"format":"kards-original-reference","version":1,"id":"db3bf72554c8f5a3","name":"card_unit_ii_rmt","package":"/Game/Blueprints/Cards/France/units/card_unit_ii_rmt","parent":"UBaseCardObject","card":{"title":"2e RMT","text":"At the start of your turn, each non-French unit you control gets +1+1.","flavorText":"The 2e RMT, or Régiment de marche du Tchad, was a mechanized unit of the French Army who joined the WWII Allies in their fight against the Axis forces in North Africa. The regiment had approximately 1,200 personnel and was organized into 9 companies during the war. The regiment fought in several campaigns in North Africa and Europe, and continued to fight until Germany surrendered in 1945. The RMT participated in the Liberation of Paris and was the first Allied unit to reach Hitler’s Eagle Nest in the German Alps. The regiment received several decorations after the war for its exemplary performance.","faction":"France","type":"infantry","rarity":"Rare","cost":5,"operationCost":3,"attack":2,"defense":7},"defaults":{"UberGraphFrame":{},"Name":"card_unit_ii_rmt","title":{"Namespace":"card_france","Key":"card_unit_ii_rmt_title","SourceString":"2e RMT","LocalizedString":"2e RMT"},"Type":"ETypeEnum::infantry","attack":2,"defense":7,"range":1,"faction":"EFactionEnum::France","kredits":5,"Text":{"Namespace":"card_france","Key":"card_unit_ii_rmt_text","SourceString":"At the start of your turn, each non-French unit you control gets +1+1.","LocalizedString":"At the start of your turn, each non-French unit you control gets +1+1."},"flavorText":{"Namespace":"card_france","Key":"card_unit_ii_rmt_history","SourceString":"The 2e RMT, or Régiment de marche du Tchad, was a mechanized unit of the French Army who joined the WWII Allies in their fight against the Axis forces in North Africa. The regiment had approximately 1,200 personnel and was organized into 9 companies during the war. The regiment fought in several campaigns in North Africa and Europe, and continued to fight until Germany surrendered in 1945. The RMT participated in the Liberation of Paris and was the first Allied unit to reach Hitler’s Eagle Nest in the German Alps. The regiment received several decorations after the war for its exemplary performance.","LocalizedString":"The 2e RMT, or Régiment de marche du Tchad, was a mechanized unit of the French Army who joined the WWII Allies in their fight against the Axis forces in North Africa. The regiment had approximately 1,200 personnel and was organized into 9 companies during the war. The regiment fought in several campaigns in North Africa and Europe, and continued to fight until Germany surrendered in 1945. The RMT participated in the Liberation of Paris and was the first Allied unit to reach Hitler’s Eagle Nest in the German Alps. The regiment received several decorations after the war for its exemplary performance."},"operationCost":3,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::Expansion2019","isInPermanentPool":true,"showBoostIcon":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"hasGuard":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/France/t_french_infantry_pentland.t_french_infantry_pentland","SubPathString":""},"artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/IIéme_RMT.IIéme_RMT","SubPathString":""},"historyPhotoSize":{"X":362.0,"Y":512.0},"historyPhotoSource":"https://i.pinimg.com/","historyPhotoDescription":{"Namespace":"card_france","Key":"card_unit_ii_rmt_photo","SourceString":"Surrendered SS officer and a French soldier from the Régiment de Marche du Tchad, ca. 1944-45.","LocalizedString":"Surrendered SS officer and a French soldier from the Régiment de Marche du Tchad, ca. 1944-45."},"historyTypeDescription":{"Namespace":"card_france","Key":"card_unit_ii_rmt_hea