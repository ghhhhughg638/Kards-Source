{"format":"kards-original-reference","version":1,"id":"ecea60657abbb113","name":"card_unit_3_fallschirmjager","package":"/Game/Blueprints/Cards/Germany/Base/units/card_unit_3_fallschirmjager","parent":"UBaseCardObject","card":{"title":"3. FALLSCHIRMJÄGER","text":"At the start of your turn, gets +1 attack for each tank in the same line.","flavorText":"The 3. Fallschirmjager Regiment was formed in 1940 as part of the 1st Parachute Division, initially named 7th Air Division for secrecy. It took part in the invasion of Crete in 1941 and later that year was sent to the eastern front, seeing heavy combat near Leningrad, Vitebsk and Smolensk over the next couple of years. In 1943 it was sent to Sicily to defend against the Allied invasion of the island and spent the remainder of the war slowly retreating up the Italian peninsula from one defensive position to another.","faction":"Germany","type":"infantry","rarity":"Uncommon","cost":2,"operationCost":1,"attack":2,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_3_fallschirmjager","title":{"Namespace":"card_germany","Key":"card_unit_3_fallschirmjager_title","SourceString":"3. FALLSCHIRMJÄGER","LocalizedString":"3. FALLSCHIRMJÄGER"},"Type":"ETypeEnum::infantry","attack":2,"defense":2,"range":1,"faction":"EFactionEnum::Germany","kredits":2,"Text":{"Namespace":"card_germany","Key":"card_unit_3_fallschirmjager_text","SourceString":"At the start of your turn, gets +1 attack for each tank in the same line.","LocalizedString":"At the start of your turn, gets +1 attack for each tank in the same line."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_3_fallschirmjager_history","SourceString":"The 3. Fallschirmjager Regiment was formed in 1940 as part of the 1st Parachute Division, initially named 7th Air Division for secrecy. It took part in the invasion of Crete in 1941 and later that year was sent to the eastern front, seeing heavy combat near Leningrad, Vitebsk and Smolensk over the next couple of years. In 1943 it was sent to Sicily to defend against the Allied invasion of the island and spent the remainder of the war slowly retreating up the Italian peninsula from one defensive position to another.","LocalizedString":"The 3. Fallschirmjager Regiment was formed in 1940 as part of the 1st Parachute Division, initially named 7th Air Division for secrecy. It took part in the invasion of Crete in 1941 and later that year was sent to the eastern front, seeing heavy combat near Leningrad, Vitebsk and Smolensk over the next couple of years. In 1943 it was sent to Sicily to defend against the Allied invasion of the island and spent the remainder of the war slowly retreating up the Italian peninsula from one defensive position to another."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Basic","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnStartofTurn"],"hasBlitz":true,"soundBlowUp":{"ObjectName":"SoundWave'Explosion02'","ObjectPath":"kards/Content/StarterContent/Audio/Explosion02.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/t_german_paratroopers.t_german_paratroopers","SubPathString":""},"ImageAnchor":"EImageAnchor::Bot","artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/3_paratroopers.3_paratroopers","SubPathString":""},"historyPhotoSize":{"X":900.0,"Y":612.0},"historyPhotoSource":"wikipedia.org","historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_3_fallschirmjager_photo","SourceString":"Paratroopers of the 3. Fallschirmjager Regiment in Sicily, August 1943.","LocalizedString":"Paratroopers of the 3. Fallschirmjager Regiment in Sicily, August 1943."},"historyTypeDescription":{"Namespace":"card_germany","Key":"card_unit_3_fallschirmjager_header","SourceString":"Infantry","LocalizedString":"Infantry"},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryS'","ObjectPath":"kards/Content