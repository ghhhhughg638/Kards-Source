{"format":"kards-original-reference","version":1,"id":"3350603b58adaed0","name":"card_unit_57mm_m1943","package":"/Game/Blueprints/Cards/Soviet/Breakthrough/units/card_unit_57mm_m1943","parent":"UBaseCardObject","card":{"title":"ZiS-2","text":"Pincer: Blitz.","flavorText":"The Zis-2 was a 57mm Soviet anti-tank gun that was produced and used during WWII. ZiS stood for Zavod imeni Stalina (e. Factory named after Stalin), but the name of the factory which produced the gun was “Joseph Stalin Factory No. 92”. Production started in 1941 but was halted that same year with the explanation that it was too powerful as it penetrated weak German armor from one side to the other without doing internal damage. Another more plausible explanation was that the gun was too expensive to produce. However, when the German heavy Tiger and Panther tanks started to appear on the battlefield in 1942-43 a more powerful gun was needed and the production of ZiS-2 was started again. By the end of the war over 10,000 ZiS-2 guns had been produced.","faction":"Soviet","type":"artillery","rarity":"Uncommon","cost":4,"operationCost":1,"attack":2,"defense":2},"defaults":{"UberGraphFrame":{},"Name":"card_unit_57mm_m1943","title":{"Namespace":"card_soviet","Key":"card_unit_57mm_m1943_title","SourceString":"ZiS-2","LocalizedString":"ZiS-2"},"Type":"ETypeEnum::artillery","attack":2,"defense":2,"range":2,"faction":"EFactionEnum::Soviet","kredits":4,"Text":{"Namespace":"card_soviet","Key":"card_unit_57mm_m1943_text","SourceString":"Pincer: Blitz.","LocalizedString":"Pincer: Blitz."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_57mm_m1943_history","SourceString":"The Zis-2 was a 57mm Soviet anti-tank gun that was produced and used during WWII. ZiS stood for Zavod imeni Stalina (e. Factory named after Stalin), but the name of the factory which produced the gun was “Joseph Stalin Factory No. 92”. Production started in 1941 but was halted that same year with the explanation that it was too powerful as it penetrated weak German armor from one side to the other without doing internal damage. Another more plausible explanation was that the gun was too expensive to produce. However, when the German heavy Tiger and Panther tanks started to appear on the battlefield in 1942-43 a more powerful gun was needed and the production of ZiS-2 was started again. By the end of the war over 10,000 ZiS-2 guns had been produced.","LocalizedString":"The Zis-2 was a 57mm Soviet anti-tank gun that was produced and used during WWII. ZiS stood for Zavod imeni Stalina (e. Factory named after Stalin), but the name of the factory which produced the gun was “Joseph Stalin Factory No. 92”. Production started in 1941 but was halted that same year with the explanation that it was too powerful as it penetrated weak German armor from one side to the other without doing internal damage. Another more plausible explanation was that the gun was too expensive to produce. However, when the German heavy Tiger and Panther tanks started to appear on the battlefield in 1942-43 a more powerful gun was needed and the production of ZiS-2 was started again. By the end of the war over 10,000 ZiS-2 guns had been produced."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::Breakthrough","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Pincer","EHelpBubbleTypes::Blitz"],"hasPincer":true,"soundEnterPlay":{"ObjectName":"SoundWave'Artillery_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Artillery_Move_FX.0"},"soundMoveToFrontline":{"ObjectName":"SoundWave'Artillery_Move_FX'","ObjectPath":"kards/Content/Assets/Audio/Units/Artillery_Move_FX.0"},"soundBlowUp":{"ObjectName":"SoundWave'Explosion_Medium'","ObjectPath":"kards/Content/Assets/Audio/Misc/Explosion_Medium.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/WE_Candidates/t_zis_2.t_zis_2","SubPathString":""},"ImageAnchor":"EImageAnchor::Bot