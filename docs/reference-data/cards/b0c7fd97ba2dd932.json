{"format":"kards-original-reference","version":1,"id":"b0c7fd97ba2dd932","name":"card_event_kangaroo_transport","package":"/Game/Blueprints/Cards/Britain/BloodIron/events/card_event_kangaroo_transport","parent":"UBaseCardObject","card":{"title":"KANGAROO TRANSPORT","text":"Give a British infantry Blitz and +1 Heavy Armor.","flavorText":"The Kangaroo was an improvised Canadian armored personnel carrier (APC) which was created by converting a tank chassis. It was so successful that it was widely used by British and Commonwealth forces during WWII. It was developed in 1944 to improve infantry mobility and protection during assaults, particularly following the heavy casualties suffered in Normandy. The Kangaroo was originally converted from obsolete or damaged tanks, such as Canadian Ram tanks and M7 Priest self-propelled guns, and offered a new way to transport infantry safely across battlefields by providing shielding from small arms fire and shell fragments. Kangaroos played a crucial role in operations in Europe, where they helped troops advance alongside tanks.","faction":"Britain","type":"order","rarity":"Common","cost":1,"operationCost":0,"attack":0,"defense":0},"defaults":{"UberGraphFrame":{},"Name":"card_event_kangaroo_transport","title":{"Namespace":"card_britain","Key":"card_event_kangaroo_transport_title","SourceString":"KANGAROO TRANSPORT","LocalizedString":"KANGAROO TRANSPORT"},"Type":"ETypeEnum::order","faction":"EFactionEnum::Britain","kredits":1,"Text":{"Namespace":"card_britain","Key":"card_event_kangaroo_transport_text","SourceString":"Give a British infantry Blitz and +1 Heavy Armor.","LocalizedString":"Give a British infantry Blitz and +1 Heavy Armor."},"flavorText":{"Namespace":"card_britain","Key":"card_event_kangaroo_transport_history","SourceString":"The Kangaroo was an improvised Canadian armored personnel carrier (APC) which was created by converting a tank chassis. It was so successful that it was widely used by British and Commonwealth forces during WWII. It was developed in 1944 to improve infantry mobility and protection during assaults, particularly following the heavy casualties suffered in Normandy. The Kangaroo was originally converted from obsolete or damaged tanks, such as Canadian Ram tanks and M7 Priest self-propelled guns, and offered a new way to transport infantry safely across battlefields by providing shielding from small arms fire and shell fragments. Kangaroos played a crucial role in operations in Europe, where they helped troops advance alongside tanks.","LocalizedString":"The Kangaroo was an improvised Canadian armored personnel carrier (APC) which was created by converting a tank chassis. It was so successful that it was widely used by British and Commonwealth forces during WWII. It was developed in 1944 to improve infantry mobility and protection during assaults, particularly following the heavy casualties suffered in Normandy. The Kangaroo was originally converted from obsolete or damaged tanks, such as Canadian Ram tanks and M7 Priest self-propelled guns, and offered a new way to transport infantry safely across battlefields by providing shielding from small arms fire and shell fragments. Kangaroos played a crucial role in operations in Europe, where they helped troops advance alongside tanks."},"rarity":"ERarityEnum::Common","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::BloodAndIron","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Blitz","EHelpBubbleTypes::HeavyArmor1"],"soundEnterPlay":{"ObjectName":"SoundWave'Tank_Medium_Move_Fx'","ObjectPath":"kards/Content/Assets/Audio/Units/Tank_Medium_Move_Fx.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Britain/Winter_2024/t_kangaroo_transport.t_kangaroo_transport","SubPathString":""},"artist":"David Pentland","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/KANGAROO_TRANSPORT.KANGAROO_TRANSPORT","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":323.0},"histor