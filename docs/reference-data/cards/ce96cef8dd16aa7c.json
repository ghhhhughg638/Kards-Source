{"format":"kards-original-reference","version":1,"id":"ce96cef8dd16aa7c","name":"card_unit_122nd_korsun","package":"/Game/Blueprints/Cards/Soviet/WinterWar/units/card_unit_122nd_korsun","parent":"UBaseCardObject","card":{"title":"122nd KORSUN","text":"Costs 1 less to deploy for each of your units.","flavorText":"The 122nd Guards Rifle Regiment was a unit of the 41st Guards Rifle Division, an elite unit which was formed in August 1942 from the 10th Airborne Corps, and served extensively throughout WWII. The division fought at Stalingrad and suffered heavy losses, but afterwards it underwent significant rebuilding before engaging in various operations. It participated in numerous battles in regions such as Donbas, eastern Ukraine, and Hungary, earning multiple battle honors (including “Korsun”) and decorations. In 1945 the division was stationed in Vienna briefly, but later moved to lower Austria where it connected with US forces towards the end of the war. Eventually, in October 1945, the division was transformed into the 18th Guards Mechanized Division.","faction":"Soviet","type":"infantry","rarity":"Unique","cost":6,"operationCost":1,"attack":5,"defense":7},"defaults":{"UberGraphFrame":{},"Name":"card_unit_122nd_korsun","title":{"Namespace":"card_soviet","Key":"card_unit_122nd_korsun_title","SourceString":"122nd KORSUN","LocalizedString":"122nd KORSUN"},"Type":"ETypeEnum::infantry","attack":5,"defense":7,"range":1,"faction":"EFactionEnum::Soviet","kredits":6,"Text":{"Namespace":"card_soviet","Key":"card_unit_122nd_korsun_text","SourceString":"Costs 1 less to deploy for each of your units.","LocalizedString":"Costs 1 less to deploy for each of your units."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_122nd_korsun_history","SourceString":"The 122nd Guards Rifle Regiment was a unit of the 41st Guards Rifle Division, an elite unit which was formed in August 1942 from the 10th Airborne Corps, and served extensively throughout WWII. The division fought at Stalingrad and suffered heavy losses, but afterwards it underwent significant rebuilding before engaging in various operations. It participated in numerous battles in regions such as Donbas, eastern Ukraine, and Hungary, earning multiple battle honors (including “Korsun”) and decorations. In 1945 the division was stationed in Vienna briefly, but later moved to lower Austria where it connected with US forces towards the end of the war. Eventually, in October 1945, the division was transformed into the 18th Guards Mechanized Division.","LocalizedString":"The 122nd Guards Rifle Regiment was a unit of the 41st Guards Rifle Division, an elite unit which was formed in August 1942 from the 10th Airborne Corps, and served extensively throughout WWII. The division fought at Stalingrad and suffered heavy losses, but afterwards it underwent significant rebuilding before engaging in various operations. It participated in numerous battles in regions such as Donbas, eastern Ukraine, and Hungary, earning multiple battle honors (including “Korsun”) and decorations. In 1945 the division was stationed in Vienna briefly, but later moved to lower Austria where it connected with US forces towards the end of the war. Eventually, in October 1945, the division was transformed into the 18th Guards Mechanized Division."},"operationCost":1,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::WinterWar","isReserved":true,"usedTriggers":["ERegisteredCardFunction::OnOtherCardEnterPlay","ERegisteredCardFunction::OnAfterOtherCardLeaveBoardOrOwner","ERegisteredCardFunction::OnOtherCovertCardPlayedFromHand"],"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Guard"],"hasGuard":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/Winter_War/t_soviets_vs_finns.t_soviets_vs_finns","SubPathString":""},"artist":"Soviet WW2 painintg","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/122nd_KORSUN.122nd_KORSUN","SubPathString":""},"historyPhotoSize":{"X":512