{"format":"kards-original-reference","version":1,"id":"6c9759cee175eeef","name":"card_unit_me_bf_110","package":"/Game/Blueprints/Cards/Germany/Base/units/card_unit_me_bf_110","parent":"UBaseCardObject","card":{"title":"ME BF 110","text":"At the end of your turn, give ME BF 110 +1+1 if you control the frontline.","flavorText":"The Messerschmitt Bf 110 was a twin-engine heavy fighter and fighter-bomber developed by the Germans in the 1930s and used by the Luftwaffe during WWII.  It was armed with two MG FF 20 mm cannons, four 7.92 mm (.312 in) MG 17 machine guns, and one 7.92 mm (.312 in) MG 15 machine gun or twin-barrel MG 81Z for defense. The aircraft served successfully in the early campaigns, however it lacked agility in the air which was a vulnerability that was exploited by the Allies during the Battle of Britain. After the Battle of Britain the Bf 110 served successfully as an air superiority fighter and strike aircraft, but by 1944 it was no match against American air supremacy.","faction":"Germany","type":"fighter","rarity":"Uncommon","cost":4,"operationCost":2,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_me_bf_110","title":{"Namespace":"card_germany","Key":"card_unit_me_bf_110_title","SourceString":"ME BF 110","LocalizedString":"ME BF 110"},"Type":"ETypeEnum::fighter","attack":3,"defense":3,"range":2,"faction":"EFactionEnum::Germany","kredits":4,"Text":{"Namespace":"card_germany","Key":"card_unit_me_bf_110_text","SourceString":"At the end of your turn, give ME BF 110 +1+1 if you control the frontline.","LocalizedString":"At the end of your turn, give ME BF 110 +1+1 if you control the frontline."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_me_bf_110_history","SourceString":"The Messerschmitt Bf 110 was a twin-engine heavy fighter and fighter-bomber developed by the Germans in the 1930s and used by the Luftwaffe during WWII.  It was armed with two MG FF 20 mm cannons, four 7.92 mm (.312 in) MG 17 machine guns, and one 7.92 mm (.312 in) MG 15 machine gun or twin-barrel MG 81Z for defense. The aircraft served successfully in the early campaigns, however it lacked agility in the air which was a vulnerability that was exploited by the Allies during the Battle of Britain. After the Battle of Britain the Bf 110 served successfully as an air superiority fighter and strike aircraft, but by 1944 it was no match against American air supremacy.","LocalizedString":"The Messerschmitt Bf 110 was a twin-engine heavy fighter and fighter-bomber developed by the Germans in the 1930s and used by the Luftwaffe during WWII.  It was armed with two MG FF 20 mm cannons, four 7.92 mm (.312 in) MG 17 machine guns, and one 7.92 mm (.312 in) MG 15 machine gun or twin-barrel MG 81Z for defense. The aircraft served successfully in the early campaigns, however it lacked agility in the air which was a vulnerability that was exploited by the Allies during the Battle of Britain. After the Battle of Britain the Bf 110 served successfully as an air superiority fighter and strike aircraft, but by 1944 it was no match against American air supremacy."},"operationCost":2,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Basic","isReserved":true,"EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnEndOfTurn"],"soundBlowUp":{"ObjectName":"SoundCue'AU_Exp_Aircraft_Medium_Cue'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Medium_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/t_me_110.t_me_110","SubPathString":""},"ImageAnchor":"EImageAnchor::Bot","artist":"War Picture Library / Rebellion","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/ME_BF_110.ME_BF_110","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":356.0},"historyPhotoSource":"German Federal Archive","historyPhotoIdentificationCode":"Bild 101I-377-2801-013","historyPhotoAuthor":"Jakobsen ","historyPhotoDescription":{"Namespace":"card_germany","Key"