{"format":"kards-original-reference","version":1,"id":"cbdd35678124bf06","name":"card_unit_tsuruga_regiment","package":"/Game/Blueprints/Cards/Japan/WinterWar/units/card_unit_tsuruga_regiment","parent":"UBaseCardObject","card":{"title":"TSURUGA REGIMENT","text":"Destruction: Deal damage equal to its attack to the enemy HQ.","flavorText":"The 67th Infantry regiment (Tsuruga) was a regiment of the 15th Division of the Imperial Japanese Army which was active from 1905 to 1925, and 1938 to 1945. In 1943 the 15th Division was assigned to the 15th Army in Burma in preparation for an offensive against British India, codenamed Operation U-Go. In 1944 the division participated in the attack on Imphal, followed by the Battle of Meiktila and Mandalay. During these operations the 15th Division lost more than half of its men, both in combat and to disease, and was forced to retreat from Burma and into Thailand where it was officially disbanded in 1945, a few days before the war ended.","faction":"Japan","type":"infantry","rarity":"Common","cost":4,"operationCost":1,"attack":2,"defense":4},"defaults":{"UberGraphFrame":{},"Name":"card_unit_tsuruga_regiment","title":{"Namespace":"card_japan","Key":"card_unit_tsuruga_regiment_title","SourceString":"TSURUGA REGIMENT","LocalizedString":"TSURUGA REGIMENT"},"Type":"ETypeEnum::infantry","attack":2,"defense":4,"range":1,"faction":"EFactionEnum::Japan","kredits":4,"Text":{"Namespace":"card_japan","Key":"card_unit_tsuruga_regiment_text","SourceString":"Destruction: Deal damage equal to its attack to the enemy HQ.","LocalizedString":"Destruction: Deal damage equal to its attack to the enemy HQ."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_tsuruga_regiment_history","SourceString":"The 67th Infantry regiment (Tsuruga) was a regiment of the 15th Division of the Imperial Japanese Army which was active from 1905 to 1925, and 1938 to 1945. In 1943 the 15th Division was assigned to the 15th Army in Burma in preparation for an offensive against British India, codenamed Operation U-Go. In 1944 the division participated in the attack on Imphal, followed by the Battle of Meiktila and Mandalay. During these operations the 15th Division lost more than half of its men, both in combat and to disease, and was forced to retreat from Burma and into Thailand where it was officially disbanded in 1945, a few days before the war ended.","LocalizedString":"The 67th Infantry regiment (Tsuruga) was a regiment of the 15th Division of the Imperial Japanese Army which was active from 1905 to 1925, and 1938 to 1945. In 1943 the 15th Division was assigned to the 15th Army in Burma in preparation for an offensive against British India, codenamed Operation U-Go. In 1944 the division participated in the attack on Imphal, followed by the Battle of Meiktila and Mandalay. During these operations the 15th Division lost more than half of its men, both in combat and to disease, and was forced to retreat from Burma and into Thailand where it was officially disbanded in 1945, a few days before the war ended."},"operationCost":1,"rarity":"ERarityEnum::Common","cardSet":"ECardSetEnum::WinterWar","isReserved":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Destruction"],"hasDestruction":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/CandidateArtwork/Winter_war/t_tsuruga_regiment.t_tsuruga_regiment","SubPathString":""},"artist":"Volmi Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/TSURUGA_REGIMENT.TSURUGA_REGIMENT","SubPathString":""},"historyPhotoSize":{"X":371.0,"Y":512.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_tsuruga_regiment_photo","SourceString":"Japanese soldiers guarding a railway bridge in Burma in 1942.","LocalizedString":"Japanese soldiers guarding a railway bridge in Burma in 1942."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpC