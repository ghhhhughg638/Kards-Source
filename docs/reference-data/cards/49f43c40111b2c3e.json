{"format":"kards-original-reference","version":1,"id":"49f43c40111b2c3e","name":"card_unit_kikka_jet","package":"/Game/Blueprints/Cards/Japan/Legions/units/card_unit_kikka_jet","parent":"UBaseCardObject","card":{"title":"KIKKA","text":"Destruction: Shuffle 4 KAMIKAZE cards into your deck.","flavorText":"The Nakajima Kikka, aka Kōkoku Nigō Heiki, was the first Japanese jet aircraft. It was developed late in the war for the Imperial Japanese Navy and intended for ground attacks and anti-shipping. The first flight tests took place in August 1945, and overall it performed well overall, but before it could ever be used in frontline service, the Japanese had surrendered to the Allies. The idea to develop the Kikka came after the Japanese military attaché in Germany witnessed the trials of the Messerschmitt Me 262 in 1942, so it’s no coincidence that the design is similar.","faction":"Japan","type":"fighter","rarity":"Unique","cost":7,"operationCost":3,"attack":6,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_kikka_jet","title":{"Namespace":"card_japan","Key":"card_unit_kikka_jet_title","SourceString":"KIKKA","LocalizedString":"KIKKA"},"Type":"ETypeEnum::fighter","attack":6,"defense":5,"range":2,"faction":"EFactionEnum::Japan","kredits":7,"Text":{"Namespace":"card_japan","Key":"card_unit_kikka_jet_text","SourceString":"Destruction: Shuffle 4 KAMIKAZE cards into your deck.","LocalizedString":"Destruction: Shuffle 4 KAMIKAZE cards into your deck."},"flavorText":{"Namespace":"card_japan","Key":"card_unit_kikka_jet_history","SourceString":"The Nakajima Kikka, aka Kōkoku Nigō Heiki, was the first Japanese jet aircraft. It was developed late in the war for the Imperial Japanese Navy and intended for ground attacks and anti-shipping. The first flight tests took place in August 1945, and overall it performed well overall, but before it could ever be used in frontline service, the Japanese had surrendered to the Allies. The idea to develop the Kikka came after the Japanese military attaché in Germany witnessed the trials of the Messerschmitt Me 262 in 1942, so it’s no coincidence that the design is similar.","LocalizedString":"The Nakajima Kikka, aka Kōkoku Nigō Heiki, was the first Japanese jet aircraft. It was developed late in the war for the Imperial Japanese Navy and intended for ground attacks and anti-shipping. The first flight tests took place in August 1945, and overall it performed well overall, but before it could ever be used in frontline service, the Japanese had surrendered to the Allies. The idea to develop the Kikka came after the Japanese military attaché in Germany witnessed the trials of the Messerschmitt Me 262 in 1942, so it’s no coincidence that the design is similar."},"operationCost":3,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::Legions","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Blitz","EHelpBubbleTypes::Destruction"],"hasDestruction":true,"hasBlitz":true,"spawnCardName":"card_event_kamikaze","soundEnterPlay":{"ObjectName":"SoundCue'AU_depl_Jet_Cue'","ObjectPath":"kards/Content/Assets/Audio/Jet/AU_depl_Jet_Cue.0"},"soundMoveToFrontline":{"ObjectName":"SoundCue'AU_depl_Jet_Cue'","ObjectPath":"kards/Content/Assets/Audio/Jet/AU_depl_Jet_Cue.0"},"soundAttack":{"ObjectName":"SoundCue'AU_depl_Jet_Cue'","ObjectPath":"kards/Content/Assets/Audio/Jet/AU_depl_Jet_Cue.0"},"soundBlowUp":{"ObjectName":"SoundWave'AU_Exp_Aircraft_Large_01'","ObjectPath":"kards/Content/Assets/Audio/Card_Blowups/AU_Exp_Aircraft_Large_01.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Japan/Invasion/t_nakajima_kikka_vs2.t_nakajima_kikka_vs2","SubPathString":""},"artist":"Yoshiyuki Takani","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/KIKKA.KIKKA","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":255.0},"historyPhotoDescription":{"Namespace":"card_japan","Key":"card_unit_kikka_jet_photo","SourceString":"Nakajima Kikka, 1945.","LocalizedString":"Nakajima Kikk