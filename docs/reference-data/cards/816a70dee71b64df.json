{"format":"kards-original-reference","version":1,"id":"816a70dee71b64df","name":"card_unit_36th_cavalry","package":"/Game/Blueprints/Cards/Soviet/CovertOp/units/card_unit_36th_cavalry","parent":"UBaseCardObject","card":{"title":"36th CAVALRY","text":"Deployment: Gets +3+3 and Blitz.\r\nDestruction: Add two suppressed copies to your support line.","flavorText":"The 36th Cavalry Division was a unit of the Red Army formed sometime prior to 1939. At the start of Operation Barbarossa in 1941 it was stationed in Vawkavysk, Belarus. On June 22nd 1941, the division was ordered to counterattack alongside the 6th Mechanized Corps. However, just a day later, Luftwaffe airstrikes inflicted heavy casualties and the division was destroyed within 48 hours. It was officially disbanded on July 6th, 1941. Subordinate units of the 36th Cavalry Division were the 24th, 42nd and 102nd Cavalry Regiments and the 8th Tank Regiment.","faction":"Soviet","type":"infantry","rarity":"Uncommon","cost":6,"operationCost":1,"attack":3,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_36th_cavalry","title":{"Namespace":"card_soviet","Key":"card_unit_36th_cavalry_title","SourceString":"36th CAVALRY","LocalizedString":"36th CAVALRY"},"Type":"ETypeEnum::infantry","attack":3,"defense":3,"range":1,"faction":"EFactionEnum::Soviet","kredits":6,"Text":{"Namespace":"card_soviet","Key":"card_unit_36th_cavalry_text","SourceString":"Deployment: Gets +3+3 and Blitz.\r\nDestruction: Add two suppressed copies to your support line.","LocalizedString":"Deployment: Gets +3+3 and Blitz.\r\nDestruction: Add two suppressed copies to your support line."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_36th_cavalry_history","SourceString":"The 36th Cavalry Division was a unit of the Red Army formed sometime prior to 1939. At the start of Operation Barbarossa in 1941 it was stationed in Vawkavysk, Belarus. On June 22nd 1941, the division was ordered to counterattack alongside the 6th Mechanized Corps. However, just a day later, Luftwaffe airstrikes inflicted heavy casualties and the division was destroyed within 48 hours. It was officially disbanded on July 6th, 1941. Subordinate units of the 36th Cavalry Division were the 24th, 42nd and 102nd Cavalry Regiments and the 8th Tank Regiment.","LocalizedString":"The 36th Cavalry Division was a unit of the Red Army formed sometime prior to 1939. At the start of Operation Barbarossa in 1941 it was stationed in Vawkavysk, Belarus. On June 22nd 1941, the division was ordered to counterattack alongside the 6th Mechanized Corps. However, just a day later, Luftwaffe airstrikes inflicted heavy casualties and the division was destroyed within 48 hours. It was officially disbanded on July 6th, 1941. Subordinate units of the 36th Cavalry Division were the 24th, 42nd and 102nd Cavalry Regiments and the 8th Tank Regiment."},"operationCost":1,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::CurrentExpansion","isInPermanentPool":true,"extraHelpTextBubbleTypes":["EHelpBubbleTypes::Suppress"],"hasDeployment":true,"hasDestruction":true,"soundEnterPlay":{"ObjectName":"SoundCue'AU_Move_Cavalry_Heavy_Cue'","ObjectPath":"kards/Content/Assets/Audio/Cavalry/AU_Move_Cavalry_Heavy_Cue.0"},"soundMoveToFrontline":{"ObjectName":"SoundCue'AU_Move_Cavalry_Heavy_Cue'","ObjectPath":"kards/Content/Assets/Audio/Cavalry/AU_Move_Cavalry_Heavy_Cue.0"},"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/CandidateArtwork/Summer_24/t_cossack_variant.t_cossack_variant","SubPathString":""},"artist":"Soviet WWII Poster","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/36th_CAVALRY.36th_CAVALRY","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":295.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_36th_cavalry_photo","SourceString":"Red Army cavalry during WWII.","LocalizedString":"Red Army cavalry during WWII."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","Obj