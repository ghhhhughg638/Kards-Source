{"format":"kards-original-reference","version":1,"id":"f254debe5d28890a","name":"card_unit_162nd_regiment","package":"/Game/Blueprints/Cards/USA/OceaniaStorm/units/card_unit_162nd_regiment","parent":"UBaseCardObject","card":{"title":"162nd REGIMENT","text":"Combat damage dealt to your infantry is reduced to 2. Fully repair your infantry when you play a Rain card.","flavorText":"The 162nd Infantry Regiment was a unit of the Oregon National Guard with roots going back to the 3rd Oregon Infantry Regiment. During WWII it served with the 41st Infantry Division, known as the Jungleers. After earlier campaigns in the Pacific, the regiment took part in the southern Philippines operations in 1945. On Mindanao, the 162nd landed near San Mateo on 10 March. The assault faced only light resistance at the beach, and the regiment quickly secured Wolfe Field before pushing inland and west along the coast. The harder fighting came afterward, when Japanese forces withdrew into high ground covered by jungle, wire, mines, and hidden positions. The 162nd advanced in two columns toward Mount Capisan, supported by artillery and close air support. By late March, organized resistance in that sector had been broken. Elements of the regiment also fought on nearby Sibago Island, where a small Japanese garrison held a lighthouse overlooking Basilan Strait. The fight lasted several days despite the island’s small size. The 162nd later moved to eastern Mindanao, securing lines of communication and helping clear Japanese resistance, before preparing for the planned invasion of Japan.","faction":"USA","type":"infantry","rarity":"Rare","cost":4,"operationCost":1,"attack":4,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_162nd_regiment","title":{"Namespace":"card_usa","Key":"card_unit_162nd_regiment_title","SourceString":"162nd REGIMENT","LocalizedString":"162nd REGIMENT"},"Type":"ETypeEnum::infantry","attack":4,"defense":5,"range":1,"faction":"EFactionEnum::USA","kredits":4,"Text":{"Namespace":"card_usa","Key":"card_unit_162nd_regiment_text","SourceString":"Combat damage dealt to your infantry is reduced to 2. Fully repair your infantry when you play a Rain card.","LocalizedString":"Combat damage dealt to your infantry is reduced to 2. Fully repair your infantry when you play a Rain card."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_162nd_regiment_history","SourceString":"The 162nd Infantry Regiment was a unit of the Oregon National Guard with roots going back to the 3rd Oregon Infantry Regiment. During WWII it served with the 41st Infantry Division, known as the Jungleers. After earlier campaigns in the Pacific, the regiment took part in the southern Philippines operations in 1945. On Mindanao, the 162nd landed near San Mateo on 10 March. The assault faced only light resistance at the beach, and the regiment quickly secured Wolfe Field before pushing inland and west along the coast. The harder fighting came afterward, when Japanese forces withdrew into high ground covered by jungle, wire, mines, and hidden positions. The 162nd advanced in two columns toward Mount Capisan, supported by artillery and close air support. By late March, organized resistance in that sector had been broken. Elements of the regiment also fought on nearby Sibago Island, where a small Japanese garrison held a lighthouse overlooking Basilan Strait. The fight lasted several days despite the island’s small size. The 162nd later moved to eastern Mindanao, securing lines of communication and helping clear Japanese resistance, before preparing for the planned invasion of Japan.","LocalizedString":"The 162nd Infantry Regiment was a unit of the Oregon National Guard with roots going back to the 3rd Oregon Infantry Regiment. During WWII it served with the 41st Infantry Division, known as the Jungleers. After earlier campaigns in the Pacific, the regiment took part in the southern Philippines operations in 1945. On Mindanao, the 162nd landed near San Mateo on 10 March. The assault faced only light resistance at the beach, and the regiment quickly secured Wolfe Field before pushing inland and west along the coast. The harder fighting came afterward, when Japanese forces withdrew into high ground covered by jungle, wire, mines, and hidden positions. The 162nd advanced in two columns toward Mount Capisan, supported by artillery and close air support. By late March, organized resistance in that sector had been broken. Elements of the regiment also fought on nearby Sibago Island, where a small Japanese garrison held a lighthouse overlooking Basilan Strait. The fight lasted several days despite the island’s small size. The 162nd later moved to eastern Mindanao, securing lines of communication and helping clear Japanese resistance, before preparing for the planned invasion of Japan."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardDealDamageAddDamage","ERegisteredCardFunction::OnOtherCardPlayedFromHand"],"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/162nd_REGIMENT.162nd_REGIMENT","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_162nd_regiment_photo","SourceString":"Men of the 162nd Infantry Regiment landing on the southwest tip of the Zamboanga Peninsula, Philippines, 1945. ","LocalizedString":"Men of the 162nd Infantry Regiment landing on the southwest tip of the Zamboanga Peninsula, Philippines, 1945. "},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryL'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryL.47"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeHeavy_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeHeavy.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"is