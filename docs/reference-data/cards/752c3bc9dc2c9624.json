{"format":"kards-original-reference","version":1,"id":"752c3bc9dc2c9624","name":"card_unit_henschel_he_129","package":"/Game/Blueprints/Cards/Germany/WorldAtWar/units/card_unit_henschel_he_129","parent":"UBaseCardObject","card":{"title":"HENSCHEL HS 129","text":"Has +2 attack against ground targets.\r\nDeployment: Fight target enemy unit.","flavorText":"The Henschel Hs 129 was Germany’s primary ground-attack aircraft during WWII. It was designed in response to the Condor Legion’s experiences in Spain and focused on heavy armor and low-level attack capability. The cockpit was protected by a steel “bathtub” and 75 mm armored glass but offered poor visibility. The initial models used underpowered Argus As 410 engines, resulting in sluggish performance and handling issues. To address these problems, later versions were equipped with captured French Gnome & Rhône 14M engines, which offered better power and eliminated torque imbalance. The improved Hs 129 B-1 entered service in 1942, followed by the B-2. Both models were mostly used on the Eastern Front, mainly to attack tanks and transport columns. Armament upgrades included 30 mm MK 101 and MK 103 cannons, and later a 37 mm BK 3.7 gun. The final variant, the B-3, mounted a 75 mm BK 7.5 cannon with an autoloader and hydraulic recoil system. Though capable of destroying any Allied tank, its performance suffered from the weapon’s weight. Production ceased in 1944 after roughly 870 Hs 129s had been produced.","faction":"Germany","type":"fighter","rarity":"Rare","cost":5,"operationCost":2,"attack":4,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_henschel_he_129","title":{"Namespace":"card_germany","Key":"card_unit_henschel_he_129_title","SourceString":"HENSCHEL HS 129","LocalizedString":"HENSCHEL HS 129"},"Type":"ETypeEnum::fighter","attack":4,"defense":5,"range":2,"faction":"EFactionEnum::Germany","kredits":5,"Text":{"Namespace":"card_germany","Key":"card_unit_henschel_he_129_text","SourceString":"Has +2 attack against ground targets.\r\nDeployment: Fight target enemy unit.","LocalizedString":"Has +2 attack against ground targets.\r\nDeployment: Fight target enemy unit."},"flavorText":{"Namespace":"card_germany","Key":"card_unit_henschel_he_129_history","SourceString":"The Henschel Hs 129 was Germany’s primary ground-attack aircraft during WWII. It was designed in response to the Condor Legion’s experiences in Spain and focused on heavy armor and low-level attack capability. The cockpit was protected by a steel “bathtub” and 75 mm armored glass but offered poor visibility. The initial models used underpowered Argus As 410 engines, resulting in sluggish performance and handling issues. To address these problems, later versions were equipped with captured French Gnome & Rhône 14M engines, which offered better power and eliminated torque imbalance. The improved Hs 129 B-1 entered service in 1942, followed by the B-2. Both models were mostly used on the Eastern Front, mainly to attack tanks and transport columns. Armament upgrades included 30 mm MK 101 and MK 103 cannons, and later a 37 mm BK 3.7 gun. The final variant, the B-3, mounted a 75 mm BK 7.5 cannon with an autoloader and hydraulic recoil system. Though capable of destroying any Allied tank, its performance suffered from the weapon’s weight. Production ceased in 1944 after roughly 870 Hs 129s had been produced.","LocalizedString":"The Henschel Hs 129 was Germany’s primary ground-attack aircraft during WWII. It was designed in response to the Condor Legion’s experiences in Spain and focused on heavy armor and low-level attack capability. The cockpit was protected by a steel “bathtub” and 75 mm armored glass but offered poor visibility. The initial models used underpowered Argus As 410 engines, resulting in sluggish performance and handling issues. To address these problems, later versions were equipped with captured French Gnome & Rhône 14M engines, which offered better power and eliminated torque imbalance. The improved Hs 129 B-1 entered service in 1942, followed by the B-2. Both models were mostly used on the Eastern Front, mainly to attack tanks and transport columns. Armament upgrades included 30 mm MK 101 and MK 103 cannons, and later a 37 mm BK 3.7 gun. The final variant, the B-3, mounted a 75 mm BK 7.5 cannon with an autoloader and hydraulic recoil system. Though capable of destroying any Allied tank, its performance suffered from the weapon’s weight. Production ceased in 1944 after roughly 870 Hs 129s had been produced."},"operationCost":2,"rarity":"ERarityEnum::Rare","selectTargetOnPlayedFromHand":true,"cardSet":"ECardSetEnum::NavalWarfare","EffectType":"ECardEffectTypes::Passive","extraHelpTextBubbleTypes":["EHelpBubbleTypes::Fight"],"hasDeployment":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Germany/World_at_War/T_henschel_he_129.T_henschel_he_129","SubPathString":""},"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/HENSCHEL_HE_129.HENSCHEL_HE_129","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":298.0},"historyPhotoDescription":{"Namespace":"card_germany","Key":"card_unit_henschel_he_129_photo","SourceString":"A couple of Henschel Hs 129s in flight. Date unknown.","LocalizedString":"A couple of Henschel Hs 129s in flight. Date unknown."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackFighter.BP_AttackFighter_C","SubPathString":""}},"variables":[{"name":"tempCard","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"CanPlayFromHand","owner":"card_unit_henschel_he_129_C","params":[{"name":"canIt","type":"bool","direction":"out"},{"name":"reason","type":"FString","