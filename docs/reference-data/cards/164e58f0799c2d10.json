{"format":"kards-original-reference","version":1,"id":"164e58f0799c2d10","name":"card_unit_uusimaa_regiment","package":"/Game/Blueprints/Cards/Finland/units/card_unit_uusimaa_regiment","parent":"UBaseCardObject","card":{"title":"UUSIMAA REGIMENT","text":"Your SISSI units deal +4 damage to HQs. At the end of your turn, add a SISSI to the same front.","flavorText":"The Uusimaa Regiment was the interwar name of the unit that later became Finland’s Nyland Brigade. Its roots reached back through the 3rd Jaeger Regiment of 1918 and the older Nyland and Tavastehus Cavalry Regiment, which had traditions dating to 1626. During the Winter War, the Uusimaa Regiment helped form the new 13th Brigade, which then became Infantry Regiment 13 during the Continuation War. During that time it fought with the 5th Division on the Karelian Isthmus, as part of the Army of the Isthmus. The brigade later carried these traditions into Finland’s coastal forces. Based at Dragsvik near Raseborg, it became known as Nyland Brigade and eventually joined the Finnish Navy. The unit has a unique language tradition. It is the only formation in the Finnish Defence Forces where training is given in Swedish, one of Finland’s two national languages, while the command language remains Finnish. Its modern coastal jaegers continue the unit’s focus on fighting in difficult shoreline terrain.","faction":"Finland","type":"infantry","rarity":"Rare","cost":3,"operationCost":1,"attack":2,"defense":5},"defaults":{"UberGraphFrame":{},"Name":"card_unit_uusimaa_regiment","title":{"Namespace":"card_finland","Key":"card_unit_uusimaa_regiment_title","SourceString":"UUSIMAA REGIMENT","LocalizedString":"UUSIMAA REGIMENT"},"Type":"ETypeEnum::infantry","attack":2,"defense":5,"range":1,"faction":"EFactionEnum::Finland","kredits":3,"Text":{"Namespace":"card_finland","Key":"card_unit_uusimaa_regiment_text","SourceString":"Your SISSI units deal +4 damage to HQs. At the end of your turn, add a SISSI to the same front.","LocalizedString":"Your SISSI units deal +4 damage to HQs. At the end of your turn, add a SISSI to the same front."},"flavorText":{"Namespace":"card_finland","Key":"card_unit_uusimaa_regiment_history","SourceString":"The Uusimaa Regiment was the interwar name of the unit that later became Finland’s Nyland Brigade. Its roots reached back through the 3rd Jaeger Regiment of 1918 and the older Nyland and Tavastehus Cavalry Regiment, which had traditions dating to 1626. During the Winter War, the Uusimaa Regiment helped form the new 13th Brigade, which then became Infantry Regiment 13 during the Continuation War. During that time it fought with the 5th Division on the Karelian Isthmus, as part of the Army of the Isthmus. The brigade later carried these traditions into Finland’s coastal forces. Based at Dragsvik near Raseborg, it became known as Nyland Brigade and eventually joined the Finnish Navy. The unit has a unique language tradition. It is the only formation in the Finnish Defence Forces where training is given in Swedish, one of Finland’s two national languages, while the command language remains Finnish. Its modern coastal jaegers continue the unit’s focus on fighting in difficult shoreline terrain.","LocalizedString":"The Uusimaa Regiment was the interwar name of the unit that later became Finland’s Nyland Brigade. Its roots reached back through the 3rd Jaeger Regiment of 1918 and the older Nyland and Tavastehus Cavalry Regiment, which had traditions dating to 1626. During the Winter War, the Uusimaa Regiment helped form the new 13th Brigade, which then became Infantry Regiment 13 during the Continuation War. During that time it fought with the 5th Division on the Karelian Isthmus, as part of the Army of the Isthmus. The brigade later carried these traditions into Finland’s coastal forces. Based at Dragsvik near Raseborg, it became known as Nyland Brigade and eventually joined the Finnish Navy. The unit has a unique language tradition. It is the only formation in the Finnish Defence Forces where training is given in Swedish, one of Finland’s two national languages, while the command language remains Finnish. Its modern coastal jaegers continue the unit’s focus on fighting in difficult shoreline terrain."},"operationCost":1,"rarity":"ERarityEnum::Rare","cardSet":"ECardSetEnum::OceaniaStorm","EffectType":"ECardEffectTypes::Trigger","usedTriggers":["ERegisteredCardFunction::OnOtherCardDealDamageAddDamage","ERegisteredCardFunction::OnEndOfTurn"],"spawnCardName":"card_unit_sissi","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/UUSIMAA_REGIMENT.UUSIMAA_REGIMENT","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_finland","Key":"card_unit_uusimaa_regiment_photo","SourceString":"Finnish soldiers operating a captured Soviet anti-tank rifle during the Continuation War. Date unknown.","LocalizedString":"Finnish soldiers operating a captured Soviet anti-tank rifle during the Continuation War. Date unknown."},"blowUpExplosionNiagara":{"ObjectName":"NiagaraSystem'NS_ExplosionInfantryM'","ObjectPath":"kards/Content/Effects/Niagara/NS_ExplosionInfantryM.46"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/Infantry/BP_AttackInfantry.BP_AttackInfantry_C","SubPathString":""},"threat_level":0.2},"variables":[{"name":"spawninfront","type":"bool","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_uusimaa_regiment","owner":"card_unit_uusimaa_regiment_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_text_Variable","type":"FText","direction":"in"},{"name":"CallFunc_IsSideActive_active","type":"bool","direction":"in"},{"name":"K2Node_Event_turnnumber","type":"int32","direction":"in"},{"name":"Ca