{"format":"kards-original-reference","version":1,"id":"073d060cdafd0748","name":"card_unit_f6f_hellcat_home","package":"/Game/Blueprints/Cards/USA/Homefront/units/card_unit_f6f_hellcat_home","parent":"UBaseCardObject","card":{"title":"F6F-5 HELLCAT","text":"When this unit attacks, it and the top unit of your deck gets +1+1.","flavorText":"The F6F-5 Hellcat, introduced in 1944, was the most advanced and numerous version of the Grumman F6F series. It improved on the earlier F6F-3 with a more powerful engine, strengthened airframe, and a redesigned engine cowling for better streamlining. Many were equipped with radar, making the F6F-5N a capable night fighter. Over 7,800 of this variant were produced out of a total 12,275 Hellcats built. Designed for carrier operations, the Hellcat was rugged, easy to fly, and lethal. It was specifically developed to counter the Mitsubishi A6M Zero and proved highly successful in doing so. With its 2,000 hp Pratt & Whitney R-2800 engine, the Hellcat had the speed, firepower and durability to dominate the skies. First seeing combat in 1943, the Hellcat quickly became the backbone of US Navy fighter squadrons in the Pacific. By the end of the war, it was credited with destroying 5,223 enemy aircraft, more than any other Allied naval plane. Its impact on air superiority was unmatched during the critical campaigns from the Gilbert Islands to Okinawa.","faction":"USA","type":"fighter","rarity":"Uncommon","cost":3,"operationCost":2,"attack":1,"defense":3},"defaults":{"UberGraphFrame":{},"GameplayTags":["ability.bond"],"Name":"card_unit_f6f_hellcat_home","title":{"Namespace":"card_usa","Key":"card_unit_f6f_hellcat_home_title","SourceString":"F6F-5 HELLCAT","LocalizedString":"F6F-5 HELLCAT"},"Type":"ETypeEnum::fighter","attack":1,"defense":3,"range":2,"faction":"EFactionEnum::USA","kredits":3,"Text":{"Namespace":"card_usa","Key":"card_unit_f6f_hellcat_home_text","SourceString":"When this unit attacks, it and the top unit of your deck gets +1+1.","LocalizedString":"When this unit attacks, it and the top unit of your deck gets +1+1."},"flavorText":{"Namespace":"card_usa","Key":"card_unit_f6f_hellcat_home_history","SourceString":"The F6F-5 Hellcat, introduced in 1944, was the most advanced and numerous version of the Grumman F6F series. It improved on the earlier F6F-3 with a more powerful engine, strengthened airframe, and a redesigned engine cowling for better streamlining. Many were equipped with radar, making the F6F-5N a capable night fighter. Over 7,800 of this variant were produced out of a total 12,275 Hellcats built. Designed for carrier operations, the Hellcat was rugged, easy to fly, and lethal. It was specifically developed to counter the Mitsubishi A6M Zero and proved highly successful in doing so. With its 2,000 hp Pratt & Whitney R-2800 engine, the Hellcat had the speed, firepower and durability to dominate the skies. First seeing combat in 1943, the Hellcat quickly became the backbone of US Navy fighter squadrons in the Pacific. By the end of the war, it was credited with destroying 5,223 enemy aircraft, more than any other Allied naval plane. Its impact on air superiority was unmatched during the critical campaigns from the Gilbert Islands to Okinawa.","LocalizedString":"The F6F-5 Hellcat, introduced in 1944, was the most advanced and numerous version of the Grumman F6F series. It improved on the earlier F6F-3 with a more powerful engine, strengthened airframe, and a redesigned engine cowling for better streamlining. Many were equipped with radar, making the F6F-5N a capable night fighter. Over 7,800 of this variant were produced out of a total 12,275 Hellcats built. Designed for carrier operations, the Hellcat was rugged, easy to fly, and lethal. It was specifically developed to counter the Mitsubishi A6M Zero and proved highly successful in doing so. With its 2,000 hp Pratt & Whitney R-2800 engine, the Hellcat had the speed, firepower and durability to dominate the skies. First seeing combat in 1943, the Hellcat quickly became the backbone of US Navy fighter squadrons in the Pacific. By the end of the war, it was credited with destroying 5,223 enemy aircraft, more than any other Allied naval plane. Its impact on air superiority was unmatched during the critical campaigns from the Gilbert Islands to Okinawa."},"operationCost":2,"rarity":"ERarityEnum::Uncommon","cardSet":"ECardSetEnum::Homefront","hasFury":true,"historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/F6F-5_HELLCAT.F6F-5_HELLCAT","SubPathString":""},"historyPhotoDescription":{"Namespace":"card_usa","Key":"card_unit_f6f_hellcat_home_photo","SourceString":"A F6F-5 Hellcat in flight, 1944. ","LocalizedString":"A F6F-5 Hellcat in flight, 1944. "},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackFighter.BP_AttackFighter_C","SubPathString":""}},"variables":[{"name":"unitOnTop","type":"UBaseCardObject*","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_f6f_hellcat_home","owner":"card_unit_f6f_hellcat_home_C","params":[{"name":"EntryPoint","type":"int32","direction":"in"}],"pure":false,"event":false,"flags":"FUNC_Final | FUNC_UbergraphFunction | FUNC_HasDefaults","locals":[{"name":"Temp_bool_True_if_break_was_hit_Variable","type":"bool","direction":"in"},{"name":"Temp_int_Array_Index_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Not_PreBool_ReturnValue","type":"bool","direction":"in"},{"name":"Temp_int_Loop_Counter_Variable","type":"int32","direction":"in"},{"name":"CallFunc_Add_IntInt_ReturnValue","type":"int32","direction":"in"},{"name":"K2Node_Event_defenderCard","type":"UBaseCardObject*","direction":