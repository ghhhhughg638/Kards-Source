{"format":"kards-original-reference","version":1,"id":"59dbbbc79d482bf5","name":"card_unit_ilyushin_10","package":"/Game/Blueprints/Cards/Soviet/WorldAtWar/units/card_unit_ilyushin_10","parent":"UBaseCardObject","card":{"title":"ILYUSHIN IL-10","text":"Destruction: Add your last destroyed ground unit to your support line.","flavorText":"The Ilyushin Il-10 was the Soviet Union’s last ground-attack aircraft introduced during WWII. Designed to replace the Il-2, it featured stronger armor, better speed and improved handling at low altitudes. These qualities were vital for surviving concentrated ground fire during close support missions. Powered by the AM-42 engine, the Il-10 carried two 23 mm cannons, two machine guns, and a rear 12.7 mm gunner. It could also deliver up to 600 kilograms of bombs. Unlike the heavier Il-8, which was tested at the same time, the Il-10 proved more agile and reliable. It entered production in September 1944 and began arriving at frontline units in early 1945. Three assault regiments flew Il-10s in combat during the final weeks of the war in Europe. They attacked German defensive positions and supply routes. Crews praised its improved protection and firepower. Some aircraft were lost to Flak and engine failures, but performance was a clear step forward. The Il-10 also took part in the Soviet offensive against Japan in August 1945. Though its time in WWII was short, it marked the Air Forces’ shift to more modern and versatile strike aircraft.","faction":"Soviet","type":"fighter","rarity":"Unique","cost":3,"operationCost":1,"attack":4,"defense":3},"defaults":{"UberGraphFrame":{},"Name":"card_unit_ilyushin_10","title":{"Namespace":"card_soviet","Key":"card_unit_ilyushin_10_title","SourceString":"ILYUSHIN IL-10","LocalizedString":"ILYUSHIN IL-10"},"Type":"ETypeEnum::fighter","attack":4,"defense":3,"range":2,"faction":"EFactionEnum::Soviet","kredits":3,"Text":{"Namespace":"card_soviet","Key":"card_unit_ilyushin_10_text","SourceString":"Destruction: Add your last destroyed ground unit to your support line.","LocalizedString":"Destruction: Add your last destroyed ground unit to your support line."},"flavorText":{"Namespace":"card_soviet","Key":"card_unit_ilyushin_10_history","SourceString":"The Ilyushin Il-10 was the Soviet Union’s last ground-attack aircraft introduced during WWII. Designed to replace the Il-2, it featured stronger armor, better speed and improved handling at low altitudes. These qualities were vital for surviving concentrated ground fire during close support missions. Powered by the AM-42 engine, the Il-10 carried two 23 mm cannons, two machine guns, and a rear 12.7 mm gunner. It could also deliver up to 600 kilograms of bombs. Unlike the heavier Il-8, which was tested at the same time, the Il-10 proved more agile and reliable. It entered production in September 1944 and began arriving at frontline units in early 1945. Three assault regiments flew Il-10s in combat during the final weeks of the war in Europe. They attacked German defensive positions and supply routes. Crews praised its improved protection and firepower. Some aircraft were lost to Flak and engine failures, but performance was a clear step forward. The Il-10 also took part in the Soviet offensive against Japan in August 1945. Though its time in WWII was short, it marked the Air Forces’ shift to more modern and versatile strike aircraft.","LocalizedString":"The Ilyushin Il-10 was the Soviet Union’s last ground-attack aircraft introduced during WWII. Designed to replace the Il-2, it featured stronger armor, better speed and improved handling at low altitudes. These qualities were vital for surviving concentrated ground fire during close support missions. Powered by the AM-42 engine, the Il-10 carried two 23 mm cannons, two machine guns, and a rear 12.7 mm gunner. It could also deliver up to 600 kilograms of bombs. Unlike the heavier Il-8, which was tested at the same time, the Il-10 proved more agile and reliable. It entered production in September 1944 and began arriving at frontline units in early 1945. Three assault regiments flew Il-10s in combat during the final weeks of the war in Europe. They attacked German defensive positions and supply routes. Crews praised its improved protection and firepower. Some aircraft were lost to Flak and engine failures, but performance was a clear step forward. The Il-10 also took part in the Soviet offensive against Japan in August 1945. Though its time in WWII was short, it marked the Air Forces’ shift to more modern and versatile strike aircraft."},"operationCost":1,"rarity":"ERarityEnum::Unique","cardSet":"ECardSetEnum::NavalWarfare","usedTriggers":["ERegisteredCardFunction::OnOtherCardDestroyed"],"hasDestruction":true,"Image":{"AssetPathName":"/Game/Assets/Textures/Images/Soviet/World_at_War/t_il-10_v2.t_il-10_v2","SubPathString":""},"artist":"Asgeir 1939 Games","historyPhoto":{"AssetPathName":"/Game/Assets/Textures/HistoricalPhotos/ILYUSHIN_IL-10.ILYUSHIN_IL-10","SubPathString":""},"historyPhotoSize":{"X":512.0,"Y":256.0},"historyPhotoDescription":{"Namespace":"card_soviet","Key":"card_unit_ilyushin_10_photo","SourceString":"Two Ilyushin Il-10s in flight. Date unknown.","LocalizedString":"Two Ilyushin Il-10s in flight. Date unknown."},"blowUpExplosion":{"ObjectName":"ParticleSystem'P_ExplosionAircraftM'","ObjectPath":"kards/Content/Effects/Explosions/Medium/Aircraft/P_ExplosionAircraftM.193"},"blowUpCameraShake":{"ObjectName":"BlueprintGeneratedClass'CameraShakeMedium_C'","ObjectPath":"kards/Content/examples/GrenadePack/Blueprints/CameraShakeMedium.0"},"OnAttackVisualsSoft":{"AssetPathName":"/Game/Blueprints/Effects/BP_AttackFighter.BP_AttackFighter_C","SubPathString":""}},"variables":[{"name":"airFound","type":"bool","direction":"in"},{"name":"lastDestroyedCard","type":"UBaseCardObject*","direction":"in"},{"name":"allCardsDestroyedThisBattle","type":"TArray<int32>","direction":"in"}],"functions":[{"name":"ExecuteUbergraph_card_unit_ilyushin_10","